IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss127-129`
IMPORT `wra4-ss130-134`

-- Tests for wra4-ss130-134.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 130 overnight care and similar services`

#ASSERT `s 130(3) the service is a relevant service` `s 130(3)(a) a service consisting of overnight care in the individual's own home provided by or on behalf of a local authority` EQUALS TRUE
#ASSERT `s 130(3) the service is a relevant service` `s 130(3)(b) a residential care service provided by or on behalf of a local authority` EQUALS TRUE
#ASSERT `s 130(3) the service is a relevant service` `s 130(3)(c) a service consisting of overnight hospital accommodation` EQUALS TRUE
#ASSERT `s 130(3) the service is a relevant service` `s 130(3) some other service` EQUALS FALSE
-- (4): England, an NHS trust or NHS foundation trust; Wales, a Local Health Board or NHS trust; Scotland, a Health Board or Special Health Board, not dental school
#ASSERT `s 130(4) the accommodation is hospital accommodation` `England outside Greater London` TRUE `s 130(4) an NHS trust` FALSE EQUALS TRUE
#ASSERT `s 130(4) the accommodation is hospital accommodation` `Greater London` TRUE `s 130(4) an NHS foundation trust` FALSE EQUALS TRUE
#ASSERT `s 130(4) the accommodation is hospital accommodation` `England outside Greater London` TRUE `s 130(4) a Local Health Board` FALSE EQUALS FALSE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Wales TRUE `s 130(4) a Local Health Board` FALSE EQUALS TRUE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Wales TRUE `s 130(4) an NHS trust` FALSE EQUALS TRUE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Wales TRUE `s 130(4) an NHS foundation trust` FALSE EQUALS FALSE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Scotland TRUE `s 130(4) a Health Board or Special Health Board` FALSE EQUALS TRUE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Scotland TRUE `s 130(4) a Health Board or Special Health Board` TRUE EQUALS FALSE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Scotland TRUE `s 130(4) an NHS trust` FALSE EQUALS FALSE
#ASSERT `s 130(4) the accommodation is hospital accommodation` `Northern Ireland` TRUE `s 130(4) an NHS trust` FALSE EQUALS FALSE
#ASSERT `s 130(4) the accommodation is hospital accommodation` Wales FALSE `s 130(4) an NHS trust` FALSE EQUALS FALSE
-- (2): (c) is prescribed information
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2)(a) information as to the fact of the provision or likely provision of the service` NOTHING EQUALS JUST TRUE
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2)(b) information about when the provision of the service begins or ends or is likely to do so` NOTHING EQUALS JUST TRUE
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2)(c) other information relating to the service provided and how it is funded` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2)(c) other information relating to the service provided and how it is funded` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2)(c) other information relating to the service provided and how it is funded` NOTHING EQUALS NOTHING
#ASSERT `s 130(2) the information falls within subsection (2)` `s 130(2) some other information` (JUST TRUE) EQUALS JUST FALSE
-- (1)
#ASSERT `s 130(1) this section applies` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 130(1) this section applies` TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 130(1) this section applies` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 130(1) this section applies` FALSE (JUST TRUE) TRUE EQUALS NOTHING
-- (7): relevant benefit
#ASSERT `s 130(7) the benefit is a relevant benefit` `universal credit` NOTHING EQUALS JUST TRUE
#ASSERT `s 130(7) the benefit is a relevant benefit` `housing benefit` NOTHING EQUALS JUST TRUE
#ASSERT `s 130(7) the benefit is a relevant benefit` `council tax benefit` NOTHING EQUALS JUST TRUE
#ASSERT `s 130(7) the benefit is a relevant benefit` `income support` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 130(7) the benefit is a relevant benefit` `income support` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 130(7) the benefit is a relevant benefit` `income support` NOTHING EQUALS NOTHING
-- (6), (5)
#ASSERT `s 130(6) the person is a person specified in subsection (6)` `s 130(6)(a) the Secretary of State` EQUALS TRUE
#ASSERT `s 130(6) the person is a person specified in subsection (6)` `s 130(6)(c) a local authority` EQUALS TRUE
#ASSERT `s 130(6) the person is a person specified in subsection (6)` `s 130(6)(e) a person providing services relating to a relevant benefit to a local authority` EQUALS TRUE
#ASSERT `s 130(6) the person is a person specified in subsection (6)` `s 130(6) some other person` EQUALS FALSE
#ASSERT `s 130(5) the local authority may use or supply the information` (JUST TRUE) `s 130(5)(a) itself uses the information` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130(5) the local authority may use or supply the information` (JUST TRUE) `s 130(5)(b) supplies the information to another person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(5) the local authority may use or supply the information` (JUST TRUE) `s 130(5)(b) supplies the information to another person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 130(5) the local authority may use or supply the information` (JUST TRUE) `s 130(5)(a) itself uses the information` FALSE FALSE EQUALS NOTHING
#ASSERT `s 130(5) the local authority may use or supply the information` (JUST TRUE) `s 130(5) does something else with the information` TRUE TRUE EQUALS NOTHING
#ASSERT `s 130(5) the local authority may use or supply the information` NOTHING `s 130(5)(a) itself uses the information` TRUE FALSE EQUALS NOTHING
-- (8)
#ASSERT `s 130(8) regulations may prescribe the benefit` TRUE EQUALS JUST FALSE
#ASSERT `s 130(8) regulations may prescribe the benefit` FALSE EQUALS NOTHING

§ `s 131 welfare services and council tax`

#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(a) a local authority` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(d) an authority which administers housing benefit` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(f) a person providing to an authority which administers housing benefit services relating to housing benefit` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(g) a person prescribed or of a description prescribed by the Secretary of State` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(g) a person prescribed or of a description prescribed by the Secretary of State` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11)(g) a person prescribed or of a description prescribed by the Secretary of State` NOTHING EQUALS NOTHING
#ASSERT `s 131(11) the person is a qualifying person` `s 131(11) some other person` (JUST TRUE) EQUALS JUST FALSE
-- (1): args: supplier, relevant information, recipient is a qualifying person, purpose is prescribed
#ASSERT `s 131(1) the Secretary of State may supply the information to a qualifying person` TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 131(1) the Secretary of State may supply the information to a qualifying person` TRUE TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 131(1) the Secretary of State may supply the information to a qualifying person` TRUE TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 131(1) the Secretary of State may supply the information to a qualifying person` FALSE TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 131(1) the Secretary of State may supply the information to a qualifying person` TRUE FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- (2), (3), (4), (5)
#ASSERT `s 131(2) the qualifying person may supply the information to the Secretary of State` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 131(2) the qualifying person may supply the information to the Secretary of State` (JUST TRUE) (JUST TRUE) FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 131(2) the qualifying person may supply the information to the Secretary of State` NOTHING (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 131(3) the qualifying person may use or supply the information` (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 131(3) the qualifying person may use or supply the information` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 131(3) the qualifying person may use or supply the information` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 131(4) the qualifying person may supply the information to a person who provides qualifying welfare services` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 131(4) the qualifying person may supply the information to a person who provides qualifying welfare services` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 131(5) the services are qualifying welfare services` TRUE FALSE EQUALS TRUE
#ASSERT `s 131(5) the services are qualifying welfare services` FALSE TRUE EQUALS TRUE
#ASSERT `s 131(5) the services are qualifying welfare services` FALSE FALSE EQUALS FALSE
-- (6) to (9): excepted purposes and information held by a Welsh or Scottish body
#ASSERT `s 131(7)(a) the information held by the Welsh body is excepted information` FALSE TRUE EQUALS TRUE
#ASSERT `s 131(7)(a) the information held by the Welsh body is excepted information` TRUE TRUE EQUALS FALSE
#ASSERT `s 131(7)(a) the information held by the Welsh body is excepted information` FALSE FALSE EQUALS FALSE
#ASSERT `s 131(7)(b) the purpose is an excepted purpose in relation to a Welsh body` TRUE FALSE EQUALS TRUE
#ASSERT `s 131(7)(b) the purpose is an excepted purpose in relation to a Welsh body` FALSE TRUE EQUALS TRUE
#ASSERT `s 131(7)(b) the purpose is an excepted purpose in relation to a Welsh body` FALSE FALSE EQUALS FALSE
#ASSERT `s 131(6) regulations may prescribe the purpose for information held by a Welsh body` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 131(6) regulations may prescribe the purpose for information held by a Welsh body` TRUE FALSE EQUALS NOTHING
#ASSERT `s 131(9)(a) the information held by the Scottish body is excepted information` FALSE TRUE EQUALS TRUE
#ASSERT `s 131(9)(a) the information held by the Scottish body is excepted information` TRUE TRUE EQUALS FALSE
#ASSERT `s 131(9)(b) the purpose is an excepted purpose in relation to a Scottish body` TRUE EQUALS TRUE
#ASSERT `s 131(9)(b) the purpose is an excepted purpose in relation to a Scottish body` FALSE EQUALS FALSE
#ASSERT `s 131(8) regulations may prescribe the purpose for information held by a Scottish body` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 131(8) regulations may prescribe the purpose for information held by a Scottish body` FALSE TRUE EQUALS NOTHING
#ASSERT `s 131(10) subsections (1) to (4) do not apply` TRUE EQUALS JUST TRUE
#ASSERT `s 131(10) subsections (1) to (4) do not apply` FALSE EQUALS NOTHING
-- (12): definitions; "includes" leaves the list open, "means" closes it
#ASSERT `s 131(12) the tax is council tax` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 131(12) the tax is council tax` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 131(12) the tax is council tax` FALSE FALSE EQUALS NOTHING
#ASSERT `s 131(12) the person is engaged in the administration of housing benefit` `s 131(12) an authority which administers housing benefit` EQUALS TRUE
#ASSERT `s 131(12) the person is engaged in the administration of housing benefit` `s 131(12) some other person` EQUALS FALSE
#ASSERT `s 131(12) the information is relevant information` TRUE FALSE EQUALS TRUE
#ASSERT `s 131(12) the information is relevant information` FALSE TRUE EQUALS TRUE
#ASSERT `s 131(12) the information is relevant information` FALSE FALSE EQUALS FALSE
#ASSERT `s 131(12) it is a relevant social security benefit` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 131(12) it is a relevant social security benefit` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 131(12) it is a relevant social security benefit` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 131(12) it is a relevant social security benefit` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 131(12) the person is a Scottish body` `s 131(12) a local authority in Scotland` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(12) the person is a Scottish body` `s 131(12) a person prescribed or of a description prescribed by the Secretary of State as a Scottish body` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 131(12) the person is a Scottish body` `s 131(12) a person prescribed or of a description prescribed by the Secretary of State as a Scottish body` NOTHING EQUALS NOTHING
#ASSERT `s 131(12) the person is a Scottish body` `s 131(12) some other person in Scotland` NOTHING EQUALS JUST FALSE
#ASSERT `s 131(12) the person is a Welsh body` `s 131(12) a local authority in Wales` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(12) the person is a Welsh body` `s 131(12) a person providing to a local authority in Wales services relating to welfare services` NOTHING EQUALS JUST TRUE
#ASSERT `s 131(12) the person is a Welsh body` `s 131(12) a person prescribed or of a description prescribed by the Secretary of State as a Welsh body` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 131(12) the person is a Welsh body` `s 131(12) some other person in Wales` NOTHING EQUALS JUST FALSE
#ASSERT `s 131(12) the service is welfare services` TRUE EQUALS JUST TRUE
#ASSERT `s 131(12) the service is welfare services` FALSE EQUALS NOTHING

§ `s 132 unlawful disclosure of information supplied under section 131`

#ASSERT `s 132(2) subsection (2) applies to the person` `s 132(2)(a) a person mentioned in section 131(11)(a) to (c)` EQUALS TRUE
#ASSERT `s 132(2) subsection (2) applies to the person` `s 132(2)(b) a person who provides qualifying welfare services within the meaning of section 131` EQUALS TRUE
#ASSERT `s 132(2) subsection (2) applies to the person` `s 132(2)(c) a person who is or has been a director, member of the committee of management, manager, secretary or other similar officer of a person mentioned in paragraph (a) or (b)` EQUALS TRUE
#ASSERT `s 132(2) subsection (2) applies to the person` `s 132(2)(d) a person who is or has been an employee of a person mentioned in paragraph (a) or (b)` EQUALS TRUE
#ASSERT `s 132(2) subsection (2) applies to the person` `s 132(2) some other person` EQUALS FALSE
#ASSERT `s 132(1) the person is guilty of an offence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(1) the person is guilty of an offence` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 132(1) the person is guilty of an offence` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(1) the person is guilty of an offence` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(4) the disclosure is not an offence under this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 132(4) the disclosure is not an offence under this section` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 132(4) the disclosure is not an offence under this section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 132(5) the person has a defence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 132(5) the person has a defence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 132(5) the person has a defence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 132(5) the person has a defence` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(6) the disclosure is made with lawful authority` TRUE EQUALS JUST TRUE
#ASSERT `s 132(6) the disclosure is made with lawful authority` FALSE EQUALS NOTHING
#ASSERT `s 132(3) the greatest punishment for the offence` `s 129(7)(a) conviction on indictment` EQUALS (`s 129(7) punishment` WITH `the term of imprisonment not exceeded` IS `s 129(7)(a) a term of two years`, `the fine not exceeded` IS `s 129(7)(a) a fine without a stated limit`)
#ASSERT `s 132(3) the greatest punishment for the offence` `s 129(7)(b) summary conviction` EQUALS (`s 129(7) punishment` WITH `the term of imprisonment not exceeded` IS `s 129(7)(b) the general limit in a magistrates' court`, `the fine not exceeded` IS `s 129(7)(b) the statutory maximum`)
#ASSERT `s 132(9) the term as read for an offence committed before 2 May 2022` `s 129(7)(b) the general limit in a magistrates' court` TRUE EQUALS `s 129(9) a term of six months`
#ASSERT `s 132(9) the term as read for an offence committed before 2 May 2022` `s 129(7)(b) the general limit in a magistrates' court` FALSE EQUALS `s 129(7)(b) the general limit in a magistrates' court`

