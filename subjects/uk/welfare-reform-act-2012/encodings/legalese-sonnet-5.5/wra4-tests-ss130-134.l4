#ASSERT `s 133(1) the thing is a benefit` TRUE EQUALS JUST TRUE
#ASSERT `s 133(1) the thing is a benefit` FALSE EQUALS NOTHING
#ASSERT `s 133(1) the body is a local authority` `s 133(1) a county or district council in England` EQUALS TRUE
