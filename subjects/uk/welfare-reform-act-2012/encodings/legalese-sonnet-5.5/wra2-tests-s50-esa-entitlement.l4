IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s50-esa-entitlement`

-- wra2-tests-s50-esa-entitlement.l4: tests for ss 50 to 53 (WRA2007 1(6A), 1A, 1B, 1(3A)).
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 877-921), not from the output.

§ `s 50 WRA2007 1(6A)`

-- line 879: in relation to a contributory allowance, the reference to a couple entitled to a joint-claim JSA does not include a couple so entitled by virtue of regulations under paragraph 8A
#ASSERT `s 50(1) WRA2007 1(6A) the couple is within the reference in subsection (3)(f)` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 50(1) WRA2007 1(6A) the couple is within the reference in subsection (3)(f)` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 50(1) WRA2007 1(6A) the couple is within the reference in subsection (3)(f)` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 50(1) WRA2007 1(6A) the couple is within the reference in subsection (3)(f)` TRUE FALSE FALSE EQUALS NOTHING

§ `s 50(2) retrospective effect`

#ASSERT `s 50(2) subsection (1) is regarded as having been in force for the period` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 50(2) subsection (1) is regarded as having been in force for the period` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 50(2) subsection (1) is regarded as having been in force for the period` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 50(2) subsection (1) is regarded as having been in force for the period` TRUE TRUE FALSE EQUALS NOTHING

§ `WRA2007 1A(2): the relevant maximum number of days`

-- lines 889-890: 365 days, or a greater number an order specifies
#ASSERT `s 51 WRA2007 1A(2) the relevant maximum number of days` NOTHING EQUALS 365
#ASSERT `s 51 WRA2007 1A(2) the relevant maximum number of days` (JUST 730) EQUALS 730
#ASSERT `s 51 WRA2007 1A(2) the relevant maximum number of days` (JUST 366) EQUALS 366
#ASSERT `s 51 WRA2007 1A(2) the relevant maximum number of days` (JUST 365) EQUALS 365
-- an order that specifies a smaller number is not an order specifying "a greater number"
#ASSERT `s 51 WRA2007 1A(2) the relevant maximum number of days` (JUST 100) EQUALS 365

§ `WRA2007 1A(1), (4), (5), (6): counting the days`

#ASSERT `s 51 WRA2007 1A(1) the period of entitlement is within the relevant maximum` 365 365
#ASSERT `s 51 WRA2007 1A(1) the period of entitlement is within the relevant maximum` 364 365
#ASSERT NOT (`s 51 WRA2007 1A(1) the period of entitlement is within the relevant maximum` 366 365)
#ASSERT `s 51 WRA2007 1A(1) the period of entitlement is within the relevant maximum` 366 730
#ASSERT `s 51 WRA2007 1A(4) the period of entitlement by virtue of the third condition is within the relevant maximum` 365 365
#ASSERT NOT (`s 51 WRA2007 1A(4) the period of entitlement by virtue of the third condition is within the relevant maximum` 366 365)
-- line 901: days before the section came into force are counted as well as those after
#ASSERT `s 51 WRA2007 1A(6) the days of entitlement that are counted before the exclusions in subsection (5)` 100 50 EQUALS 150
#ASSERT `s 51 WRA2007 1A(6) the days of entitlement that are counted before the exclusions in subsection (5)` 0 50 EQUALS 50
-- lines 898-900: support group days, support component days and assessment-phase days followed by either are not counted
#ASSERT `s 51 WRA2007 1A(5) the days that are counted` 400 20 10 5 EQUALS 365
#ASSERT `s 51 WRA2007 1A(5) the days that are counted` 400 0 0 0 EQUALS 400
#ASSERT `s 51 WRA2007 1A(5) the days that are counted` 400 400 0 0 EQUALS 0

§ `WRA2007 1A(3): a further contributory allowance`

-- line 891-893: (a) satisfies the first and second conditions, and (b) the two tax years include at least one later than the second year of the previous entitlement
#ASSERT `s 51 WRA2007 1A(3) subsection (1) does not prevent the person being entitled to a further contributory allowance` TRUE 2014 2013
#ASSERT NOT (`s 51 WRA2007 1A(3) subsection (1) does not prevent the person being entitled to a further contributory allowance` TRUE 2013 2013)
#ASSERT NOT (`s 51 WRA2007 1A(3) subsection (1) does not prevent the person being entitled to a further contributory allowance` TRUE 2012 2013)
#ASSERT NOT (`s 51 WRA2007 1A(3) subsection (1) does not prevent the person being entitled to a further contributory allowance` FALSE 2014 2013)

§ `s 52 WRA2007 1B`

#ASSERT `s 52 WRA2007 1B(1) the claimant is entitled to an employment and support allowance by virtue of section 1B` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 52 WRA2007 1B(1) the claimant is entitled to an employment and support allowance by virtue of section 1B` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 52 WRA2007 1B(1) the claimant is entitled to an employment and support allowance by virtue of section 1B` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 52 WRA2007 1B(1) the claimant is entitled to an employment and support allowance by virtue of section 1B` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 52 WRA2007 1B(1) the claimant is entitled to an employment and support allowance by virtue of section 1B` TRUE TRUE TRUE FALSE)
#ASSERT `s 52 WRA2007 1B(2) the allowance is regarded as a contributory allowance for the purposes of Part 1` TRUE EQUALS JUST TRUE
#ASSERT `s 52 WRA2007 1B(2) the allowance is regarded as a contributory allowance for the purposes of Part 1` FALSE EQUALS NOTHING

§ `s 53 WRA2007 1(3A)`

-- line 921: after the coming into force no claim may be made by virtue of the third condition (fork F-53-1: the day itself counts)
#ASSERT `s 53 WRA2007 1(3A) a claim may be made by virtue of the third condition` TRUE (Date 1 5 2013) (JUST (Date 1 5 2013)) EQUALS JUST FALSE
#ASSERT `s 53 WRA2007 1(3A) a claim may be made by virtue of the third condition` TRUE (Date 2 5 2013) (JUST (Date 1 5 2013)) EQUALS JUST FALSE
#ASSERT `s 53 WRA2007 1(3A) a claim may be made by virtue of the third condition` TRUE (Date 30 4 2013) (JUST (Date 1 5 2013)) EQUALS NOTHING
#ASSERT `s 53 WRA2007 1(3A) a claim may be made by virtue of the third condition` TRUE (Date 2 5 2013) NOTHING EQUALS NOTHING
#ASSERT `s 53 WRA2007 1(3A) a claim may be made by virtue of the third condition` FALSE (Date 2 5 2013) (JUST (Date 1 5 2013)) EQUALS NOTHING
