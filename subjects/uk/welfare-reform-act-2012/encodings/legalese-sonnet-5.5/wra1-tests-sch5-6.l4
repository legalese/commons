IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra1-three-valued`
IMPORT `wra1-ch3-general`
IMPORT `wra1-sch5-6`

-- Tests for wra1-sch5-6.l4 (Schedules 5 and 6). Every expected value is written by hand from the text quoted in the module, beside
-- the assertion. A figure such as 80 is an invented test figure: the Act supplies none of these amounts.

§ `sch 5 para 1`

-- (1) relevant benefit: the two allowances, on both of their bases, and nothing else
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `contribution-based jobseeker's allowance` EQUALS TRUE
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `income-based jobseeker's allowance` EQUALS TRUE
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `contributory employment and support allowance` EQUALS TRUE
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `income-related employment and support allowance` EQUALS TRUE
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `income support` EQUALS FALSE
#ASSERT `sch 5 para 1(1) the benefit is a relevant benefit` `universal credit` EQUALS FALSE
-- (2) the three regimes
#ASSERT `sch 5 para 1(2) the requirement is a work-related requirement` `sch 5 para 1(2)(a) this Part` EQUALS TRUE
#ASSERT `sch 5 para 1(2) the requirement is a work-related requirement` `sch 5 para 1(2)(b) the Jobseekers Act 1995` EQUALS TRUE
#ASSERT `sch 5 para 1(2) the requirement is a work-related requirement` `sch 5 para 1(2)(c) Part 1 of the Welfare Reform Act 2007` EQUALS TRUE
#ASSERT `sch 5 para 1(2) the requirement is a work-related requirement` `sch 5 para 1(2) some other regime` EQUALS FALSE
-- (3) sanctions: s 26, s 27, JSA 6J, JSA 6K and WRA2007 11J; the interim-period provisions and income support are not named
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `universal credit higher-level sanction` EQUALS TRUE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `universal credit other sanction` EQUALS TRUE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `jobseeker's allowance higher-level sanction after universal credit` EQUALS TRUE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `jobseeker's allowance other sanction after universal credit` EQUALS TRUE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `employment and support allowance sanction` EQUALS TRUE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `jobseeker's allowance higher-level sanction` EQUALS FALSE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `jobseeker's allowance other sanction` EQUALS FALSE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `jobseeker's allowance ceasing to be available` EQUALS FALSE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `employment and support allowance interim sanction` EQUALS FALSE
#ASSERT `sch 5 para 1(3) the reduction is a sanction` `income support sanction` EQUALS FALSE

§ `sch 5 paras 2 to 4`

-- 2(1), (2) the amount is the regulations' (80 is invented; nil is allowed by 2(2))
#ASSERT `sch 5 para 2(1) the amount payable by way of the relevant benefit` TRUE (JUST 80) EQUALS JUST 80
#ASSERT `sch 5 para 2(1) the amount payable by way of the relevant benefit` TRUE (JUST 0) EQUALS JUST 0
#ASSERT `sch 5 para 2(1) the amount payable by way of the relevant benefit` TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 5 para 2(1) the amount payable by way of the relevant benefit` FALSE (JUST 80) EQUALS NOTHING
-- 2(3)-(5), 3: what regulations may provide
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(3)(a) the application of work-related requirements` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(3)(b) the application of sanctions` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(4)(a) compliance with a requirement for a relevant benefit treated as compliance with a requirement for universal credit` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(4)(b) disapplying a requirement to impose, or to comply with, a work-related requirement` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(5)(a) the order in which sanctions are applied to awards of relevant benefit and universal credit` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2(5)(b) securing that a sanction on a relevant benefit does not increase an award of universal credit` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 3(a) applying a universal credit sanction to the relevant benefit after a move from universal credit` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 3(b) applying a relevant benefit sanction to universal credit after a move to universal credit` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 3(c) applying a sanction on one relevant benefit to the other after a move between them` EQUALS JUST TRUE
#ASSERT `sch 5 para 2 and 3 regulations may make this provision` `sch 5 para 2 and 3 some other provision` EQUALS NOTHING
-- 4 hardship payments for a person reduced by regulations under 2(3)(b) or 3(b)
#ASSERT `sch 5 para 4 regulations under section 28 may be made in relation to the person` TRUE EQUALS JUST TRUE
#ASSERT `sch 5 para 4 regulations under section 28 may be made in relation to the person` FALSE EQUALS NOTHING

§ `sch 6 para 1`

-- (2) existing benefit: abolished by s 33(1), or any other benefit that is prescribed
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `income support` NOTHING EQUALS JUST TRUE
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `child tax credit` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `housing benefit` NOTHING EQUALS JUST TRUE
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `state pension credit` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `state pension credit` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 6 para 1(2) the benefit is an existing benefit` `state pension credit` NOTHING EQUALS NOTHING
-- (3) the appointed day is the day appointed (1 April 2013 is the test day)
#ASSERT `sch 6 para 1(3) the day is the appointed day` (Date 1 4 2013) (JUST (Date 1 4 2013)) EQUALS JUST TRUE
#ASSERT `sch 6 para 1(3) the day is the appointed day` (Date 2 4 2013) (JUST (Date 1 4 2013)) EQUALS JUST FALSE
#ASSERT `sch 6 para 1(3) the day is the appointed day` (Date 31 3 2013) (JUST (Date 1 4 2013)) EQUALS JUST FALSE
#ASSERT `sch 6 para 1(3) the day is the appointed day` (Date 1 4 2013) NOTHING EQUALS NOTHING

§ `sch 6 paras 2 to 7 -- what the regulations may include`

#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 2(1)(a) a claim for universal credit made before the appointed day for a period beginning on or after that day` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 2(1)(b) a claim for universal credit made before the appointed day treated as a claim for an existing benefit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 2(1)(c) a claim for an existing benefit made before the appointed day treated as a claim for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 2(2) an award on a claim made before the appointed day for a period before that day` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(a) permanently or temporarily excluding a claim for universal credit after the appointed day by a person who has, or would be entitled to, an existing benefit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(b) temporarily excluding a claim for universal credit after the appointed day by any other person` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(c) excluding entitlement to universal credit temporarily or for a particular period` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(d) a claim for universal credit made after the appointed day treated as a claim for an existing benefit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(e) a claim for an existing benefit made after the appointed day treated as a claim for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(2) an award on a claim made after the appointed day for a period before that day` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(1)(a) terminating an award of an existing benefit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(1)(b) making an award of universal credit, with or without application, to a person whose award of existing benefit is terminated` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(a) requirements as to procedure, information or assessments for an award under para 4(1)(b)` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(b) the consequences of failure to comply with such a requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(c)(i) disapplying or modifying conditions of entitlement to universal credit for the award` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(c)(ii) disapplying or modifying any requirement to be assessed for capability for work or work-related activity` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(d) the amount of such an award` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(2)(e) treating fulfilment of a condition for an existing benefit as fulfilment of an equivalent condition for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(3)(a) an award of universal credit not less than the terminated award, or not less by more than a prescribed amount` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 4(3)(b) disregarding a gap in entitlement of not more than a prescribed period` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(1)(a) the application of work-related requirements for relevant benefits` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(1)(b) the application of sanctions` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(2)(a) a claimant commitment for a relevant benefit treated as a claimant commitment for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(2)(b) a work-related requirement for a relevant benefit treated as one for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(2)(c) anything done relevant to compliance treated as done for compliance with a requirement for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(2)(d) temporarily disapplying provisions of this Part about work-related requirements` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(3)(a) a sanction relevant to a relevant benefit applied to an award of universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(3)(b) anything done relevant to a sanction treated as done for a sanction for universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 5(3)(c) temporarily disapplying provisions of this Part about the application of sanctions` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 6(a) modifying the application of the Tax Credits Act 2002` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 6(b) recovering overpayments of working tax credit or child tax credit, including treating them as overpayments of universal credit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 7 disregarding a gap in entitlement to an existing benefit` TRUE EQUALS JUST TRUE
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 some other provision` TRUE EQUALS NOTHING
-- outside the purposes of replacing existing benefits with universal credit the power does not reach
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 para 3(1)(c) excluding entitlement to universal credit temporarily or for a particular period` FALSE EQUALS NOTHING
#ASSERT `sch 6 para 1(1) regulations may include this provision` `sch 6 some other provision` FALSE EQUALS NOTHING

§ `sch 6 para 5(4)`

-- relevant benefit: jobseeker's allowance, employment and support allowance, and income support
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `contribution-based jobseeker's allowance` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `income-based jobseeker's allowance` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `contributory employment and support allowance` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `income-related employment and support allowance` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `income support` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `universal credit` EQUALS FALSE
#ASSERT `sch 6 para 5(4) the benefit is a relevant benefit` `housing benefit` EQUALS FALSE
-- work-related requirement: the eleven sources the definition names
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) universal credit: a work-related requirement within the meaning of this Part` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) JSA: regulations under section 8 or 17A of the Jobseekers Act 1995` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) JSA: a jobseeker's direction within the meaning of section 19A of that Act` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) JSA: regulations under section 2A, 2AA or 2D of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) JSA: a direction under section 2F of that Act` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) ESA: regulations under section 8, 9, 11, 12 or 13 of the Welfare Reform Act 2007` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) ESA: a direction under section 15 of that Act` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) ESA: regulations under section 2A, 2AA or 2D of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) ESA: a direction under section 2F of that Act` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) income support: regulations under section 2A, 2AA or 2D of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) income support: a direction under section 2F of that Act` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the requirement is a work-related requirement` `sch 6 para 5(4) some other source` EQUALS FALSE
-- sanction: s 26 or 27, JSA 19, 19A, 19B, WRA2007 11 to 13, SSAA 2A, 2AA, 2D; not JSA 6J, 6K or WRA2007 11J
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `universal credit higher-level sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `universal credit other sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `jobseeker's allowance higher-level sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `jobseeker's allowance other sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `jobseeker's allowance ceasing to be available` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `employment and support allowance interim sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `income support sanction` EQUALS TRUE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `jobseeker's allowance higher-level sanction after universal credit` EQUALS FALSE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `jobseeker's allowance other sanction after universal credit` EQUALS FALSE
#ASSERT `sch 6 para 5(4) the reduction is a sanction` `employment and support allowance sanction` EQUALS FALSE
