IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra3-sch4`

-- Tests for wra3-sch4.l4 (Schedule 4, housing credit). Expected values are written from the text (raw lines 3001-3049),
-- decided before running. Amounts are INVENTED test numbers: the prescribed amount is left to regulations.

§ `sch 4 para 4 SPCA 3A(1)`

#ASSERT `sch 4 para 4 SPCA 3A(1) the first condition for housing credit is met` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(1) the first condition for housing credit is met` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 4 para 4 SPCA 3A(1) the first condition for housing credit is met` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 4 para 4 SPCA 3A(1) the first condition for housing credit is met` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 4 para 4 SPCA 3A(1) the first condition for housing credit is met` NOTHING (JUST FALSE) EQUALS JUST FALSE

§ `sch 4 para 4 SPCA 3A(4)`

-- (a) in Great Britain: England (inside or outside Greater London), Scotland and Wales yes; Northern Ireland and abroad no
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` `Greater London` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` `England outside Greater London` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Scotland TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` `Northern Ireland` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` `outside the United Kingdom` TRUE TRUE TRUE EQUALS JUST FALSE
-- (b) must be residential
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales FALSE TRUE TRUE EQUALS JUST FALSE
-- (c) immaterial whether the whole or part of a building, and whether self-contained: all four combinations give the same answer
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(4) the accommodation is accommodation for the purposes of subsection (1)` Wales TRUE FALSE FALSE EQUALS JUST TRUE

§ `sch 4 para 4 SPCA 3A(2) and (3)`

-- (2) the amount payable would not be less than the prescribed amount (invented: 10): 10 meets it, 9 does not
#ASSERT `sch 4 para 4 SPCA 3A(2) the second condition for housing credit is met` 10 (JUST 10) EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(2) the second condition for housing credit is met` 11 (JUST 10) EQUALS JUST TRUE
#ASSERT `sch 4 para 4 SPCA 3A(2) the second condition for housing credit is met` 9 (JUST 10) EQUALS JUST FALSE
#ASSERT `sch 4 para 4 SPCA 3A(2) the second condition for housing credit is met` 10 NOTHING EQUALS NOTHING
-- (3) the amount is as regulations calculate it, which may be zero
#ASSERT `sch 4 para 4 SPCA 3A(3) the amount of the housing credit` (JUST 0) EQUALS JUST 0
#ASSERT `sch 4 para 4 SPCA 3A(3) the amount of the housing credit` (JUST 25) EQUALS JUST 25
#ASSERT `sch 4 para 4 SPCA 3A(3) the amount of the housing credit` NOTHING EQUALS NOTHING

§ `sch 4 paras 2, 3`

#ASSERT `sch 4 para 2 SPCA 1(2)(c)(iii) the claimant satisfies the conditions in section 3A(1) and (2)` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 4 para 2 SPCA 1(2)(c)(iii) the claimant satisfies the conditions in section 3A(1) and (2)` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 4 para 2 SPCA 1(2)(c)(iii) the claimant satisfies the conditions in section 3A(1) and (2)` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 4 para 2 SPCA 1(2)(c)(iii) the claimant satisfies the conditions in section 3A(1) and (2)` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `sch 4 para 3 SPCA 1(3)(c) the claimant is entitled to a housing credit` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 4 para 3 SPCA 1(3)(c) the claimant is entitled to a housing credit` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 4 para 3 SPCA 1(3)(c) the claimant is entitled to a housing credit` NOTHING EQUALS NOTHING
-- 1(3) as amended: each credit whose relevant conditions are satisfied, so more than one is possible
#ASSERT `sch 4 para 3 SPCA 1(3)(b) the credits the claimant is entitled to` TRUE FALSE TRUE EQUALS LIST `sch 4 para 3 guarantee credit`, `sch 4 para 3 housing credit`
#ASSERT `sch 4 para 3 SPCA 1(3)(b) the credits the claimant is entitled to` TRUE TRUE TRUE EQUALS LIST `sch 4 para 3 guarantee credit`, `sch 4 para 3 savings credit`, `sch 4 para 3 housing credit`
#ASSERT `sch 4 para 3 SPCA 1(3)(b) the credits the claimant is entitled to` FALSE FALSE TRUE EQUALS LIST `sch 4 para 3 housing credit`
#ASSERT `sch 4 para 3 SPCA 1(3)(b) the credits the claimant is entitled to` FALSE FALSE FALSE EQUALS EMPTY

§ `sch 4 definitions`

#ASSERT `sch 4 para 7 SPCA 17(1) housing credit is construed in accordance with` EQUALS "sections 1 and 3A of the State Pension Credit Act 2002"
#ASSERT `sch 4 para 12 SSAA 122F(5) housing credit has the same meaning as in` EQUALS "the State Pension Credit Act 2002"
