    IF `an action has been specified under subsection (1)(b)`
    THEN JUST TRUE
    -- NOTHING-kind (limited by its own wording): the power is "to any particular action" specified under subsection (1)(b)
    ELSE NOTHING

-- (3) "Action which may be specified under subsection (1)(b) includes in particular (a) ... (f) any action prescribed"
DECLARE `s 17(3) kind of action` IS ONE OF
    `s 17(3)(a) carrying out work searches`
    `s 17(3)(b) making applications`
    `s 17(3)(c) creating and maintaining an online profile`
    `s 17(3)(d) registering with an employment agency`
    `s 17(3)(e) seeking references`
    `s 17(3)(f) any action prescribed for the purpose in subsection (1)`
    `s 17(3) some other action`

