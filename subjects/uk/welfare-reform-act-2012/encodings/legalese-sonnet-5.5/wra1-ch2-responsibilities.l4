    WHEN `s 17(3)(b) making applications` THEN JUST TRUE
    WHEN `s 17(3)(c) creating and maintaining an online profile` THEN JUST TRUE
    WHEN `s 17(3)(d) registering with an employment agency` THEN JUST TRUE
    WHEN `s 17(3)(e) seeking references` THEN JUST TRUE
