IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra1-three-valued`
IMPORT `wra1-sch1`

-- Tests for wra1-sch1.l4 (Schedule 1). Every expected value is written by hand from the text quoted in the module, beside the
-- assertion. A number such as 7 is an invented test figure: the Act supplies none of these amounts.

§ `sch 1 para 1`

#ASSERT `sch 1 para 1 joint claimants may be entitled without each meeting all the basic conditions` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 1 joint claimants may be entitled without each meeting all the basic conditions` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 1 para 1 joint claimants may be entitled without each meeting all the basic conditions` TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 1 para 1 joint claimants may be entitled without each meeting all the basic conditions` FALSE (JUST TRUE) EQUALS NOTHING

§ `sch 1 para 2`

-- separated by "no more than" the prescribed number: 7 days apart with 7 prescribed is covered, 8 is not
#ASSERT `sch 1 para 2 the two periods are treated as a single period` 7 (JUST 7) EQUALS JUST TRUE
#ASSERT `sch 1 para 2 the two periods are treated as a single period` 6 (JUST 7) EQUALS JUST TRUE
#ASSERT `sch 1 para 2 the two periods are treated as a single period` 8 (JUST 7) EQUALS NOTHING
#ASSERT `sch 1 para 2 the two periods are treated as a single period` 0 (JUST 7) EQUALS JUST TRUE
#ASSERT `sch 1 para 2 the two periods are treated as a single period` 3 NOTHING EQUALS NOTHING

§ `sch 1 para 4`

-- (5) joint claimants' capital and income includes each one's separate capital and income, unless (6) regulations disregard it
#ASSERT `sch 1 para 4(5) the joint capital and income includes this person's separate capital and income` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 4(5) the joint capital and income includes this person's separate capital and income` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 1 para 4(5) the joint capital and income includes this person's separate capital and income` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 4(5) the joint capital and income includes this person's separate capital and income` FALSE NOTHING EQUALS NOTHING

§ `sch 1 para 5`

#ASSERT `sch 1 para 5(1) the person is responsible for the child or qualifying young person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 5(1) the person is responsible for the child or qualifying young person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 para 5(1) the person is responsible for the child or qualifying young person` NOTHING EQUALS NOTHING
#ASSERT `sch 1 para 5(2) the couple has jointly nominated the person as the responsible carer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 5(2) the couple has jointly nominated the person as the responsible carer` NOTHING EQUALS NOTHING

§ `sch 1 para 6`

-- (2) a voucher is available only if the award includes an amount for particular costs and regulations provide for one
#ASSERT `sch 1 para 6(2) liability to pay all or part of the award may be discharged by a voucher` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 6(2) liability to pay all or part of the award may be discharged by a voucher` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 para 6(2) liability to pay all or part of the award may be discharged by a voucher` TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 1 para 6(2) liability to pay all or part of the award may be discharged by a voucher` FALSE (JUST TRUE) EQUALS NOTHING
-- (3) the voucher may not exceed the total: equal is permitted, one more is not
#ASSERT `sch 1 para 6(3) the amount paid by means of the voucher is permitted` 100 100 EQUALS TRUE
#ASSERT `sch 1 para 6(3) the amount paid by means of the voucher is permitted` 99 100 EQUALS TRUE
#ASSERT `sch 1 para 6(3) the amount paid by means of the voucher is permitted` 101 100 EQUALS FALSE
#ASSERT `sch 1 para 6(3) the amount paid by means of the voucher is permitted` 0 0 EQUALS TRUE
-- (4) both limbs are needed
#ASSERT `sch 1 para 6(4) the means is a voucher` TRUE TRUE EQUALS TRUE
#ASSERT `sch 1 para 6(4) the means is a voucher` FALSE TRUE EQUALS FALSE
#ASSERT `sch 1 para 6(4) the means is a voucher` TRUE FALSE EQUALS FALSE
-- (5)
#ASSERT `sch 1 para 6(5) a voucher may be` `sch 1 para 6(5)(a) limited as regards the person or persons who will accept it` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) a voucher may be` `sch 1 para 6(5)(b) valid only for a limited time` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) a voucher may be` `sch 1 para 6(5) some other feature` EQUALS NOTHING

§ `sch 1 para 7`

-- regulations so provide, and the claimant has the right to reside and would otherwise fall within the section
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `sch 1 para 7 the claimant is treated as not falling within section 19, 20 or 21` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
-- applying it to the answer of section 19, 20 or 21
#ASSERT `sch 1 para 7 the claimant falls within the section once regulations are applied` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 7 the claimant falls within the section once regulations are applied` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 1 para 7 the claimant falls within the section once regulations are applied` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 7 the claimant falls within the section once regulations are applied` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 1 para 7 the claimant falls within the section once regulations are applied` NOTHING NOTHING EQUALS NOTHING

§ `sch 1 para 8`

#ASSERT `sch 1 para 8(a) the person is treated as having a good reason for the act or omission` TRUE NOTHING EQUALS TRUE
#ASSERT `sch 1 para 8(a) the person is treated as having a good reason for the act or omission` FALSE NOTHING EQUALS FALSE
#ASSERT `sch 1 para 8(a) the person is treated as having a good reason for the act or omission` FALSE (JUST TRUE) EQUALS TRUE
#ASSERT `sch 1 para 8(a) the person is treated as having a good reason for the act or omission` TRUE (JUST FALSE) EQUALS FALSE
