§ `sch 2 -- SSAA 159D and 160C`

-- 159D(6) benefit income
#ASSERT `sch 2 SSAA 159D(6) the income is benefit income` `sch 2 SSAA 159D(6) benefit under the Contributions and Benefits Act` EQUALS TRUE
#ASSERT `sch 2 SSAA 159D(6) the income is benefit income` `sch 2 SSAA 159D(6) personal independence payment` EQUALS TRUE
#ASSERT `sch 2 SSAA 159D(6) the income is benefit income` `sch 2 SSAA 159D(6) some other income` EQUALS FALSE
-- 159D(6) element: the amount must be specified in regulations under ss 9 to 12 and be included in the calculation
#ASSERT `sch 2 SSAA 159D(6) the amount is an element of universal credit` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSAA 159D(6) the amount is an element of universal credit` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `sch 2 SSAA 159D(6) the amount is an element of universal credit` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `sch 2 SSAA 159D(6) the amount is an element of universal credit` NOTHING TRUE EQUALS NOTHING
#ASSERT `sch 2 SSAA 159D(6) the amount is an element of universal credit` NOTHING FALSE EQUALS JUST FALSE
-- 159D(2) Arguments: award in force, alteration affects the computation, an exception or condition applies, the amount after the alteration (500 is invented), the commencing date (1 April 2026), the day
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` TRUE TRUE (JUST FALSE) 500 (Date 1 4 2026) (Date 1 4 2026) EQUALS JUST 500
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` TRUE TRUE NOTHING 500 (Date 1 4 2026) (Date 2 4 2026) EQUALS JUST 500
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` TRUE TRUE (JUST FALSE) 500 (Date 1 4 2026) (Date 31 3 2026) EQUALS NOTHING
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` TRUE TRUE (JUST TRUE) 500 (Date 1 4 2026) (Date 1 4 2026) EQUALS NOTHING
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` FALSE TRUE (JUST FALSE) 500 (Date 1 4 2026) (Date 1 4 2026) EQUALS NOTHING
#ASSERT `sch 2 SSAA 159D(2) the amount of universal credit payable on the day without any further decision` TRUE FALSE (JUST FALSE) 500 (Date 1 4 2026) (Date 1 4 2026) EQUALS NOTHING
-- 159D(3)
#ASSERT `sch 2 SSAA 159D(3) the award continues in force` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSAA 159D(3) the award continues in force` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 2 SSAA 159D(3) the award continues in force` FALSE TRUE EQUALS NOTHING
-- 160C(2) Arguments: award in force, element became applicable by age, increased entitlement, a section 160C(3) question, a section 160C(4) question
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 2 SSAA 160C(2) the increased amount is payable from the day without any further decision` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING

§ `sch 2 -- SSA1998`

#ASSERT `sch 2 SSA1998 39(1) this is the claimant in relation to the couple` `sch 2 SSA1998 39(1) the couple` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSA1998 39(1) this is the claimant in relation to the couple` `sch 2 SSA1998 39(1) either member of the couple` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSA1998 39(1) this is the claimant in relation to the couple` `sch 2 SSA1998 39(1) someone else` TRUE EQUALS JUST FALSE
#ASSERT `sch 2 SSA1998 39(1) this is the claimant in relation to the couple` `sch 2 SSA1998 39(1) the couple` FALSE EQUALS NOTHING
#ASSERT `sch 2 SSA1998 an appeal lies against the decision` `sch 2 SSA1998 Sch 2 para 6(b)(v) a decision under section 159D(1)(b) of the Administration Act (universal credit)` EQUALS JUST FALSE
#ASSERT `sch 2 SSA1998 an appeal lies against the decision` `sch 2 SSA1998 Sch 2 new paragraph a decision as to the amount of benefit determined by an increase of universal credit under section 160C(2)` EQUALS JUST FALSE
#ASSERT `sch 2 SSA1998 an appeal lies against the decision` `sch 2 SSA1998 Sch 3 new paragraph a decision as to the amount of a relevant benefit payable by virtue of regulations under section 6B, 7, 8 or 9 of the Social Security Fraud Act 2001` EQUALS JUST TRUE
#ASSERT `sch 2 SSA1998 an appeal lies against the decision` `sch 2 SSA1998 some other decision` EQUALS NOTHING

§ `sch 2 -- SSFA`

-- 6A(1)(za) universal credit is a disqualifying benefit; the other benefits are named by other limbs, not by this one
#ASSERT `sch 2 SSFA 6A(1)(za) the benefit is a disqualifying benefit` `universal credit` EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 6A(1)(za) the benefit is a disqualifying benefit` `income support` EQUALS NOTHING
#ASSERT `sch 2 SSFA 6A(1)(za) the benefit is a disqualifying benefit` `child tax credit` EQUALS NOTHING
-- 6B(5A)
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A)(a) the amount payable reduced in the manner prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A)(b) payable only if the offender complies with information obligations the regulations impose` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A)(c) payable only if the circumstances are otherwise as prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A)(d) any amount payable in prescribed circumstances recoverable by the Secretary of State` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A) some other way` TRUE EQUALS NOTHING
#ASSERT `sch 2 SSFA 6B(5A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 6B(5A)(a) the amount payable reduced in the manner prescribed` FALSE EQUALS NOTHING
-- 7(2A)
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A)(a) the amount payable reduced in the manner prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A)(b) payable only if the offender complies with information obligations the regulations impose` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A)(c) payable only if the circumstances are otherwise as prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A)(d) any amount payable in prescribed circumstances recoverable by the Secretary of State` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A) some other way` TRUE EQUALS NOTHING
#ASSERT `sch 2 SSFA 7(2A) regulations may provide that universal credit is payable as if this applied` `sch 2 SSFA 7(2A)(a) the amount payable reduced in the manner prescribed` FALSE EQUALS NOTHING
-- 9(2A)
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A)(a) the amount payable reduced in the manner prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A)(b) payable only if the offender or the offender's family member, or both, comply with information obligations the regulations impose` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A)(c) payable only if the circumstances are otherwise as prescribed` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A)(d) any amount payable in prescribed circumstances recoverable by the Secretary of State` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A) some other way` TRUE EQUALS NOTHING
#ASSERT `sch 2 SSFA 9(2A) regulations may provide that the family member's universal credit is payable as if this applied` `sch 2 SSFA 9(2A)(a) the amount payable reduced in the manner prescribed` FALSE EQUALS NOTHING

§ `sch 2 -- SPCA`

