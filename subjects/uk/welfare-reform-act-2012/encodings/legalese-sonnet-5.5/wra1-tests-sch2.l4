#ASSERT `sch 2 SPCA 4(1A) the claimant is entitled to state pension credit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 2 SPCA 4(1A) the claimant is entitled to state pension credit` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 2 SPCA 4(1A) the claimant is entitled to state pension credit` FALSE FALSE EQUALS NOTHING
