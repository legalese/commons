IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss113-116`

-- Tests for wra4-ss113-116.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 113 SSAA 115A(1A)`

#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) section 71` EQUALS JUST TRUE
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) section 71ZB` EQUALS JUST TRUE
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) section 71A` EQUALS JUST TRUE
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) section 75` EQUALS JUST TRUE
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) section 76` EQUALS JUST TRUE
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` TRUE `s 113(2) SSAA 115A(1A)(b) some other provision` EQUALS NOTHING
#ASSERT `s 113(2) SSAA 115A(1A) the penalty provision also applies` FALSE `s 113(2) SSAA 115A(1A)(b) section 71ZB` EQUALS NOTHING

§ `s 114 SSAA 115A(3), (3A): the amount of the penalty`

-- 50% of the overpayment, rounded down to the nearest whole penny, with a minimum of 350 and a maximum of 2000 pounds
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 1000 EQUALS 500
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 700 EQUALS 350
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 700.02 EQUALS 350.01
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 699.99 EQUALS 350
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 100 EQUALS 350
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 0 EQUALS 350
-- rounding down to the penny: 50% of 3333.33 is 1666.665, which rounds down to 1666.66
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 3333.33 EQUALS 1666.66
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 3999.99 EQUALS 1999.99
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 4000 EQUALS 2000
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 4000.01 EQUALS 2000
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 4001 EQUALS 2000
#ASSERT `s 114(1) SSAA 115A(3) the amount of the penalty` 50000 EQUALS 2000
#ASSERT `s 114(1) SSAA 115A(3A) the amount of the penalty in a case within subsection (1A)` EQUALS 350

§ `s 115 the cooling-off period (14)`

#ASSERT `s 115(2) SSAA 115A(5) the agreement is withdrawn within the cooling-off period` 0 EQUALS JUST TRUE
#ASSERT `s 115(2) SSAA 115A(5) the agreement is withdrawn within the cooling-off period` 14 EQUALS JUST TRUE
#ASSERT `s 115(2) SSAA 115A(5) the agreement is withdrawn within the cooling-off period` 15 EQUALS NOTHING
#ASSERT `s 115(2) SSAA 115A(5) the agreement is withdrawn within the cooling-off period` (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 115(3) SSAA 115B(6) the agreement is withdrawn within the cooling-off period` 0 EQUALS JUST TRUE
#ASSERT `s 115(3) SSAA 115B(6) the agreement is withdrawn within the cooling-off period` 14 EQUALS JUST TRUE
#ASSERT `s 115(3) SSAA 115B(6) the agreement is withdrawn within the cooling-off period` 15 EQUALS NOTHING

§ `s 116 SSAA 115C(6): definitions`

#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `the Secretary of State` FALSE EQUALS TRUE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `a local authority` TRUE EQUALS TRUE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `a local authority` FALSE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `an authorised person` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `an employment officer` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `Her Majesty's Revenue and Customs` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `the First-tier Tribunal` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `the Upper Tribunal` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `a court` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the body is the appropriate authority` `the Director of Public Prosecutions` TRUE EQUALS FALSE
#ASSERT `s 116(1) SSAA 115C(6) the payment is an overpayment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(6) the payment is an overpayment` NOTHING EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(6) the benefit is a relevant social security benefit` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 116(1) SSAA 115C(6) the benefit is a relevant social security benefit` NOTHING EQUALS NOTHING

§ `s 116 SSAA 115C(1) to (5): incorrect statements`

-- args: (a)(i) claim, (a)(ii) award, (b) failed to correct, (c) overpayment resulted, (d) charged/cautioned/notice
#ASSERT `s 116(1) SSAA 115C(1) the section applies` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(1) the section applies` FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(1) the section applies` FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(1) the section applies` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(1) the section applies` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(1) the section applies` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(2)(a) a penalty may be imposed on the person` TRUE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(2)(a) a penalty may be imposed on the person` FALSE EQUALS NOTHING
-- (2)(b) with (3): on B instead of A, unless B was not and could not reasonably be expected to have been aware
#ASSERT `s 116(1) SSAA 115C(2)(b) a penalty may be imposed on the other joint claimant instead` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(2)(b) a penalty may be imposed on the other joint claimant instead` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 116(1) SSAA 115C(2)(b) a penalty may be imposed on the other joint claimant instead` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(2)(b) a penalty may be imposed on the other joint claimant instead` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(4) the penalty is recoverable from the person` TRUE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(4) the penalty is recoverable from the person` FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115C(5) the penalty may be recovered in this way` `deduction from benefit` EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(5) the penalty may be recovered in this way` `deduction from earnings` EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(5) the penalty may be recovered in this way` `court action` EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115C(5) the penalty may be recovered in this way` `adjustment of benefit` EQUALS NOTHING

§ `s 116 SSAA 115D: failure to disclose information`

-- args: failed, reasonable excuse, overpayment resulted, charged/cautioned/notice
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- (3) joint claimants who both fail: only one penalty for the same overpayment
#ASSERT `s 116(1) SSAA 115D(3) a further penalty may be imposed for the same overpayment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 116(1) SSAA 115D(3) a further penalty may be imposed for the same overpayment` TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(3) a further penalty may be imposed for the same overpayment` FALSE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(4) the penalty is recoverable from the person` TRUE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(4) the penalty is recoverable from the person` FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(5) the penalty may be recovered in this way` `court action` EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(5) the penalty may be recovered in this way` `adjustment of benefit` EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(6) the change is a relevant change of circumstances` TRUE EQUALS TRUE
#ASSERT `s 116(1) SSAA 115D(6) the change is a relevant change of circumstances` FALSE EQUALS FALSE

-- 115D(1) and (2): "A AND NOT B AND C AND NOT D" must read each NOT on its own (a bare NOT would swallow the rest of the line).
-- args: failed, had a reasonable excuse, the failure resulted in an overpayment, already charged or cautioned or given a notice
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(1) a penalty may be imposed for failing to provide information` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 116(1) SSAA 115D(2) a penalty may be imposed for failing to notify a change of circumstances` FALSE FALSE TRUE FALSE EQUALS NOTHING
