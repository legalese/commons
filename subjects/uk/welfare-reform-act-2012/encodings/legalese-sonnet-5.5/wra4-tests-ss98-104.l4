IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss98-104`

-- Tests for wra4-ss98-104.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 99(3) SSAA 5(1A): regulations may require a person of a prescribed description to supply information`

#ASSERT `s 99(3) SSAA 5(1A) regulations may require the person to supply the information` (JUST TRUE) TRUE EQUALS JUST TRUE
-- information that is not and could not be relevant is outside the paragraph's words
#ASSERT `s 99(3) SSAA 5(1A) regulations may require the person to supply the information` (JUST TRUE) FALSE EQUALS NOTHING
-- not of a prescribed description: the text says nothing about anyone else
#ASSERT `s 99(3) SSAA 5(1A) regulations may require the person to supply the information` (JUST FALSE) TRUE EQUALS NOTHING
-- the description is for regulations, which are not among the sources
#ASSERT `s 99(3) SSAA 5(1A) regulations may require the person to supply the information` NOTHING TRUE EQUALS NOTHING

§ `s 100 SSAA 5(3B): joint payments`

#ASSERT `s 100 SSAA 5(3B) the Secretary of State may be given power to direct the payment in this way` TRUE `s 100 SSAA 5(3B)(a) to whichever of them they nominate` EQUALS JUST TRUE
#ASSERT `s 100 SSAA 5(3B) the Secretary of State may be given power to direct the payment in this way` TRUE `s 100 SSAA 5(3B)(b) to one of them irrespective of any nomination` EQUALS JUST TRUE
-- only "in the case of a benefit awarded to persons jointly"
#ASSERT `s 100 SSAA 5(3B) the Secretary of State may be given power to direct the payment in this way` FALSE `s 100 SSAA 5(3B)(a) to whichever of them they nominate` EQUALS NOTHING
#ASSERT `s 100 SSAA 5(3B) the Secretary of State may be given power to direct the payment in this way` FALSE `s 100 SSAA 5(3B)(b) to one of them irrespective of any nomination` EQUALS NOTHING

§ `s 101(1) SSAA 5(1)(r): payments on account`

-- (i) impracticable to determine or pay at once; (ii) in cases of need; (iii) the Secretary of State considers it recoverable
#ASSERT `s 101(1) SSAA 5(1)(r) regulations may provide for a payment on account in this case` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 101(1) SSAA 5(1)(r) regulations may provide for a payment on account in this case` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 101(1) SSAA 5(1)(r) regulations may provide for a payment on account in this case` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 101(1) SSAA 5(1)(r) regulations may provide for a payment on account in this case` FALSE FALSE FALSE EQUALS NOTHING

§ `s 102: right of appeal and consideration of revision (seam 8)`

-- 12(2)(b): a right of appeal "where regulations under subsection (3A) so provide"
#ASSERT `s 102(2) SSA1998 12(2)(b) there is a right of appeal because regulations so provide` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 102(2) SSA1998 12(2)(b) there is a right of appeal because regulations so provide` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 102(2) SSA1998 12(2)(b) there is a right of appeal because regulations so provide` NOTHING EQUALS NOTHING
-- 12(3A): "a right of appeal ... only if the Secretary of State has considered whether to revise the decision": the four rows of PLAN.md section 8
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 102(3) SSA1998 12(3A) there is a right of appeal` (JUST TRUE) TRUE EQUALS NOTHING
-- 12(3B): "that condition is met only where" (a), (b) or (c)
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(a) the consideration was on an application`) TRUE EQUALS JUST TRUE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(a) the consideration was on an application`) FALSE EQUALS JUST FALSE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(b) the Secretary of State considered issues of a specified description`) TRUE EQUALS JUST TRUE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(b) the Secretary of State considered issues of a specified description`) FALSE EQUALS JUST FALSE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(c) the consideration satisfied another condition the regulations specify`) TRUE EQUALS JUST TRUE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` (JUST `s 102(3) SSA1998 12(3B)(c) the consideration satisfied another condition the regulations specify`) FALSE EQUALS JUST FALSE
#ASSERT `s 102(3) SSA1998 12(3B) the consideration meets the condition the regulations set` NOTHING TRUE EQUALS NOTHING
-- 12(3C)
#ASSERT `s 102(3) SSA1998 12(3C) the references to the Secretary of State and regulations are read as the other person's` TRUE EQUALS JUST TRUE
#ASSERT `s 102(3) SSA1998 12(3C) the references to the Secretary of State and regulations are read as the other person's` FALSE EQUALS NOTHING
-- 12(7)(b)
#ASSERT `s 102(4) SSA1998 12(7)(b) the purported appeal may be treated as an application for revision` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 102(4) SSA1998 12(7)(b) the purported appeal may be treated as an application for revision` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 102(4) SSA1998 12(7)(b) the purported appeal may be treated as an application for revision` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 102(4) SSA1998 12(7)(b) the purported appeal may be treated as an application for revision` FALSE (JUST TRUE) EQUALS NOTHING

§ `s 103(2): deemed in force on 3 November 2008`

#ASSERT `s 103(2)(a) the Schedule 12 amendments have effect on the day` (Date 3 11 2008) EQUALS JUST TRUE
#ASSERT `s 103(2)(a) the Schedule 12 amendments have effect on the day` (Date 4 11 2008) EQUALS JUST TRUE
#ASSERT `s 103(2)(a) the Schedule 12 amendments have effect on the day` (Date 2 11 2008) EQUALS NOTHING
#ASSERT `s 103(2)(b) the regulations have effect on the day` (JUST TRUE) (Date 3 11 2008) EQUALS JUST TRUE
#ASSERT `s 103(2)(b) the regulations have effect on the day` (JUST TRUE) (Date 2 11 2008) EQUALS NOTHING
#ASSERT `s 103(2)(b) the regulations have effect on the day` (JUST FALSE) (Date 3 11 2008) EQUALS NOTHING
#ASSERT `s 103(2)(b) the regulations have effect on the day` NOTHING (Date 3 11 2008) EQUALS NOTHING

§ `s 104: electronic communications reading rules`

#ASSERT `s 104(1) SSAA 189(5B) the reference is read as` `s 104 a reference to an order under section 8` EQUALS JUST `s 104 read as a reference to regulations under the Act`
#ASSERT `s 104(1) SSAA 189(5B) the reference is read as` `s 104 a reference to anything authorised by such an order` EQUALS JUST `s 104 read as a reference to anything required or authorised by such regulations`
#ASSERT `s 104(1) SSAA 189(5B) the reference is read as` `s 104 any other reference` EQUALS NOTHING
#ASSERT `s 104(2) SSA1998 79(6B) the reference is read as` `s 104 a reference to an order under section 8` EQUALS JUST `s 104 read as a reference to regulations under the Act`
#ASSERT `s 104(2) SSA1998 79(6B) the reference is read as` `s 104 a reference to anything authorised by such an order` EQUALS JUST `s 104 read as a reference to anything required or authorised by such regulations`
#ASSERT `s 104(2) SSA1998 79(6B) the reference is read as` `s 104 any other reference` EQUALS NOTHING
