    `s 49(5) JSA 35(1) work preparation requirement`
    `s 49(5) JSA 35(1) work search requirement`
    `s 49(5) JSA 35(1) work-focused interview requirement`
    `s 49(5) JSA 35(1) work-related requirement`

-- src:868 | “work availability requirement” has the meaning given by section 6E;
-- src:869 | “work preparation requirement” has the meaning given by section 6C;
-- src:870 | “work search requirement” has the meaning given by section 6D;
-- src:871 | “work-focused interview requirement” has the meaning given by section 6B;
-- src:872 | “work-related requirement” has the meaning given by section 6;
@ref s 49(5) JSA 35(1) (src:868-872)
GIVEN `the term` IS A `s 49(5) JSA 35(1) term`
GIVETH A STRING
`s 49(5) JSA 35(1) the section that gives the meaning of the term` MEANS
    CONSIDER `the term`
    WHEN `s 49(5) JSA 35(1) work availability requirement` THEN "6E"
    WHEN `s 49(5) JSA 35(1) work preparation requirement` THEN "6C"
    WHEN `s 49(5) JSA 35(1) work search requirement` THEN "6D"
    WHEN `s 49(5) JSA 35(1) work-focused interview requirement` THEN "6B"
    WHEN `s 49(5) JSA 35(1) work-related requirement` THEN "6"

§ `s 49: the provision that reduces an award`

DECLARE `s 49 JSA section` IS ONE OF
    `s 49 JSA 6J higher-level sanctions`
    `s 49 JSA 6K other sanctions`

-- Seam 9 of PLAN.md: the core's list of provisions that reduce an award; this part maps each section it inserts to one constructor.
-- src:795 | 6J Higher-level sanctions
-- src:818 | 6K Other sanctions
@ref s 49 JSA 6J and 6K (src:795 src:818)
GIVEN `the section` IS A `s 49 JSA section`
GIVETH A `Provision that reduces an award`
`s 49 JSA 6J and 6K the provision that reduces an award` MEANS
    CONSIDER `the section`
    WHEN `s 49 JSA 6J higher-level sanctions` THEN `jobseeker's allowance higher-level sanction after universal credit`
    WHEN `s 49 JSA 6K other sanctions` THEN `jobseeker's allowance other sanction after universal credit`
