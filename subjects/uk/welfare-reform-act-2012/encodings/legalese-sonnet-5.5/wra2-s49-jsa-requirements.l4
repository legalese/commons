        THEN NOTHING
        IF `it is imposed by regulations`
        THEN JUST TRUE
        -- the Secretary of State "may in any particular case specify further such limitations"
        IF `who imposes the limitation` EQUALS `the Secretary of State`
        THEN JUST TRUE
        -- NOTHING-kind (limited by its own wording): only regulations and the Secretary of State are given the power
        OTHERWISE NOTHING

