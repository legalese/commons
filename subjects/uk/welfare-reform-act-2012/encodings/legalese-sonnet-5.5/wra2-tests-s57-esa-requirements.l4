IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s57-esa-requirements`

-- wra2-tests-s57-esa-requirements.l4: tests for s 57 (WRA2007 ss 11 to 11K, s 24 definitions, Sch 2 paras 10ZA and 10B).
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 962-1132), not from the output.

`a child aged 15` MEANS Person WITH
    `reference` IS "child15"
    `age in years` IS 15
    `date of birth` IS Date 1 1 1999
    `where the person is` IS `England outside Greater London`
    `where the person lives` IS `England outside Greater London`

`a person aged 16` MEANS Person WITH
    `reference` IS "person16"
    `age in years` IS 16
    `date of birth` IS Date 1 1 1998
    `where the person is` IS `England outside Greater London`
    `where the person lives` IS `England outside Greater London`

§ `s 57 WRA2007 11: work-related requirements`

-- line 965: the provisions provide for the Secretary of State to impose requirements with which persons entitled must comply
#ASSERT `s 57 WRA2007 11(1) the person must comply with the work-related requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11(1) the person must comply with the work-related requirement` FALSE EQUALS NOTHING
-- lines 966-968: work-related requirement means (a) a work-focused interview requirement, (b) a work preparation requirement
#ASSERT `s 57 WRA2007 11B(1) the requirement is a work-focused interview requirement` `s 57 WRA2007 11B(1) to participate in one or more work-focused interviews as specified by the Secretary of State`
#ASSERT NOT (`s 57 WRA2007 11B(1) the requirement is a work-focused interview requirement` `s 57 WRA2007 11C(1) to take particular action specified by the Secretary of State to make paid work more likely in the opinion of the Secretary of State`)
#ASSERT `s 57 WRA2007 11C(1) the requirement is a work preparation requirement` `s 57 WRA2007 11C(1) to take particular action specified by the Secretary of State to make paid work more likely in the opinion of the Secretary of State`
#ASSERT NOT (`s 57 WRA2007 11C(1) the requirement is a work preparation requirement` `s 57 WRA2007 11 to do something else`)
#ASSERT `s 57 WRA2007 11(2) the requirement is a work-related requirement` `s 57 WRA2007 11B(1) to participate in one or more work-focused interviews as specified by the Secretary of State`
#ASSERT `s 57 WRA2007 11(2) the requirement is a work-related requirement` `s 57 WRA2007 11C(1) to take particular action specified by the Secretary of State to make paid work more likely in the opinion of the Secretary of State`
#ASSERT NOT (`s 57 WRA2007 11(2) the requirement is a work-related requirement` `s 57 WRA2007 11 to do something else`)
#ASSERT `s 57 WRA2007 11(2) the requirement is one of the work-related requirements of this Part` `work-focused interview requirement`
#ASSERT `s 57 WRA2007 11(2) the requirement is one of the work-related requirements of this Part` `work preparation requirement`
-- a work search requirement and a work availability requirement are not among the two the Part defines
#ASSERT NOT (`s 57 WRA2007 11(2) the requirement is one of the work-related requirements of this Part` `work search requirement`)
#ASSERT NOT (`s 57 WRA2007 11(2) the requirement is one of the work-related requirements of this Part` `work availability requirement`)
-- lines 969-972: three groups, mapped to the core's list
#ASSERT `s 57 WRA2007 11(3) the core's group of claimants by requirement` `s 57 WRA2007 11(3)(a) persons subject to no work-related requirements (see section 11D)` EQUALS `no work-related requirements`
#ASSERT `s 57 WRA2007 11(3) the core's group of claimants by requirement` `s 57 WRA2007 11(3)(b) persons subject to work-focused interview requirement only (see section 11E)` EQUALS `work-focused interview requirement only`
#ASSERT `s 57 WRA2007 11(3) the core's group of claimants by requirement` `s 57 WRA2007 11(3)(c) persons subject to work-focused interview and work preparation requirements (see section 11F)` EQUALS `work-focused interview and work preparation requirements only`

§ `s 57 WRA2007 11A: claimant commitment`

-- line 974: a claimant commitment is a record of the responsibilities of a person entitled to an ESA in relation to the award
#ASSERT `s 57 WRA2007 11A(1) the document is a claimant commitment` TRUE `contributory employment and support allowance`
#ASSERT `s 57 WRA2007 11A(1) the document is a claimant commitment` TRUE `income-related employment and support allowance`
#ASSERT NOT (`s 57 WRA2007 11A(1) the document is a claimant commitment` FALSE `contributory employment and support allowance`)
#ASSERT NOT (`s 57 WRA2007 11A(1) the document is a claimant commitment` TRUE `universal credit`)
-- line 975: prepared by the Secretary of State (11K(1): or an authorised person)
#ASSERT `s 57 WRA2007 11A(2) the claimant commitment was prepared by the Secretary of State` `the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11A(2) the claimant commitment was prepared by the Secretary of State` `an authorised person` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11A(2) the claimant commitment was prepared by the Secretary of State` `an employment officer` EQUALS NOTHING
-- line 976
#ASSERT `s 57 WRA2007 11A(3) the claimant commitment is in the form the Secretary of State thinks fit` TRUE
#ASSERT NOT (`s 57 WRA2007 11A(3) the claimant commitment is in the form the Secretary of State thinks fit` FALSE)
-- lines 977-980: (a) a record of the requirements, (b) any prescribed information, (c) any other information the Secretary of State considers appropriate
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11A(4) the claimant commitment includes what the subsection requires` FALSE NOTHING TRUE EQUALS JUST FALSE
-- line 981: accepts if, and only if, the claimant accepts the most up-to-date version in the prescribed manner
#ASSERT `s 57 WRA2007 11A(5) the person accepts the claimant commitment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11A(5) the person accepts the claimant commitment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11A(5) the person accepts the claimant commitment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 57 WRA2007 11A(5) the person accepts the claimant commitment` FALSE NOTHING EQUALS JUST FALSE

§ `s 57 WRA2007 11B and 11C: the two requirements`

-- line 984: a work-focused interview is an interview for prescribed purposes relating to work or work preparation
#ASSERT `s 57 WRA2007 11B(2) the interview is a work-focused interview` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11B(2) the interview is a work-focused interview` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11B(2) the interview is a work-focused interview` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 57 WRA2007 11B(2) the interview is a work-focused interview` (JUST TRUE) FALSE EQUALS JUST FALSE
-- line 985: the purposes which may be prescribed include in particular one purpose
#ASSERT `s 57 WRA2007 11B(3) the purpose may be prescribed under subsection (2)` `s 57 WRA2007 11B(3) making it more likely, in the opinion of the Secretary of State, that the person will obtain paid work (or more paid work or better-paid work)` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11B(3) the purpose may be prescribed under subsection (2)` `s 57 WRA2007 11B(3) some other purpose` EQUALS NOTHING
-- line 986: how, when and where
#ASSERT `s 57 WRA2007 11B(4) the Secretary of State may specify that matter` `s 57 WRA2007 11B(4) how the interview is to take place` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11B(4) the Secretary of State may specify that matter` `s 57 WRA2007 11B(4) when the interview is to take place` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11B(4) the Secretary of State may specify that matter` `s 57 WRA2007 11B(4) where the interview is to take place` EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11B(4) the Secretary of State may specify that matter` `s 57 WRA2007 11B(4) some other matter` EQUALS NOTHING
-- line 989: the time to be devoted to any particular action
#ASSERT `s 57 WRA2007 11C(2) the Secretary of State may specify the time to be devoted to the action` TRUE EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(2) the Secretary of State may specify the time to be devoted to the action` FALSE EQUALS NOTHING
-- lines 990-998: the listed actions, and the health-related assessment
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(a) attending a skills assessment` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(b) improving personal presentation` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(c) participating in training` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(d) participating in an employment programme` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(e) undertaking work experience or a work placement` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(f) developing a business plan` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(g) any action prescribed for the purpose in subsection (1)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(g) any action prescribed for the purpose in subsection (1)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3)(g) any action prescribed for the purpose in subsection (1)` NOTHING EQUALS NOTHING
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(4) taking part in a work-focused health-related assessment` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(3) the action may be specified under subsection (1)` `s 57 WRA2007 11C(3) some other action` NOTHING EQUALS NOTHING
-- lines 999-1001: work-focused health-related assessment
#ASSERT `s 57 WRA2007 11C(5) the assessment is a work-focused health-related assessment` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(5) the assessment is a work-focused health-related assessment` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 57 WRA2007 11C(5) the assessment is a work-focused health-related assessment` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11C(5) the assessment is a work-focused health-related assessment` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11C(5) the assessment is a work-focused health-related assessment` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- lines 1002-1006: health care professional
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6)(a) a registered medical practitioner` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6)(b) a registered nurse` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6)(c) an occupational therapist or physiotherapist registered with a regulatory body established by an Order in Council under section 60 of the Health Act 1999` NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6)(d) a member of another profession regulated by a body mentioned in section 25(3) of the National Health Service Reform and Health Care Professions Act 2002` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6)(d) a member of another profession regulated by a body mentioned in section 25(3) of the National Health Service Reform and Health Care Professions Act 2002` NOTHING EQUALS NOTHING
#ASSERT `s 57 WRA2007 11C(6) the professional is a health care professional` `s 57 WRA2007 11C(6) some other kind of professional` (JUST TRUE) EQUALS JUST FALSE

§ `s 57 WRA2007 24: the terms the section adds`

-- line 1108: "child" means a person under the age of 16
#ASSERT `s 57(4) WRA2007 24(1) the person is a child` `a child aged 15`
#ASSERT NOT (`s 57(4) WRA2007 24(1) the person is a child` `a person aged 16`)
-- line 1109: "single person" means an individual who is not a member of a couple
#ASSERT `s 57(4) WRA2007 24(1) the person is a single person` FALSE
#ASSERT NOT (`s 57(4) WRA2007 24(1) the person is a single person` TRUE)
-- line 1110: "work" has such meaning as may be prescribed
#ASSERT `s 57(4) WRA2007 24(1) the activity is work` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57(4) WRA2007 24(1) the activity is work` NOTHING EQUALS NOTHING
-- lines 1111-1113: the three pointers
#ASSERT `s 57(4) WRA2007 24(1) the section that gives the meaning of the term` `s 57(4) WRA2007 24(1) work-focused interview requirement` EQUALS "11B"
#ASSERT `s 57(4) WRA2007 24(1) the section that gives the meaning of the term` `s 57(4) WRA2007 24(1) work preparation requirement` EQUALS "11C"
#ASSERT `s 57(4) WRA2007 24(1) the section that gives the meaning of the term` `s 57(4) WRA2007 24(1) work-related requirement` EQUALS "11"
-- lines 1114-1115: "work-related activity" means activity which makes it more likely that the person will obtain or remain in work or be able to do so
#ASSERT `s 57(4)(b) WRA2007 24(1) the activity is work-related activity` TRUE FALSE FALSE
#ASSERT `s 57(4)(b) WRA2007 24(1) the activity is work-related activity` FALSE TRUE FALSE
#ASSERT `s 57(4)(b) WRA2007 24(1) the activity is work-related activity` FALSE FALSE TRUE
#ASSERT NOT (`s 57(4)(b) WRA2007 24(1) the activity is work-related activity` FALSE FALSE FALSE)
-- lines 1129-1131: Sch 2 para 10B, circumstances in which a person is or is not responsible for a child
#ASSERT `s 57(8) WRA2007 Sch 2 para 10B the person is responsible for the child` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57(8) WRA2007 Sch 2 para 10B the person is responsible for the child` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57(8) WRA2007 Sch 2 para 10B the person is responsible for the child` NOTHING EQUALS NOTHING

§ `s 57 WRA2007 11D: persons subject to no work-related requirements`

-- lines 1015-1017: both meanings are left to regulations
#ASSERT `s 57 WRA2007 11D(4) the responsibilities are regular and substantial caring responsibilities` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(4) the responsibilities are regular and substantial caring responsibilities` NOTHING EQUALS NOTHING
#ASSERT `s 57 WRA2007 11D(4) the person cared for is severely disabled` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(4) the person cared for is severely disabled` NOTHING EQUALS NOTHING
