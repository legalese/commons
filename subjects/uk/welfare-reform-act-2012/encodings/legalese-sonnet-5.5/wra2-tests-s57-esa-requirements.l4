-- (a) limited capability for work and work-related activity
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` TRUE (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) 5 (JUST FALSE) EQUALS JUST TRUE
-- (b) caring responsibilities for a severely disabled person: both regulations' meanings must be met
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST TRUE) (JUST TRUE) TRUE (JUST FALSE) 5 (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST TRUE) (JUST FALSE) TRUE (JUST FALSE) 5 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST TRUE) NOTHING TRUE (JUST FALSE) 5 (JUST FALSE) EQUALS NOTHING
-- (c) a single person responsible for a child under the age of 1
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) 0 (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) 1 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) TRUE (JUST TRUE) 0 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) 0 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) FALSE NOTHING 0 (JUST FALSE) EQUALS NOTHING
-- (d) a prescribed description
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) 5 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) 5 NOTHING EQUALS NOTHING
-- none of the four: a failed "if" (reading (a) of NOTES)
#ASSERT `s 57 WRA2007 11D(2) the person falls within section 11D` FALSE (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) 5 (JUST FALSE) EQUALS JUST FALSE
-- line 1008: may not impose any work-related requirement
#ASSERT `s 57 WRA2007 11D(1) the Secretary of State may impose a work-related requirement on the person` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11D(1) the Secretary of State may impose a work-related requirement on the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11D(1) the Secretary of State may impose a work-related requirement on the person` NOTHING EQUALS NOTHING
-- line 1014: a requirement previously applying ceases to have effect
#ASSERT `s 57 WRA2007 11D(3) the earlier work-related requirement has ceased to have effect` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11D(3) the earlier work-related requirement has ceased to have effect` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 57 WRA2007 11D(3) the earlier work-related requirement has ceased to have effect` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 57 WRA2007 11D(3) the earlier work-related requirement has ceased to have effect` NOTHING TRUE EQUALS NOTHING

§ `s 57 WRA2007 11E: persons subject to work-focused interview requirement only`

-- lines 1019-1021: the arguments are (couple, responsible for the child, the child's age, the prescribed age, prescribed description)
-- (a) a single person responsible for a child aged at least 1 and under the prescribed age (not less than 3)
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 1 (JUST 5) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 4 (JUST 5) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 5 (JUST 5) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 0 (JUST 5) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 (JUST 3) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 3 (JUST 3) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` TRUE (JUST TRUE) 2 (JUST 5) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST FALSE) 2 (JUST 5) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE NOTHING 2 (JUST 5) (JUST FALSE) EQUALS NOTHING
-- the prescribed age may not be less than 3: a prescribed age of 2 is outside what the subsection allows
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 1 (JUST 2) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING (JUST FALSE) EQUALS JUST TRUE
-- line 1020, prescribed age UNKNOWN (NOTHING): "(which may not be less than 3)" bounds it, so every age the regulations may prescribe is at least 3
-- a child under 1 is not "aged at least 1" whatever age is prescribed: the age part is false
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 0 NOTHING (JUST FALSE) EQUALS JUST FALSE
-- a child aged 1 or 2 is "aged at least 1" and under every age that may be prescribed: the age part is true
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 1 NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING (JUST FALSE) EQUALS JUST TRUE
-- a child aged 3 or more is under the prescribed age only if the prescribed age is above the child's age, which is not in the text
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 3 NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 4 NOTHING (JUST FALSE) EQUALS NOTHING
-- the other inputs of limb (a) and limb (b) still bind when the prescribed age is unknown
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` TRUE (JUST TRUE) 2 NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST FALSE) 2 NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE NOTHING 2 NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE NOTHING 0 NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 0 NOTHING NOTHING EQUALS NOTHING
-- carried through to 11E(2), 11E(3) and the groups of 11(3), for a single person responsible for a child of 2 and then of 0 and 3
#ASSERT `s 57 WRA2007 11E(3) the Secretary of State may impose a work preparation requirement` (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 57 WRA2007 11E(3) the Secretary of State may impose a work preparation requirement` (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 0 NOTHING (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11E(3) the Secretary of State may impose a work preparation requirement` (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 3 NOTHING (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11E(2) the Secretary of State may impose a work-focused interview requirement` TRUE (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING (JUST FALSE)) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 57 WRA2007 11E(2) the Secretary of State may impose a work-focused interview requirement` TRUE (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 3 NOTHING (JUST FALSE)) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57 WRA2007 11(3) the group the person falls into` (JUST FALSE) (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 2 NOTHING (JUST FALSE)) EQUALS JUST `s 57 WRA2007 11(3)(b) persons subject to work-focused interview requirement only (see section 11E)`
#ASSERT `s 57 WRA2007 11(3) the group the person falls into` (JUST TRUE) (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 0 NOTHING (JUST FALSE)) EQUALS JUST `s 57 WRA2007 11(3)(a) persons subject to no work-related requirements (see section 11D)`
#ASSERT `s 57 WRA2007 11(3) the group the person falls into` (JUST FALSE) (`s 57 WRA2007 11E(1) the person falls within section 11E` FALSE (JUST TRUE) 3 NOTHING (JUST FALSE)) EQUALS NOTHING
