#ASSERT `Under section 96(10), I am a single person for the purposes of the benefit cap` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `Under section 96(10), I am a single person for the purposes of the benefit cap` NOTHING EQUALS NOTHING
