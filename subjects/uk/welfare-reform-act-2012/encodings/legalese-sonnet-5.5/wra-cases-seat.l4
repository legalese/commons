#ASSERT `Under section 96(5A), the annual limit that applies to me` (JUST TRUE) (JUST `s 96(5A) the first figure`) EQUALS JUST 25323
#ASSERT `Under section 96(5A), the annual limit that applies to me` (JUST TRUE) (JUST `s 96(5A) the second figure`) EQUALS JUST 16967
#ASSERT `Under section 96(5A), the annual limit that applies to me` (JUST FALSE) (JUST `s 96(5A) the first figure`) EQUALS JUST 22020
#ASSERT `Under section 96(5A), the annual limit that applies to me` (JUST FALSE) (JUST `s 96(5A) the second figure`) EQUALS JUST 14753
