IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s46-jsa-sanctions`

-- wra2-tests-s46-jsa-sanctions.l4: tests for s 46 (JSA 19, 19A, 19B, 19C, Sch 1 para 14AA).
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 580-683), not from the output.

§ `fixtures`

`a person A` MEANS Person WITH
    `reference` IS "A"
    `age in years` IS 30
    `date of birth` IS Date 1 1 1983
    `where the person is` IS `England outside Greater London`
    `where the person lives` IS `England outside Greater London`

`a person B` MEANS Person WITH
    `reference` IS "B"
    `age in years` IS 31
    `date of birth` IS Date 1 1 1982
    `where the person is` IS `England outside Greater London`
    `where the person lives` IS `England outside Greater London`

`a couple A and B` MEANS `Two people` WITH
    `the first person` IS `a person A`
    `the second person` IS `a person B`
    `their relationship` IS `Relationship of two people` WITH
        `married to each other or civil partners of each other` IS TRUE
        `members of the same household` IS TRUE
        `living together as if married or civil partners` IS FALSE

`no s 19 limb` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS FALSE
    `the claimant voluntarily leaves such employment` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

`s 19(2)(a) only` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS TRUE
    `the claimant voluntarily leaves such employment` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

`s 19(2)(b) only` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS FALSE
    `the claimant voluntarily leaves such employment` IS TRUE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

`s 19(2)(c) only` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS FALSE
    `the claimant voluntarily leaves such employment` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS TRUE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

`s 19(2)(d) only` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS FALSE
    `the claimant voluntarily leaves such employment` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS TRUE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

`s 19(2)(e) only` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS FALSE
    `the claimant voluntarily leaves such employment` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS TRUE

`s 19(2)(a) and (b)` MEANS `s 46 JSA 19(2) failure` WITH
    `through misconduct the claimant loses employment as an employed earner` IS TRUE
    `the claimant voluntarily leaves such employment` IS TRUE
    `the claimant refuses or fails to apply for, or accept if offered, a situation in employment that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of employment` IS FALSE
    `the claimant fails to participate in a scheme within section 17A(1) prescribed for the purposes of section 19` IS FALSE

§ `Sch 1 para 14AA(a): good reason`

-- lines 677-679: regulations may provide for circumstances in which a person is to be treated as having or not having a good reason
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` TRUE (JUST `s 46(3) JSA Sch 1 para 14AA treated as having a good reason`) EQUALS JUST TRUE
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` FALSE (JUST `s 46(3) JSA Sch 1 para 14AA treated as having a good reason`) EQUALS JUST TRUE
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` TRUE (JUST `s 46(3) JSA Sch 1 para 14AA treated as not having a good reason`) EQUALS JUST FALSE
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` TRUE (JUST `s 46(3) JSA Sch 1 para 14AA regulations do not address the case`) EQUALS JUST TRUE
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` FALSE (JUST `s 46(3) JSA Sch 1 para 14AA regulations do not address the case`) EQUALS JUST FALSE
#ASSERT `s 46(3) JSA Sch 1 para 14AA(a) the claimant has a good reason for the act or omission` TRUE NOTHING EQUALS NOTHING

§ `JSA 19(2): a failure sanctionable under section 19`

-- (a) misconduct has no good-reason element; (b) to (e) are "without a good reason"
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(a) only` NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(a) only` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(b) only` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(b) only` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(b) only` NOTHING (JUST FALSE) EQUALS NOTHING
-- 19(3): regulations treat a person who might otherwise be treated as having left voluntarily as not having left voluntarily
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(b) only` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(b) only` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(c) only` (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(c) only` (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(c) only` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(d) only` (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(d) only` (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(e) only` (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(e) only` (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `no s 19 limb` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `no s 19 limb` NOTHING NOTHING EQUALS JUST FALSE
-- misconduct (a) makes it sanctionable even though the claimant had a good reason for leaving (b)
#ASSERT `s 46 JSA 19(2) the failure is sanctionable under section 19` `s 19(2)(a) and (b)` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE

§ `JSA 19(1), (4), (6), (7)`

#ASSERT `s 46 JSA 19(1) the award is to be reduced in accordance with section 19` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(1) the award is to be reduced in accordance with section 19` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(1) the award is to be reduced in accordance with section 19` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 46 JSA 19(1) the award is to be reduced in accordance with section 19` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(1) the award is to be reduced in accordance with section 19` NOTHING (JUST FALSE) EQUALS NOTHING

#ASSERT `s 46 JSA 19(4)(a) the award after the reduction, in pounds` 100 (JUST 40) EQUALS JUST 60
#ASSERT `s 46 JSA 19(4)(a) the award after the reduction, in pounds` 100 (JUST 100) EQUALS JUST 0
#ASSERT `s 46 JSA 19(4)(a) the award after the reduction, in pounds` 100 (JUST 101) EQUALS NOTHING
#ASSERT `s 46 JSA 19(4)(a) the award after the reduction, in pounds` 100 NOTHING EQUALS NOTHING

-- "not exceeding three years": a reduction beginning on 1 March 2013 may run to 29 February 2016, the day before the third anniversary
#ASSERT `s 46 JSA 19(4)(b) the period of the reduction is within three years` (Date 1 3 2013) (Date 29 2 2016)
#ASSERT NOT (`s 46 JSA 19(4)(b) the period of the reduction is within three years` (Date 1 3 2013) (Date 1 3 2016))
#ASSERT `s 46 JSA 19(4)(b) the period of the reduction is within three years` (Date 1 1 2014) (Date 31 12 2016)
#ASSERT NOT (`s 46 JSA 19(4)(b) the period of the reduction is within three years` (Date 1 1 2014) (Date 1 1 2017))

#ASSERT `s 46 JSA 19(6)(b) the reduction on the terminated award is applied to the new award` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 46 JSA 19(6)(b) the reduction on the terminated award is applied to the new award` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(6)(b) the reduction on the terminated award is applied to the new award` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 46 JSA 19(6)(b) the reduction on the terminated award is applied to the new award` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 46 JSA 19(6)(b) the reduction on the terminated award is applied to the new award` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING

-- 19(7): the allowance is payable to the other member of the couple
#ASSERT `s 46 JSA 19(7) the member of the couple to whom the allowance is payable` `a couple A and B` `s 46 JSA 19(7) the first person` TRUE EQUALS JUST `a person B`
#ASSERT `s 46 JSA 19(7) the member of the couple to whom the allowance is payable` `a couple A and B` `s 46 JSA 19(7) the second person` TRUE EQUALS JUST `a person A`
#ASSERT `s 46 JSA 19(7) the member of the couple to whom the allowance is payable` `a couple A and B` `s 46 JSA 19(7) the first person` FALSE EQUALS NOTHING

§ `JSA 19A`

`s 19A(2)(a) only` MEANS `s 46 JSA 19A(2) failure` WITH
    `the claimant fails to comply with regulations under section 8(1) or (1A)` IS TRUE
    `the claimant fails to comply with regulations under section 17A` IS FALSE
    `the claimant refuses or fails to carry out a jobseeker's direction that was reasonable having regard to the claimant's circumstances` IS FALSE
    `the claimant neglects to avail of a reasonable opportunity of a place on a training scheme or employment programme` IS FALSE
    `the claimant refuses or fails to apply for, or accept if offered, a place on such a scheme or programme that an employment officer has informed the claimant is vacant or about to become vacant` IS FALSE
    `the claimant gives up a place on such a scheme or programme or fails to attend it having been given a place` IS FALSE
    `through misconduct the claimant loses a place on such a scheme or programme` IS FALSE

