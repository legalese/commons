IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-part3`

-- wra2-tests-part3.l4: tests for ss 64 to 76.
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 1237-1343), not from the output.

§ `s 64 injuries arising before 5 July 1948`
#ASSERT `s 64(1) the words are repealed` `s 64(1)(a) in section 94(1), the words "after 4th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1)(b) in section 103(2)(a), the words "after 4th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1)(c) in section 108(1), the words "and which developed after 4th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1)(d) in section 108(3), the words "but not before 5th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1)(e) in section 109(5)(a), the words "after 4th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1)(f) in section 109(5)(b) and (6)(a), the words "and developed after 4th July 1948"` EQUALS JUST TRUE
#ASSERT `s 64(1) the words are repealed` `s 64(1) some other words` EQUALS NOTHING
#ASSERT `s 64(2) the provision is repealed` `s 64(2) section 111 of the Social Security Contributions and Benefits Act 1992` EQUALS JUST TRUE
#ASSERT `s 64(2) the provision is repealed` `s 64(2) Schedule 8 to the Social Security Contributions and Benefits Act 1992` EQUALS JUST TRUE
#ASSERT `s 64(2) the provision is repealed` `s 64(2) some other provision` EQUALS NOTHING
#ASSERT `s 64(3) the Secretary of State may make regulations for that purpose` `s 64(3)(a) for, and in relation to, the payment of industrial injuries benefit to persons to whom compensation or benefits were payable under section 111 of, and Schedule 8 to, the 1992 Act before commencement` EQUALS JUST TRUE
#ASSERT `s 64(3) the Secretary of State may make regulations for that purpose` `s 64(3)(b) for claims for the payment of such compensation or benefit to be treated as claims for industrial injuries benefit` EQUALS JUST TRUE
#ASSERT `s 64(3) the Secretary of State may make regulations for that purpose` `s 64(3) some other purpose` EQUALS NOTHING


§ `s 66 trainees`
#ASSERT `s 66(1) SSCBA 95A(1) the participation is taken to be employed earner's employment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 66(1) SSCBA 95A(1) the participation is taken to be employed earner's employment` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 66(1) SSCBA 95A(1) the participation is taken to be employed earner's employment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 66(1) SSCBA 95A(1) the participation is taken to be employed earner's employment` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 66(1) SSCBA 95A(2) the person is taken to be the employer in relation to the participation` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 66(1) SSCBA 95A(2) the person is taken to be the employer in relation to the participation` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 66(1) SSCBA 95A(2) the person is taken to be the employer in relation to the participation` NOTHING EQUALS NOTHING
#ASSERT `s 66(3) the Secretary of State may make regulations for that purpose` `s 66(3)(a) for, and in relation to, the payment of industrial injuries benefit to persons to whom payments were payable under section 11(3) of the Employment and Training Act 1973 before commencement` EQUALS JUST TRUE
#ASSERT `s 66(3) the Secretary of State may make regulations for that purpose` `s 66(3)(b) for claims for such payments to be treated as claims for industrial injuries benefit` EQUALS JUST TRUE
#ASSERT `s 66(3) the Secretary of State may make regulations for that purpose` `s 66(3) some other purpose` EQUALS NOTHING

