#ASSERT `s 49 JSA 6A(4) the claimant commitment includes what the subsection requires` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 49 JSA 6A(4) the claimant commitment includes what the subsection requires` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 49 JSA 6A(4) the claimant commitment includes what the subsection requires` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 49 JSA 6A(4) the claimant commitment includes what the subsection requires` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 49 JSA 6A(5) the claimant accepts the claimant commitment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 49 JSA 6A(5) the claimant accepts the claimant commitment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 49 JSA 6A(5) the claimant accepts the claimant commitment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 49 JSA 6A(5) the claimant accepts the claimant commitment` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 49 JSA 6A(5) the claimant accepts the claimant commitment` FALSE NOTHING EQUALS JUST FALSE

