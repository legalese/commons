IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss117-119`
IMPORT `wra4-s120-taxcredits`

-- Tests for wra4-s120-taxcredits.l4. Every expected value is written from the text of the Act, beside the assertion.

`s 120(2) TCA test person Ann` MEANS
    Person WITH `reference` IS "ann", `age in years` IS 40, `date of birth` IS Date 1 1 1985, `where the person is` IS Wales, `where the person lives` IS Wales

`s 120(2) TCA test person Bob` MEANS
    Person WITH `reference` IS "bob", `age in years` IS 41, `date of birth` IS Date 1 1 1984, `where the person is` IS Wales, `where the person lives` IS Wales

`s 120(2) TCA test person Cat` MEANS
    Person WITH `reference` IS "cat", `age in years` IS 30, `date of birth` IS Date 1 1 1995, `where the person is` IS Wales, `where the person lives` IS Wales

`s 120(2) TCA test couple Ann and Bob` MEANS
    `joint claimants` (`Two people` WITH
        `the first person` IS `s 120(2) TCA test person Ann`,
        `the second person` IS `s 120(2) TCA test person Bob`,
        `their relationship` IS `Relationship of two people` WITH
            `married to each other or civil partners of each other` IS TRUE,
            `members of the same household` IS TRUE,
            `living together as if married or civil partners` IS TRUE)

`s 120(2) TCA test period` MEANS
    Period WITH `first day` IS Date 1 4 2025, `last day` IS Date 30 6 2025

§ `s 120 TCA 36A(2): appropriate penalty provision and authority`

#ASSERT `s 120(2) TCA 36A(2)(a) the provision is the appropriate penalty provision` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(a) the provision is the appropriate penalty provision` `s 120(2) TCA 36A(2)(a) section 109A of the Social Security Administration (Northern Ireland) Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(a) the provision is the appropriate penalty provision` `s 120(2) TCA 36A(2)(a) some other penalty provision` EQUALS FALSE
-- (i) for section 115A: the Secretary of State or an authority which administers housing benefit or council tax benefit
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Secretary of State` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) an authority which administers housing benefit or council tax benefit` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Northern Ireland Housing Executive` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` EQUALS FALSE
-- (ii) for section 109A: the Department or the Northern Ireland Housing Executive
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Department within the meaning of the Social Security Administration (Northern Ireland) Act 1992` `s 120(2) TCA 36A(2)(a) section 109A of the Social Security Administration (Northern Ireland) Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Northern Ireland Housing Executive` `s 120(2) TCA 36A(2)(a) section 109A of the Social Security Administration (Northern Ireland) Act 1992` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Secretary of State` `s 120(2) TCA 36A(2)(a) section 109A of the Social Security Administration (Northern Ireland) Act 1992` EQUALS FALSE
#ASSERT `s 120(2) TCA 36A(2)(b) the body is an appropriate authority in relation to the provision` `s 120(2) TCA 36A(2)(b) the Secretary of State` `s 120(2) TCA 36A(2)(a) some other penalty provision` EQUALS FALSE

§ `s 120 TCA 36A(10): definitions`

-- args: claim, receipt, facilitating, attempt or conspiracy, date committed, the day the Treasury specified
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` TRUE FALSE FALSE FALSE (Date 2 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` FALSE TRUE FALSE FALSE (Date 1 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` FALSE FALSE TRUE FALSE (Date 1 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` FALSE FALSE FALSE TRUE (Date 1 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` TRUE FALSE FALSE FALSE (Date 31 12 2024) (JUST (Date 1 1 2025)) EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` FALSE FALSE FALSE FALSE (Date 2 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36A(10) the offence is a benefit offence` TRUE FALSE FALSE FALSE (Date 2 1 2025) NOTHING EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(10) the benefit is a disqualifying benefit` `working tax credit` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(10) the benefit is a disqualifying benefit` `income support` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(10) the event is a disqualifying event` `s 120(2) TCA 36A(10) the conviction falling within subsection (1)(a)` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(10) the event is a disqualifying event` `s 120(2) TCA 36A(10) the agreement falling within subsection (1)(b)` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(10) the event is a disqualifying event` `s 120(2) TCA 36A(10) the caution falling within subsection (1)(c)` EQUALS TRUE
#ASSERT `s 120(2) TCA 36A(10) the event is a disqualifying event` `s 120(2) TCA 36A(10) some other event` EQUALS FALSE

§ `s 120 TCA 36A(1), (3), (4): when the credit is not payable`

-- (b): a notice under 115A from the Secretary of State, agreement in the manner specified, offence is a benefit offence
#ASSERT `s 120(2) TCA 36A(1)(b) the person agreed to pay a penalty as the paragraph describes` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` `s 120(2) TCA 36A(2)(b) the Secretary of State` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(1)(b) the person agreed to pay a penalty as the paragraph describes` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` `s 120(2) TCA 36A(2)(b) the Secretary of State` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(1)(b) the person agreed to pay a penalty as the paragraph describes` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` `s 120(2) TCA 36A(2)(b) the Secretary of State` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36A(1)(b) the person agreed to pay a penalty as the paragraph describes` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` `s 120(2) TCA 36A(2)(b) the Northern Ireland Housing Executive` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36A(1)(b) the person agreed to pay a penalty as the paragraph describes` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` `s 120(2) TCA 36A(2)(b) the Secretary of State` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (1): conviction, agreement or caution
#ASSERT `s 120(2) TCA 36A(1) subsection (4) applies by virtue of subsection (1)` TRUE NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(1) subsection (4) applies by virtue of subsection (1)` FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(1) subsection (4) applies by virtue of subsection (1)` FALSE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(1) subsection (4) applies by virtue of subsection (1)` FALSE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(1) subsection (4) applies by virtue of subsection (1)` FALSE NOTHING FALSE EQUALS NOTHING
-- 121(2): the caution ground is repealed
#ASSERT `s 121(2) TCA 36A(1)(c) a caution is a ground for subsection (4)` TRUE EQUALS JUST FALSE
#ASSERT `s 121(2) TCA 36A(1)(c) a caution is a ground for subsection (4)` FALSE EQUALS NOTHING
-- (3)
#ASSERT `s 120(2) TCA 36A(3) subsection (4) does not apply by virtue of subsection (1)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(3) subsection (4) does not apply by virtue of subsection (1)(a)` FALSE EQUALS NOTHING
-- (4): single claim, the offender; joint claim, the offender or the other member of the couple
#ASSERT `s 120(2) TCA 36A(4)(a) the person is among those to whom working tax credit is not payable` (`a single claimant` `s 120(2) TCA test person Ann`) `s 120(2) TCA test person Ann` `s 120(2) TCA test person Ann` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(4)(a) the person is among those to whom working tax credit is not payable` (`a single claimant` `s 120(2) TCA test person Ann`) `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(4)(a) the person is among those to whom working tax credit is not payable` `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Ann` `s 120(2) TCA test person Ann` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(4)(a) the person is among those to whom working tax credit is not payable` `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(4)(a) the person is among those to whom working tax credit is not payable` `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Cat` `s 120(2) TCA test person Ann` EQUALS NOTHING
-- args: applies, would be entitled, claim, person, offender, day, period
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST TRUE) TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 1 4 2025) `s 120(2) TCA test period` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST TRUE) TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 30 6 2025) `s 120(2) TCA test period` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST TRUE) TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 31 3 2025) `s 120(2) TCA test period` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST TRUE) TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 1 7 2025) `s 120(2) TCA test period` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST TRUE) FALSE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 1 5 2025) `s 120(2) TCA test period` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` (JUST FALSE) TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 1 5 2025) `s 120(2) TCA test period` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(4) working tax credit is not payable to the person for the day` NOTHING TRUE `s 120(2) TCA test couple Ann and Bob` `s 120(2) TCA test person Bob` `s 120(2) TCA test person Ann` (Date 1 5 2025) `s 120(2) TCA test period` EQUALS NOTHING

§ `s 120 TCA 36A(6), (7): the disqualification period`

#ASSERT `s 120(2) TCA 36A(7) the relevant period` `s 120(2) TCA 36A(7) a case within subsection (1)(a)` (JUST TRUE) EQUALS JUST `s 120(2) TCA 36A(7) the period of three years`
#ASSERT `s 120(2) TCA 36A(7) the relevant period` `s 120(2) TCA 36A(7) a case within subsection (1)(a)` (JUST FALSE) EQUALS JUST `s 120(2) TCA 36A(7) the period of 13 weeks`
#ASSERT `s 120(2) TCA 36A(7) the relevant period` `s 120(2) TCA 36A(7) a case within subsection (1)(a)` NOTHING EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(7) the relevant period` `s 120(2) TCA 36A(7) a case within subsection (1)(b)` NOTHING EQUALS JUST `s 120(2) TCA 36A(7) the period of 4 weeks`
#ASSERT `s 120(2) TCA 36A(7) the relevant period` `s 120(2) TCA 36A(7) a case within subsection (1)(c)` (JUST TRUE) EQUALS JUST `s 120(2) TCA 36A(7) the period of 4 weeks`
#ASSERT `s 120(2) TCA 36A(7) the last day of the relevant period` `s 120(2) TCA 36A(7) the period of three years` (Date 1 1 2025) EQUALS Date 31 12 2027
#ASSERT `s 120(2) TCA 36A(7) the last day of the relevant period` `s 120(2) TCA 36A(7) the period of 13 weeks` (Date 1 1 2025) EQUALS Date 1 4 2025
#ASSERT `s 120(2) TCA 36A(7) the last day of the relevant period` `s 120(2) TCA 36A(7) the period of 4 weeks` (Date 1 1 2025) EQUALS Date 28 1 2025
#ASSERT `s 120(2) TCA 36A(6) the disqualification period` (Date 1 3 2025) (JUST (Date 1 4 2025)) `s 120(2) TCA 36A(7) the period of 4 weeks` EQUALS JUST (Period WITH `first day` IS Date 1 4 2025, `last day` IS Date 28 4 2025)
#ASSERT `s 120(2) TCA 36A(6) the disqualification period` (Date 1 3 2025) (JUST (Date 1 3 2025)) `s 120(2) TCA 36A(7) the period of 4 weeks` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36A(6) the disqualification period` (Date 1 3 2025) NOTHING `s 120(2) TCA 36A(7) the period of 4 weeks` EQUALS NOTHING

§ `s 120 TCA 36B: supplementary`

#ASSERT `s 120(2) TCA 36B(1) the restriction is to be treated as not imposed` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(1) the restriction is to be treated as not imposed` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36B(1) the restriction is to be treated as not imposed` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36B(1) the restriction is to be treated as not imposed` FALSE TRUE FALSE EQUALS NOTHING
-- (2): args: taken into account, withdrawn, decided not recoverable or due, could have been imposed anyway
#ASSERT `s 120(2) TCA 36B(2) the restriction is to be treated as not imposed` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(2) the restriction is to be treated as not imposed` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(2) the restriction is to be treated as not imposed` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 120(2) TCA 36B(2) the restriction is to be treated as not imposed` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36B(2) the restriction is to be treated as not imposed` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (3), (4)
#ASSERT `s 120(2) TCA 36B(3) section 36A ceases to apply by virtue of the old agreement and subsection (4) applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(3) section 36A ceases to apply by virtue of the old agreement and subsection (4) applies` TRUE FALSE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36B(4) the consequence of the revision` TRUE FALSE EQUALS `s 120(2) TCA 36B(4)(a) the new disqualification period is reduced`
#ASSERT `s 120(2) TCA 36B(4) the consequence of the revision` FALSE TRUE EQUALS `s 120(2) TCA 36B(4)(a) the new disqualification period is reduced`
#ASSERT `s 120(2) TCA 36B(4) the consequence of the revision` FALSE FALSE EQUALS `s 120(2) TCA 36B(4)(b) payments and adjustments are made as if the restriction had not been imposed`
#ASSERT `s 120(2) TCA 36B(4)(a) the number of days in the reduced disqualification period` 91 30 EQUALS 61
#ASSERT `s 120(2) TCA 36B(4)(a) the number of days in the reduced disqualification period` 28 40 EQUALS (0 MINUS 12)
-- (5)
#ASSERT `s 120(2) TCA 36B(5)(a) the date of the conviction` (Date 1 2 2025) FALSE (Date 1 3 2025) EQUALS Date 1 2 2025
#ASSERT `s 120(2) TCA 36B(5)(a) the date of the conviction` (Date 1 2 2025) TRUE (Date 1 3 2025) EQUALS Date 1 3 2025
#ASSERT `s 120(2) TCA 36B(5)(b) the event counts as a conviction for section 36A` `s 120(2) TCA 36B(5)(b) a conviction in Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(5)(b) the event counts as a conviction for section 36A` `s 120(2) TCA 36B(5)(b) a conviction in relation to which the court makes an order for absolute or conditional discharge` EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36B(5)(b) the event counts as a conviction for section 36A` `s 120(2) TCA 36B(5)(b) some other event` EQUALS NOTHING
#ASSERT `s 120(2) TCA 36B(6) the provision is the appropriate penalty provision` `s 120(2) TCA 36A(2)(a) section 115A of the Social Security Administration Act 1992` EQUALS TRUE

§ `s 120 TCA 36C and 36D: repeated benefit fraud`

-- args: convicted, offence dates, event dates, current set not used before, earlier event not used before, would be entitled
#ASSERT `s 120(2) TCA 36C(1) the restriction in subsection (3) applies` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36C(1) the restriction in subsection (3) applies` TRUE (LIST (Date 1 1 2025)) (LIST (Date 1 1 2020)) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36C(1) the restriction in subsection (3) applies` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 120(2) TCA 36C(1) the restriction in subsection (3) applies` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE TRUE FALSE EQUALS NOTHING
