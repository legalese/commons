#ASSERT `s 120(2) TCA 36D(1) the restriction is to be treated as not imposed` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 120(2) TCA 36D(1) the restriction is to be treated as not imposed` TRUE TRUE TRUE EQUALS JUST FALSE
