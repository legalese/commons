IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss127-129`

-- Tests for wra4-ss127-129.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 127(1) to (4): who may supply what to whom`

-- (1): information held for HMRC functions by the Commissioners or a person providing services to them
#ASSERT `s 127(1) subsection (1) applies to the information` TRUE `s 127(1)(a) the Commissioners for Her Majesty's Revenue and Customs` EQUALS TRUE
#ASSERT `s 127(1) subsection (1) applies to the information` TRUE `s 127(1)(b) a person providing services to the Commissioners` EQUALS TRUE
#ASSERT `s 127(1) subsection (1) applies to the information` TRUE `s 127(3)(a) the Secretary of State or a person providing services to the Secretary of State` EQUALS FALSE
#ASSERT `s 127(1) subsection (1) applies to the information` FALSE `s 127(1)(a) the Commissioners for Her Majesty's Revenue and Customs` EQUALS FALSE
-- (3): information held for departmental functions by the Secretary of State or a Northern Ireland Department (or their providers)
#ASSERT `s 127(3) subsection (3) applies to the information` TRUE `s 127(3)(a) the Secretary of State or a person providing services to the Secretary of State` EQUALS TRUE
#ASSERT `s 127(3) subsection (3) applies to the information` TRUE `s 127(3)(b) a Northern Ireland Department or a person providing services to a Northern Ireland Department` EQUALS TRUE
#ASSERT `s 127(3) subsection (3) applies to the information` TRUE `s 127(1)(a) the Commissioners for Her Majesty's Revenue and Customs` EQUALS FALSE
#ASSERT `s 127(3) subsection (3) applies to the information` FALSE `s 127(3)(a) the Secretary of State or a person providing services to the Secretary of State` EQUALS FALSE
-- (2): to the Secretary of State or a Northern Ireland Department, for departmental functions
#ASSERT `s 127(2) information held for HMRC functions may be supplied` TRUE `s 127(2)(a) the Secretary of State or a person providing services to the Secretary of State` `s 127(2) the purposes of departmental functions` EQUALS JUST TRUE
#ASSERT `s 127(2) information held for HMRC functions may be supplied` TRUE `s 127(2)(b) a Northern Ireland Department or a person providing services to a Northern Ireland Department` `s 127(2) the purposes of departmental functions` EQUALS JUST TRUE
#ASSERT `s 127(2) information held for HMRC functions may be supplied` TRUE `s 127(2)(a) the Secretary of State or a person providing services to the Secretary of State` `s 127 some other purpose` EQUALS NOTHING
#ASSERT `s 127(2) information held for HMRC functions may be supplied` TRUE `s 127 some other recipient` `s 127(2) the purposes of departmental functions` EQUALS NOTHING
#ASSERT `s 127(2) information held for HMRC functions may be supplied` FALSE `s 127(2)(a) the Secretary of State or a person providing services to the Secretary of State` `s 127(2) the purposes of departmental functions` EQUALS NOTHING
-- (2A): to the Scottish Ministers, for the Employment and Training Act arrangements
#ASSERT `s 127(2A) information held for HMRC functions may be supplied to the Scottish Ministers` TRUE `s 127(2A) the Scottish Ministers` `s 127(2A) arrangements made by the Scottish Ministers under section 2 of the Employment and Training Act 1973 by virtue of article 2(1) of the Scotland Act 1998 (Transfer of Functions to the Scottish Ministers etc.) Order 2020` EQUALS JUST TRUE
#ASSERT `s 127(2A) information held for HMRC functions may be supplied to the Scottish Ministers` TRUE `s 127(2A) the Scottish Ministers` `s 127(2) the purposes of departmental functions` EQUALS NOTHING
-- (4): to the Commissioners, for HMRC functions
#ASSERT `s 127(4) information held for departmental functions may be supplied` TRUE `s 127(4) the Commissioners for Her Majesty's Revenue and Customs or a person providing services to them` `s 127(4) the purposes of HMRC functions` EQUALS JUST TRUE
#ASSERT `s 127(4) information held for departmental functions may be supplied` TRUE `s 127(4) the Commissioners for Her Majesty's Revenue and Customs or a person providing services to them` `s 127 some other purpose` EQUALS NOTHING
#ASSERT `s 127(4) information held for departmental functions may be supplied` FALSE `s 127(4) the Commissioners for Her Majesty's Revenue and Customs or a person providing services to them` `s 127(4) the purposes of HMRC functions` EQUALS NOTHING

§ `s 127(5), (6), (9): onward supply`

#ASSERT `s 127(5) whose authority the recipient needs before supplying the information to another person` `s 127(5)(a) supplied under subsection (2) or (2A)` EQUALS JUST `s 127(5)(a) the authority of the Commissioners for Her Majesty's Revenue and Customs`
#ASSERT `s 127(5) whose authority the recipient needs before supplying the information to another person` `s 127(5)(b) held as mentioned in subsection (3)(a) and supplied under subsection (4)` EQUALS JUST `s 127(5)(b) the authority of the Secretary of State`
#ASSERT `s 127(5) whose authority the recipient needs before supplying the information to another person` `s 127(5)(c) held as mentioned in subsection (3)(b) and supplied under subsection (4)` EQUALS JUST `s 127(5)(c) the authority of the relevant Northern Ireland Department`
#ASSERT `s 127(5) whose authority the recipient needs before supplying the information to another person` `s 127(5) supplied under this section in some other way` EQUALS NOTHING
-- without the authority: the text says no; with it, the bar is lifted but nothing is granted
#ASSERT `s 127(5) the recipient may supply the information to another person` `s 127(5)(a) supplied under subsection (2) or (2A)` FALSE EQUALS JUST FALSE
#ASSERT `s 127(5) the recipient may supply the information to another person` `s 127(5)(b) held as mentioned in subsection (3)(a) and supplied under subsection (4)` FALSE EQUALS JUST FALSE
#ASSERT `s 127(5) the recipient may supply the information to another person` `s 127(5)(c) held as mentioned in subsection (3)(b) and supplied under subsection (4)` FALSE EQUALS JUST FALSE
#ASSERT `s 127(5) the recipient may supply the information to another person` `s 127(5)(a) supplied under subsection (2) or (2A)` TRUE EQUALS NOTHING
#ASSERT `s 127(5) the recipient may supply the information to another person` `s 127(5) supplied under this section in some other way` FALSE EQUALS NOTHING
#ASSERT `s 127(6) it is lawful to use the information for any purposes for which information held for those purposes could be used` TRUE EQUALS JUST TRUE
#ASSERT `s 127(6) it is lawful to use the information for any purposes for which information held for those purposes could be used` FALSE EQUALS NOTHING
#ASSERT `s 127(9) this section does not limit the supply` TRUE EQUALS JUST TRUE
#ASSERT `s 127(9) this section does not limit the supply` FALSE EQUALS NOTHING
#ASSERT `s 127(10) SSA1998 3(1A)(e) the purpose is within paragraph (e)` TRUE EQUALS JUST TRUE
#ASSERT `s 127(10) SSA1998 3(1A)(e) the purpose is within paragraph (e)` FALSE EQUALS NOTHING

§ `s 127(7), (8): definitions`

#ASSERT `s 127(7) the function is a departmental function` `s 127(7) a function relating to social security` EQUALS TRUE
#ASSERT `s 127(7) the function is a departmental function` `s 127(7) a function relating to employment or training` EQUALS TRUE
#ASSERT `s 127(7) the function is a departmental function` `s 127(7) a function relating to the investigation or prosecution of offences relating to tax credits` EQUALS TRUE
#ASSERT `s 127(7) the function is a departmental function` `s 127(7) a function relating to child support` EQUALS TRUE
#ASSERT `s 127(7) the function is a departmental function` `s 127(7) some other function` EQUALS FALSE
#ASSERT `s 127(7) the function is an HMRC function` `s 127(7) a function conferred by or under the Childcare Payments Act 2014` EQUALS TRUE
#ASSERT `s 127(7) the function is an HMRC function` `s 127(7) a function conferred by or under section 2 of, or Schedule 2 to, the Savings (Government Contributions) Act 2017` EQUALS TRUE
#ASSERT `s 127(7) the function is an HMRC function` `s 127(7) a function for which the Commissioners are responsible by virtue of section 5 of the Commissioners for Revenue and Customs Act 2005` EQUALS TRUE
#ASSERT `s 127(7) the function is an HMRC function` `s 127(7) a function which relates to a matter listed in Schedule 1 to the Commissioners for Revenue and Customs Act 2005` EQUALS TRUE
#ASSERT `s 127(7) the function is an HMRC function` `s 127(7) a function from some other source` EQUALS FALSE
#ASSERT `s 127(7) the department is a Northern Ireland Department` `s 127(7) the Department for Communities` EQUALS TRUE
#ASSERT `s 127(7) the department is a Northern Ireland Department` `s 127(7) the Department of Finance` EQUALS TRUE
#ASSERT `s 127(7) the department is a Northern Ireland Department` `s 127(7) the Department for the Economy` EQUALS TRUE
#ASSERT `s 127(7) the department is a Northern Ireland Department` `s 127(7) some other department` EQUALS FALSE
#ASSERT `s 127(8) the function is treated as relating to social security` `s 127(8)(a) statutory payments as defined in section 4C(11) of the Social Security Contributions and Benefits Act 1992` EQUALS JUST TRUE
#ASSERT `s 127(8) the function is treated as relating to social security` `s 127(8)(d) maternity allowance under section 35 or 35B of that Act` EQUALS JUST TRUE
#ASSERT `s 127(8) the function is treated as relating to social security` `s 127(8) some other function` EQUALS NOTHING

§ `s 128: the Secretary of State and the Director of Public Prosecutions`

#ASSERT `s 128(2) the person is a person specified in subsection (2)` `s 128(2)(a) the Director of Public Prosecutions` EQUALS TRUE
#ASSERT `s 128(2) the person is a person specified in subsection (2)` `s 128(2)(b) a person appointed under section 5 of the Prosecution of Offences Act 1985` EQUALS TRUE
#ASSERT `s 128(2) the person is a person specified in subsection (2)` `s 128(2) some other person` EQUALS FALSE
#ASSERT `s 128(3) the purpose is a purpose specified in subsection (3)` `s 128(3)(a) the institution or conduct of criminal proceedings which relate wholly or partly to social security matters or child support` EQUALS TRUE
#ASSERT `s 128(3) the purpose is a purpose specified in subsection (3)` `s 128(3)(d) the exercise of functions of the Director of Public Prosecutions under Part 2, 5 or 8 of the Proceeds of Crime Act 2002` EQUALS TRUE
#ASSERT `s 128(3) the purpose is a purpose specified in subsection (3)` `s 128 some other purpose` EQUALS FALSE
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128(1) the Secretary of State` `s 128(1) social security information` `s 128(2)(a) the Director of Public Prosecutions` `s 128(3)(b) the giving of advice on any matter relating to criminal proceedings, or criminal offences, which relate wholly or partly to social security matters or child support` EQUALS JUST TRUE
-- (4): a person providing services to the Secretary of State stands in the Secretary of State's place
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128(4) a person providing services to the Secretary of State` `s 128(1) child support information` `s 128(2)(b) a person appointed under section 5 of the Prosecution of Offences Act 1985` `s 128(3)(c) the exercise in relation to social security matters or child support of functions assigned to the Director of Public Prosecutions under section 3(2)(g) of the Prosecution of Offences Act 1985` EQUALS JUST TRUE
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128 some other supplier` `s 128(1) social security information` `s 128(2)(a) the Director of Public Prosecutions` `s 128(3)(b) the giving of advice on any matter relating to criminal proceedings, or criminal offences, which relate wholly or partly to social security matters or child support` EQUALS NOTHING
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128(1) the Secretary of State` `s 128 some other information` `s 128(2)(a) the Director of Public Prosecutions` `s 128(3)(b) the giving of advice on any matter relating to criminal proceedings, or criminal offences, which relate wholly or partly to social security matters or child support` EQUALS NOTHING
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128(1) the Secretary of State` `s 128(1) social security information` `s 128(2) some other person` `s 128(3)(b) the giving of advice on any matter relating to criminal proceedings, or criminal offences, which relate wholly or partly to social security matters or child support` EQUALS NOTHING
#ASSERT `s 128(1) the Secretary of State may supply the information` `s 128(1) the Secretary of State` `s 128(1) social security information` `s 128(2)(a) the Director of Public Prosecutions` `s 128 some other purpose` EQUALS NOTHING
#ASSERT `s 128(6) the information is child support information` TRUE EQUALS TRUE
#ASSERT `s 128(6) the information is child support information` FALSE EQUALS FALSE
#ASSERT `s 128(6) the information is social security information` TRUE EQUALS TRUE
#ASSERT `s 128(6) the information is social security information` FALSE EQUALS FALSE
#ASSERT `s 128(6) the matter is a social security matter` `s 128(6) tax credits` EQUALS TRUE
#ASSERT `s 128(6) the matter is a social security matter` `s 128(6) social security, including the payments and allowances referred to in section 127(8)` EQUALS TRUE
#ASSERT `s 128(6) the matter is a social security matter` `s 128(6) schemes and arrangements under section 2 of the Employment and Training Act 1973` EQUALS TRUE
#ASSERT `s 128(6) the matter is a social security matter` `s 128(6) some other matter` EQUALS FALSE

§ `s 129: unlawful disclosure`

#ASSERT `s 129(1) subsection (1) bars the disclosure` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 129(1) subsection (1) bars the disclosure` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 129(1) subsection (1) bars the disclosure` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 129(1) subsection (1) bars the disclosure` FALSE TRUE TRUE EQUALS NOTHING
-- (2): the exceptions; (b) is lost if the Director's restriction is contravened
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(a) a summary or collection of information so framed as not to enable information relating to any particular person to be ascertained from it` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(b) a disclosure made for the purposes of a function of the Director of Public Prosecutions` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(b) a disclosure made for the purposes of a function of the Director of Public Prosecutions` TRUE EQUALS NOTHING
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(c) a disclosure made to the Secretary of State, or a person providing services to the Secretary of State, for the purposes of the exercise of functions relating to social security matters or child support` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(d) a disclosure made for the purposes of a criminal investigation or criminal proceedings, whether or not in the United Kingdom` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(e) a disclosure made for the purposes of a function under the Proceeds of Crime Act 2002 or of an investigation or proceedings outside the United Kingdom which may lead to an external order` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(f) a disclosure made to a person exercising public functions of law enforcement for the purposes of the exercise of those functions in civil proceedings` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(g) a disclosure which in the opinion of the Director of Public Prosecutions is desirable for the purpose of safeguarding national security` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(h) a disclosure made in pursuance of an order of a court` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2)(i) a disclosure made with the consent of each person to whom the information relates` FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) subsection (1) does not apply to the disclosure` `s 129(2) a disclosure of some other kind` FALSE EQUALS NOTHING
#ASSERT `s 129(3) subsection (1) does not apply to the information` TRUE EQUALS JUST TRUE
#ASSERT `s 129(3) subsection (1) does not apply to the information` FALSE EQUALS NOTHING
#ASSERT `s 129(4) subsection (1) stands unaffected by any other enactment` TRUE EQUALS NOTHING
#ASSERT `s 129(4) subsection (1) stands unaffected by any other enactment` FALSE EQUALS JUST TRUE
-- (1) to (4) together: args: the bar on its own words, exception (2), exception (3), free of another enactment
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` (JUST TRUE) NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` NOTHING NOTHING NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 129(1) the bar on disclosure applies to the disclosure` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- (5): contravening the bar is an offence
#ASSERT `s 129(5) the person commits an offence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 129(5) the person commits an offence` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 129(5) the person commits an offence` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 129(5) the person commits an offence` NOTHING TRUE EQUALS NOTHING
-- (6): the defence
#ASSERT `s 129(6) the person has a defence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 129(6) the person has a defence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 129(6) the person has a defence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 129(6) the person has a defence` FALSE TRUE TRUE EQUALS NOTHING
-- (7), (9): the greatest punishment
#ASSERT `s 129(7) the greatest punishment for the offence` `s 129(7)(a) conviction on indictment` EQUALS (`s 129(7) punishment` WITH `the term of imprisonment not exceeded` IS `s 129(7)(a) a term of two years`, `the fine not exceeded` IS `s 129(7)(a) a fine without a stated limit`)
#ASSERT `s 129(7) the greatest punishment for the offence` `s 129(7)(b) summary conviction` EQUALS (`s 129(7) punishment` WITH `the term of imprisonment not exceeded` IS `s 129(7)(b) the general limit in a magistrates' court`, `the fine not exceeded` IS `s 129(7)(b) the statutory maximum`)
#ASSERT `s 129(9) the term as read for an offence committed before 2 May 2022` `s 129(7)(b) the general limit in a magistrates' court` TRUE EQUALS `s 129(9) a term of six months`
#ASSERT `s 129(9) the term as read for an offence committed before 2 May 2022` `s 129(7)(b) the general limit in a magistrates' court` FALSE EQUALS `s 129(7)(b) the general limit in a magistrates' court`
#ASSERT `s 129(9) the term as read for an offence committed before 2 May 2022` `s 129(7)(a) a term of two years` TRUE EQUALS `s 129(7)(a) a term of two years`
-- (8)
#ASSERT `s 129(8) a prosecution may be instituted` FALSE EQUALS JUST FALSE
#ASSERT `s 129(8) a prosecution may be instituted` TRUE EQUALS NOTHING
