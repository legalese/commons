IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss106-112`

-- Tests for wra4-ss106-112.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 106 deduction from earnings: other cases`

#ASSERT `s 106(1) SSAA 71(9A) the amount may be recovered by deduction from earnings` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 106(1) SSAA 71(9A) the amount may be recovered by deduction from earnings` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 106(1) SSAA 71(9A) the amount may be recovered by deduction from earnings` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 106(1) SSAA 71(9A) the amount may be recovered by deduction from earnings` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 106(3) SSAA 75(8) the amount may be recovered by deduction from earnings` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 106(3) SSAA 75(8) the amount may be recovered by deduction from earnings` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 106(3) SSAA 75(8) the amount may be recovered by deduction from earnings` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 106(4) SSAA 78(3C) the amount may be recovered by deduction from earnings` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 106(4) SSAA 78(3C) the amount may be recovered by deduction from earnings` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 106(4) SSAA 78(3C) the amount may be recovered by deduction from earnings` FALSE (JUST TRUE) EQUALS NOTHING
-- "earnings" has such meaning as may be prescribed (71(9B), 75(9), 78(3D)): the regulations' answer when supplied
#ASSERT `s 106(1) SSAA 71(9B) the payment is earnings` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 106(1) SSAA 71(9B) the payment is earnings` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 106(1) SSAA 71(9B) the payment is earnings` NOTHING EQUALS NOTHING
#ASSERT `s 106(3) SSAA 75(9) the payment is earnings` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 106(3) SSAA 75(9) the payment is earnings` NOTHING EQUALS NOTHING
#ASSERT `s 106(4) SSAA 78(3D) the payment is earnings` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 106(4) SSAA 78(3D) the payment is earnings` NOTHING EQUALS NOTHING

#ASSERT `s 106(2) SSAA 71ZA(2A) the reference in 71(9A) is read as reaching the amount` TRUE EQUALS JUST TRUE
#ASSERT `s 106(2) SSAA 71ZA(2A) the reference in 71(9A) is read as reaching the amount` FALSE EQUALS NOTHING

§ `s 107 child benefit and guardian's allowance`

#ASSERT `s 107(1) the exclusion of this benefit from SSAA 71(8) is repealed` `child benefit` EQUALS JUST TRUE
#ASSERT `s 107(1) the exclusion of this benefit from SSAA 71(8) is repealed` `guardian's allowance` EQUALS JUST TRUE
#ASSERT `s 107(1) the exclusion of this benefit from SSAA 71(8) is repealed` `income support` EQUALS NOTHING
#ASSERT `s 107(2) the exclusion of this benefit from SSA(NI)A 69(8) is repealed` `child benefit` EQUALS JUST TRUE
#ASSERT `s 107(2) the exclusion of this benefit from SSA(NI)A 69(8) is repealed` `guardian's allowance` EQUALS JUST TRUE
#ASSERT `s 107(2) the exclusion of this benefit from SSA(NI)A 69(8) is repealed` `universal credit` EQUALS NOTHING

§ `s 108 Limitation Act 1980`

-- a sum recoverable under Part 3 SSAA, SSCBA s 127(c) or Part 1 TCA 2002: a method of recovery is not an "action", other than court proceedings
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(a) under Part 3 of the Social Security Administration Act 1992` `deduction from benefit` EQUALS JUST FALSE
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(a) under Part 3 of the Social Security Administration Act 1992` `deduction from earnings` EQUALS JUST FALSE
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(b) under section 127(c) of the Social Security Contributions and Benefits Act 1992` `adjustment of benefit` EQUALS JUST FALSE
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(c) under Part 1 of the Tax Credits Act 2002` `deduction from benefit` EQUALS JUST FALSE
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(a) under Part 3 of the Social Security Administration Act 1992` `court action` EQUALS NOTHING
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3)(c) under Part 1 of the Tax Credits Act 2002` `court action` EQUALS NOTHING
#ASSERT `s 108(3) LA1980 38(11) the method of recovery is an “action” for the Limitation Act` `s 108(3) under some other provision` `deduction from benefit` EQUALS NOTHING
#ASSERT `s 108(4) the amendments apply to the proceedings as if in force from the start` TRUE EQUALS JUST FALSE
#ASSERT `s 108(4) the amendments apply to the proceedings as if in force from the start` FALSE EQUALS JUST TRUE

§ `s 109 CJA1991 s 24: "income-related" repealed`

#ASSERT `s 109 CJA1991 s 24 “income-related” no longer limits the allowance on the day` `contributory employment and support allowance` (Date 27 10 2008) EQUALS JUST TRUE
#ASSERT `s 109 CJA1991 s 24 “income-related” no longer limits the allowance on the day` `contributory employment and support allowance` (Date 26 10 2008) EQUALS NOTHING
#ASSERT `s 109 CJA1991 s 24 “income-related” no longer limits the allowance on the day` `income-related employment and support allowance` (Date 28 10 2008) EQUALS JUST TRUE
#ASSERT `s 109 CJA1991 s 24 “income-related” no longer limits the allowance on the day` `income-related employment and support allowance` (Date 26 10 2008) EQUALS NOTHING
#ASSERT `s 109 CJA1991 s 24 “income-related” no longer limits the allowance on the day` `income support` (Date 28 10 2008) EQUALS NOTHING

§ `s 110 SSAA 109B(2)(ia)`

#ASSERT `s 110(a) SSAA 109B(2)(ia) the person may be required to supply information for an investigation` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 110(a) SSAA 109B(2)(ia) the person may be required to supply information for an investigation` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 110(a) SSAA 109B(2)(ia) the person may be required to supply information for an investigation` NOTHING EQUALS NOTHING

§ `s 112 SSAA 116ZA: local authority proceedings`

-- args: place, administers HB or CTB, (a) started an investigation, (b) HB case and CTB history, (c) CTB case and HB history,
--       a (3) direction bars (a)-(c), (d) prescribed (maybe), (e) Secretary of State directed, a (5) condition unmet
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Scotland TRUE TRUE FALSE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales FALSE TRUE FALSE FALSE FALSE NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE TRUE FALSE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE TRUE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` `England outside Greater London` TRUE FALSE FALSE TRUE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` `Northern Ireland` TRUE TRUE FALSE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE
-- a (3) direction bars (a), (b) and (c): then the answer turns on (d) and (e)
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE TRUE FALSE FALSE TRUE NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE TRUE FALSE FALSE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE TRUE FALSE FALSE TRUE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
-- none of (a) to (c): (d) prescribed, (e) directed, or neither
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE FALSE FALSE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE FALSE FALSE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE FALSE FALSE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE FALSE FALSE FALSE NOTHING FALSE FALSE EQUALS NOTHING
-- (5) "only if any such condition is satisfied": an unmet prescribed condition bars even an authorised prosecution
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE TRUE FALSE FALSE FALSE NOTHING FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 112(2) SSAA 116ZA(2) the authority may bring proceedings for the benefit offence` Wales TRUE FALSE FALSE FALSE FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
-- (4)
#ASSERT `s 112(2) SSAA 116ZA(4) a direction may relate to the subject` `s 112 SSAA 116ZA(4) a particular authority` EQUALS TRUE
#ASSERT `s 112(2) SSAA 116ZA(4) a direction may relate to the subject` `s 112 SSAA 116ZA(4) a description of authority` EQUALS TRUE
#ASSERT `s 112(2) SSAA 116ZA(4) a direction may relate to the subject` `s 112 SSAA 116ZA(4) particular proceedings` EQUALS TRUE
#ASSERT `s 112(2) SSAA 116ZA(4) a direction may relate to the subject` `s 112 SSAA 116ZA(4) a description of proceedings` EQUALS TRUE
-- (6) the Secretary of State continues or discontinues, "if" (a), (b), (c) or (d)
#ASSERT `s 112(2) SSAA 116ZA(6) the Secretary of State may continue or discontinue the proceedings` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(6) the Secretary of State may continue or discontinue the proceedings` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(6) the Secretary of State may continue or discontinue the proceedings` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(6) the Secretary of State may continue or discontinue the proceedings` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(6) the Secretary of State may continue or discontinue the proceedings` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (7) the Code for Crown Prosecutors
#ASSERT `s 112(2) SSAA 116ZA(7) the local authority must have regard to the Code for Crown Prosecutors in the decision` `s 112 SSAA 116ZA(7)(a) whether the proceedings should be instituted` EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(7) the local authority must have regard to the Code for Crown Prosecutors in the decision` `s 112 SSAA 116ZA(7)(b) what charges should be preferred` EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(7) the local authority must have regard to the Code for Crown Prosecutors in the decision` `s 112 SSAA 116ZA(7)(c) what representations to make to a magistrates' court about mode of trial` EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(7) the local authority must have regard to the Code for Crown Prosecutors in the decision` `s 112 SSAA 116ZA(7)(d) whether to discontinue proceedings` EQUALS JUST TRUE
#ASSERT `s 112(2) SSAA 116ZA(7) the local authority must have regard to the Code for Crown Prosecutors in the decision` `s 112 SSAA 116ZA(7) any other decision` EQUALS NOTHING
