IMPORT prelude
IMPORT daydate

-- Welfare Reform Act 2012 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2012-5.txt (point in time
-- 1 July 2026).

§ `Nouns`

-- s 4(1): one claimant's basic conditions.
DECLARE `Claimant` HAS
    `date of birth`                                     IS A DATE
    `reaches the qualifying age for state pension credit on` IS A DATE
    `in Great Britain`                                  IS A BOOLEAN
    `receiving education`                               IS A BOOLEAN
    `accepted a claimant commitment`                    IS A BOOLEAN

DECLARE `Universal credit claim` HAS
    `claimants`                                         IS A LIST OF `Claimant`
    `assessed on`                                       IS A DATE
    -- s 5: capital (or the prescribed part) and the prescribed limit; the
    -- prescribed minimum award.
    `capital`                                           IS A NUMBER
    `prescribed capital limit`                          IS A NUMBER
    `prescribed minimum award`                          IS A NUMBER
    -- s 8(2): the elements under ss 9-12.
    `standard allowance`                                IS A NUMBER
    `child element`                                     IS A NUMBER
    `housing element`                                   IS A NUMBER
    `other elements`                                    IS A NUMBER
    -- s 8(3): the deductions, calculated in the prescribed manner.
    `earned income deduction`                           IS A NUMBER
    `unearned income deduction`                         IS A NUMBER

DECLARE `Limitation` IS ONE OF
    `not limited`
    `limited`
    `severely limited`

DECLARE `PIP facts` HAS
    `date of birth`                                     IS A DATE
    `reaches pensionable age on`                        IS A DATE
    `day in question`                                   IS A DATE
    -- s 80: the assessment findings.
    `daily living ability`                              IS A `Limitation`
    `mobility ability`                                  IS A `Limitation`
    -- s 81: the required period condition (previous 3 months, next 9).
    `daily living required period met`                  IS A BOOLEAN
    `mobility required period met`                      IS A BOOLEAN
    -- s 79(1)(a), (2)(a): of or over the prescribed age.
    `of the age prescribed for mobility`                IS A BOOLEAN
    -- s 82(1)
    `terminally ill and claimed on that ground`         IS A BOOLEAN
    -- s 77(4)
    `entitled to a Scottish disability payment`         IS A BOOLEAN

DECLARE `Cap facts` HAS
    `resident in Greater London`                        IS A BOOLEAN
    -- s 96(5B)(a): regulations say which of the two limits applies.
    `the higher limit applies`                          IS A BOOLEAN
    `reference period in days`                          IS A NUMBER
    `total welfare benefits for the reference period`   IS A NUMBER
