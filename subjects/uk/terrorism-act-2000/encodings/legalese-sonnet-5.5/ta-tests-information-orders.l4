#ASSERT `s 22C(4) the prosecution is a prosecution for perjury` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22C(4) the prosecution is a prosecution for perjury` FALSE FALSE EQUALS NOTHING

§§ `s 22D tests`
#ASSERT `s 22D(1) an appeal lies to the relevant appeal court` TRUE EQUALS JUST TRUE
#ASSERT `s 22D(1) an appeal lies to the relevant appeal court` FALSE EQUALS NOTHING
#ASSERT `s 22D(2) the person may bring the appeal` TRUE EQUALS JUST TRUE
#ASSERT `s 22D(2) the person may bring the appeal` FALSE EQUALS NOTHING
#ASSERT `s 22D(3) the relevant appeal court` `a magistrates court in England and Wales` EQUALS `the Crown Court`
#ASSERT `s 22D(3) the relevant appeal court` `a magistrates court in Northern Ireland` EQUALS `a county court`
#ASSERT `s 22D(3) the relevant appeal court` `the sheriff` EQUALS `the Sheriff Appeal Court`
#ASSERT `s 22D(4) the relevant appeal court may make, discharge or vary the order` TRUE EQUALS JUST TRUE
#ASSERT `s 22D(4) the relevant appeal court may make, discharge or vary the order` FALSE EQUALS NOTHING

§§ `s 22E and s 22F tests`
#ASSERT `s 22E(1) the information order confers the right to require the information` TRUE EQUALS JUST FALSE
#ASSERT `s 22E(1) the information order confers the right to require the information` FALSE EQUALS NOTHING
