#ASSERT `s 22B(14) the person is a law enforcement officer` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(14) the person is a law enforcement officer` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(14) the person is a senior law enforcement officer` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 22B(14) the person is a senior law enforcement officer` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 22B(14) the person is a senior law enforcement officer` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(14) the person is a senior law enforcement officer` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 3` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 3` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 4` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 4` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 1` TRUE TRUE EQUALS NOTHING
#ASSERT `s 22B(14) the act is terrorist financing` `Condition 2` TRUE TRUE EQUALS NOTHING

§§ `s 22C tests`
#ASSERT `s 22C(1) the statement may not be used in evidence against the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22C(1) the statement may not be used in evidence against the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 22C(1) the statement may not be used in evidence against the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 22C(2) subsection (1) does not apply` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 22C(2) subsection (1) does not apply` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 22C(2) subsection (1) does not apply` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22C(2) subsection (1) does not apply` FALSE FALSE FALSE EQUALS NOTHING
-- s 22C(3) columns: use is sought by virtue of (2)(c), evidence adduced by or for the person, question asked by or for the person
#ASSERT `s 22C(3) the statement may not be used by virtue of subsection (2)(c)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 22C(3) the statement may not be used by virtue of subsection (2)(c)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22C(3) the statement may not be used by virtue of subsection (2)(c)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22C(3) the statement may not be used by virtue of subsection (2)(c)` FALSE FALSE FALSE EQUALS NOTHING
