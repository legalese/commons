IMPORT prelude
IMPORT `ta-nouns`
IMPORT `ta-logic`
IMPORT `ta-information-orders`

-- Tests of ss 22B to 22F.  Expected values are written from the text (the quoted words beside each).

§§ `s 22B conditions`
-- Info order condition 1 facts columns: arises from a s 21A disclosure, respondent made the disclosure, respondent otherwise in the regulated sector, would assist an investigation of ss 15 to 18, would assist in identifying terrorist property, reasonable
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF TRUE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF TRUE, FALSE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(4) condition 1 is met` (`Info order condition 1 facts` OF TRUE, TRUE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- Info order condition 2 facts columns: arises from a corresponding disclosure requirement, an external request made to the NCA, respondent in the regulated sector, likely to be of substantial value, reasonable
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 22B(5) condition 2 is met` (`Info order condition 2 facts` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 22B(6) the request is an external request` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(6) the request is an external request` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(6) the request is an external request` FALSE TRUE EQUALS JUST FALSE
-- Info order condition 3 facts columns: operational analysis, strategic analysis, for the criminal intelligence function, respondent in the regulated sector, application to a magistrates court, applicant had regard to the code, application to the sheriff, by a procurator fiscal at the request of the NCA, requester had regard to the code, reasonable
`condition 3, magistrates, operational` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 3, magistrates, strategic` MEANS `Info order condition 3 facts` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 3, magistrates, no regard to the code` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE
`condition 3, sheriff, all met` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE
`condition 3, sheriff, requester had no regard` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE
`condition 3, sheriff, not by a procurator fiscal` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE
`condition 3, no analysis` MEANS `Info order condition 3 facts` OF FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 3, not reasonable` MEANS `Info order condition 3 facts` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, magistrates, operational` EQUALS JUST TRUE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, magistrates, strategic` EQUALS JUST TRUE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, magistrates, no regard to the code` EQUALS JUST FALSE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, sheriff, all met` EQUALS JUST TRUE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, sheriff, requester had no regard` EQUALS JUST FALSE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, sheriff, not by a procurator fiscal` EQUALS JUST FALSE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, no analysis` EQUALS JUST FALSE
#ASSERT `s 22B(6A) condition 3 is met` `condition 3, not reasonable` EQUALS JUST FALSE
-- Info order condition 4 facts columns: a foreign FIU request, belief request made only to assist analysis, belief of substantial value, for the criminal intelligence function, respondent in the regulated sector, application to a magistrates court, applicant had regard to the code, application to the sheriff, by a procurator fiscal at the request of the NCA, requester had regard to the code, reasonable
`condition 4, magistrates, all met` MEANS `Info order condition 4 facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 4, sheriff, all met` MEANS `Info order condition 4 facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE
`condition 4, no foreign FIU request` MEANS `Info order condition 4 facts` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 4, no belief of substantial value` MEANS `Info order condition 4 facts` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`condition 4, magistrates, no regard to the code` MEANS `Info order condition 4 facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE
`condition 4, sheriff, not by a procurator fiscal` MEANS `Info order condition 4 facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, magistrates, all met` EQUALS JUST TRUE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, sheriff, all met` EQUALS JUST TRUE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, no foreign FIU request` EQUALS JUST FALSE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, no belief of substantial value` EQUALS JUST FALSE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, magistrates, no regard to the code` EQUALS JUST FALSE
#ASSERT `s 22B(6B) condition 4 is met` `condition 4, sheriff, not by a procurator fiscal` EQUALS JUST FALSE

§§ `s 22B the order`
#ASSERT `s 22B(1) the court may make an information order` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 22B(1) the court may make an information order` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(1) the court may make an information order` TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE
-- s 22B(1) "may ... make an information order if satisfied that either condition 1 or condition 2 is met": a power given "if": an unmet "if" is JUST FALSE (ruling of 2026-11-05); an unknown condition stays NOTHING
#ASSERT `s 22B(1) the court may make an information order` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 22B(1) the court may make an information order` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 22B(1) the court may make an information order` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- s 22B(1A): (a) a magistrates' court on the NCA's application; (b) the sheriff on a procurator fiscal's
#ASSERT `s 22B(1A) the court may make an information order` `a magistrates court in England and Wales` TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 22B(1A) the court may make an information order` `a magistrates court in Northern Ireland` TRUE FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(1A) the court may make an information order` `the sheriff` FALSE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- the wrong applicant for the court
#ASSERT `s 22B(1A) the court may make an information order` `the sheriff` TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 22B(1A) the court may make an information order` `a magistrates court in England and Wales` FALSE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- neither condition met
#ASSERT `s 22B(1A) the court may make an information order` `a magistrates court in England and Wales` TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 22B(2) the application has the content the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(2) the application has the content the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22B(2) the application has the content the subsection requires` TRUE FALSE EQUALS JUST FALSE
-- s 22B(3): "so far as the information is in the possession, or under the control, of the respondent"
#ASSERT `s 22B(3) the order requires the respondent to provide the information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(3) the order requires the respondent to provide the information` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(3) the order requires the respondent to provide the information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 22B(3) the order requires the respondent to provide the information` FALSE FALSE TRUE EQUALS NOTHING
#TRACE `s 22B(3) the respondent must provide the information the order requires` 14 AT 0 WITH
    PARTY `the respondent` DOES `provide the information the order requires` AT 10
-- the trace above must end FULFILLED
#TRACE `s 22B(3) the respondent must provide the information the order requires` 14 AT 0 WITH
    PARTY `the respondent` DOES `provide the information the order requires` AT 20
-- the trace above must end in a BREACH by the respondent (the order's date, 14, had passed)
#ASSERT `s 22B(7) the order has the content the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22B(7) the order has the content the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22B(7) the order has the content the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(8) the magistrates court may order the person to pay an amount` TRUE TRUE EQUALS JUST TRUE
-- s 22B(8) "If a person fails to comply ... the magistrates' court may order": an unmet "If" is JUST FALSE (ruling of 2026-11-05)
#ASSERT `s 22B(8) the magistrates court may order the person to pay an amount` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(8) the magistrates court may order the person to pay an amount` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22B(8) the ceiling of the amount the court may order the person to pay` NOTHING EQUALS 5000
#ASSERT `s 22B(8) the ceiling of the amount the court may order the person to pay` (JUST 7500) EQUALS 7500
#ASSERT `s 22B(9) the sum is treated as adjudged to be paid by a conviction of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 22B(9) the sum is treated as adjudged to be paid by a conviction of the court` FALSE EQUALS NOTHING
-- s 22B(12) columns: a constable, NCA officer or counter-terrorism financial investigator, relies on Condition 1 or 2, senior law enforcement officer, authorised by one
#ASSERT `s 22B(12) the officer is barred from making the application` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 22B(12) the officer is barred from making the application` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 22B(12) the officer is barred from making the application` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 22B(12) the officer is barred from making the application` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 22B(12) the officer is barred from making the application` FALSE TRUE FALSE FALSE EQUALS NOTHING
#TRACE `s 22B(12) the law enforcement officer shall not make an application unless senior or authorised` AT 0 WITH
    PARTY `a law enforcement officer` DOES `make an application for an information order` AT 2
-- the trace above must end in a BREACH by a law enforcement officer
#ASSERT `s 22B(13) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 22B(13) the business is a business in the regulated sector` NOTHING EQUALS NOTHING

