#ASSERT `s 22E(2) the information is privileged information` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 22E(2) the information is privileged information` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 22E(3) the provision of the information does not breach any restriction on disclosure` TRUE EQUALS JUST TRUE
#ASSERT `s 22E(3) the provision of the information does not breach any restriction on disclosure` FALSE EQUALS NOTHING
#ASSERT `s 22E(4) the application may be heard and determined in private` TRUE EQUALS JUST TRUE
#ASSERT `s 22E(4) the application may be heard and determined in private` FALSE EQUALS NOTHING
#ASSERT `s 22F(7) the failure of itself makes the person liable to criminal or civil proceedings` TRUE EQUALS JUST FALSE
#ASSERT `s 22F(7) the failure of itself makes the person liable to criminal or civil proceedings` FALSE EQUALS NOTHING
#ASSERT `s 22F(8) the code is admissible and is to be taken into account` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 22F(8) the code is admissible and is to be taken into account` TRUE FALSE EQUALS NOTHING
#ASSERT `s 22F(8) the code is admissible and is to be taken into account` FALSE TRUE EQUALS NOTHING
#ASSERT `s 22F(10) the term has the meaning given in s 22B(14)` TRUE EQUALS JUST TRUE
#ASSERT `s 22F(10) the term has the meaning given in s 22B(14)` FALSE EQUALS NOTHING

