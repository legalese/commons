IMPORT prelude
IMPORT `ta-nouns`
IMPORT `ta-logic`
IMPORT `ta-forfeiture`

-- Tests of ss 23 to 23B.  Expected values are written from the text (the quoted words beside each).
-- Forfeitable property facts columns: in the person's possession or control at the time of the offence, had been used for terrorism, the person intended it be so used, the person had reasonable cause to suspect it might be,
--   the person knew or had reasonable cause to suspect it would or might be, the arrangement related to it, received as a payment or reward, it is the amount paid under the insurance contract

§§ `s 23 tests`
`held and used` MEANS `Forfeitable property facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`held and intended` MEANS `Forfeitable property facts` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`held and might be used` MEANS `Forfeitable property facts` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`held and would or might be used` MEANS `Forfeitable property facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`held, nothing more` MEANS `Forfeitable property facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`used but not held` MEANS `Forfeitable property facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`arrangement property, used` MEANS `Forfeitable property facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`arrangement property, would or might be used` MEANS `Forfeitable property facts` OF FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE
`arrangement property, nothing more` MEANS `Forfeitable property facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`a reward` MEANS `Forfeitable property facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`the insured amount` MEANS `Forfeitable property facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
#ASSERT `s 23(1) the court may make a forfeiture order` TRUE EQUALS JUST TRUE
#ASSERT `s 23(1) the court may make a forfeiture order` FALSE EQUALS NOTHING
-- s 23(2): offences under s 15(1), 15(2) or 16; used, or intended, or reasonable cause to suspect it might be used
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 15(1)` `held and used` EQUALS JUST TRUE
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 15(2)` `held and intended` EQUALS JUST TRUE
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 16(1)` `held and might be used` EQUALS JUST TRUE
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 16(2)` `held and might be used` EQUALS JUST TRUE
-- "would or might" is the s 23(3) test; s 23(2) says "might"
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 16(1)` `held and would or might be used` EQUALS NOTHING
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 16(1)` `held, nothing more` EQUALS NOTHING
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 16(1)` `used but not held` EQUALS NOTHING
-- ruling of 2026-11-05 (b): "Where a person is convicted of an offence under ..." is a "where" condition; a conviction for a different offence is JUST FALSE (the property clauses stay NOTHING)
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 15(3)` `held and used` EQUALS JUST FALSE
#ASSERT `s 23(2) the court may order the forfeiture of the property` `an offence under s 17` `held and used` EQUALS JUST FALSE
-- the helper that holds the s 23(2) test
#ASSERT `s 23(2) the property is within the subsection` `held and used` EQUALS JUST TRUE
#ASSERT `s 23(2) the property is within the subsection` `held, nothing more` EQUALS NOTHING
-- s 23(3): the offence under s 15(3); used, or knew or had reasonable cause to suspect it would or might be used
#ASSERT `s 23(3) the court may order the forfeiture of the property` `an offence under s 15(3)` `held and used` EQUALS JUST TRUE
#ASSERT `s 23(3) the court may order the forfeiture of the property` `an offence under s 15(3)` `held and would or might be used` EQUALS JUST TRUE
#ASSERT `s 23(3) the court may order the forfeiture of the property` `an offence under s 15(3)` `held and intended` EQUALS NOTHING
#ASSERT `s 23(3) the court may order the forfeiture of the property` `an offence under s 15(3)` `used but not held` EQUALS NOTHING
#ASSERT `s 23(3) the court may order the forfeiture of the property` `an offence under s 15(1)` `held and used` EQUALS JUST FALSE
-- s 23(4): the offences under s 17 or 18; used, or intended
#ASSERT `s 23(4) the court may order the forfeiture of the property` `an offence under s 17` `held and used` EQUALS JUST TRUE
#ASSERT `s 23(4) the court may order the forfeiture of the property` `an offence under s 18` `held and intended` EQUALS JUST TRUE
#ASSERT `s 23(4) the court may order the forfeiture of the property` `an offence under s 18` `held and might be used` EQUALS NOTHING
#ASSERT `s 23(4) the court may order the forfeiture of the property` `an offence under s 17` `used but not held` EQUALS NOTHING
#ASSERT `s 23(4) the court may order the forfeiture of the property` `an offence under s 16(1)` `held and used` EQUALS JUST FALSE
-- s 23(5): the offence under s 17; the property the arrangement related to, and used, or known or suspected to be about to be used
#ASSERT `s 23(5) the court may order the forfeiture of the property` `an offence under s 17` `arrangement property, used` EQUALS JUST TRUE
#ASSERT `s 23(5) the court may order the forfeiture of the property` `an offence under s 17` `arrangement property, would or might be used` EQUALS JUST TRUE
#ASSERT `s 23(5) the court may order the forfeiture of the property` `an offence under s 17` `arrangement property, nothing more` EQUALS NOTHING
#ASSERT `s 23(5) the court may order the forfeiture of the property` `an offence under s 17` `held and used` EQUALS NOTHING
#ASSERT `s 23(5) the court may order the forfeiture of the property` `an offence under s 18` `arrangement property, used` EQUALS JUST FALSE
-- s 23(5A): the offence under s 17A; the amount paid under the insurance contract
#ASSERT `s 23(5A) the court may order the forfeiture of the amount` `an offence under s 17A` `the insured amount` EQUALS JUST TRUE
#ASSERT `s 23(5A) the court may order the forfeiture of the amount` `an offence under s 17A` `held and used` EQUALS NOTHING
#ASSERT `s 23(5A) the court may order the forfeiture of the amount` `an offence under s 17` `the insured amount` EQUALS JUST FALSE
-- s 23(6): the offence under s 18; the property the arrangement related to
#ASSERT `s 23(6) the court may order the forfeiture of the property` `an offence under s 18` `arrangement property, nothing more` EQUALS JUST TRUE
#ASSERT `s 23(6) the court may order the forfeiture of the property` `an offence under s 18` `held and used` EQUALS NOTHING
#ASSERT `s 23(6) the court may order the forfeiture of the property` `an offence under s 17` `arrangement property, nothing more` EQUALS JUST FALSE
-- s 23(7): any offence under ss 15 to 18; a payment or reward
#ASSERT `s 23(7) the court may order the forfeiture of the payment or reward` TRUE `a reward` EQUALS JUST TRUE
#ASSERT `s 23(7) the court may order the forfeiture of the payment or reward` TRUE `held and used` EQUALS NOTHING
#ASSERT `s 23(7) the court may order the forfeiture of the payment or reward` FALSE `a reward` EQUALS NOTHING

§§ `s 23A tests`
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 54 (weapons training)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 57 (possessing things for the purposes of terrorism)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 58 (collecting information for the purposes of terrorism)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 58A (collecting information for the purposes of terrorism)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 58B (entering or remaining in a designated area)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 59 (inciting terrorism outside the United Kingdom)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 60 (inciting terrorism outside the United Kingdom)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2000 section 61 (inciting terrorism outside the United Kingdom)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 2 (dissemination of terrorist publications)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 5 (preparation of terrorist acts)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 6 (training for terrorism)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 9 (offences involving radioactive devices or materials)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 10 (offences involving radioactive devices or materials)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `Terrorism Act 2006 section 11 (offences involving radioactive devices or materials)` EQUALS JUST TRUE
#ASSERT `s 23A(2) this section applies to the offence` `none of these` EQUALS NOTHING
#ASSERT `s 23A(3) this section applies to the ancillary offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 23A(3) this section applies to the ancillary offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 23A(3) this section applies to the ancillary offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 23A(4) this section applies to the offence with a terrorist connection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 23A(4) this section applies to the offence with a terrorist connection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 23A(4) this section applies to the offence with a terrorist connection` FALSE FALSE EQUALS NOTHING
-- Terrorism forfeiture facts columns: in the person's possession or control at the time of the offence, had been used, intended by the person, the court believes it will be used unless forfeited
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST TRUE) (`Terrorism forfeiture facts` OF TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST TRUE) (`Terrorism forfeiture facts` OF TRUE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST TRUE) (`Terrorism forfeiture facts` OF TRUE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST TRUE) (`Terrorism forfeiture facts` OF FALSE, TRUE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST TRUE) (`Terrorism forfeiture facts` OF TRUE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 23A(1) the court may order the forfeiture of the property` NOTHING (`Terrorism forfeiture facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 23A(1) the court may order the forfeiture of the property` (JUST FALSE) (`Terrorism forfeiture facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 23A(6) the order adding the offence to subsection (2) applies to the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 23A(6) the order adding the offence to subsection (2) applies to the offence` FALSE EQUALS JUST FALSE

§§ `s 23B tests`
-- columns: the court is about to make an order, the person is the convicted person, the person claims to be the owner or otherwise interested
#ASSERT `s 23B(1) the court must give the person an opportunity to be heard` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 23B(1) the court must give the person an opportunity to be heard` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 23B(1) the court must give the person an opportunity to be heard` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 23B(1) the court must give the person an opportunity to be heard` FALSE FALSE TRUE EQUALS NOTHING
#TRACE `s 23B(1) the court must give an opportunity to be heard` AT 0 WITH
    PARTY `the court` DOES `give an opportunity to be heard` AT 2
-- the trace above must end FULFILLED
#ASSERT `s 23B(2) the court shall have regard to the value of the property and the effects on the convicted person` TRUE EQUALS JUST TRUE
#ASSERT `s 23B(2) the court shall have regard to the value of the property and the effects on the convicted person` FALSE EQUALS NOTHING
#TRACE `s 23B(2) the court must have regard to the value and effects` AT 0 WITH
    PARTY `the court` DOES `have regard to the value of the property and the likely effects of the order on the convicted person` AT 2
-- the trace above must end FULFILLED
-- s 23B(3) columns: the court is in Scotland, on indictment, applies when moving for sentence, summary proceedings, applies before sentence
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- the wrong moment for the kind of proceedings
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 23B(3) the court in Scotland is barred from making the order` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
#TRACE `s 23B(3) the court in Scotland shall not make the order except on the prosecutor's application` AT 0 WITH
    PARTY `the court` DOES `make a forfeiture order in Scotland other than on the application of the prosecutor` AT 2
-- the trace above must end in a BREACH by the court
#ASSERT `s 23B(3) the order of a Scottish court is a sentence for the purposes of any appeal or review` TRUE EQUALS JUST TRUE
#ASSERT `s 23B(3) the order of a Scottish court is a sentence for the purposes of any appeal or review` FALSE EQUALS NOTHING
#ASSERT `s 23B(4) Schedule 4 makes further provision for the order` TRUE EQUALS JUST TRUE
#ASSERT `s 23B(4) Schedule 4 makes further provision for the order` FALSE EQUALS NOTHING

-- 83 assertions written; 83 satisfied (run with l4 1.6.109 on the main build; check.sh recounts)
