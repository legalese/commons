IMPORT prelude
IMPORT `ta-nouns`
IMPORT `ta-logic`
IMPORT `ta-regulated-sector`

-- Tests of ss 21A, 21B and 21C.  Expected values are written from the text (the quoted words beside each).

§§ `s 21A tests`
-- Regulated sector facts columns: knows or suspects, has reasonable grounds for knowing or suspecting, came in the regulated sector, disclosed promptly to a constable or nominated officer
`knows, in the regulated sector, silent` MEANS `Regulated sector facts` OF TRUE, FALSE, TRUE, FALSE
`reasonable grounds only, in the regulated sector, silent` MEANS `Regulated sector facts` OF FALSE, TRUE, TRUE, FALSE
`no knowledge or suspicion` MEANS `Regulated sector facts` OF FALSE, FALSE, TRUE, FALSE
`not in the regulated sector` MEANS `Regulated sector facts` OF TRUE, FALSE, FALSE, FALSE
`knows, in the regulated sector, disclosed promptly` MEANS `Regulated sector facts` OF TRUE, FALSE, TRUE, TRUE
#ASSERT `s 21A(2) the first condition is satisfied` `knows, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(2) the first condition is satisfied` `reasonable grounds only, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(2) the first condition is satisfied` `no knowledge or suspicion` EQUALS JUST FALSE
#ASSERT `s 21A(3) the second condition is satisfied` `knows, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(3) the second condition is satisfied` `not in the regulated sector` EQUALS JUST FALSE
#ASSERT `s 21A(4) the third condition is satisfied` `knows, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(4) the third condition is satisfied` `knows, in the regulated sector, disclosed promptly` EQUALS JUST FALSE
#ASSERT `s 21A(1) the person commits an offence if each of the three conditions is satisfied` `knows, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(1) the person commits an offence if each of the three conditions is satisfied` `reasonable grounds only, in the regulated sector, silent` EQUALS JUST TRUE
#ASSERT `s 21A(1) the person commits an offence if each of the three conditions is satisfied` `no knowledge or suspicion` EQUALS JUST FALSE
#ASSERT `s 21A(1) the person commits an offence if each of the three conditions is satisfied` `not in the regulated sector` EQUALS JUST FALSE
#ASSERT `s 21A(1) the person commits an offence if each of the three conditions is satisfied` `knows, in the regulated sector, disclosed promptly` EQUALS JUST FALSE

-- Assistance facts columns: employed by or in partnership with an adviser to assist, the matter comes in connection with that assistance, it came to the adviser in privileged circumstances
`assistant, all three` MEANS `Assistance facts` OF TRUE, TRUE, TRUE
`assistant, not privileged` MEANS `Assistance facts` OF TRUE, TRUE, FALSE
`assistant, not in connection with assistance` MEANS `Assistance facts` OF TRUE, FALSE, TRUE
`not an assistant` MEANS `Assistance facts` OF FALSE, TRUE, TRUE
-- Exception facts columns: a reasonable excuse, a professional legal adviser or relevant professional adviser, it came in privileged circumstances
`no exception` MEANS `Exception facts` OF FALSE, FALSE, FALSE
`reasonable excuse` MEANS `Exception facts` OF TRUE, FALSE, FALSE
`adviser, privileged` MEANS `Exception facts` OF FALSE, TRUE, TRUE
`adviser, not privileged` MEANS `Exception facts` OF FALSE, TRUE, FALSE
`privileged, not an adviser` MEANS `Exception facts` OF FALSE, FALSE, TRUE
#ASSERT `s 21A(5A) subsection (5A) applies to the person` `assistant, all three` EQUALS JUST TRUE
#ASSERT `s 21A(5A) subsection (5A) applies to the person` `assistant, not privileged` EQUALS JUST FALSE
#ASSERT `s 21A(5A) subsection (5A) applies to the person` `assistant, not in connection with assistance` EQUALS JUST FALSE
#ASSERT `s 21A(5A) subsection (5A) applies to the person` `not an assistant` EQUALS JUST FALSE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `reasonable excuse` `not an assistant` EQUALS JUST TRUE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `adviser, privileged` `not an assistant` EQUALS JUST TRUE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `no exception` `assistant, all three` EQUALS JUST TRUE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `adviser, not privileged` `not an assistant` EQUALS JUST FALSE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `privileged, not an adviser` `not an assistant` EQUALS JUST FALSE
#ASSERT `s 21A(5) the person does not commit an offence under section 21A` `no exception` `assistant, not privileged` EQUALS JUST FALSE
-- the subsections gathered by hand (E1 option B): an offence, unless an exception in (5) applies
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `knows, in the regulated sector, silent` `no exception` `not an assistant` EQUALS JUST TRUE
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `knows, in the regulated sector, silent` `reasonable excuse` `not an assistant` EQUALS JUST FALSE
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `knows, in the regulated sector, silent` `adviser, privileged` `not an assistant` EQUALS JUST FALSE
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `knows, in the regulated sector, silent` `no exception` `assistant, all three` EQUALS JUST FALSE
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `knows, in the regulated sector, silent` `adviser, not privileged` `not an assistant` EQUALS JUST TRUE
#ASSERT `s 21A(1) and (5) the person commits an offence under section 21A` `not in the regulated sector` `no exception` `not an assistant` EQUALS JUST FALSE

-- Guidance facts columns: issued by a supervisory authority or appropriate body, approved by the Treasury, published in the approved manner, relevant guidance at the time
#ASSERT `s 21A(6) the guidance is relevant guidance the court must consider` (`Guidance facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(6) the guidance is relevant guidance the court must consider` (`Guidance facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 21A(6) the guidance is relevant guidance the court must consider` (`Guidance facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 21A(6) the guidance is relevant guidance the court must consider` (`Guidance facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `s 21A(6) the guidance is relevant guidance the court must consider` (`Guidance facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
#TRACE `s 21A(6) the court must consider whether the person followed the relevant guidance` AT 0 WITH
    PARTY `the court` DOES `consider whether the person followed the relevant guidance` AT 2
-- the trace above must end FULFILLED

-- Nominated officer facts columns: made to a person nominated by the employer, in the course of employment, in accordance with the employer's procedure
#ASSERT `s 21A(7) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(7) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21A(7) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21A(7) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF TRUE, TRUE, FALSE) EQUALS JUST FALSE

-- Adviser communication facts columns: from a client for legal advice, from a person seeking legal advice, for legal proceedings, with a view to furthering a criminal purpose
`from a client` MEANS `Adviser communication facts` OF TRUE, FALSE, FALSE, FALSE
`from a person seeking advice` MEANS `Adviser communication facts` OF FALSE, TRUE, FALSE, FALSE
`for legal proceedings` MEANS `Adviser communication facts` OF FALSE, FALSE, TRUE, FALSE
`from a client, to further a criminal purpose` MEANS `Adviser communication facts` OF TRUE, FALSE, FALSE, TRUE
`none of the three, no criminal purpose` MEANS `Adviser communication facts` OF FALSE, FALSE, FALSE, FALSE
#ASSERT `s 21A(8) the information or other matter comes to the adviser in privileged circumstances` `from a client` EQUALS JUST TRUE
#ASSERT `s 21A(8) the information or other matter comes to the adviser in privileged circumstances` `from a person seeking advice` EQUALS JUST TRUE
#ASSERT `s 21A(8) the information or other matter comes to the adviser in privileged circumstances` `for legal proceedings` EQUALS JUST TRUE
#ASSERT `s 21A(8) the information or other matter comes to the adviser in privileged circumstances` `none of the three, no criminal purpose` EQUALS JUST FALSE
#ASSERT `s 21A(9) subsection (8) does not apply to the information or other matter` `from a client, to further a criminal purpose` EQUALS JUST TRUE
#ASSERT `s 21A(9) subsection (8) does not apply to the information or other matter` `from a client` EQUALS NOTHING
#ASSERT `s 21A(8) and (9) the information or other matter comes to the adviser in privileged circumstances` `from a client` EQUALS JUST TRUE
#ASSERT `s 21A(8) and (9) the information or other matter comes to the adviser in privileged circumstances` `from a client, to further a criminal purpose` EQUALS JUST FALSE
#ASSERT `s 21A(8) and (9) the information or other matter comes to the adviser in privileged circumstances` `none of the three, no criminal purpose` EQUALS JUST FALSE

#ASSERT `s 21A(10)(a) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(10)(a) the business is a business in the regulated sector` NOTHING EQUALS NOTHING
#ASSERT `s 21A(10)(b) the body is a supervisory authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 21A(10)(b) the body is a supervisory authority` NOTHING EQUALS NOTHING
#ASSERT `s 21A(11) the person is to be taken to have committed an offence mentioned in s 21A(2)` (`Act abroad facts` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(11) the person is to be taken to have committed an offence mentioned in s 21A(2)` (`Act abroad facts` OF TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 21A(11) the person is to be taken to have committed an offence mentioned in s 21A(2)` (`Act abroad facts` OF FALSE, TRUE) EQUALS JUST FALSE
-- s 21A(12): five years is 60 months; 4000 is a test input for the statutory maximum, not the Act's figure
#ASSERT `s 21A(12) the ceiling of the penalty for an offence under s 21A` `on conviction on indictment` 4000 EQUALS `Penalty ceiling` OF 60, `No ceiling is stated`
#ASSERT `s 21A(12) the ceiling of the penalty for an offence under s 21A` `on summary conviction` 4000 EQUALS `Penalty ceiling` OF 6, `A fine not exceeding` 4000
#ASSERT `s 21A(13) the body is an appropriate body` TRUE EQUALS JUST TRUE
#ASSERT `s 21A(13) the body is an appropriate body` FALSE EQUALS JUST FALSE
#ASSERT `s 21A(14) the person is a constable for the purposes of s 21A` (`Officer facts` OF TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21A(14) the person is a constable for the purposes of s 21A` (`Officer facts` OF FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(14) the person is a constable for the purposes of s 21A` (`Officer facts` OF FALSE, FALSE) EQUALS NOTHING
-- Professional adviser facts columns: accountant, auditor or tax adviser; member of a professional body for such advisers; body tests competence; body imposes standards and sanctions
#ASSERT `s 21A(15) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21A(15) the person is a relevant professional adviser` (`Professional adviser facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21A(15) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21A(15) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21A(15) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE

§§ `s 21B tests`
-- Protected disclosure facts columns: came in the regulated sector, causes the discloser to know or suspect, gives reasonable grounds, made to a constable or nominated officer, as soon as practicable
`protected, all conditions` MEANS `Protected disclosure facts` OF TRUE, TRUE, FALSE, TRUE, TRUE
`protected, reasonable grounds only` MEANS `Protected disclosure facts` OF TRUE, FALSE, TRUE, TRUE, TRUE
`not from the regulated sector` MEANS `Protected disclosure facts` OF FALSE, TRUE, FALSE, TRUE, TRUE
`no knowledge, suspicion or grounds` MEANS `Protected disclosure facts` OF TRUE, FALSE, FALSE, TRUE, TRUE
`made to someone else` MEANS `Protected disclosure facts` OF TRUE, TRUE, FALSE, FALSE, TRUE
`made late` MEANS `Protected disclosure facts` OF TRUE, TRUE, FALSE, TRUE, FALSE
#ASSERT `s 21B(2) the first condition is satisfied` `protected, all conditions` EQUALS JUST TRUE
#ASSERT `s 21B(2) the first condition is satisfied` `not from the regulated sector` EQUALS JUST FALSE
#ASSERT `s 21B(3) the second condition is satisfied` `protected, all conditions` EQUALS JUST TRUE
#ASSERT `s 21B(3) the second condition is satisfied` `protected, reasonable grounds only` EQUALS JUST TRUE
#ASSERT `s 21B(3) the second condition is satisfied` `no knowledge, suspicion or grounds` EQUALS JUST FALSE
#ASSERT `s 21B(4) the third condition is satisfied` `protected, all conditions` EQUALS JUST TRUE
#ASSERT `s 21B(4) the third condition is satisfied` `made to someone else` EQUALS JUST FALSE
#ASSERT `s 21B(4) the third condition is satisfied` `made late` EQUALS JUST FALSE
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `protected, all conditions` EQUALS JUST TRUE
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `protected, reasonable grounds only` EQUALS JUST TRUE
-- s 21B(1) "A disclosure which satisfies the following three conditions": a disclosure that fails a condition is outside the protection, JUST FALSE (ruling of 2026-11-05 on conditions the text states; fork F17)
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `not from the regulated sector` EQUALS JUST FALSE
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `no knowledge, suspicion or grounds` EQUALS JUST FALSE
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `made to someone else` EQUALS JUST FALSE
#ASSERT `s 21B(1) the disclosure is not to be taken to breach any restriction on the disclosure of information` `made late` EQUALS JUST FALSE
#ASSERT `s 21B(5) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21B(5) the disclosure is a disclosure to a nominated officer` (`Nominated officer facts` OF TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21B(6) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21B(6) the business is a business in the regulated sector` NOTHING EQUALS NOTHING
#ASSERT `s 21B(7) the person is a constable for the purposes of s 21B` (`Officer facts` OF TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21B(7) the person is a constable for the purposes of s 21B` (`Officer facts` OF FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21B(7) the person is a constable for the purposes of s 21B` (`Officer facts` OF FALSE, FALSE) EQUALS NOTHING

§§ `s 21C tests`
#ASSERT `s 21C(1) the constable must pass the disclosure in full to an authorised National Crime Agency officer` TRUE EQUALS JUST TRUE
#ASSERT `s 21C(1) the constable must pass the disclosure in full to an authorised National Crime Agency officer` FALSE EQUALS JUST FALSE
#TRACE `s 21C(1) the constable must disclose it in full to an authorised National Crime Agency officer` AT 0 WITH
    PARTY `a constable` DOES `disclose the disclosure in full to an authorised National Crime Agency officer` AT 4
-- the trace above must end FULFILLED
#ASSERT `s 21C(2) the constable must pass the section 21 disclosure in full to an authorised National Crime Agency officer` TRUE EQUALS JUST TRUE
