IMPORT prelude
IMPORT `ta-nouns`
IMPORT `ta-logic`
IMPORT `ta-tipping-off`

-- Tests of ss 21D to 21H.  Expected values are written from the text (the quoted words beside each).

§§ `s 21D tests`
-- Protected matter facts columns: a disclosure under this Part was made, to a constable, per the employer's procedure, to a nominated officer, to an authorised NCA officer, of information from the regulated sector
`matter: to a constable` MEANS `Protected matter facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`matter: per employer procedure` MEANS `Protected matter facts` OF TRUE, FALSE, TRUE, FALSE, FALSE, TRUE
`matter: to a nominated officer` MEANS `Protected matter facts` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE
`matter: to an NCA officer` MEANS `Protected matter facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE
`matter: no route` MEANS `Protected matter facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE
`matter: no disclosure made` MEANS `Protected matter facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, TRUE
`matter: not from the regulated sector` MEANS `Protected matter facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: to a constable` EQUALS JUST TRUE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: per employer procedure` EQUALS JUST TRUE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: to a nominated officer` EQUALS JUST TRUE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: to an NCA officer` EQUALS JUST TRUE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: no route` EQUALS JUST FALSE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: no disclosure made` EQUALS JUST FALSE
#ASSERT `s 21D(2) the matter is within subsection (2)` `matter: not from the regulated sector` EQUALS JUST FALSE
-- Tipping off facts columns: likely to prejudice an investigation, the information came in the regulated sector
#ASSERT `s 21D(1) the person commits an offence by tipping off` (JUST TRUE) (`Tipping off facts` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21D(1) the person commits an offence by tipping off` (JUST TRUE) (`Tipping off facts` OF FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21D(1) the person commits an offence by tipping off` (JUST TRUE) (`Tipping off facts` OF TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 21D(1) the person commits an offence by tipping off` (JUST FALSE) (`Tipping off facts` OF TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21D(1) the person commits an offence by tipping off` NOTHING (`Tipping off facts` OF TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 21D(1) the person commits an offence by tipping off` NOTHING (`Tipping off facts` OF FALSE, TRUE) EQUALS JUST FALSE
-- Investigation disclosure facts columns: discloses that an investigation is contemplated or under way, likely to prejudice it, the information came in the regulated sector
#ASSERT `s 21D(3) the person commits an offence by disclosing an investigation` (`Investigation disclosure facts` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21D(3) the person commits an offence by disclosing an investigation` (`Investigation disclosure facts` OF FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21D(3) the person commits an offence by disclosing an investigation` (`Investigation disclosure facts` OF TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21D(3) the person commits an offence by disclosing an investigation` (`Investigation disclosure facts` OF TRUE, TRUE, FALSE) EQUALS JUST FALSE
-- s 21D(4): three months is 3; two years is 24 months; 4000 is a test input for level 5, not the Act's figure
#ASSERT `s 21D(4) the ceiling of the penalty for an offence under s 21D` `on summary conviction` 4000 EQUALS `Penalty ceiling` OF 3, `A fine not exceeding` 4000
#ASSERT `s 21D(4) the ceiling of the penalty for an offence under s 21D` `on conviction on indictment` 4000 EQUALS `Penalty ceiling` OF 24, `No ceiling is stated`
-- s 21D(5): an exception that applies displaces the offence
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 21D(5) an exception in s 21E, s 21F or s 21G displaces the offence` NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE

§§ `s 21E tests`
#ASSERT `s 21E(1) the person does not commit an offence under s 21D` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21E(1) the person does not commit an offence under s 21D` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 21E(1) the person does not commit an offence under s 21D` FALSE TRUE EQUALS JUST FALSE
-- Group disclosure facts columns: by a credit or financial institution, to a credit or financial institution, recipient in the UK, an EEA state or an equivalent country, same group
#ASSERT `s 21E(2) the person does not commit an offence under s 21D by a disclosure within a group` (`Group disclosure facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21E(2) the person does not commit an offence under s 21D by a disclosure within a group` (`Group disclosure facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(2) the person does not commit an offence under s 21D by a disclosure within a group` (`Group disclosure facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(2) the person does not commit an offence under s 21D by a disclosure within a group` (`Group disclosure facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(2) the person does not commit an offence under s 21D by a disclosure within a group` (`Group disclosure facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 21E(3) the institutions belong to the same group` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21E(3) the institutions belong to the same group` NOTHING EQUALS NOTHING
-- Adviser group facts columns: the discloser is an adviser, the recipient is an adviser, both carry on business in the UK, an EEA state or an equivalent country, different undertakings under common ownership, management or control
#ASSERT `s 21E(4) the adviser does not commit an offence under s 21D` (`Adviser group facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21E(4) the adviser does not commit an offence under s 21D` (`Adviser group facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(4) the adviser does not commit an offence under s 21D` (`Adviser group facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(4) the adviser does not commit an offence under s 21D` (`Adviser group facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21E(4) the adviser does not commit an offence under s 21D` (`Adviser group facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE

§§ `s 21F tests`
-- Between institutions facts columns: credit to credit, financial to financial, legal adviser to legal adviser, professional adviser to one of the same kind
#ASSERT `s 21F(1) this section applies to the disclosure` (`Between institutions facts` OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21F(1) this section applies to the disclosure` (`Between institutions facts` OF FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21F(1) this section applies to the disclosure` (`Between institutions facts` OF FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21F(1) this section applies to the disclosure` (`Between institutions facts` OF FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21F(1) this section applies to the disclosure` (`Between institutions facts` OF FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- Institution disclosure facts columns: relates to a client or former client, relates to a transaction involving both, relates to a service involving both, for the purpose only of preventing an offence, recipient in the UK, an EEA state or an equivalent country, equivalent confidentiality and data protection duties
`relates to a client` MEANS `Institution disclosure facts` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE
`relates to a transaction` MEANS `Institution disclosure facts` OF FALSE, TRUE, FALSE, TRUE, TRUE, TRUE
`relates to a service` MEANS `Institution disclosure facts` OF FALSE, FALSE, TRUE, TRUE, TRUE, TRUE
`relates to nothing` MEANS `Institution disclosure facts` OF FALSE, FALSE, FALSE, TRUE, TRUE, TRUE
`also for another purpose` MEANS `Institution disclosure facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE
`recipient abroad, not equivalent` MEANS `Institution disclosure facts` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE
`no equivalent duties` MEANS `Institution disclosure facts` OF TRUE, FALSE, FALSE, TRUE, TRUE, FALSE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `relates to a client` EQUALS JUST TRUE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `relates to a transaction` EQUALS JUST TRUE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `relates to a service` EQUALS JUST TRUE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `relates to nothing` EQUALS JUST FALSE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `also for another purpose` EQUALS JUST FALSE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `recipient abroad, not equivalent` EQUALS JUST FALSE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST TRUE) `no equivalent duties` EQUALS JUST FALSE
-- if section 21F does not apply to the disclosure, subsection (2) gives no protection
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` (JUST FALSE) `relates to a client` EQUALS JUST FALSE
#ASSERT `s 21F(2) the person does not commit an offence under s 21D in respect of the disclosure` NOTHING `relates to a client` EQUALS NOTHING

§§ `s 21G tests`
-- Permitted disclosure facts columns: to the supervisory authority, in good faith by virtue of s 21CA, to detect, investigate or prosecute an offence, for a Proceeds of Crime Act investigation, to enforce a Proceeds of Crime Act order
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21G(1) the person does not commit an offence under s 21D` (`Permitted disclosure facts` OF FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 21G(2) the adviser does not commit an offence under s 21D` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21G(2) the adviser does not commit an offence under s 21D` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 21G(2) the adviser does not commit an offence under s 21D` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 21G(2) the adviser does not commit an offence under s 21D` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 21G(3) the person does not commit an offence under s 21D(1)` FALSE EQUALS JUST TRUE
#ASSERT `s 21G(3) the person does not commit an offence under s 21D(1)` TRUE EQUALS JUST FALSE
#ASSERT `s 21G(4) the person does not commit an offence under s 21D(3)` FALSE EQUALS JUST TRUE
#ASSERT `s 21G(4) the person does not commit an offence under s 21D(3)` TRUE EQUALS JUST FALSE

§§ `s 21H tests`
#ASSERT `s 21H(1)(a) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21H(1)(a) the business is a business in the regulated sector` NOTHING EQUALS NOTHING
#ASSERT `s 21H(1)(b) the body is a supervisory authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 21H(1)(b) the body is a supervisory authority` NOTHING EQUALS NOTHING
#ASSERT `s 21H(2) the undertaking is a credit institution` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21H(2) the undertaking is a credit institution` NOTHING EQUALS NOTHING
#ASSERT `s 21H(2) the undertaking is a financial institution` TRUE EQUALS JUST TRUE
#ASSERT `s 21H(2) the undertaking is a financial institution` FALSE EQUALS JUST FALSE
#ASSERT `s 21H(3) the disclosure counts as a disclosure by or to the institution` TRUE EQUALS JUST TRUE
#ASSERT `s 21H(3) the disclosure counts as a disclosure by or to the institution` FALSE EQUALS NOTHING
#ASSERT `s 21H(4) the country or territory imposes equivalent money laundering requirements` TRUE EQUALS JUST TRUE
#ASSERT `s 21H(4) the country or territory imposes equivalent money laundering requirements` FALSE EQUALS JUST FALSE
-- Professional adviser facts columns: accountant, auditor or tax adviser; member of a professional body for such advisers; body tests competence; body imposes standards and sanctions
#ASSERT `s 21H(5) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 21H(5) the person is a relevant professional adviser` (`Professional adviser facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21H(5) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21H(5) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 21H(5) the person is a relevant professional adviser` (`Professional adviser facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE

-- 85 assertions written; 85 satisfied (run with l4 1.6.109 on the main build; check.sh recounts)
