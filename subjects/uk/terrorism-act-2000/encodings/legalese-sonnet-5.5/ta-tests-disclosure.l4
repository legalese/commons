§§ `s 21 tests`
-- Cooperation facts columns: involved in a transaction, discloses the suspicion, discloses the information, after becoming concerned, own initiative, as soon as reasonably practicable,
--                            a constable forbids continuing, he continues
`all conditions of s 21(2) and (3) met` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE
`forbidden but stops` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE
`forbidden and continues` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`continues, never forbidden` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE
`disclosed before becoming concerned` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE
`not on own initiative` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE
`not as soon as reasonably practicable` MEANS `Cooperation facts` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE
`information not disclosed` MEANS `Cooperation facts` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE
`suspicion not disclosed` MEANS `Cooperation facts` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE
`not involved` MEANS `Cooperation facts` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE
#ASSERT `s 21(1) the person does not commit an offence under any of sections 15 to 18 by acting with the express consent of a constable` TRUE EQUALS JUST TRUE
#ASSERT `s 21(1) the person does not commit an offence under any of sections 15 to 18 by acting with the express consent of a constable` FALSE EQUALS JUST FALSE
#ASSERT `s 21(3) subsection (2) applies to the person's disclosure` `all conditions of s 21(2) and (3) met` EQUALS JUST TRUE
#ASSERT `s 21(3) subsection (2) applies to the person's disclosure` `disclosed before becoming concerned` EQUALS JUST FALSE
#ASSERT `s 21(3) subsection (2) applies to the person's disclosure` `not on own initiative` EQUALS JUST FALSE
#ASSERT `s 21(3) subsection (2) applies to the person's disclosure` `not as soon as reasonably practicable` EQUALS JUST FALSE
#ASSERT `s 21(4) subsection (2) does not apply to the person` `forbidden and continues` EQUALS JUST TRUE
#ASSERT `s 21(4) subsection (2) does not apply to the person` `forbidden but stops` EQUALS JUST FALSE
#ASSERT `s 21(4) subsection (2) does not apply to the person` `continues, never forbidden` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `all conditions of s 21(2) and (3) met` EQUALS JUST TRUE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `forbidden but stops` EQUALS JUST TRUE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `continues, never forbidden` EQUALS JUST TRUE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `forbidden and continues` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `disclosed before becoming concerned` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `not on own initiative` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `not as soon as reasonably practicable` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `information not disclosed` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `suspicion not disclosed` EQUALS JUST FALSE
#ASSERT `s 21(2) the person does not commit an offence under any of sections 15 to 18 by involvement in the transaction` `not involved` EQUALS JUST FALSE
-- s 21(5): the defence is for "any of sections 15(2) and (3) and 16 to 18"
#ASSERT `s 21(5) the person has a defence` `an offence under s 15(2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 15(3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 16(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 16(2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 17` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 18` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 15(1)` TRUE TRUE EQUALS NOTHING
-- fork F7: the range "16 to 18" includes section 17A
#ASSERT `s 21(5) the person has a defence` `an offence under s 17A` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(5) the person has a defence` `an offence under s 18` TRUE FALSE EQUALS NOTHING
#ASSERT `s 21(5) the person has a defence` `an offence under s 18` FALSE TRUE EQUALS NOTHING
#ASSERT `s 21(6) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 21(6) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 21(7) the involvement is in a transaction or arrangement relating to money or other property` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 21(7) the involvement is in a transaction or arrangement relating to money or other property` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 21(7) the involvement is in a transaction or arrangement relating to money or other property` FALSE FALSE EQUALS NOTHING

