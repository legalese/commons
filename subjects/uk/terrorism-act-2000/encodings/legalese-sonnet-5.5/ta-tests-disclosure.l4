§§ `s 20 tests`
#ASSERT `s 20(1) the person may disclose to a constable` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 20(1) the person may disclose to a constable` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 20(1) the person may disclose to a constable` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 20(1) the person may disclose to a constable` FALSE FALSE TRUE EQUALS NOTHING
#TRACE `s 20(1) the person may disclose to a constable, as a permission` AT 0 WITH
    PARTY `the person` DOES `disclose the matter to a constable` AT 3
#ASSERT `s 20(2) the person may make a disclosure to a constable in the circumstances mentioned in s 19(1) and (2)` `believes, from business` TRUE EQUALS JUST TRUE
#ASSERT `s 20(2) the person may make a disclosure to a constable in the circumstances mentioned in s 19(1) and (2)` `believes, from business` FALSE EQUALS NOTHING
#ASSERT `s 20(2) the person may make a disclosure to a constable in the circumstances mentioned in s 19(1) and (2)` `does not believe, from business` TRUE EQUALS NOTHING
#ASSERT `s 20(3) a restriction on disclosure imposed by statute or otherwise does not prevent the disclosure` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 20(3) a restriction on disclosure imposed by statute or otherwise does not prevent the disclosure` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 20(3) a restriction on disclosure imposed by statute or otherwise does not prevent the disclosure` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 20(4) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 20(4) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 20(4) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 20(4) a disclosure in accordance with the employer's procedure counts as a disclosure to a constable` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 20(5) the person is a constable for the purposes of s 20` (`Officer facts` OF TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 20(5) the person is a constable for the purposes of s 20` (`Officer facts` OF FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 20(5) the person is a constable for the purposes of s 20` (`Officer facts` OF FALSE, FALSE) EQUALS NOTHING

