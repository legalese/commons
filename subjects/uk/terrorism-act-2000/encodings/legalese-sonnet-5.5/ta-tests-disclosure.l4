IMPORT prelude
IMPORT daydate
IMPORT `ta-nouns`
IMPORT `ta-logic`
IMPORT `ta-disclosure`

-- Tests of ss 19, 20, 21, 21ZA, 21ZB, 21ZC and 22A.  Expected values are written from the text (the quoted words beside each).
-- Calendar used below (2026): Sun 1 Nov, Mon 2, Tue 3, Wed 4, Thu 5, Fri 6, Sat 7, Sun 8, Mon 9, Tue 10, Wed 11, Thu 12, Fri 13, Sat 14, Sun 15,
-- Mon 16, Tue 17 Nov; Mon 21 Dec, Fri 25 Dec (Christmas Day), Sat 26, Sun 27, Mon 28, Tue 29, Wed 30, Thu 31 Dec; Fri 1 Jan 2027.

-- ---------------------------------------------------------------------------
§§ `s 22A tests`
-- Employment facts columns: any employment, a contract for services or office, work experience, voluntary work
#ASSERT `s 22A(a) the work is employment` (`Employment facts` OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 22A(a) the work is employment` (`Employment facts` OF FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 22A(a) the work is employment` (`Employment facts` OF FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 22A(a) the work is employment` (`Employment facts` OF FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 22A(a) the work is employment` (`Employment facts` OF FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 22A(b) the person is the employer` (`Employment facts` OF TRUE, FALSE, FALSE, FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 22A(b) the person is the employer` (`Employment facts` OF FALSE, FALSE, FALSE, TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 22A(b) the person is the employer` (`Employment facts` OF TRUE, FALSE, FALSE, FALSE) FALSE EQUALS NOTHING
#ASSERT `s 22A(b) the person is the employer` (`Employment facts` OF FALSE, FALSE, FALSE, FALSE) TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `s 19 tests`
-- Information facts columns: believes or suspects an offence under ss 15 to 18, from a trade, profession or business, from employment, in the regulated sector
`believes, from business` MEANS `Information facts` OF TRUE, TRUE, FALSE, FALSE
`believes, from employment` MEANS `Information facts` OF TRUE, FALSE, TRUE, FALSE
`believes, from neither` MEANS `Information facts` OF TRUE, FALSE, FALSE, FALSE
`does not believe, from business` MEANS `Information facts` OF FALSE, TRUE, FALSE, FALSE
`believes, from business, in the regulated sector` MEANS `Information facts` OF TRUE, TRUE, FALSE, TRUE
-- Disclosure facts columns: discloses the belief or suspicion, discloses the information, as soon as is reasonably practicable
`disclosed both promptly` MEANS `Disclosure facts` OF TRUE, TRUE, TRUE
`disclosed nothing` MEANS `Disclosure facts` OF FALSE, FALSE, FALSE
`disclosed the belief only` MEANS `Disclosure facts` OF TRUE, FALSE, TRUE
`disclosed both late` MEANS `Disclosure facts` OF TRUE, TRUE, FALSE

#ASSERT `s 19(1) this section applies to the person` `believes, from business` EQUALS JUST TRUE
#ASSERT `s 19(1) this section applies to the person` `believes, from employment` EQUALS JUST TRUE
-- reading M1: a failed "where" in "This section applies where a person—" is the text's no (decided by the brief's rule, not by what the code printed)
#ASSERT `s 19(1) this section applies to the person` `believes, from neither` EQUALS JUST FALSE
#ASSERT `s 19(1) this section applies to the person` `does not believe, from business` EQUALS JUST FALSE
#ASSERT `s 19(1A) this section does not apply to the person` TRUE EQUALS JUST TRUE
#ASSERT `s 19(1A) this section does not apply to the person` FALSE EQUALS JUST FALSE

-- s 19(2) "commits an offence if he does not disclose to a constable as soon as is reasonably practicable (a) his belief or suspicion, and (b) the information"
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from business` `disclosed nothing` EQUALS JUST TRUE
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from employment` `disclosed nothing` EQUALS JUST TRUE
-- reading F2 (NOTES.md): failing to disclose either (a) or (b), or failing to do it promptly, is not having disclosed
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from business` `disclosed the belief only` EQUALS JUST TRUE
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from business` `disclosed both late` EQUALS JUST TRUE
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from business` `disclosed both promptly` EQUALS JUST FALSE
-- s 19(1A): the regulated sector is outside the section, whatever was disclosed
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from business, in the regulated sector` `disclosed nothing` EQUALS JUST FALSE
-- the section does not apply (no belief, or information from neither source): by M1 that is the text's no
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `does not believe, from business` `disclosed nothing` EQUALS JUST FALSE
#ASSERT `s 19(2) the person commits an offence by not disclosing to a constable` `believes, from neither` `disclosed nothing` EQUALS JUST FALSE
#TRACE `s 19(2) the person must disclose to a constable` AT 0 WITH
    PARTY `the person` DOES `disclose the belief or suspicion and the information to a constable` AT 3
-- the trace above must end FULFILLED; with no event the obligation stands (no WITHIN: the text names no period, only "as soon as is reasonably practicable")
#TRACE `s 19(2) the person must disclose to a constable` AT 0 WITH
    PARTY `a constable` DOES `disclose the matter to a constable` AT 3

#ASSERT `s 19(3) the person has a defence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 19(3) the person has a defence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 19(3) the person has a defence` FALSE TRUE EQUALS NOTHING

-- ruling of 2026-11-05 (b): a "where" condition of s 19(4) that is not met (not in employment, no procedure, not charged) is JUST FALSE; the procedure not followed is the proof the person must make, so NOTHING
-- Procedure facts columns: in employment, employer has established a procedure, charged with the offence, disclosed in accordance with the procedure
#ASSERT `s 19(4) the person has a defence` (`Procedure facts` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 19(4) the person has a defence` (`Procedure facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 19(4) the person has a defence` (`Procedure facts` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 19(4) the person has a defence` (`Procedure facts` OF TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 19(4) the person has a defence` (`Procedure facts` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING

-- s 19(5): an adviser is not required to disclose privileged information or a belief based on it
#ASSERT `s 19(5) subsection (2) requires the professional legal adviser to disclose` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 19(5) subsection (2) requires the professional legal adviser to disclose` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 19(5) subsection (2) requires the professional legal adviser to disclose` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 19(5) subsection (2) requires the professional legal adviser to disclose` TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 19(5) subsection (2) requires the professional legal adviser to disclose` TRUE NOTHING NOTHING EQUALS NOTHING

-- Privilege facts columns: otherwise than to further a criminal purpose, from a client, from a person seeking advice, for legal proceedings
#ASSERT `s 19(6) the information is obtained by the adviser in privileged circumstances` (`Privilege facts` OF TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 19(6) the information is obtained by the adviser in privileged circumstances` (`Privilege facts` OF TRUE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 19(6) the information is obtained by the adviser in privileged circumstances` (`Privilege facts` OF TRUE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 19(6) the information is obtained by the adviser in privileged circumstances` (`Privilege facts` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 19(6) the information is obtained by the adviser in privileged circumstances` (`Privilege facts` OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST FALSE

-- Act abroad facts columns: took an action or was in possession of a thing, would have committed an offence under ss 15 to 18 if in the United Kingdom
#ASSERT `s 19(7) the person is treated as having committed an offence under one of sections 15 to 18` (`Act abroad facts` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 19(7) the person is treated as having committed an offence under one of sections 15 to 18` (`Act abroad facts` OF TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 19(7) the person is treated as having committed an offence under one of sections 15 to 18` (`Act abroad facts` OF FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 19(7A) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 19(7A) the business is a business in the regulated sector` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 19(7A) the business is a business in the regulated sector` NOTHING EQUALS NOTHING

-- Officer facts columns: a constable, a National Crime Agency officer authorised for the purposes of the section
#ASSERT `s 19(7B) the person is a constable for the purposes of s 19` (`Officer facts` OF TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 19(7B) the person is a constable for the purposes of s 19` (`Officer facts` OF FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 19(7B) the person is a constable for the purposes of s 19` (`Officer facts` OF FALSE, FALSE) EQUALS NOTHING
-- s 19(8): "five years" is 60 months; the fine on indictment has no stated ceiling; 4000 is a test input for the statutory maximum, not the Act's figure
#ASSERT `s 19(8) the ceiling of the penalty for an offence under s 19` `on conviction on indictment` 4000 EQUALS `Penalty ceiling` OF 60, `No ceiling is stated`
#ASSERT `s 19(8) the ceiling of the penalty for an offence under s 19` `on summary conviction` 4000 EQUALS `Penalty ceiling` OF 6, `A fine not exceeding` 4000

