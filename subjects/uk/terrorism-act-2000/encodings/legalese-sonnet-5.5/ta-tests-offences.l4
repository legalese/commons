IMPORT prelude
IMPORT `ta-nouns`
IMPORT `ta-interpretation`
IMPORT `ta-offences`

-- Tests of ss 15 to 18, 17A and 22.  Expected values are written from the text (the quoted words beside each).
-- Positional OF, columns named once:
--   Fund-raising act:   invites another, receives, gives, lends, otherwise makes available, for consideration
--   Mind:               intends it be used, knows it will be used, reasonable cause to suspect it will or may be used
--   Use and possession: uses it for terrorism, possesses it
--   Arrangement act:    enters into, becomes concerned in, result: made available to another

`no mind` MEANS `Mind about use for terrorism` OF FALSE, FALSE, FALSE
`intends` MEANS `Mind about use for terrorism` OF TRUE, FALSE, FALSE
`knows` MEANS `Mind about use for terrorism` OF FALSE, TRUE, FALSE
`suspects` MEANS `Mind about use for terrorism` OF FALSE, FALSE, TRUE

`does nothing` MEANS `Fund-raising act` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`invites` MEANS `Fund-raising act` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`receives` MEANS `Fund-raising act` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`gives, for consideration` MEANS `Fund-raising act` OF FALSE, FALSE, TRUE, FALSE, FALSE, TRUE
`gives, not for consideration` MEANS `Fund-raising act` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`lends` MEANS `Fund-raising act` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`otherwise makes available` MEANS `Fund-raising act` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE

-- s 15(4): "given, lent or otherwise made available, whether or not for consideration"
#ASSERT `s 15(4) the person provides money or other property` `gives, for consideration` EQUALS JUST TRUE
#ASSERT `s 15(4) the person provides money or other property` `gives, not for consideration` EQUALS JUST TRUE
#ASSERT `s 15(4) the person provides money or other property` `lends` EQUALS JUST TRUE
#ASSERT `s 15(4) the person provides money or other property` `otherwise makes available` EQUALS JUST TRUE
#ASSERT `s 15(4) the person provides money or other property` `invites` EQUALS JUST FALSE
#ASSERT `s 15(4) the person provides money or other property` `does nothing` EQUALS JUST FALSE

-- s 15(1) "invites another ... and intends that it should be used, or has reasonable cause to suspect that it may be used"
#ASSERT `s 15(1) the person commits an offence by inviting another to provide money or other property` `invites` `intends` EQUALS JUST TRUE
#ASSERT `s 15(1) the person commits an offence by inviting another to provide money or other property` `invites` `suspects` EQUALS JUST TRUE
#ASSERT `s 15(1) the person commits an offence by inviting another to provide money or other property` `invites` `no mind` EQUALS JUST FALSE
#ASSERT `s 15(1) the person commits an offence by inviting another to provide money or other property` `does nothing` `intends` EQUALS JUST FALSE
#ASSERT `s 15(1) the person commits an offence by inviting another to provide money or other property` `receives` `suspects` EQUALS JUST FALSE

-- s 15(2) "receives money or other property, and intends ... or has reasonable cause to suspect"
#ASSERT `s 15(2) the person commits an offence by receiving money or other property` `receives` `intends` EQUALS JUST TRUE
#ASSERT `s 15(2) the person commits an offence by receiving money or other property` `receives` `suspects` EQUALS JUST TRUE
#ASSERT `s 15(2) the person commits an offence by receiving money or other property` `receives` `no mind` EQUALS JUST FALSE
#ASSERT `s 15(2) the person commits an offence by receiving money or other property` `invites` `suspects` EQUALS JUST FALSE

-- s 15(3) "provides money or other property, and knows or has reasonable cause to suspect that it will or may be used"
#ASSERT `s 15(3) the person commits an offence by providing money or other property` `gives, for consideration` `knows` EQUALS JUST TRUE
#ASSERT `s 15(3) the person commits an offence by providing money or other property` `lends` `suspects` EQUALS JUST TRUE
#ASSERT `s 15(3) the person commits an offence by providing money or other property` `otherwise makes available` `knows` EQUALS JUST TRUE
#ASSERT `s 15(3) the person commits an offence by providing money or other property` `gives, not for consideration` `no mind` EQUALS JUST FALSE
#ASSERT `s 15(3) the person commits an offence by providing money or other property` `receives` `knows` EQUALS JUST FALSE

`uses` MEANS `Use and possession act` OF TRUE, FALSE
`possesses` MEANS `Use and possession act` OF FALSE, TRUE
`neither uses nor possesses` MEANS `Use and possession act` OF FALSE, FALSE

-- s 16(1) "uses money or other property for the purposes of terrorism"; no mental element is stated
#ASSERT `s 16(1) the person commits an offence by using money or other property for the purposes of terrorism` `uses` EQUALS JUST TRUE
#ASSERT `s 16(1) the person commits an offence by using money or other property for the purposes of terrorism` `possesses` EQUALS JUST FALSE
-- s 16(2) "possesses money or other property, and intends ... or has reasonable cause to suspect"
#ASSERT `s 16(2) the person commits an offence by possessing money or other property` `possesses` `intends` EQUALS JUST TRUE
#ASSERT `s 16(2) the person commits an offence by possessing money or other property` `possesses` `suspects` EQUALS JUST TRUE
#ASSERT `s 16(2) the person commits an offence by possessing money or other property` `possesses` `no mind` EQUALS JUST FALSE
#ASSERT `s 16(2) the person commits an offence by possessing money or other property` `neither uses nor possesses` `intends` EQUALS JUST FALSE

`enters into, result` MEANS `Arrangement act` OF TRUE, FALSE, TRUE
`becomes concerned in, result` MEANS `Arrangement act` OF FALSE, TRUE, TRUE
`enters into, no result` MEANS `Arrangement act` OF TRUE, FALSE, FALSE
`no arrangement, result` MEANS `Arrangement act` OF FALSE, FALSE, TRUE

-- s 17 "enters into or becomes concerned in an arrangement as a result of which money or other property is made available ... to another, and he knows or has reasonable cause to suspect"
#ASSERT `s 17 the person commits an offence by a funding arrangement` `enters into, result` `knows` EQUALS JUST TRUE
#ASSERT `s 17 the person commits an offence by a funding arrangement` `becomes concerned in, result` `suspects` EQUALS JUST TRUE
#ASSERT `s 17 the person commits an offence by a funding arrangement` `enters into, no result` `knows` EQUALS JUST FALSE
#ASSERT `s 17 the person commits an offence by a funding arrangement` `enters into, result` `no mind` EQUALS JUST FALSE
#ASSERT `s 17 the person commits an offence by a funding arrangement` `no arrangement, result` `knows` EQUALS JUST FALSE

-- s 17A(1).  Insurance payment facts columns: is the insurer, paid under the contract or purportedly, in respect of property handed over to a terrorist demand,
--                                              insurer knows or suspects, the person authorising for the insurer knows or suspects
`insurer paid, insurer knows` MEANS `Insurance payment facts` OF TRUE, TRUE, TRUE, TRUE, FALSE
`insurer paid, only the authoriser knows` MEANS `Insurance payment facts` OF TRUE, TRUE, TRUE, FALSE, TRUE
`insurer paid, nobody knows` MEANS `Insurance payment facts` OF TRUE, TRUE, TRUE, FALSE, FALSE
`not the insurer` MEANS `Insurance payment facts` OF FALSE, TRUE, TRUE, TRUE, TRUE
`no payment` MEANS `Insurance payment facts` OF TRUE, FALSE, TRUE, TRUE, TRUE
`payment not in response to a terrorist demand` MEANS `Insurance payment facts` OF TRUE, TRUE, FALSE, TRUE, TRUE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `insurer paid, insurer knows` EQUALS JUST TRUE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `insurer paid, only the authoriser knows` EQUALS JUST TRUE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `insurer paid, nobody knows` EQUALS JUST FALSE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `not the insurer` EQUALS JUST FALSE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `no payment` EQUALS JUST FALSE
#ASSERT `s 17A(1) the insurer commits an offence by paying under the contract` `payment not in response to a terrorist demand` EQUALS JUST FALSE

-- s 17A(2) and (4).  Officer liability facts columns: by a body corporate, by a Scottish partnership, consent or connivance, neglect,
--                                                      director manager secretary or similar, partner, purporting to act
`director consented, body corporate` MEANS `Officer liability facts` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE
`manager neglected, body corporate` MEANS `Officer liability facts` OF TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE
`purporting to act, consented, body corporate` MEANS `Officer liability facts` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE
`officer but neither consented nor neglected` MEANS `Officer liability facts` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`consented but no officer and not purporting` MEANS `Officer liability facts` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`director consented, offence not by a body corporate` MEANS `Officer liability facts` OF FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE
`partner consented, Scottish partnership` MEANS `Officer liability facts` OF FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, FALSE
`partner neglected, Scottish partnership` MEANS `Officer liability facts` OF FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE
`purporting to act as partner, consented` MEANS `Officer liability facts` OF FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE
`partner but neither consented nor neglected` MEANS `Officer liability facts` OF FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE
`partner consented, offence not by a Scottish partnership` MEANS `Officer liability facts` OF FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `director consented, body corporate` EQUALS JUST TRUE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `manager neglected, body corporate` EQUALS JUST TRUE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `purporting to act, consented, body corporate` EQUALS JUST TRUE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `officer but neither consented nor neglected` EQUALS JUST FALSE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `consented but no officer and not purporting` EQUALS JUST FALSE
#ASSERT `s 17A(2) the officer is guilty of the offence as well as the body corporate` `director consented, offence not by a body corporate` EQUALS JUST FALSE
#ASSERT `s 17A(4) the partner is guilty of the offence as well as the partnership` `partner consented, Scottish partnership` EQUALS JUST TRUE
#ASSERT `s 17A(4) the partner is guilty of the offence as well as the partnership` `partner neglected, Scottish partnership` EQUALS JUST TRUE
#ASSERT `s 17A(4) the partner is guilty of the offence as well as the partnership` `purporting to act as partner, consented` EQUALS JUST TRUE
#ASSERT `s 17A(4) the partner is guilty of the offence as well as the partnership` `partner but neither consented nor neglected` EQUALS JUST FALSE
#ASSERT `s 17A(4) the partner is guilty of the offence as well as the partnership` `partner consented, offence not by a Scottish partnership` EQUALS JUST FALSE

-- s 17A(3) "in relation to a body corporate whose affairs are managed by its members, is a reference to a member"
#ASSERT `s 17A(3) the person is the body corporate's director for the purposes of s 17A(2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 17A(3) the person is the body corporate's director for the purposes of s 17A(2)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 17A(3) the person is the body corporate's director for the purposes of s 17A(2)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 17A(3) the person is the body corporate's director for the purposes of s 17A(2)` FALSE FALSE EQUALS NOTHING

-- s 17A(5) "a contract under which one party accepts significant insurance risk from another party ... by agreeing to compensate"
#ASSERT `s 17A(5) the contract is an insurance contract` (`Contract facts` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 17A(5) the contract is an insurance contract` (`Contract facts` OF TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 17A(5) the contract is an insurance contract` (`Contract facts` OF FALSE, TRUE) EQUALS JUST FALSE

-- s 18.  Laundering act columns: enters into, becomes concerned in, facilitates by concealment, by removal from the jurisdiction, by transfer to nominees, in any other way
`enters into, conceals` MEANS `Laundering act` OF TRUE, FALSE, TRUE, FALSE, FALSE, FALSE
`concerned in, removes from the jurisdiction` MEANS `Laundering act` OF FALSE, TRUE, FALSE, TRUE, FALSE, FALSE
`enters into, transfers to nominees` MEANS `Laundering act` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE
`concerned in, any other way` MEANS `Laundering act` OF FALSE, TRUE, FALSE, FALSE, FALSE, TRUE
`enters into, facilitates in no way` MEANS `Laundering act` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`not involved in an arrangement, conceals` MEANS `Laundering act` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
-- Property facts columns: likely to be used, a proscribed organisation's, proceeds of terrorism, proceeds of acts for terrorism
`no proceeds` MEANS `Proceeds facts` OF FALSE, FALSE, FALSE
`terrorist property` MEANS `Property facts` OF TRUE, FALSE, `no proceeds`, `no proceeds`
`not terrorist property` MEANS `Property facts` OF FALSE, FALSE, `no proceeds`, `no proceeds`
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `enters into, conceals` `terrorist property` EQUALS JUST TRUE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `concerned in, removes from the jurisdiction` `terrorist property` EQUALS JUST TRUE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `enters into, transfers to nominees` `terrorist property` EQUALS JUST TRUE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `concerned in, any other way` `terrorist property` EQUALS JUST TRUE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `enters into, facilitates in no way` `terrorist property` EQUALS JUST FALSE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `not involved in an arrangement, conceals` `terrorist property` EQUALS JUST FALSE
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `enters into, conceals` `not terrorist property` EQUALS JUST FALSE
-- s 14(1) "means" is closed (F1), so an arrangement over property that is not terrorist property misses the last element of s 18(1): JUST FALSE
-- a missing element of s 18(1) is JUST FALSE whatever s 14 says
#ASSERT `s 18(1) the person commits an offence by an arrangement that facilitates retention or control of terrorist property` `not involved in an arrangement, conceals` `not terrorist property` EQUALS JUST FALSE

-- s 18(2) "a defence ... to prove that he did not know and had no reasonable cause to suspect"; Proof columns: did not know, no reasonable cause to suspect
#ASSERT `s 18(2) the person has a defence` TRUE (`Proof about terrorist property` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 18(2) the person has a defence` TRUE (`Proof about terrorist property` OF TRUE, FALSE) EQUALS NOTHING
#ASSERT `s 18(2) the person has a defence` TRUE (`Proof about terrorist property` OF FALSE, TRUE) EQUALS NOTHING
#ASSERT `s 18(2) the person has a defence` FALSE (`Proof about terrorist property` OF TRUE, TRUE) EQUALS NOTHING

-- s 22.  The summary fine ceiling is "the statutory maximum", which the Act does not state; 5000 here is a test input, not the Act's figure.
#ASSERT `s 22 the ceiling of the penalty for an offence under any of sections 15 to 18` `on conviction on indictment` 5000 EQUALS `Penalty ceiling` OF 168, `No ceiling is stated`
#ASSERT `s 22 the ceiling of the penalty for an offence under any of sections 15 to 18` `on summary conviction` 5000 EQUALS `Penalty ceiling` OF 6, `A fine not exceeding` 5000
#ASSERT `s 22 the ceiling of the penalty for an offence under any of sections 15 to 18` `on summary conviction` 7000 EQUALS `Penalty ceiling` OF 6, `A fine not exceeding` 7000

-- 70 assertions written; 70 satisfied (run with l4 1.6.109 on the main build; check.sh recounts)
