IMPORT prelude
IMPORT daydate

-- Trade Union and Labour Relations (Consolidation) Act 1992 (UK) — THE NOUNS.
-- No rules here. Source: ../registers/source-bundle/ukpga-1992-52.txt (point
-- in time 25 August 2026). Seat: the worker or employee.

§ `Nouns`

-- s 292A(2): Day A, when the complainant contacted ACAS; Day B, when the
-- certificate was received (or treated as received).
DECLARE `Early conciliation` HAS
    `Day A`                                             IS A DATE
    `Day B`                                             IS A DATE

§§ `Union membership and activities (ss 146-161)`

-- The sole or main purpose of the act (s 146(1)), or the reason or principal
-- reason for the dismissal (s 152(1)), as found.
DECLARE `Union reason` IS ONE OF
    -- s 146(1)(a), 152(1)(a)
    `membership of an independent trade union`
    -- s 146(1)(b), 152(1)(b)
    `taking part in independent union activities`
    -- s 146(1)(ba), 152(1)(ba), (2B)
    `making use of union services`
    -- s 152(1)(bb), 146(2C): failing to accept an offer contrary to s 145A or
    -- 145B
    `refusing an unlawful inducement`
    -- s 146(1)(c), 152(1)(c): non-membership, or refusing to join or remain
    `not being a member`
    -- s 146(3), 152(3): a requirement to make payments in lieu of membership
    `refusing payments in lieu of membership`
    `some other reason`

DECLARE `Treatment` IS ONE OF
    `a detriment short of dismissal`
    `dismissal`
    -- s 153: selection for redundancy
    `selection for redundancy`

DECLARE `Union case` HAS
    `the reason`                                        IS A `Union reason`
    -- s 146(2), 152(2): outside working hours, or within them by arrangement
    -- or with consent.
    `at an appropriate time`                            IS A BOOLEAN
    `an employee`                                       IS A BOOLEAN
    `the treatment`                                     IS A `Treatment`
    -- s 153(a): others in similar positions to whom the redundancy applied
    -- equally were not dismissed.
    `others similarly placed were not dismissed`        IS A BOOLEAN
    -- s 147(1)(a), (2): the act or failure, or the last of a series, or the
    -- last day of an act extending over a period.
    `act on`                                            IS A DATE
    `early conciliation`                                IS A MAYBE `Early conciliation`
    -- s 161(2), (6)
    `effective date of termination`                     IS A MAYBE DATE
    `interim relief applied for on`                     IS A MAYBE DATE
    `union certificate presented on`                    IS A MAYBE DATE
    -- s 161(3): an offer contrary to s 145A(1)(d) needs no certificate.
    `the offer was under s 145A(1)(d)`                  IS A BOOLEAN
    -- the basic award under the Employment Rights Act 1996, before any
    -- reduction under its s 122
    `basic award before reductions`                     IS A NUMBER

§§ `Collective redundancies (ss 188-192)`

DECLARE `Redundancy case` HAS
    -- s 188(A1): proposed to be dismissed as redundant within 90 days or less
    `proposed dismissals in all`                        IS A NUMBER
    `proposed dismissals at my establishment`           IS A NUMBER
    -- s 195A: the threshold number set by regulations (at least 20)
    `threshold number`                                  IS A NUMBER
    `first dismissal takes effect on`                   IS A DATE
    `last dismissal takes effect on`                    IS A DATE
    `consultation began on`                             IS A MAYBE DATE
    `early conciliation`                                IS A MAYBE `Early conciliation`
    `the award`                                         IS A MAYBE `Protective award`

DECLARE `Protective award` HAS
    `award made on`                                     IS A DATE
    -- s 189(4)(b): the length the tribunal determines, in days
    `days determined`                                   IS A NUMBER
    -- s 190(2), (5)
    `a week's pay`                                      IS A NUMBER
    -- s 190(4), (6), s 191: days of the period for which I am not entitled
    `days not payable`                                  IS A NUMBER
    -- s 192(2)(a): the last day for which remuneration was not paid
    `last unpaid day`                                   IS A MAYBE DATE
    `early conciliation for non-payment`                IS A MAYBE `Early conciliation`

§§ `Protected industrial action (ss 238A-239)`

DECLARE `Industrial action case` HAS
    -- s 238A(1): the acts were induced by an act not actionable in tort by
    -- virtue of s 219.
    `I took protected industrial action`                IS A BOOLEAN
    -- s 238A(2)(a): the reason or principal reason for the dismissal
    `that was the reason for the dismissal`             IS A BOOLEAN
    -- s 238(5): the day the employer's notice was given, if the contract was
    -- ended by notice
    `employer's notice given on`                        IS A MAYBE DATE
    `effective date of termination`                     IS A DATE
