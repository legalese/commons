IMPORT prelude
IMPORT daydate
IMPORT `tulrca-types`
IMPORT `tulrca-periods`
IMPORT `tulrca-union`
IMPORT `tulrca-redundancy`
IMPORT `tulrca-goal`

-- Independent tests for the TULRCA 1992 encoding. Expected values come from
-- independent-expectations.md, written from BRIEF.md and the Act before the
-- code was read. A failing assertion is a finding; expected values are not
-- changed to fit the code.

§ `Helpers`

GIVEN p IS A `Union reason`, q IS A BOOLEAN, e IS A BOOLEAN, t IS A `Treatment`
GIVETH A `Union case`
`ucase` p q e t MEANS
    `Union case` OF p, q, e, t, FALSE, (Date 1 1 2026), NOTHING, NOTHING, NOTHING, NOTHING, FALSE, 0

GIVEN p IS A `Union reason`, o IS A BOOLEAN, t IS A `Treatment`
GIVETH A `Union case`
`rsel` p o t MEANS
    `Union case` OF p, TRUE, TRUE, t, o, (Date 1 1 2026), NOTHING, NOTHING, NOTHING, NOTHING, FALSE, 0

-- a detriment on membership grounds to a worker, on day d
GIVEN d IS A DATE, k IS A MAYBE `Early conciliation`
GIVETH A `Union case`
`dcase` d k MEANS
    `Union case` OF `membership of an independent trade union`, TRUE, FALSE, `a detriment short of dismissal`, FALSE, d, k, NOTHING, NOTHING, NOTHING, FALSE, 0

GIVEN p IS A `Union reason`, t IS A DATE, a IS A MAYBE DATE, c IS A MAYBE DATE, o IS A BOOLEAN
GIVETH A `Union case`
`ircase` p t a c o MEANS
    `Union case` OF p, TRUE, TRUE, `dismissal`, FALSE, (Date 1 1 2026), NOTHING, (JUST t), a, c, o, 0

GIVEN n IS A NUMBER
GIVETH A `Union case`
`bcase` n MEANS
    `Union case` OF `membership of an independent trade union`, TRUE, TRUE, `dismissal`, FALSE, (Date 1 1 2026), NOTHING, NOTHING, NOTHING, NOTHING, FALSE, n

GIVEN a IS A DATE, b IS A DATE
GIVETH A MAYBE `Early conciliation`
`ec` a b MEANS JUST (`Early conciliation` OF a, b)

GIVEN n IS A NUMBER, m IS A NUMBER, h IS A NUMBER, f IS A DATE
GIVETH A `Redundancy case`
`rcase` n m h f MEANS
    `Redundancy case` OF n, m, h, f, f, NOTHING, NOTHING, NOTHING

GIVEN b IS A DATE
GIVETH A `Redundancy case`
`rbegan` b MEANS
    `Redundancy case` OF 20, 20, 25, (Date 1 3 2026), (Date 1 3 2026), (JUST b), NOTHING, NOTHING

GIVEN l IS A DATE, k IS A MAYBE `Early conciliation`
GIVETH A `Redundancy case`
`rlast` l k MEANS
    `Redundancy case` OF 20, 20, 25, l, l, NOTHING, k, NOTHING

GIVEN d IS A DATE, n IS A NUMBER, w IS A NUMBER, x IS A NUMBER
GIVETH A `Protective award`
`pa` d n w x MEANS
    `Protective award` OF d, n, w, x, NOTHING, NOTHING

GIVEN d IS A DATE, k IS A MAYBE `Early conciliation`
GIVETH A `Protective award`
`unpaid` d k MEANS
    `Protective award` OF (Date 1 1 2027), 90, 700, 0, (JUST d), k

GIVEN f IS A DATE, d IS A DATE, n IS A NUMBER
GIVETH A DATE
`pend` f d n MEANS `the last day of the protected period for` (`rcase` 20 20 25 f) `under` (`pa` d n 700 0)

GIVEN f IS A DATE, d IS A DATE, n IS A NUMBER
GIVETH A DATE
`pstart` f d n MEANS `the first day of the protected period for` (`rcase` 20 20 25 f) `under` (`pa` d n 700 0)

GIVEN d IS A DATE, k IS A MAYBE `Early conciliation`
GIVETH A MAYBE DATE
`s147` d k MEANS `the last day to complain of the detriment for` (`dcase` d k)

§ `Goal 1 — protection (ss 146, 152, 153, 154)`

-- P1
#ASSERT `I am protected under the union provisions` (`ucase` `membership of an independent trade union` TRUE FALSE `a detriment short of dismissal`)
-- P2
#ASSERT `I am protected under the union provisions` (`ucase` `taking part in independent union activities` TRUE FALSE `a detriment short of dismissal`)
-- P3
#ASSERT NOT (`I am protected under the union provisions` (`ucase` `taking part in independent union activities` FALSE FALSE `a detriment short of dismissal`))
-- P4 (consent: appropriate time)
#ASSERT `I am protected under the union provisions` (`ucase` `making use of union services` TRUE FALSE `a detriment short of dismissal`)
-- P5
#ASSERT `I am protected under the union provisions` (`ucase` `not being a member` TRUE FALSE `a detriment short of dismissal`)
-- P6
#ASSERT `I am protected under the union provisions` (`ucase` `refusing payments in lieu of membership` TRUE FALSE `a detriment short of dismissal`)
-- other reason
#ASSERT NOT (`I am protected under the union provisions` (`ucase` `some other reason` TRUE FALSE `a detriment short of dismissal`))
-- P7: employee, detriment amounts to dismissal: s 146 does not apply, so no s 147 limit
#ASSERT `the last day to complain of the detriment for` (`ucase` `membership of an independent trade union` TRUE TRUE `dismissal`) EQUALS NOTHING
-- P8: a worker who is not an employee, whose engagement is ended: s 146(5A) does not take him out of s 146
#ASSERT `I am protected under the union provisions` (`ucase` `membership of an independent trade union` TRUE FALSE `dismissal`)
#ASSERT `the last day to complain of the detriment for` (`ucase` `membership of an independent trade union` TRUE FALSE `dismissal`) EQUALS JUST (Date 31 3 2026)
-- P9
#ASSERT `I am protected under the union provisions` (`ucase` `membership of an independent trade union` TRUE TRUE `dismissal`)
-- P10
#ASSERT NOT (`I am protected under the union provisions` (`ucase` `taking part in independent union activities` FALSE TRUE `dismissal`))
-- P11
#ASSERT `I am protected under the union provisions` (`ucase` `refusing payments in lieu of membership` TRUE TRUE `dismissal`)
-- P12
#ASSERT `I am protected under the union provisions` (`ucase` `not being a member` TRUE TRUE `dismissal`)
-- P13
#ASSERT `I am protected under the union provisions` (`rsel` `membership of an independent trade union` TRUE `selection for redundancy`)
-- P14
#ASSERT NOT (`I am protected under the union provisions` (`rsel` `membership of an independent trade union` FALSE `selection for redundancy`))
-- P15
#ASSERT `the qualifying period is disapplied for` (`ucase` `membership of an independent trade union` TRUE TRUE `dismissal`)
#ASSERT `the qualifying period is disapplied for` (`rsel` `membership of an independent trade union` TRUE `selection for redundancy`)

§ `Goal 1 — minimum basic award (s 156(1))`

#ASSERT `the basic award before reductions for` (`bcase` 5000) EQUALS 9157
#ASSERT `the basic award before reductions for` (`bcase` 9156) EQUALS 9157
#ASSERT `the basic award before reductions for` (`bcase` 9157) EQUALS 9157
#ASSERT `the basic award before reductions for` (`bcase` 9158) EQUALS 9158
#ASSERT `the basic award before reductions for` (`bcase` 20000) EQUALS 20000

§ `Goal 1 — s 147 time limit`

-- L1
#ASSERT `s147` (Date 15 3 2026) NOTHING EQUALS JUST (Date 14 6 2026)
#ASSERT NOT (`s147` (Date 15 3 2026) NOTHING EQUALS JUST (Date 13 6 2026))
#ASSERT NOT (`s147` (Date 15 3 2026) NOTHING EQUALS JUST (Date 15 6 2026))
-- L2
#ASSERT `s147` (Date 31 1 2026) NOTHING EQUALS JUST (Date 30 4 2026)
-- L3
#ASSERT `s147` (Date 30 11 2025) NOTHING EQUALS JUST (Date 28 2 2026)
-- L4
#ASSERT `s147` (Date 30 11 2027) NOTHING EQUALS JUST (Date 29 2 2028)
-- L5
#ASSERT `s147` (Date 29 11 2027) NOTHING EQUALS JUST (Date 28 2 2028)
-- L6
#ASSERT `s147` (Date 1 12 2025) NOTHING EQUALS JUST (Date 28 2 2026)
-- L7 (last of a series)
#ASSERT `s147` (Date 10 3 2026) NOTHING EQUALS JUST (Date 9 6 2026)

-- C1
#ASSERT `s147` (Date 15 3 2026) (`ec` (Date 1 4 2026) (Date 15 4 2026)) EQUALS JUST (Date 28 6 2026)
-- C2
#ASSERT `s147` (Date 15 3 2026) (`ec` (Date 1 6 2026) (Date 10 6 2026)) EQUALS JUST (Date 10 7 2026)
-- C3 Day A on the limit
#ASSERT `s147` (Date 15 3 2026) (`ec` (Date 14 6 2026) (Date 20 6 2026)) EQUALS JUST (Date 20 7 2026)
-- C4 Day A the day after the limit
#ASSERT `s147` (Date 15 3 2026) (`ec` (Date 15 6 2026) (Date 20 6 2026)) EQUALS JUST (Date 14 6 2026)
-- C5 Day A the day before the limit
#ASSERT `s147` (Date 15 3 2026) (`ec` (Date 13 6 2026) (Date 20 6 2026)) EQUALS JUST (Date 20 7 2026)
-- C6 leap year, Day B 31 Jan
#ASSERT `s147` (Date 1 12 2027) (`ec` (Date 20 1 2028) (Date 31 1 2028)) EQUALS JUST (Date 11 3 2028)
-- C7
#ASSERT `s147` (Date 1 11 2026) (`ec` (Date 20 1 2027) (Date 31 1 2027)) EQUALS JUST (Date 28 2 2027)
-- C8 long conciliation running past the unextended limit
#ASSERT `s147` (Date 1 3 2026) (`ec` (Date 5 3 2026) (Date 20 6 2026)) EQUALS JUST (Date 15 9 2026)

§ `Goal 1 — interim relief (s 161)`

-- I1-I3: s 152(1)(c), no certificate needed
#ASSERT `my interim relief application is in time for` (`ircase` `not being a member` (Date 10 3 2026) (JUST (Date 17 3 2026)) NOTHING FALSE)
#ASSERT NOT (`my interim relief application is in time for` (`ircase` `not being a member` (Date 10 3 2026) (JUST (Date 18 3 2026)) NOTHING FALSE))
#ASSERT `my interim relief application is in time for` (`ircase` `not being a member` (Date 10 3 2026) (JUST (Date 5 3 2026)) NOTHING FALSE)
#ASSERT `my interim relief application is in time for` (`ircase` `not being a member` (Date 10 3 2026) (JUST (Date 16 3 2026)) NOTHING FALSE)
-- I4-I5
#ASSERT `the last day to apply for interim relief for` (`ircase` `not being a member` (Date 26 2 2028) NOTHING NOTHING FALSE) EQUALS JUST (Date 4 3 2028)
#ASSERT `the last day to apply for interim relief for` (`ircase` `not being a member` (Date 26 2 2026) NOTHING NOTHING FALSE) EQUALS JUST (Date 5 3 2026)
-- I6-I8: s 152(1)(b), certificate needed
#ASSERT `my interim relief application is in time for` (`ircase` `taking part in independent union activities` (Date 10 3 2026) (JUST (Date 17 3 2026)) (JUST (Date 17 3 2026)) FALSE)
#ASSERT NOT (`my interim relief application is in time for` (`ircase` `taking part in independent union activities` (Date 10 3 2026) (JUST (Date 17 3 2026)) (JUST (Date 18 3 2026)) FALSE))
#ASSERT NOT (`my interim relief application is in time for` (`ircase` `taking part in independent union activities` (Date 10 3 2026) (JUST (Date 17 3 2026)) NOTHING FALSE))
-- I9
#ASSERT NOT (`my interim relief application is in time for` (`ircase` `membership of an independent trade union` (Date 10 3 2026) (JUST (Date 12 3 2026)) NOTHING FALSE))
-- I10
#ASSERT `my interim relief application is in time for` (`ircase` `making use of union services` (Date 10 3 2026) (JUST (Date 12 3 2026)) (JUST (Date 12 3 2026)) FALSE)
-- I11: (bb) with a s 145A(1)(d) offer: no certificate
#ASSERT `my interim relief application is in time for` (`ircase` `refusing an unlawful inducement` (Date 10 3 2026) (JUST (Date 12 3 2026)) NOTHING TRUE)
-- I12: (bb) otherwise: certificate needed
#ASSERT NOT (`my interim relief application is in time for` (`ircase` `refusing an unlawful inducement` (Date 10 3 2026) (JUST (Date 12 3 2026)) NOTHING FALSE))
-- I13: s 152(3) payments, treated as (1)(c): no certificate
#ASSERT `my interim relief application is in time for` (`ircase` `refusing payments in lieu of membership` (Date 10 3 2026) (JUST (Date 12 3 2026)) NOTHING FALSE)
-- I14: s 153 only: no interim relief
#ASSERT `the last day to apply for interim relief for` (`Union case` OF `membership of an independent trade union`, TRUE, TRUE, `selection for redundancy`, TRUE, (Date 1 1 2026), NOTHING, (JUST (Date 10 3 2026)), (JUST (Date 11 3 2026)), (JUST (Date 11 3 2026)), FALSE, 0) EQUALS NOTHING

§ `Goal 2 — duty to consult (s 188)`

-- R1
#ASSERT `consultation is required for` (`rcase` 20 20 25 (Date 1 3 2026))
#ASSERT `the days of consultation needed for` (`rcase` 20 20 25 (Date 1 3 2026)) EQUALS 30
-- R2
#ASSERT NOT (`consultation is required for` (`rcase` 19 19 20 (Date 1 3 2026)))
#ASSERT `the last day for consultation to begin for` (`rcase` 19 19 20 (Date 1 3 2026)) EQUALS NOTHING
-- R3
#ASSERT `consultation is required for` (`rcase` 20 8 20 (Date 1 3 2026))
-- R4
#ASSERT NOT (`consultation is required for` (`rcase` 24 10 25 (Date 1 3 2026)))
-- R5
#ASSERT `consultation is required for` (`rcase` 25 10 25 (Date 1 3 2026))
-- R6
#ASSERT `the days of consultation needed for` (`rcase` 99 99 20 (Date 1 3 2026)) EQUALS 30
-- R7
#ASSERT `the days of consultation needed for` (`rcase` 100 100 20 (Date 1 3 2026)) EQUALS 45
-- R8: 120 in all, 60 at one establishment, threshold 150
#ASSERT `consultation is required for` (`rcase` 120 60 150 (Date 1 3 2026))
#ASSERT `the days of consultation needed for` (`rcase` 120 60 150 (Date 1 3 2026)) EQUALS 45
-- R9-R12
#ASSERT `the last day for consultation to begin for` (`rcase` 100 100 20 (Date 1 3 2026)) EQUALS JUST (Date 15 1 2026)
#ASSERT `the last day for consultation to begin for` (`rcase` 20 20 25 (Date 1 3 2026)) EQUALS JUST (Date 30 1 2026)
#ASSERT `the last day for consultation to begin for` (`rcase` 20 20 25 (Date 1 3 2028)) EQUALS JUST (Date 31 1 2028)
#ASSERT `the last day for consultation to begin for` (`rcase` 100 100 20 (Date 1 3 2028)) EQUALS JUST (Date 16 1 2028)
-- R13
#ASSERT `consultation began in time for` (`rbegan` (Date 29 1 2026))
#ASSERT `consultation began in time for` (`rbegan` (Date 30 1 2026))
#ASSERT NOT (`consultation began in time for` (`rbegan` (Date 31 1 2026)))

