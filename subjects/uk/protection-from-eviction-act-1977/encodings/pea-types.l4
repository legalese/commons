IMPORT prelude
IMPORT daydate

-- Protection from Eviction Act 1977 (UK) — THE NOUNS.
--
-- Facts about a letting, a notice to quit and a landlord's conduct. No rules
-- here. Source: ../registers/source-bundle/ukpga-1977-43.txt (revised text,
-- point in time 1 May 2026).

§ `Nouns`

DECLARE `Kind of occupancy` IS ONE OF
    `a tenancy`
    `a licence`
    -- s 8(2): exclusive possession under the terms of employment, other than
    -- as a tenant (deemed a tenant for Part I).
    `exclusive possession under employment`

-- s 3A: the facts behind each exclusion.
DECLARE `Exclusion facts` HAS
    -- s 3A(2): shares accommodation with the landlord or licensor, who
    -- occupied the shared premises as their only or principal home both
    -- immediately before the grant and when it ends.
    `shares with a resident landlord`                   IS A BOOLEAN
    -- s 3A(3): shares with a member of the landlord's family, who so
    -- occupied it; and the landlord occupied premises in the same building
    -- (not a purpose-built block of flats) at both times.
    `shares with a resident member of the landlord's family, landlord in the same building` IS A BOOLEAN
    -- s 3A(6)
    `granted as a temporary expedient to a trespasser`  IS A BOOLEAN
    -- s 3A(7)
    `for a holiday only`                                IS A BOOLEAN
    `granted otherwise than for money or money's worth` IS A BOOLEAN
    -- s 3A(7A), (7D)
    `asylum support accommodation`                      IS A BOOLEAN
    `an immigration-barred residential tenancy agreement` IS A BOOLEAN
    -- s 3A(8): a licence of a hostel provided by a body listed there.
    `a hostel licence from a listed body`               IS A BOOLEAN

DECLARE `Occupancy` HAS
    `kind`                                              IS A `Kind of occupancy`
    `let or occupied as a dwelling`                     IS A BOOLEAN
    -- s 8(1): a protected, statutory, assured, business or agricultural
    -- tenancy, or a Welsh occupation contract.
    `statutorily protected`                             IS A BOOLEAN
    -- s 3(2C): entered into before the Housing Act 1988 came into force, or
    -- under a contract made before then (or treated as new under s 8(5)).
    `entered into before the Housing Act 1988`          IS A BOOLEAN
    `exclusions`                                        IS AN `Exclusion facts`
    -- s 3(1)(a)-(b)
    `has come to an end`                                IS A BOOLEAN
    `occupier continues to reside`                      IS A BOOLEAN
    -- s 2: a lease subject to a right of re-entry or forfeiture, with a
    -- person lawfully residing in the premises.
    `a lease with a right of re-entry or forfeiture`    IS A BOOLEAN
    `someone lawfully residing`                         IS A BOOLEAN

-- s 5(1)(b): the two versions printed in the revised text.
DECLARE `Section 5 version` IS ONE OF
    `before the Renters' Rights Act 2025`
    `as amended by the Renters' Rights Act 2025`

DECLARE `Who gives notice` IS ONE OF
    `the landlord or licensor`
    `the tenant or licensee`

DECLARE `Notice to quit` HAS
    `version`                                           IS A `Section 5 version`
    `given by`                                          IS A `Who gives notice`
    -- s 5(1A): for a licence, whether it is periodic.
    `a periodic licence`                                IS A BOOLEAN
    -- s 5(1)(a): in writing, with the prescribed information.
    `in writing with the prescribed information`        IS A BOOLEAN
    `given on`                                          IS A DATE
    `to take effect on`                                 IS A DATE
    -- s 5(1ZA)(a): premises let under an assured tenancy.
    `an assured tenancy`                                IS A BOOLEAN
    -- s 5(1ZA)(a)(i): a shorter period, in days, the landlord agreed to in
    -- writing; NOTHING if none.
    `period agreed in writing, in days`                 IS A MAYBE NUMBER
    -- s 5(1ZB): for a joint tenancy, the agreement was made with all the
    -- tenants.
    `agreed with all the tenants`                       IS A BOOLEAN
    -- s 5(1C): a dwelling in Wales subject to an occupation contract.
    `a Welsh occupation contract`                       IS A BOOLEAN

-- s 1: what was done, and what was proved.
DECLARE `Conduct` HAS
    -- s 1(1)
    `the person is a residential occupier`              IS A BOOLEAN
    -- s 1(2)
    `unlawfully deprived, or attempted to deprive, the occupier of occupation` IS A BOOLEAN
    `proves a reasonable belief the occupier had ceased to reside` IS A BOOLEAN
    -- s 1(3), (3A)
    `did acts likely to interfere with peace or comfort` IS A BOOLEAN
    `persistently withdrew or withheld services`        IS A BOOLEAN
    `intended the occupier to give up occupation or refrain from a right` IS A BOOLEAN
    `is the landlord or the landlord's agent`           IS A BOOLEAN
    `knew or had reasonable cause to believe it likely to have that effect` IS A BOOLEAN
    `proves reasonable grounds for the conduct`         IS A BOOLEAN

DECLARE `Penalty facts` HAS
    `premises in England`                               IS A BOOLEAN
    -- s 1A(1): the authority is satisfied beyond reasonable doubt.
    `authority satisfied beyond reasonable doubt`       IS A BOOLEAN
    -- s 1A(2)
    `convicted for the conduct`                         IS A BOOLEAN
    `criminal proceedings pending`                      IS A BOOLEAN
    `criminal proceedings concluded without conviction` IS A BOOLEAN
    -- Schedule A1 para 1
    `first day of sufficient evidence`                  IS A DATE
    `conduct continuing on that day and beyond it`      IS A BOOLEAN
    -- NOTHING while the conduct continues.
    `last day of the conduct`                           IS A MAYBE DATE
    `notice of intent given on`                         IS A MAYBE DATE
    `final notice given on`                             IS A MAYBE DATE
