IMPORT prelude
IMPORT daydate
IMPORT `pea-types`
IMPORT `pea-eviction`
IMPORT `pea-notice-to-quit`
IMPORT `pea-penalty`
IMPORT `pea-goal`

-- Protection from Eviction Act 1977 (UK) — the encoder's tests.
-- Expected values are worked by hand from the Act, not from the code.

§ `Tests`

noExclusions MEANS `Exclusion facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
residentLandlord MEANS `Exclusion facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
hostel MEANS `Exclusion facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
holiday MEANS `Exclusion facts` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE

-- Fields: kind, dwelling, protected, before 1988, exclusions, ended,
-- resides, forfeiture lease, someone lawfully residing.
GIVEN kind IS A `Kind of occupancy`, protected IS A BOOLEAN, pre88 IS A BOOLEAN, x IS AN `Exclusion facts`,
      ended IS A BOOLEAN, resides IS A BOOLEAN
GIVETH AN `Occupancy`
`occupancy` kind `, protected` protected `, before 1988` pre88 `, exclusions` x `, ended` ended `, resides` resides MEANS
    `Occupancy` OF kind, TRUE, protected, pre88, x, ended, resides, FALSE, FALSE

ordinary MEANS `occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` TRUE `, resides` TRUE

§§ `Goal 1 — eviction only by court proceedings`

#ASSERT `court proceedings are required to recover possession from` ordinary
-- A statutorily protected tenancy: not this Act's s 3.
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` TRUE `, before 1988` FALSE `, exclusions` noExclusions `, ended` TRUE `, resides` TRUE))
-- The occupier no longer resides; the tenancy has not ended.
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` TRUE `, resides` FALSE))
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` FALSE `, resides` TRUE))
-- s 3A(2): a resident landlord; but s 3(2C) saves a tenancy from before 1988.
#ASSERT `is excluded` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` residentLandlord `, ended` TRUE `, resides` TRUE)
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` residentLandlord `, ended` TRUE `, resides` TRUE))
#ASSERT `court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` TRUE `, exclusions` residentLandlord `, ended` TRUE `, resides` TRUE)
-- The saving is for tenancies, not licences.
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a licence` `, protected` FALSE `, before 1988` TRUE `, exclusions` residentLandlord `, ended` TRUE `, resides` TRUE))
-- s 3(2B): a licence other than an excluded licence.
#ASSERT `court proceedings are required to recover possession from` (`occupancy` `a licence` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` TRUE `, resides` TRUE)
-- s 3A(8): a hostel licence is excluded; the paragraph is for licences only.
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a licence` `, protected` FALSE `, before 1988` FALSE `, exclusions` hostel `, ended` TRUE `, resides` TRUE))
#ASSERT `court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` hostel `, ended` TRUE `, resides` TRUE)
-- s 3A(7)(a): holiday lets.
#ASSERT NOT (`court proceedings are required to recover possession from` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` holiday `, ended` TRUE `, resides` TRUE))
-- s 8(2): exclusive possession under employment counts as a tenancy.
#ASSERT `court proceedings are required to recover possession from` (`occupancy` `exclusive possession under employment` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` TRUE `, resides` TRUE)
-- s 2: forfeiture of a dwelling lease while someone lawfully resides, even
-- of a protected tenancy that has not ended.
forfeitable MEANS `Occupancy` OF `a tenancy`, TRUE, TRUE, FALSE, noExclusions, FALSE, TRUE, TRUE, TRUE
#ASSERT `court proceedings are required to recover possession from` forfeitable
#ASSERT NOT (`court proceedings are required to recover possession from` (`Occupancy` OF `a tenancy`, TRUE, TRUE, FALSE, noExclusions, FALSE, TRUE, TRUE, FALSE))

§§ `Goal 2 — notices to quit`

-- Fields: version, by, periodic licence, writing, given, effect, assured,
-- agreed days, all tenants, Welsh.
GIVEN v IS A `Section 5 version`, who IS A `Who gives notice`, given IS A DATE, effect IS A DATE,
      assured IS A BOOLEAN, agreed IS A MAYBE NUMBER, all IS A BOOLEAN
GIVETH A `Notice to quit`
`notice` v `by` who `, given` given `, effect` effect `, assured` assured `, agreed` agreed `, all` all MEANS
    `Notice to quit` OF v, who, TRUE, TRUE, given, effect, assured, agreed, all, FALSE

old MEANS `before the Renters' Rights Act 2025`
new MEANS `as amended by the Renters' Rights Act 2025`
landlord MEANS `the landlord or licensor`
tenant MEANS `the tenant or licensee`

-- Four weeks: given 1 March 2026, effect 29 March at the earliest.
GIVEN effect IS A DATE
GIVETH A `Notice to quit`
`a landlord's notice given 1 March 2026, effect` effect MEANS
    `notice` old `by` landlord `, given` (Date 1 3 2026) `, effect` effect `, assured` FALSE `, agreed` NOTHING `, all` TRUE

#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`a landlord's notice given 1 March 2026, effect` (Date 29 3 2026)) EQUALS Date 29 3 2026
#ASSERT `the notice meets s 5 for` ordinary `and` (`a landlord's notice given 1 March 2026, effect` (Date 29 3 2026))
#ASSERT NOT (`the notice meets s 5 for` ordinary `and` (`a landlord's notice given 1 March 2026, effect` (Date 28 3 2026)))
-- s 5(1)(a): not in writing.
#ASSERT NOT (`the notice meets s 5 for` ordinary `and` (`Notice to quit` OF old, landlord, TRUE, FALSE, Date 1 3 2026, Date 1 5 2026, FALSE, NOTHING, TRUE, FALSE))

-- s 5(1ZA)(a)(ii): a tenant's notice under an assured tenancy, two months.
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 15 1 2027) `, effect` (Date 15 3 2027) `, assured` TRUE `, agreed` NOTHING `, all` TRUE) EQUALS Date 15 3 2027
-- From 31 December there is no 31 February: 28 February 2027.
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 31 12 2026) `, effect` (Date 1 3 2027) `, assured` TRUE `, agreed` NOTHING `, all` TRUE) EQUALS Date 28 2 2027
#ASSERT NOT (`the notice meets s 5 for` ordinary `and` (`notice` new `by` tenant `, given` (Date 15 1 2027) `, effect` (Date 14 3 2027) `, assured` TRUE `, agreed` NOTHING `, all` TRUE))
-- (1ZA)(a)(i): 30 days agreed in writing; 70 days exceeds two months; an
-- agreement not made with all the joint tenants (1ZB).
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` (JUST 30) `, all` TRUE) EQUALS Date 1 7 2026
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` (JUST 70) `, all` TRUE) EQUALS Date 1 8 2026
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` (JUST 30) `, all` FALSE) EQUALS Date 1 8 2026
-- (1ZA)(b): otherwise four weeks — a landlord's notice, or a tenant's under a
-- tenancy that is not assured; and the original text, for any tenant.
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` landlord `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` NOTHING `, all` TRUE) EQUALS Date 29 6 2026
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` new `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` FALSE `, agreed` NOTHING `, all` TRUE) EQUALS Date 29 6 2026
#ASSERT `the earliest day the notice can take effect for` ordinary `and` (`notice` old `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` NOTHING `, all` TRUE) EQUALS Date 29 6 2026
-- A licence: four weeks, even as amended.
periodicLicence MEANS `occupancy` `a licence` `, protected` FALSE `, before 1988` FALSE `, exclusions` noExclusions `, ended` FALSE `, resides` TRUE
#ASSERT `the earliest day the notice can take effect for` periodicLicence `and` (`notice` new `by` tenant `, given` (Date 1 6 2026) `, effect` (Date 1 7 2026) `, assured` TRUE `, agreed` NOTHING `, all` TRUE) EQUALS Date 29 6 2026
-- s 5(1A): a licence that is not periodic; s 5(1B): an excluded tenancy;
-- s 5(1C): a Welsh occupation contract — s 5 does not apply.
#ASSERT NOT (`s 5 applies to` periodicLicence `and` (`Notice to quit` OF old, landlord, FALSE, TRUE, Date 1 6 2026, Date 2 6 2026, FALSE, NOTHING, TRUE, FALSE))
#ASSERT `the notice meets s 5 for` periodicLicence `and` (`Notice to quit` OF old, landlord, FALSE, TRUE, Date 1 6 2026, Date 2 6 2026, FALSE, NOTHING, TRUE, FALSE)
#ASSERT NOT (`s 5 applies to` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` FALSE `, exclusions` holiday `, ended` FALSE `, resides` TRUE) `and` (`a landlord's notice given 1 March 2026, effect` (Date 2 3 2026)))
#ASSERT `s 5 applies to` (`occupancy` `a tenancy` `, protected` FALSE `, before 1988` TRUE `, exclusions` holiday `, ended` FALSE `, resides` TRUE) `and` (`a landlord's notice given 1 March 2026, effect` (Date 2 3 2026))
#ASSERT NOT (`s 5 applies to` ordinary `and` (`Notice to quit` OF old, landlord, TRUE, TRUE, Date 1 6 2026, Date 2 6 2026, FALSE, NOTHING, TRUE, TRUE))

§§ `Goal 3 — the offence and the financial penalty`

-- Fields: occupier, deprived, belief defence, acts, services, intent,
-- landlord, knowledge, reasonable grounds.
eviction MEANS `Conduct` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
#ASSERT `an offence under s 1 is made out by` eviction
#ASSERT NOT (`an offence under s 1 is made out by` (`Conduct` OF TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE))
#ASSERT NOT (`an offence under s 1 is made out by` (`Conduct` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE))
-- s 1(3): acts with intent, by anyone.
#ASSERT `an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE)
#ASSERT `an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT (`an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE))
-- s 1(3A): the landlord, with knowledge; (3B) reasonable grounds.
#ASSERT `an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE)
#ASSERT NOT (`an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE))
-- (3B) is no answer to s 1(3) where intent is proved.
#ASSERT `an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE)
-- Knowledge without being the landlord or an agent.
#ASSERT NOT (`an offence under s 1 is made out by` (`Conduct` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE))

-- Fields: England, satisfied, convicted, pending, acquitted, first
-- evidence, continuing, last conduct, notice of intent, final notice.
GIVEN england IS A BOOLEAN, convicted IS A BOOLEAN, pending IS A BOOLEAN, acquitted IS A BOOLEAN
GIVETH A `Penalty facts`
`penalty, England` england `, convicted` convicted `, pending` pending `, acquitted` acquitted MEANS
    `Penalty facts` OF england, TRUE, convicted, pending, acquitted, Date 15 3 2026, FALSE, NOTHING, NOTHING, NOTHING

#ASSERT `a financial penalty may be imposed for` eviction `with` (`penalty, England` TRUE `, convicted` FALSE `, pending` FALSE `, acquitted` FALSE)
#ASSERT NOT (`a financial penalty may be imposed for` eviction `with` (`penalty, England` FALSE `, convicted` FALSE `, pending` FALSE `, acquitted` FALSE))
#ASSERT NOT (`a financial penalty may be imposed for` eviction `with` (`penalty, England` TRUE `, convicted` TRUE `, pending` FALSE `, acquitted` FALSE))
#ASSERT NOT (`a financial penalty may be imposed for` eviction `with` (`penalty, England` TRUE `, convicted` FALSE `, pending` TRUE `, acquitted` FALSE))
#ASSERT NOT (`a financial penalty may be imposed for` eviction `with` (`penalty, England` TRUE `, convicted` FALSE `, pending` FALSE `, acquitted` TRUE))
#ASSERT NOT (`a financial penalty may be imposed for` eviction `with` (`Penalty facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, Date 15 3 2026, FALSE, NOTHING, NOTHING, NOTHING))
#ASSERT `the maximum financial penalty` EQUALS 40000

-- Sch A1 para 1: six months beginning with 15 March 2026 end 14 September;
-- beginning with 31 August 2026, 28 February 2027.
#ASSERT `the last day for the notice of intent for` (`penalty, England` TRUE `, convicted` FALSE `, pending` FALSE `, acquitted` FALSE) EQUALS JUST (Date 14 9 2026)
#ASSERT `the last day for the notice of intent for` (`Penalty facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, Date 31 8 2026, FALSE, NOTHING, NOTHING, NOTHING) EQUALS JUST (Date 28 2 2027)
-- Continuing conduct, last on 10 October 2026: 9 April 2027; still
-- continuing: no last day.
#ASSERT `the last day for the notice of intent for` (`Penalty facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, Date 15 3 2026, TRUE, JUST (Date 10 10 2026), NOTHING, NOTHING) EQUALS JUST (Date 9 4 2027)
#ASSERT `the last day for the notice of intent for` (`Penalty facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, Date 15 3 2026, TRUE, NOTHING, NOTHING, NOTHING) EQUALS NOTHING

-- Notice of intent 1 February 2027: representations to 1 March, final notice
-- from 2 March; final notice 10 March: payment and appeal to 7 April.
dates MEANS `the penalty dates for` (`Penalty facts` OF TRUE, TRUE, FALSE, FALSE, FALSE, Date 15 9 2026, FALSE, NOTHING, JUST (Date 1 2 2027), JUST (Date 10 3 2027))
#ASSERT dates's `last day for the notice of intent` EQUALS JUST (Date 14 3 2027)
#ASSERT dates's `last day for representations` EQUALS JUST (Date 1 3 2027)
#ASSERT dates's `earliest day for the final notice` EQUALS JUST (Date 2 3 2027)
#ASSERT dates's `last day for payment` EQUALS JUST (Date 7 4 2027)
#ASSERT dates's `last day to appeal` EQUALS JUST (Date 7 4 2027)

§§ `The top-level goal`

theNotice MEANS JUST (`a landlord's notice given 1 March 2026, effect` (Date 29 3 2026))
thePenalty MEANS JUST (`penalty, England` TRUE `, convicted` FALSE `, pending` FALSE `, acquitted` FALSE)
theCase MEANS `Eviction case` OF ordinary, theNotice, JUST eviction, thePenalty
pos MEANS `the eviction position for` theCase
#ASSERT pos's `court proceedings required`
#ASSERT NOT (pos's `excluded tenancy or licence`)
#ASSERT pos's `notice to quit meets s 5` EQUALS JUST TRUE
#ASSERT pos's `earliest day the notice can take effect` EQUALS JUST (Date 29 3 2026)
#ASSERT pos's `offence under s 1` EQUALS JUST TRUE
#ASSERT pos's `financial penalty may be imposed` EQUALS JUST TRUE
#ASSERT pos's `maximum financial penalty` EQUALS 40000

bare MEANS `the eviction position for` (`Eviction case` OF ordinary, NOTHING, NOTHING, NOTHING)
#ASSERT bare's `notice to quit meets s 5` EQUALS NOTHING
#ASSERT bare's `financial penalty may be imposed` EQUALS NOTHING
