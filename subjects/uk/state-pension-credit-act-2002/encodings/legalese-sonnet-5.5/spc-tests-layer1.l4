#ASSERT `Sch 2 para 17 -- the amount of state pension credit payable on` (YearMonthDay 2024 4 1) `under section 159B given the commencing date` (YearMonthDay 2024 4 1) `with an award in force` TRUE `and an alteration in a component` TRUE `or in benefit income` FALSE `or in a jobseeker's allowance component` FALSE `or in a war pension` FALSE `that affects the computation` TRUE `outside any prescribed exception` TRUE `from the amount before` 50 `to the amount after` 60 EQUALS NOTHING

-- Paragraph 26 (Transport Act 1982 s 70(2)(bb)) and paragraph 30 (Children Act 1989 s 29(3B)):
-- in receipt of guarantee state pension credit, or a couple (section 17(1)) whose other member is.
#ASSERT `Sch 2 para 26 -- the Secretary of State makes the payment under section 70(2) of the Transport Act 1982 for` `a single person` TRUE FALSE
#ASSERT NOT (`Sch 2 para 26 -- the Secretary of State makes the payment under section 70(2) of the Transport Act 1982 for` `a single person` FALSE TRUE)
#ASSERT `Sch 2 para 26 -- the Secretary of State makes the payment under section 70(2) of the Transport Act 1982 for` `a married couple in one household` FALSE TRUE
#ASSERT NOT (`Sch 2 para 26 -- the Secretary of State makes the payment under section 70(2) of the Transport Act 1982 for` `a married couple in one household` FALSE FALSE)
#ASSERT `Sch 2 para 30 -- the person is not liable to pay a charge under section 29(1) of the Children Act 1989 for a service under section 18(2) or (6) when` `a single person` TRUE FALSE
#ASSERT NOT (`Sch 2 para 30 -- the person is not liable to pay a charge under section 29(1) of the Children Act 1989 for a service under section 18(2) or (6) when` `a single person` FALSE TRUE)
#ASSERT `Sch 2 para 30 -- the person is not liable to pay a charge under section 29(1) of the Children Act 1989 for a service under section 18(2) or (6) when` `an unmarried couple living together` FALSE TRUE
#ASSERT NOT (`Sch 2 para 30 -- the person is not liable to pay a charge under section 29(1) of the Children Act 1989 for a service under section 18(2) or (6) when` `an unmarried couple living together in prescribed circumstances` FALSE TRUE)
