IMPORT prelude
IMPORT daydate

-- Third Parties (Rights against Insurers) Act 2010 (UK) — THE NOUNS.
-- Source: ../registers/source-bundle/ukpga-2010-10.txt (point in time
-- 4 January 2024). No rules here.

§ `Nouns`

-- ss 4-7: the event that makes the insured a relevant person.
DECLARE `Relevant person event` IS ONE OF
    -- ss 4(1)(b), (c), (e), (f), 4(2), 4(3)(a)-(b), (c), (d), 6(2)-(4B), 7(1):
    -- an order, arrangement, administration, receivership, winding up,
    -- sequestration or trust deed in force.
    `an insolvency event`
    -- s 4(1)(d), (3)(ba): a debt relief order — s 1(1)(b) only (s 4(4)).
    `a debt relief order`
    -- s 5: an individual who dies insolvent — s 1(1)(b) only.
    `died insolvent`
    -- s 6(1): a compromise or arrangement sanctioned under s 899 or 901F of
    -- the Companies Act 2006.
    `a sanctioned compromise or arrangement` HAS
        `the liability was transferred to another body by the sanctioning order` IS A BOOLEAN
        `the arrangement binds the third party`         IS A BOOLEAN
    -- s 6A: a dissolved body.
    `dissolved` HAS
        `treated as no longer dissolved since`          IS A BOOLEAN
        `a partnership that is not a body corporate`    IS A BOOLEAN
    `none`

DECLARE `Transfer facts` HAS
    `the event`                                         IS A `Relevant person event`
    `became a relevant person on`                       IS A DATE
    `the liability was incurred on`                     IS A DATE
    -- s 1(1): the insured is insured against the liability.
    `insured against the liability`                     IS A BOOLEAN
    -- s 15: the liability is itself one incurred by an insurer under a
    -- contract of insurance (reinsurance).
    `the liability is an insurer's liability under a contract of insurance` IS A BOOLEAN
    -- Sch 3 para 3: the 1930 Act still applies.
    `the 1930 Act still applies`                        IS A BOOLEAN

DECLARE `Money facts` HAS
    -- s 1(4): existence and amount established by declaration, judgment,
    -- award or enforceable agreement.
    `the liability is established`                      IS A BOOLEAN
    `the insured's liability to the third party`        IS A NUMBER
    -- s 8: the insurer's liability to the insured, ignoring s 1.
    `the insurer's liability to the insured`            IS A NUMBER
    -- s 10
    `the insurer's set-off`                             IS A NUMBER
    -- s 14(6)-(7)
    `shortfall from the insurer's own insolvency`       IS A NUMBER
    `eligible for the FSCS`                             IS A BOOLEAN
    `an FSCS claim was made`                            IS A BOOLEAN
    `paid or due from the FSCS`                         IS A NUMBER
    `shortfall from a fund limit in the contract`       IS A NUMBER

-- s 9: the condition and the insured.
DECLARE `Condition kind` IS ONE OF
    `to provide information or assistance`
    `to notify the insurer of a claim`
    `prior discharge of the liability by the insured`
    `another condition`

DECLARE `Insured kind` IS ONE OF
    `a living individual`
    `a deceased individual`
    `a body corporate, dissolved`
    `an unincorporated body other than a partnership, dissolved`
    `another insured`

DECLARE `Condition facts` HAS
    `kind of condition`                                 IS A `Condition kind`
    `the insured`                                       IS AN `Insured kind`
    `marine insurance`                                  IS A BOOLEAN
    `liability for death or personal injury`            IS A BOOLEAN
