IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa17-helpers`
IMPORT `coa17-part21-ch1`

-- coa17-tests-part21-ch1.l4: tests for ss 768-782 (coa17-part21-ch1.l4).
-- Every expected value is written by hand from the text of the section named beside it, never copied from the output.
-- Fixture names begin with the section label, as every top-level name of this encoding does.

§ `Tests: Part 21 Chapter 1`

-- ---- s 768 ------------------------------------------------------------------------------------------------------
-- (1) England and Wales or Northern Ireland: a certificate under the common seal specifying shares held by a member
-- is prima facie evidence of title.
#ASSERT `s 768(1) the certificate is prima facie evidence of the member's title to the shares` `England and Wales` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 768(1) the certificate is prima facie evidence of the member's title to the shares` `Northern Ireland` TRUE TRUE EQUALS JUST TRUE
-- not under the common seal, or not specifying shares: the grant does not reach it (limited by its own wording)
#ASSERT `s 768(1) the certificate is prima facie evidence of the member's title to the shares` `England and Wales` FALSE TRUE EQUALS NOTHING
#ASSERT `s 768(1) the certificate is prima facie evidence of the member's title to the shares` `England and Wales` TRUE FALSE EQUALS NOTHING
-- a Scottish company is outside subsection (1)
#ASSERT `s 768(1) the certificate is prima facie evidence of the member's title to the shares` Scotland TRUE TRUE EQUALS NOTHING
-- (2) Scotland: under the common seal (a) or subscribed under the 1995 Act (b); sufficient evidence unless the contrary is shown
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` Scotland TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` Scotland FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` Scotland TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` Scotland FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` Scotland TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 768(2) the certificate is sufficient evidence of the member's title to the shares` `England and Wales` TRUE FALSE TRUE FALSE EQUALS NOTHING

-- ---- s 769 ------------------------------------------------------------------------------------------------------
`s 769 test shares allotted on 5 January 2026` MEANS `s 769 allotment` WITH
    `s 769(1) the thing allotted` IS `s 769(1) shares allotted`
    `s 769(1) the day of the allotment` IS Date 5 1 2026
    `s 769(2)(a) the conditions of issue provide otherwise` IS FALSE
    `s 769(2)(b) the allotment is to a financial institution` IS FALSE
    `s 769(2)(c) the company has issued a share warrant in respect of the shares allotted` IS FALSE

`s 769 test debentures allotted on 31 December 2025` MEANS `s 769 allotment` WITH
    `s 769(1) the thing allotted` IS `s 769(1) debentures allotted`
    `s 769(1) the day of the allotment` IS Date 31 12 2025
    `s 769(2)(a) the conditions of issue provide otherwise` IS FALSE
    `s 769(2)(b) the allotment is to a financial institution` IS FALSE
    `s 769(2)(c) the company has issued a share warrant in respect of the shares allotted` IS TRUE

`s 769 test debenture stock allotted to a financial institution` MEANS `s 769 allotment` WITH
    `s 769(1) the thing allotted` IS `s 769(1) debenture stock allotted`
    `s 769(1) the day of the allotment` IS Date 1 3 2026
    `s 769(2)(a) the conditions of issue provide otherwise` IS FALSE
    `s 769(2)(b) the allotment is to a financial institution` IS TRUE
    `s 769(2)(c) the company has issued a share warrant in respect of the shares allotted` IS FALSE

`s 769 test shares allotted and a share warrant then issued` MEANS `s 769 allotment` WITH
    `s 769(1) the thing allotted` IS `s 769(1) shares allotted`
    `s 769(1) the day of the allotment` IS Date 5 1 2026
    `s 769(2)(a) the conditions of issue provide otherwise` IS FALSE
    `s 769(2)(b) the allotment is to a financial institution` IS FALSE
    `s 769(2)(c) the company has issued a share warrant in respect of the shares allotted` IS TRUE

`s 769 test shares allotted on terms that provide otherwise` MEANS `s 769 allotment` WITH
    `s 769(1) the thing allotted` IS `s 769(1) shares allotted`
    `s 769(1) the day of the allotment` IS Date 5 1 2026
    `s 769(2)(a) the conditions of issue provide otherwise` IS TRUE
    `s 769(2)(b) the allotment is to a financial institution` IS FALSE
    `s 769(2)(c) the company has issued a share warrant in respect of the shares allotted` IS FALSE

-- (1)(a), (b), (c): what the company must have ready
#ASSERT `s 769(1) the documents the company must complete and have ready for delivery` `s 769 test shares allotted on 5 January 2026` EQUALS `s 769(1)(a) the certificates of the shares allotted`
#ASSERT `s 769(1) the documents the company must complete and have ready for delivery` `s 769 test debentures allotted on 31 December 2025` EQUALS `s 769(1)(b) the debentures allotted`
#ASSERT `s 769(1) the documents the company must complete and have ready for delivery` `s 769 test debenture stock allotted to a financial institution` EQUALS `s 769(1)(c) the certificates of the debenture stock allotted`
-- "within two months after the allotment": 5 January gives 5 March; 31 December gives the last day of February (the day of the month is clamped)
#ASSERT `s 769(1) the last day for completing the documents and having them ready for delivery` `s 769 test shares allotted on 5 January 2026` EQUALS Date 5 3 2026
#ASSERT `s 769(1) the last day for completing the documents and having them ready for delivery` `s 769 test debentures allotted on 31 December 2025` EQUALS Date 28 2 2026
-- (2) Subsection (1) does not apply: (a) conditions of issue; (b) financial institution; (c) shares, and a share warrant issued
#ASSERT `s 769(2) subsection (1) does not apply` `s 769 test shares allotted on terms that provide otherwise` EQUALS JUST TRUE
#ASSERT `s 769(2) subsection (1) does not apply` `s 769 test debenture stock allotted to a financial institution` EQUALS JUST TRUE
#ASSERT `s 769(2) subsection (1) does not apply` `s 769 test shares allotted and a share warrant then issued` EQUALS JUST TRUE
-- (c) speaks only of "an allotment of shares": a warrant flag on an allotment of debentures changes nothing; the list is not closed
#ASSERT `s 769(2) subsection (1) does not apply` `s 769 test debentures allotted on 31 December 2025` EQUALS NOTHING
#ASSERT `s 769(2) subsection (1) does not apply` `s 769 test shares allotted on 5 January 2026` EQUALS NOTHING
-- (1): the duty
#ASSERT `s 769(1) the company must complete and have ready for delivery the documents` `s 769 test shares allotted on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 769(1) the company must complete and have ready for delivery the documents` `s 769 test debentures allotted on 31 December 2025` EQUALS JUST TRUE
#ASSERT `s 769(1) the company must complete and have ready for delivery the documents` `s 769 test shares allotted on terms that provide otherwise` EQUALS JUST FALSE
#ASSERT `s 769(1) the company must complete and have ready for delivery the documents` `s 769 test debenture stock allotted to a financial institution` EQUALS JUST FALSE
#ASSERT `s 769(1) the company must complete and have ready for delivery the documents` `s 769 test shares allotted and a share warrant then issued` EQUALS JUST FALSE
-- (3) default: ready on the last day is in time; the day after is default; not ready, the default begins the day after the last day
#ASSERT `s 769(3) default is made in complying with subsection (1)` `s 769 test shares allotted on 5 January 2026` (JUST (Date 5 3 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 769(3) default is made in complying with subsection (1)` `s 769 test shares allotted on 5 January 2026` (JUST (Date 6 3 2026)) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 769(3) default is made in complying with subsection (1)` `s 769 test shares allotted on 5 January 2026` NOTHING (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 769(3) default is made in complying with subsection (1)` `s 769 test shares allotted on 5 January 2026` NOTHING (Date 6 3 2026) EQUALS JUST TRUE
#ASSERT `s 769(3) default is made in complying with subsection (1)` `s 769 test shares allotted on terms that provide otherwise` NOTHING (Date 6 3 2026) EQUALS JUST FALSE
-- (3) the offence: committed by every officer in default, where default is made; both answers needed
#ASSERT `s 769(3) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 769(3) an offence is committed by the officer of the company who is in default` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 769(3) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 769(3) an offence is committed by the officer of the company who is in default` (JUST TRUE) NOTHING EQUALS NOTHING
-- (4) the penalty: summary conviction, level 3, daily default fine one-tenth of level 3
#ASSERT `s 769(4) the penalty`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 769(4) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` OF 3, 1)
#ASSERT `s 769(4) the penalty`'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1)
#ASSERT `s 769(4) the penalty`'s `imprisonment not exceeding` EQUALS NOTHING
#ASSERT `s 769(4) the penalty`'s `imprisonment and fine together` EQUALS FALSE

-- ---- s 770 ------------------------------------------------------------------------------------------------------
-- (1) may not register unless (a) a proper instrument has been delivered, or (b)(i) exempt transfer, (ii) regulations under Chapter 2
#ASSERT `s 770(1) the bar on registering the transfer applies` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 770(1) the bar on registering the transfer applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 770(1) the bar on registering the transfer applies` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 770(1) the bar on registering the transfer applies` FALSE FALSE TRUE EQUALS JUST FALSE
-- (2) transmission by operation of law
#ASSERT `s 770(2) subsection (1) does not affect the company's power to register the person` TRUE EQUALS JUST TRUE
#ASSERT `s 770(2) subsection (1) does not affect the company's power to register the person` FALSE EQUALS NOTHING

-- ---- s 771 ------------------------------------------------------------------------------------------------------
`s 771 test transfer of shares lodged on 5 January 2026` MEANS `s 771 lodged transfer` WITH
    `s 771(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 771(5)(a) the transfer is of shares and the company has issued a share warrant in respect of the shares` IS FALSE
    `s 771(5)(b) the transfer is a transmission of shares or debentures by operation of law` IS FALSE

`s 771 test transfer of shares lodged on 5 January 2026 with a share warrant issued` MEANS `s 771 lodged transfer` WITH
    `s 771(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 771(5)(a) the transfer is of shares and the company has issued a share warrant in respect of the shares` IS TRUE
    `s 771(5)(b) the transfer is a transmission of shares or debentures by operation of law` IS FALSE

`s 771 test transmission by operation of law lodged on 5 January 2026` MEANS `s 771 lodged transfer` WITH
    `s 771(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 771(5)(a) the transfer is of shares and the company has issued a share warrant in respect of the shares` IS FALSE
    `s 771(5)(b) the transfer is a transmission of shares or debentures by operation of law` IS TRUE

#ASSERT `s 771(5) this section does not apply` `s 771 test transfer of shares lodged on 5 January 2026 with a share warrant issued` EQUALS JUST TRUE
#ASSERT `s 771(5) this section does not apply` `s 771 test transmission by operation of law lodged on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 771(5) this section does not apply` `s 771 test transfer of shares lodged on 5 January 2026` EQUALS NOTHING
#ASSERT `s 771(1) the company must register the transfer or give the transferee notice of refusal` `s 771 test transfer of shares lodged on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 771(1) the company must register the transfer or give the transferee notice of refusal` `s 771 test transmission by operation of law lodged on 5 January 2026` EQUALS JUST FALSE
#ASSERT `s 771(1) the last day for registering the transfer or giving notice of refusal` `s 771 test transfer of shares lodged on 5 January 2026` EQUALS Date 5 3 2026
-- (1) registered in time and as soon as practicable: complied; on the last day is in time; the day after is not
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1)(a) registered the transfer` (Date 20 1 2026) TRUE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1)(b) gave the transferee notice of refusal with its reasons` (Date 5 3 2026) TRUE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1)(a) registered the transfer` (Date 6 3 2026) TRUE (Date 1 6 2026) EQUALS JUST FALSE
-- in time, but not as soon as practicable
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1)(a) registered the transfer` (Date 1 3 2026) FALSE (Date 1 6 2026) EQUALS JUST FALSE
-- did neither: after the last day, a breach; before it, not yet decided
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1) did neither` (Date 1 1 2000) FALSE (Date 6 3 2026) EQUALS JUST FALSE
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transfer of shares lodged on 5 January 2026` `s 771(1) did neither` (Date 1 1 2000) FALSE (Date 5 3 2026) EQUALS NOTHING
-- the section does not apply: no duty to have complied with
#ASSERT `s 771(1) the company has complied with subsection (1)` `s 771 test transmission by operation of law lodged on 5 January 2026` `s 771(1) did neither` (Date 1 1 2000) FALSE (Date 6 3 2026) EQUALS NOTHING
-- (1A) unless satisfied that it has the information required for the register of members
#ASSERT `s 771(1A) the bar on registering the transfer under subsection (1)(a) applies` TRUE EQUALS JUST FALSE
#ASSERT `s 771(1A) the bar on registering the transfer under subsection (1)(a) applies` FALSE EQUALS JUST TRUE
-- (2) further information about the reasons: only on refusal; not minutes of directors' meetings; as the transferee may reasonably request
#ASSERT `s 771(2) the company must provide the transferee with the further information requested` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 771(2) the company must provide the transferee with the further information requested` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 771(2) the company must provide the transferee with the further information requested` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 771(2) the company must provide the transferee with the further information requested` TRUE FALSE FALSE EQUALS NOTHING
-- (3) the offences
#ASSERT `s 771(3)(a) an offence is committed by the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 771(3)(a) an offence is committed by the company` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 771(3)(a) an offence is committed by the company` NOTHING EQUALS NOTHING
#ASSERT `s 771(3)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 771(3)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 771(3)(b) an offence is committed by the officer of the company who is in default` NOTHING (JUST TRUE) EQUALS NOTHING
-- (4) the penalty
#ASSERT `s 771(4) the penalty` EQUALS `s 769(4) the penalty`

-- ---- ss 772 to 775 ----------------------------------------------------------------------------------------------
#ASSERT `s 772 the company must enter the name of the transferee in its register of members` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 772 the company must enter the name of the transferee in its register of members` TRUE FALSE EQUALS NOTHING
#ASSERT `s 772 the company must enter the name of the transferee in its register of members` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 773(a) the personal representative may make the instrument of transfer although not a member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 773(a) the personal representative may make the instrument of transfer although not a member` TRUE FALSE EQUALS NOTHING
#ASSERT `s 773(a) the personal representative may make the instrument of transfer although not a member` FALSE TRUE EQUALS NOTHING
#ASSERT `s 773(b) the instrument is as effective as if the personal representative had been a member at the time of execution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 773(b) the instrument is as effective as if the personal representative had been a member at the time of execution` FALSE FALSE EQUALS NOTHING
-- s 774: (a) probate, (b) letters of administration, (c) confirmation as executor
#ASSERT `s 774 the company must accept the document as sufficient evidence of the grant` `s 774(a) probate of the will of a deceased person` TRUE EQUALS JUST TRUE
#ASSERT `s 774 the company must accept the document as sufficient evidence of the grant` `s 774(b) letters of administration of the estate of a deceased person` TRUE EQUALS JUST TRUE
#ASSERT `s 774 the company must accept the document as sufficient evidence of the grant` `s 774(c) confirmation as executor of a deceased person` TRUE EQUALS JUST TRUE
#ASSERT `s 774 the company must accept the document as sufficient evidence of the grant` `s 774(c) confirmation as executor of a deceased person` FALSE EQUALS NOTHING
#ASSERT `s 774 the company must accept the document as sufficient evidence of the grant` `s 774 some other grant` TRUE EQUALS NOTHING
-- s 775(4)(a) certificated
#ASSERT `s 775(4)(a) the instrument of transfer is certificated` TRUE EQUALS JUST TRUE
#ASSERT `s 775(4)(a) the instrument of transfer is certificated` FALSE EQUALS JUST FALSE
-- s 775(4)(c) treated as signed: purports to be authenticated, and it is not shown to be neither his nor an authorised person's
#ASSERT `s 775(4)(c) the certification is treated as signed by the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 775(4)(c) the certification is treated as signed by the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 775(4)(c) the certification is treated as signed by the person` FALSE FALSE EQUALS JUST FALSE
-- s 775(4)(b) made by the company: (i) authorised issuer and (ii) signed by an authorised person or an officer or employee
#ASSERT `s 775(4)(b) the certification of the instrument of transfer is made by the company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 775(4)(b) the certification of the instrument of transfer is made by the company` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 775(4)(b) the certification of the instrument of transfer is made by the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 775(4)(b) the certification of the instrument of transfer is made by the company` FALSE TRUE TRUE EQUALS JUST FALSE
-- s 775(1) (2) (3)
#ASSERT `s 775(1) the certification is taken as a representation that documents showing a prima facie title in the transferor have been produced` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 775(1) the certification is taken as a representation that documents showing a prima facie title in the transferor have been produced` TRUE FALSE EQUALS NOTHING
#ASSERT `s 775(2) the certification is taken as a representation that the transferor has any title to the shares or debentures` TRUE EQUALS JUST FALSE
#ASSERT `s 775(2) the certification is taken as a representation that the transferor has any title to the shares or debentures` FALSE EQUALS NOTHING
#ASSERT `s 775(3) the company is under the same liability to the person as if the certification had been made fraudulently` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 775(3) the company is under the same liability to the person as if the certification had been made fraudulently` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 775(3) the company is under the same liability to the person as if the certification had been made fraudulently` FALSE TRUE EQUALS JUST FALSE

-- ---- ss 776 and 777 ---------------------------------------------------------------------------------------------
`s 776 test shares transferred, lodged on 5 January 2026` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) shares transferred`
    `s 776(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS TRUE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS FALSE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS FALSE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS FALSE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS FALSE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS FALSE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS NOTHING

`s 776 test debentures transferred by an exempt transfer` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) debentures transferred`
    `s 776(1) the day the transfer was lodged` IS Date 31 12 2025
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS FALSE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS TRUE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS FALSE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS FALSE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS FALSE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS FALSE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS NOTHING

`s 776 test debenture stock transferred that the company is entitled to refuse and does not register` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) debenture stock transferred`
    `s 776(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS TRUE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS FALSE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS TRUE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS FALSE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS FALSE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS FALSE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS NOTHING

`s 776 test transfer to a person not entitled to a certificate, lodged on 5 January 2026` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) shares transferred`
    `s 776(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS TRUE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS FALSE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS FALSE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS FALSE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS TRUE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS FALSE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS NOTHING

`s 776 test the same transferee later entitled, who gave notice on 10 April 2026` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) shares transferred`
    `s 776(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS TRUE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS FALSE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS FALSE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS FALSE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS TRUE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS TRUE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS JUST (Date 10 4 2026)

`s 776 test shares transferred to a financial institution` MEANS `s 776 lodged transfer` WITH
    `s 776(1) the thing transferred` IS `s 776(1) shares transferred`
    `s 776(1) the day the transfer was lodged` IS Date 5 1 2026
    `s 776(2)(a) the transfer is duly stamped and otherwise valid` IS TRUE
    `s 776(2)(b) the transfer is an exempt transfer within the Stock Transfer Act 1982` IS FALSE
    `s 776(2) the company is entitled to refuse to register the transfer and does not register it` IS FALSE
    `s 776(3)(a) the conditions of issue provide otherwise` IS FALSE
    `s 776(3)(b) the transfer is to a financial institution` IS TRUE
    `s 776(3)(c) the company has issued a share warrant in respect of the shares transferred` IS FALSE
    `s 777(1) the transferee is not entitled to a certificate by virtue of regulations under section 3 of the Stock Transfer Act 1982` IS FALSE
    `s 777(2)(a) the transferee has since become entitled to a certificate by virtue of a provision of those regulations` IS FALSE
    `s 777(2)(b) the day on which the transferee gave the company notice in writing of that fact` IS NOTHING

#ASSERT `s 776(1) the documents the company must complete and have ready for delivery` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS `s 776(1)(a) the certificates of the shares transferred`
#ASSERT `s 776(1) the documents the company must complete and have ready for delivery` `s 776 test debentures transferred by an exempt transfer` EQUALS `s 776(1)(b) the debentures transferred`
#ASSERT `s 776(1) the documents the company must complete and have ready for delivery` `s 776 test debenture stock transferred that the company is entitled to refuse and does not register` EQUALS `s 776(1)(c) the certificates of the debenture stock transferred`
-- (2) "transfer" means (a) duly stamped and valid or (b) exempt, but not one the company may refuse and does not register
#ASSERT `s 776(2) the instrument is a transfer for the purposes of subsection (1)` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 776(2) the instrument is a transfer for the purposes of subsection (1)` `s 776 test debentures transferred by an exempt transfer` EQUALS JUST TRUE
#ASSERT `s 776(2) the instrument is a transfer for the purposes of subsection (1)` `s 776 test debenture stock transferred that the company is entitled to refuse and does not register` EQUALS JUST FALSE
-- (3) Subsection (1) does not apply
#ASSERT `s 776(3) subsection (1) does not apply` `s 776 test shares transferred to a financial institution` EQUALS JUST TRUE
#ASSERT `s 776(3) subsection (1) does not apply` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS NOTHING
-- s 777(1): a transferee not entitled to a certificate; s 777(2): the notice date stands in for the lodging date
#ASSERT `s 777(1) section 776(1) does not apply to the transfer` `s 776 test transfer to a person not entitled to a certificate, lodged on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 777(1) section 776(1) does not apply to the transfer` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS NOTHING
#ASSERT `s 777(2) the day treated as the day on which the transfer was lodged` `s 776 test the same transferee later entitled, who gave notice on 10 April 2026` EQUALS JUST (Date 10 4 2026)
#ASSERT `s 777(2) the day treated as the day on which the transfer was lodged` `s 776 test transfer to a person not entitled to a certificate, lodged on 5 January 2026` EQUALS NOTHING
#ASSERT `s 776(4) the day from which the period of two months runs` `s 776 test the same transferee later entitled, who gave notice on 10 April 2026` EQUALS Date 10 4 2026
#ASSERT `s 776(4) the day from which the period of two months runs` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS Date 5 1 2026
-- (1) the duty
#ASSERT `s 776(1) the company must complete and have ready for delivery the documents` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS JUST TRUE
#ASSERT `s 776(1) the company must complete and have ready for delivery the documents` `s 776 test debenture stock transferred that the company is entitled to refuse and does not register` EQUALS JUST FALSE
#ASSERT `s 776(1) the company must complete and have ready for delivery the documents` `s 776 test shares transferred to a financial institution` EQUALS JUST FALSE
#ASSERT `s 776(1) the company must complete and have ready for delivery the documents` `s 776 test transfer to a person not entitled to a certificate, lodged on 5 January 2026` EQUALS JUST FALSE
#ASSERT `s 776(1) the company must complete and have ready for delivery the documents` `s 776 test the same transferee later entitled, who gave notice on 10 April 2026` EQUALS JUST TRUE
-- "within two months after the date on which a transfer ... is lodged": 5 January gives 5 March; with the notice on 10 April, 10 June
#ASSERT `s 776(1) the last day for completing the documents and having them ready for delivery` `s 776 test shares transferred, lodged on 5 January 2026` EQUALS Date 5 3 2026
#ASSERT `s 776(1) the last day for completing the documents and having them ready for delivery` `s 776 test debentures transferred by an exempt transfer` EQUALS Date 28 2 2026
#ASSERT `s 776(1) the last day for completing the documents and having them ready for delivery` `s 776 test the same transferee later entitled, who gave notice on 10 April 2026` EQUALS Date 10 6 2026
-- (5) default
#ASSERT `s 776(5) default is made in complying with subsection (1)` `s 776 test shares transferred, lodged on 5 January 2026` (JUST (Date 5 3 2026)) (Date 1 9 2026) EQUALS JUST FALSE
#ASSERT `s 776(5) default is made in complying with subsection (1)` `s 776 test shares transferred, lodged on 5 January 2026` (JUST (Date 6 3 2026)) (Date 1 9 2026) EQUALS JUST TRUE
#ASSERT `s 776(5) default is made in complying with subsection (1)` `s 776 test shares transferred, lodged on 5 January 2026` NOTHING (Date 6 3 2026) EQUALS JUST TRUE
#ASSERT `s 776(5) default is made in complying with subsection (1)` `s 776 test shares transferred, lodged on 5 January 2026` NOTHING (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 776(5) default is made in complying with subsection (1)` `s 776 test shares transferred to a financial institution` NOTHING (Date 6 3 2026) EQUALS JUST FALSE
