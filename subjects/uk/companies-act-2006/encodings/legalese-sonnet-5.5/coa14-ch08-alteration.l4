    `the answer on the dates`
    WHERE
        `the answer on the dates` MEANS
            CONSIDER `the date the company gave notice to the registrar, if it has`
            WHEN JUST given THEN
                BRANCH
                    IF given LESS THAN `the date the company exercised a power conferred by section 620`
                    THEN NOTHING -- NOTHING-kind (limited by its own wording): the period runs "after" the event and a notice given before it is not within the period
                    IF given AT MOST `s 621(1) the last day for the notice` `the date the company exercised a power conferred by section 620`
                    THEN JUST TRUE
                    OTHERWISE JUST FALSE -- FALSE-kind (the text says no in its own words): "it must within one month after doing so give notice to the registrar"
            WHEN NOTHING THEN
                IF `the date being asked about` GREATER THAN `s 621(1) the last day for the notice` `the date the company exercised a power conferred by section 620`
                THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "it must within one month after doing so give notice to the registrar" (the period of 1 month has ended and nothing was given)
                ELSE NOTHING -- NOTHING-kind (limited by its own wording): the period of 1 month has not ended, so the text does not yet say whether the duty is met

