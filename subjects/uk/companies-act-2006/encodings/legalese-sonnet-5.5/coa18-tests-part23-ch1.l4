IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa18-part23-ch1`

-- coa18-tests-part23-ch1.l4: tests for coa18-part23-ch1.l4 (Companies Act 2006, Part 23 Chapter 1, ss 829 to 835).
-- Every expected value is written from the text, beside its assertion, before the run; a failing assertion is a finding.
-- Generated by work/gentests.py from work/tests/part23-ch1.py (the layout only; the values are hand-written).

§§ `s 829 meaning of "distribution"`

-- 829(2)(a): a bonus issue is not a distribution
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(a) an issue of shares as fully or partly paid bonus shares` NOTHING EQUALS JUST TRUE
-- 829(2)(b)(i): reduction by extinguishing or reducing liability on unpaid share capital
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(b)(i) a reduction of share capital by extinguishing or reducing the liability of any of the members on any of the company's shares in respect of share capital not paid up` NOTHING EQUALS JUST TRUE
-- 829(2)(b)(ii): reduction by repaying paid-up share capital
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(b)(ii) a reduction of share capital by repaying paid-up share capital` NOTHING EQUALS JUST TRUE
-- 829(2)(c): redemption or purchase in accordance with Part 18 Chapter 3, 4 or 5
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(c) the redemption or purchase of any of the company's own shares out of capital (including the proceeds of any fresh issue of shares) or out of unrealised profits` ((JUST TRUE)) EQUALS JUST TRUE
-- 829(2)(c): not in accordance with Part 18: outside the exception; not decided here
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(c) the redemption or purchase of any of the company's own shares out of capital (including the proceeds of any fresh issue of shares) or out of unrealised profits` ((JUST FALSE)) EQUALS NOTHING
-- 829(2)(c): Part 18 answer unknown
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(c) the redemption or purchase of any of the company's own shares out of capital (including the proceeds of any fresh issue of shares) or out of unrealised profits` NOTHING EQUALS NOTHING
-- 829(2)(d): a distribution of assets on winding up
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(2)(d) a distribution of assets to members of the company on its winding up` NOTHING EQUALS JUST TRUE
-- 829(2): an act not in the list: silent
#ASSERT `s 829(2) the act is not a distribution for the purposes of this Part` `s 829(1) another description of distribution of the company's assets to its members, whether in cash or otherwise` NOTHING EQUALS NOTHING
-- 829(1): not a distribution of assets to members: "means"
#ASSERT `s 829(1) the act is a distribution` `s 829(1) something that is not a distribution of the company's assets to its members` NOTHING EQUALS JUST FALSE
-- 829(1): another description of distribution of assets to members
#ASSERT `s 829(1) the act is a distribution` `s 829(1) another description of distribution of the company's assets to its members, whether in cash or otherwise` NOTHING EQUALS JUST TRUE
-- 829(1) with (2)(a): bonus shares
#ASSERT `s 829(1) the act is a distribution` `s 829(2)(a) an issue of shares as fully or partly paid bonus shares` NOTHING EQUALS JUST FALSE
-- 829(1) with (2)(c)
#ASSERT `s 829(1) the act is a distribution` `s 829(2)(c) the redemption or purchase of any of the company's own shares out of capital (including the proceeds of any fresh issue of shares) or out of unrealised profits` ((JUST TRUE)) EQUALS JUST FALSE
-- 829(1): redemption not shown to be in accordance with Part 18: not decided
#ASSERT `s 829(1) the act is a distribution` `s 829(2)(c) the redemption or purchase of any of the company's own shares out of capital (including the proceeds of any fresh issue of shares) or out of unrealised profits` ((JUST FALSE)) EQUALS NOTHING
-- 829(1) with (2)(d)
#ASSERT `s 829(1) the act is a distribution` `s 829(2)(d) a distribution of assets to members of the company on its winding up` NOTHING EQUALS JUST FALSE

§§ `s 830 profits available for distribution`

-- 830(2): (1000 - 200) - (300 - 100)
#ASSERT `s 830(2) the profits available for distribution` 1000 200 300 100 EQUALS 600
-- 830(2): realised losses exceed realised profits: a negative figure, no profits available
#ASSERT `s 830(2) the profits available for distribution` 100 0 400 0 EQUALS (0 MINUS 300)
-- 830(2): all profits already utilised
#ASSERT `s 830(2) the profits available for distribution` 1000 1000 0 0 EQUALS 0
-- 830(1): equal to the profits available
#ASSERT `s 830(1) the distribution is within the profits available for the purpose` 600 600 EQUALS JUST TRUE
-- 830(1): one pound more: "may only make a distribution out of profits available"
#ASSERT `s 830(1) the distribution is within the profits available for the purpose` 601 600 EQUALS JUST FALSE
-- 830(1): no profits available
#ASSERT `s 830(1) the distribution is within the profits available for the purpose` 0 (0 MINUS 300) EQUALS JUST FALSE
-- 830(3)
#ASSERT `s 830(3) subsection (2) has effect subject to sections 832, 833A and 835` TRUE EQUALS JUST TRUE
-- 830(3): another company: not mentioned
#ASSERT `s 830(3) subsection (2) has effect subject to sections 832, 833A and 835` FALSE EQUALS NOTHING

§§ `s 831 net asset restriction`

-- 831(1): net assets 1000, aggregate 800, distribution 200 leaves exactly 800
#ASSERT `s 831(1) the distribution is within the net asset restriction` TRUE 1000 600 200 200 EQUALS JUST TRUE
-- 831(1)(b): distribution 201 would reduce the net assets to 799
#ASSERT `s 831(1) the distribution is within the net asset restriction` TRUE 1000 600 200 201 EQUALS JUST FALSE
-- 831(1)(a): net assets less than the aggregate
#ASSERT `s 831(1) the distribution is within the net asset restriction` TRUE 799 600 200 0 EQUALS JUST FALSE
-- 831(1)(a): net assets exactly the aggregate, nothing distributed
#ASSERT `s 831(1) the distribution is within the net asset restriction` TRUE 800 600 200 0 EQUALS JUST TRUE
-- 831(1): a private company is not mentioned
#ASSERT `s 831(1) the distribution is within the net asset restriction` FALSE 1000 600 200 200 EQUALS NOTHING
-- 831(2): assets less liabilities
#ASSERT `s 831(2) the company's net assets` 1000 400 EQUALS 600
-- 831(3)(a): a provision of a kind specified by regulations under s 396
#ASSERT `s 831(3) the provision is included in liabilities` `s 831(3)(a) Companies Act accounts` ((JUST TRUE)) EQUALS JUST TRUE
-- 831(3)(a): not of a kind so specified: "includes" does not close the list
#ASSERT `s 831(3) the provision is included in liabilities` `s 831(3)(a) Companies Act accounts` ((JUST FALSE)) EQUALS NOTHING
-- 831(3)(a): s 396 unknown
#ASSERT `s 831(3) the provision is included in liabilities` `s 831(3)(a) Companies Act accounts` NOTHING EQUALS NOTHING
-- 831(3)(b): IAS accounts: provisions of any kind
#ASSERT `s 831(3) the provision is included in liabilities` `s 831(3)(b) IAS accounts` NOTHING EQUALS JUST TRUE
-- 831(3): accounts of another kind are not mentioned
#ASSERT `s 831(3) the provision is included in liabilities` `s 831(3) accounts of another kind` NOTHING EQUALS NOTHING
-- 831(4): 100 + 50 + [(500 - (200 - 50)) - (100 - 20) = 270] + 10 + 5; the transfer to the capital redemption reserve is not "capitalisation"
#ASSERT `s 831(4) the company's undistributable reserves` 100 50 500 200 50 100 20 10 5 EQUALS 435
-- 831(4): with no transfer to the CRR the same figures give 100 + 50 + 220 + 10 + 5 (shows the last sentence of (4) matters)
#ASSERT `s 831(4) the company's undistributable reserves` 100 50 500 200 0 100 20 10 5 EQUALS 385
-- 831(4)(c): unrealised profits do not exceed unrealised losses: there is no excess, so only the premium account counts
#ASSERT `s 831(4) the company's undistributable reserves` 10 0 100 0 0 300 0 0 0 EQUALS 10
-- 831(5): a public company must not
#ASSERT `s 831(5) the company may include uncalled share capital as an asset in any accounts relevant for the purposes of this section` TRUE EQUALS JUST FALSE
-- 831(5): a private company is not mentioned
#ASSERT `s 831(5) the company may include uncalled share capital as an asset in any accounts relevant for the purposes of this section` FALSE EQUALS NOTHING
-- 831(6)
#ASSERT `s 831(6) subsection (1) has effect subject to sections 832 and 835` TRUE EQUALS JUST TRUE
-- 831(6): not mentioned
#ASSERT `s 831(6) subsection (1) has effect subject to sections 832 and 835` FALSE EQUALS NOTHING

