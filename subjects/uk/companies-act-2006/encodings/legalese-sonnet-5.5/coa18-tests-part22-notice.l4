-- (2)(a): no knowledge that the shares are restricted: not covered
#ASSERT `s 798(2)(a) the person commits an offence by exercising a right to dispose` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (5): "subject to" a direction under s 794(2), 799 or 800
#ASSERT `s 798(2)(a) the person commits an offence by exercising a right to dispose` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (2)(b): votes as holder or proxy
#ASSERT `s 798(2)(b) the person commits an offence by voting or appointing a proxy` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- (2)(b): appoints a proxy to vote
#ASSERT `s 798(2)(b) the person commits an offence by voting or appointing a proxy` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- (2)(b): neither votes nor appoints: not covered
#ASSERT `s 798(2)(b) the person commits an offence by voting or appointing a proxy` FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (5) subject to a direction
#ASSERT `s 798(2)(b) the person commits an offence by voting or appointing a proxy` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (2)(c): all elements
#ASSERT `s 798(2)(c) the holder commits an offence by failing to notify the restrictions` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (2)(c): he knows the other person is aware of the restrictions: not covered
#ASSERT `s 798(2)(c) the holder commits an offence by failing to notify the restrictions` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
-- (5) subject to a direction
#ASSERT `s 798(2)(c) the holder commits an offence by failing to notify the restrictions` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (2)(d)
#ASSERT `s 798(2)(d) the person commits an offence by entering into a void agreement` TRUE TRUE FALSE EQUALS JUST TRUE
-- (2)(d): the agreement is not void under section 797(2) or (3): not covered
#ASSERT `s 798(2)(d) the person commits an offence by entering into a void agreement` TRUE FALSE FALSE EQUALS NOTHING
-- (5) subject to a direction
#ASSERT `s 798(2)(d) the person commits an offence by entering into a void agreement` TRUE TRUE TRUE EQUALS JUST FALSE
-- (3): shares issued in contravention of the restrictions
#ASSERT `s 798(3)(a) the company commits an offence` TRUE EQUALS JUST TRUE
-- (3): "If shares ... are issued in contravention"
#ASSERT `s 798(3)(a) the company commits an offence` FALSE EQUALS JUST FALSE
-- (3)(b): an officer who is in default (s 1121 says so)
#ASSERT `s 798(3)(b) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
-- (3)(b): an officer not in default
#ASSERT `s 798(3)(b) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
-- (3)(b): s 1121 not known: not covered
#ASSERT `s 798(3)(b) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
-- (3)(b): no shares issued in contravention
#ASSERT `s 798(3)(b) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (4)(a): a fine on indictment
#ASSERT `s 798(4) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (4)(b): a fine not exceeding the statutory maximum
#ASSERT `s 798(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- (4)(b): in England and Wales
#ASSERT `s 798(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- (5): within a direction or an interim order's terms
#ASSERT `s 798(5) the provisions of section 798 are displaced for the act` TRUE EQUALS JUST TRUE
-- (5): neither: not mentioned
#ASSERT `s 798(5) the provisions of section 798 are displaced for the act` FALSE EQUALS NOTHING

