-- 805(7)(b): one inquiry has neither a response nor the time elapsed
#ASSERT `s 805(7) the investigation carried out by the company in pursuance of a requirement under section 803 is concluded` TRUE (LIST (`s 805(7) inquiry` OF TRUE, FALSE), (`s 805(7) inquiry` OF FALSE, FALSE)) EQUALS JUST FALSE
-- 805(7)(a): not all inquiries made
#ASSERT `s 805(7) the investigation carried out by the company in pursuance of a requirement under section 803 is concluded` FALSE (LIST (`s 805(7) inquiry` OF TRUE, FALSE)) EQUALS JUST FALSE
-- 806(1)(a)
#ASSERT `s 806(1)(a) the company commits an offence` TRUE EQUALS JUST TRUE
