-- 800(3)(b): transfer for valuable consideration and approved
#ASSERT `s 800(3) the court is barred from making an order under section 800` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- 800(3)(b): not approved: barred
#ASSERT `s 800(3) the court is barred from making an order under section 800` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- 800(3): neither (a) nor (b): "must not make an order"
#ASSERT `s 800(3) the court is barred from making an order under section 800` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- 800(4)
#ASSERT `s 800(4) the order may continue the restrictions` TRUE TRUE TRUE EQUALS JUST TRUE
-- 800(4): "so far as they relate to a right acquired or offer made before the transfer": otherwise not covered
#ASSERT `s 800(4) the order may continue the restrictions` TRUE TRUE FALSE EQUALS NOTHING
-- 800(5)(a)
#ASSERT `s 800(5)(a) an application may be made for an order directing that the shares shall cease to be subject to those restrictions` TRUE EQUALS JUST TRUE
-- 800(5): "Where any restrictions continue in force under subsection (4)"
#ASSERT `s 800(5)(a) an application may be made for an order directing that the shares shall cease to be subject to those restrictions` FALSE EQUALS JUST FALSE
-- 800(5)(b): "subsection (3) does not apply"
#ASSERT `s 800(5)(b) subsection (3) does not apply in relation to the making of such an order` TRUE EQUALS JUST TRUE
-- 800(5): where none continue, (b) is not engaged
#ASSERT `s 800(5)(b) subsection (3) does not apply in relation to the making of such an order` FALSE EQUALS JUST FALSE
-- 801(1)
#ASSERT `s 801(1) the court may order that the shares subject to restrictions be sold, subject to the court's approval as to the sale` TRUE EQUALS JUST TRUE
-- 801(1): shares not subject to restrictions: not mentioned
#ASSERT `s 801(1) the court may order that the shares subject to restrictions be sold, subject to the court's approval as to the sale` FALSE EQUALS NOTHING
-- 801(2): the company
#ASSERT `s 801(2) the person may apply for an order under subsection (1)` TRUE EQUALS JUST TRUE
-- 801(2): "may only be made by the company"
#ASSERT `s 801(2) the person may apply for an order under subsection (1)` FALSE EQUALS JUST FALSE
-- 801(3)
#ASSERT `s 801(3) the court may make such further order relating to the sale or transfer of the shares as it thinks fit` TRUE EQUALS JUST TRUE
-- 801(3): no order under the section yet
#ASSERT `s 801(3) the court may make such further order relating to the sale or transfer of the shares as it thinks fit` FALSE EQUALS JUST FALSE
-- 801(4)(a)
#ASSERT `s 801(4) the person may apply for an order under subsection (3)` TRUE FALSE FALSE EQUALS JUST TRUE
-- 801(4)(b)
#ASSERT `s 801(4) the person may apply for an order under subsection (3)` FALSE TRUE FALSE EQUALS JUST TRUE
-- 801(4)(c)
#ASSERT `s 801(4) the person may apply for an order under subsection (3)` FALSE FALSE TRUE EQUALS JUST TRUE
-- 801(4): "may be made" does not say "only"
#ASSERT `s 801(4) the person may apply for an order under subsection (3)` FALSE FALSE FALSE EQUALS NOTHING
-- 801(5)
#ASSERT `s 801(5) the court may order that the applicant's costs (in Scotland, expenses) be paid out of the proceeds of sale` TRUE EQUALS JUST TRUE
-- 801(5): no order under (1) or (3) made
#ASSERT `s 801(5) the court may order that the applicant's costs (in Scotland, expenses) be paid out of the proceeds of sale` FALSE EQUALS JUST FALSE
-- 802(1): proceeds less the costs of the sale
#ASSERT `s 802(1) the sum to be paid into court for the benefit of the persons who are beneficially interested in the shares` TRUE 1000 150 EQUALS JUST 850
-- 802(1): not sold under a court order: not covered
#ASSERT `s 802(1) the sum to be paid into court for the benefit of the persons who are beneficially interested in the shares` FALSE 1000 150 EQUALS NOTHING
-- 802(2)
#ASSERT `s 802(2) the person may apply to the court for the whole or part of those proceeds to be paid to him` TRUE EQUALS JUST TRUE
-- 802(2): not beneficially interested: not covered
#ASSERT `s 802(2) the person may apply to the court for the whole or part of those proceeds to be paid to him` FALSE EQUALS NOTHING
-- 802(3)(a): nobody else interested: the whole proceeds with interest
#ASSERT `s 802(3) the amount the court shall order paid to the applicant` 1000 50 FALSE 1 4 EQUALS JUST 1050
-- 802(3)(b): proceeds and interest 1050 times 1/4
#ASSERT `s 802(3) the amount the court shall order paid to the applicant` 1000 50 TRUE 1 4 EQUALS JUST 262.5
-- 802(3)(b): total value nil: the proportion is undefined
#ASSERT `s 802(3) the amount the court shall order paid to the applicant` 1000 50 TRUE 1 0 EQUALS NOTHING
-- 802(4)
#ASSERT `s 802(4) the applicant under section 801 is entitled to payment of his costs out of the proceeds before any person interested in the shares receives any part` TRUE EQUALS JUST TRUE
-- 802(4): no order under 801(5)
#ASSERT `s 802(4) the applicant under section 801 is entitled to payment of his costs out of the proceeds before any person interested in the shares receives any part` FALSE EQUALS JUST FALSE

§§ `s 803 to s 807: members, the report and inspection`

-- 803(1): members
#ASSERT `s 803(1) the persons may require the company to exercise its powers under section 793` TRUE EQUALS JUST TRUE
-- 803(1): not members: not mentioned
#ASSERT `s 803(1) the persons may require the company to exercise its powers under section 793` FALSE EQUALS NOTHING
-- 803(2): exactly 10% of the voting paid-up capital
#ASSERT `s 803(2) the company is required to exercise its powers under section 793` TRUE 100 1000 EQUALS JUST TRUE
-- 803(2): just below 10%
#ASSERT `s 803(2) the company is required to exercise its powers under section 793` TRUE 99.99 1000 EQUALS JUST FALSE
-- 803(2): requests not to the same effect
#ASSERT `s 803(2) the company is required to exercise its powers under section 793` FALSE 500 1000 EQUALS JUST FALSE
-- 803(3): all requirements met, hard copy
#ASSERT `s 803(3) the request meets the requirements of this subsection` `hard copy form` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- 803(3)(a): electronic form is equally allowed
#ASSERT `s 803(3) the request meets the requirements of this subsection` `electronic form` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- 803(3)(b)(i): does not state that the company is requested to act
#ASSERT `s 803(3) the request meets the requirements of this subsection` `hard copy form` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- 803(3)(b)(ii): the manner is not specified
#ASSERT `s 803(3) the request meets the requirements of this subsection` `hard copy form` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- 803(3)(b)(iii): no reasonable grounds
#ASSERT `s 803(3) the request meets the requirements of this subsection` `hard copy form` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- 803(3)(c): not authenticated
#ASSERT `s 803(3) the request meets the requirements of this subsection` `hard copy form` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 804(1): a company required under section 803
#ASSERT `s 804(1) the company must exercise those powers in the manner specified in the requests` TRUE EQUALS JUST TRUE
-- 804(1): "A company that is required under section 803" (read as an "if": marginal reading (a))
#ASSERT `s 804(1) the company must exercise those powers in the manner specified in the requests` FALSE EQUALS JUST FALSE
-- 804(2): default and the officer is in default
#ASSERT `s 804(2) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
-- 804(2): default but the officer is not in default
#ASSERT `s 804(2) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
-- 804(2): s 1121 not known: not covered
#ASSERT `s 804(2) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
-- 804(2): no default
#ASSERT `s 804(2) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
-- 804(3)(a)
#ASSERT `s 804(3) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- 804(3)(b)
#ASSERT `s 804(3) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- 805(1): on the fifteenth working day
#ASSERT `s 805(1) the report was made available for inspection within a reasonable period (not more than 15 days) after the conclusion of the investigation` 15 TRUE EQUALS JUST TRUE
-- 805(1): the sixteenth working day
#ASSERT `s 805(1) the report was made available for inspection within a reasonable period (not more than 15 days) after the conclusion of the investigation` 16 TRUE EQUALS JUST FALSE
-- 805(1): within 15 days but not a reasonable period
#ASSERT `s 805(1) the report was made available for inspection within a reasonable period (not more than 15 days) after the conclusion of the investigation` 3 FALSE EQUALS JUST FALSE
-- 805(2): concluded within three months: no interim report
#ASSERT `s 805(2) the number of interim reports the company must cause to be prepared` (Date 1 1 2026) (Date 20 2 2026) EQUALS 0
-- 805(2): concluded on the last day of the three months: "within three months"
#ASSERT `s 805(2) the number of interim reports the company must cause to be prepared` (Date 1 1 2026) (Date 1 4 2026) EQUALS 0
-- 805(2): one day over three months: one interim report
#ASSERT `s 805(2) the number of interim reports the company must cause to be prepared` (Date 1 1 2026) (Date 2 4 2026) EQUALS 1
-- 805(2): the second period ends on the day of the conclusion, not "before" it
#ASSERT `s 805(2) the number of interim reports the company must cause to be prepared` (Date 1 1 2026) (Date 1 7 2026) EQUALS 1
-- 805(2): the second period ends before the conclusion
#ASSERT `s 805(2) the number of interim reports the company must cause to be prepared` (Date 1 1 2026) (Date 2 7 2026) EQUALS 2
-- 805(3)
#ASSERT `s 805(3) each such report was made available for inspection within a reasonable period (not more than 15 days) after the end of the period to which it relates` 15 TRUE EQUALS JUST TRUE
-- 805(3)
#ASSERT `s 805(3) each such report was made available for inspection within a reasonable period (not more than 15 days) after the end of the period to which it relates` 16 TRUE EQUALS JUST FALSE
-- 805(4): on the sixth anniversary (at least six years)
#ASSERT `s 805(4) the reports must still be retained and kept available for inspection` (Date 1 3 2026) (Date 1 3 2032) EQUALS JUST TRUE
-- 805(4): the day after the six years
#ASSERT `s 805(4) the reports must still be retained and kept available for inspection` (Date 1 3 2026) (Date 2 3 2032) EQUALS JUST FALSE
-- 805(4)(a): the company's registered office
#ASSERT `s 805(4) the place at which the reports are kept is a place at which they must be kept available for inspection` TRUE NOTHING EQUALS JUST TRUE
-- 805(4)(b): a place specified in regulations under s 1136
#ASSERT `s 805(4) the place at which the reports are kept is a place at which they must be kept available for inspection` FALSE (JUST TRUE) EQUALS JUST TRUE
-- 805(4)(b): the seam says no
#ASSERT `s 805(4) the place at which the reports are kept is a place at which they must be kept available for inspection` FALSE (JUST FALSE) EQUALS JUST FALSE
-- 805(4)(b): s 1136 not known: not covered
#ASSERT `s 805(4) the place at which the reports are kept is a place at which they must be kept available for inspection` FALSE NOTHING EQUALS NOTHING
-- 805(5): kept at the registered office at all times: "unless"
#ASSERT `s 805(5) the company must give notice to the registrar of the place and of any change in that place` TRUE EQUALS JUST FALSE
-- 805(5): kept elsewhere: notice must be given
#ASSERT `s 805(5) the company must give notice to the registrar of the place and of any change in that place` FALSE EQUALS JUST TRUE
-- 805(6): on the third day
#ASSERT `s 805(6) the company notified the members who made the requests where the report is available within three days` 3 EQUALS JUST TRUE
-- 805(6): the fourth day
#ASSERT `s 805(6) the company notified the members who made the requests where the report is available within three days` 4 EQUALS JUST FALSE
-- 805(7): all inquiries made; one answered, one timed out
