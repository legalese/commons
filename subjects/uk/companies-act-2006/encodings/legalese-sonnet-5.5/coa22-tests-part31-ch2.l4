IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa22-part31-ch2`

-- coa22-tests-part31-ch2.l4: tests for Part 31, Chapter 2 (ss 1012 to 1023). Every expected value was decided from the
-- text (quoted in coa22-part31-ch2.l4) before the run and is written beside the assertion; none was copied from the
-- output. T = JUST TRUE, F = JUST FALSE, N = NOTHING ("not covered"). Dates: Date day month year.

§ `Part 31 Chapter 2 tests`

§§ `s 1012 Property of dissolved company to be bona vacantia`

-- (1) args: the company is dissolved; the property was vested in or held on trust for the company immediately before; held on trust for another person
#ASSERT `s 1012(1) the property or right is deemed to be bona vacantia` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1012(1) the property or right is deemed to be bona vacantia` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1012(1) the property or right is deemed to be bona vacantia` TRUE FALSE FALSE EQUALS JUST FALSE
-- property the company holds on trust for another person is not included
#ASSERT `s 1012(1) the property or right is deemed to be bona vacantia` TRUE TRUE TRUE EQUALS JUST FALSE
-- (1)(a) args: the (1) answer; the owner in the case
#ASSERT `s 1012(1)(a) the owner to whom the property belongs` (JUST TRUE) `s 1012(1)(a) the Crown` EQUALS JUST `s 1012(1)(a) the Crown`
#ASSERT `s 1012(1)(a) the owner to whom the property belongs` (JUST TRUE) `s 1012(1)(a) the Duchy of Lancaster` EQUALS JUST `s 1012(1)(a) the Duchy of Lancaster`
#ASSERT `s 1012(1)(a) the owner to whom the property belongs` (JUST TRUE) `s 1012(1)(a) the Duke of Cornwall` EQUALS JUST `s 1012(1)(a) the Duke of Cornwall`
#ASSERT `s 1012(1)(a) the owner to whom the property belongs` (JUST FALSE) `s 1012(1)(a) the Crown` EQUALS NOTHING
#ASSERT `s 1012(1)(a) the owner to whom the property belongs` NOTHING `s 1012(1)(a) the Crown` EQUALS NOTHING
#ASSERT `s 1012(1)(b) the property vests and may be dealt with in the same manner as other bona vacantia` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1012(1)(b) the property vests and may be dealt with in the same manner as other bona vacantia` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1012(1)(b) the property vests and may be dealt with in the same manner as other bona vacantia` NOTHING EQUALS NOTHING
#ASSERT `s 1012(2) the effect of subsection (1) is subject to the restoration of the company to the register` TRUE EQUALS JUST TRUE
#ASSERT `s 1012(2) the effect of subsection (1) is subject to the restoration of the company to the register` FALSE EQUALS NOTHING

§§ `s 1013 Crown disclaimer of property vesting as bona vacantia`

-- (1)/(8) the Crown representative; args: owner under section 1012; the property is in Scotland
#ASSERT `s 1013(1) the Crown representative for the property` `s 1012(1)(a) the Crown` FALSE EQUALS `s 1013(1) the Treasury Solicitor`
#ASSERT `s 1013(1) the Crown representative for the property` `s 1012(1)(a) the Crown` TRUE EQUALS `s 1013(1) the Queen's and Lord Treasurer's Remembrancer`
#ASSERT `s 1013(1) the Crown representative for the property` `s 1012(1)(a) the Duchy of Lancaster` FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Lancaster`
#ASSERT `s 1013(1) the Crown representative for the property` `s 1012(1)(a) the Duke of Cornwall` FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Cornwall`
-- (1) args: the property vests in the Crown; the notice is signed by the Crown representative
#ASSERT `s 1013(1) the Crown's title to the property may be disclaimed by the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1013(1) the Crown's title to the property may be disclaimed by the notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1013(1) the Crown's title to the property may be disclaimed by the notice` FALSE TRUE EQUALS NOTHING
-- (2) waived expressly; by taking possession
#ASSERT `s 1013(2) the right to execute a notice of disclaimer has been waived` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1013(2) the right to execute a notice of disclaimer has been waived` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1013(2) the right to execute a notice of disclaimer has been waived` FALSE FALSE EQUALS NOTHING
-- (3) args: date the fact first comes to the notice; ownership established at that date; the end of the period reasonably necessary to establish ownership (if not established)
#ASSERT `s 1013(3) the last day for executing the notice of disclaimer` (Date 10 3 2026) TRUE NOTHING EQUALS JUST (Date 10 3 2029)
#ASSERT `s 1013(3) the last day for executing the notice of disclaimer` (Date 10 3 2026) FALSE (JUST (Date 1 9 2026)) EQUALS JUST (Date 1 9 2029)
#ASSERT `s 1013(3) the last day for executing the notice of disclaimer` (Date 10 3 2026) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 1013(3) the last day for executing the notice of disclaimer` (Date 29 2 2024) TRUE NOTHING EQUALS JUST (Date 28 2 2027)
-- (4) args: date the application in writing was made; the date to which the court allowed a further period (if)
#ASSERT `s 1013(4) the last day for executing the notice of disclaimer after an application` (Date 1 5 2026) NOTHING EQUALS Date 1 5 2027
#ASSERT `s 1013(4) the last day for executing the notice of disclaimer after an application` (Date 1 5 2026) (JUST (Date 1 8 2027)) EQUALS Date 1 8 2027
-- a further period that ends before the twelve months adds nothing
#ASSERT `s 1013(4) the last day for executing the notice of disclaimer after an application` (Date 1 5 2026) (JUST (Date 1 2 2027)) EQUALS Date 1 5 2027
-- (5) args: date executed; the (3) last day; the (4) last day (if an application was made)
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 10 3 2029) (JUST (Date 10 3 2029)) NOTHING EQUALS JUST FALSE
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 11 3 2029) (JUST (Date 10 3 2029)) NOTHING EQUALS JUST TRUE
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 11 3 2029) NOTHING NOTHING EQUALS NOTHING
-- with an application: late under either period makes it of no effect
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 1 5 2027) (JUST (Date 10 3 2029)) (JUST (Date 1 5 2027)) EQUALS JUST FALSE
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 2 5 2027) (JUST (Date 10 3 2029)) (JUST (Date 1 5 2027)) EQUALS JUST TRUE
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 11 3 2029) (JUST (Date 10 3 2029)) (JUST (Date 1 5 2030)) EQUALS JUST TRUE
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 1 1 2027) NOTHING (JUST (Date 1 5 2027)) EQUALS NOTHING
#ASSERT `s 1013(5) the notice of disclaimer is of no effect` (Date 2 5 2027) NOTHING (JUST (Date 1 5 2027)) EQUALS JUST TRUE
-- (6), (7)
#ASSERT `s 1013(6) the notice must be delivered to the registrar and retained and registered by him` TRUE EQUALS JUST TRUE
#ASSERT `s 1013(6) the notice must be delivered to the registrar and retained and registered by him` FALSE EQUALS NOTHING
#ASSERT `s 1013(7) copies of the notice must be published in the Gazette` TRUE EQUALS JUST TRUE
#ASSERT `s 1013(7) copies of the notice must be published in the Gazette` FALSE EQUALS NOTHING
-- (7) args: a notice has been executed; the person has given the Crown representative notice that they claim to be interested
#ASSERT `s 1013(7) a copy of the notice must be sent to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1013(7) a copy of the notice must be sent to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1013(7) a copy of the notice must be sent to the person` FALSE TRUE EQUALS NOTHING

§§ `s 1014 Effect of Crown disclaimer`

-- (1) args: notice executed; the section 1013(5) answer
#ASSERT `s 1014(1) the property is deemed not to have vested in the Crown under section 1012` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1014(1) the property is deemed not to have vested in the Crown under section 1012` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1014(1) the property is deemed not to have vested in the Crown under section 1012` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1014(1) the property is deemed not to have vested in the Crown under section 1012` TRUE NOTHING EQUALS NOTHING
-- (2) args: in England and Wales or Northern Ireland; in Scotland
#ASSERT `s 1014(2) the sections that apply to the property` TRUE FALSE EQUALS `s 1014(2) sections 1015 to 1019 (property in England and Wales or Northern Ireland)`
#ASSERT `s 1014(2) the sections that apply to the property` FALSE TRUE EQUALS `s 1014(2) sections 1020 to 1022 (property in Scotland)`
#ASSERT `s 1014(2) the sections that apply to the property` FALSE FALSE EQUALS `s 1014(2) neither set applies (property outside the three)`

§§ `s 1015 General effect of disclaimer`

-- (1) args: date of the disclaimer; date asked about
#ASSERT `s 1015(1) the rights, interests and liabilities of the company in or in respect of the property are terminated` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 1015(1) the rights, interests and liabilities of the company in or in respect of the property are terminated` (Date 1 6 2026) (Date 2 6 2026) EQUALS JUST TRUE
#ASSERT `s 1015(1) the rights, interests and liabilities of the company in or in respect of the property are terminated` (Date 1 6 2026) (Date 31 5 2026) EQUALS JUST FALSE
-- (2) args: the effect is necessary for releasing the company from liability
#ASSERT `s 1015(2) the disclaimer affects the rights or liabilities of the other person` FALSE EQUALS JUST FALSE
#ASSERT `s 1015(2) the disclaimer affects the rights or liabilities of the other person` TRUE EQUALS NOTHING

§§ `s 1016 Disclaimer of leaseholds`

-- (3) args: vested in the Duchy of Lancaster; vested in the Duke of Cornwall; in Scotland
#ASSERT `s 1016(3) the Crown representative for the property` TRUE FALSE FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Lancaster`
#ASSERT `s 1016(3) the Crown representative for the property` FALSE TRUE FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Cornwall`
#ASSERT `s 1016(3) the Crown representative for the property` FALSE FALSE TRUE EQUALS `s 1013(1) the Queen's and Lord Treasurer's Remembrancer`
#ASSERT `s 1016(3) the Crown representative for the property` FALSE FALSE FALSE EQUALS `s 1013(1) the Treasury Solicitor`
-- (1) the bar. args: leasehold; copy served on every underlessee and mortgagee; day the last notice was served (1 June 2026);
-- day an application under section 1017 was made (if); the court directs that the disclaimer shall take effect; date asked about
-- the 14 days beginning with 1 June end on 14 June
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) NOTHING FALSE (Date 14 6 2026) EQUALS JUST TRUE
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) NOTHING FALSE (Date 15 6 2026) EQUALS JUST FALSE
-- not served on every such person: barred however long it has been
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE FALSE (Date 1 6 2026) NOTHING FALSE (Date 1 1 2027) EQUALS JUST TRUE
-- an application within the 14 days and no direction: barred; with a direction: the bar is lifted
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) (JUST (Date 14 6 2026)) FALSE (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) (JUST (Date 14 6 2026)) TRUE (Date 1 1 2027) EQUALS JUST FALSE
-- an application after the 14 days is not "before the end of the period": limb (a) is satisfied once the period has ended
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) (JUST (Date 15 6 2026)) FALSE (Date 16 6 2026) EQUALS JUST FALSE
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` TRUE TRUE (Date 1 6 2026) (JUST (Date 15 6 2026)) FALSE (Date 14 6 2026) EQUALS JUST TRUE
-- property not of a leasehold character: not mentioned
#ASSERT `s 1016(1) the disclaimer of the leasehold property is barred from taking effect` FALSE TRUE (Date 1 6 2026) NOTHING FALSE (Date 1 1 2027) EQUALS NOTHING
-- (2)
#ASSERT `s 1016(2) the court may make such order as it thinks fit with respect to fixtures, tenant's improvements and other matters arising out of the lease` TRUE EQUALS JUST TRUE
#ASSERT `s 1016(2) the court may make such order as it thinks fit with respect to fixtures, tenant's improvements and other matters arising out of the lease` FALSE EQUALS JUST FALSE

§§ `s 1017 Power of court to make vesting order`

-- (1) args: claims an interest in the disclaimed property; under a liability not discharged by the disclaimer
#ASSERT `s 1017(1) the court may make a vesting order in respect of the property on the application of the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1017(1) the court may make a vesting order in respect of the property on the application of the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1017(1) the court may make a vesting order in respect of the property on the application of the person` FALSE FALSE EQUALS NOTHING
-- (2) args: entitled to it (or a trustee); subject to such a liability (or a trustee)
#ASSERT `s 1017(2) an order under section 1017 may vest the disclaimed property in, or deliver it to, the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1017(2) an order under section 1017 may vest the disclaimed property in, or deliver it to, the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1017(2) an order under section 1017 may vest the disclaimed property in, or deliver it to, the person` FALSE FALSE EQUALS NOTHING
-- (3) "may only be made where": no is the text's own
#ASSERT `s 1017(3) an order under subsection (2)(b) may be made` TRUE EQUALS JUST TRUE
#ASSERT `s 1017(3) an order under subsection (2)(b) may be made` FALSE EQUALS JUST FALSE
#ASSERT `s 1017(4) the order may be made on such terms as the court thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `s 1017(4) the order may be made on such terms as the court thinks fit` FALSE EQUALS NOTHING
#ASSERT `s 1017(5) the property comprised in the order vests in the person named without conveyance, assignment or transfer` TRUE EQUALS JUST TRUE
#ASSERT `s 1017(5) the property comprised in the order vests in the person named without conveyance, assignment or transfer` FALSE EQUALS JUST FALSE

§§ `s 1018 Protection of persons holding under a lease`

-- (1) args: leasehold nature; claims as underlessee or mortgagee; terms (a); terms (b) and the court thinks fit
#ASSERT `s 1018(1) the court is barred from making the vesting order` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1018(1) the court is barred from making the vesting order` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1018(1) the court is barred from making the vesting order` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1018(1) the court is barred from making the vesting order` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1018(1) the court is barred from making the vesting order` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1018(2) subsection (1) applies as if the lease had comprised only the property comprised in the vesting order` TRUE EQUALS JUST TRUE
#ASSERT `s 1018(2) subsection (1) applies as if the lease had comprised only the property comprised in the vesting order` FALSE EQUALS NOTHING
-- (3) args: claims as underlessee or mortgagee; declines to accept
#ASSERT `s 1018(3) the person is excluded from all interest in the property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1018(3) the person is excluded from all interest in the property` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1018(3) the person is excluded from all interest in the property` FALSE TRUE EQUALS NOTHING
-- (4) args: there is a person claiming who is willing; the person is liable to perform the lessee's covenants
#ASSERT `s 1018(4) the court has power to vest the company's estate and interest in the property in the person` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1018(4) the court has power to vest the company's estate and interest in the property in the person` TRUE TRUE EQUALS JUST FALSE; name-test sweep of 2026-11-12: a grant named "may" whose "if" gate fails answers NOTHING, not JUST FALSE (the other reading is JUST FALSE, fork F24); the facts are unchanged
#ASSERT `s 1018(4) the court has power to vest the company's estate and interest in the property in the person` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1018(4) the court has power to vest the company's estate and interest in the property in the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1018(5) the court may vest the estate and interest freed and discharged from all estates, incumbrances and interests created by the company` TRUE EQUALS JUST TRUE
#ASSERT `s 1018(5) the court may vest the estate and interest freed and discharged from all estates, incumbrances and interests created by the company` FALSE EQUALS NOTHING

§§ `s 1019 Land subject to rentcharge`

-- args: land subject to a rentcharge vests in the person in consequence of the disclaimer; the sum becomes due after possession, control or occupation
#ASSERT `s 1019 the person or his successors in title are subject to personal liability for the sum due under the rentcharge` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1019 the person or his successors in title are subject to personal liability for the sum due under the rentcharge` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1019 the person or his successors in title are subject to personal liability for the sum due under the rentcharge` FALSE FALSE EQUALS NOTHING

§§ `s 1020 General effect of disclaimer (Scotland)`

#ASSERT `s 1020(1) the rights, interests and liabilities of the company, and the property of the company, in or in respect of the property are determined` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 1020(1) the rights, interests and liabilities of the company, and the property of the company, in or in respect of the property are determined` (Date 1 6 2026) (Date 31 5 2026) EQUALS JUST FALSE
#ASSERT `s 1020(2) the disclaimer affects the rights or liabilities of the other person` FALSE EQUALS JUST FALSE
#ASSERT `s 1020(2) the disclaimer affects the rights or liabilities of the other person` TRUE EQUALS NOTHING

§§ `s 1021 Power of court to make vesting order (Scotland)`

-- (1) args: claims an interest; under a liability not discharged by this Act; the court has heard such persons as it thinks fit
#ASSERT `s 1021(1) the court may make a vesting order in respect of the property on the application of the person` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1021(1) the court may make a vesting order in respect of the property on the application of the person` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1021(1) the court may make a vesting order in respect of the property on the application of the person` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1021(1) the court may make a vesting order in respect of the property on the application of the person` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1021(2) the order may be made on such terms as the court thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `s 1021(2) the order may be made on such terms as the court thinks fit` FALSE EQUALS NOTHING
#ASSERT `s 1021(3) the property comprised in the order vests in the person named without conveyance or assignation` TRUE EQUALS JUST TRUE
#ASSERT `s 1021(3) the property comprised in the order vests in the person named without conveyance or assignation` FALSE EQUALS JUST FALSE

§§ `s 1022 Protection of persons holding under a lease (Scotland)`

#ASSERT `s 1022(6) the heritable security is duly recorded or duly registered` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1022(6) the heritable security is duly recorded or duly registered` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1022(6) the heritable security is duly recorded or duly registered` FALSE FALSE EQUALS JUST FALSE
-- (1) args: held under a lease; claims as sub-lessee; heritable security duly recorded or registered; claims as creditor in the security; terms (a); terms (b)
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE TRUE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE TRUE NOTHING FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE TRUE NOTHING FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE FALSE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
-- a creditor in a security that is not duly recorded or registered is outside the section
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` TRUE FALSE (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1022(1) the court is barred from making the vesting order in favour of the person` FALSE TRUE NOTHING FALSE FALSE FALSE EQUALS NOTHING
-- (3) args: a sub-lessee or creditor within (1); declines to accept
#ASSERT `s 1022(3) the person is excluded from all interest in and security over the property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1022(3) the person is excluded from all interest in and security over the property` TRUE FALSE EQUALS NOTHING
-- (4) args: there is a person claiming who is willing; the person is liable to perform the lessee's obligations
#ASSERT `s 1022(4) the court has power to vest the company's estate and interest in the property in the person` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1022(4) the court has power to vest the company's estate and interest in the property in the person` TRUE TRUE EQUALS JUST FALSE; name-test sweep of 2026-11-12: a grant named "may" whose "if" gate fails answers NOTHING, not JUST FALSE (the other reading is JUST FALSE, fork F25); the facts are unchanged
#ASSERT `s 1022(4) the court has power to vest the company's estate and interest in the property in the person` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1022(4) the court has power to vest the company's estate and interest in the property in the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1022(5) the court may vest the estate and interest freed and discharged from all interests, rights and obligations created by the company in the lease or in relation to the lease` TRUE EQUALS JUST TRUE
#ASSERT `s 1022(5) the court may vest the estate and interest freed and discharged from all interests, rights and obligations created by the company in the lease or in relation to the lease` FALSE EQUALS NOTHING

§§ `s 1023 Liability for rentcharge on company's land after dissolution`

#ASSERT `s 1023(3) the person is a company for the purposes of section 1023` TRUE EQUALS JUST TRUE
#ASSERT `s 1023(3) the person is a company for the purposes of section 1023` FALSE EQUALS NOTHING
-- (1) args: the (3) answer; the company is dissolved; land in England and Wales or Northern Ireland subject to a rentcharge vests on the dissolution
#ASSERT `s 1023(1) section 1023 applies` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1023(1) section 1023 applies` NOTHING TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1023(1) section 1023 applies` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1023(1) section 1023 applies` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 1023(1) section 1023 applies` (JUST TRUE) TRUE FALSE EQUALS NOTHING
-- (2) args: the (1) answer; the sum becomes due after possession, control or occupation
#ASSERT `s 1023(2) the proprietor or his successors in title are subject to personal liability for the sum due under the rentcharge` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1023(2) the proprietor or his successors in title are subject to personal liability for the sum due under the rentcharge` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 1023(2) the proprietor or his successors in title are subject to personal liability for the sum due under the rentcharge` NOTHING FALSE EQUALS NOTHING
