IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa11-part16-ch2-general`

-- coa11-tests-ch2-general.l4: tests for coa11-part16-ch2-general.l4 (ss 492 to 494A).
-- Every expected value is written by hand from the text of the section named beside it, before the run: the Table of
-- s 494ZA(1) is worked through on paper for each row and sub-case, with the company's financial years beginning on one day
-- of each calendar year.  Argument order is the order of the function's GIVEN.

§ `Tests: Part 16 Chapter 2, general provisions`

§§ `Test fixtures: a company whose financial years begin on one day of every calendar year`

-- the financial years beginning on `day` `month` of each year from `first year` to `last year`; a year is flagged when its
-- number is in `years with a qualifying selection procedure`
GIVEN day IS A NUMBER
      month IS A NUMBER
      `first year` IS A NUMBER
      `last year` IS A NUMBER
      `years with a qualifying selection procedure` IS A LIST OF NUMBER
GIVETH A LIST OF `s 494ZA financial year`
`coa11 test the company's financial years` MEANS
    IF `first year` GREATER THAN `last year`
    THEN EMPTY
    ELSE (`s 494ZA financial year` OF (Date day month `first year`), (Date (Day (Date day month (`first year` PLUS 1)) MINUS 1)), (elem `first year` `years with a qualifying selection procedure`))
         FOLLOWED BY `coa11 test the company's financial years` day month (`first year` PLUS 1) `last year` `years with a qualifying selection procedure`

-- the first day of the answer, if there is one
GIVEN answer IS A MAYBE `s 494ZA financial year`
GIVETH A MAYBE DATE
`coa11 test the first day of the answer` MEANS
    CONSIDER answer
    WHEN NOTHING THEN NOTHING
    WHEN JUST year THEN JUST (year's `s 494ZA first day of the financial year`)

-- the last day of the answer, if there is one
GIVEN answer IS A MAYBE `s 494ZA financial year`
GIVETH A MAYBE DATE
`coa11 test the last day of the answer` MEANS
    CONSIDER answer
    WHEN NOTHING THEN NOTHING
    WHEN JUST year THEN JUST (year's `s 494ZA last day of the financial year`)

-- the fixtures themselves
#ASSERT `coa11 test the first day of the answer` (JUST (`s 494ZA financial year` OF (Date 1 1 2020), (Date 31 12 2020), FALSE)) EQUALS JUST (Date 1 1 2020)
#ASSERT `coa11 test the company's financial years` 1 1 2020 2019 (EMPTY) EQUALS EMPTY  -- no years when the first is after the last
#ASSERT `coa11 test the company's financial years` 1 1 2020 2020 (LIST 2020) EQUALS LIST (`s 494ZA financial year` OF (Date 1 1 2020), (Date 31 12 2020), TRUE)
#ASSERT `coa11 test the company's financial years` 16 6 2020 2020 (EMPTY) EQUALS LIST (`s 494ZA financial year` OF (Date 16 6 2020), (Date 15 6 2021), FALSE)

§§ `s 492: fixing of auditor's remuneration`

#ASSERT `s 492(1) to (3) who must fix the auditor's remuneration` `s 492 appointed by the members` EQUALS `s 492(1) the members, by ordinary resolution or in such manner as the members may by ordinary resolution determine`
#ASSERT `s 492(1) to (3) who must fix the auditor's remuneration` `s 492 appointed by the directors` EQUALS `s 492(2) the directors`
#ASSERT `s 492(1) to (3) who must fix the auditor's remuneration` `s 492 appointed by the Secretary of State` EQUALS `s 492(3) the Secretary of State`
#ASSERT `s 492(1) to (3) who must fix the auditor's remuneration` `s 492 appointed in some other way` EQUALS `s 492 not covered: the auditor was appointed in some other way`  -- not covered
#ASSERT `s 492(4) the sum is part of the auditor's remuneration` TRUE EQUALS JUST TRUE  -- expenses are included
#ASSERT `s 492(4) the sum is part of the auditor's remuneration` FALSE EQUALS NOTHING  -- "includes": the list is not closed
#ASSERT `s 492(5) the section applies to the benefit as to a payment of money` TRUE EQUALS JUST TRUE
#ASSERT `s 492(5) the section applies to the benefit as to a payment of money` FALSE EQUALS NOTHING

§§ `s 494ZA(1): the Table, row 1 (a first year beginning before 17 June 1994)`

-- years begin on 16 June from 1993: 16 June 1993 is before 17 June 1994, so row 1; the last year to begin before 17 June 2020 begins on 16 June 2020
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 1993 2025 (EMPTY))) EQUALS JUST (Date 16 6 2020)
-- years begin on 17 June from 1993: the year beginning 17 June 2020 is not before 17 June 2020, so the last begins on 17 June 2019
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 17 6 1993 2025 (EMPTY))) EQUALS JUST (Date 17 6 2019)
-- the last day of that year is the day before the next year begins
#ASSERT `coa11 test the last day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 1993 2025 (EMPTY))) EQUALS JUST (Date 15 6 2021)
-- 16 June 1994 is before 17 June 1994: still row 1
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 1994 2025 (EMPTY))) EQUALS JUST (Date 16 6 2020)
-- the years supplied stop before the cut-off: not covered (the years supplied do not reach a year beginning on or after 17 June 2020)
#ASSERT `s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 1993 2019 (EMPTY)) EQUALS NOTHING
#ASSERT `s 494ZA(1) the last financial year of the maximum engagement period` (EMPTY) EQUALS NOTHING  -- no year supplied

§§ `s 494ZA(1): the Table, row 2 (a first year beginning on or after 17 June 1994 and before 17 June 2003)`

-- 17 June 1994 is on or after 17 June 1994: row 2; the last year to begin before 17 June 2023 begins on 17 June 2022
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 17 6 1994 2030 (EMPTY))) EQUALS JUST (Date 17 6 2022)
-- 16 June 2002 is before 17 June 2003: row 2; the last year to begin before 17 June 2023 begins on 16 June 2023
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 2002 2030 (EMPTY))) EQUALS JUST (Date 16 6 2023)
-- 16 June 2003 is before 17 June 2003: still row 2
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 2003 2030 (EMPTY))) EQUALS JUST (Date 16 6 2023)

§§ `s 494ZA(1): the Table, row 3 (a first year beginning on or after 17 June 2003 and before 17 June 2016)`

-- no qualifying selection procedure, first year 1 January 2010: the later of (a) 1 January 2016 (the last year to begin before 17 June 2016)
-- and (b) 1 January 2019 (the last year to begin within the 10 years from 1 January 2010) is 1 January 2019
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2010 2030 (EMPTY))) EQUALS JUST (Date 1 1 2019)
-- no qualifying selection procedure, first year 1 July 2003: (a) 1 July 2015 and (b) 1 July 2012: the later is 1 July 2015
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 7 2003 2030 (EMPTY))) EQUALS JUST (Date 1 7 2015)
-- 17 June 2003 is on or after 17 June 2003: row 3; no qualifying selection procedure: (a) 17 June 2015 and (b) 17 June 2012: 17 June 2015
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 17 6 2003 2030 (EMPTY))) EQUALS JUST (Date 17 6 2015)
-- no qualifying selection procedure within 10 years: the last such year is 2005, whose 10 years end on 31 December 2014, before 17 June 2016:
-- (a) the last year to begin before 17 June 2016, 1 January 2016, because the first year to begin on or after 17 June 2016 (1 January 2017) is not a qualifying year
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2005))) EQUALS JUST (Date 1 1 2016)
-- the same, but the auditor is appointed following a qualifying selection procedure for 2017 (the first year on or after 17 June 2016):
-- (b) the last year to begin within the 20 years from 1 January 2004, which begins on 1 January 2023
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2005, 2017))) EQUALS JUST (Date 1 1 2023)
-- the same, but the auditor's qualifying selection procedure for the first year on or after 17 June 2016 is missing (2018 is flagged, 2017 is not):
-- the last qualifying year before 17 June 2016 is still 2005, so sub-case (ii) applies and (b) does not: (a) the last year to begin before 17 June 2016, 1 January 2016
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2005, 2018))) EQUALS JUST (Date 1 1 2016)
-- qualifying selection procedure within 10 years: the last such year is 2008; the earlier of (a) the last year to begin within the 10 years from 1 January 2008 (1 January 2017)
-- and (b) the last year to begin within the 20 years from 1 January 2004 (1 January 2023) is 1 January 2017
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2008))) EQUALS JUST (Date 1 1 2017)
-- with a second qualifying year, 2017: (a) is the last year within the 10 years from 1 January 2017 (1 January 2026), (b) is 1 January 2023; the earlier is 1 January 2023
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2008, 2017))) EQUALS JUST (Date 1 1 2023)
-- the only qualifying year is after 17 June 2016 (2018): the 10 years from it end after 17 June 2016, so "any other case": (a) 1 January 2027, (b) 1 January 2023: the earlier is 1 January 2023
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2004 2030 (LIST 2018))) EQUALS JUST (Date 1 1 2023)
-- 16 June 2016 is before 17 June 2016: row 3; no qualifying selection procedure: (a) 16 June 2016 and (b) 16 June 2025 (within the 10 years from 16 June 2016): the later is 16 June 2025
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 16 6 2016 2030 (EMPTY))) EQUALS JUST (Date 16 6 2025)
-- the years supplied stop before 17 June 2016 (2010 to 2015): not covered
#ASSERT `s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2010 2015 (EMPTY)) EQUALS NOTHING
-- the years supplied stop before the 10 years end: not covered
#ASSERT `s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2010 2018 (EMPTY)) EQUALS NOTHING

§§ `s 494ZA(1): the Table, row 4 (a first year beginning on or after 17 June 2016)`

-- first year 1 January 2017 with a qualifying selection procedure for 2017: the earlier of (a) 1 January 2026 and (b) 1 January 2036 is 1 January 2026
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2017 2040 (LIST 2017))) EQUALS JUST (Date 1 1 2026)
-- and with a second qualifying year, 2022: (a) 1 January 2031, (b) 1 January 2036: 1 January 2031
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2017 2040 (LIST 2017, 2022))) EQUALS JUST (Date 1 1 2031)
-- and with a qualifying year 2030: (a) 1 January 2039, (b) 1 January 2036: the earlier is 1 January 2036
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 1 1 2017 2040 (LIST 2017, 2030))) EQUALS JUST (Date 1 1 2036)
-- 17 June 2016 is on or after 17 June 2016: row 4: (a) 17 June 2025 and (b) 17 June 2035: 17 June 2025
#ASSERT `coa11 test the first day of the answer` (`s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 17 6 2016 2040 (LIST 2016))) EQUALS JUST (Date 17 6 2025)
-- no qualifying selection procedure at all: the Table asks for the last year for which the auditor was appointed following one: not covered
#ASSERT `s 494ZA(1) the last financial year of the maximum engagement period` (`coa11 test the company's financial years` 17 6 2016 2040 (EMPTY)) EQUALS NOTHING

§§ `s 494ZA(2) to (4): extension of the maximum engagement period`

#ASSERT `s 494ZA(3) the competent authority may give its approval` TRUE EQUALS JUST TRUE
#ASSERT `s 494ZA(3) the competent authority may give its approval` FALSE EQUALS JUST FALSE  -- "only if it is satisfied that exceptional circumstances exist"
-- s 494ZA(2) arguments: first day of the first year, years of extension, approved, section 494ZA(3) answer
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 2 TRUE (JUST TRUE) EQUALS JUST TRUE  -- two years: "no more than 2 years"
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 1 TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 3 TRUE (JUST TRUE) EQUALS JUST FALSE  -- three years
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 17 6 2003) 2 TRUE (JUST TRUE) EQUALS JUST TRUE  -- the first year begins on 17 June 2003
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 16 6 2003) 2 TRUE (JUST TRUE) EQUALS NOTHING  -- before 17 June 2003: the extension is not given; not covered
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 2 FALSE (JUST TRUE) EQUALS JUST FALSE  -- no approval
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 2 TRUE (JUST FALSE) EQUALS JUST FALSE  -- the authority is not satisfied that exceptional circumstances exist
#ASSERT `s 494ZA(2) the maximum engagement period may be extended by the period` (Date 1 1 2010) 2 TRUE NOTHING EQUALS NOTHING
#ASSERT `s 494ZA(2) the last day of the maximum engagement period as extended` (Date 31 12 2024) 2 EQUALS Date 31 12 2026
#ASSERT `s 494ZA(2) the last day of the maximum engagement period as extended` (Date 31 12 2024) 1 EQUALS Date 31 12 2025
#ASSERT `s 494ZA(2) the last day of the maximum engagement period as extended` (Date 29 2 2024) 1 EQUALS Date 28 2 2025  -- capped at the end of a shorter February (fork F23)
#ASSERT `s 494ZA(4)(a) the second column of the Table has effect with the necessary modifications` TRUE EQUALS NOTHING  -- the modifications are not spelled out: not covered
#ASSERT `s 494ZA(4)(a) the second column of the Table has effect with the necessary modifications` FALSE EQUALS NOTHING
-- s 494ZA(4)(b) arguments: approval given, the first appointment after the extended period, made following a qualifying selection procedure
#ASSERT `s 494ZA(4)(b) the appointment meets the requirement of a qualifying selection procedure` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 494ZA(4)(b) the appointment meets the requirement of a qualifying selection procedure` TRUE TRUE FALSE EQUALS JUST FALSE  -- "must be made following a qualifying selection procedure"
#ASSERT `s 494ZA(4)(b) the appointment meets the requirement of a qualifying selection procedure` FALSE TRUE FALSE EQUALS NOTHING  -- no approval was given
#ASSERT `s 494ZA(4)(b) the appointment meets the requirement of a qualifying selection procedure` TRUE FALSE FALSE EQUALS NOTHING  -- not the first appointment after the extended period

§§ `s 494ZA(5): qualifying selection procedure`

-- arguments: first day of the year, after the 2017 Regulations, private company, audit committee, then the record of compliance
-- (i) 485A, (ii) 489A, (iii) 485B, (iv) 489B, (b) Article 16(2) to (5)
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- (a)(i)
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE  -- (a)(i) not met, whatever else is
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE TRUE FALSE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE  -- (a)(iii): a private company with no audit committee
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE TRUE FALSE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE FALSE TRUE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- (a)(ii): a public company with an audit committee
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE FALSE TRUE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE FALSE FALSE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE  -- (a)(iv): a public company with no audit committee
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 1 1 2017) TRUE FALSE FALSE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
-- (b) any other case: a year beginning before 17 June 2016, or an appointment made before the 2017 Regulations came into force
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 16 6 2016) TRUE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE  -- before 17 June 2016: only (b) counts
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 16 6 2016) TRUE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 17 6 2016) FALSE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE  -- before the Regulations came into force: only (b) counts
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 17 6 2016) FALSE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 494ZA(5) the selection procedure is a qualifying selection procedure` (Date 17 6 2016) TRUE TRUE TRUE (`s 494ZA(5) compliance of the selection procedure` OF TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE  -- 17 June 2016 and after the Regulations: (a)(i)

§§ `s 494A: interpretation`

-- "audit committee": a body which performs the DTR 7.1.3 functions, or the PRA rule 2.4 functions, or equivalent functions
#ASSERT `s 494A "audit committee" the body is an audit committee` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 494A "audit committee" the body is an audit committee` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 494A "audit committee" the body is an audit committee` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 494A "audit committee" the body is an audit committee` FALSE FALSE FALSE EQUALS JUST FALSE
-- "Auditor General": the Comptroller and Auditor General, for Scotland, for Wales, the Comptroller and Auditor General for Northern Ireland
#ASSERT `s 494A "Auditor General" the person is an Auditor General` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 494A "Auditor General" the person is an Auditor General` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 494A "Auditor General" the person is an Auditor General` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 494A "Auditor General" the person is an Auditor General` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 494A "Auditor General" the person is an Auditor General` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "issuer": the borrowed definition's own answer
#ASSERT `s 494A "issuer" the person is an issuer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 494A "issuer" the person is an issuer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 494A "issuer" the person is an issuer` NOTHING EQUALS NOTHING  -- Part 6 of the Financial Services and Markets Act 2000 is not among the sources
-- "network": an association of persons other than a firm co-operating in audit work by way of (a) to (f)
#ASSERT `s 494A "network" the association is a network` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- profit-sharing
#ASSERT `s 494A "network" the association is a network` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- cost sharing
#ASSERT `s 494A "network" the association is a network` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE  -- common ownership, control or management
#ASSERT `s 494A "network" the association is a network` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE  -- common quality control policies and procedures
#ASSERT `s 494A "network" the association is a network` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE  -- common business strategy
#ASSERT `s 494A "network" the association is a network` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE  -- use of a common name
#ASSERT `s 494A "network" the association is a network` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE  -- no co-operation of the listed kinds
#ASSERT `s 494A "network" the association is a network` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE  -- a firm, not an association of persons other than a firm
-- "public interest entity": arguments: issuer, securities admitted to a UK regulated market, credit institution and CRR firm, insurance undertaking
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE  -- (a)
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST TRUE) FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- an issuer whose securities are not admitted to a UK regulated market
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST FALSE) TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- admitted, but not an issuer
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST FALSE) FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE  -- (b)
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST FALSE) FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE  -- (c)
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST FALSE) FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- "means": none of (a) to (c) (fork F21 on the omitted words)
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` NOTHING TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING  -- not covered: "issuer" is a borrowed term not known
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` (JUST FALSE) FALSE NOTHING (JUST FALSE) EQUALS NOTHING  -- not covered
#ASSERT `s 494A "public interest entity" the entity is a public interest entity` NOTHING TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE  -- a limb that holds decides
