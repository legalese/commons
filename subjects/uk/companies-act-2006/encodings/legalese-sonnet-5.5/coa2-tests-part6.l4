IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-part6-registered-office`

-- coa2-tests-part6.l4: tests for coa2-part6-registered-office.l4 (ss 86-88B).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.

-- s 86(2): an address is an "appropriate address" if (a) a document delivered by hand or post would be expected to come to the attention of a person acting for the company, and (b) delivery is capable of being recorded by an acknowledgement
#ASSERT `s 86(2) the address is an appropriate address` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 86(2) the address is an appropriate address` TRUE FALSE EQUALS JUST FALSE -- (b) missing
#ASSERT `s 86(2) the address is an appropriate address` FALSE TRUE EQUALS JUST FALSE -- (a) missing

-- s 86(1) and (5): the duty does not apply during any period for which the address is a default address nominated under s 1097A(3)(h)
#ASSERT `s 86(1) the company must ensure that its registered office is at an appropriate address` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 86(1) the company must ensure that its registered office is at an appropriate address` (JUST TRUE) EQUALS JUST FALSE -- s 86(5)
#ASSERT `s 86(1) the company must ensure that its registered office is at an appropriate address` NOTHING EQUALS NOTHING

-- s 86(3): if a company fails, without reasonable excuse, to comply, an offence is committed by (a) the company and (b) every officer in default
-- (the company fails to comply, the company has a reasonable excuse, the person, the officer is in default)
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 86(3) the person commits an offence` TRUE TRUE Company NOTHING EQUALS JUST FALSE -- a reasonable excuse
#ASSERT `s 86(3) the person commits an offence` FALSE FALSE Company NOTHING EQUALS JUST FALSE -- the company did not fail
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE `Officer in default` NOTHING EQUALS JUST TRUE
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE `Shadow director` (JUST TRUE) EQUALS NOTHING -- silent: no sentence treating a shadow director as an officer in this section
#ASSERT `s 86(3) the person commits an offence` TRUE FALSE Member (JUST TRUE) EQUALS NOTHING

-- s 86(4): (a) in England and Wales, a fine; (b) in Scotland or Northern Ireland, level 5 on the standard scale and a daily default fine of one-tenth of level 5
#ASSERT (`s 86(4) the penalty on summary conviction` `England and Wales`)'s `how convicted` EQUALS `on summary conviction in England and Wales`
#ASSERT (`s 86(4) the penalty on summary conviction` `England and Wales`)'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT (`s 86(4) the penalty on summary conviction` `England and Wales`)'s `daily default fine for continued contravention` EQUALS NOTHING -- silent in (a)
#ASSERT (`s 86(4) the penalty on summary conviction` Scotland)'s `how convicted` EQUALS `on summary conviction in Scotland`
#ASSERT (`s 86(4) the penalty on summary conviction` Scotland)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 86(4) the penalty on summary conviction` Scotland)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 0.1)
#ASSERT (`s 86(4) the penalty on summary conviction` `Northern Ireland`)'s `how convicted` EQUALS `on summary conviction in Northern Ireland`
#ASSERT (`s 86(4) the penalty on summary conviction` `Northern Ireland`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 86(4) the penalty on summary conviction` `Northern Ireland`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 0.1)

-- s 87(1): a company may change the address of its registered office by giving notice to the registrar; (1A) the notice must include a statement
#ASSERT `s 87(1) the company may change the address of its registered office` TRUE EQUALS JUST TRUE
#ASSERT `s 87(1) the company may change the address of its registered office` FALSE EQUALS NOTHING
#ASSERT `s 87(1A) the notice must include a statement that the new address is an appropriate address within the meaning given by section 86(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 87(1A) the notice must include a statement that the new address is an appropriate address within the meaning given by section 86(2)` FALSE EQUALS NOTHING

-- s 87(2): the change takes effect upon the notice being registered (registered 10 April 2027)
#ASSERT `s 87(2) the change takes effect on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 87(2) the change takes effect on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 87(2) the change takes effect on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE -- not registered
-- s 87(2): until the end of the period of 14 days beginning with the date on which it is registered a person may validly serve a document at the previous address (10 April to 23 April 2027)
#ASSERT `s 87(2) a person may validly serve a document on the company at the address previously registered on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE -- the first day
#ASSERT `s 87(2) a person may validly serve a document on the company at the address previously registered on the day` (JUST (Date 10 4 2027)) (Date 23 4 2027) EQUALS JUST TRUE -- the 14th day
#ASSERT `s 87(2) a person may validly serve a document on the company at the address previously registered on the day` (JUST (Date 10 4 2027)) (Date 24 4 2027) EQUALS JUST FALSE -- after the period
#ASSERT `s 87(2) a person may validly serve a document on the company at the address previously registered on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS NOTHING -- before the period begins
#ASSERT `s 87(2) a person may validly serve a document on the company at the address previously registered on the day` NOTHING (Date 10 4 2027) EQUALS NOTHING

-- s 87(3): a company that has given notice may act on the change as from such date, not more than 14 days after the notice is given, as it may determine (notice given 1 May 2027)
#ASSERT `s 87(3) the company may act on the change as from that date` (Date 1 5 2027) (Date 15 5 2027) EQUALS JUST TRUE -- 14 days after
#ASSERT `s 87(3) the company may act on the change as from that date` (Date 1 5 2027) (Date 16 5 2027) EQUALS JUST FALSE -- 15 days after
#ASSERT `s 87(3) the company may act on the change as from that date` (Date 1 5 2027) (Date 1 5 2027) EQUALS JUST TRUE

-- s 87(4): a company that unavoidably ceases to perform a duty at its registered office, with no practicable prior notice, resumes as soon as practicable and gives notice within 14 days of doing so, is not treated as having failed
-- (unavoidably ceases, prior notice not practicable, resumes as soon as practicable, date of resuming, date of notice)
#ASSERT `s 87(4) the company is protected from being treated as having failed to comply with the duty` TRUE TRUE TRUE (Date 1 6 2027) (Date 15 6 2027) EQUALS JUST TRUE -- within 14 days of doing so
#ASSERT `s 87(4) the company is protected from being treated as having failed to comply with the duty` TRUE TRUE TRUE (Date 1 6 2027) (Date 16 6 2027) EQUALS JUST FALSE -- 15 days after
#ASSERT `s 87(4) the company is protected from being treated as having failed to comply with the duty` FALSE TRUE TRUE (Date 1 6 2027) (Date 10 6 2027) EQUALS JUST FALSE -- not unavoidable
#ASSERT `s 87(4) the company is protected from being treated as having failed to comply with the duty` TRUE FALSE TRUE (Date 1 6 2027) (Date 10 6 2027) EQUALS JUST FALSE -- prior notice was practicable
#ASSERT `s 87(4) the company is protected from being treated as having failed to comply with the duty` TRUE TRUE FALSE (Date 1 6 2027) (Date 10 6 2027) EQUALS JUST FALSE -- did not resume as soon as practicable

-- s 88(1): a "Welsh company" is a company as to which it is stated in the register that its registered office is to be situated in Wales
#ASSERT `s 88(1) the company is a Welsh company` TRUE EQUALS JUST TRUE
#ASSERT `s 88(1) the company is a Welsh company` FALSE EQUALS JUST FALSE

-- s 88(2): a company whose registered office is in Wales and for which the register says England and Wales may by special resolution require the register to say Wales
-- (office in Wales, register says England and Wales, special resolution)
#ASSERT `s 88(2) the company may by special resolution require the register to state that its registered office is to be situated in Wales` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 88(2) the company may by special resolution require the register to state that its registered office is to be situated in Wales` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- not a special resolution
#ASSERT `s 88(2) the company may by special resolution require the register to state that its registered office is to be situated in Wales` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 88(2) the company may by special resolution require the register to state that its registered office is to be situated in Wales` FALSE TRUE (JUST TRUE) EQUALS NOTHING -- the office is not in Wales
#ASSERT `s 88(2) the company may by special resolution require the register to state that its registered office is to be situated in Wales` TRUE FALSE (JUST TRUE) EQUALS NOTHING -- the register does not say England and Wales
-- s 88(3): the converse
#ASSERT `s 88(3) the company may by special resolution require the register to state that its registered office is to be situated in England and Wales` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 88(3) the company may by special resolution require the register to state that its registered office is to be situated in England and Wales` TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 88(3) the company may by special resolution require the register to state that its registered office is to be situated in England and Wales` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 88(3) the company may by special resolution require the register to state that its registered office is to be situated in England and Wales` TRUE FALSE (JUST TRUE) EQUALS NOTHING
-- s 88(4): where a company passes a resolution under this section it must give notice to the registrar, who shall amend the register and issue a new certificate
#ASSERT `s 88(4) the company must give notice to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 88(4) the company must give notice to the registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 88(4)(a) the registrar must amend the register accordingly` TRUE EQUALS JUST TRUE
#ASSERT `s 88(4)(a) the registrar must amend the register accordingly` FALSE EQUALS NOTHING
#ASSERT `s 88(4)(b) the registrar must issue a new certificate of incorporation altered to meet the circumstances of the case` TRUE EQUALS JUST TRUE
#ASSERT `s 88(4)(b) the registrar must issue a new certificate of incorporation altered to meet the circumstances of the case` FALSE EQUALS NOTHING

-- s 88A(2): an email address is an "appropriate email address" if emails sent to it by the registrar would be expected to come to the attention of a person acting on behalf of the company
#ASSERT `s 88A(2) the email address is an appropriate email address` TRUE EQUALS JUST TRUE
#ASSERT `s 88A(2) the email address is an appropriate email address` FALSE EQUALS JUST FALSE
#ASSERT `s 88A(1) the company must ensure that its registered email address is an appropriate email address` TRUE EQUALS JUST TRUE
#ASSERT `s 88A(1) the company must ensure that its registered email address is an appropriate email address` FALSE EQUALS NOTHING
-- s 88A(3): offence where the company fails without reasonable excuse
#ASSERT `s 88A(3) the person commits an offence` TRUE FALSE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 88A(3) the person commits an offence` TRUE TRUE Company NOTHING EQUALS JUST FALSE -- a reasonable excuse
#ASSERT `s 88A(3) the person commits an offence` FALSE FALSE Company NOTHING EQUALS JUST FALSE
#ASSERT `s 88A(3) the person commits an offence` TRUE FALSE `Officer in default` NOTHING EQUALS JUST TRUE
#ASSERT `s 88A(3) the person commits an offence` TRUE FALSE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 88A(3) the person commits an offence` TRUE FALSE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 88A(3) the person commits an offence` TRUE FALSE `Shadow director` (JUST TRUE) EQUALS NOTHING -- silent
-- s 88A(4): (a) in England and Wales a fine; (b) in Scotland or Northern Ireland level 5 and a daily default fine of one-tenth of level 5
#ASSERT (`s 88A(4) the penalty on summary conviction` `England and Wales`)'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT (`s 88A(4) the penalty on summary conviction` `England and Wales`)'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT (`s 88A(4) the penalty on summary conviction` Scotland)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 88A(4) the penalty on summary conviction` Scotland)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 0.1)
#ASSERT (`s 88A(4) the penalty on summary conviction` `Northern Ireland`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 88A(4) the penalty on summary conviction` `Northern Ireland`)'s `how convicted` EQUALS `on summary conviction in Northern Ireland`

-- s 88B(1): a company may change its registered email address by giving notice; (2) the notice must include a statement; (3) the change takes effect upon registration (registered 10 April 2027)
#ASSERT `s 88B(1) the company may change its registered email address` TRUE EQUALS JUST TRUE
#ASSERT `s 88B(1) the company may change its registered email address` FALSE EQUALS NOTHING
#ASSERT `s 88B(2) the notice must include a statement that the new address is an appropriate email address within the meaning given by section 88A(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 88B(2) the notice must include a statement that the new address is an appropriate email address within the meaning given by section 88A(2)` FALSE EQUALS NOTHING
#ASSERT `s 88B(3) the change takes effect on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 88B(3) the change takes effect on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 88B(3) the change takes effect on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE
-- s 86: the registered office as a seam answer for other parts: the registered address is the registered office; otherwise the text does not say
#ASSERT `s 86 the company has its registered office at the address` TRUE EQUALS JUST TRUE
#ASSERT `s 86 the company has its registered office at the address` FALSE EQUALS NOTHING
