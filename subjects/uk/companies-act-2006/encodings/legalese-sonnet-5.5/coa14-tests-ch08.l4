#ASSERT `s 621(5) the penalty for a person guilty of an offence under this section` FALSE EQUALS NOTHING


§§ `s 622`
#ASSERT `s 622(1) the company may redenominate its share capital` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 622(1) the company may redenominate its share capital` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 622(1) the company may redenominate its share capital` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 622(1) the company may redenominate its share capital` TRUE TRUE FALSE EQUALS NOTHING
-- "Redenominate" means convert shares from a fixed nominal value in one currency to a fixed nominal value in another
#ASSERT `s 622(1) the conversion is a redenomination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 622(1) the conversion is a redenomination` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 622(1) the conversion is a redenomination` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 622(2) the conversion is made at a rate the section requires` TRUE TRUE EQUALS JUST TRUE
