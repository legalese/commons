#ASSERT `s 620(1) the company may reconvert the stock into paid-up shares of any nominal value` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 620(1) the company may reconvert the stock into paid-up shares of any nominal value` TRUE FALSE EQUALS NOTHING
#ASSERT `s 620(1) the company may reconvert the stock into paid-up shares of any nominal value` FALSE TRUE EQUALS NOTHING
