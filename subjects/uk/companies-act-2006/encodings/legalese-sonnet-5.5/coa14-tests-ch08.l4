#ASSERT `s 620(2) the section bars the company from exercising the power for want of an ordinary resolution` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 620(2) the section bars the company from exercising the power for want of an ordinary resolution` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 620(2) the section bars the company from exercising the power for want of an ordinary resolution` TRUE NOTHING EQUALS NOTHING
