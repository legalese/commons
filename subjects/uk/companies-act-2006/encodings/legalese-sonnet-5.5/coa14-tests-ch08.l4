#ASSERT `s 620(3) the resolution may authorise this` TRUE `s 620(3) something else` EQUALS NOTHING
#ASSERT `s 620(3) the resolution may authorise this` FALSE `s 620(3)(a) the exercise of the power on more than one occasion` EQUALS NOTHING
-- (1) and (2) together
#ASSERT `s 620 the company may exercise the power conferred by section 620` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 620 the company may exercise the power conferred by section 620` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 620 the company may exercise the power conferred by section 620` NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 620 the company may exercise the power conferred by section 620` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 620 the company may exercise the power conferred by section 620` (JUST TRUE) NOTHING EQUALS NOTHING

§§ `s 621`
-- (1) notice within one month after exercising the power; 10 March 2023: the last day is 10 April 2023
