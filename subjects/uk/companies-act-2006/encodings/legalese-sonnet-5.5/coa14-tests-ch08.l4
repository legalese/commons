IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa14-nouns`
IMPORT `coa14-ch08-alteration`

-- coa14-tests-ch08.l4: tests for Chapter 8 (ss 617 to 628). EXPECTED VALUES ARE HAND-WRITTEN FROM THE TEXT, beside each
-- assertion or in the arguments of the generator line that makes a group of them. A failing assertion is a finding.

§ `Tests: Chapter 8 -- Alteration of share capital`

§§ `s 617`
-- fixtures: one alteration of each way, made in accordance with the provision that names it (TRUE) or not (FALSE)
`s 617 fixture (2)(a) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(2)(a) increase the share capital by allotting new shares in accordance with this Part`, TRUE
`s 617 fixture (2)(a) not in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(2)(a) increase the share capital by allotting new shares in accordance with this Part`, FALSE
`s 617 fixture (2)(b) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(2)(b) reduce the share capital in accordance with Chapter 10`, TRUE
`s 617 fixture (3)(a) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(3)(a) sub-divide or consolidate the share capital in accordance with section 618`, TRUE
`s 617 fixture (3)(b) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(3)(b) reconvert stock into shares in accordance with section 620`, TRUE
`s 617 fixture (4)(a) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(4)(a) redenominate shares in accordance with section 622`, TRUE
`s 617 fixture (4)(b) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(4)(b) reduce the share capital in accordance with section 626 in connection with a redenomination`, TRUE
`s 617 fixture (4)(b) not in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(4)(b) reduce the share capital in accordance with section 626 in connection with a redenomination`, FALSE
`s 617 fixture (5)(a) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(a) purchase or redeem shares in accordance with Part 18`, TRUE
`s 617 fixture (5)(a) not in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(a) purchase or redeem shares in accordance with Part 18`, FALSE
`s 617 fixture (5)(b) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(b) purchase shares in pursuance of an order of the court under section 98, 721(6), 759 or Part 30`, TRUE
`s 617 fixture (5)(c) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(c) forfeit shares, or accept shares surrendered in lieu, in pursuance of the articles`, TRUE
`s 617 fixture (5)(d) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(d) cancel shares under section 662`, TRUE
`s 617 fixture (5)(e) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(e) compromise or arrangement under Part 26 or 26A, or compliance with a court order on an application under that Part`, TRUE
`s 617 fixture (5)(f) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(f) cancel a share warrant and its shares under paragraph 6 of Schedule 4 to the Small Business, Enterprise and Employment Act 2015`, TRUE
`s 617 fixture (5)(g) in accordance` MEANS `s 617(1) alteration of share capital` OF `s 617(5)(g) cancel a share warrant and its shares under section 1028A(2) or 1032A(2)`, TRUE
`s 617 fixture some other way` MEANS `s 617(1) alteration of share capital` OF `s 617 some other way of altering share capital`, TRUE
-- "A limited company having a share capital may not alter its share capital except in the following ways": a listed way in accordance is not barred
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (2)(a) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (2)(b) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (3)(a) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (3)(b) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (4)(a) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (4)(b) in accordance` EQUALS JUST FALSE
-- a listed way not made in accordance with the provision that names it is not one of "the following ways": barred
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (2)(a) not in accordance` EQUALS JUST TRUE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (4)(b) not in accordance` EQUALS JUST TRUE
-- any other way: barred
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture some other way` EQUALS JUST TRUE
-- (5) "Nothing in this section affects" these powers: not barred by this section
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(a) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(b) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(c) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(d) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(e) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(f) in accordance` EQUALS JUST FALSE
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(g) in accordance` EQUALS JUST FALSE
-- a (5) power used outside its provision: the subsection does not address it
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` TRUE `s 617 fixture (5)(a) not in accordance` EQUALS NOTHING
-- the bar is on "A limited company having a share capital": another company is outside it
#ASSERT `s 617(1) the section bars the company from altering its share capital in this way` FALSE `s 617 fixture some other way` EQUALS NOTHING

§§ `s 618`
-- (1) the two powers
#ASSERT `s 618(1) the company may use the power to change its shares in this way` TRUE `s 618(1)(a) sub-division into shares of a smaller nominal amount` 1 2 EQUALS JUST TRUE
#ASSERT `s 618(1) the company may use the power to change its shares in this way` TRUE `s 618(1)(a) sub-division into shares of a smaller nominal amount` 2 2 EQUALS NOTHING
#ASSERT `s 618(1) the company may use the power to change its shares in this way` TRUE `s 618(1)(a) sub-division into shares of a smaller nominal amount` 3 2 EQUALS NOTHING
#ASSERT `s 618(1) the company may use the power to change its shares in this way` TRUE `s 618(1)(b) consolidation and division into shares of a larger nominal amount` 10 1 EQUALS JUST TRUE
#ASSERT `s 618(1) the company may use the power to change its shares in this way` TRUE `s 618(1)(b) consolidation and division into shares of a larger nominal amount` 1 1 EQUALS NOTHING
#ASSERT `s 618(1) the company may use the power to change its shares in this way` FALSE `s 618(1)(a) sub-division into shares of a smaller nominal amount` 1 2 EQUALS NOTHING
-- (2) the proportion between paid and unpaid is kept: 5:5 stays 5:5 at 2.5:2.5; 5:5 does not become 1:2; 0:10 stays 0:5; 10:0 stays 2:0
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 5 5 2.5 2.5 EQUALS JUST TRUE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 5 5 1 2 EQUALS JUST FALSE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 0 10 0 5 EQUALS JUST TRUE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 0 10 1 5 EQUALS JUST FALSE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 10 0 2 0 EQUALS JUST TRUE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 10 0 2 1 EQUALS JUST FALSE
#ASSERT `s 618(2) the proportion between the amount paid and the amount unpaid is the same as before` 0 0 0 0 EQUALS NOTHING
-- (3) only if members have passed a resolution
#ASSERT `s 618(3) the section bars the company from exercising the power for want of a resolution` TRUE EQUALS JUST FALSE
#ASSERT `s 618(3) the section bars the company from exercising the power for want of a resolution` FALSE EQUALS JUST TRUE
-- (4) what the resolution may authorise
#ASSERT `s 618(4) the resolution may authorise this` TRUE `s 618(4)(a) the exercise of more than one of the powers` EQUALS JUST TRUE
#ASSERT `s 618(4) the resolution may authorise this` TRUE `s 618(4)(b) the exercise of a power on more than one occasion` EQUALS JUST TRUE
#ASSERT `s 618(4) the resolution may authorise this` TRUE `s 618(4)(c) the exercise of a power at a specified time or in specified circumstances` EQUALS JUST TRUE
#ASSERT `s 618(4) the resolution may authorise this` TRUE `s 618(4) something else` EQUALS NOTHING
#ASSERT `s 618(4) the resolution may authorise this` FALSE `s 618(4)(a) the exercise of more than one of the powers` EQUALS NOTHING
-- (5) the articles may exclude or restrict the power
#ASSERT `s 618(5) the company's articles bar the exercise of the power` TRUE EQUALS JUST TRUE
#ASSERT `s 618(5) the company's articles bar the exercise of the power` FALSE EQUALS JUST FALSE
-- all together
#ASSERT `s 618 the company may exercise the power conferred by section 618` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 618 the company may exercise the power conferred by section 618` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 618 the company may exercise the power conferred by section 618` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 618 the company may exercise the power conferred by section 618` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 618 the company may exercise the power conferred by section 618` NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 618 the company may exercise the power conferred by section 618` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING

§§ `s 619`
-- fixtures: a statement of capital, positionally: total number, aggregate nominal value, aggregate unpaid, class entries, stated for the right moment;
-- a class entry: prescribed particulars of the rights, total number of shares of the class, aggregate nominal value of the class
`s 619 fixture complete class entry` MEANS `s 619(3)(c) class entry in a statement of capital` OF TRUE, TRUE, TRUE
`s 619 fixture class entry without the rights` MEANS `s 619(3)(c) class entry in a statement of capital` OF FALSE, TRUE, TRUE
`s 619 fixture class entry without the number` MEANS `s 619(3)(c) class entry in a statement of capital` OF TRUE, FALSE, TRUE
`s 619 fixture class entry without the nominal value` MEANS `s 619(3)(c) class entry in a statement of capital` OF TRUE, TRUE, FALSE
`s 619 fixture complete statement` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture complete class entry`, `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement without the total number` MEANS `s 619(3) statement of capital` OF FALSE, TRUE, TRUE, (LIST `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement without the aggregate nominal value` MEANS `s 619(3) statement of capital` OF TRUE, FALSE, TRUE, (LIST `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement without the aggregate unpaid` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, FALSE, (LIST `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement for the wrong moment` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture complete class entry`), FALSE
`s 619 fixture statement with a class entry lacking the rights` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture complete class entry`, `s 619 fixture class entry without the rights`), TRUE
`s 619 fixture statement with a class entry lacking the number` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture class entry without the number`), TRUE
`s 619 fixture statement with a class entry lacking the nominal value` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture class entry without the nominal value`), TRUE
`s 619 fixture statement listing no class` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, EMPTY, TRUE
`s 619 fixture statement listing no class and lacking the total` MEANS `s 619(3) statement of capital` OF FALSE, TRUE, TRUE, EMPTY, TRUE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture complete statement` EQUALS JUST TRUE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement without the total number` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement without the aggregate nominal value` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement without the aggregate unpaid` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement for the wrong moment` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement with a class entry lacking the rights` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement with a class entry lacking the number` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement with a class entry lacking the nominal value` EQUALS JUST FALSE
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement listing no class` EQUALS NOTHING
#ASSERT `s 619(3) the statement of capital states what the section requires` `s 619 fixture statement listing no class and lacking the total` EQUALS JUST FALSE
-- the pounds a fine limit stands for (the pounds of level 3 and of the statutory maximum are INPUTS: 1,000 and 5,000 here are test inputs, not the Act's figures)
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding a level on the standard scale` 3 1) 1000 5000 EQUALS JUST 1000
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding a level on the standard scale` 3 0.1) 1000 5000 EQUALS JUST 100
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding a level on the standard scale` 4 1) 1000 5000 EQUALS NOTHING
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding the statutory maximum` 1) 1000 5000 EQUALS JUST 5000
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding the statutory maximum` 0.2) 1000 5000 EQUALS JUST 1000
#ASSERT `s 619(5) the most a fine can be, in pounds` `a fine without a stated limit` 1000 5000 EQUALS NOTHING
#ASSERT `s 619(5) the most a fine can be, in pounds` (`a fine not exceeding an amount in pounds` 250) 1000 5000 EQUALS JUST 250
-- (1) notice within one month after exercising the power; 15 January 2023: the last day is 15 February 2023
-- s 619(1): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 619(1) the last day for the notice` (Date 15 1 2023) EQUALS Date 15 2 2023
#ASSERT `s 619(1) the number of days allowed for the notice` (Date 15 1 2023) EQUALS 31
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) (JUST (Date 15 2 2023)) (Date 15 2 2023) EQUALS JUST TRUE
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) (JUST (Date 15 1 2023)) (Date 15 2 2023) EQUALS JUST TRUE
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) (JUST (Date 16 2 2023)) (Date 16 2 2023) EQUALS JUST FALSE
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) (JUST (Date 14 1 2023)) (Date 16 2 2023) EQUALS NOTHING
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) NOTHING (Date 16 2 2023) EQUALS JUST FALSE
#ASSERT `s 619(1) the company gave notice to the registrar in time` (Date 15 1 2023) NOTHING (Date 15 2 2023) EQUALS NOTHING
-- a month after the 31 1 2023: the last day of a shorter month (the calendar month clamps)
#ASSERT `s 619(1) the last day for the notice` (Date 31 1 2023) EQUALS Date 28 2 2023
-- the regulative duty: acting inside the period fulfils it, waiting past it is a breach (traces; a DEONTIC cannot be compared)
#TRACE `s 619(1) the company's duty to give notice to the registrar, specifying the shares affected` 31 AT 0 WITH
    PARTY Company DOES `Action of a party` Company Registrar "give notice to the registrar, specifying the shares affected" AT 31
#TRACE `s 619(1) the company's duty to give notice to the registrar, specifying the shares affected` 31 AT 0 WITH
    (WAITUNTIL 32)

#ASSERT `s 619(1) the notice specifies the shares affected` TRUE EQUALS JUST TRUE
#ASSERT `s 619(1) the notice specifies the shares affected` FALSE EQUALS JUST FALSE
#ASSERT `s 619(2) the notice is accompanied by a statement of capital` TRUE EQUALS JUST TRUE
#ASSERT `s 619(2) the notice is accompanied by a statement of capital` FALSE EQUALS JUST FALSE
-- s 619(4): default is made if any requirement is not met
#ASSERT `s 619(4) default is made in complying with this section` (LIST (JUST TRUE), (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 619(4) default is made in complying with this section` (LIST (JUST TRUE), (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 619(4) default is made in complying with this section` (LIST (JUST TRUE), NOTHING) EQUALS NOTHING
#ASSERT `s 619(4) default is made in complying with this section` (LIST NOTHING, (JUST FALSE)) EQUALS JUST TRUE
-- s 619(4): an offence is committed by (a) the company, and (b) every officer who is in default
#ASSERT `s 619(4)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 619(4)(a) the company commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 619(4)(a) the company commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 619(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 619(4)(b) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 619(4)(b) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 619(4)(b) the officer commits an offence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 619(4)(b) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
-- s 619(5): liable on summary conviction to a fine not exceeding level 3 and, for continued contravention, a daily default fine not exceeding one-tenth of level 3
#ASSERT `s 619(5) the penalty for a person guilty of an offence under this section` TRUE EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE)
#ASSERT `s 619(5) the penalty for a person guilty of an offence under this section` FALSE EQUALS NOTHING


