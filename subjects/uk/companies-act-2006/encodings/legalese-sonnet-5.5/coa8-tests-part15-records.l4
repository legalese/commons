IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-records`

-- Tests of ss 386 to 389 (accounting records). Every expected value was written from the text before the run.

-- s 386(1): "Every company must keep adequate accounting records"
#ASSERT `s 386(1) the company is required to keep adequate accounting records` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 386(1) the company is required to keep adequate accounting records` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 386(1) the company is required to keep adequate accounting records` NOTHING EQUALS NOTHING
-- s 386(2): adequate records are sufficient in all three respects
#ASSERT `s 386(2) the records are adequate accounting records` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386(2) the records are adequate accounting records` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386(2) the records are adequate accounting records` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386(2) the records are adequate accounting records` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 386(3)
#ASSERT `s 386(3) the records contain what subsection (3) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386(3) the records contain what subsection (3) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386(3) the records contain what subsection (3) requires` TRUE FALSE EQUALS JUST FALSE
-- s 386(4): only a company whose business involves dealing in goods; ordinary retail sales are excepted from limb (c)
#ASSERT `s 386(4) the records are required to contain the stock and goods statements` TRUE EQUALS JUST TRUE
#ASSERT `s 386(4) the records are required to contain the stock and goods statements` FALSE EQUALS JUST FALSE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386(4) the records contain the statements subsection (4) requires` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- s 386(5)
#ASSERT `s 386(5) the parent company is required to take reasonable steps to secure that the subsidiary undertaking keeps accounting records` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 386(5) the parent company is required to take reasonable steps to secure that the subsidiary undertaking keeps accounting records` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 386(5) the parent company is required to take reasonable steps to secure that the subsidiary undertaking keeps accounting records` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 386(5) the parent company is required to take reasonable steps to secure that the subsidiary undertaking keeps accounting records` NOTHING TRUE EQUALS NOTHING

-- s 387(1): an offence by every officer in default if the company fails to comply with section 386
#ASSERT `s 387(1) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 387(1) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 387(1) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 387(1) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 387(1) the officer commits an offence` NOTHING (JUST FALSE) EQUALS JUST FALSE
-- s 387(2): the defence needs both honesty and excusable default
#ASSERT `s 387(2) this subsection gives the person a defence on these facts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387(2) this subsection gives the person a defence on these facts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 387(2) this subsection gives the person a defence on these facts` FALSE TRUE EQUALS JUST FALSE
-- s 387(3): indictment, two years or a fine or both; summary: twelve months (England and Wales) or six months (Scotland, Northern Ireland), or a fine not exceeding the statutory maximum, or both
#ASSERT `s 387(3) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 387(3) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 387(3) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 387(3) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 387(3) the penalty on conviction` `on summary conviction` EQUALS NOTHING

-- s 388(1): kept at the registered office or another place the directors think fit, and at all times open to the officers
#ASSERT `s 388(1) the accounting records are kept as subsection (1) requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 388(1) the accounting records are kept as subsection (1) requires` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 388(1) the accounting records are kept as subsection (1) requires` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 388(1) the accounting records are kept as subsection (1) requires` TRUE FALSE FALSE EQUALS JUST FALSE
-- s 388(2): records kept outside the United Kingdom
#ASSERT `s 388(2) the accounts and returns for records kept outside the United Kingdom are kept as subsection (2) requires` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 388(2) the accounts and returns for records kept outside the United Kingdom are kept as subsection (2) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 388(2) the accounts and returns for records kept outside the United Kingdom are kept as subsection (2) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 388(2) the accounts and returns for records kept outside the United Kingdom are kept as subsection (2) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 388(3): at intervals of not more than six months
#ASSERT `s 388(3) the accounts and returns sent to the United Kingdom are such as subsection (3) requires` FALSE 12 FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 388(3) the accounts and returns sent to the United Kingdom are such as subsection (3) requires` TRUE 6 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 388(3) the accounts and returns sent to the United Kingdom are such as subsection (3) requires` TRUE 7 TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 388(3) the accounts and returns sent to the United Kingdom are such as subsection (3) requires` TRUE 6 FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 388(3) the accounts and returns sent to the United Kingdom are such as subsection (3) requires` TRUE 6 TRUE FALSE EQUALS JUST FALSE
-- s 388(5) and (4)
#ASSERT `s 388(5) a provision of insolvency rules displaces subsection (4)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 388(5) a provision of insolvency rules displaces subsection (4)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 388(5) a provision of insolvency rules displaces subsection (4)` NOTHING EQUALS NOTHING
#ASSERT `s 388(4) the period for which the accounting records must be preserved` FALSE EQUALS Period OF 3, Years
#ASSERT `s 388(4) the period for which the accounting records must be preserved` TRUE EQUALS Period OF 6, Years
-- a private company, records made on 1 March 2020: three years from that date, anniversary 1 March 2023
#ASSERT `s 388(4) the accounting records must still be preserved on the day` FALSE (Date 1 3 2020) (Date 28 2 2023) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 388(4) the accounting records must still be preserved on the day` FALSE (Date 1 3 2020) (Date 1 3 2023) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 388(4) the accounting records must still be preserved on the day` FALSE (Date 1 3 2020) (Date 2 3 2023) (JUST FALSE) EQUALS JUST FALSE
-- a public company: six years, anniversary 1 March 2026
#ASSERT `s 388(4) the accounting records must still be preserved on the day` TRUE (Date 1 3 2020) (Date 28 2 2026) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 388(4) the accounting records must still be preserved on the day` TRUE (Date 1 3 2020) (Date 1 3 2026) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 388(4) the accounting records must still be preserved on the day` TRUE (Date 1 3 2020) (Date 2 3 2026) (JUST FALSE) EQUALS JUST FALSE
-- insolvency rules
#ASSERT `s 388(4) the accounting records must still be preserved on the day` FALSE (Date 1 3 2020) (Date 28 2 2023) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 388(4) the accounting records must still be preserved on the day` FALSE (Date 1 3 2020) (Date 28 2 2023) NOTHING EQUALS NOTHING

-- s 389(1)
#ASSERT `s 389(1) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 389(1) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 389(1) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 389(1) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
-- s 389(2)
#ASSERT `s 389(2) this subsection gives the person a defence on these facts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 389(2) this subsection gives the person a defence on these facts` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 389(2) this subsection gives the person a defence on these facts` TRUE FALSE EQUALS JUST FALSE
-- s 389(3): (a) fails to take all reasonable steps, or (b) intentionally causes the default
#ASSERT `s 389(3) the officer commits an offence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 389(3) the officer commits an offence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 389(3) the officer commits an offence` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 389(3) the officer commits an offence` FALSE TRUE TRUE EQUALS JUST FALSE
-- s 389(4): the same penalties as section 387
#ASSERT `s 389(4) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 389(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 389(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 389(4) the penalty on conviction` `on summary conviction` EQUALS NOTHING
