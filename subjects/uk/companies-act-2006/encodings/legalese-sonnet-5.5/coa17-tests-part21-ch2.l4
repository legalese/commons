IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa17-helpers`
IMPORT `coa17-part21-ch2`

-- coa17-tests-part21-ch2.l4: tests for ss 783-790 (coa17-part21-ch2.l4). Expected values are written by hand from the
-- text of the section named beside each group.

§ `Tests: Part 21 Chapter 2`

-- s 783(a) "securities" means shares, debentures, debenture stock, loan stock, bonds, units of a collective investment
-- scheme within FSMA 2000, and other securities of any description
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) shares` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) debentures` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) debenture stock` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) loan stock` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) bonds` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) units of a collective investment scheme within the meaning of the Financial Services and Markets Act 2000` FALSE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) an instrument of some other kind` TRUE EQUALS JUST TRUE
#ASSERT `s 783(a) the instrument is a security for the purposes of this Chapter` `s 783(a) an instrument of some other kind` FALSE EQUALS JUST FALSE
-- s 783(b) title includes any legal or equitable interest; (c) a transfer by way of security; (d) bearer securities, without delivery
#ASSERT `s 783(b) the interest counts as title to securities` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 783(b) the interest counts as title to securities` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 783(b) the interest counts as title to securities` FALSE FALSE EQUALS NOTHING
#ASSERT `s 783(c) the transfer counts as a transfer of title` TRUE EQUALS JUST TRUE
#ASSERT `s 783(c) the transfer counts as a transfer of title` FALSE EQUALS NOTHING
#ASSERT `s 783(d) the transfer counts as a transfer without a written instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 783(d) the transfer counts as a transfer without a written instrument` TRUE FALSE EQUALS NOTHING
#ASSERT `s 783(d) the transfer counts as a transfer without a written instrument` FALSE TRUE EQUALS NOTHING
-- s 790 Chapter 3 of Part 3 applies to a resolution passed by virtue of regulations under this Chapter
#ASSERT `s 790 Chapter 3 of Part 3 applies to the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 790 Chapter 3 of Part 3 applies to the resolution` FALSE EQUALS NOTHING
