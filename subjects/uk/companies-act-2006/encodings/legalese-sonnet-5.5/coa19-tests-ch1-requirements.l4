#ASSERT `s 866(2) the instrument may be sent for registration under section 860 even if further proceedings are necessary` FALSE EQUALS JUST FALSE
#ASSERT `s 867(1) subsection (2) applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 867(1) subsection (2) applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 867(1) subsection (2) applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 867(2) the delivery has the same effect as the delivery of the instrument itself` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 867(2) the delivery has the same effect as the delivery of the instrument itself` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 867(2) the delivery has the same effect as the delivery of the instrument itself` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 867(2) the delivery has the same effect as the delivery of the instrument itself` NOTHING TRUE EQUALS NOTHING

§§ `s 868 Northern Ireland: registration of certain charges etc. affecting land`
#ASSERT `s 868(1) the Registrar of Titles must cause two copies to be delivered to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 868(1) the Registrar of Titles must cause two copies to be delivered to the registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 868(2) the Registrar of Deeds must cause two copies of the order to be delivered to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 868(2) the Registrar of Deeds must cause two copies of the order to be delivered to the registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 868(3)(a) the registrar must register one of the copies in accordance with section 869` TRUE EQUALS JUST TRUE
#ASSERT `s 868(3)(a) the registrar must register one of the copies in accordance with section 869` FALSE EQUALS JUST FALSE
-- (3)(b) not later than 7 days from the date of delivery: delivery on 3 March 2025 gives 10 March 2025; delivery on 28 February 2025 gives 7 March 2025
#ASSERT `s 868(3)(b) the last day on which the registrar must cause the other copy and the certificate of registration to be sent to the company` (Date 3 3 2025) EQUALS Date 10 3 2025
#ASSERT `s 868(3)(b) the last day on which the registrar must cause the other copy and the certificate of registration to be sent to the company` (Date 28 2 2025) EQUALS Date 7 3 2025
#ASSERT `s 868(4) the Registrar of Titles or the Registrar of Deeds must cause a certified copy of the certificate of satisfaction to be delivered to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 868(4) the Registrar of Titles or the Registrar of Deeds must cause a certified copy of the certificate of satisfaction to be delivered to the registrar` FALSE EQUALS JUST FALSE
-- (5) the defined expressions, as the section words them
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) the 1981 Order` EQUALS "the Judgments Enforcement (Northern Ireland) Order 1981 (S.I. 1981/226 (N.I. 6))"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) the Registrar of Deeds` EQUALS "the registrar appointed under the Registration of Deeds Act (Northern Ireland) 1970 (c. 25)"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) Registry of Deeds` EQUALS "the same meaning as in the Registration of Deeds Acts"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) Registration of Deeds Acts` EQUALS "the Registration of Deeds Act (Northern Ireland) 1970 and every statutory provision for the time being in force amending that Act"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) the Land Registry` EQUALS "to be construed in accordance with section 1 of the Land Registration Act (Northern Ireland) 1970 (c. 18)"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) the Registrar of Titles` EQUALS "to be construed in accordance with section 1 of the Land Registration Act (Northern Ireland) 1970 (c. 18)"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) registered land` EQUALS "the same meaning as in Part 3 of the Land Registration Act (Northern Ireland) 1970"
#ASSERT `s 868(5) the meaning the section gives the expression` `s 868(5) unregistered land` EQUALS "the same meaning as in Part 3 of the Land Registration Act (Northern Ireland) 1970"
