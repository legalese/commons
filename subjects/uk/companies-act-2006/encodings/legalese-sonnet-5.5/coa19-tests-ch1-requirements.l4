IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa19-nouns`
IMPORT `coa19-ch1-requirements`

-- coa19-tests-ch1-requirements.l4: tests for coa19-ch1-requirements.l4 (ss 860 to 868).
-- Every expected value is written from the text of the section named in the comment above it, not from the code's output.

§ `Tests: ss 860 to 868`

§§ `s 861(5) definitions`
-- "company" means a company registered in England and Wales or in Northern Ireland
#ASSERT `s 861(5) the body is a company` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 861(5) the body is a company` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 861(5) the body is a company` `Scotland` EQUALS JUST FALSE
-- "charge" includes mortgage
#ASSERT `s 861(5) the arrangement is a charge` TRUE EQUALS JUST TRUE
#ASSERT `s 861(5) the arrangement is a charge` FALSE EQUALS NOTHING

§§ `s 860 Charges created by a company`
-- (7) the nine kinds, in the order of the record: land, rent charge, bill of sale, debentures, uncalled share capital, calls, book debts, floating, ship or aircraft, goodwill or IP
`s 860 test: land` MEANS `s 860(7) what the charge is` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 860 test: rent charge on land` MEANS `s 860(7) what the charge is` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 860 test: bill of sale` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 860 test: securing debentures` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 860 test: uncalled share capital` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 860 test: calls made but not paid` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`s 860 test: book debts` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`s 860 test: floating charge` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`s 860 test: ship or aircraft` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`s 860 test: goodwill or intellectual property` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`s 860 test: none of the listed kinds` MEANS `s 860(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: land` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: bill of sale` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: securing debentures` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: uncalled share capital` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: calls made but not paid` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: book debts` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: floating charge` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: ship or aircraft` EQUALS JUST TRUE
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: goodwill or intellectual property` EQUALS JUST TRUE
-- a charge on land "other than a charge for any rent or other periodical sum issuing out of land" is not within (a); the list is not closed, so the text does not decide
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: rent charge on land` EQUALS NOTHING
#ASSERT `s 860(7) the charge is one to which section 860 applies` `s 860 test: none of the listed kinds` EQUALS NOTHING
-- (1) the duty of a company registered in England and Wales or Northern Ireland that creates a charge to which the section applies
#ASSERT `s 860(1) the company must deliver the prescribed particulars and the instrument to the registrar` `England and Wales` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 860(1) the company must deliver the prescribed particulars and the instrument to the registrar` `Northern Ireland` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 860(1) the company must deliver the prescribed particulars and the instrument to the registrar` `Scotland` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 860(1) the company must deliver the prescribed particulars and the instrument to the registrar` `England and Wales` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 860(1) the company must deliver the prescribed particulars and the instrument to the registrar` `England and Wales` TRUE NOTHING EQUALS NOTHING
-- (2) registration may instead be effected on the application of a person interested
#ASSERT `s 860(2) registration may be effected on the application of the person` TRUE EQUALS JUST TRUE
#ASSERT `s 860(2) registration may be effected on the application of the person` FALSE EQUALS NOTHING
-- (3) a person other than the company who effects registration may recover the fees properly paid
#ASSERT `s 860(3) the person is entitled to recover from the company the fees properly paid` TRUE EQUALS JUST TRUE
#ASSERT `s 860(3) the person is entitled to recover from the company the fees properly paid` FALSE EQUALS JUST FALSE
#ASSERT `s 860(3) the amount the person is entitled to recover from the company` TRUE 23 EQUALS JUST 23
#ASSERT `s 860(3) the amount the person is entitled to recover from the company` FALSE 23 EQUALS NOTHING
-- (6) subsection (4) does not apply if registration has been effected on the application of some other person
#ASSERT `s 860(6) subsection (4) applies` TRUE EQUALS JUST FALSE
#ASSERT `s 860(6) subsection (4) applies` FALSE EQUALS NOTHING
-- (4) the offence: the company fails to comply with (1) (the particulars were not delivered before the end of the period); (6) takes it away
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 860(4) the company fails to comply with subsection (1), so that an offence is committed` NOTHING (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 860(4)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 860(4)(a) the company commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 860(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 860(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 860(4)(b) the officer commits an offence` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 860(4)(b) the officer commits an offence` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
-- (5) the penalties: on indictment a fine; on summary conviction a fine not exceeding the statutory maximum
#ASSERT (count (`s 860(5) the penalties for the offence`)) EQUALS 2
#ASSERT ((`s 860(5) the penalties for the offence`) EQUALS (LIST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE), (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)))

§§ `s 861 Charges which have to be registered: supplementary`
#ASSERT `s 861(1) the interest is an interest in land for the purposes of section 860(7)(a)` TRUE EQUALS JUST FALSE
#ASSERT `s 861(1) the interest is an interest in land for the purposes of section 860(7)(a)` FALSE EQUALS NOTHING
-- (2) immaterial where the land is situated: either way the place does not matter
#ASSERT `s 861(2) where the land subject to the charge is situated is material` TRUE EQUALS JUST FALSE
#ASSERT `s 861(2) where the land subject to the charge is situated is material` FALSE EQUALS JUST FALSE
#ASSERT `s 861(3) the deposit is a charge on those book debts for the purposes of section 860(7)(f)` TRUE EQUALS JUST FALSE
#ASSERT `s 861(3) the deposit is a charge on those book debts for the purposes of section 860(7)(f)` FALSE EQUALS NOTHING
#ASSERT `s 861(4) the right is intellectual property for the purposes of section 860(7)(i)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 861(4) the right is intellectual property for the purposes of section 860(7)(i)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 861(4) the right is intellectual property for the purposes of section 860(7)(i)` FALSE FALSE EQUALS JUST FALSE

§§ `s 862 Charges existing on property acquired`
#ASSERT `s 862(1) this section applies` `England and Wales` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 862(1) this section applies` `Northern Ireland` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 862(1) this section applies` `Scotland` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 862(1) this section applies` `England and Wales` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 862(1) this section applies` `England and Wales` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 862(1) this section applies` `England and Wales` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 862(2) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 862(2) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 862(2) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` NOTHING EQUALS NOTHING
-- (4) default in complying: not delivered before the end of the period
#ASSERT `s 862(4) default is made in complying with this section, so that an offence is committed` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 862(4) default is made in complying with this section, so that an offence is committed` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 862(4) default is made in complying with this section, so that an offence is committed` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 862(4) default is made in complying with this section, so that an offence is committed` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 862(4) default is made in complying with this section, so that an offence is committed` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 862(4)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 862(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 862(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT (count (`s 862(5) the penalties for the offence`)) EQUALS 2

§§ `s 863 Charge in series of debentures`
-- (2) the required particulars: total amount; resolution dates; covering deed's date if any; description; trustees' names if any
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 863(2) the particulars given are the required particulars` FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 863(2) the particulars given are the required particulars` TRUE TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- (1) delivery of the required particulars with the deed (or one debenture) in time is sufficient for s 860(1)
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 863(1) delivery of the particulars with the deed or one debenture is sufficient for section 860(1)` NOTHING TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 863(3) particulars of the date and amount of each issue must be sent to the registrar` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 863(3) particulars of the date and amount of each issue must be sent to the registrar` FALSE EQUALS JUST FALSE; s 863(3): the duty is laid on issues of a series of the kind in subsection (1); the text says nothing of other issues, so NOTHING
#ASSERT `s 863(3) particulars of the date and amount of each issue must be sent to the registrar` FALSE EQUALS NOTHING
#ASSERT `s 863(4) the failure to comply with subsection (3) affects the validity of the debentures issued` TRUE EQUALS JUST FALSE
#ASSERT `s 863(4) the failure to comply with subsection (3) affects the validity of the debentures issued` FALSE EQUALS NOTHING
#ASSERT `s 863(5) subsections (2) to (6) of section 860 apply to the registration of the series of debentures` TRUE EQUALS JUST TRUE
#ASSERT `s 863(5) subsections (2) to (6) of section 860 apply to the registration of the series of debentures` FALSE EQUALS NOTHING

§§ `s 864 Additional registration requirement for commission etc in relation to debentures`
#ASSERT `s 864(1) the particulars must include the amount or rate per cent. of the commission, discount or allowance` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 864(1) the particulars must include the amount or rate per cent. of the commission, discount or allowance` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 864(1) the particulars must include the amount or rate per cent. of the commission, discount or allowance` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 864(1) the particulars must include the amount or rate per cent. of the commission, discount or allowance` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 864(2) the deposit is treated as the issue of debentures at a discount` TRUE EQUALS JUST FALSE
#ASSERT `s 864(2) the deposit is treated as the issue of debentures at a discount` FALSE EQUALS NOTHING
#ASSERT `s 864(3) the failure to comply with section 864 affects the validity of the debentures issued` TRUE EQUALS JUST FALSE
#ASSERT `s 864(3) the failure to comply with section 864 affects the validity of the debentures issued` FALSE EQUALS NOTHING

§§ `s 865 Endorsement of certificate on debentures`
-- (2) a debenture issued before the charge was created is not covered
#ASSERT `s 865(2) the company is required to cause a copy of the certificate to be endorsed on the debenture` TRUE EQUALS JUST FALSE
#ASSERT `s 865(2) the company is required to cause a copy of the certificate to be endorsed on the debenture` FALSE EQUALS NOTHING
-- (1) every debenture issued by the company whose payment is secured by the registered charge
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) FALSE TRUE NOTHING EQUALS JUST FALSE; s 865(1): the duty is laid on debentures issued by the company and secured by the charge; the text says nothing of another debenture, so NOTHING
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) FALSE TRUE NOTHING EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) TRUE FALSE NOTHING EQUALS JUST FALSE; s 865(1): the duty is laid on debentures issued by the company and secured by the charge; the text says nothing of another debenture, so NOTHING
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST TRUE) TRUE FALSE NOTHING EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST FALSE) TRUE TRUE NOTHING EQUALS JUST FALSE; s 865(1): the duty is laid on debentures and certificates of debenture stock; the text says nothing of another instrument, so NOTHING
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` (JUST FALSE) TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 865(1) the company must cause a copy of the certificate of registration to be endorsed on the debenture` NOTHING TRUE TRUE NOTHING EQUALS NOTHING
-- (3) the offence: knowingly and wilfully authorising or permitting delivery of a debenture that should carry the copy but does not
#ASSERT `s 865(3) the person commits an offence` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 865(3) the person commits an offence` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 865(3) the person commits an offence` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 865(3) the person commits an offence` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 865(3) the person commits an offence` TRUE NOTHING FALSE EQUALS NOTHING
-- (4) the penalty: summary conviction, level 3, no daily default fine
#ASSERT (`s 865(4) the penalty for the offence`'s `fine not exceeding`) EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 865(4) the penalty for the offence`'s `daily default fine for continued contravention`) EQUALS NOTHING
#ASSERT (`s 865(4) the penalty for the offence`'s `how convicted`) EQUALS `on summary conviction`

§§ `ss 866 and 867 Charges in other jurisdictions`
#ASSERT `s 866(1) the delivery of a verified copy has the same effect as the delivery of the instrument itself` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 866(1) the delivery of a verified copy has the same effect as the delivery of the instrument itself` TRUE FALSE EQUALS NOTHING
#ASSERT `s 866(1) the delivery of a verified copy has the same effect as the delivery of the instrument itself` FALSE TRUE EQUALS JUST FALSE
