IMPORT prelude
IMPORT daydate
IMPORT `coa28-part46`
IMPORT `coa28-part44`

-- coa28-tests-part44.l4: tests for coa28-part44.l4 (ss 1274-1283). Every expected value was decided by reading the
-- section named beside it, before running; none is copied from the encoding's output.

-- ---- s 1274(3): the definitions inserted into section 16(5) of the 2004 Act
#ASSERT `s 1274(3) the body is a professional actuarial body` `s 1274(3)(a) the Institute of Actuaries` EQUALS JUST TRUE
#ASSERT `s 1274(3) the body is a professional actuarial body` `s 1274(3)(b) the Faculty of Actuaries in Scotland` EQUALS JUST TRUE
#ASSERT `s 1274(3) the body is a professional actuarial body` `s 1274(3) another body` EQUALS JUST FALSE
-- columns: a member of the body; not a member but subject to its rules in performing actuarial functions
#ASSERT `s 1274(3) the person is a member of a professional actuarial body` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1274(3) the person is a member of a professional actuarial body` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1274(3) the person is a member of a professional actuarial body` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1274(3) the function is a regulatory function in relation to professional actuarial bodies` `s 1274(3)(a) investigatory or disciplinary functions exercised by such bodies in relation to the performance by their members of actuarial functions` EQUALS JUST TRUE
#ASSERT `s 1274(3) the function is a regulatory function in relation to professional actuarial bodies` `s 1274(3)(b) the setting by such bodies of standards in relation to the performance by their members of actuarial functions` EQUALS JUST TRUE
#ASSERT `s 1274(3) the function is a regulatory function in relation to professional actuarial bodies` `s 1274(3)(c) the determining by such bodies of requirements in relation to the education and training of their members` EQUALS JUST TRUE
#ASSERT `s 1274(3) the function is a regulatory function in relation to professional actuarial bodies` `s 1274(3) another function` EQUALS JUST FALSE

-- ---- s 1275
-- (3A): an administrator of a public service pension scheme, or a trustee or manager of an occupational or personal pension scheme
#ASSERT `s 1275(3) the person is within subsection (3A) of section 17 of the 2004 Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1275(3) the person is within subsection (3A) of section 17 of the 2004 Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1275(3) the person is within subsection (3A) of section 17 of the 2004 Act` FALSE FALSE EQUALS NOTHING
-- (13): a draft of regulations to which subsection (10) applies that would be a hybrid instrument proceeds as if it were not
#ASSERT `s 1275(5) the draft is to proceed in that House as if it were not a hybrid instrument` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1275(5) the draft is to proceed in that House as if it were not a hybrid instrument` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1275(5) the draft is to proceed in that House as if it were not a hybrid instrument` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1275(6) the amendments have effect in relation to the exercise of the power` TRUE EQUALS JUST TRUE
#ASSERT `s 1275(6) the amendments have effect in relation to the exercise of the power` FALSE EQUALS NOTHING

-- ---- s 1276
#ASSERT `s 1276(2) the matter is one to which subsection (2)(a) to (t) of section 16 of the 2004 Act is read as referring in Scotland` TRUE EQUALS JUST TRUE
#ASSERT `s 1276(2) the matter is one to which subsection (2)(a) to (t) of section 16 of the 2004 Act is read as referring in Scotland` FALSE EQUALS JUST FALSE
#ASSERT `s 1276(4)(c) the instrument is the 1986 Order` TRUE EQUALS JUST TRUE
#ASSERT `s 1276(4)(c) the instrument is the 1986 Order` FALSE EQUALS JUST FALSE

-- ---- s 1277
-- (3)(a): delegated authority, or specified in the regulations
#ASSERT `s 1277(3)(a) the person is a person acting on behalf of the institution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1277(3)(a) the person is a person acting on behalf of the institution` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1277(3)(a) the person is a person acting on behalf of the institution` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1277(3)(b) the matter is specified for the purposes of sections 1277 to 1280` TRUE EQUALS JUST TRUE
#ASSERT `s 1277(3)(b) the matter is specified for the purposes of sections 1277 to 1280` FALSE EQUALS JUST FALSE
-- (4): columns: the obligation is imposed by regulations under s 1277; a person to whom the information should have been provided; a specified regulatory authority
#ASSERT `s 1277(4) the person may bring civil proceedings to enforce the obligation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1277(4) the person may bring civil proceedings to enforce the obligation` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1277(4) the person may bring civil proceedings to enforce the obligation` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1277(4) the person may bring civil proceedings to enforce the obligation` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1277(6) the procedure for regulations under section 1277` EQUALS `s 1290 affirmative resolution procedure`
-- s 1278(1): columns: (a) unit trust scheme with an order under s 243; (b) open-ended investment company; (c) approved investment trust; (d) pension scheme; (e) long-term insurance undertaking
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1278(1) the institution is one to which section 1277 applies` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1278(3) the regulations meet the requirement to specify by whom the duty is to be fulfilled` TRUE EQUALS JUST TRUE
#ASSERT `s 1278(3) the regulations meet the requirement to specify by whom the duty is to be fulfilled` FALSE EQUALS JUST FALSE
-- s 1279
#ASSERT `s 1279(2) the institution has an interest in the shares` TRUE EQUALS JUST TRUE
#ASSERT `s 1279(2) the institution has an interest in the shares` FALSE EQUALS JUST FALSE
-- a depositary certificate: rights (other than options) in respect of shares held by another person, transferable without that person's consent
#ASSERT `s 1279(2) the instrument is a depositary certificate` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1279(2) the instrument is a depositary certificate` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1279(2) the instrument is a depositary certificate` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1279(2) the instrument is a depositary certificate` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1279(4) the scheme or vehicle is taken to have an interest in the shares` TRUE EQUALS JUST TRUE
#ASSERT `s 1279(4) the scheme or vehicle is taken to have an interest in the shares` FALSE EQUALS JUST FALSE
-- (3): the institution has an interest in a specified scheme or vehicle; that scheme or vehicle has or is taken to have an interest
#ASSERT `s 1279(3) the institution is taken to have an interest in the shares` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1279(3) the institution is taken to have an interest in the shares` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1279(3) the institution is taken to have an interest in the shares` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1279(3) the institution is taken to have an interest in the shares` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (1): shares of a description traded on a specified market, in which the institution has or is taken to have an interest
#ASSERT `s 1279(1) the shares are shares to which section 1277 applies` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1279(1) the shares are shares to which section 1277 applies` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1279(1) the shares are shares to which section 1277 applies` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1279(1) the shares are shares to which section 1277 applies` TRUE NOTHING EQUALS NOTHING
-- s 1280
#ASSERT `s 1280(5)(b) the information is information given in aggregated form` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1280(5)(b) the information is information given in aggregated form` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1280(5)(b) the information is information given in aggregated form` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1280(5)(b) the information is information given in aggregated form` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1280(6) the reference to instructions in section 1280 covers the instruction` TRUE EQUALS JUST TRUE
#ASSERT `s 1280(6) the reference to instructions in section 1280 covers the instruction` FALSE EQUALS NOTHING

-- ---- s 1281 (section 241A of the Enterprise Act 2002)
-- (2): the excluded information
#ASSERT `s 1281 241A(2) subsection (1) does not apply to the information` `s 1281 241A(2)(a) information which comes to a public authority in connection with an investigation under Part 4, 5 or 6 of the 1973 Act or under section 11 of the Competition Act 1980` EQUALS JUST TRUE
#ASSERT `s 1281 241A(2) subsection (1) does not apply to the information` `s 1281 241A(2)(b) competition information within the meaning of section 351 of the Financial Services and Markets Act 2000` EQUALS JUST TRUE
#ASSERT `s 1281 241A(2) subsection (1) does not apply to the information` `s 1281 241A(2)(c) information which comes to a public authority in connection with an investigation under Part 3 or 4 or section 174 of the Enterprise Act 2002` EQUALS JUST TRUE
#ASSERT `s 1281 241A(2) subsection (1) does not apply to the information` `s 1281 241A(2)(d) information which comes to a public authority in connection with an investigation under the Competition Act 1998` EQUALS JUST TRUE
#ASSERT `s 1281 241A(2) subsection (1) does not apply to the information` `s 1281 241A(2) any other information` EQUALS NOTHING
#ASSERT `s 1281 241A(3) the information or proceedings are prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 1281 241A(3) the information or proceedings are prescribed` FALSE EQUALS JUST FALSE
-- (1): columns: a public authority holding prescribed information to which s 237 applies; the purpose; (2) excludes the information
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` TRUE `s 1281 241A(1)(a) the purposes of, or in connection with, prescribed civil proceedings (including prospective proceedings) in the United Kingdom or elsewhere` NOTHING EQUALS JUST TRUE
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` TRUE `s 1281 241A(1)(b) the purposes of obtaining legal advice in relation to such proceedings` NOTHING EQUALS JUST TRUE
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` TRUE `s 1281 241A(1)(c) otherwise for the purposes of establishing, enforcing or defending legal rights that are or may be the subject of such proceedings` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` TRUE `s 1281 241A(1)(a) the purposes of, or in connection with, prescribed civil proceedings (including prospective proceedings) in the United Kingdom or elsewhere` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` TRUE `s 1281 241A(1) any other purpose` NOTHING EQUALS NOTHING
#ASSERT `s 1281 241A(1) the public authority may disclose the information to any person` FALSE `s 1281 241A(1)(a) the purposes of, or in connection with, prescribed civil proceedings (including prospective proceedings) in the United Kingdom or elsewhere` NOTHING EQUALS NOTHING
#ASSERT `s 1281 241A(4)(c) the procedure for an order under section 241A` EQUALS `s 1289 negative resolution procedure`
-- (5): columns: the information was disclosed under s 241A; the person is the person to whom it was disclosed; the purpose is one specified in subsection (1)
#ASSERT `s 1281 241A(5) the person is barred from using the information for the purpose` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1281 241A(5) the person is barred from using the information for the purpose` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1281 241A(5) the person is barred from using the information for the purpose` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1281 241A(5) the person is barred from using the information for the purpose` TRUE FALSE FALSE EQUALS NOTHING
-- The same prohibition as a regulative rule: no event leaves the prohibition standing; the forbidden use is a breach.
-- (A DEONTIC value cannot be compared in an #ASSERT on the stable binary; the outcomes are read from the trace output.)
#TRACE `s 1281 241A(5) the recipient's prohibition on use` AT 0 WITH
#TRACE `s 1281 241A(5) the recipient's prohibition on use` AT 0 WITH
    PARTY `s 1281 241A(5) the person to whom the information is disclosed` DOES `s 1281 241A(5) uses the information for a purpose other than those specified in subsection (1)` AT 3

-- ---- s 1282 (section 176ZA of the Insolvency Act 1986; Article 150ZA of the Insolvency (Northern Ireland) Order 1989)
-- assets available: 500 before the exclusion, 100 made available under section 176A(2)(a): 400 available; an exclusion larger than the assets leaves nothing
#ASSERT `s 1282(1) 176ZA(2)(a) the assets of the company available for payment of general creditors` 500 100 EQUALS 400
#ASSERT `s 1282(1) 176ZA(2)(a) the assets of the company available for payment of general creditors` 50 100 EQUALS 0
#ASSERT `s 1282(2) 150ZA(2)(a) the assets of the company available for payment of general creditors` 500 100 EQUALS 400
-- expenses of 700 against 400 available: 300 has priority; expenses within the assets: none
#ASSERT `s 1282(1) 176ZA(1) the amount of the expenses that has priority over floating charge claims` 700 400 EQUALS 300
#ASSERT `s 1282(1) 176ZA(1) the amount of the expenses that has priority over floating charge claims` 300 400 EQUALS 0
#ASSERT `s 1282(1) 176ZA(1) the amount of the expenses that has priority over floating charge claims` 400 400 EQUALS 0
#ASSERT `s 1282(2) 150ZA(1) the amount of the expenses that has priority over floating charge claims` 700 400 EQUALS 300
-- columns: the winding up is in England and Wales; the assets available are insufficient
#ASSERT `s 1282(1) 176ZA(1) the expenses of winding up have priority over claims to property comprised in or subject to a floating charge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1282(1) 176ZA(1) the expenses of winding up have priority over claims to property comprised in or subject to a floating charge` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1282(1) 176ZA(1) the expenses of winding up have priority over claims to property comprised in or subject to a floating charge` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1282(2) 150ZA(1) the expenses of winding up have priority over claims to property comprised in or subject to a floating charge` TRUE EQUALS JUST TRUE
#ASSERT `s 1282(2) 150ZA(1) the expenses of winding up have priority over claims to property comprised in or subject to a floating charge` FALSE EQUALS JUST FALSE
#ASSERT `s 1282(1) 176ZA(2)(b) the claim is a claim to property comprised in or subject to a floating charge` `s 1282 176ZA(2)(b)(i) a holder of debentures secured by, or a holder of, the floating charge` EQUALS JUST TRUE
#ASSERT `s 1282(1) 176ZA(2)(b) the claim is a claim to property comprised in or subject to a floating charge` `s 1282 176ZA(2)(b)(ii) a preferential creditor entitled to be paid out of that property in priority to them` EQUALS JUST TRUE
#ASSERT `s 1282(1) 176ZA(2)(b) the claim is a claim to property comprised in or subject to a floating charge` `s 1282 another claimant` EQUALS NOTHING
#ASSERT `s 1282(2) 150ZA(2)(b) the claim is a claim to property comprised in or subject to a floating charge` `s 1282 176ZA(2)(b)(i) a holder of debentures secured by, or a holder of, the floating charge` EQUALS JUST TRUE
#ASSERT `s 1282(2) 150ZA(2)(b) the claim is a claim to property comprised in or subject to a floating charge` `s 1282 another claimant` EQUALS NOTHING
#ASSERT `s 1282(1) 176ZA(4) the expense is an expense of the winding up` TRUE EQUALS JUST TRUE
#ASSERT `s 1282(1) 176ZA(4) the expense is an expense of the winding up` FALSE EQUALS NOTHING
#ASSERT `s 1282(2) 150ZA(4) the expense is an expense of the winding up` TRUE EQUALS JUST TRUE
#ASSERT `s 1282(2) 150ZA(4) the expense is an expense of the winding up` FALSE EQUALS NOTHING

-- ---- s 1283: columns: a commonhold association alters its memorandum or articles; at a time when the land specified in its memorandum is commonhold land
#ASSERT `s 1283 paragraph 3(1) of Schedule 3 to the Commonhold and Leasehold Reform Act 2002 applies to the alteration` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1283 paragraph 3(1) of Schedule 3 to the Commonhold and Leasehold Reform Act 2002 applies to the alteration` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1283 paragraph 3(1) of Schedule 3 to the Commonhold and Leasehold Reform Act 2002 applies to the alteration` FALSE TRUE EQUALS JUST FALSE
