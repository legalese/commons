IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa26-support`
IMPORT `coa26-ch3b`

-- Tests for coa26-ch3b.l4 (ss 1232-1238). Expected values are written by hand from the text.

-- s 1232(1): the power reaches the named body, for requirement (a) or (b); anything else is outside the grant. order: body answer, (a), (b)
#ASSERT `s 1232(1) the Independent Supervisor may require the body to notify or give information` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1232(1) the Independent Supervisor may require the body to notify or give information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1232(1) the Independent Supervisor may require the body to notify or give information` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1232(1) the Independent Supervisor may require the body to notify or give information` FALSE TRUE TRUE EQUALS NOTHING
-- s 1232(2): the requirement must be reasonable
#ASSERT `s 1232(2) the notice or information required is within subsection (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 1232(2) the notice or information required is within subsection (2)` FALSE EQUALS JUST FALSE
-- s 1232(3)
#ASSERT `s 1232(3) the Independent Supervisor may require the information to be given in a specified form or verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1232(3) the Independent Supervisor may require the information to be given in a specified form or verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1232(3) the Independent Supervisor may require the information to be given in a specified form or verified in a specified manner` FALSE TRUE EQUALS NOTHING
-- s 1232(4): in writing unless another manner is specified or approved. order: required under this section, other manner specified or approved
#ASSERT `s 1232(4) the notice or information must be given in writing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1232(4) the notice or information must be given in writing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1232(4) the notice or information must be given in writing` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1232(4) the notice or information must be given in writing` FALSE TRUE EQUALS NOTHING
-- s 1233(1). order: the person is within the persons named (MAYBE), the requirement is by notice in writing, the information is reasonably required
#ASSERT `s 1233(1) the Independent Supervisor may by notice in writing require the person to give the information` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1233(1) the Independent Supervisor may by notice in writing require the person to give the information` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 1233(1) the Independent Supervisor may by notice in writing require the person to give the information` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 1233(1) the Independent Supervisor may by notice in writing require the person to give the information` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1233(1) the Independent Supervisor may by notice in writing require the person to give the information` NOTHING TRUE TRUE EQUALS NOTHING
-- s 1233(2): a reasonable time and a specified manner of verification
#ASSERT `s 1233(2) the Independent Supervisor may require the information to be given within a reasonable time and verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1233(2) the Independent Supervisor may require the information to be given within a reasonable time and verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1233(2) the Independent Supervisor may require the information to be given within a reasonable time and verified in a specified manner` FALSE TRUE EQUALS NOTHING

-- s 1234(1)
#ASSERT `s 1234(1) the Independent Supervisor may issue the notice` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1234(1) the Independent Supervisor may issue the notice` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(1) the Independent Supervisor may issue the notice` FALSE FALSE EQUALS NOTHING
-- s 1234(2)
#ASSERT `s 1234(2) the Independent Supervisor has had regard to the matters in subsection (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(2) the Independent Supervisor has had regard to the matters in subsection (2)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1234(2) the Independent Supervisor has had regard to the matters in subsection (2)` FALSE TRUE EQUALS JUST FALSE
-- s 1234(3): in writing; states the date; the date is after the period of three months beginning with the date of issue.
-- order: in writing, states the date, date of issue, date it takes effect
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE TRUE (Date 10 1 2027) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE TRUE (Date 10 1 2027) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE TRUE (Date 10 1 2027) (Date 11 4 2027) EQUALS JUST TRUE
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE TRUE (Date 15 11 2026) (Date 15 2 2027) EQUALS JUST TRUE
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE TRUE (Date 15 11 2026) (Date 14 2 2027) EQUALS JUST FALSE
#ASSERT `s 1234(3) the notice meets subsection (3)` FALSE TRUE (Date 10 1 2027) (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 1234(3) the notice meets subsection (3)` TRUE FALSE (Date 10 1 2027) (Date 10 4 2027) EQUALS JUST FALSE
-- s 1234(4), (5)
#ASSERT `s 1234(4) the Independent Supervisor has complied with the duty before issuing the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(4) the Independent Supervisor has complied with the duty before issuing the notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1234(4) the Independent Supervisor has complied with the duty before issuing the notice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1234(5) the notice of intention has the required content` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(5) the notice of intention has the required content` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1234(5) the notice of intention has the required content` FALSE TRUE EQUALS JUST FALSE
-- s 1234(7)
#ASSERT `s 1234(7) the person is within subsection (7)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1234(7) the person is within subsection (7)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(7) the person is within subsection (7)` FALSE FALSE EQUALS JUST FALSE
-- s 1234(6): three months beginning with the date of service or publication (10 January 2027: through 9 April 2027), or a longer period allowed.
-- order: within (7) (MAYBE), date of service or publication, day the representations are made, last day of any longer period allowed
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 10 1 2027) NOTHING EQUALS JUST TRUE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 9 4 2027) NOTHING EQUALS JUST TRUE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 10 4 2027) NOTHING EQUALS JUST FALSE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 9 1 2027) NOTHING EQUALS JUST FALSE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 30 4 2027) (JUST (Date 30 4 2027)) EQUALS JUST TRUE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST TRUE) (Date 10 1 2027) (Date 1 5 2027) (JUST (Date 30 4 2027)) EQUALS JUST FALSE
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` (JUST FALSE) (Date 10 1 2027) (Date 10 1 2027) NOTHING EQUALS NOTHING
#ASSERT `s 1234(6) the person may make written representations and, if desired, oral representations` NOTHING (Date 10 1 2027) (Date 10 1 2027) NOTHING EQUALS NOTHING
-- s 1234(8)
#ASSERT `s 1234(8) the Independent Supervisor has complied with the duty to have regard to the representations` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(8) the Independent Supervisor has complied with the duty to have regard to the representations` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1234(8) the Independent Supervisor has complied with the duty to have regard to the representations` FALSE TRUE EQUALS NOTHING
-- s 1234(9), (10), (11)
#ASSERT `s 1234(9) the Independent Supervisor may issue the notice without regard to the restriction in subsection (3)(b)` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1234(9) the Independent Supervisor may issue the notice without regard to the restriction in subsection (3)(b)` FALSE EQUALS JUST FALSE; name-test sweep: a grant named "may" whose own "if" gate fails is NOTHING (a grant limited by its own wording), the other reading being JUST FALSE (a failed "if" read as the text's own no), recorded as F25 in NOTES.md
#ASSERT `s 1234(9) the Independent Supervisor may issue the notice without regard to the restriction in subsection (3)(b)` FALSE EQUALS NOTHING
#ASSERT `s 1234(10) the Independent Supervisor has complied with the duty on issuing the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1234(10) the Independent Supervisor has complied with the duty on issuing the notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1234(10) the Independent Supervisor has complied with the duty on issuing the notice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1234(11) the person is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1234(11) the person is specified` FALSE EQUALS JUST FALSE

-- s 1235(1)
#ASSERT `s 1235(1) the Auditor General may act as statutory auditor of the audited person` TRUE EQUALS JUST FALSE
#ASSERT `s 1235(1) the Auditor General may act as statutory auditor of the audited person` FALSE EQUALS NOTHING
-- s 1235(2) as a decision function. order: holds office as a statutory auditor, a suspension notice takes effect during his term of office
#ASSERT `s 1235(2) the Auditor General must immediately resign and give notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1235(2) the Auditor General must immediately resign and give notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1235(2) the Auditor General must immediately resign and give notice` FALSE TRUE EQUALS JUST FALSE
-- s 1235(3)
#ASSERT `s 1235(3) the suspension notice makes the Auditor General ineligible for the purposes of section 1213` TRUE EQUALS JUST FALSE
#ASSERT `s 1235(3) the suspension notice makes the Auditor General ineligible for the purposes of section 1213` FALSE EQUALS NOTHING

-- s 1236
#ASSERT `s 1236(1) the Independent Supervisor may make an application to the court` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1236(1) the Independent Supervisor may make an application to the court` FALSE EQUALS JUST FALSE; name-test sweep: a grant named "may" whose own "if" gate fails is NOTHING (a grant limited by its own wording), the other reading being JUST FALSE (a failed "if" read as the text's own no), recorded as F26 in NOTES.md
#ASSERT `s 1236(1) the Independent Supervisor may make an application to the court` FALSE EQUALS NOTHING
#ASSERT `s 1236(2) the court may order the Auditor General to take such steps as the court directs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1236(2) the court may order the Auditor General to take such steps as the court directs` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1236(2) the court may order the Auditor General to take such steps as the court directs` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1236(3) the court is` FALSE EQUALS `s 1236(3) the High Court`
#ASSERT `s 1236(3) the court is` TRUE EQUALS `s 1236(3) the Court of Session`
-- s 1237
#ASSERT `s 1237(2) the proceedings are relevant proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 1237(2) the proceedings are relevant proceedings` FALSE EQUALS JUST FALSE
#ASSERT `s 1237(1) the proceedings may be brought by or against the Independent Supervisor in that name` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1237(1) the proceedings may be brought by or against the Independent Supervisor in that name` TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 1237(1) the proceedings may be brought by or against the Independent Supervisor in that name` TRUE (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1237(1) the proceedings may be brought by or against the Independent Supervisor in that name` FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 1237(3) the revoking order may make the provision with respect to pending proceedings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1237(3) the revoking order may make the provision with respect to pending proceedings` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1237(3) the revoking order may make the provision with respect to pending proceedings` FALSE TRUE EQUALS JUST FALSE

-- s 1235(1) and (2) as regulative rules (traced, outcomes recorded in NOTES.md)
#TRACE `s 1235(1) the prohibition on acting while a suspension notice has effect` TRUE AT 0 WITH
    PARTY Auditor DOES `s 1235(1) acts as statutory auditor of the audited person` AT 2
#TRACE `s 1235(1) the prohibition on acting while a suspension notice has effect` FALSE AT 0 WITH
    PARTY Auditor DOES `s 1235(1) acts as statutory auditor of the audited person` AT 2
#TRACE `s 1235(2) the duty of an Auditor General when a suspension notice takes effect` AT 0 WITH
    PARTY Auditor DOES `s 1235(2)(a) resigns his office with immediate effect` AT 0
    PARTY Auditor DOES `s 1235(2)(b) gives notice in writing that he has resigned by reason of his becoming ineligible` AT 0
#TRACE `s 1235(2) the duty of an Auditor General when a suspension notice takes effect` AT 0 WITH
    PARTY Auditor DOES `s 1235(2)(a) resigns his office with immediate effect` AT 0
    WAITUNTIL 2
#TRACE `s 1235(2) the duty of an Auditor General when a suspension notice takes effect` AT 0 WITH
    WAITUNTIL 1
