IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch7`

-- coa7-tests-ch7.l4: tests for coa7-ch7.l4 (Part 13 Chapter 7, ss 360 to 361 with 360A to 360C).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 7 (ss 360 to 361)`

-- s 360(1): the listed provisions; a provision outside the list is not decided
#ASSERT `s 360(1) the clear day rule applies for the purposes of the provision` "section 307(1) and (2)" EQUALS JUST TRUE
#ASSERT `s 360(1) the clear day rule applies for the purposes of the provision` "section 338(4)(d)(i)" EQUALS JUST TRUE
#ASSERT `s 360(1) the clear day rule applies for the purposes of the provision` "section 340B(2)(b)" EQUALS JUST TRUE
#ASSERT `s 360(1) the clear day rule applies for the purposes of the provision` "section 304" EQUALS NOTHING
-- s 360(2): the day of the meeting and the day notice is given are excluded. Notice on 1 March, meeting on 16 March: 14 clear days
#ASSERT `s 360(2) the clear days between the day the notice is given and the day of the meeting` (Date 1 3 2026) (Date 16 3 2026) EQUALS 14
#ASSERT `s 360(2) the period of the specified length is satisfied` 14 (Date 1 3 2026) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 360(2) the period of the specified length is satisfied` 14 (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 360(2) the period of the specified length is satisfied` 28 (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST TRUE
#ASSERT `s 360(2) the period of the specified length is satisfied` 28 (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST FALSE

-- s 360A(1)
#ASSERT `s 360A(1) this Part precludes the holding and conducting of the meeting in that way` TRUE EQUALS JUST FALSE
#ASSERT `s 360A(1) this Part precludes the holding and conducting of the meeting in that way` FALSE EQUALS NOTHING
-- s 360A(2): a traded company's electronic means may be made subject only to necessary and proportionate requirements
#ASSERT `s 360A(2) the use of electronic means may be made subject to the requirement or restriction` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 360A(2) the use of electronic means may be made subject to the requirement or restriction` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 360A(2) the use of electronic means may be made subject to the requirement or restriction` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 360A(2) the use of electronic means may be made subject to the requirement or restriction` FALSE TRUE TRUE EQUALS NOTHING
-- s 360A(3)
#ASSERT `s 360A(3) subsection (2) affects the company's power to require reasonable evidence of entitlement` TRUE EQUALS JUST FALSE
#ASSERT `s 360A(3) subsection (2) affects the company's power to require reasonable evidence of entitlement` FALSE EQUALS NOTHING

-- s 360AA(1): a traded company must confirm receipt of an electronic poll vote to the member, the proxy or the representative who cast it
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` TRUE TRUE `s 360AA(1)(a) the member` TRUE EQUALS JUST TRUE
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` TRUE TRUE `s 360AA(1)(b) the proxy` TRUE EQUALS JUST TRUE
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` TRUE TRUE `s 360AA(1)(c) the representative of a corporation under section 323(1)` TRUE EQUALS JUST TRUE
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` TRUE TRUE `s 360AA(1)(a) the member` FALSE EQUALS JUST FALSE
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` FALSE TRUE `s 360AA(1)(a) the member` TRUE EQUALS NOTHING
#ASSERT `s 360AA(1) the company has sent confirmation of receipt of the vote` TRUE FALSE `s 360AA(1)(a) the member` TRUE EQUALS NOTHING
-- s 360AA(2): the votes covered
#ASSERT `s 360AA(2) the vote is a vote under subsection (1)` `s 360AA(2)(a) at a meeting` EQUALS JUST TRUE
#ASSERT `s 360AA(2) the vote is a vote under subsection (1)` `s 360AA(2)(b) at an electronic meeting conducted in accordance with section 360A` EQUALS JUST TRUE
#ASSERT `s 360AA(2) the vote is a vote under subsection (1)` `s 360AA(2)(c) in advance of a meeting or electronic meeting (see section 322A)` EQUALS JUST TRUE
#ASSERT `s 360AA(2) the vote is a vote under subsection (1)` `s 360AA(2) somewhere else` EQUALS NOTHING

-- s 360B(3): the hours counted leave out hours of a day that is not a working day
#ASSERT `s 360B(3) the hours of the period that are counted` 48 0 EQUALS 48
#ASSERT `s 360B(3) the hours of the period that are counted` 72 24 EQUALS 48
-- s 360B(1)(a)
#ASSERT `s 360B(1)(a) the provision of the articles is void` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 360B(1)(a) the provision of the articles is void` TRUE FALSE EQUALS NOTHING
#ASSERT `s 360B(1)(a) the provision of the articles is void` FALSE TRUE EQUALS NOTHING
-- s 360B(1)(b)
#ASSERT `s 360B(1)(b) the provision of the articles is void` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 360B(1)(b) the provision of the articles is void` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 360B(1)(b) the provision of the articles is void` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 360B(1)(b) the provision of the articles is void` FALSE TRUE TRUE EQUALS NOTHING
-- s 360B(2): the right to vote is determined as at a time not more than 48 (working-day) hours before the meeting
#ASSERT `s 360B(2) the time determined by the company is one this subsection allows` TRUE 48 0 EQUALS JUST TRUE
#ASSERT `s 360B(2) the time determined by the company is one this subsection allows` TRUE 49 0 EQUALS JUST FALSE
#ASSERT `s 360B(2) the time determined by the company is one this subsection allows` TRUE 72 24 EQUALS JUST TRUE
#ASSERT `s 360B(2) the time determined by the company is one this subsection allows` TRUE 73 24 EQUALS JUST FALSE
#ASSERT `s 360B(2) the time determined by the company is one this subsection allows` FALSE 48 0 EQUALS NOTHING
-- s 360B(4)
#ASSERT `s 360B(4) this section does not affect the matter` `s 360B(4)(a)(i) the operation of Part 22 of this Act (information about interests in a company's shares)` EQUALS JUST TRUE
#ASSERT `s 360B(4) this section does not affect the matter` `s 360B(4)(a)(ii) the operation of Part 15 of the Companies Act 1985 (orders imposing restrictions on shares)` EQUALS JUST TRUE
#ASSERT `s 360B(4) this section does not affect the matter` `s 360B(4)(a)(iii) any provision in a company's articles relating to the application of any provision of either of those Parts` EQUALS JUST TRUE
#ASSERT `s 360B(4) this section does not affect the matter` `s 360B(4)(b) the validity of articles prescribed, or to the same effect as articles prescribed, under section 19 of this Act` EQUALS JUST TRUE
#ASSERT `s 360B(4) this section does not affect the matter` `s 360B(4) another matter` EQUALS NOTHING

-- s 360BA(2)(a): a request received no later than 30 days from the date of the meeting (1 March + 30 days is 31 March)
#ASSERT `s 360BA(2)(a) the request was received in time` (Date 1 3 2026) (Date 31 3 2026) EQUALS JUST TRUE
#ASSERT `s 360BA(2)(a) the request was received in time` (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- s 360BA(2)(b)
#ASSERT `s 360BA(2)(b) the member has no other reasonable means` TRUE EQUALS JUST FALSE
#ASSERT `s 360BA(2)(b) the member has no other reasonable means` FALSE EQUALS JUST TRUE
-- s 360BA(1)
#ASSERT `s 360BA(1) the company must provide the information to the member` TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 360BA(1) the company must provide the information to the member` TRUE TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 360BA(1) the company must provide the information to the member` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 360BA(1) the company must provide the information to the member` TRUE TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 360BA(1) the company must provide the information to the member` FALSE TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 360BA(1) the company must provide the information to the member` TRUE FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- s 360BA(3): 15 days beginning with the later first working day (10 March): the last day is 24 March
#ASSERT `s 360BA(3) the last day for providing the information` (Date 3 3 2026) (Date 10 3 2026) EQUALS Date 24 3 2026
#ASSERT `s 360BA(3) the last day for providing the information` (Date 10 3 2026) (Date 3 3 2026) EQUALS Date 24 3 2026
#ASSERT `s 360BA(3) the information was provided in time` (Date 24 3 2026) (Date 24 3 2026) EQUALS JUST TRUE
#ASSERT `s 360BA(3) the information was provided in time` (Date 24 3 2026) (Date 25 3 2026) EQUALS JUST FALSE

-- s 360C: a company any shares of which carry the right to vote AND are admitted to trading (the same shares)
#ASSERT `s 360C the company is a traded company` (LIST (`s 360C class of shares` OF TRUE, TRUE)) EQUALS JUST TRUE
#ASSERT `s 360C the company is a traded company` (LIST (`s 360C class of shares` OF TRUE, FALSE), (`s 360C class of shares` OF FALSE, TRUE)) EQUALS JUST FALSE
#ASSERT `s 360C the company is a traded company` (LIST (`s 360C class of shares` OF TRUE, FALSE), (`s 360C class of shares` OF TRUE, TRUE)) EQUALS JUST TRUE
#ASSERT `s 360C the company is a traded company` EMPTY EQUALS JUST FALSE
-- s 361: the meaning in Part 15 (s 385), taken as an input
#ASSERT `s 361 the company is a quoted company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 361 the company is a quoted company` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 361 the company is a quoted company` NOTHING EQUALS NOTHING
