IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-removal`

-- coa4-tests-removal.l4: tests for coa4-removal.l4 (ss 168 to 169A). Expected values are written from the text of the
-- section named beside each assertion, before the code was run.

-- s 168(1): arguments: s 282 ordinary resolution; the way it is passed; an agreement says the director may not be removed
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` (JUST TRUE) `at a meeting on a show of hands` FALSE EQUALS JUST TRUE
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` (JUST TRUE) `at a meeting on a poll` FALSE EQUALS JUST TRUE
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` (JUST TRUE) `at a meeting on a show of hands` TRUE EQUALS JUST TRUE
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` (JUST TRUE) `as a written resolution` FALSE EQUALS NOTHING
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` (JUST FALSE) `at a meeting on a poll` FALSE EQUALS NOTHING
#ASSERT `s 168(1) the company may by that resolution remove the director before the expiration of the director's period of office` NOTHING `at a meeting on a poll` FALSE EQUALS NOTHING
-- s 168(2)
#ASSERT `s 168(2) special notice is required of the resolution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(2) special notice is required of the resolution` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 168(2) special notice is required of the resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 168(2) special notice is required of the resolution` FALSE FALSE EQUALS NOTHING
-- s 168(3): a vacancy not filled at the meeting may be filled as a casual vacancy
#ASSERT `s 168(3) the vacancy may be filled as a casual vacancy` TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 168(3) the vacancy may be filled as a casual vacancy` TRUE TRUE EQUALS JUST FALSE; s 168(3) is a grant ("may be filled") behind an "if not filled at the meeting" gate: a vacancy that was filled is outside the grant, and the text does not say it may not be filled as a casual vacancy, so the answer is NOTHING (name-test sweep, F70)
#ASSERT `s 168(3) the vacancy may be filled as a casual vacancy` TRUE TRUE EQUALS NOTHING
#ASSERT `s 168(3) the vacancy may be filled as a casual vacancy` FALSE FALSE EQUALS NOTHING
-- s 168(4)
#ASSERT `s 168(4) the day on which the person appointed in place is treated as having become director, for the time at which a director is to retire` TRUE (Date 3 5 2020) EQUALS JUST (Date 3 5 2020)
#ASSERT `s 168(4) the day on which the person appointed in place is treated as having become director, for the time at which a director is to retire` FALSE (Date 3 5 2020) EQUALS NOTHING
-- s 168(5)
#ASSERT `s 168(5)(a) section 168 deprives the person removed of the compensation or damages` TRUE EQUALS JUST FALSE
#ASSERT `s 168(5)(a) section 168 deprives the person removed of the compensation or damages` FALSE EQUALS NOTHING
#ASSERT `s 168(5)(b) section 168 derogates from the power to remove the director that exists apart from the section` TRUE EQUALS JUST FALSE
#ASSERT `s 168(5)(b) section 168 derogates from the power to remove the director that exists apart from the section` FALSE EQUALS NOTHING
-- s 169(1): on receipt of the notice the company must forthwith send a copy to the director
#ASSERT `s 169(1) the company has complied with the duty to send a copy of the notice to the director concerned` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169(1) the company has complied with the duty to send a copy of the notice to the director concerned` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 169(1) the company has complied with the duty to send a copy of the notice to the director concerned` FALSE TRUE EQUALS NOTHING
#ASSERT `s 169(1) the company has complied with the duty to send a copy of the notice to the director concerned` FALSE FALSE EQUALS NOTHING
-- The regulative rule has a MUST and no deadline ("forthwith" gives no number of days). Read: with the event it is FULFILLED;
-- with no event the obligation stays standing (a residual MUST).
#TRACE `s 169(1) the company's duty to send a copy of the notice to the director concerned` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Director, "send a copy of the notice to the director concerned" AT 1
#TRACE `s 169(1) the company's duty to send a copy of the notice to the director concerned` AT 0 WITH
    (WAITUNTIL 5)

-- s 169(2): arguments: the resolution is to remove the director; the director is a member
#ASSERT `s 169(2) the director is entitled to be heard on the resolution at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169(2) the director is entitled to be heard on the resolution at the meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169(2) the director is entitled to be heard on the resolution at the meeting` FALSE TRUE EQUALS NOTHING
-- s 169(3): arguments: notice given; representations in writing; not over a reasonable length; requests notification; received too late
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 169(3) the company is obliged to state the fact of the representations and send a copy of them to the members` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 169(3)(a) the company has stated the fact of the representations in the notice of the resolution` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 169(3)(a) the company has stated the fact of the representations in the notice of the resolution` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 169(3)(a) the company has stated the fact of the representations in the notice of the resolution` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 169(3)(a) the company has stated the fact of the representations in the notice of the resolution` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 169(3)(b) the company has sent a copy of the representations to every member to whom notice of the meeting is sent` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 169(3)(b) the company has sent a copy of the representations to every member to whom notice of the meeting is sent` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 169(3)(b) the company has sent a copy of the representations to every member to whom notice of the meeting is sent` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 169(3)(b) the company has sent a copy of the representations to every member to whom notice of the meeting is sent` NOTHING FALSE EQUALS NOTHING
#TRACE `s 169(3) the company's duty to state the representations and send a copy of them` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Member, "state the fact of the representations in the notice of the resolution" AT 1
    PARTY Company DOES `Action of a party` OF Company, Member, "send a copy of the representations to every member to whom notice of the meeting is sent" AT 2

-- s 169(4): arguments: a copy is not sent as required by (3); because received too late or because of the company's default
#ASSERT `s 169(4) the director may require that the representations be read out at the meeting` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 169(4) the director may require that the representations be read out at the meeting` TRUE FALSE EQUALS JUST FALSE; s 169(4) is a grant ("may require") behind an "If a copy ... is not sent ... because received too late or because of the company's default" gate: when the gate fails the text does not say the director may not require it, so the answer is NOTHING (name-test sweep, F71)
#ASSERT `s 169(4) the director may require that the representations be read out at the meeting` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 169(4) the director may require that the representations be read out at the meeting` FALSE TRUE EQUALS JUST FALSE; s 169(4) is a grant ("may require") behind an "If a copy ... is not sent ... because received too late or because of the company's default" gate: when the gate fails the text does not say the director may not require it, so the answer is NOTHING (name-test sweep, F71)
#ASSERT `s 169(4) the director may require that the representations be read out at the meeting` FALSE TRUE EQUALS NOTHING
-- s 169(5), (6)
#ASSERT `s 169(5) copies need not be sent out and the representations need not be read out` TRUE EQUALS JUST TRUE
#ASSERT `s 169(5) copies need not be sent out and the representations need not be read out` FALSE EQUALS JUST FALSE
#ASSERT `s 169(6) the court may order the company's costs to be paid in whole or in part by the director` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169(6) the court may order the company's costs to be paid in whole or in part by the director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169(6) the court may order the company's costs to be paid in whole or in part by the director` FALSE FALSE EQUALS NOTHING
-- s 169A(1): arguments: appointed as a director; becomes disqualified (s 159A(2))
#ASSERT `s 169A(1) the person has ceased to hold office by virtue of the appointment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 169A(1) the person has ceased to hold office by virtue of the appointment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 169A(1) the person has ceased to hold office by virtue of the appointment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 169A(1) the person has ceased to hold office by virtue of the appointment` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 169A(2) section 169A leaves the person's liability unaffected` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169A(2) section 169A leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 169A(2) section 169A leaves the person's liability unaffected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 169A(2) section 169A leaves the person's liability unaffected` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 169A(3) the person is treated as a person who becomes disqualified` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169A(3) the person is treated as a person who becomes disqualified` TRUE FALSE EQUALS NOTHING
#ASSERT `s 169A(3) the person is treated as a person who becomes disqualified` FALSE TRUE EQUALS NOTHING
