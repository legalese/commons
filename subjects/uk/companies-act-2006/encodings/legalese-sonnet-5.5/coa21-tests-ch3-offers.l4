#ASSERT `s 988(3) the offeror has a substantial interest in the body corporate` FALSE 99 300 EQUALS JUST FALSE
#ASSERT `s 988(3) the offeror has a substantial interest in the body corporate` FALSE 0 0 EQUALS JUST FALSE
