IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa21-ch3-offers`

-- coa21-tests-ch3-offers.l4: tests for coa21-ch3-offers.l4 (Part 28, Chapter 3: ss 974 to 978 and 987 to 991).
-- Every expected value is written from the text of the section named beside it, before the run, and never copied from the code's output.

§ `Tests for Chapter 3, takeover offers, joint offers and interpretation`

-- s 991(1): the definitions.
#ASSERT `s 991(1) the company is the company for the purposes of Chapter 3` TRUE EQUALS JUST TRUE
#ASSERT `s 991(1) the company is the company for the purposes of Chapter 3` FALSE EQUALS JUST FALSE
-- the date of the offer: the publication date where published and no earlier notices; otherwise the date of the first notices.
#ASSERT `s 991(1) the date of the offer` TRUE (JUST (Date 10 3 2027)) FALSE (JUST (Date 9 3 2027)) EQUALS JUST (Date 10 3 2027)
#ASSERT `s 991(1) the date of the offer` TRUE (JUST (Date 10 3 2027)) TRUE (JUST (Date 9 3 2027)) EQUALS JUST (Date 9 3 2027)
#ASSERT `s 991(1) the date of the offer` FALSE NOTHING FALSE (JUST (Date 9 3 2027)) EQUALS JUST (Date 9 3 2027)
#ASSERT `s 991(1) the date of the offer` FALSE NOTHING FALSE NOTHING EQUALS NOTHING
#ASSERT `s 991(1) the shares are non-voting shares` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 991(1) the shares are non-voting shares` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 991(1) the shares are non-voting shares` NOTHING EQUALS NOTHING
#ASSERT `s 991(1) the rights are voting rights` TRUE EQUALS JUST TRUE
#ASSERT `s 991(1) the rights are voting rights` FALSE EQUALS JUST FALSE
#ASSERT `s 991(1) the shares are voting shares` TRUE EQUALS JUST TRUE
#ASSERT `s 991(1) the shares are voting shares` FALSE EQUALS JUST FALSE
#ASSERT `s 991(1) the person is the offeror` TRUE EQUALS JUST TRUE
#ASSERT `s 991(1) the person is the offeror` FALSE EQUALS JUST FALSE
-- s 991(2): unconditional contract.
#ASSERT `s 991(2) the person contracts unconditionally to acquire the shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 991(2) the person contracts unconditionally to acquire the shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 991(2) the person contracts unconditionally to acquire the shares` FALSE FALSE EQUALS JUST FALSE

-- s 989: convertible securities.
#ASSERT `s 989(1) the securities are treated as shares in the company` TRUE EQUALS JUST TRUE
#ASSERT `s 989(1) the securities are treated as shares in the company` FALSE EQUALS JUST FALSE
#ASSERT `s 989(2) subsection (1) requires the securities to be treated as shares of the same class` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 989(2) subsection (1) requires the securities to be treated as shares of the same class` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 989(2) subsection (1) requires the securities to be treated as shares of the same class` FALSE FALSE EQUALS NOTHING

-- s 990: debentures carrying voting rights.
#ASSERT `s 990(2) the company is one to which the subsection applies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 990(2) the company is one to which the subsection applies` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 990(2) the company is one to which the subsection applies` NOTHING EQUALS NOTHING
#ASSERT `s 990(1) the debentures are treated as shares in the company` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 990(1) the debentures are treated as shares in the company` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 990(1) the debentures are treated as shares in the company` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 990(3) the reference is read in relation to the debentures` (JUST TRUE) `s 990(3)(a) a reference to the holder of shares or a shareholder` EQUALS JUST TRUE
#ASSERT `s 990(3) the reference is read in relation to the debentures` (JUST TRUE) `s 990(3)(b) a reference to shares being allotted` EQUALS JUST TRUE
#ASSERT `s 990(3) the reference is read in relation to the debentures` (JUST TRUE) `s 990(3) another reference` EQUALS NOTHING
#ASSERT `s 990(3) the reference is read in relation to the debentures` (JUST FALSE) `s 990(3)(a) a reference to the holder of shares or a shareholder` EQUALS NOTHING

-- s 988(2): fellow subsidiary.
#ASSERT `s 988(2) the company is a fellow subsidiary of the other body corporate` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 988(2) the company is a fellow subsidiary of the other body corporate` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 988(2) the company is a fellow subsidiary of the other body corporate` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 988(2) the company is a fellow subsidiary of the other body corporate` (JUST TRUE) NOTHING EQUALS NOTHING
-- s 988(3): substantial interest: accustomed to act on his directions, or one-third or more of the voting power (boundary: 1 of 3).
