IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa14-nouns`
IMPORT `coa14-ch07-premiums`

-- coa14-tests-ch07.l4: tests for Chapter 7 (ss 610 to 616). EXPECTED VALUES ARE HAND-WRITTEN FROM THE TEXT, beside each
-- assertion; a failing assertion is a finding, never edited to match the code.

§ `Tests: Chapter 7 -- Share premiums`

§§ `s 610`
-- s 610(1) "If a company issues shares at a premium ... a sum equal to the aggregate amount or value of the premiums ... must be transferred"
#ASSERT `s 610(1) the company must transfer a sum to the share premium account` TRUE EQUALS JUST TRUE
#ASSERT `s 610(1) the company must transfer a sum to the share premium account` FALSE EQUALS JUST FALSE
#ASSERT `s 610(1) the sum that must be transferred to the share premium account` TRUE 500 EQUALS JUST 500
#ASSERT `s 610(1) the sum that must be transferred to the share premium account` FALSE 500 EQUALS NOTHING
-- s 610(2) write-offs: (a) expenses and (b) commission, of the issue of those shares
#ASSERT `s 610(2) the company may use the sum to write off the item` TRUE `s 610(2)(a) writing off the expenses of the issue of those shares` TRUE EQUALS JUST TRUE
#ASSERT `s 610(2) the company may use the sum to write off the item` TRUE `s 610(2)(b) writing off any commission paid on the issue of those shares` TRUE EQUALS JUST TRUE
#ASSERT `s 610(2) the company may use the sum to write off the item` TRUE `s 610(2)(a) writing off the expenses of the issue of those shares` FALSE EQUALS NOTHING
#ASSERT `s 610(2) the company may use the sum to write off the item` TRUE `s 610(2)(b) writing off any commission paid on the issue of those shares` FALSE EQUALS NOTHING
#ASSERT `s 610(2) the company may use the sum to write off the item` TRUE `s 610(2) some other use of the sum` TRUE EQUALS NOTHING
#ASSERT `s 610(2) the company may use the sum to write off the item` FALSE `s 610(2)(a) writing off the expenses of the issue of those shares` TRUE EQUALS JUST FALSE
-- s 610(3) bonus shares
#ASSERT `s 610(3) the company may use the share premium account to pay up the shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 610(3) the company may use the share premium account to pay up the shares` TRUE FALSE EQUALS NOTHING
#ASSERT `s 610(3) the company may use the share premium account to pay up the shares` FALSE TRUE EQUALS NOTHING
-- s 610(4) "Subject to subsections (2) and (3), the reduction provisions apply as if the account were paid up share capital"
#ASSERT `s 610(4) the reduction provisions treat the share premium account as paid up share capital` FALSE EQUALS JUST TRUE
#ASSERT `s 610(4) the reduction provisions treat the share premium account as paid up share capital` TRUE EQUALS NOTHING
-- s 610(5): premiums 1,000; no relief anywhere
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST FALSE) (JUST 300) (JUST FALSE) FALSE EQUALS JUST 1000
-- s 611 applies, minimum premium value 300 < 1,000: only 300 need be transferred
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST TRUE) (JUST 300) (JUST FALSE) FALSE EQUALS JUST 300
-- minimum premium value 1,500 exceeds the premiums 1,000: nothing in excess of 1,500 is required, so the s 610 sum of 1,000 stands
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST TRUE) (JUST 1500) (JUST FALSE) FALSE EQUALS JUST 1000
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST TRUE) NOTHING (JUST FALSE) FALSE EQUALS NOTHING
-- s 612(2): section 610 does not apply to the premiums: nothing is transferred
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST FALSE) NOTHING (JUST TRUE) FALSE EQUALS JUST 0
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 NOTHING NOTHING (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST FALSE) NOTHING NOTHING FALSE EQUALS NOTHING
-- no premium, or a regulation under s 614 (outside the sources): not covered
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` FALSE 1000 (JUST FALSE) NOTHING (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 610(5) the sum that must be transferred to the share premium account, subject to sections 611, 612 and 614` TRUE 1000 (JUST FALSE) NOTHING (JUST FALSE) TRUE EQUALS NOTHING
-- s 610(6) "the issuing company" means the company issuing shares as mentioned in subsection (1)
#ASSERT `s 610(6) the company is the issuing company` TRUE EQUALS JUST TRUE
#ASSERT `s 610(6) the company is the issuing company` FALSE EQUALS JUST FALSE

§§ `s 611`
-- s 611(1): (a) wholly-owned subsidiary, (b) allots to the holding company or another wholly-owned subsidiary (a nominee counts, s 616(2)(b)),
-- in consideration for non-cash assets of a transferor company that is a member of the group
--                                                                 WOS  hc   hc-nom wos2 wos2-nom ncash consid group
#ASSERT `s 611(1) section 611 applies` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 611(1) section 611 applies` TRUE FALSE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 611(1) section 611 applies` TRUE FALSE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 611(1) section 611 applies` TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 611(1) section 611 applies` TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 611(1) section 611 applies` FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 611(1) section 611 applies` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 611(1) section 611 applies` TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 611(1) section 611 applies` TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- s 611(2)
#ASSERT `s 611(2) the issuing company is not required to transfer any amount in excess of the minimum premium value` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 611(2) the issuing company is not required to transfer any amount in excess of the minimum premium value` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 611(2) the issuing company is not required to transfer any amount in excess of the minimum premium value` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 611(2) the issuing company is not required to transfer any amount in excess of the minimum premium value` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 611(2) the issuing company is not required to transfer any amount in excess of the minimum premium value` NOTHING FALSE EQUALS JUST FALSE
-- s 611(3): the amount (if any) by which the base value of the consideration exceeds the aggregate nominal value
#ASSERT `s 611(3) the minimum premium value` (JUST 800) 500 EQUALS JUST 300
#ASSERT `s 611(3) the minimum premium value` (JUST 500) 500 EQUALS JUST 0
#ASSERT `s 611(3) the minimum premium value` (JUST 400) 500 EQUALS JUST 0
#ASSERT `s 611(3) the minimum premium value` NOTHING 500 EQUALS NOTHING
-- s 611(4): the amount by which the base value of the assets transferred exceeds the base value of the liabilities assumed
#ASSERT `s 611(4) the base value of the consideration for the shares allotted` 900 400 EQUALS JUST 500
#ASSERT `s 611(4) the base value of the consideration for the shares allotted` 400 400 EQUALS NOTHING
#ASSERT `s 611(4) the base value of the consideration for the shares allotted` 300 400 EQUALS NOTHING
-- s 611(5)(a): the cost to the transferor company or, if less, the amount stated in its accounting records
#ASSERT `s 611(5)(a) the base value of the assets transferred` 1000 (JUST 800) EQUALS 800
#ASSERT `s 611(5)(a) the base value of the assets transferred` 1000 (JUST 1200) EQUALS 1000
#ASSERT `s 611(5)(a) the base value of the assets transferred` 1000 (JUST 1000) EQUALS 1000
#ASSERT `s 611(5)(a) the base value of the assets transferred` 1000 NOTHING EQUALS 1000
-- s 611(5)(b): the amount at which the liabilities are stated in the accounting records
#ASSERT `s 611(5)(b) the base value of the liabilities assumed` 250 EQUALS 250

§§ `s 612`
-- s 612(1): 90% equity holding secured; arrangement provides for allotment of equity shares; consideration by (a) issue or transfer of equity shares in the other company or (b) cancellation of such shares not held by the issuing company
--                                                      secured    arrangement itself nominee cancelled
#ASSERT `s 612(1) section 612 applies` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 612(1) section 612 applies` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 612(1) section 612 applies` (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 612(1) section 612 applies` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 612(1) section 612 applies` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 612(1) section 612 applies` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 612(1) section 612 applies` NOTHING TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 612(1) section 612 applies` NOTHING FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- s 612(4): "This section does not apply in a case falling within section 611"
#ASSERT `s 612(4) section 612 applies to the case, so far as section 611 is concerned` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 612(4) section 612 applies to the case, so far as section 611 is concerned` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 612(4) section 612 applies to the case, so far as section 611 is concerned` NOTHING EQUALS NOTHING
-- the two together
#ASSERT `s 612(1) and (4) section 612 applies to the case` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 612(1) and (4) section 612 applies to the case` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 612(1) and (4) section 612 applies to the case` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 612(1) and (4) section 612 applies to the case` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 612(1) and (4) section 612 applies to the case` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 612(1) and (4) section 612 applies to the case` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 612(1) and (4) section 612 applies to the case` NOTHING NOTHING EQUALS NOTHING
-- s 612(2): section 610 does not apply to the premiums on the equity shares allotted for the acquisition or cancellation, if issued at a premium
#ASSERT `s 612(2) section 610 does not apply to the premiums on those shares` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 612(2) section 610 does not apply to the premiums on those shares` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 612(2) section 610 does not apply to the premiums on those shares` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 612(2) section 610 does not apply to the premiums on those shares` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 612(2) section 610 does not apply to the premiums on those shares` NOTHING TRUE TRUE EQUALS NOTHING
-- s 612(3): extends to shares allotted on terms of non-equity shares (a) or cancellation of such shares (b)
--                                                           applies  (a)    (b)    allotted
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE
-- shares NOT allotted on those terms: the extension is limited to shares allotted on those terms, so the text does not say (a scope limit with no "only": ruling of 2026-11-05 (c))
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` (JUST FALSE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 612(3) the relief under subsection (2) extends to the shares` NOTHING TRUE FALSE TRUE EQUALS NOTHING

§§ `s 613`
-- fixtures: a class of company B's equity share capital, positionally:
--  nominal value held by A, (5)(a) holding co or subsidiary of A, (5)(b) subsidiary of A's holding co, (5)(c) nominees, total incl. treasury, treasury
`s 613 fixture exactly 90% after treasury` MEANS `s 613(2) class of company B's equity share capital` OF 810, 0, 0, 0, 1000, 100
`s 613 fixture just under 90% after treasury` MEANS `s 613(2) class of company B's equity share capital` OF 809, 0, 0, 0, 1000, 100
`s 613 fixture 90% only counting the section 613(5) holders` MEANS `s 613(2) class of company B's equity share capital` OF 500, 200, 100, 10, 1000, 100
`s 613 fixture just under 90% if treasury shares were counted` MEANS `s 613(2) class of company B's equity share capital` OF 810, 0, 0, 0, 1000, 0
`s 613 fixture class one of two, wholly held` MEANS `s 613(2) class of company B's equity share capital` OF 10000, 0, 0, 0, 10000, 0
`s 613 fixture class two of two, not held` MEANS `s 613(2) class of company B's equity share capital` OF 0, 0, 0, 0, 1000, 0
`s 613 fixture class two of two, 90% held` MEANS `s 613(2) class of company B's equity share capital` OF 900, 0, 0, 0, 1000, 0
`s 613 fixture a class with no capital` MEANS `s 613(2) class of company B's equity share capital` OF 0, 0, 0, 0, 100, 100

-- (3)(a): immaterial whether acquired in pursuance of the arrangement
#ASSERT `s 613(3)(a) the shares count towards company A's holding` TRUE EQUALS JUST TRUE
#ASSERT `s 613(3)(a) the shares count towards company A's holding` FALSE EQUALS JUST TRUE
-- (3)(b): treasury shares excluded: 1000 less 100
#ASSERT `s 613(3)(b) the nominal value of the class counted in company B's equity share capital` `s 613 fixture exactly 90% after treasury` EQUALS 900
-- (5): shares held by the holding company or a subsidiary, a subsidiary of the holding company, or nominees, are treated as held by A
#ASSERT `s 613(5) the nominal value of the class treated as held by company A` `s 613 fixture 90% only counting the section 613(5) holders` EQUALS 810
#ASSERT `s 613(5) the nominal value of the class treated as held by company A` `s 613 fixture exactly 90% after treasury` EQUALS 810
-- (2): 90% or more of the nominal value of the equity share capital, treasury shares excluded
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture exactly 90% after treasury`) EQUALS JUST TRUE
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture just under 90% after treasury`) EQUALS JUST FALSE
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture 90% only counting the section 613(5) holders`) EQUALS JUST TRUE
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture just under 90% if treasury shares were counted`) EQUALS JUST FALSE
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` FALSE (LIST `s 613 fixture exactly 90% after treasury`) EQUALS JUST FALSE
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture a class with no capital`) EQUALS NOTHING
-- (4): different classes: each class taken separately
#ASSERT `s 613(4) the class requirement bars company A from being regarded as having secured the holding` TRUE (LIST `s 613 fixture exactly 90% after treasury`) EQUALS JUST FALSE
#ASSERT `s 613(4) the class requirement bars company A from being regarded as having secured the holding` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture class two of two, not held`) EQUALS JUST TRUE
#ASSERT `s 613(4) the class requirement bars company A from being regarded as having secured the holding` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture class two of two, 90% held`) EQUALS JUST FALSE
#ASSERT `s 613(4) the class requirement bars company A from being regarded as having secured the holding` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture a class with no capital`) EQUALS NOTHING
-- (2) and (4) together: the aggregate 10,000 of 11,000 is 90.9%, but class two is not held at all
#ASSERT `s 613(2) company A has secured at least a 90% equity holding in company B` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture class two of two, not held`) EQUALS JUST TRUE
#ASSERT `s 613(2) and (4) company A has secured at least a 90% equity holding in company B, each class taken separately` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture class two of two, not held`) EQUALS JUST FALSE
#ASSERT `s 613(2) and (4) company A has secured at least a 90% equity holding in company B, each class taken separately` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture class two of two, 90% held`) EQUALS JUST TRUE
#ASSERT `s 613(2) and (4) company A has secured at least a 90% equity holding in company B, each class taken separately` TRUE (LIST `s 613 fixture just under 90% after treasury`) EQUALS JUST FALSE
#ASSERT `s 613(2) and (4) company A has secured at least a 90% equity holding in company B, each class taken separately` TRUE (LIST `s 613 fixture exactly 90% after treasury`) EQUALS JUST TRUE
#ASSERT `s 613(2) and (4) company A has secured at least a 90% equity holding in company B, each class taken separately` TRUE (LIST `s 613 fixture class one of two, wholly held`, `s 613 fixture a class with no capital`) EQUALS NOTHING

§§ `s 615`
#ASSERT `s 615 the amount that may be disregarded in determining the balance sheet amount` TRUE 40 EQUALS JUST 40
#ASSERT `s 615 the amount that may be disregarded in determining the balance sheet amount` FALSE 40 EQUALS NOTHING

§§ `s 616`
-- (1) "arrangement"
#ASSERT `s 616(1) the thing is an arrangement` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 616(1) the thing is an arrangement` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 616(1) the thing is an arrangement` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 616(1) the thing is an arrangement` FALSE FALSE FALSE EQUALS JUST FALSE
-- (1) "company": includes any body corporate, except in reference to the issuing company
#ASSERT `s 616(1) the body is a company for this Chapter` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 616(1) the body is a company for this Chapter` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 616(1) the body is a company for this Chapter` FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 616(1) the body is a company for this Chapter` FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 616(1) the body is a company for this Chapter` FALSE FALSE NOTHING EQUALS NOTHING
-- (1) "equity shares" means shares comprised in a company's equity share capital; "non-equity shares" means shares not so comprised
#ASSERT `s 616(1) the shares are equity shares` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 616(1) the shares are equity shares` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 616(1) the shares are equity shares` NOTHING EQUALS NOTHING
#ASSERT `s 616(1) the shares are non-equity shares` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 616(1) the shares are non-equity shares` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 616(1) the shares are non-equity shares` NOTHING EQUALS NOTHING
-- (1) "the issuing company" has the meaning given by s 610(6)
#ASSERT `s 616(1) the company is the issuing company` TRUE EQUALS JUST TRUE
#ASSERT `s 616(1) the company is the issuing company` FALSE EQUALS JUST FALSE
-- (2) acts of a nominee
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(a) the acquisition by a company of shares in another company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(a) the acquisition by a company of shares in another company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(a) the acquisition by a company of shares in another company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(b) the issue or allotment of shares to, or the transfer of shares to or by, a company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(b) the issue or allotment of shares to, or the transfer of shares to or by, a company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2)(b) the issue or allotment of shares to, or the transfer of shares to or by, a company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 616(2) the act is treated as an act of the company` `s 616(2) some other act` TRUE TRUE EQUALS NOTHING
#ASSERT `s 616(2) the reference in section 611 to the transferor company is read as including a nominee` TRUE EQUALS JUST TRUE
#ASSERT `s 616(2) the reference in section 611 to the transferor company is read as including a nominee` FALSE EQUALS NOTHING
-- (3) the transfer of shares includes the transfer of the right to be included in the register of members
#ASSERT `s 616(3) the transaction is a transfer of shares in the company for this Chapter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 616(3) the transaction is a transfer of shares in the company for this Chapter` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 616(3) the transaction is a transfer of shares in the company for this Chapter` FALSE FALSE EQUALS NOTHING
