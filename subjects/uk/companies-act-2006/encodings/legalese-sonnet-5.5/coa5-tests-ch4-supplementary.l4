IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-ch4-supplementary`

-- coa5-tests-ch4-supplementary.l4: tests for ss 223 to 225 (coa5-ch4-supplementary.l4). Expected values read from the text, not from the code.

§ `Tests: s 223`

-- s 223(1): a shadow director is treated as a director for ss 188-189, 190-196, 197-214, 215-222
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(a) sections 188 and 189 (directors' service contracts)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(b) sections 190 to 196 (property transactions)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(c) sections 197 to 214 (loans etc)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(d) sections 215 to 222 (payments for loss of office)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1) some other provision` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(c) sections 197 to 214 (loans etc)` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 223(1) the shadow director is treated as a director for the provision` `s 223(1)(c) sections 197 to 214 (loans etc)` NOTHING EQUALS NOTHING

-- s 223(2): a reference to loss of office as a director does not apply to loss of status as a shadow director
#ASSERT `s 223(2) a reference to loss of office as a director applies to the loss` `s 223(2) loss of a person's status as a shadow director` EQUALS JUST FALSE
#ASSERT `s 223(2) a reference to loss of office as a director applies to the loss` `s 223(2) loss of office as a director` EQUALS NOTHING

§ `Tests: s 224`

-- s 224(2): subject to a provision of the articles
#ASSERT `s 224(2) subsection (1) has effect subject to a provision of the articles` TRUE EQUALS JUST TRUE
#ASSERT `s 224(2) subsection (1) has effect subject to a provision of the articles` FALSE EQUALS NOTHING

-- s 224(1): where written resolution and a memorandum is required to be sent, an accidental failure to send it to one or more members is disregarded
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` FALSE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` TRUE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` TRUE TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 224(1) the failure is disregarded in determining whether the requirement has been met` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE

§ `Tests: s 225`

-- s 225(1): approval may be required under more than one provision
#ASSERT `s 225(1) approval is required under more than one provision of this Chapter` 2 EQUALS JUST TRUE
#ASSERT `s 225(1) approval is required under more than one provision of this Chapter` 3 EQUALS JUST TRUE
#ASSERT `s 225(1) approval is required under more than one provision of this Chapter` 1 EQUALS NOTHING
#ASSERT `s 225(1) approval is required under more than one provision of this Chapter` 0 EQUALS NOTHING

-- s 225(2): if so, the requirements of each applicable provision must be met
#ASSERT `s 225(2) approval has been given as this Chapter requires` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 225(2) approval has been given as this Chapter requires` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 225(2) approval has been given as this Chapter requires` NOTHING TRUE EQUALS NOTHING

-- s 225(3): this does not require a separate resolution for each provision
#ASSERT `s 225(3) a separate resolution is required for each provision` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 225(3) a separate resolution is required for each provision` NOTHING EQUALS NOTHING
