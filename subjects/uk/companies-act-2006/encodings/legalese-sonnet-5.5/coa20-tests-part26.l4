#ASSERT `s 899(3) the compromise or arrangement is binding on the person` TRUE `s 899(3) a contributory of a company in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 899(3) the compromise or arrangement is binding on the person` TRUE `s 899(3) any other person` EQUALS NOTHING
-- s 899(4): no effect until a copy has been delivered to the registrar (the bar)
#ASSERT `s 899(4) the court's order cannot yet have effect` FALSE EQUALS JUST TRUE
#ASSERT `s 899(4) the court's order cannot yet have effect` TRUE EQUALS JUST FALSE

§ `Tests -- s 899A Moratorium debts, etc`
-- s 899A(1): application made before the end of the 12 weeks beginning with the day after the moratorium ended: the moratorium ended on 1 March 2026, so day 1 is 2 March and day 84 is 24 May
#ASSERT `s 899A(1) this section applies` (Date 24 5 2026) (Date 1 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 899A(1) this section applies` (Date 25 5 2026) (Date 1 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 899A(1) this section applies` (Date 2 3 2026) (Date 1 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 899A(1) this section applies` (Date 20 2 2026) (Date 1 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 899A(1) this section applies` (Date 2 3 2026) (Date 1 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 899A(2) the creditor is a relevant creditor` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 899A(2) the creditor is a relevant creditor` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 899A(2) the creditor is a relevant creditor` FALSE FALSE EQUALS JUST FALSE
-- s 899A(3): relevant creditors may not participate
#ASSERT `s 899A(3) the relevant creditor may participate in the meeting summoned under section 896` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 899A(3) the relevant creditor may participate in the meeting summoned under section 896` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 899A(3) the relevant creditor may participate in the meeting summoned under section 896` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 899A(3) the relevant creditor may participate in the meeting summoned under section 896` NOTHING TRUE EQUALS NOTHING
-- s 899A(4): section 897 reaches relevant creditors
#ASSERT `s 899A(4) the relevant creditor is within section 897 as a creditor entitled to be sent the statement and to attend` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 899A(4) the relevant creditor is within section 897 as a creditor entitled to be sent the statement and to attend` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 899A(4) the relevant creditor is within section 897 as a creditor entitled to be sent the statement and to attend` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 899A(4) the relevant creditor is within section 897 as a creditor entitled to be sent the statement and to attend` NOTHING TRUE EQUALS NOTHING
-- s 899A(5): the court may not sanction if it includes provision for a relevant creditor who has not agreed
#ASSERT `s 899A(5) the court may sanction the compromise or arrangement under section 899` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 899A(5) the court may sanction the compromise or arrangement under section 899` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 899A(5) the court may sanction the compromise or arrangement under section 899` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 899A(5) the court may sanction the compromise or arrangement under section 899` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 899A(5) the court may sanction the compromise or arrangement under section 899` NOTHING TRUE FALSE EQUALS NOTHING
-- s 899A(6): the meaning is borrowed from s 174A of the 1986 Act or Article 148A of the 1989 Order: the borrowed answer passes through
#ASSERT `s 899A(6) the debt is a moratorium debt or a priority pre-moratorium debt` `s 899A(6) a moratorium under Part A1 of the Insolvency Act 1986` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 899A(6) the debt is a moratorium debt or a priority pre-moratorium debt` `s 899A(6) a moratorium under Part 1A of the Insolvency (Northern Ireland) Order 1989` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 899A(6) the debt is a moratorium debt or a priority pre-moratorium debt` `s 899A(6) a moratorium under Part A1 of the Insolvency Act 1986` NOTHING EQUALS NOTHING

