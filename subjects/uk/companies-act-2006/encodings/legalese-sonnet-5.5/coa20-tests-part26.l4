IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa20-part26`

-- coa20-tests-part26.l4: tests for coa20-part26.l4 (ss 895-901). Every expected value is written from the text of the section
-- named beside it, before the code was run. T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Tests -- s 895 Application of this Part`
-- s 895(1): "apply where a compromise or arrangement is proposed between a company and (a) its creditors ... or (b) its members"
#ASSERT `s 895(1) the provisions of Part 26 apply` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 895(1) the provisions of Part 26 apply` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 895(1) the provisions of Part 26 apply` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 895(1) the provisions of Part 26 apply` FALSE FALSE EQUALS JUST FALSE
-- s 895(2) "arrangement" includes consolidation, division or both; any other reorganisation: not covered (includes)
#ASSERT `s 895(2) the reorganisation of the share capital is an arrangement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 895(2) the reorganisation of the share capital is an arrangement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 895(2) the reorganisation of the share capital is an arrangement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 895(2) the reorganisation of the share capital is an arrangement` FALSE FALSE EQUALS NOTHING
-- s 895(2) "company": in s 900 a company within the meaning of the Act; elsewhere a company liable to be wound up under the 1986 Act or the 1989 Order
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) in section 900` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) in section 900` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) in section 900` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) elsewhere in Part 26` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) elsewhere in Part 26` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 895(2) the body is a company for the purposes of Part 26` `s 895(2) elsewhere in Part 26` (JUST TRUE) NOTHING EQUALS NOTHING
-- s 895(3): subject to Part 27 where that Part applies
#ASSERT `s 895(3) the provisions of Part 26 have effect subject to Part 27` TRUE EQUALS JUST TRUE
#ASSERT `s 895(3) the provisions of Part 26 have effect subject to Part 27` FALSE EQUALS JUST FALSE

§ `Tests -- s 896 Court order for holding of meeting`
#ASSERT `s 896(1) the court may order a meeting of the creditors, class of creditors, members or class of members` TRUE EQUALS JUST TRUE
#ASSERT `s 896(1) the court may order a meeting of the creditors, class of creditors, members or class of members` FALSE EQUALS NOTHING
-- s 896(2): the company, any creditor or member; the liquidator only if the company is being wound up; the administrator only if in administration
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) a creditor of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) a member of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the liquidator of the company` TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F26)
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the administrator of the company` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the administrator of the company` TRUE FALSE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F26)
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) the administrator of the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 896(2) the person may apply for an order for a meeting` `s 896(2) any other person` TRUE TRUE EQUALS NOTHING
-- s 896(3): s 323 applies to a meeting of creditors under this section
#ASSERT `s 896(3) section 323 applies to the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 896(3) section 323 applies to the meeting` FALSE EQUALS NOTHING
-- s 896(4): subject to s 899A
#ASSERT `s 896(4) section 896 is subject to section 899A` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 896(4) section 896 is subject to section 899A` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 896(4) section 896 is subject to section 899A` NOTHING EQUALS NOTHING

§ `Tests -- s 897 Statement to be circulated or made available`
-- s 897(1): a notice sent to a creditor or member must be accompanied by a statement; an advertisement must include one or say where to get one
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` FALSE `s 897(1) sent to a creditor or member` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` TRUE `s 897(1) sent to a creditor or member` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` TRUE `s 897(1) sent to a creditor or member` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` TRUE `s 897(1) given by advertisement` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` TRUE `s 897(1) given by advertisement` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 897(1) the notice summoning the meeting satisfies the requirement` TRUE `s 897(1) given by advertisement` TRUE FALSE FALSE EQUALS JUST FALSE
-- s 897(2): explain the effect, state directors' interests, state the effect on those interests
#ASSERT `s 897(2) the statement complies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 897(2) the statement complies` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 897(2) the statement complies` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 897(2) the statement complies` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 897(3): where debenture holders' rights are affected, the like explanation as respects the trustees
#ASSERT `s 897(3) the statement complies as respects debenture holders` FALSE FALSE EQUALS NOTHING
#ASSERT `s 897(3) the statement complies as respects debenture holders` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 897(3) the statement complies as respects debenture holders` TRUE FALSE EQUALS JUST FALSE
-- s 897(4): a free copy on application in the manner indicated
#ASSERT `s 897(4) the person is entitled to be provided by the company with a copy of the statement free of charge` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 897(4) the person is entitled to be provided by the company with a copy of the statement free of charge` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 897(4) the person is entitled to be provided by the company with a copy of the statement free of charge` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 897(4) the person is entitled to be provided by the company with a copy of the statement free of charge` TRUE TRUE FALSE EQUALS NOTHING
-- s 897(5)-(7): the company, and every officer in default, unless the person shows the refusal defence
#ASSERT `s 897(5) the person is guilty of an offence under section 897` FALSE `s 897(5) the company` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) the company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) the company` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) an officer of the company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) an officer of the company` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) an officer of the company` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) a liquidator or administrator of the company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) a trustee of a deed for securing the issue of debentures of the company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) a trustee of a deed for securing the issue of debentures of the company` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 897(5) the person is guilty of an offence under section 897` TRUE `s 897(5) any other person` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 897(7) section 897(7) gives the person a defence on these facts` TRUE EQUALS JUST TRUE
#ASSERT `s 897(7) section 897(7) gives the person a defence on these facts` FALSE EQUALS JUST FALSE
-- s 897(8): on indictment a fine; on summary conviction a fine not exceeding the statutory maximum
#ASSERT `s 897(8) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 897(8) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 897(8) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)

§ `Tests -- s 898 Duty of directors and trustees to provide information`
