§ `Tests -- s 901 Obligations of company with respect to articles etc`
#ASSERT `s 901(1) this section applies to the order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 901(1) this section applies to the order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901(1) this section applies to the order` FALSE FALSE EQUALS NOTHING
#ASSERT `s 901(2) the copy of the order is accompanied as the section requires` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 901(2) the copy of the order is accompanied as the section requires` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 901(2) the copy of the order is accompanied as the section requires` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 901(2) the copy of the order is accompanied as the section requires` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 901(2) the copy of the order is accompanied as the section requires` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
-- the exception is met (the effect of the order is in the articles): nothing more is required
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` (JUST FALSE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 901(3) the copy of the articles is accompanied as the section requires` NOTHING TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 901(4) the thing is within the reference` `s 901(4)(a) a reference to the effect of the order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 901(4) the thing is within the reference` `s 901(4)(a) a reference to the effect of the order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 901(4) the thing is within the reference` `s 901(4)(b) a reference to the articles of a company not having articles` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901(4) the thing is within the reference` `s 901(4)(b) a reference to the articles of a company not having articles` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 901(5) the person is guilty of an offence under section 901` FALSE `s 897(5) the company` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 901(5) the person is guilty of an offence under section 901` TRUE `s 897(5) the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901(5) the person is guilty of an offence under section 901` TRUE `s 897(5) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901(5) the person is guilty of an offence under section 901` TRUE `s 897(5) an officer of the company` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 901(5) the person is guilty of an offence under section 901` TRUE `s 897(5) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 901(6) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
#ASSERT `s 901(6) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING

§ `Tests -- helpers (s 903(1), s 903(2), s 906(3))`
-- s 903(1) status of a requirement: an excluding section that applies switches the requirement off; one not known is not covered
#ASSERT `s 903(1) the status of the requirement` (JUST TRUE) TRUE EQUALS `s 903(1) requirement does not apply`
#ASSERT `s 903(1) the status of the requirement` (JUST TRUE) FALSE EQUALS `s 903(1) requirement does not apply`
#ASSERT `s 903(1) the status of the requirement` NOTHING TRUE EQUALS `s 903(1) requirement not covered`
#ASSERT `s 903(1) the status of the requirement` (JUST FALSE) TRUE EQUALS `s 903(1) requirement complied with`
#ASSERT `s 903(1) the status of the requirement` (JUST FALSE) FALSE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 903(2) any of the provisions answers yes` (LIST JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 903(2) any of the provisions answers yes` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 903(2) any of the provisions answers yes` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `s 903(2) any of the provisions answers yes` (LIST NOTHING, JUST TRUE) EQUALS JUST TRUE
-- one month: 31 January + one month is 28 February 2026 (the library clamps); 15 March - one month is 15 February
#ASSERT `s 906(3) the date one month after` (Date 31 1 2026) EQUALS Date 28 2 2026
#ASSERT `s 906(3) the date one month after` (Date 15 3 2026) EQUALS Date 15 4 2026
#ASSERT `s 906(3) the date one month before` (Date 15 3 2026) EQUALS Date 15 2 2026
#ASSERT `s 906(3) the date one month before` (Date 31 3 2026) EQUALS Date 28 2 2026
