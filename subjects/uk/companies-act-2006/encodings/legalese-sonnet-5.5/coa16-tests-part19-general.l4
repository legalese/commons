IMPORT prelude
IMPORT daydate
IMPORT `coa16-part19-general`

-- coa16-tests-part19-general.l4: tests for coa16-part19-general.l4 (ss 738 to 742).
-- Every expected value is written from the text beside the assertion, never from the code's output.
-- #TRACE results are read by hand (an assertion cannot compare a DEONTIC); each trace carries its expected result.

-- ---- s 738 ---------------------------------------------------------------------------------------------
-- "includes debenture stock, bonds and any other securities of a company, whether or not constituting a charge"
#ASSERT `s 738 the instrument is a debenture` `s 738 debenture stock` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 738 the instrument is a debenture` `s 738 debenture stock` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 738 the instrument is a debenture` `s 738 a bond` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 738 the instrument is a debenture` `s 738 a bond` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 738 the instrument is a debenture` `s 738 another security of a company` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 738 the instrument is a debenture` `s 738 another security of a company` FALSE (JUST TRUE) EQUALS JUST TRUE
-- a share: the text does not say (fork F1): not covered
#ASSERT `s 738 the instrument is a debenture` `s 738 a share in a company` FALSE (JUST TRUE) EQUALS NOTHING
-- not a security of a company: "includes" leaves the list open: not covered, not "no"
#ASSERT `s 738 the instrument is a debenture` `s 738 something that is not a security of a company` FALSE (JUST TRUE) EQUALS NOTHING
-- "In the Companies Acts": outside it, or not known, is not covered
#ASSERT `s 738 the instrument is a debenture` `s 738 a bond` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 738 the instrument is a debenture` `s 738 a bond` FALSE NOTHING EQUALS NOTHING

-- ---- s 739 ---------------------------------------------------------------------------------------------
-- (1) "is not invalid by reason only that the debentures are made (a) irredeemable, or (b) redeemable only (i) on a contingency or (ii) on the expiration of a period"
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- redeemable in some other way: the text is silent
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- a condition that is not in debentures or a deed securing them: outside the limit of the provision
#ASSERT `s 739(1) the condition is invalid by reason only of how the debentures are made redeemable` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (2) "whenever issued", "whenever executed": any date, before and after the Act's enactment
#ASSERT `s 739(2) subsection (1) applies to the debentures or deed` (Date 1 1 1900) EQUALS JUST TRUE
#ASSERT `s 739(2) subsection (1) applies to the debentures or deed` (Date 7 11 2006) EQUALS JUST TRUE
#ASSERT `s 739(2) subsection (1) applies to the debentures or deed` (Date 8 11 2006) EQUALS JUST TRUE
#ASSERT `s 739(2) subsection (1) applies to the debentures or deed` (Date 1 1 2040) EQUALS JUST TRUE

-- ---- s 740 ---------------------------------------------------------------------------------------------
#ASSERT `s 740 the contract may be enforced by an order for specific performance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 740 the contract may be enforced by an order for specific performance` FALSE TRUE EQUALS NOTHING
#ASSERT `s 740 the contract may be enforced by an order for specific performance` TRUE FALSE EQUALS NOTHING

-- ---- s 741(1): the last day, "within two months after the date of the allotment" -----------------------
#ASSERT `s 741(1) the last day for registering the allotment` (Date 15 1 2023) EQUALS Date 15 3 2023
#ASSERT `s 741(1) the last day for registering the allotment` (Date 31 8 2023) EQUALS Date 31 10 2023
#ASSERT `s 741(1) the last day for registering the allotment` (Date 31 12 2022) EQUALS Date 28 2 2023
#ASSERT `s 741(1) the last day for registering the allotment` (Date 31 12 2023) EQUALS Date 29 2 2024
#ASSERT `s 741(1) the last day for registering the allotment` (Date 30 11 2022) EQUALS Date 30 1 2023
-- 15 January to 15 March 2023: 16 + 28 + 15 = 59 days
#ASSERT `s 741(1) the days allowed for registering the allotment` (Date 15 1 2023) EQUALS 59
-- registered on the last day and as soon as practicable: in time
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 15 1 2023) (JUST (Date 15 3 2023)) TRUE (Date 20 3 2023) EQUALS JUST TRUE
-- the day after the last day: late
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) EQUALS JUST FALSE
-- inside two months but not as soon as practicable: the first limb is not met
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 15 1 2023) (JUST (Date 1 3 2023)) FALSE (Date 20 3 2023) EQUALS JUST FALSE
-- the short-month deadline: 31 December 2022 allotment, last day 28 February 2023
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 31 12 2022) (JUST (Date 28 2 2023)) TRUE (Date 5 3 2023) EQUALS JUST TRUE
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 31 12 2022) (JUST (Date 1 3 2023)) TRUE (Date 5 3 2023) EQUALS JUST FALSE
-- not registered: still time left, no answer yet; the day after the last day, the duty is not met
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 15 1 2023) NOTHING TRUE (Date 15 3 2023) EQUALS NOTHING
#ASSERT `s 741(1) the company has registered the allotment as the section requires` (Date 15 1 2023) NOTHING TRUE (Date 16 3 2023) EQUALS JUST FALSE

-- s 741(1) as a regulative rule: the clock counts days from the allotment (day 0 = 15 January 2023, last day = day 59)
-- Registered on day 59, inside the period: expected FULFILLED
#TRACE `s 741(1) the company must register the allotment` (Date 15 1 2023) AT 0 WITH
    PARTY Company DOES `s 741 register the allotment of debentures` AT 59
-- Registered on day 60, after the period: expected DEONTIC BREACHED, BY Company
#TRACE `s 741(1) the company must register the allotment` (Date 15 1 2023) AT 0 WITH
    PARTY Company DOES `s 741 register the allotment of debentures` AT 60
-- Nothing done and the clock passes day 59: expected DEONTIC BREACHED, BY Company
#TRACE `s 741(1) the company must register the allotment` (Date 15 1 2023) AT 0 WITH
    (WAITUNTIL 60)

-- ---- s 741(2): the offence --------------------------------------------------------------------------------
-- the company, registration late
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) `s 741(2) the company` EQUALS JUST TRUE
-- an officer in default
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) (`s 741(2) an officer of the company` (JUST TRUE)) EQUALS JUST TRUE
-- an officer who is not in default: outside the class "every officer of the company who is in default"
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) (`s 741(2) an officer of the company` (JUST FALSE)) EQUALS NOTHING
-- an officer whose default is not known (s 1121 not answered)
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) (`s 741(2) an officer of the company` NOTHING) EQUALS NOTHING
-- a person the text does not name
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 16 3 2023)) TRUE (Date 20 3 2023) `s 741(2) another person` EQUALS NOTHING
-- the company registered in time: "If a company fails to comply" is not met
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 15 3 2023)) TRUE (Date 20 3 2023) `s 741(2) the company` EQUALS JUST FALSE
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) (JUST (Date 15 3 2023)) TRUE (Date 20 3 2023) (`s 741(2) an officer of the company` (JUST TRUE)) EQUALS JUST FALSE
-- not yet registered and still in time: not yet known
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) NOTHING TRUE (Date 1 3 2023) `s 741(2) the company` EQUALS NOTHING
-- not registered and out of time: the company fails to comply
#ASSERT `s 741(2) the person commits an offence` (Date 15 1 2023) NOTHING TRUE (Date 1 4 2023) `s 741(2) the company` EQUALS JUST TRUE

-- ---- s 741(3): level 3 on the standard scale, and one-tenth of level 3 a day -------------------------------
#ASSERT `s 741(3) the penalty for the offence` EQUALS Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE
-- the pounds a level stands for is an input: 200 pounds for level 3 is a made-up test value, not the Act's
#ASSERT `s 741(3) the most that a fine limit allows, in pounds` (`a fine not exceeding a level on the standard scale` 3 1) 200 5000 EQUALS JUST 200
#ASSERT `s 741(3) the most that a fine limit allows, in pounds` (`a fine not exceeding a level on the standard scale` 3 0.1) 200 5000 EQUALS JUST 20
#ASSERT `s 741(3) the most that a fine limit allows, in pounds` (`a fine not exceeding the statutory maximum` 1) 200 5000 EQUALS JUST 5000
#ASSERT `s 741(3) the most that a fine limit allows, in pounds` (`a fine not exceeding an amount in pounds` 75) 200 5000 EQUALS JUST 75
#ASSERT `s 741(3) the most that a fine limit allows, in pounds` `a fine without a stated limit` 200 5000 EQUALS NOTHING

-- ---- s 742 ---------------------------------------------------------------------------------------------
#ASSERT `s 742 the debentures are valid and binding according to their terms` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742 the debentures are valid and binding according to their terms` FALSE TRUE EQUALS NOTHING
#ASSERT `s 742 the debentures are valid and binding according to their terms` TRUE FALSE EQUALS NOTHING
