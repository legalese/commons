IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa17-helpers`
IMPORT `coa17-part21a-ch5`

-- coa17-tests-part21a-ch5.l4: tests for ss 790ZF-790ZH (coa17-part21a-ch5.l4). Expected values are written by hand from the
-- text of the section named beside each group.

§ `Tests: Part 21A Chapter 5`

-- s 790ZF(2) the information is (a) the usual residential address of a person with significant control, (b) that the service address is the usual residential address
#ASSERT `s 790ZF(2) the information is within this subsection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790ZF(2) the information is within this subsection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790ZF(2) the information is within this subsection` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790ZF(1) sections 240 to 244 apply to the information as protected information` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 790ZF(1) sections 240 to 244 apply to the information as protected information` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 790ZF(1) sections 240 to 244 apply to the information as protected information` NOTHING EQUALS NOTHING
-- s 790ZG(2), (3), (7)
#ASSERT `s 790ZG(2) the particulars are relevant PSC particulars` TRUE EQUALS JUST TRUE
#ASSERT `s 790ZG(2) the particulars are relevant PSC particulars` FALSE EQUALS JUST FALSE
#ASSERT `s 790ZG(3) the person counts as a person with significant control over the company for the purposes of subsection (2)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790ZG(3) the person counts as a person with significant control over the company for the purposes of subsection (2)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790ZG(3) the person counts as a person with significant control over the company for the purposes of subsection (2)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 790ZG(7) this section or regulations under it affect the use or disclosure of the particulars` TRUE EQUALS JUST FALSE
#ASSERT `s 790ZG(7) this section or regulations under it affect the use or disclosure of the particulars` FALSE EQUALS NOTHING
-- s 790ZH(1) the offences
#ASSERT `s 790ZH(1)(a) an offence is committed by the company` TRUE EQUALS JUST TRUE
#ASSERT `s 790ZH(1)(a) an offence is committed by the company` FALSE EQUALS JUST FALSE
#ASSERT `s 790ZH(1)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 790ZH(1)(b) an offence is committed by the officer of the company who is in default` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 790ZH(1)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) NOTHING EQUALS NOTHING
-- s 790ZH(2) summary conviction: (a) England and Wales, a fine; (b) Scotland or Northern Ireland, a fine not exceeding level 5 and a daily default fine of one-tenth of level 5
#ASSERT `s 790ZH(2) the penalty` `on summary conviction in England and Wales` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 790ZH(2) the penalty` `on summary conviction in Scotland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 790ZH(2) the penalty` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 790ZH(2) the penalty` `on summary conviction` EQUALS NOTHING
