IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa1-part2-formation`

-- coa1-tests-part2.l4: tests for coa1-part2-formation.l4 (ss 7 to 16 of the Companies Act 2006).
-- Every expected value was decided by reading the section's words (quoted in the comment beside the group) before the run, and is
-- written beside the assertion; none was copied from the module's own output. Arguments follow the GIVEN order of each rule.
-- Where an argument is a pound amount or a date it is an illustrative test input, not a figure from the Act.

-- ---- s 7 ----
-- "(1) A company is formed under this Act by one or more persons— (a) subscribing their names ..., and (b) complying with the requirements"
#ASSERT `s 7(1) the company is formed under this Act` 1 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 7(1) the company is formed under this Act` 2 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 7(1) the company is formed under this Act` 0 TRUE TRUE EQUALS NOTHING
#ASSERT `s 7(1) the company is formed under this Act` 1 FALSE TRUE EQUALS NOTHING
#ASSERT `s 7(1) the company is formed under this Act` 1 TRUE FALSE EQUALS NOTHING
-- "(2) A company may not be so formed for an unlawful purpose."
#ASSERT `s 7(2) the company may be formed for the purpose` TRUE EQUALS JUST FALSE
#ASSERT `s 7(2) the company may be formed for the purpose` FALSE EQUALS NOTHING

-- ---- s 8 ----
-- "(1) A memorandum of association is a memorandum stating that the subscribers— (a) wish to form a company under this Act, and (b) agree to become members ... and, in the case of a company that is to have a share capital, to take at least one share each."
#ASSERT `s 8(1) the document is a memorandum of association` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(1) the document is a memorandum of association` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 8(1) the document is a memorandum of association` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 8(1) the document is a memorandum of association` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 8(1) the document is a memorandum of association` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- "(2) The memorandum must be in the prescribed form and must be authenticated by each subscriber."
#ASSERT `s 8(2) the memorandum meets the requirements as to form and authentication` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 8(2) the memorandum meets the requirements as to form and authentication` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 8(2) the memorandum meets the requirements as to form and authentication` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 8(2) the memorandum meets the requirements as to form and authentication` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 8(2) the memorandum meets the requirements as to form and authentication` FALSE NOTHING EQUALS JUST FALSE
-- The subscriber's duty, run (a DEONTIC value cannot be compared in an #ASSERT on the stable binary, so these are read, not asserted):
-- expected: FULFILLED for the first trace; the second leaves the obligation standing, because the text gives no time limit.
#TRACE `s 8(2) the subscriber's duty` AT 0 WITH
    PARTY `Subscriber to the memorandum` DOES `s 8(2) authenticate the memorandum` AT 3
#TRACE `s 8(2) the subscriber's duty` AT 0 WITH
    (WAITUNTIL 100)

-- ---- s 9 ----
-- "(1) The memorandum ... must be delivered to the registrar together with an application ..., the documents required by this section and a statement of compliance."
#ASSERT `s 9(1) the delivery includes what the section requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(1) the delivery includes what the section requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(1) the delivery includes what the section requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(1) the delivery includes what the section requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(1) the delivery includes what the section requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "(2) The application for registration must state— (a) ... (e)"
#ASSERT `s 9(2) the application states what it must` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(2) the application states what it must` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(2) the application states what it must` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(2) the application states what it must` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(2) the application states what it must` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(2) the application states what it must` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "(3) If the application is delivered by a person as agent for the subscribers ..., it must state his name and address."
#ASSERT `s 9(3) the application states the agent's name and address as required` FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(3) the application states the agent's name and address as required` FALSE FALSE EQUALS NOTHING
#ASSERT `s 9(3) the application states the agent's name and address as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(3) the application states the agent's name and address as required` TRUE FALSE EQUALS JUST FALSE
-- "(3A) The application must contain— (a) ... (b) ... (c) if any of them would be so disqualified but for the permission of a court to act, a statement to that effect ... (d) if any of them would be disqualified ... but for the authority of a licence ..."
#ASSERT `s 9(3A) the application contains the statements it must` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(3A) the application contains the statements it must` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 9(3A) the application contains the statements it must` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 9(3A) the application contains the statements it must` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(3A) the application contains the statements it must` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 9(3A) the application contains the statements it must` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 9(3A) the application contains the statements it must` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "(4) The application must contain— (a) in the case of a company that is to have a share capital, a statement of capital and initial shareholdings; (b) in the case of a company that is to be limited by guarantee, a statement of guarantee; (c) ...; (d) ..."
#ASSERT `s 9(4) the application contains the statements it must` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(4) the application contains the statements it must` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(4) the application contains the statements it must` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(4) the application contains the statements it must` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(4) the application contains the statements it must` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(4) the application contains the statements it must` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(4) the application contains the statements it must` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- "(5) The application must also contain— (a) a statement of the intended address ..., which must be an appropriate address ...; (aa) ... email address ...; (b) a copy of any proposed articles ... (to the extent that these are not supplied by the default application of model articles ...); and (c) a statement of the type of company"
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` FALSE (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) FALSE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST FALSE) TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE (JUST FALSE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST FALSE) TRUE NOTHING FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE NOTHING TRUE (JUST FALSE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(5) the application contains what it must also contain` TRUE NOTHING TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(5) the application contains what it must also contain` TRUE (JUST TRUE) TRUE NOTHING FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(5) the application contains what it must also contain` TRUE NOTHING TRUE NOTHING FALSE FALSE TRUE EQUALS NOTHING
-- "(5A) The information as to the company's type must be given by reference to the classification scheme prescribed"
#ASSERT `s 9(5A) the type information is given by reference to the prescribed scheme` TRUE EQUALS JUST TRUE
#ASSERT `s 9(5A) the type information is given by reference to the prescribed scheme` FALSE EQUALS JUST FALSE
-- "(5B) The information as to the company's intended principal business activities may be given by reference to one or more categories of any prescribed system"
#ASSERT `s 9(5B) the principal business activities may be given by reference to prescribed categories` TRUE EQUALS JUST TRUE
#ASSERT `s 9(5B) the principal business activities may be given by reference to prescribed categories` FALSE EQUALS NOTHING
-- "(6) The application must be delivered— (a) to the registrar of companies for England and Wales, if the registered office ... (b) ... Scotland ... (c) ... Northern Ireland"
#ASSERT `s 9(6) the registrar to whom the application must be delivered` `England and Wales` EQUALS "the registrar of companies for England and Wales"
#ASSERT `s 9(6) the registrar to whom the application must be delivered` `Scotland` EQUALS "the registrar of companies for Scotland"
#ASSERT `s 9(6) the registrar to whom the application must be delivered` `Northern Ireland` EQUALS "the registrar of companies for Northern Ireland"
#ASSERT `s 9(6) the application is delivered to the right registrar` `England and Wales` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 9(6) the application is delivered to the right registrar` `Scotland` `Scotland` EQUALS JUST TRUE
#ASSERT `s 9(6) the application is delivered to the right registrar` `Northern Ireland` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 9(6) the application is delivered to the right registrar` `Scotland` `England and Wales` EQUALS JUST FALSE
#ASSERT `s 9(6) the application is delivered to the right registrar` `England and Wales` `Northern Ireland` EQUALS JUST FALSE
-- "(7) In subsection (3A)(c) “permission of a court to act” means permission of a court under a provision mentioned in column 2 of the table in section 159A(2)."
#ASSERT `s 9(7) the permission is permission of a court to act` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 9(7) the permission is permission of a court to act` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 9(7) the permission is permission of a court to act` NOTHING EQUALS NOTHING

-- ---- s 9A ----
-- "(1) The required information about a subscriber who is an individual is— (a) name; (b) a service address. (2) ... body corporate, or a firm that is a legal person ... is— (a) corporate or firm name; (b) a service address."
#ASSERT `s 9A(1) the required information about a subscriber` `an individual` FALSE EQUALS JUST (LIST `s 9A the individual's name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `a company registered under the Companies Act 2006` FALSE EQUALS JUST (LIST `s 9A the corporate or firm name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `another body corporate incorporated in the United Kingdom` FALSE EQUALS JUST (LIST `s 9A the corporate or firm name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `a body corporate incorporated outside the United Kingdom` FALSE EQUALS JUST (LIST `s 9A the corporate or firm name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `a partnership` TRUE EQUALS JUST (LIST `s 9A the corporate or firm name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `a partnership` FALSE EQUALS NOTHING
#ASSERT `s 9A(1) the required information about a subscriber` `an unincorporated association` TRUE EQUALS JUST (LIST `s 9A the corporate or firm name`, `s 9A a service address`)
#ASSERT `s 9A(1) the required information about a subscriber` `a corporation sole` FALSE EQUALS NOTHING
-- "(3) In subsection (1) “name” means the individual’s forename and surname."
#ASSERT `s 9A(3) the name of an individual` "Jane" "Smith" EQUALS "Jane Smith"
-- "(4) Where a subscriber is a peer or an individual usually known by a title, that title may be stated ... instead of the subscriber’s forename and surname."
#ASSERT `s 9A(4) the name stated for the subscriber is acceptable` FALSE "Jane Smith" "Jane" "Smith" "Lady Smith" EQUALS JUST TRUE
#ASSERT `s 9A(4) the name stated for the subscriber is acceptable` TRUE "Lady Smith" "Jane" "Smith" "Lady Smith" EQUALS JUST TRUE
#ASSERT `s 9A(4) the name stated for the subscriber is acceptable` TRUE "Jane Smith" "Jane" "Smith" "Lady Smith" EQUALS JUST TRUE
#ASSERT `s 9A(4) the name stated for the subscriber is acceptable` FALSE "Lady Smith" "Jane" "Smith" "Lady Smith" EQUALS JUST FALSE
#ASSERT `s 9A(4) the name stated for the subscriber is acceptable` TRUE "Jane" "Jane" "Smith" "Lady Smith" EQUALS JUST FALSE

-- ---- s 10 ----
`s 10(2)(c) test class complete` MEANS `s 10(2)(c) statement for a class of shares` OF TRUE, TRUE, TRUE
`s 10(2)(c) test class lacking rights` MEANS `s 10(2)(c) statement for a class of shares` OF FALSE, TRUE, TRUE
`s 10(2)(c) test class lacking number` MEANS `s 10(2)(c) statement for a class of shares` OF TRUE, FALSE, TRUE
`s 10(2)(c) test class lacking value` MEANS `s 10(2)(c) statement for a class of shares` OF TRUE, TRUE, FALSE
-- "(2) It must state— (a) the total number of shares ..., (b) the aggregate nominal value ..., (ba) the aggregate amount (if any) to be unpaid ..., and (c) for each class of shares— (i) prescribed particulars of the rights ..., (ii) the total number of shares of that class, and (iii) the aggregate nominal value of shares of that class"
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE TRUE (LIST `s 10(2)(c) test class complete`, `s 10(2)(c) test class complete`) EQUALS JUST TRUE
#ASSERT `s 10(2) the statement of capital states what it must` FALSE TRUE TRUE (LIST `s 10(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 10(2) the statement of capital states what it must` TRUE FALSE TRUE (LIST `s 10(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE FALSE (LIST `s 10(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE TRUE (LIST `s 10(2)(c) test class complete`, `s 10(2)(c) test class lacking rights`) EQUALS JUST FALSE
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE TRUE (LIST `s 10(2)(c) test class lacking number`) EQUALS JUST FALSE
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE TRUE (LIST `s 10(2)(c) test class lacking value`) EQUALS JUST FALSE
-- No class listed: nothing is stated "for each class", so none is missing (fork F-s10, the empty list is vacuously complete).
#ASSERT `s 10(2) the statement of capital states what it must` TRUE TRUE TRUE EMPTY EQUALS JUST TRUE
-- "(3) It must contain such information as may be prescribed for the purpose of identifying the subscribers"
#ASSERT `s 10(3) the statement contains the prescribed identifying information` TRUE EQUALS JUST TRUE
#ASSERT `s 10(3) the statement contains the prescribed identifying information` FALSE EQUALS JUST FALSE
`s 10(4)(a) test class statement complete` MEANS `s 10(4)(a) statement for a class of shares taken by a subscriber` OF TRUE, TRUE, TRUE
`s 10(4)(a) test class statement lacking number` MEANS `s 10(4)(a) statement for a class of shares taken by a subscriber` OF FALSE, TRUE, TRUE
`s 10(4)(a) test class statement lacking nominal value` MEANS `s 10(4)(a) statement for a class of shares taken by a subscriber` OF TRUE, FALSE, TRUE
`s 10(4)(a) test class statement lacking class` MEANS `s 10(4)(a) statement for a class of shares taken by a subscriber` OF TRUE, TRUE, FALSE
-- "(4) It must state, with respect to each subscriber to the memorandum— (a) the number, nominal value (of each share) and class of shares to be taken by him on formation, and (b) the amount to be paid up and the amount (if any) to be unpaid on each share"
#ASSERT `s 10(4) the statement states what it must for the subscriber` (LIST `s 10(4)(a) test class statement complete`) TRUE EQUALS JUST TRUE
#ASSERT `s 10(4) the statement states what it must for the subscriber` (LIST `s 10(4)(a) test class statement complete`) FALSE EQUALS JUST FALSE
#ASSERT `s 10(4) the statement states what it must for the subscriber` EMPTY TRUE EQUALS JUST FALSE
#ASSERT `s 10(4) the statement states what it must for the subscriber` (LIST `s 10(4)(a) test class statement lacking number`) TRUE EQUALS JUST FALSE
#ASSERT `s 10(4) the statement states what it must for the subscriber` (LIST `s 10(4)(a) test class statement lacking nominal value`) TRUE EQUALS JUST FALSE
#ASSERT `s 10(4) the statement states what it must for the subscriber` (LIST `s 10(4)(a) test class statement lacking class`) TRUE EQUALS JUST FALSE
-- "(5) Where a subscriber to the memorandum is to take shares of more than one class, the information required under subsection (4)(a) is required for each class."
#ASSERT `s 10(5) the information is given for each class` 1 1 EQUALS NOTHING
#ASSERT `s 10(5) the information is given for each class` 0 0 EQUALS NOTHING
#ASSERT `s 10(5) the information is given for each class` 2 2 EQUALS JUST TRUE
#ASSERT `s 10(5) the information is given for each class` 3 3 EQUALS JUST TRUE
#ASSERT `s 10(5) the information is given for each class` 2 1 EQUALS JUST FALSE
#ASSERT `s 10(5) the information is given for each class` 3 2 EQUALS JUST FALSE

-- ---- s 11 ----
-- "(2) It must contain such information as may be prescribed for the purpose of identifying the subscribers"
#ASSERT `s 11(2) the statement contains the prescribed identifying information` TRUE EQUALS JUST TRUE
#ASSERT `s 11(2) the statement contains the prescribed identifying information` FALSE EQUALS JUST FALSE
-- "(3) It must state that each member undertakes that, if the company is wound up while he is a member, or within one year after he ceases to be a member, he will contribute ... such amount as may be required for— (a) ..., (b) ..., and (c) ..., not exceeding a specified amount."
#ASSERT `s 11(3) the statement of guarantee states what it must` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 11(3) the statement of guarantee states what it must` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 11(3) the statement of guarantee states what it must` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 11(3) the statement of guarantee states what it must` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 11(3) the statement of guarantee states what it must` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 11(3) the statement of guarantee states what it must` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "if the company is wound up while he is a member, or within one year after he ceases to be a member": both sides of the end of the year.
#ASSERT `s 11(3) the undertaking applies to the member` NOTHING (Date 1 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 11(3) the undertaking applies to the member` (JUST (Date 1 3 2024)) (Date 1 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `s 11(3) the undertaking applies to the member` (JUST (Date 1 3 2024)) (Date 2 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `s 11(3) the undertaking applies to the member` (JUST (Date 1 3 2024)) (Date 1 3 2024) FALSE EQUALS JUST TRUE
#ASSERT `s 11(3) the undertaking applies to the member` NOTHING (Date 1 3 2025) FALSE EQUALS NOTHING
-- the most a member can be required to contribute: the lesser of what is required for (a), (b) and (c) and the specified amount (illustrative pounds)
#ASSERT `s 11(3) the most the member can be required to contribute, in pounds` TRUE 100 50 20 1000 EQUALS JUST 170
#ASSERT `s 11(3) the most the member can be required to contribute, in pounds` TRUE 100 50 20 170 EQUALS JUST 170
#ASSERT `s 11(3) the most the member can be required to contribute, in pounds` TRUE 100 50 20 169 EQUALS JUST 169
#ASSERT `s 11(3) the most the member can be required to contribute, in pounds` TRUE 100 50 20 150 EQUALS JUST 150
#ASSERT `s 11(3) the most the member can be required to contribute, in pounds` FALSE 100 50 20 1000 EQUALS NOTHING

-- ---- s 12 ----
-- "(1) The statement ... must contain the required information about— (a) the ... first director or directors; (b) in the case of a company that is to be a private company, any person who is ... to be the first secretary ...; (c) in the case of a company that is to be a public company, the person ... to be the first secretary"
#ASSERT `s 12(1) the statement contains the required information about the first officers` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 12(1) the statement contains the required information about the first officers` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(1) the statement contains the required information about the first officers` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12(1) the statement contains the required information about the first officers` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(1) the statement contains the required information about the first officers` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12(1) the statement contains the required information about the first officers` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "(2A) The statement must, in the case of each individual named as a director, confirm that the individual’s identity is verified (see section 1110A)."
#ASSERT `s 12(2A) the statement confirms that an individual named as a director has a verified identity` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12(2A) the statement confirms that an individual named as a director has a verified identity` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 12(2A) the statement confirms that an individual named as a director has a verified identity` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 12(2A) the statement confirms that an individual named as a director has a verified identity` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 12(2A) the statement confirms that an individual named as a director has a verified identity` FALSE NOTHING EQUALS JUST FALSE
-- "(3) The statement must also include a statement by the subscribers ... that each of the persons named ... has consented to act in the relevant capacity. If all the partners in a firm are to be joint secretaries, consent may be given by one partner on behalf of all of them."
#ASSERT `s 12(3) the statement includes the subscribers' statement of consent to act` TRUE EQUALS JUST TRUE
#ASSERT `s 12(3) the statement includes the subscribers' statement of consent to act` FALSE EQUALS JUST FALSE
#ASSERT `s 12(3) consent may be given by one partner on behalf of all of them` TRUE EQUALS JUST TRUE
#ASSERT `s 12(3) consent may be given by one partner on behalf of all of them` FALSE EQUALS NOTHING
-- "(4) The statement must also include a statement by the subscribers ... that no one named as a director is— (a) disqualified ..., or (b) otherwise ineligible by virtue of any enactment"
#ASSERT `s 12(4) the statement includes the subscribers' statement of no disqualification or ineligibility` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(4) the statement includes the subscribers' statement of no disqualification or ineligibility` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12(4) the statement includes the subscribers' statement of no disqualification or ineligibility` FALSE TRUE EQUALS JUST FALSE
-- "(5) Where any of the persons named as directors would be disqualified ... but for the permission of a court to act, the statement must also include a statement to that effect, in respect of each of them, specifying— (a) the person’s name, (b) the court ..., and (c) the date"
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 12(5) the statement includes what it must about permission of a court to act` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "(6) In subsection (5) “permission of a court to act” means permission of a court under a provision mentioned in column 2 of the table in section 159A(2)."
#ASSERT `s 12(6) the permission is permission of a court to act` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12(6) the permission is permission of a court to act` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12(6) the permission is permission of a court to act` NOTHING EQUALS NOTHING
-- "(7) Where any of the persons named as directors would be disqualified ... by virtue of section 11A ... but for the authority of a licence ..., the statement must also include a statement to that effect ..., specifying— (a) the person’s name, and (b) the date on which the licence was issued and by whom it was issued."
#ASSERT `s 12(7) the statement includes what it must about the authority of a licence` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 12(7) the statement includes what it must about the authority of a licence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12(7) the statement includes what it must about the authority of a licence` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 12(7) the statement includes what it must about the authority of a licence` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 12(7) the statement includes what it must about the authority of a licence` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- ---- s 12A ----
-- "(1) The statement of initial significant control ... must— (a) state whether, on incorporation, there will be anyone who is either a registrable person or a registrable relevant legal entity ..., and (b) include the required particulars of any such person."
#ASSERT `s 12A(1) the statement of initial significant control states what it must` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12A(1) the statement of initial significant control states what it must` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12A(1) the statement of initial significant control states what it must` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 12A(1) the statement of initial significant control states what it must` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12A(1) the statement of initial significant control states what it must` (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12A(1) the statement of initial significant control states what it must` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 12A(1) the statement of initial significant control states what it must` NOTHING FALSE TRUE EQUALS JUST FALSE
-- "(1A) If there is anyone who will be a registrable person ... on incorporation, the statement must also include— (a) ... none of them is disqualified ..., (b) if any of them would be so disqualified but for the permission of a court to act, a statement to that effect ..., (c) ... licence ..."
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` NOTHING TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 12A(1A) the statement includes what it must where there will be a registrable person` (JUST TRUE) TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- "(2) It is not necessary to include under subsection (1)(b) the date on which someone becomes a registrable person"
#ASSERT `s 12A(2) the statement must include the date on which someone becomes a registrable person or a registrable relevant legal entity` EQUALS JUST FALSE
-- "(3) If the statement includes required particulars of an individual, it must also contain a statement that those particulars are included with the knowledge of that individual."
#ASSERT `s 12A(3) the statement contains the statement that the particulars are included with the individual's knowledge` FALSE FALSE EQUALS NOTHING
#ASSERT `s 12A(3) the statement contains the statement that the particulars are included with the individual's knowledge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12A(3) the statement contains the statement that the particulars are included with the individual's knowledge` TRUE FALSE EQUALS JUST FALSE
-- "(4) “Registrable person”, “registrable relevant legal entity” and “required particulars” have the meanings given in Part 21A"; the second "(4)" adds "permission of a court to act"
#ASSERT `s 12A(4) the person is a registrable person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12A(4) the person is a registrable person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12A(4) the person is a registrable person` NOTHING EQUALS NOTHING
#ASSERT `s 12A(4) the entity is a registrable relevant legal entity` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12A(4) the entity is a registrable relevant legal entity` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12A(4) the entity is a registrable relevant legal entity` NOTHING EQUALS NOTHING
#ASSERT `s 12A(4) the particulars are required particulars` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12A(4) the particulars are required particulars` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12A(4) the particulars are required particulars` NOTHING EQUALS NOTHING
#ASSERT `s 12A(4) the permission is permission of a court to act` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12A(4) the permission is permission of a court to act` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12A(4) the permission is permission of a court to act` NOTHING EQUALS NOTHING

-- ---- s 12B ----
-- "(1) This section applies if an application for the registration of a company contains a statement of initial significant control that identifies a person who will be a registrable person, or a registrable relevant legal entity"
#ASSERT `s 12B(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 12B(1) this section applies` FALSE EQUALS JUST FALSE
-- "(2) In relation to any person who will be a registrable person, the statement may include a statement that the person’s identity is verified"
#ASSERT `s 12B(2) the statement may include a statement that the person's identity is verified` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12B(2) the statement may include a statement that the person's identity is verified` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 12B(2) the statement may include a statement that the person's identity is verified` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 12B(2) the statement may include a statement that the person's identity is verified` (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 12B(2) the statement may include a statement that the person's identity is verified` NOTHING (JUST TRUE) EQUALS NOTHING
-- "(3) In relation to any person who will be a registrable relevant legal entity, the statement may include a statement that— (a) specifies the name of one of its relevant officers ... who is an individual and whose identity is verified, and (b) confirms that the individual’s identity is verified."
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) (JUST TRUE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST TRUE) NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` (JUST FALSE) (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 12B(3) the statement may include a statement naming a relevant officer whose identity is verified` NOTHING (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
-- "(4) If a statement under subsection (3) is included ..., the application for registration of the company must be accompanied by a statement by the individual confirming that the individual is a relevant officer of that entity."
#ASSERT `s 12B(4) the application is accompanied by the individual's confirmation` FALSE FALSE EQUALS NOTHING
#ASSERT `s 12B(4) the application is accompanied by the individual's confirmation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 12B(4) the application is accompanied by the individual's confirmation` TRUE FALSE EQUALS JUST FALSE
-- "(6) In this section— “registrable person” has the meaning given by section 790C, except that it does not include a person mentioned in section 790C(12)(a) to (d) ...; “registrable relevant legal entity” has the meaning given by section 790C"
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 12B(6) the person is a registrable person for the purposes of section 12B` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 12B(6) the entity is a registrable relevant legal entity for the purposes of section 12B` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 12B(6) the entity is a registrable relevant legal entity for the purposes of section 12B` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 12B(6) the entity is a registrable relevant legal entity for the purposes of section 12B` NOTHING EQUALS NOTHING

-- ---- s 13 ----
-- "(1) The statement of compliance required to be delivered to the registrar is a statement that the requirements of this Act as to registration have been complied with."
#ASSERT `s 13(1) the document is a statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 13(1) the document is a statement of compliance` FALSE EQUALS JUST FALSE
-- "(2) The registrar may accept the statement of compliance as sufficient evidence of compliance."
#ASSERT `s 13(2) the registrar may accept the statement of compliance as sufficient evidence of compliance` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 13(2) the registrar may accept the statement of compliance as sufficient evidence of compliance` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 13(2) the registrar may accept the statement of compliance as sufficient evidence of compliance` NOTHING EQUALS NOTHING

-- ---- s 14 ----
-- "If the registrar is satisfied that the requirements of this Act as to registration are complied with, he shall register the documents delivered to him."
#ASSERT `s 14 the registrar shall register the documents delivered` TRUE EQUALS JUST TRUE
#ASSERT `s 14 the registrar shall register the documents delivered` FALSE EQUALS JUST FALSE
-- the registrar's duty, run (read, not asserted). Expected, in order: FULFILLED (registers); the standing obligation (nothing yet done, no time limit in the text); FULFILLED (not satisfied, so nothing is owed).
#TRACE `s 14 the registrar's duty` TRUE AT 0 WITH
    PARTY Registrar DOES `s 14 register the documents delivered to the registrar` AT 2
#TRACE `s 14 the registrar's duty` TRUE AT 0 WITH
    (WAITUNTIL 50)
#TRACE `s 14 the registrar's duty` FALSE AT 0 WITH
    (WAITUNTIL 50)

-- ---- s 15 ----
-- "(1) On the registration of a company, the registrar of companies shall give a certificate that the company is incorporated."
#ASSERT `s 15(1) the registrar shall give a certificate that the company is incorporated` TRUE EQUALS JUST TRUE
#ASSERT `s 15(1) the registrar shall give a certificate that the company is incorporated` FALSE EQUALS JUST FALSE
`s 15(2)(c) test unlimited` MEANS `Company profile` WITH
    `place of registration` IS `England and Wales`
    `liability of the members` IS `liability not limited`
    `a share capital` IS FALSE
    `certificate of incorporation stating that it is a public company` IS FALSE
`s 15(2)(c) test limited by shares` MEANS `Company profile` WITH
    `place of registration` IS `England and Wales`
    `liability of the members` IS `liability limited to the amount, if any, unpaid on the shares held`
    `a share capital` IS TRUE
    `certificate of incorporation stating that it is a public company` IS FALSE
`s 15(2)(c) test limited by guarantee` MEANS `Company profile` WITH
    `place of registration` IS `Scotland`
    `liability of the members` IS `liability limited to the amount the members undertake to contribute on a winding up`
    `a share capital` IS FALSE
    `certificate of incorporation stating that it is a public company` IS FALSE
`s 15(2)(c) test limited some other way` MEANS `Company profile` WITH
    `place of registration` IS `Northern Ireland`
    `liability of the members` IS `liability limited in some other way by the constitution`
    `a share capital` IS FALSE
    `certificate of incorporation stating that it is a public company` IS FALSE
-- "(2) The certificate must state— ... (c) whether it is a limited or unlimited company, and if it is limited whether it is limited by shares or limited by guarantee"
#ASSERT `s 15(2)(c) what the certificate must state about the liability of the members` `s 15(2)(c) test unlimited` EQUALS JUST `s 15(2)(c) that the company is an unlimited company`
#ASSERT `s 15(2)(c) what the certificate must state about the liability of the members` `s 15(2)(c) test limited by shares` EQUALS JUST `s 15(2)(c) that the company is a limited company limited by shares`
#ASSERT `s 15(2)(c) what the certificate must state about the liability of the members` `s 15(2)(c) test limited by guarantee` EQUALS JUST `s 15(2)(c) that the company is a limited company limited by guarantee`
#ASSERT `s 15(2)(c) what the certificate must state about the liability of the members` `s 15(2)(c) test limited some other way` EQUALS NOTHING
-- "(d) whether it is a private or a public company"
#ASSERT `s 15(2)(d) what the certificate must state about the company's status` TRUE EQUALS `s 15(2)(d) that the company is a public company`
#ASSERT `s 15(2)(d) what the certificate must state about the company's status` FALSE EQUALS `s 15(2)(d) that the company is a private company`
-- "(e) whether the company's registered office is situated in England and Wales (or in Wales), in Scotland or in Northern Ireland"
#ASSERT `s 15(2)(e) what the certificate must state about the registered office` `England and Wales` EQUALS "England and Wales (or in Wales)"
#ASSERT `s 15(2)(e) what the certificate must state about the registered office` `Scotland` EQUALS "Scotland"
#ASSERT `s 15(2)(e) what the certificate must state about the registered office` `Northern Ireland` EQUALS "Northern Ireland"
-- the certificate states all of (a)-(e), with (c)'s second limb only for a limited company
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE FALSE TRUE TRUE `liability not limited` EQUALS JUST TRUE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE TRUE TRUE TRUE `liability limited to the amount, if any, unpaid on the shares held` EQUALS JUST TRUE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE FALSE TRUE TRUE `liability limited to the amount, if any, unpaid on the shares held` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE FALSE TRUE TRUE `liability limited to the amount the members undertake to contribute on a winding up` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` FALSE TRUE TRUE FALSE TRUE TRUE `liability not limited` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` TRUE FALSE TRUE FALSE TRUE TRUE `liability not limited` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE FALSE FALSE TRUE TRUE `liability not limited` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE FALSE FALSE TRUE `liability not limited` EQUALS JUST FALSE
#ASSERT `s 15(2) the certificate states what it must` TRUE TRUE TRUE FALSE TRUE FALSE `liability not limited` EQUALS JUST FALSE
-- "(3) The certificate must be signed by the registrar or authenticated by the registrar's official seal."
#ASSERT `s 15(3) the certificate is signed or authenticated as required` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 15(3) the certificate is signed or authenticated as required` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 15(3) the certificate is signed or authenticated as required` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 15(3) the certificate is signed or authenticated as required` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 15(3) the certificate is signed or authenticated as required` FALSE NOTHING EQUALS NOTHING
-- "(4) The certificate is conclusive evidence that the requirements of this Act as to registration have been complied with and that the company is duly registered under this Act."
#ASSERT `s 15(4) the certificate is conclusive evidence that the requirements as to registration have been complied with and that the company is duly registered` TRUE EQUALS JUST TRUE
#ASSERT `s 15(4) the certificate is conclusive evidence that the requirements as to registration have been complied with and that the company is duly registered` FALSE EQUALS NOTHING

-- ---- s 16 ----
-- "(1) The registration of a company has the following effects as from the date of incorporation." (illustrative dates)
#ASSERT `s 16(1) the effects of registration have begun on the date` (Date 10 5 2026) (Date 10 5 2026) EQUALS JUST TRUE
#ASSERT `s 16(1) the effects of registration have begun on the date` (Date 10 5 2026) (Date 9 5 2026) EQUALS JUST FALSE
#ASSERT `s 16(1) the effects of registration have begun on the date` (Date 10 5 2026) (Date 11 5 2026) EQUALS JUST TRUE
-- "(2) The subscribers to the memorandum, together with such other persons as may from time to time become members of the company, are a body corporate by the name stated in the certificate of incorporation."
#ASSERT `s 16(2) the person is one of those who are the body corporate` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 16(2) the person is one of those who are the body corporate` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 16(2) the person is one of those who are the body corporate` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 16(2) the person is one of those who are the body corporate` TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 16(2) the person is one of those who are the body corporate` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 16(2) the name of the body corporate` "Acme Ltd" EQUALS "Acme Ltd"
-- "(3) That body corporate is capable of exercising all the functions of an incorporated company."
#ASSERT `s 16(3) the body corporate is capable of exercising all the functions of an incorporated company` TRUE EQUALS JUST TRUE
#ASSERT `s 16(3) the body corporate is capable of exercising all the functions of an incorporated company` FALSE EQUALS JUST FALSE
-- "(4) The status, registered email address and registered office of the company are as stated in, or in connection with, the application for registration."
#ASSERT (`s 16(4) the status, registered email address and registered office of the company` TRUE "a@example.org" `Scotland`)'s `status as a public company` EQUALS TRUE
#ASSERT (`s 16(4) the status, registered email address and registered office of the company` TRUE "a@example.org" `Scotland`)'s `registered email address` EQUALS "a@example.org"
#ASSERT (`s 16(4) the status, registered email address and registered office of the company` TRUE "a@example.org" `Scotland`)'s `place of the registered office` EQUALS `Scotland`
-- "(5) In the case of a company having a share capital, the subscribers to the memorandum become holders of the shares specified in the statement of capital and initial shareholdings."
#ASSERT `s 16(5) the number of shares the subscriber holds on registration` TRUE TRUE 100 EQUALS JUST 100
#ASSERT `s 16(5) the number of shares the subscriber holds on registration` TRUE FALSE 100 EQUALS NOTHING
#ASSERT `s 16(5) the number of shares the subscriber holds on registration` FALSE TRUE 100 EQUALS NOTHING
-- "(6) The persons named in the statement of proposed officers— (a) as director, or (b) as secretary or joint secretary of the company, are deemed to have been appointed to that office unless ineligible for appointment to that office by virtue of any enactment."
#ASSERT `s 16(6) the person is deemed to have been appointed to the office` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 16(6) the person is deemed to have been appointed to the office` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 16(6) the person is deemed to have been appointed to the office` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 16(6) the person is deemed to have been appointed to the office` FALSE TRUE FALSE EQUALS NOTHING
