IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa13-ch4-undersubscribed`

-- coa13-tests-ch4.l4: tests for coa13-ch4-undersubscribed.l4 (ss 578 and 579). Every expected value is written from the text of
-- the section named beside it, before the code was run. A test of a "not covered" case asserts NOTHING.

§ `Tests for Part 17, Chapter 4`

-- s 578(4): the section applies to shares offered as wholly or partly payable otherwise than in cash.
#ASSERT `s 578(4) section 578 applies to the shares as it applies to shares offered for subscription` TRUE EQUALS JUST TRUE
#ASSERT `s 578(4) section 578 applies to the shares as it applies to shares offered for subscription` FALSE EQUALS NOTHING

-- s 578(1): no allotment of shares of a public company offered for subscription unless (a) fully subscribed or (b) the offer allows allotment in any event, or if conditions are met and are met.
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- Conditions specified but not met: still prohibited.
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- A conditions-are-met fact without a term allowing allotment on conditions does not help.
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- Not a public company, or not offered: not covered by the section.
#ASSERT `s 578(1) the allotment of the shares is prohibited` FALSE TRUE NOTHING FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE FALSE NOTHING FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 578(4): shares offered as payable otherwise than in cash are treated as offered for subscription.
#ASSERT `s 578(1) the allotment of the shares is prohibited` TRUE FALSE (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE

-- s 578(2): if the allotment is prohibited and 40 days have elapsed after the first making of the offer (1 March 2026: the 40th day is 10 April), money must be repaid.
#ASSERT `s 578(2) the company must repay the money received from applicants` (JUST TRUE) (Date 1 3 2026) (Date 11 4 2026) EQUALS JUST TRUE
#ASSERT `s 578(2) the company must repay the money received from applicants` (JUST TRUE) (Date 1 3 2026) (Date 10 4 2026) EQUALS JUST FALSE
#ASSERT `s 578(2) the company must repay the money received from applicants` (JUST FALSE) (Date 1 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 578(2) the company must repay the money received from applicants` NOTHING (Date 1 3 2026) (Date 1 6 2026) EQUALS NOTHING
-- ... without interest.
#ASSERT `s 578(2) the company must pay interest on the money repaid under subsection (2)` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 578(2) the company must pay interest on the money repaid under subsection (2)` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 578(2) the company must pay interest on the money repaid under subsection (2)` NOTHING EQUALS NOTHING

-- s 578(3): defence: a director is not liable if he proves the default was not due to his misconduct or negligence.
#ASSERT `s 578(3) the director has the defence in subsection (3)` TRUE EQUALS JUST TRUE
#ASSERT `s 578(3) the director has the defence in subsection (3)` FALSE EQUALS JUST FALSE
-- s 578(3): directors are liable for money not repaid within 48 days after the first making of the offer (1 March 2026: the 48th day is 18 April).
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST TRUE) (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 19 4 2026) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST TRUE) (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 18 4 2026) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST TRUE) (Date 1 3 2026) TRUE (Date 18 4 2026) (Date 1 6 2026) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST TRUE) (Date 1 3 2026) TRUE (Date 19 4 2026) (Date 1 6 2026) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST TRUE) (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 19 4 2026) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` (JUST FALSE) (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 19 4 2026) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 578(3) the director is liable to repay the money, with interest` NOTHING (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 19 4 2026) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 578(3) the 48th day after the first making of the offer, from the expiration of which interest runs` (Date 1 3 2026) EQUALS Date 18 4 2026

-- s 578(5): in a non-cash offer, subscription is construed accordingly, and interest applies accordingly.
#ASSERT `s 578(5)(a) the references in subsection (1) to subscription are construed accordingly` TRUE EQUALS JUST TRUE
#ASSERT `s 578(5)(a) the references in subsection (1) to subscription are construed accordingly` FALSE EQUALS NOTHING
#ASSERT `s 578(5)(c) the references to interest apply accordingly` TRUE EQUALS JUST TRUE
#ASSERT `s 578(5)(c) the references to interest apply accordingly` FALSE EQUALS NOTHING
-- s 578(5)(b): repayment includes returning other consideration, or paying its value if it is not reasonably practicable to return it.
#ASSERT `s 578(5)(b) the applicant's consideration is repaid by` TRUE TRUE 500 EQUALS `s 578(5)(b)(i) the consideration is returned (and, if the case so requires, the applicant is released from any undertaking)`
#ASSERT `s 578(5)(b) the applicant's consideration is repaid by` TRUE FALSE 500 EQUALS `s 578(5)(b)(ii) money is paid equal to the value of the consideration at the time it was received` 500
#ASSERT `s 578(5)(b) the applicant's consideration is repaid by` FALSE TRUE 500 EQUALS `s 578(5)(b) the consideration was money, so the subsection adds nothing`

-- s 578(6): a condition requiring an applicant to waive compliance is void.
#ASSERT `s 578(6) the condition is void` TRUE EQUALS JUST TRUE
#ASSERT `s 578(6) the condition is void` FALSE EQUALS NOTHING

-- s 579(1): voidable at the instance of the applicant within one month after the date of the allotment, and not later (allotment 15 January 2026: 15 February).
#ASSERT `s 579(1) the allotment is voidable at the instance of the applicant` TRUE TRUE (Date 15 1 2026) (Date 15 2 2026) EQUALS JUST TRUE
#ASSERT `s 579(1) the allotment is voidable at the instance of the applicant` TRUE TRUE (Date 15 1 2026) (Date 16 2 2026) EQUALS JUST FALSE
#ASSERT `s 579(1) the allotment is voidable at the instance of the applicant` FALSE TRUE (Date 15 1 2026) (Date 15 2 2026) EQUALS NOTHING
#ASSERT `s 579(1) the allotment is voidable at the instance of the applicant` TRUE FALSE (Date 15 1 2026) (Date 15 2 2026) EQUALS NOTHING
-- s 579(2): so voidable even if the company is being wound up.
#ASSERT `s 579(2) the allotment is voidable although the company is being wound up` TRUE EQUALS JUST TRUE
#ASSERT `s 579(2) the allotment is voidable although the company is being wound up` FALSE EQUALS NOTHING
-- s 579(3): a director of a public company who knowingly contravenes s 578 is liable to compensate the company and the allottee.
#ASSERT `s 579(3) the director is liable to compensate the company and the allottee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 579(3) the director is liable to compensate the company and the allottee` FALSE TRUE EQUALS NOTHING
#ASSERT `s 579(3) the director is liable to compensate the company and the allottee` TRUE FALSE EQUALS NOTHING
#ASSERT `s 579(3) the amount the director is liable to compensate the company or the allottee` 1200 EQUALS 1200
-- s 579(4): proceedings may not be brought more than two years after the date of the allotment (15 January 2026: 15 January 2028).
#ASSERT `s 579(4) the proceedings may be brought` (Date 15 1 2026) (Date 15 1 2028) EQUALS NOTHING
#ASSERT `s 579(4) the proceedings may be brought` (Date 15 1 2026) (Date 16 1 2028) EQUALS JUST FALSE
