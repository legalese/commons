IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-requirements`

-- coa4-tests-requirements.l4: tests for coa4-requirements.l4 (ss 154 to 156C). Every expected value is written
-- from the text of the section named beside it, before the code was run; none is copied from the encoding's output.
-- The pounds a level on the standard scale stands for are not in the Act: the numbers below are invented round
-- figures used only to test the arithmetic.

-- s 154(1): "A private company must have at least one director."
#ASSERT `s 154(1) the private company meets the requirement to have at least one director` TRUE 1 EQUALS JUST TRUE
#ASSERT `s 154(1) the private company meets the requirement to have at least one director` TRUE 5 EQUALS JUST TRUE
#ASSERT `s 154(1) the private company meets the requirement to have at least one director` TRUE 0 EQUALS JUST FALSE
-- a company that is not private: the subsection says nothing of it
#ASSERT `s 154(1) the private company meets the requirement to have at least one director` FALSE 0 EQUALS NOTHING
#ASSERT `s 154(1) the private company meets the requirement to have at least one director` FALSE 3 EQUALS NOTHING

-- s 154(2): "A public company must have at least two directors."
#ASSERT `s 154(2) the public company meets the requirement to have at least two directors` TRUE 2 EQUALS JUST TRUE
#ASSERT `s 154(2) the public company meets the requirement to have at least two directors` TRUE 3 EQUALS JUST TRUE
#ASSERT `s 154(2) the public company meets the requirement to have at least two directors` TRUE 1 EQUALS JUST FALSE
#ASSERT `s 154(2) the public company meets the requirement to have at least two directors` TRUE 0 EQUALS JUST FALSE
#ASSERT `s 154(2) the public company meets the requirement to have at least two directors` FALSE 1 EQUALS NOTHING

-- s 155(1): "A company must have at least one director who is a natural person."
#ASSERT `s 155(1) the company meets the requirement to have at least one director who is a natural person` 1 EQUALS JUST TRUE
#ASSERT `s 155(1) the company meets the requirement to have at least one director who is a natural person` 4 EQUALS JUST TRUE
#ASSERT `s 155(1) the company meets the requirement to have at least one director who is a natural person` 0 EQUALS JUST FALSE

-- s 155(2): "This requirement is met if the office of director is held by a natural person as a corporation sole or otherwise by virtue of an office."
#ASSERT `s 155(2) the requirement is met by the office of director being held by a natural person as a corporation sole or by virtue of an office` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 155(2) the requirement is met by the office of director being held by a natural person as a corporation sole or by virtue of an office` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 155(2) the requirement is met by the office of director being held by a natural person as a corporation sole or by virtue of an office` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 155(2) the requirement is met by the office of director being held by a natural person as a corporation sole or by virtue of an office` FALSE FALSE EQUALS JUST FALSE

-- s 156(1): the Secretary of State may give a direction if it appears that the company is in breach of s 154 or s 155.
#ASSERT `s 156(1) the Secretary of State may give the company a direction under section 156` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 156(1) the Secretary of State may give the company a direction under section 156` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 156(1) the Secretary of State may give the company a direction under section 156` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 156(1) the Secretary of State may give the company a direction under section 156` FALSE FALSE EQUALS JUST FALSE; s 156(1) is a grant ("may give") behind an "If it appears" gate: when the gate fails the text does not say the power is withheld, so the answer is NOTHING (name-test sweep, F4)
#ASSERT `s 156(1) the Secretary of State may give the company a direction under section 156` FALSE FALSE EQUALS NOTHING

-- s 156(2)(a)-(c): the direction must specify all three things.
#ASSERT `s 156(2) the direction specifies what the section requires it to specify` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156(2) the direction specifies what the section requires it to specify` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 156(2) the direction specifies what the section requires it to specify` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 156(2) the direction specifies what the section requires it to specify` TRUE TRUE FALSE EQUALS JUST FALSE

-- s 156(2), last sentence: not less than one month or more than three months after the day the direction is given.
-- Direction given 15 January 2025: the period may end from 15 February to 15 April 2025, both days included.
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 15 2 2025) EQUALS JUST TRUE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 14 2 2025) EQUALS JUST FALSE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 15 3 2025) EQUALS JUST TRUE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 15 4 2025) EQUALS JUST TRUE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 16 4 2025) EQUALS JUST FALSE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 1 2025) (Date 20 1 2025) EQUALS JUST FALSE
-- across a year end: given 15 November 2024, the window runs from 15 December 2024 to 15 February 2025
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 11 2024) (Date 15 2 2025) EQUALS JUST TRUE
#ASSERT `s 156(2) the period the direction specifies is not less than one month or more than three months after the day the direction is given` (Date 15 11 2024) (Date 16 2 2025) EQUALS JUST FALSE

-- s 156(3): the direction must also inform the company of the consequences of failing to comply.
#ASSERT `s 156(3) the direction informs the company of the consequences of failing to comply as the section requires` TRUE EQUALS JUST TRUE
#ASSERT `s 156(3) the direction informs the company of the consequences of failing to comply as the section requires` FALSE EQUALS JUST FALSE

-- s 156(4): where in breach, appointments AND notice before the end of the period.
#ASSERT `s 156(4) the company has complied with the direction by making the appointments and giving notice of them` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156(4) the company has complied with the direction by making the appointments and giving notice of them` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 156(4) the company has complied with the direction by making the appointments and giving notice of them` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 156(4) the company has complied with the direction by making the appointments and giving notice of them` FALSE TRUE TRUE EQUALS NOTHING

-- s 156(5): where the company has already made the appointments, notice before the end of the period suffices.
#ASSERT `s 156(5) the company has complied with the direction by giving notice of the appointments already made` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156(5) the company has complied with the direction by giving notice of the appointments already made` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 156(5) the company has complied with the direction by giving notice of the appointments already made` FALSE TRUE EQUALS NOTHING

-- s 156(5A): "Nothing in subsection (4) or (5) affects the duty imposed by section 167G"
#ASSERT `s 156(5A) complying with the direction discharges the duty under section 167G to give notice within the period in section 167G(6)` EQUALS JUST FALSE

-- s 156(4) as a regulative rule: both duties within the period (30 days in these runs). Read the results below:
-- both done in time is FULFILLED; either missed is a BREACH naming the company and the duty missed.
-- (A DEONTIC value cannot be compared in #ASSERT on the stable binary: see NOTES.md, "What the stable binary does not accept".)
#TRACE `s 156(4) the company's duty to comply with the direction` 30 AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, `Secretary of State`, "make the necessary appointment or appointments" AT 10
    PARTY Company DOES `Action of a party` OF Company, `Secretary of State`, "give notice of them under section 167G" AT 20
#TRACE `s 156(4) the company's duty to comply with the direction` 30 AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, `Secretary of State`, "make the necessary appointment or appointments" AT 30
    PARTY Company DOES `Action of a party` OF Company, `Secretary of State`, "give notice of them under section 167G" AT 30
#TRACE `s 156(4) the company's duty to comply with the direction` 30 AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, `Secretary of State`, "make the necessary appointment or appointments" AT 10
    (WAITUNTIL 31)
#TRACE `s 156(4) the company's duty to comply with the direction` 30 AT 0 WITH
    (WAITUNTIL 31)

-- s 156(6)(a): the company commits an offence if it fails to comply with the direction.
#ASSERT `s 156(6)(a) the company commits an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 156(6)(a) the company commits an offence` FALSE EQUALS JUST FALSE

-- s 156(6)(b): every officer who is in default; a shadow director is treated as an officer.
-- arguments: the company failed to comply; officer (s 1173(1)); shadow director (s 251); in default (s 1121)
#ASSERT `s 156(6)(b) the officer in default commits the offence` FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE NOTHING (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 156(6)(b) the officer in default commits the offence` TRUE NOTHING (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- s 156(7): the penalty on summary conviction (first wording): level 5, and a daily default fine of one-tenth of level 5.
#ASSERT `s 156(7) the penalty for the offence, under the wording ending one-tenth of level 5 on the standard scale` `on summary conviction` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 156(7) the penalty for the offence, under the wording ending one-tenth of level 5 on the standard scale` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 156(7) the penalty for the offence, under the wording ending one-tenth of level 5 on the standard scale` `on summary conviction in Scotland` EQUALS NOTHING

-- s 156(7) second wording: one-tenth of the greater of 5,000 and level 4 (invented level 4 figures: 2,500 and 8,000)
#ASSERT `s 156(7) the daily default fine limit in pounds under the wording one-tenth of the greater of 5000 pounds or level 4 on the standard scale` (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS 500
#ASSERT `s 156(7) the daily default fine limit in pounds under the wording one-tenth of the greater of 5000 pounds or level 4 on the standard scale` (`s 156(7) standard scale in pounds` OF 20000, 8000, 10000) EQUALS 800
#ASSERT `s 156(7) the daily default fine limit in pounds under the wording one-tenth of the greater of 5000 pounds or level 4 on the standard scale` (`s 156(7) standard scale in pounds` OF 20000, 5000, 10000) EQUALS 500

-- a fine limit in pounds, from invented scale figures: statutory maximum 20,000; level 4 2,500; level 5 10,000
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 5 0.1) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS JUST 1000
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 5 1) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS JUST 10000
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 4 1) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS JUST 2500
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 3 1) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS NOTHING
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding the statutory maximum` 1) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS JUST 20000
#ASSERT `s 156(7) the fine limit in pounds` (`a fine not exceeding an amount in pounds` 750) (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS JUST 750
#ASSERT `s 156(7) the fine limit in pounds` `a fine without a stated limit` (`s 156(7) standard scale in pounds` OF 20000, 2500, 10000) EQUALS NOTHING

-- s 156A(1): "may not be appointed ... unless the person is a natural person"; (2) corporation sole; (5) regulations.
-- arguments: natural person; holds the office as a natural person as corporation sole or by virtue of an office; regulations allow
#ASSERT `s 156A(1) section 156A(1) bars the appointment of the person as a director` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 156A(1) section 156A(1) bars the appointment of the person as a director` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 156A(1) section 156A(1) bars the appointment of the person as a director` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 156A(1) section 156A(1) bars the appointment of the person as a director` FALSE FALSE TRUE EQUALS NOTHING

-- s 156A(3): an appointment made in contravention is void.
#ASSERT `s 156A(3) the appointment made is void` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156A(3) the appointment made is void` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 156A(3) the appointment made is void` NOTHING EQUALS NOTHING

-- s 156A(4): liability is unaffected for a person who purports to act, or acts as shadow director, though not validly appointed.
#ASSERT `s 156A(4) section 156A leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 156A(4) section 156A leaves the person's liability unaffected` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156A(4) section 156A leaves the person's liability unaffected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 156A(4) section 156A leaves the person's liability unaffected` FALSE FALSE TRUE EQUALS NOTHING

-- s 156A(6): who commits the offence.
#ASSERT `s 156A(6)(a) the company purporting to make the appointment commits an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 156A(6)(a) the company purporting to make the appointment commits an offence` FALSE EQUALS JUST FALSE
#ASSERT `s 156A(6)(b) the body corporate or firm purportedly appointed commits an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156A(6)(b) the body corporate or firm purportedly appointed commits an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 156A(6)(b) the body corporate or firm purportedly appointed commits an offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 156A(6)(c) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156A(6)(c) the officer in default commits the offence` FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 156A(6)(c) the officer in default commits the offence` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 156A(6)(c) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

-- s 156A(7): (a) in England and Wales, a fine; (b) in Scotland or Northern Ireland, level 5.
#ASSERT `s 156A(7) the penalty for the offence` `on summary conviction in England and Wales` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 156A(7) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 156A(7) the penalty for the offence` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 156A(7) the penalty for the offence` `on summary conviction` EQUALS NOTHING
#ASSERT `s 156A(7) the penalty for the offence` `on conviction on indictment` EQUALS NOTHING

-- s 156C(1): the day after the end of the 12 months beginning with the day s 156A comes into force.
-- Section 156A in force on 15 March 2025 (invented day): the 12 months end on 14 March 2026; the relevant day is 15 March 2026.
#ASSERT `s 156C(1) the relevant day` (Date 15 3 2025) EQUALS Date 15 3 2026
#ASSERT `s 156C(1) the relevant day` (Date 1 1 2025) EQUALS Date 1 1 2026

-- s 156C(2): a pre-commencement appointee who is not a natural person ceases to hold office on the relevant day.
-- arguments: commencement day; appointed before commencement; not a natural person; excepted by regulations; the day in question
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) TRUE TRUE FALSE (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) TRUE TRUE FALSE (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) TRUE TRUE FALSE (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) FALSE TRUE FALSE (Date 16 3 2026) EQUALS JUST FALSE
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) TRUE FALSE FALSE (Date 16 3 2026) EQUALS JUST FALSE
#ASSERT `s 156C(2) the person has ceased to hold office by virtue of that appointment` (Date 15 3 2025) TRUE TRUE TRUE (Date 16 3 2026) EQUALS JUST FALSE

-- s 156C(2A): liability unaffected for a person who has ceased and then purports to act or acts as shadow director.
#ASSERT `s 156C(2A) section 156C leaves the person's liability unaffected` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 156C(2A) section 156C leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 156C(2A) section 156C leaves the person's liability unaffected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 156C(2A) section 156C leaves the person's liability unaffected` FALSE TRUE FALSE EQUALS NOTHING

-- s 156C(3): the registrar must note a company's failure to give notice that a person ceased to be a director.
#ASSERT `s 156C(3) the registrar must include a note in the register recording that the company failed to give notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 156C(3) the registrar must include a note in the register recording that the company failed to give notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 156C(3) the registrar must include a note in the register recording that the company failed to give notice` FALSE TRUE EQUALS JUST FALSE
