IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa12-logic`
IMPORT `coa12-ch4a-removal`

-- coa12-tests-ch4a.l4: tests for coa12-ch4a-removal.l4 (ss 510-515). Expected values are decided from the text and typed in the
-- script that makes this file; the script only keeps the argument lists aligned. Argument order is the GIVEN order of each function.

-- s 510(1)
#ASSERT `s 510(1) the members may remove the auditor from office` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 510(1) the members may remove the auditor from office` TRUE FALSE EQUALS NOTHING
#ASSERT `s 510(1) the members may remove the auditor from office` FALSE TRUE EQUALS NOTHING
-- s 510(2): an ordinary resolution at a meeting, after special notice
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
-- a special resolution does what an ordinary one may (s 282(5): fork F7)
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
-- not at a meeting (a written resolution)
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` (JUST TRUE) (JUST FALSE) FALSE TRUE EQUALS JUST FALSE
-- no special notice
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` (JUST TRUE) (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` NOTHING (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 510(2) the power to remove the auditor has been exercised as the subsection requires` NOTHING NOTHING TRUE FALSE EQUALS JUST FALSE
-- s 510(3)
#ASSERT `s 510(3) the section deprives the person removed of the compensation or damages` TRUE EQUALS JUST FALSE
#ASSERT `s 510(3) the section deprives the person removed of the compensation or damages` FALSE EQUALS NOTHING
-- s 510(4): neither route
#ASSERT `s 510(4) the auditor is barred from removal before the expiration of his term of office` TRUE FALSE FALSE EQUALS JUST TRUE
-- by resolution under s 510
#ASSERT `s 510(4) the auditor is barred from removal before the expiration of his term of office` TRUE TRUE FALSE EQUALS JUST FALSE
-- in accordance with s 511A
#ASSERT `s 510(4) the auditor is barred from removal before the expiration of his term of office` TRUE FALSE TRUE EQUALS JUST FALSE
-- not before the term ends
#ASSERT `s 510(4) the auditor is barred from removal before the expiration of his term of office` FALSE FALSE FALSE EQUALS NOTHING
-- s 511(1)
#ASSERT `s 511(1) special notice is required for the resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 511(1) special notice is required for the resolution` TRUE FALSE EQUALS NOTHING
#ASSERT `s 511(1) special notice is required for the resolution` FALSE TRUE EQUALS NOTHING
-- s 511(2)
#ASSERT `s 511(2) the company must immediately send a copy of the notice to the auditor proposed to be removed` TRUE EQUALS JUST TRUE
#ASSERT `s 511(2) the company must immediately send a copy of the notice to the auditor proposed to be removed` FALSE EQUALS JUST FALSE
-- s 511(3)
#ASSERT `s 511(3) the auditor may make representations and request their notification to members` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 511(3) the auditor may make representations and request their notification to members` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 511(3) the auditor may make representations and request their notification to members` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 511(3) the auditor may make representations and request their notification to members` TRUE TRUE FALSE EQUALS NOTHING
-- s 511(4)
#ASSERT `s 511(4) the company must state the fact of the representations in its notice and send a copy to every member to whom notice is sent` TRUE FALSE EQUALS JUST TRUE
-- received too late: "unless"
#ASSERT `s 511(4) the company must state the fact of the representations in its notice and send a copy to every member to whom notice is sent` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 511(4) the company must state the fact of the representations in its notice and send a copy to every member to whom notice is sent` FALSE FALSE EQUALS NOTHING
#ASSERT `s 511(4) the company must state the fact of the representations in its notice and send a copy to every member to whom notice is sent` FALSE TRUE EQUALS NOTHING
-- s 511(5)
#ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` TRUE FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` TRUE FALSE FALSE EQUALS JUST FALSE; the function is named for a grant or a power and its plain "if" gate fails, so it now answers NOTHING, not JUST FALSE (name-test sweep of 2026-11-12, fork F16); the text does not say the grant is refused
#ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` TRUE FALSE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` FALSE TRUE FALSE EQUALS JUST FALSE; the function is named for a grant or a power and its plain "if" gate fails, so it now answers NOTHING, not JUST FALSE (name-test sweep of 2026-11-12, fork F16); the text does not say the grant is refused
#ASSERT `s 511(5) the auditor may require that the representations be read out at the meeting` FALSE TRUE FALSE EQUALS NOTHING
-- s 511(6)
#ASSERT `s 511(6) copies of the representations need not be sent out and the representations need not be read at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 511(6) copies of the representations need not be sent out and the representations need not be read at the meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 511(6) copies of the representations need not be sent out and the representations need not be read at the meeting` FALSE TRUE EQUALS JUST FALSE
