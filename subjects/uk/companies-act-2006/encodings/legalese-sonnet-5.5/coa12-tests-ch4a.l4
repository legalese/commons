#ASSERT `s 511A(2) the competent authority may apply to the court for an order removing the auditor` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 511A(2) the competent authority may apply to the court for an order removing the auditor` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 511A(2) the competent authority may apply to the court for an order removing the auditor` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 511A(2) the competent authority may apply to the court for an order removing the auditor` NOTHING TRUE TRUE EQUALS NOTHING
