#ASSERT `s 689(2) the notice is accompanied by a statement of capital` TRUE EQUALS JUST TRUE
#ASSERT `s 689(2) the notice is accompanied by a statement of capital` FALSE EQUALS JUST FALSE

`fixture: an entry` MEANS `s 663(3) class entry` WITH
    `s 663(3) states prescribed particulars of the rights attached to the shares of the class` IS TRUE
    `s 663(3) states the total number of shares of the class` IS TRUE
    `s 663(3) states the aggregate nominal value of the shares of the class` IS TRUE

`fixture: an entry missing the nominal value` MEANS `s 663(3) class entry` WITH
    `s 663(3) states prescribed particulars of the rights attached to the shares of the class` IS TRUE
    `s 663(3) states the total number of shares of the class` IS TRUE
    `s 663(3) states the aggregate nominal value of the shares of the class` IS FALSE

`fixture: a statement` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS TRUE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS TRUE
    `s 663(3) entries for the classes of shares` IS LIST `fixture: an entry`

`fixture: a statement without the amount unpaid` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS TRUE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS FALSE
    `s 663(3) entries for the classes of shares` IS LIST `fixture: an entry`

`fixture: a statement with a short class entry` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS TRUE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS TRUE
    `s 663(3) entries for the classes of shares` IS LIST `fixture: an entry missing the nominal value`

`fixture: a statement with no class entry` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS TRUE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS TRUE
    `s 663(3) entries for the classes of shares` IS EMPTY

#ASSERT `s 689(3) the statement of capital states what the section requires` `fixture: a statement` EQUALS JUST TRUE
#ASSERT `s 689(3) the statement of capital states what the section requires` `fixture: a statement without the amount unpaid` EQUALS JUST FALSE
#ASSERT `s 689(3) the statement of capital states what the section requires` `fixture: a statement with a short class entry` EQUALS JUST FALSE
#ASSERT `s 689(3) the statement of capital states what the section requires` `fixture: a statement with no class entry` EQUALS NOTHING

#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) the company` NOTHING EQUALS JUST TRUE
#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) an officer of the company` NOTHING EQUALS NOTHING
#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) a director of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 689(4) the person commits an offence` TRUE `s 658(2) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 689(4) the person commits an offence` FALSE `s 658(2) the company` NOTHING EQUALS JUST FALSE
#ASSERT `s 689(5) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 689(5) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 689(5) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 689(5) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 689(5) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
