IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch1`
IMPORT `coa15-ch3`

-- coa15-tests-ch3.l4: tests of coa15-ch3.l4 (ss 684 to 689). Expected values are written from the text before the run.

#ASSERT `s 684(1) the shares are redeemable shares` TRUE EQUALS JUST TRUE
#ASSERT `s 684(1) the shares are redeemable shares` FALSE EQUALS JUST FALSE
#ASSERT `s 684(1) the company may issue redeemable shares` TRUE EQUALS JUST TRUE
#ASSERT `s 684(1) the company may issue redeemable shares` FALSE EQUALS NOTHING
#ASSERT `s 684(2) the articles may exclude or restrict the issue of redeemable shares` TRUE EQUALS JUST TRUE
#ASSERT `s 684(2) the articles may exclude or restrict the issue of redeemable shares` FALSE EQUALS NOTHING
#ASSERT `s 684(3) the public limited company may issue redeemable shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 684(3) the public limited company may issue redeemable shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 684(3) the public limited company may issue redeemable shares` FALSE TRUE EQUALS NOTHING
#ASSERT `s 684(4) the issue of redeemable shares is barred` TRUE EQUALS JUST TRUE
#ASSERT `s 684(4) the issue of redeemable shares is barred` FALSE EQUALS JUST FALSE

#ASSERT `s 685(1) the directors may determine the terms, conditions and manner of redemption` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 685(1) the directors may determine the terms, conditions and manner of redemption` TRUE FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 685(1) the directors may determine the terms, conditions and manner of redemption` TRUE FALSE FALSE EQUALS JUST FALSE`; the function is named for a grant or a power and its "if" gate fails here, so it answers NOTHING and not JUST FALSE (fork F-grant-685-1)
#ASSERT `s 685(1) the directors may determine the terms, conditions and manner of redemption` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 685(1) the directors may determine the terms, conditions and manner of redemption` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 685(2) the resolution is a good resolution under subsection (1)(b)` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 685(2) the resolution is a good resolution under subsection (1)(b)` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 685(2) the resolution is a good resolution under subsection (1)(b)` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 685(2) the resolution is a good resolution under subsection (1)(b)` FALSE (JUST TRUE) EQUALS NOTHING
-- the directors must determine the terms before the shares are allotted: allotment on 10 June 2026
#ASSERT `s 685(3)(a) the directors determined the terms before the shares were allotted` TRUE (Date 9 6 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `s 685(3)(a) the directors determined the terms before the shares were allotted` TRUE (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST FALSE
#ASSERT `s 685(3)(a) the directors determined the terms before the shares were allotted` TRUE (Date 11 6 2026) (Date 10 6 2026) EQUALS JUST FALSE
#ASSERT `s 685(3)(a) the directors determined the terms before the shares were allotted` FALSE (Date 9 6 2026) (Date 10 6 2026) EQUALS JUST FALSE
-- 1 June to 10 June is 9 days, so the last day before the allotment is day 8 (9 June)
-- expect: FULFILLED
#TRACE `s 685(3)(a) the directors must determine the terms before the shares are allotted` (Date 1 6 2026) (Date 10 6 2026) AT 0 WITH
    PARTY Director DOES `s 685(3)(a) determine the terms, conditions and manner of redemption of the shares` AT 8
-- expect: BREACH
#TRACE `s 685(3)(a) the directors must determine the terms before the shares are allotted` (Date 1 6 2026) (Date 10 6 2026) AT 0 WITH
    PARTY Director DOES `s 685(3)(a) determine the terms, conditions and manner of redemption of the shares` AT 9
#ASSERT `s 685(3)(b) the obligation to state the rights extends to the terms, conditions and manner of redemption` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 685(3)(b) the obligation to state the rights extends to the terms, conditions and manner of redemption` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 685(3)(b) the obligation to state the rights extends to the terms, conditions and manner of redemption` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 685(4) the terms, conditions and manner of redemption must be stated in the company's articles` FALSE EQUALS JUST TRUE
#ASSERT `s 685(4) the terms, conditions and manner of redemption must be stated in the company's articles` TRUE EQUALS JUST FALSE

#ASSERT `s 686(1) the redemption is barred` TRUE EQUALS JUST FALSE
#ASSERT `s 686(1) the redemption is barred` FALSE EQUALS JUST TRUE
#ASSERT `s 686(2) the terms of redemption may provide for payment on a later date` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 686(2) the terms of redemption may provide for payment on a later date` TRUE FALSE EQUALS NOTHING
#ASSERT `s 686(2) the terms of redemption may provide for payment on a later date` FALSE TRUE EQUALS NOTHING
#ASSERT `s 686(3) the shares must be paid for on redemption` FALSE EQUALS JUST TRUE
#ASSERT `s 686(3) the shares must be paid for on redemption` TRUE EQUALS JUST FALSE
-- expect: FULFILLED
#TRACE `s 686(3) the company must pay for the shares on redemption` AT 0 WITH
    PARTY Company DOES `s 686(3) pay for the shares on redemption` AT 0
-- (the text states no period: the duty stands until it is done)
-- expect: RESIDUAL
#TRACE `s 686(3) the company must pay for the shares on redemption` AT 0 WITH
    (WAITUNTIL 40)

#ASSERT `s 687(1) the private limited company may redeem the shares out of capital` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 687(1) the private limited company may redeem the shares out of capital` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 687(1) the private limited company may redeem the shares out of capital` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 687(1) the private limited company may redeem the shares out of capital` FALSE (JUST TRUE) EQUALS NOTHING
-- arguments: s 687(1), out of distributable profits, out of the proceeds of a fresh issue
