#ASSERT `s 687(2) the redemption is out of a source the section permits` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 687(2) the redemption is out of a source the section permits` (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 687(2) the redemption is out of a source the section permits` (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 687(2) the redemption is out of a source the section permits` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 687(2) the redemption is out of a source the section permits` NOTHING TRUE FALSE EQUALS JUST TRUE
-- subsection (4): the lesser of the premiums received on the issue and the share premium account
#ASSERT `s 687(4) the most of the premium that may be paid out of the proceeds of a fresh issue` TRUE 300 500 EQUALS 300
#ASSERT `s 687(4) the most of the premium that may be paid out of the proceeds of a fresh issue` TRUE 500 300 EQUALS 300
#ASSERT `s 687(4) the most of the premium that may be paid out of the proceeds of a fresh issue` TRUE 400 400 EQUALS 400
#ASSERT `s 687(4) the most of the premium that may be paid out of the proceeds of a fresh issue` FALSE 500 500 EQUALS 0
#ASSERT `s 687(3) the part of the premium that must be paid out of distributable profits` 350 300 EQUALS 50
#ASSERT `s 687(3) the part of the premium that must be paid out of distributable profits` 300 300 EQUALS 0
#ASSERT `s 687(3) the part of the premium that must be paid out of distributable profits` 200 300 EQUALS 0
#ASSERT `s 687(3) the part of the premium that must be paid out of distributable profits` 200 0 EQUALS 200
