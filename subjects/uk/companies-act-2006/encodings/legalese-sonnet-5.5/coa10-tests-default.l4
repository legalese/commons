IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-default`

-- coa10-tests-default.l4: tests for coa10-default.l4 (ss 451 to 453). Every expected value was written down from the text
-- of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 451(1): the offence (line 6125) ----
-- not complied with, and a director immediately before the end of the period: an offence
#ASSERT `s 451(1) the person commits an offence` (JUST FALSE) TRUE EQUALS JUST TRUE
-- not complied with, but not a director then: the text names only directors, so not covered
#ASSERT `s 451(1) the person commits an offence` (JUST FALSE) FALSE EQUALS NOTHING
-- complied with before the end of the period: no offence
#ASSERT `s 451(1) the person commits an offence` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 451(1) the person commits an offence` (JUST TRUE) FALSE EQUALS JUST FALSE
-- not known
#ASSERT `s 451(1) the person commits an offence` NOTHING TRUE EQUALS NOTHING

-- ---- s 451(2), (3): the defence (lines 6126-6127) ----
#ASSERT `s 451(2) this section gives the person a defence on these facts` TRUE EQUALS JUST TRUE
#ASSERT `s 451(2) this section gives the person a defence on these facts` FALSE EQUALS JUST FALSE
#ASSERT `s 451(3) proving that the documents were not prepared as required is a defence to the offence` TRUE EQUALS JUST FALSE
#ASSERT `s 451(3) proving that the documents were not prepared as required is a defence to the offence` FALSE EQUALS NOTHING

-- ---- s 451(4): guilty of an offence = the offence committed and no defence made out ----
#ASSERT `s 451(4) the person is guilty of an offence under section 451` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 451(4) the person is guilty of an offence under section 451` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 451(4) the person is guilty of an offence under section 451` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 451(4) the person is guilty of an offence under section 451` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 451(4) the person is guilty of an offence under section 451` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 451(4) the person is guilty of an offence under section 451` NOTHING (JUST FALSE) EQUALS NOTHING

-- ---- s 451(4): the penalty (line 6128) ----
-- First text: on summary conviction, a fine not exceeding level 5 and, for continued contravention, a daily default fine not exceeding one-tenth of level 5.
#ASSERT (`s 451(4) the penalty in the first text`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 451(4) the penalty in the first text`)'s `imprisonment not exceeding` EQUALS NOTHING
#ASSERT (`s 451(4) the penalty in the first text`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 451(4) the penalty in the first text`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 0.1)
#ASSERT NOT (`s 451(4) the penalty in the first text`)'s `imprisonment and fine together`
-- Second text: the same fine, and a daily default fine of one-tenth of the greater of 5,000 pounds or level 4.
#ASSERT (`s 451(4) the penalty in the second text`)'s `s 451 how convicted` EQUALS `on summary conviction`
#ASSERT (`s 451(4) the penalty in the second text`)'s `s 451 the fine not exceeding level 5 on the standard scale` EQUALS `a fine not exceeding a level on the standard scale` 5 1
#ASSERT (`s 451(4) the penalty in the second text`)'s `s 451 the daily default fine for continued contravention` EQUALS `s 451 one-tenth of the greater of £5,000 or level 4 on the standard scale`
-- In pounds. The amounts of the levels are not in the Act; these tests assume level 5 is 5,000 and, in turn, level 4 is 2,500, 5,000 and 6,000.
#ASSERT `s 451(4) the greatest fine on summary conviction in pounds` 5000 EQUALS 5000
-- first text: one-tenth of level 5 = 500
#ASSERT `s 451(4) the greatest daily default fine in pounds` `s 441 first text in the file` 2500 5000 EQUALS 500
-- second text: the greater of 5,000 and level 4, a tenth of it
#ASSERT `s 451(4) the greatest daily default fine in pounds` `s 441 second text in the file` 2500 5000 EQUALS 500
#ASSERT `s 451(4) the greatest daily default fine in pounds` `s 441 second text in the file` 5000 5000 EQUALS 500
#ASSERT `s 451(4) the greatest daily default fine in pounds` `s 441 second text in the file` 6000 5000 EQUALS 600

-- ---- s 452(1)(b): 14 days after the service of the notice (line 6132) ----
-- Served 1 March 2026: the last day is 15 March 2026.
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) (JUST (Date 15 3 2026)) (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) (JUST (Date 16 3 2026)) (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) (JUST (Date 1 3 2026)) (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) NOTHING (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) NOTHING (Date 15 3 2026) EQUALS NOTHING
#ASSERT `s 452(1)(b) the directors failed to make good the default within 14 days after the service of the notice` (Date 1 3 2026) NOTHING (Date 10 3 2026) EQUALS NOTHING

-- ---- s 452(1): the court may order (lines 6130-6133) ----
#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST FALSE) (JUST TRUE) FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F19)
#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F19)
#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST FALSE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 452(1) the court may order the directors to make good the default` (JUST FALSE) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 452(1) the court may order the directors to make good the default` NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 452(2) the court's order may provide that all the costs are borne by the directors` TRUE EQUALS JUST TRUE
#ASSERT `s 452(2) the court's order may provide that all the costs are borne by the directors` FALSE EQUALS NOTHING

-- ---- s 453: civil penalty (lines 6136-6142) ----
#ASSERT `s 453(1) the company is liable to a civil penalty` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 453(1) the company is liable to a civil penalty` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 453(1) the company is liable to a civil penalty` NOTHING EQUALS NOTHING
#ASSERT `s 453(1) the company's liability is in addition to the directors' liability under section 451` TRUE EQUALS JUST TRUE
#ASSERT `s 453(1) the company's liability is in addition to the directors' liability under section 451` FALSE EQUALS NOTHING
-- Period for filing ended 30 Sep 2026; complied with on 14 Oct 2026: 14 days; on the last day itself: 0.
#ASSERT `s 453(2)(a) the number of days between the end of the period for filing and the day on which the requirements are complied with` (Date 30 9 2026) (Date 14 10 2026) EQUALS 14
#ASSERT `s 453(2)(a) the number of days between the end of the period for filing and the day on which the requirements are complied with` (Date 30 9 2026) (Date 30 9 2026) EQUALS 0
-- The amount is the regulations' (an input).
#ASSERT `s 453(2) the amount of the civil penalty` (JUST TRUE) 750 EQUALS JUST 750
#ASSERT `s 453(2) the amount of the civil penalty` (JUST FALSE) 750 EQUALS NOTHING
#ASSERT `s 453(2) the amount of the civil penalty` NOTHING 750 EQUALS NOTHING
#ASSERT `s 453(3) the registrar may recover the penalty from the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 453(3) the registrar may recover the penalty from the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 453(3) the registrar may recover the penalty from the company` NOTHING EQUALS NOTHING
#ASSERT `s 453(3) the penalty is to be paid into the Consolidated Fund` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 453(3) the penalty is to be paid into the Consolidated Fund` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 453(3) the penalty is to be paid into the Consolidated Fund` NOTHING EQUALS NOTHING
#ASSERT `s 453(4) proving that the documents were not prepared as required is a defence to the civil penalty` TRUE EQUALS JUST FALSE
#ASSERT `s 453(4) proving that the documents were not prepared as required is a defence to the civil penalty` FALSE EQUALS NOTHING
