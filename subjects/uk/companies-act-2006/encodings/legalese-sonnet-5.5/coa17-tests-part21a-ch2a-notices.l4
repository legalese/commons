IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa17-helpers`
IMPORT `coa17-part21a-ch2a-notices`

-- coa17-tests-part21a-ch2a-notices.l4: tests for ss 790LA-790LL (coa17-part21a-ch2a-notices.l4). Expected values are written
-- by hand from the text of the section named beside each group.

§ `Tests: Part 21A Chapter 2A, notices to the registrar`

-- ---- s 790LA -----------------------------------------------------------------------------------------------------
-- (4) not required if (a) the incorporation statement named the person and (b) no cause to believe they have since ceased
#ASSERT `s 790LA(4) the company is not required to give a notice under this section in relation to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LA(4) the company is not required to give a notice under this section in relation to the person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LA(4) the company is not required to give a notice under this section in relation to the person` FALSE TRUE EQUALS JUST FALSE
-- (1) must give a notice if it has had confirmation of (a) the status and (b) the required particulars
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LA(1) the company must give a notice to the registrar` NOTHING TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 790LA(2) the notice contains what this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LA(2) the notice contains what this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LA(2) the notice contains what this subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LA(3) the last day for the company to give the notice to the registrar` (Date 5 1 2026) EQUALS Date 18 1 2026
#ASSERT `s 790LA(3) the notice was given to the registrar in time` (Date 5 1 2026) (JUST (Date 18 1 2026)) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 790LA(3) the notice was given to the registrar in time` (Date 5 1 2026) (JUST (Date 19 1 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 790LA(3) the notice was given to the registrar in time` (Date 5 1 2026) NOTHING (Date 18 1 2026) EQUALS NOTHING
#ASSERT `s 790LA(3) the notice was given to the registrar in time` (Date 5 1 2026) NOTHING (Date 19 1 2026) EQUALS JUST FALSE
#ASSERT `s 790LA(5) section 126 affects the duty to give the notice or its receipt by the registrar` TRUE EQUALS JUST FALSE
#ASSERT `s 790LA(5) section 126 affects the duty to give the notice or its receipt by the registrar` FALSE EQUALS NOTHING

-- ---- s 790LB -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LB(1) the notice may include a statement that the person's identity is verified` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LB(1) the notice may include a statement that the person's identity is verified` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LB(1) the notice may include a statement that the person's identity is verified` FALSE FALSE EQUALS NOTHING
#ASSERT `s 790LB(2) the notice may include a statement specifying the name of a relevant officer whose identity is verified and confirming that` TRUE EQUALS JUST TRUE
#ASSERT `s 790LB(2) the notice may include a statement specifying the name of a relevant officer whose identity is verified and confirming that` FALSE EQUALS NOTHING
#ASSERT `s 790LB(3) the notice must be accompanied by a statement by the individual confirming that the individual is a relevant officer of the registrable relevant legal entity` TRUE EQUALS JUST TRUE
#ASSERT `s 790LB(3) the notice must be accompanied by a statement by the individual confirming that the individual is a relevant officer of the registrable relevant legal entity` FALSE EQUALS JUST FALSE

-- ---- s 790LC -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LC(1) the company must give a notice to the registrar` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LC(1) the company must give a notice to the registrar` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LC(1) the company must give a notice to the registrar` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
-- (4) nothing requires a notice on incorporation for a person in the statement of initial significant control
#ASSERT `s 790LC(1) the company must give a notice to the registrar` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LC(1) the company must give a notice to the registrar` (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LC(1) the company must give a notice to the registrar` NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 790LC(2) the notice states what this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LC(2) the notice states what this subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LC(3) the last day for the company to give the notice to the registrar` (Date 31 1 2026) EQUALS Date 13 2 2026
#ASSERT `s 790LC(3) the notice was given to the registrar in time` (Date 31 1 2026) (JUST (Date 13 2 2026)) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 790LC(3) the notice was given to the registrar in time` (Date 31 1 2026) (JUST (Date 14 2 2026)) (Date 1 6 2026) EQUALS JUST FALSE

-- ---- ss 790LD and 790LE ------------------------------------------------------------------------------------------
#ASSERT `s 790LD(1) the company must give a notice to the registrar of the change` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LD(1) the company must give a notice to the registrar of the change` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LD(1) the company must give a notice to the registrar of the change` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LD(1) the company must give a notice to the registrar of the change` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LD(2) the notice states what this subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LD(2) the notice states what this subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LD(2) the notice states what this subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LD(3) the last day for the company to give the notice to the registrar` (Date 20 2 2026) EQUALS Date 5 3 2026
#ASSERT `s 790LD(3) the notice was given to the registrar in time` (Date 20 2 2026) (JUST (Date 6 3 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 790LD(4) section 126 affects the duty to give the notice or its receipt by the registrar` TRUE EQUALS JUST FALSE
#ASSERT `s 790LD(4) section 126 affects the duty to give the notice or its receipt by the registrar` FALSE EQUALS NOTHING
-- 790LE(5): a change after the application was delivered but before the company was incorporated
#ASSERT `s 790LE(5) the change is a pre-incorporation change` (Date 1 3 2026) (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 790LE(5) the change is a pre-incorporation change` (Date 1 3 2026) (Date 25 2 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 790LE(5) the change is a pre-incorporation change` (Date 1 3 2026) (Date 25 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 790LE(5) the change is a pre-incorporation change` (Date 1 3 2026) (Date 1 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 790LE(5) the change is a pre-incorporation change` (Date 1 3 2026) (Date 20 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 790LE(5) the person is a proposed PSC` TRUE EQUALS JUST TRUE
#ASSERT `s 790LE(5) the person is a proposed PSC` FALSE EQUALS JUST FALSE
-- 790LE(1) and (2): not required if a notice has been given under section 790LG
#ASSERT `s 790LE(1) the company must give a notice to the registrar of the pre-incorporation change` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LE(1) the company must give a notice to the registrar of the pre-incorporation change` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LE(1) the company must give a notice to the registrar of the pre-incorporation change` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LE(1) the company must give a notice to the registrar of the pre-incorporation change` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LE(1) the company must give a notice to the registrar of the pre-incorporation change` NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 790LE(3) the notice states what this subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LE(3) the notice states what this subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LE(4) the last day for the company to give the notice to the registrar` (Date 20 2 2026) EQUALS Date 5 3 2026
#ASSERT `s 790LE(4) the notice was given to the registrar in time` (Date 20 2 2026) (JUST (Date 5 3 2026)) (Date 1 6 2026) EQUALS JUST TRUE

-- ---- s 790LF -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LF(1) the company must give a notice to the registrar that the person has ceased` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LF(1) the company must give a notice to the registrar that the person has ceased` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LF(1) the company must give a notice to the registrar that the person has ceased` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LF(2) the notice states what this subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LF(2) the notice states what this subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LF(2) the notice states what this subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LF(3) the last day for the company to give the notice to the registrar` (Date 1 3 2026) EQUALS Date 14 3 2026
#ASSERT `s 790LF(3) the notice was given to the registrar in time` (Date 1 3 2026) (JUST (Date 15 3 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 790LF(4) the name of the individual` "Jane" "Doe" EQUALS "Jane Doe"

-- ---- ss 790LG and 790LH ------------------------------------------------------------------------------------------
#ASSERT `s 790LG(1) the company must give a notice to the registrar that the person named did not become a registrable person or registrable relevant legal entity` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 790LG(1) the company must give a notice to the registrar that the person named did not become a registrable person or registrable relevant legal entity` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 790LG(1) the company must give a notice to the registrar that the person named did not become a registrable person or registrable relevant legal entity` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 790LG(1A) the notice states the date on which the company first knew or had cause to believe the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 790LG(1A) the notice states the date on which the company first knew or had cause to believe the matter` FALSE EQUALS JUST FALSE
#ASSERT `s 790LG(2) the last day for the company to give the notice to the registrar` (Date 10 4 2026) EQUALS Date 23 4 2026
#ASSERT `s 790LG(2) the notice was given to the registrar in time` (Date 10 4 2026) (JUST (Date 24 4 2026)) (Date 1 9 2026) EQUALS JUST FALSE
#ASSERT `s 790LH(4) the company is not required to give a notice under this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LH(4) the company is not required to give a notice under this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LH(1) the company must give a notice to the registrar that it has no persons with significant control` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 790LH(1) the company must give a notice to the registrar that it has no persons with significant control` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LH(1) the company must give a notice to the registrar that it has no persons with significant control` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LH(1) the company must give a notice to the registrar that it has no persons with significant control` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LH(1) the company must give a notice to the registrar that it has no persons with significant control` NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 790LH(2) the notice states what this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LH(2) the notice states what this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LH(3) the last day for the company to give the notice to the registrar` (Date 1 12 2026) EQUALS Date 14 12 2026
#ASSERT `s 790LH(3) the notice was given to the registrar in time` (Date 1 12 2026) (JUST (Date 14 12 2026)) (Date 1 6 2027) EQUALS JUST TRUE
#ASSERT `s 790LH(5) the statement is a statement of initial significant control` TRUE EQUALS JUST TRUE
#ASSERT `s 790LH(5) the statement is a statement of initial significant control` FALSE EQUALS JUST FALSE

-- ---- s 790LJ -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LA` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LC` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LD` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LE` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LF` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LG` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LH` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under regulations under section 790LI` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LA` TRUE TRUE EQUALS NOTHING
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) the duty under section 790LA` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LJ(1)(a) an offence is committed by the company` `s 790LJ(1) another duty` TRUE FALSE EQUALS NOTHING
#ASSERT `s 790LJ(1)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 790LJ(1)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 790LJ(2) the shadow director is treated as an officer of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 790LJ(2) the shadow director is treated as an officer of the company` FALSE EQUALS NOTHING
-- (3) summary conviction: level 3 on the standard scale and, for continued contravention, a daily default fine of one-tenth of level 3
#ASSERT `s 790LJ(3) the penalty`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 790LJ(3) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` OF 3, 1)
#ASSERT `s 790LJ(3) the penalty`'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1)
#ASSERT `s 790LJ(3) the penalty`'s `imprisonment not exceeding` EQUALS NOTHING

-- ---- s 790LK -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LK(1) an application may be made to the court for an order requiring the company to deliver the information or statements to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 790LK(1) an application may be made to the court for an order requiring the company to deliver the information or statements to the registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 790LK(2) the person may apply to the court` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 790LK(2) the person may apply to the court` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LK(2) the person may apply to the court` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790LK(2) the person may apply to the court` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 790LK(2) the person may apply to the court` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LK(3) the court may refuse the application or make the order and order the company to pay damages sustained by any party aggrieved` TRUE EQUALS JUST TRUE
#ASSERT `s 790LK(3) the court may refuse the application or make the order and order the company to pay damages sustained by any party aggrieved` FALSE EQUALS NOTHING
#ASSERT `s 790LK(4) the court may decide any question as to whether a name should be included in or omitted from the information, and any question necessary or expedient for rectifying the position` TRUE EQUALS JUST TRUE
#ASSERT `s 790LK(4) the court may decide any question as to whether a name should be included in or omitted from the information, and any question necessary or expedient for rectifying the position` FALSE EQUALS NOTHING
#ASSERT `s 790LK(5) this section affects the person's rights under section 1094 or 1096` TRUE EQUALS JUST FALSE
#ASSERT `s 790LK(5) this section affects the person's rights under section 1094 or 1096` FALSE EQUALS NOTHING

-- ---- s 790LL -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LL(1) the person may request the company to tell them whether all of the information it is required to deliver under this Chapter has been delivered` FALSE EQUALS JUST TRUE
#ASSERT `s 790LL(1) the person may request the company to tell them whether all of the information it is required to deliver under this Chapter has been delivered` TRUE EQUALS JUST FALSE
#ASSERT `s 790LL(2) the company must comply with the request` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LL(2) the company must comply with the request` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LL(2) the company must comply with the request` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LL(2) the company must comply with the request` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LL(2) the company must comply with the request` NOTHING TRUE FALSE EQUALS NOTHING
-- within the period of 14 days beginning with the day on which the request is made: 5 January gives 18 January
#ASSERT `s 790LL(2) the last day for the company to comply with the request` (Date 5 1 2026) EQUALS Date 18 1 2026
#ASSERT `s 790LL(2) the company complied with the request in time` (Date 5 1 2026) (JUST (Date 18 1 2026)) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 790LL(2) the company complied with the request in time` (Date 5 1 2026) (JUST (Date 19 1 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 790LL(2) the company complied with the request in time` (Date 5 1 2026) NOTHING (Date 18 1 2026) EQUALS NOTHING
-- (3) failing without reasonable excuse
#ASSERT `s 790LL(3)(a) an offence is committed by the company` (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 790LL(3)(a) an offence is committed by the company` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 790LL(3)(a) an offence is committed by the company` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 790LL(3)(a) an offence is committed by the company` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 790LL(3)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 790LL(3)(b) an offence is committed by the officer of the company who is in default` (JUST TRUE) NOTHING EQUALS NOTHING
-- (4) a fine not exceeding level 3 on the standard scale; no daily default fine
#ASSERT `s 790LL(4) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` OF 3, 1)
#ASSERT `s 790LL(4) the penalty`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT `s 790LL(4) the penalty`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 790LL(5) subsection (1) does not apply to the information` TRUE EQUALS JUST TRUE
#ASSERT `s 790LL(5) subsection (1) does not apply to the information` FALSE EQUALS NOTHING
