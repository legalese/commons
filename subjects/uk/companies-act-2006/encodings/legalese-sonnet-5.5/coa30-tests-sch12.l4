IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch12`

-- coa30-tests-sch12.l4: tests for coa30-sch12.l4 (Schedule 12). Expected values are decided from the text of each paragraph.

§ `Tests: Schedule 12`

-- sch 12 para 1(1): every limb that applies is required ("The arrangements referred to in section 1242(1)(a) are appropriate arrangements—")
#ASSERT `sch 12 para 1(1) the arrangements are appropriate arrangements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 1(1) the arrangements are appropriate arrangements` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 1(1) the arrangements are appropriate arrangements` TRUE FALSE EQUALS JUST FALSE
-- 2(1): (a) investigations; (b) hearings etc only "where it appears to be desirable"; (c) independence.
-- args: (a), hearings desirable, (b)(i), (b)(ii), (b)(iii), (c)
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2(1) the arrangements are appropriate arrangements` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 2(1A), 2(2)
#ASSERT `sch 12 para 2(1A) decisions to take disciplinary action may be made without a disciplinary hearing` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 2(1A) decisions to take disciplinary action may be made without a disciplinary hearing` FALSE EQUALS NOTHING
#ASSERT `sch 12 para 2(2) the action is disciplinary action` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 2(2) the action is disciplinary action` FALSE EQUALS NOTHING
-- 3(1)
#ASSERT `sch 12 para 3(1) this paragraph applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 12 para 3(1) this paragraph applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 3(1) this paragraph applies` FALSE FALSE EQUALS NOTHING
-- 3(2): "not ... appropriate ... unless" both (a) and (b) are designed in
#ASSERT `sch 12 para 3(2) the arrangements are not to be regarded as appropriate for ensuring independence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 3(2) the arrangements are not to be regarded as appropriate for ensuring independence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 3(2) the arrangements are not to be regarded as appropriate for ensuring independence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 12 para 3(2) the arrangements are not to be regarded as appropriate for ensuring independence` FALSE FALSE EQUALS JUST TRUE
-- 3(3)
#ASSERT `sch 12 para 3(3) additional criteria may need to be satisfied for the arrangements to be regarded as appropriate` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 3(3) additional criteria may need to be satisfied for the arrangements to be regarded as appropriate` FALSE EQUALS NOTHING
-- 4: must pay the costs that the arrangements provide it is to pay
-- args: within paragraph 1 or 2, obliged to participate, the arrangements provide it pays, has paid
#ASSERT `sch 12 para 4 the registered third country auditor has paid the costs it must pay` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 4 the registered third country auditor has paid the costs it must pay` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 4 the registered third country auditor has paid the costs it must pay` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 12 para 4 the registered third country auditor has paid the costs it must pay` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 12 para 4 the registered third country auditor has paid the costs it must pay` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- 5, 6(1)
#ASSERT `sch 12 para 5 the arrangements may qualify as arrangements within paragraph 1 or 2` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 5 the arrangements may qualify as arrangements within paragraph 1 or 2` FALSE EQUALS NOTHING
#ASSERT `sch 12 para 6(1) the registered third country auditor is obliged to participate in the set of arrangements` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 6(1) the registered third country auditor is obliged to participate in the set of arrangements` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 6(1) the registered third country auditor is obliged to participate in the set of arrangements` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 12 para 6(1) the registered third country auditor is obliged to participate in the set of arrangements` FALSE TRUE TRUE EQUALS NOTHING
