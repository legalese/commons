IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-supplementary`

-- coa10-tests-supplementary.l4: tests for coa10-supplementary.l4 (ss 463, 469, 470). Every expected value was written down
-- from the text of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 463(1): the reports and statements (lines 6326-6331) ----
#ASSERT `s 463(1) the section applies to the report or statement` `s 463 the strategic report` EQUALS JUST TRUE
#ASSERT `s 463(1) the section applies to the report or statement` `s 463 the directors' report` EQUALS JUST TRUE
#ASSERT `s 463(1) the section applies to the report or statement` `s 463 the directors' remuneration report` EQUALS JUST TRUE
#ASSERT `s 463(1) the section applies to the report or statement` `s 463 a separate corporate governance statement` EQUALS JUST TRUE
#ASSERT `s 463(1) the section applies to the report or statement` `s 463 another report or statement` EQUALS NOTHING

-- ---- s 463(2), (3): liability to compensate the company (lines 6332-6337) ----
-- The arguments: the section applies; loss suffered as a result; he knew or was reckless; he knew the omission was dishonest concealment.
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
-- "only if": neither knowledge nor recklessness
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
-- no loss
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST TRUE) FALSE TRUE FALSE EQUALS NOTHING
-- a report or statement the section does not list
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 463(2) the director is liable to compensate the company for the loss` (JUST FALSE) TRUE TRUE FALSE EQUALS NOTHING

-- ---- s 463(4), (5), (6) (lines 6338-6342) ----
#ASSERT `s 463(4) a person is subject to liability to the claimant` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 463(4) a person is subject to liability to the claimant` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 463(4) a person is subject to liability to the claimant` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 463(4) a person is subject to liability to the claimant` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 463(5) the claim is within the liability that subsection (4) removes` TRUE EQUALS JUST TRUE
#ASSERT `s 463(5) the claim is within the liability that subsection (4) removes` FALSE EQUALS NOTHING
#ASSERT `s 463(6) the section affects the liability` `s 463 liability for a civil penalty` EQUALS JUST FALSE
#ASSERT `s 463(6) the section affects the liability` `s 463 liability for a criminal offence` EQUALS JUST FALSE
#ASSERT `s 463(6) the section affects the liability` `s 463 any other liability` EQUALS NOTHING

-- ---- s 469: accounts in euros (lines 6447-6454) ----
#ASSERT `s 469(1) the amounts may also be shown in the same accounts translated into euros` TRUE EQUALS JUST TRUE
#ASSERT `s 469(1) the amounts may also be shown in the same accounts translated into euros` FALSE EQUALS NOTHING
#ASSERT `s 469(2) the directors may deliver to the registrar an additional copy of the annual accounts translated into euros` TRUE EQUALS JUST TRUE
#ASSERT `s 469(2) the directors may deliver to the registrar an additional copy of the annual accounts translated into euros` FALSE EQUALS NOTHING
-- (3): rate on the balance sheet date, and disclosed in the notes (unless a micro-entity's Companies Act individual accounts)
#ASSERT `s 469(3) the translation meets the requirements of the section` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 469(3) the translation meets the requirements of the section` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 469(3) the translation meets the requirements of the section` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 469(3) the translation meets the requirements of the section` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 469(3) the translation meets the requirements of the section` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 469(3A) subsection (3)(b) requires the rate to be disclosed in the notes` TRUE EQUALS JUST FALSE
#ASSERT `s 469(3A) subsection (3)(b) requires the rate to be disclosed in the notes` FALSE EQUALS NOTHING
#ASSERT `s 469(4) the additional copy is treated as statutory accounts of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 469(4) the additional copy is treated as statutory accounts of the company` FALSE EQUALS NOTHING
#ASSERT `s 469(4) the references in sections 434 and 435 to the auditor's report are read as references to the report on the accounts of which the copy is a copy` TRUE EQUALS JUST TRUE
#ASSERT `s 469(4) the references in sections 434 and 435 to the auditor's report are read as references to the report on the accounts of which the copy is a copy` FALSE EQUALS NOTHING

-- ---- s 470: banking partnerships (lines 6456-6460) ----
#ASSERT `s 470(2) the partnership is a banking partnership` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 470(2) the partnership is a banking partnership` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 470(2) the partnership is a banking partnership` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 470(3) the expression has the same meaning as in those provisions` TRUE EQUALS JUST TRUE
#ASSERT `s 470(3) the expression has the same meaning as in those provisions` FALSE EQUALS NOTHING
