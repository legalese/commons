IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa19-nouns`
IMPORT `coa19-ch3-powers`

-- coa19-tests-ch3-powers.l4: tests for coa19-ch3-powers.l4 (s 893).
-- Every expected value is written from the text of the section named in the comment above it, not from the code's output.

§ `Tests: s 893`

-- (1) a "special register" means a register, other than the register, in which a charge to which Chapter A1 applies is required or authorised to be registered
#ASSERT `s 893(1) the register is a special register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 893(1) the register is a special register` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 893(1) the register is a special register` FALSE TRUE EQUALS JUST FALSE
-- (2) "the responsible person" and "information-sharing arrangements"
#ASSERT `s 893(2) the person is the responsible person` TRUE EQUALS JUST TRUE
#ASSERT `s 893(2) the person is the responsible person` FALSE EQUALS JUST FALSE
#ASSERT `s 893(2) the arrangements are information-sharing arrangements` TRUE EQUALS JUST TRUE
#ASSERT `s 893(2) the arrangements are information-sharing arrangements` FALSE EQUALS JUST FALSE
-- (3)(a) the registrar is authorised not to register a charge of a specified description, by an order
#ASSERT `s 893(3)(a) the registrar is authorised not to register the charge under Chapter A1` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 893(3)(a) the registrar is authorised not to register the charge under Chapter A1` TRUE FALSE EQUALS NOTHING
#ASSERT `s 893(3)(a) the registrar is authorised not to register the charge under Chapter A1` FALSE TRUE EQUALS NOTHING
-- (3)(b) a charge of a specified description registered in the special register within a specified period is treated as registered
#ASSERT `s 893(3)(b) the charge is to be treated as if it had been registered under Chapter A1` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 893(3)(b) the charge is to be treated as if it had been registered under Chapter A1` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 893(3)(b) the charge is to be treated as if it had been registered under Chapter A1` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 893(3)(b) the charge is to be treated as if it had been registered under Chapter A1` FALSE TRUE TRUE EQUALS NOTHING
-- (3)(c) the other provisions of Chapter A1 apply to a charge so treated, with the order's modifications
#ASSERT `s 893(3)(c) the other provisions of Chapter A1 apply to the charge with the modifications the order specifies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 893(3)(c) the other provisions of Chapter A1 apply to the charge with the modifications the order specifies` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 893(3)(c) the other provisions of Chapter A1 apply to the charge with the modifications the order specifies` NOTHING EQUALS NOTHING
-- (4) the arrangements must ensure that inspectors are made aware of such charges and can obtain information about them
#ASSERT `s 893(4) the information-sharing arrangements meet the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 893(4) the information-sharing arrangements meet the requirement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 893(4) the information-sharing arrangements meet the requirement` FALSE TRUE EQUALS JUST FALSE
-- (6) "specified" means specified in an order under the section
#ASSERT `s 893(6) the description or period is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 893(6) the description or period is specified` FALSE EQUALS JUST FALSE
