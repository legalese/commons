IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa22-part31-ch2`
IMPORT `coa22-part31-ch3`

-- coa22-tests-part31-ch3.l4: tests for Part 31, Chapter 3 (ss 1024 to 1034). Every expected value was decided from the
-- text (quoted in coa22-part31-ch3.l4) before the run and is written beside the assertion; none was copied from the
-- output. T = JUST TRUE, F = JUST FALSE, N = NOTHING ("not covered"). Dates: Date day month year.
-- A trace is not an assertion on the stable binary: each #TRACE carries its expected outcome on the line before it
-- (-- EXPECT:), and check-traces.py compares it with what the binary prints.

§ `Part 31 Chapter 3 tests`

§§ `s 1024 Application for administrative restoration to the register`

-- (1) args: struck off under section 1000 or 1001; struck off under section 1002A
#ASSERT `s 1024(1) an application may be made to the registrar to restore the company to the register` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1024(1) an application may be made to the registrar to restore the company to the register` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1024(1) an application may be made to the registrar to restore the company to the register` FALSE FALSE EQUALS NOTHING
-- (2) whether or not the company has been dissolved: the same either way
#ASSERT `s 1024(2) the application may be made whether or not the company has in consequence been dissolved` TRUE EQUALS JUST TRUE
#ASSERT `s 1024(2) the application may be made whether or not the company has in consequence been dissolved` FALSE EQUALS JUST TRUE
-- (3) only a former director or former member
#ASSERT `s 1024(3) the person may make the application to the registrar` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1024(3) the person may make the application to the registrar` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1024(3) the person may make the application to the registrar` FALSE FALSE EQUALS JUST FALSE
-- (4) dissolved on 1 June 2020: the six years end on 1 June 2026
#ASSERT `s 1024(4) the last day for making the application to the registrar` (Date 1 6 2020) EQUALS Date 1 6 2026
#ASSERT `s 1024(4) the last day for making the application to the registrar` (Date 29 2 2020) EQUALS Date 28 2 2026
#ASSERT `s 1024(4) the application is made within the period of six years from the date of the dissolution` (Date 1 6 2020) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 1024(4) the application is made within the period of six years from the date of the dissolution` (Date 1 6 2020) (Date 2 6 2026) EQUALS JUST FALSE
#ASSERT `s 1024(4) the application is made within the period of six years from the date of the dissolution` (Date 1 6 2020) (Date 31 5 2026) EQUALS JUST TRUE
#ASSERT `s 1024(4) the application is made within the period of six years from the date of the dissolution` (Date 29 2 2020) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `s 1024(4) the application is made within the period of six years from the date of the dissolution` (Date 29 2 2020) (Date 1 3 2026) EQUALS JUST FALSE
-- (1) to (4) together; args: the (1), (3) and (4) answers
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1024 the person may make an application to the registrar for administrative restoration` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING

§§ `s 1025 Requirements for administrative restoration`

-- (2) args: the way the company was struck off; carrying on business or in operation; the registrar did not have reasonable cause to believe the 1002A matter
#ASSERT `s 1025(2) the first condition is met` `s 1025(2)(a) struck off under section 1000 or 1001` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1025(2) the first condition is met` `s 1025(2)(a) struck off under section 1000 or 1001` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1025(2) the first condition is met` `s 1025(2)(b) struck off under section 1002A` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(2) the first condition is met` `s 1025(2)(b) struck off under section 1002A` TRUE FALSE EQUALS JUST FALSE
-- (3) args: property has vested as bona vacantia; the Crown representative has signified consent in writing
#ASSERT `s 1025(3) the second condition is met` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1025(3) the second condition is met` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(3) the second condition is met` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(3) the second condition is met` TRUE FALSE EQUALS JUST FALSE
-- (4) args: a cost in dealing with the property during dissolution; a cost in connection with the proceedings; demanded as a condition of consent
#ASSERT `s 1025(4) the applicant is responsible for paying the cost` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(4) the applicant is responsible for paying the cost` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(4) the applicant is responsible for paying the cost` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(4) the applicant is responsible for paying the cost` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1025(4) the applicant is responsible for paying the cost` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1025(5) the third condition is met` TRUE EQUALS JUST TRUE
#ASSERT `s 1025(5) the third condition is met` FALSE EQUALS JUST FALSE
-- (5C) args: the kind of firm; a director; one of the members who manage the firm; an officer whose functions correspond to a director's
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(a) a company` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(a) a company` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(b) a firm the affairs of which are managed by its members` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(b) a firm the affairs of which are managed by its members` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(c) any other firm` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(5C) the person is a relevant officer of the firm` `s 1025(5C)(c) any other firm` TRUE TRUE FALSE EQUALS JUST FALSE
-- (5B) args: the applicant; a director immediately before; a director immediately after; the (5C) answer; the firm is itself a relevant person
#ASSERT `s 1025(5B) the person is a relevant person` TRUE FALSE FALSE NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE TRUE TRUE NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE TRUE FALSE NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE FALSE TRUE NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE FALSE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE FALSE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE FALSE FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 1025(5B) the person is a relevant person` FALSE FALSE FALSE NOTHING TRUE EQUALS NOTHING
-- (5A) args: outstanding section 453 penalties paid; each relevant person has paid outstanding fines and penalties
#ASSERT `s 1025(5A) the fourth condition is met` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1025(5A) the fourth condition is met` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1025(5A) the fourth condition is met` TRUE FALSE EQUALS JUST FALSE
-- (1) "if, and only if": all four met; any unmet is the text's no; otherwise not covered
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 1025(1) the registrar shall restore the company to the register` (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 1025(1) the registrar shall restore the company to the register` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- (6) the Crown representative; args: vested in the Duchy of Lancaster; vested in the Duke of Cornwall; in Scotland
#ASSERT `s 1025(6) the Crown representative for the property` TRUE FALSE FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Lancaster`
#ASSERT `s 1025(6) the Crown representative for the property` FALSE TRUE FALSE EQUALS `s 1013(8) the Solicitor to the Duchy of Cornwall`
#ASSERT `s 1025(6) the Crown representative for the property` FALSE FALSE TRUE EQUALS `s 1013(1) the Queen's and Lord Treasurer's Remembrancer`
#ASSERT `s 1025(6) the Crown representative for the property` FALSE FALSE FALSE EQUALS `s 1013(1) the Treasury Solicitor`

§§ `s 1026 Application to be accompanied by statement of compliance`

#ASSERT `s 1026(1) the application meets the requirement to be accompanied by a statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 1026(1) the application meets the requirement to be accompanied by a statement of compliance` FALSE EQUALS JUST FALSE
-- (2) args: states standing; states the requirements are met
#ASSERT `s 1026(2) the statement of compliance is the statement required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1026(2) the statement of compliance is the statement required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1026(2) the statement of compliance is the statement required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1026(3) the registrar may accept the statement of compliance as sufficient evidence of those matters` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1026(3) the registrar may accept the statement of compliance as sufficient evidence of those matters` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1026(3) the registrar may accept the statement of compliance as sufficient evidence of those matters` NOTHING EQUALS NOTHING

§§ `s 1027 Registrar's decision on application for administrative restoration`

#ASSERT `s 1027(1) the registrar must give notice to the applicant of the decision on the application` TRUE EQUALS JUST TRUE
#ASSERT `s 1027(1) the registrar must give notice to the applicant of the decision on the application` FALSE EQUALS NOTHING
-- (2) args: the decision is that the company should be restored; the date the notice is sent
#ASSERT `s 1027(2) the date as from which the restoration takes effect` TRUE (Date 5 6 2026) EQUALS JUST (Date 5 6 2026)
#ASSERT `s 1027(2) the date as from which the restoration takes effect` FALSE (Date 5 6 2026) EQUALS NOTHING
#ASSERT `s 1027(3) the registrar must enter a note of the date on the register and cause notice of the restoration to be published in the Gazette` TRUE EQUALS JUST TRUE
#ASSERT `s 1027(3) the registrar must enter a note of the date on the register and cause notice of the restoration to be published in the Gazette` FALSE EQUALS JUST FALSE
-- (4) args: states the name (and former name); states the registered number; states the date
#ASSERT `s 1027(4) the notice states what the text requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1027(4) the notice states what the text requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1027(4) the notice states what the text requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1027(4) the notice states what the text requires` TRUE TRUE FALSE EQUALS JUST FALSE

§§ `s 1028 Effect of administrative restoration`

#ASSERT `s 1028(1) the company is deemed to have continued in existence as if it had not been dissolved or struck off the register` TRUE EQUALS JUST TRUE
#ASSERT `s 1028(1) the company is deemed to have continued in existence as if it had not been dissolved or struck off the register` FALSE EQUALS NOTHING
-- (2) args: the date the filing period ended; the date of dissolution or striking off (1 January 2025); the date of restoration (1 June 2026)
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 2 1 2025) (Date 1 1 2025) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 31 5 2026) (Date 1 1 2025) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 1 1 2025) (Date 1 1 2025) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 1 6 2026) (Date 1 1 2025) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 2 6 2026) (Date 1 1 2025) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 1028(2) the company is liable to a penalty under section 453 or any corresponding earlier provision for the financial year` (Date 31 12 2024) (Date 1 1 2025) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 1028(3) the court may give such directions and make such provision as seems just for placing the company and all other persons in the same position as if the company had not been dissolved or struck off the register` TRUE EQUALS JUST TRUE
#ASSERT `s 1028(3) the court may give such directions and make such provision as seems just for placing the company and all other persons in the same position as if the company had not been dissolved or struck off the register` FALSE EQUALS NOTHING
-- (4) restored on 1 June 2026: the three years end on 1 June 2029
#ASSERT `s 1028(4) the last day for applying to the court for such directions or provision` (Date 1 6 2026) EQUALS Date 1 6 2029
#ASSERT `s 1028(4) the application to the court is made within three years after the date of restoration` (Date 1 6 2026) (Date 1 6 2029) EQUALS JUST TRUE
#ASSERT `s 1028(4) the application to the court is made within three years after the date of restoration` (Date 1 6 2026) (Date 2 6 2029) EQUALS JUST FALSE

