IMPORT prelude
IMPORT daydate
IMPORT `coa28-sch1c`

-- coa28-tests-sch1c.l4: tests for coa28-sch1c.l4 (Schedule 1C, paragraphs 1 to 21). Every expected value was decided
-- by reading the paragraph named beside it, before running; none is copied from the encoding's output.

-- ---- Part 1: general principles
-- 20(2): securities are of one class if the rights are in all respects uniform
#ASSERT `sch 1C para 20(2) the securities are of one class` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(2) the securities are of one class` FALSE EQUALS JUST FALSE
-- 1(1): columns: the holders hold securities of an offeree company; the securities are of the same class
#ASSERT `sch 1C para 1(1) the rules must afford the holders equivalent treatment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1C para 1(1) the rules must afford the holders equivalent treatment` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 1C para 1(1) the rules must afford the holders equivalent treatment` TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 1C para 1(1) the rules must afford the holders equivalent treatment` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 1C para 1(2) the rules must protect the other holders of securities` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 1(2) the rules must protect the other holders of securities` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 2(1) the holders must have sufficient time and information to reach a properly informed decision on the takeover bid` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 2(1) the holders must have sufficient time and information to reach a properly informed decision on the takeover bid` FALSE EQUALS NOTHING
-- 2(2): the board advises the holders; the effect
#ASSERT `sch 1C para 2(2) the board of the offeree company must give its views on the effect of implementation of the takeover bid` TRUE `sch 1C para 2(2)(a) employment` EQUALS JUST TRUE
#ASSERT `sch 1C para 2(2) the board of the offeree company must give its views on the effect of implementation of the takeover bid` TRUE `sch 1C para 2(2)(b) conditions of employment` EQUALS JUST TRUE
#ASSERT `sch 1C para 2(2) the board of the offeree company must give its views on the effect of implementation of the takeover bid` TRUE `sch 1C para 2(2)(c) the locations of the company's places of business` EQUALS JUST TRUE
#ASSERT `sch 1C para 2(2) the board of the offeree company must give its views on the effect of implementation of the takeover bid` TRUE `sch 1C para 2(2) another effect` EQUALS NOTHING
#ASSERT `sch 1C para 2(2) the board of the offeree company must give its views on the effect of implementation of the takeover bid` FALSE `sch 1C para 2(2)(a) employment` EQUALS JUST FALSE
-- 3: the board of an offeree company; acts in the interests of the company as a whole; denies the holders the opportunity to decide
#ASSERT `sch 1C para 3 the board of the offeree company complies with the principle` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 3 the board of the offeree company complies with the principle` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 3 the board of the offeree company complies with the principle` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 3 the board of the offeree company complies with the principle` FALSE TRUE FALSE EQUALS NOTHING
-- 4: the company; the offeror is a company; the prices become artificial and the markets distorted
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4(a) the offeree company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4(a) the offeree company` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4(b) the offeror, if the offeror is a company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4(b) the offeror, if the offeror is a company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4(c) any other company concerned by the takeover bid` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 4 the creation of a false market in the securities of the company is barred` `sch 1C para 4 another person` TRUE TRUE EQUALS NOTHING
-- 5: the bar until the cash is ensured and the other consideration measures taken. Columns: cash offered; ensured; other consideration offered; measures taken
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 5 the offeror is barred from announcing the takeover bid yet` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 6: hindered by a takeover bid; for longer than is reasonable
#ASSERT `sch 1C para 6 the hindrance of the offeree company is barred` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 6 the hindrance of the offeree company is barred` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1C para 6 the hindrance of the offeree company is barred` FALSE TRUE EQUALS NOTHING

-- ---- Part 2: paragraphs 7 to 10
#ASSERT `sch 1C para 7(3) the obligation to make a mandatory takeover bid no longer applies` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 7(3) the obligation to make a mandatory takeover bid no longer applies` FALSE EQUALS JUST FALSE
-- 7(1): acquired securities; they give control; the obligation no longer applies under (3)
#ASSERT `sch 1C para 7(1) the rules must require P to make a mandatory takeover bid` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 1C para 7(1) the rules must require P to make a mandatory takeover bid` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1C para 7(1) the rules must require P to make a mandatory takeover bid` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1C para 7(1) the rules must require P to make a mandatory takeover bid` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1C para 7(1) the rules must require P to make a mandatory takeover bid` TRUE TRUE NOTHING EQUALS JUST TRUE
-- 7(2): a mandatory bid is required; addressed at the earliest opportunity to all holders; for all their holdings; at the equitable price
#ASSERT `sch 1C para 7(2) the mandatory takeover bid meets the requirement the rules must ensure` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 7(2) the mandatory takeover bid meets the requirement the rules must ensure` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 7(2) the mandatory takeover bid meets the requirement the rules must ensure` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 7(2) the mandatory takeover bid meets the requirement the rules must ensure` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 7(2) the mandatory takeover bid meets the requirement the rules must ensure` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- 8(1): the equitable price is the highest price paid by the offeror, or persons acting in concert, for the same securities, in the 6 to 12 months before the announcement of 1 July 2025
-- columns: date of the purchase; price paid; by the offeror or a person acting in concert; of the same securities
`coa28 test purchase 1 January 2025` MEANS `sch 1C para 8(1) purchase` OF (Date 1 1 2025), 100, TRUE, TRUE
`coa28 test purchase 31 December 2024` MEANS `sch 1C para 8(1) purchase` OF (Date 31 12 2024), 150, TRUE, TRUE
`coa28 test purchase by a stranger` MEANS `sch 1C para 8(1) purchase` OF (Date 10 3 2025), 120, FALSE, TRUE
`coa28 test purchase of other securities` MEANS `sch 1C para 8(1) purchase` OF (Date 15 4 2025), 110, TRUE, FALSE
`coa28 test purchase 20 June 2025` MEANS `sch 1C para 8(1) purchase` OF (Date 20 6 2025), 105, TRUE, TRUE
`coa28 test purchase on the day of the announcement` MEANS `sch 1C para 8(1) purchase` OF (Date 1 7 2025), 300, TRUE, TRUE
`coa28 test purchases` MEANS LIST `coa28 test purchase 1 January 2025`, `coa28 test purchase 31 December 2024`, `coa28 test purchase by a stranger`, `coa28 test purchase of other securities`, `coa28 test purchase 20 June 2025`, `coa28 test purchase on the day of the announcement`
-- a 6-month period reaches back to 1 January (1 January plus 6 months is the 1 July announcement) but not to 31 December
#ASSERT `sch 1C para 8(1) the equitable price` `coa28 test purchases` (Date 1 7 2025) 6 EQUALS JUST 105
-- a 12-month period also reaches 31 December 2024
#ASSERT `sch 1C para 8(1) the equitable price` `coa28 test purchases` (Date 1 7 2025) 12 EQUALS JUST 150
-- a period of less than 6 or more than 12 months is not what the paragraph allows
#ASSERT `sch 1C para 8(1) the equitable price` `coa28 test purchases` (Date 1 7 2025) 5 EQUALS NOTHING
#ASSERT `sch 1C para 8(1) the equitable price` `coa28 test purchases` (Date 1 7 2025) 13 EQUALS NOTHING
-- no qualifying purchase: no price (the paragraph is silent)
#ASSERT `sch 1C para 8(1) the equitable price` EMPTY (Date 1 7 2025) 6 EQUALS NOTHING
#ASSERT `sch 1C para 8(1) the equitable price` (LIST `coa28 test purchase by a stranger`, `coa28 test purchase of other securities`) (Date 1 7 2025) 6 EQUALS NOTHING
-- 8(2): the offer consideration must not be less than the highest price paid later
#ASSERT `sch 1C para 8 the highest of the prices` (LIST 90, 110, 105) EQUALS 110
#ASSERT `sch 1C para 8(2) the offer consideration must not be less than` 100 (LIST 90, 110, 105) EQUALS 110
#ASSERT `sch 1C para 8(2) the offer consideration must not be less than` 100 EMPTY EQUALS 100
#ASSERT `sch 1C para 8(2) the offer consideration must not be less than` 100 (LIST 90) EQUALS 100
-- 8(4): substantiated and made public
#ASSERT `sch 1C para 8(4) the Panel's decision to adjust the equitable price meets the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 8(4) the Panel's decision to adjust the equitable price meets the requirement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 8(4) the Panel's decision to adjust the equitable price meets the requirement` FALSE TRUE EQUALS JUST FALSE
-- 9(1)
#ASSERT `sch 1C para 9(1) the rules must ensure that the offeror may offer the consideration for the securities` `sch 1C para 9(1)(a) securities` EQUALS JUST TRUE
#ASSERT `sch 1C para 9(1) the rules must ensure that the offeror may offer the consideration for the securities` `sch 1C para 9(1)(b) cash` EQUALS JUST TRUE
#ASSERT `sch 1C para 9(1) the rules must ensure that the offeror may offer the consideration for the securities` `sch 1C para 9(1)(c) a combination of securities and cash` EQUALS JUST TRUE
#ASSERT `sch 1C para 9(1) the rules must ensure that the offeror may offer the consideration for the securities` `sch 1C para 9(1) another form of consideration` EQUALS NOTHING
-- 9(2): cash as an alternative where the consideration is not liquid securities on a UK regulated market, or where cash purchases carry 5% or more of the voting rights
#ASSERT `sch 1C para 9(2) the rules must ensure that cash is offered as an alternative` TRUE 0 EQUALS JUST TRUE
#ASSERT `sch 1C para 9(2) the rules must ensure that cash is offered as an alternative` FALSE 0.05 EQUALS JUST TRUE
#ASSERT `sch 1C para 9(2) the rules must ensure that cash is offered as an alternative` FALSE 0.06 EQUALS JUST TRUE
#ASSERT `sch 1C para 9(2) the rules must ensure that cash is offered as an alternative` FALSE 0.049 EQUALS JUST FALSE
-- 9(3): the relevant period runs from 6 months before the announcement (1 July 2025) to the close of the offer (31 July 2025)
#ASSERT `sch 1C para 9(3) the day is within the relevant period` (Date 1 1 2025) (Date 1 7 2025) 6 (Date 31 7 2025) EQUALS JUST TRUE
#ASSERT `sch 1C para 9(3) the day is within the relevant period` (Date 31 12 2024) (Date 1 7 2025) 6 (Date 31 7 2025) EQUALS JUST FALSE
#ASSERT `sch 1C para 9(3) the day is within the relevant period` (Date 31 7 2025) (Date 1 7 2025) 6 (Date 31 7 2025) EQUALS JUST TRUE
#ASSERT `sch 1C para 9(3) the day is within the relevant period` (Date 1 8 2025) (Date 1 7 2025) 6 (Date 31 7 2025) EQUALS JUST FALSE
-- 10: a rule that goes beyond paragraphs 7 to 9 is barred if it hinders the normal course of a takeover bid
#ASSERT `sch 1C para 10 the rule is barred` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 10 the rule is barred` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 10 the rule is barred` FALSE TRUE EQUALS NOTHING

-- ---- paragraphs 11 to 14
#ASSERT `sch 1C para 11(1) the decision to make a takeover bid has been made public and the Panel informed as the rules must ensure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 11(1) the decision to make a takeover bid has been made public and the Panel informed as the rules must ensure` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 11(1) the decision to make a takeover bid has been made public and the Panel informed as the rules must ensure` FALSE TRUE EQUALS JUST FALSE
-- 11(3), 12(3), 18(2): the representatives of the employees, or where there are none the employees themselves; nothing until the event
#ASSERT `sch 1C para 11(3) the boards of the offeree company and of the offeror must inform` TRUE TRUE EQUALS JUST `sch 1C the representatives of the employees`
#ASSERT `sch 1C para 11(3) the boards of the offeree company and of the offeror must inform` TRUE FALSE EQUALS JUST `sch 1C the employees themselves`
#ASSERT `sch 1C para 11(3) the boards of the offeree company and of the offeror must inform` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1C para 12(3) the boards of the offeree company and of the offeror must communicate the offer document to` TRUE TRUE EQUALS JUST `sch 1C the representatives of the employees`
#ASSERT `sch 1C para 12(3) the boards of the offeree company and of the offeror must communicate the offer document to` TRUE FALSE EQUALS JUST `sch 1C the employees themselves`
#ASSERT `sch 1C para 12(3) the boards of the offeree company and of the offeror must communicate the offer document to` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1C para 18(2) the board must at the same time communicate its opinion to` TRUE TRUE EQUALS JUST `sch 1C the representatives of the employees`
#ASSERT `sch 1C para 18(2) the board must at the same time communicate its opinion to` TRUE FALSE EQUALS JUST `sch 1C the employees themselves`
#ASSERT `sch 1C para 18(2) the board must at the same time communicate its opinion to` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1C para 12(1) the offeror has met the requirement to draw up and make public an offer document` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 12(1) the offeror has met the requirement to draw up and make public an offer document` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 12(2) the offeror has met the requirement to provide a copy to the Panel before the offer document is made public` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 12(2) the offeror has met the requirement to provide a copy to the Panel before the offer document is made public` FALSE EQUALS JUST FALSE
-- 12(4): the offer document must state at least (a) to (q): every item that applies must be stated
#ASSERT `sch 1C para 12(4) the offer document states at least the information the rules must require` EMPTY EMPTY EQUALS JUST TRUE
#ASSERT `sch 1C para 12(4) the offer document states at least the information the rules must require` (LIST `sch 1C para 12(4)(a) the terms of the takeover bid`) EMPTY EQUALS JUST FALSE
#ASSERT `sch 1C para 12(4) the offer document states at least the information the rules must require` (LIST `sch 1C para 12(4)(q) the national law which will govern contracts concluded between the offeror and the holders of the offeree company's securities as a result of the takeover bid and the competent courts`) EMPTY EQUALS JUST FALSE
-- an item that does not apply to this bid (no opting-in compensation, an offeror that is not a company) need not be stated
#ASSERT `sch 1C para 12(4) the offer document states at least the information the rules must require` (LIST `sch 1C para 12(4)(e) the compensation offered for the rights which might be removed as a result of a company's opting-in resolution under Chapter 2, with particulars of the way in which that compensation is to be paid and the method employed in determining it`, `sch 1C para 12(4)(l) if the offeror is a company and in so far as it is affected by the takeover bid, its intentions as to future business and jobs and its strategic plans for itself`) (LIST `sch 1C para 12(4)(e) the compensation offered for the rights which might be removed as a result of a company's opting-in resolution under Chapter 2, with particulars of the way in which that compensation is to be paid and the method employed in determining it`, `sch 1C para 12(4)(l) if the offeror is a company and in so far as it is affected by the takeover bid, its intentions as to future business and jobs and its strategic plans for itself`) EQUALS JUST TRUE
#ASSERT `sch 1C para 12(4) the offer document states at least the information the rules must require` (LIST `sch 1C para 12(4)(e) the compensation offered for the rights which might be removed as a result of a company's opting-in resolution under Chapter 2, with particulars of the way in which that compensation is to be paid and the method employed in determining it`, `sch 1C para 12(4)(m) the time allowed for acceptance of the takeover bid`) (LIST `sch 1C para 12(4)(e) the compensation offered for the rights which might be removed as a result of a company's opting-in resolution under Chapter 2, with particulars of the way in which that compensation is to be paid and the method employed in determining it`) EQUALS JUST FALSE
-- 13(1): publication on 1 January 2025: not less than two weeks (last day 15 January) nor more than 10 weeks (last day 12 March)
#ASSERT `sch 1C para 13(1) the time allowed for acceptance is within the limits the rules must ensure` (Date 1 1 2025) (Date 15 1 2025) FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 13(1) the time allowed for acceptance is within the limits the rules must ensure` (Date 1 1 2025) (Date 14 1 2025) FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 13(1) the time allowed for acceptance is within the limits the rules must ensure` (Date 1 1 2025) (Date 12 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 13(1) the time allowed for acceptance is within the limits the rules must ensure` (Date 1 1 2025) (Date 13 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 13(1) the time allowed for acceptance is within the limits the rules must ensure` (Date 1 1 2025) (Date 14 1 2025) TRUE EQUALS NOTHING

-- ---- paragraphs 15 to 19
-- 15: the company; the offeror is a company
#ASSERT `sch 1C para 15 the rules must ensure that the takeover bid is made public so as to ensure market transparency and integrity for the securities of the company` `sch 1C para 15(a) the offeree company` FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 15 the rules must ensure that the takeover bid is made public so as to ensure market transparency and integrity for the securities of the company` `sch 1C para 15(b) the offeror, if the offeror is a company` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 15 the rules must ensure that the takeover bid is made public so as to ensure market transparency and integrity for the securities of the company` `sch 1C para 15(b) the offeror, if the offeror is a company` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 15 the rules must ensure that the takeover bid is made public so as to ensure market transparency and integrity for the securities of the company` `sch 1C para 15(c) any other company affected by the takeover bid` FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 15 the rules must ensure that the takeover bid is made public so as to ensure market transparency and integrity for the securities of the company` `sch 1C para 15 another person` TRUE EQUALS NOTHING
-- 16
#ASSERT `sch 1C para 16 the rules must ensure that the information and documents are readily and promptly available to the recipient` `sch 1C para 16(a) a holder of securities admitted to trading on a UK regulated market who is located in the United Kingdom` EQUALS JUST TRUE
#ASSERT `sch 1C para 16 the rules must ensure that the information and documents are readily and promptly available to the recipient` `sch 1C para 16(b) a representative of the employees of the offeree company or of the offeror` EQUALS JUST TRUE
#ASSERT `sch 1C para 16 the rules must ensure that the information and documents are readily and promptly available to the recipient` `sch 1C para 16(b) an employee of the offeree company or of the offeror, where there are no such representatives` EQUALS JUST TRUE
#ASSERT `sch 1C para 16 the rules must ensure that the information and documents are readily and promptly available to the recipient` `sch 1C para 16 another person` EQUALS NOTHING
-- 17(2): the board receives the information on 10 January 2025; rules may determine an earlier stage; the result is made public on 20 February 2025
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 10 1 2025) (Date 10 1 2025) NOTHING (JUST (Date 20 2 2025)) EQUALS JUST TRUE
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 9 1 2025) (Date 10 1 2025) NOTHING (JUST (Date 20 2 2025)) EQUALS JUST FALSE
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 20 2 2025) (Date 10 1 2025) NOTHING (JUST (Date 20 2 2025)) EQUALS JUST TRUE
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 21 2 2025) (Date 10 1 2025) NOTHING (JUST (Date 20 2 2025)) EQUALS JUST FALSE
-- an earlier stage determined by rules (5 January) moves the beginning back
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 5 1 2025) (Date 10 1 2025) (JUST (Date 5 1 2025)) (JUST (Date 20 2 2025)) EQUALS JUST TRUE
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 4 1 2025) (Date 10 1 2025) (JUST (Date 5 1 2025)) (JUST (Date 20 2 2025)) EQUALS JUST FALSE
-- a "stage" that is not earlier than the receipt does not move the beginning
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 9 1 2025) (Date 10 1 2025) (JUST (Date 15 1 2025)) (JUST (Date 20 2 2025)) EQUALS JUST FALSE
-- no end yet: the period is still running
#ASSERT `sch 1C para 17(2) the day is within the relevant period` (Date 1 6 2025) (Date 10 1 2025) NOTHING NOTHING EQUALS JUST TRUE
-- 17(1): columns: the day is within the relevant period; seeking alternative bids; may frustrate the bid; issuing shares that may be a lasting impediment
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` (JUST FALSE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 17(1) the rules must require the board to obtain the prior authorisation of a general meeting` NOTHING FALSE TRUE TRUE EQUALS NOTHING
-- 17(3): decided before the period; not yet implemented; not in the normal course of business; implementation may frustrate the bid
#ASSERT `sch 1C para 17(3) the rules must require a general meeting to approve or confirm the decision` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 17(3) the rules must require a general meeting to approve or confirm the decision` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 17(3) the rules must require a general meeting to approve or confirm the decision` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 17(3) the rules must require a general meeting to approve or confirm the decision` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 17(3) the rules must require a general meeting to approve or confirm the decision` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 17(4): a two-tier structure: "board of directors" is both boards
#ASSERT `sch 1C para 17(4) the body is the board of directors for paragraph 17` TRUE `sch 1C para 17(4) the management board` EQUALS JUST TRUE
#ASSERT `sch 1C para 17(4) the body is the board of directors for paragraph 17` TRUE `sch 1C para 17(4) the supervisory board` EQUALS JUST TRUE
#ASSERT `sch 1C para 17(4) the body is the board of directors for paragraph 17` TRUE `sch 1C para 17(4) another body` EQUALS JUST FALSE
#ASSERT `sch 1C para 17(4) the body is the board of directors for paragraph 17` FALSE `sch 1C para 17(4) the management board` EQUALS JUST FALSE
-- 18(1): the document; the views on the effects; the views on the offeror's plans
#ASSERT `sch 1C para 18(1) the board has met the requirement to draw up and make public its opinion` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 18(1) the board has met the requirement to draw up and make public its opinion` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 18(1) the board has met the requirement to draw up and make public its opinion` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 18(1) the board has met the requirement to draw up and make public its opinion` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 18(3) the employees' representatives' opinion must be appended to the document` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 18(3) the employees' representatives' opinion must be appended to the document` FALSE EQUALS JUST FALSE
-- 19
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19(a) the lapsing of takeover bids` EQUALS JUST TRUE
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19(b) the revision of takeover bids` EQUALS JUST TRUE
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19(c) competing takeover bids` EQUALS JUST TRUE
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19(d) the disclosure of the results of takeover bids` EQUALS JUST TRUE
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19(e) the irrevocability of takeover bids and the conditions permitted` EQUALS JUST TRUE
#ASSERT `sch 1C para 19 the rules must make provision on the topic` `sch 1C para 19 another topic` EQUALS NOTHING

-- ---- paragraph 20: interpretation
#ASSERT `sch 1C para 20(1) the document is an offer document` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the document is an offer document` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the company is an offeree company` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the company is an offeree company` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the person is the offeror in relation to the takeover bid` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the person is the offeror in relation to the takeover bid` FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the rules are rules for this Schedule` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the rules are rules for this Schedule` FALSE EQUALS JUST FALSE
-- securities: transferable securities (a borrowed answer) carrying voting rights in a company
#ASSERT `sch 1C para 20(1) the instruments are securities` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the instruments are securities` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the instruments are securities` NOTHING TRUE EQUALS NOTHING
#ASSERT `sch 1C para 20(1) the instruments are securities` (JUST TRUE) FALSE EQUALS JUST FALSE
-- takeover bid: columns: a public offer to the holders of the securities of a company; to acquire some or all of them; follows or aims at acquiring control; made by the company itself
#ASSERT `sch 1C para 20(1) the offer is a takeover bid` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the offer is a takeover bid` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the offer is a takeover bid` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the offer is a takeover bid` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the offer is a takeover bid` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(1) the rights are voting rights for this Schedule` TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(1) the rights are voting rights for this Schedule` FALSE EQUALS JUST FALSE
-- 20(3): co-operates on the basis of an agreement or understanding aimed at (a) acquiring control or (b) frustrating the outcome
#ASSERT `sch 1C para 20(3) the person is a person acting in concert` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(3) the person is a person acting in concert` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1C para 20(3) the person is a person acting in concert` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1C para 20(3) the person is a person acting in concert` FALSE TRUE TRUE EQUALS JUST FALSE
-- 20(4): A is a subsidiary undertaking of B (s 420 FSMA 2000, modified: a borrowed answer): A and B, A and B's other subsidiaries, are deemed to act in concert
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST TRUE) `sch 1C para 20(4)(a) A and B` EQUALS JUST TRUE
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST TRUE) `sch 1C para 20(4)(a) A and another subsidiary undertaking of B` EQUALS JUST TRUE
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST TRUE) `sch 1C para 20(4)(b) B and A` EQUALS JUST TRUE
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST TRUE) `sch 1C para 20(4)(b) another subsidiary undertaking of B and A` EQUALS JUST TRUE
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST TRUE) `sch 1C para 20(4) any other pair` EQUALS NOTHING
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` (JUST FALSE) `sch 1C para 20(4)(a) A and B` EQUALS JUST FALSE
#ASSERT `sch 1C para 20(4) the two are deemed to be acting in concert` NOTHING `sch 1C para 20(4)(a) A and B` EQUALS NOTHING

