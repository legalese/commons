-- coa5-tests-director-supplementary.l4: tests for ss 247 to 249 and 258 to 259 (coa5-director-supplementary.l4). Expected values read from the text, not from the code.

§ `Tests: s 247`

#ASSERT `s 247(1) the powers of the directors include the power to make the provision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 247(1) the powers of the directors include the power to make the provision` TRUE FALSE EQUALS NOTHING
#ASSERT `s 247(1) the powers of the directors include the power to make the provision` FALSE TRUE EQUALS NOTHING
#ASSERT `s 247(2) the general duty in section 172 prevents the exercise of the power` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 247(2) the general duty in section 172 prevents the exercise of the power` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 247(2) the general duty in section 172 prevents the exercise of the power` NOTHING EQUALS NOTHING
#ASSERT `s 247(3) a restriction flowing from the company's objects prevents the exercise of the power` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 247(3) a restriction flowing from the company's objects prevents the exercise of the power` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 247(3) a restriction flowing from the company's objects prevents the exercise of the power` NOTHING TRUE EQUALS NOTHING
-- s 247(5): a resolution of the directors must be authorised by the articles; it is not sufficient for payments to or for the benefit of directors, former directors or shadow directors
#ASSERT `s 247(5) the resolution of the directors is sufficient sanction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 247(5) the resolution of the directors is sufficient sanction` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 247(5) the resolution of the directors is sufficient sanction` TRUE TRUE EQUALS JUST FALSE
-- s 247(4): the power may only be exercised if sanctioned by a resolution of the company or by a (sufficient) resolution of the directors
#ASSERT `s 247(4) the power may be exercised` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 247(4) the power may be exercised` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 247(4) the power may be exercised` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 247(4) the power may be exercised` FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 247(6) the other requirements of the articles have been complied with` TRUE EQUALS JUST TRUE
#ASSERT `s 247(6) the other requirements of the articles have been complied with` FALSE EQUALS JUST FALSE
-- s 247(7): before the commencement of any winding up, and out of profits available for dividend
#ASSERT `s 247(7) the payment may be made` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 247(7) the payment may be made` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 247(7) the payment may be made` FALSE TRUE EQUALS JUST FALSE

