IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa14-nouns`
IMPORT `coa14-ch11-misc`

-- coa14-tests-ch11.l4: tests for Chapter 11 (ss 654 to 657). EXPECTED VALUES ARE HAND-WRITTEN FROM THE TEXT.

§ `Tests: Chapter 11 -- Miscellaneous and supplementary provisions`

§§ `s 654`
--  columns: the reserve arises from a reduction of share capital, an order under the section disapplies the prohibition
#ASSERT `s 654(1) the reserve is distributable` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 654(1) the reserve is distributable` TRUE TRUE EQUALS NOTHING
#ASSERT `s 654(1) the reserve is distributable` FALSE FALSE EQUALS NOTHING

§§ `s 655`
-- not debarred by reason only of holding or having held shares, or a right to apply or subscribe for shares, or to be in the register of members
#ASSERT `s 655 the person is debarred from obtaining damages or other compensation from the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 655 the person is debarred from obtaining damages or other compensation from the company` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 655 the person is debarred from obtaining damages or other compensation from the company` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 655 the person is debarred from obtaining damages or other compensation from the company` FALSE FALSE FALSE EQUALS NOTHING

§§ `s 656`
-- (1) net assets half or less of the called-up share capital (200 of 400: exactly half; 201 is more than half)
--  columns: public company, net assets, called-up share capital
#ASSERT `s 656(1) the directors must call a general meeting` TRUE 200 400 EQUALS JUST TRUE
#ASSERT `s 656(1) the directors must call a general meeting` TRUE 201 400 EQUALS JUST FALSE
#ASSERT `s 656(1) the directors must call a general meeting` TRUE 0 400 EQUALS JUST TRUE
#ASSERT `s 656(1) the directors must call a general meeting` TRUE -50 400 EQUALS JUST TRUE
#ASSERT `s 656(1) the directors must call a general meeting` FALSE 100 400 EQUALS JUST FALSE
-- (2) within 28 days from the earliest day the fact is known to a director: 1 March 2023 -> 29 March 2023
-- s 656(2): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 656(2) the last day for the call of the meeting` (Date 1 3 2023) EQUALS Date 29 3 2023
#ASSERT `s 656(2) the number of days allowed for the call of the meeting` (Date 1 3 2023) EQUALS 28
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) (JUST (Date 29 3 2023)) (Date 29 3 2023) EQUALS JUST TRUE
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) (JUST (Date 1 3 2023)) (Date 29 3 2023) EQUALS JUST TRUE
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) (JUST (Date 30 3 2023)) (Date 30 3 2023) EQUALS JUST FALSE
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) (JUST (Date 28 2 2023)) (Date 30 3 2023) EQUALS NOTHING
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) NOTHING (Date 30 3 2023) EQUALS JUST FALSE
#ASSERT `s 656(2) the directors called the general meeting in time` (Date 1 3 2023) NOTHING (Date 29 3 2023) EQUALS NOTHING
-- the regulative duty: acting inside the period fulfils it, waiting past it is a breach (traces; a DEONTIC cannot be compared)
#TRACE `s 656(2) the directors' duty to call a general meeting of the company to consider whether any, and if so what, steps should be taken to deal with the situation` 28 AT 0 WITH
    PARTY Director DOES `Action of a party` Director Company "call a general meeting of the company to consider whether any, and if so what, steps should be taken to deal with the situation" AT 28
#TRACE `s 656(2) the directors' duty to call a general meeting of the company to consider whether any, and if so what, steps should be taken to deal with the situation` 28 AT 0 WITH
    (WAITUNTIL 29)

-- (3) the meeting convened for a date not later than 56 days from that day: 1 March 2023 -> 26 April 2023
#ASSERT `s 656(3) the last day for which the meeting may be convened` (Date 1 3 2023) EQUALS Date 26 4 2023
#ASSERT `s 656(3) the meeting is convened for a date in time` (Date 1 3 2023) (Date 26 4 2023) EQUALS JUST TRUE
#ASSERT `s 656(3) the meeting is convened for a date in time` (Date 1 3 2023) (Date 27 4 2023) EQUALS JUST FALSE
-- (4) a failure to convene as required, and the directors who knowingly authorise or permit it
--  columns: s 656(1) duty, s 656(2) in time, s 656(3) in time
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 656(4) there is a failure to convene a meeting as required by this section` NOTHING (JUST FALSE) (JUST TRUE) EQUALS NOTHING
--  columns: there is a failure, knowingly authorises or permits, after the period knowingly authorises or permits the failure to continue
#ASSERT `s 656(4) the director commits an offence` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 656(4) the director commits an offence` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 656(4) the director commits an offence` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 656(4) the director commits an offence` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 656(4) the director commits an offence` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 656(4) the director commits an offence` NOTHING FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 656(5) the penalty for a person guilty of an offence under this section` TRUE EQUALS JUST (LIST (Penalty OF `on conviction on indictment`, NOTHING, (JUST `a fine without a stated limit`), NOTHING, FALSE), (Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, FALSE))
#ASSERT `s 656(5) the penalty for a person guilty of an offence under this section` FALSE EQUALS NOTHING

-- (6) nothing authorises the consideration of a matter that could not have been considered apart from the section
#ASSERT `s 656(6) the section authorises the consideration of the matter at the meeting` TRUE EQUALS JUST FALSE
#ASSERT `s 656(6) the section authorises the consideration of the matter at the meeting` FALSE EQUALS NOTHING
