IMPORT prelude
IMPORT `coa28-sch1`

-- coa28-tests-sch1.l4: tests for coa28-sch1.l4 (Schedule 1, paragraphs 1 to 6). Every expected value was decided by
-- reading the paragraph named beside it, before running; none is copied from the encoding's output.

-- ---- para 1(1), 1(2)
#ASSERT `sch 1 para 1(1) the provisions of this Schedule govern the reference` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 1(1) the provisions of this Schedule govern the reference` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 1(2) the provisions of this Schedule apply to the security` `sch 1 para 1(2) shares` EQUALS JUST TRUE
#ASSERT `sch 1 para 1(2) the provisions of this Schedule apply to the security` `sch 1 para 1(2) debentures` EQUALS JUST TRUE
#ASSERT `sch 1 para 1(2) the provisions of this Schedule apply to the security` `sch 1 para 1(2) another kind of security` EQUALS NOTHING

-- ---- para 2
#ASSERT `sch 1 para 2(1) the person has an interest in the shares` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 2(1) the person has an interest in the shares` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 2(2) the restraint or restriction is disregarded` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 2(2) the restraint or restriction is disregarded` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 2(3) the lack of identifiability of the shares matters to the interest` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 2(3) the lack of identifiability of the shares matters to the interest` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 2(4) the person is deemed to have the interest` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 2(4) the person is deemed to have the interest` FALSE EQUALS NOTHING

-- ---- para 3(1) to (4)
#ASSERT `sch 1 para 3(1) the person is taken to have an interest in the shares by entering into a contract to acquire them` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(1) the person is taken to have an interest in the shares by entering into a contract to acquire them` FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 3(3) the right or obligation is to be taken to be a right to acquire, or an obligation to take, an interest in shares for sub-paragraph (2)` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 3(3) the right or obligation is to be taken to be a right to acquire, or an obligation to take, an interest in shares for sub-paragraph (2)` FALSE EQUALS NOTHING
-- columns: right to call for delivery; right to acquire or obligation to take; that right or obligation is to subscribe
#ASSERT `sch 1 para 3(2) the person is taken to have an interest in the shares by a right to call for delivery or a right or obligation to acquire an interest` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(2) the person is taken to have an interest in the shares by a right to call for delivery or a right or obligation to acquire an interest` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(2) the person is taken to have an interest in the shares by a right to call for delivery or a right or obligation to acquire an interest` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 3(2) the person is taken to have an interest in the shares by a right to call for delivery or a right or obligation to acquire an interest` FALSE FALSE FALSE EQUALS JUST FALSE
-- a right to call for delivery is not touched by the subscription carve-out, which speaks only of (2)(b)
#ASSERT `sch 1 para 3(2) the person is taken to have an interest in the shares by a right to call for delivery or a right or obligation to acquire an interest` TRUE TRUE TRUE EQUALS JUST TRUE
-- columns: delivered in fulfilment of a contract; delivered in satisfaction of a right; failure to deliver; lapse of right
#ASSERT `sch 1 para 3(4) the person ceases to have an interest in the shares by virtue of paragraph 3` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(4) the person ceases to have an interest in the shares by virtue of paragraph 3` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(4) the person ceases to have an interest in the shares by virtue of paragraph 3` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(4) the person ceases to have an interest in the shares by virtue of paragraph 3` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 3(4) the person ceases to have an interest in the shares by virtue of paragraph 3` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- ---- para 4(1) to (3)
-- columns: registered holder; entitled to exercise a right; entitled to control the exercise of a right
#ASSERT `sch 1 para 4(1) the person is taken to have an interest in the shares by an entitlement to exercise or control the exercise of a right` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 4(1) the person is taken to have an interest in the shares by an entitlement to exercise or control the exercise of a right` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 4(1) the person is taken to have an interest in the shares by an entitlement to exercise or control the exercise of a right` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 4(1) the person is taken to have an interest in the shares by an entitlement to exercise or control the exercise of a right` FALSE FALSE FALSE EQUALS JUST FALSE
-- a registered holder with no entitlement of the kind: not by this paragraph (this row tells apart NOT (a) AND (b OR c) from NOT (a AND (b OR c)))
#ASSERT `sch 1 para 4(1) the person is taken to have an interest in the shares by an entitlement to exercise or control the exercise of a right` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 4(2) the person is taken to be entitled to exercise or control the exercise of a right conferred by the holding of shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 4(2) the person is taken to be entitled to exercise or control the exercise of a right conferred by the holding of shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 4(2) the person is taken to be entitled to exercise or control the exercise of a right conferred by the holding of shares` FALSE FALSE EQUALS JUST FALSE
-- columns: appointed a proxy; appointed a corporate representative; that is the only reason
#ASSERT `sch 1 para 4(3) the person is taken by virtue of paragraph 4 to be interested in the shares by reason only of the appointment` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 4(3) the person is taken by virtue of paragraph 4 to be interested in the shares by reason only of the appointment` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 4(3) the person is taken by virtue of paragraph 4 to be interested in the shares by reason only of the appointment` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 4(3) the person is taken by virtue of paragraph 4 to be interested in the shares by reason only of the appointment` FALSE FALSE TRUE EQUALS NOTHING

-- ---- para 5(1), 5(2)
#ASSERT `sch 1 para 5(2) the voting power of the other body corporate is taken to be exercisable by the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 5(2) the voting power of the other body corporate is taken to be exercisable by the person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 5(2) the voting power of the other body corporate is taken to be exercisable by the person` FALSE TRUE EQUALS JUST FALSE
-- "more than one-half": exactly one-half is not more than one-half
#ASSERT NOT (`sch 1 para 5(1)(b) the person is entitled to exercise or control the exercise of more than one-half of the voting power at general meetings of the body corporate` 0.5 0)
#ASSERT NOT (`sch 1 para 5(1)(b) the person is entitled to exercise or control the exercise of more than one-half of the voting power at general meetings of the body corporate` 0.4 0.1)
#ASSERT `sch 1 para 5(1)(b) the person is entitled to exercise or control the exercise of more than one-half of the voting power at general meetings of the body corporate` 0.51 0
#ASSERT `sch 1 para 5(1)(b) the person is entitled to exercise or control the exercise of more than one-half of the voting power at general meetings of the body corporate` 0.3 0.25
#ASSERT NOT (`sch 1 para 5(1)(b) the person is entitled to exercise or control the exercise of more than one-half of the voting power at general meetings of the body corporate` 0.3 0.2)
-- columns: a body corporate is interested; accustomed to act on his directions; entitled to more than one-half of the voting power
#ASSERT `sch 1 para 5(1) the person is taken to be interested in the shares because a body corporate is interested in them` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 5(1) the person is taken to be interested in the shares because a body corporate is interested in them` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 5(1) the person is taken to be interested in the shares because a body corporate is interested in them` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 5(1) the person is taken to be interested in the shares because a body corporate is interested in them` FALSE TRUE TRUE EQUALS JUST FALSE

-- ---- para 6(1) to (5)
#ASSERT `sch 1 para 6(1) the beneficiary is taken to have an interest in the shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 6(1) the beneficiary is taken to have an interest in the shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(1) the beneficiary is taken to have an interest in the shares` FALSE TRUE EQUALS JUST FALSE
-- columns: the interest is in reversion, remainder or fee; a person is entitled to the income
#ASSERT `sch 1 para 6(2) the interest in reversion, remainder or fee is disregarded` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 6(2) the interest in reversion, remainder or fee is disregarded` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(2) the interest in reversion, remainder or fee is disregarded` FALSE TRUE EQUALS NOTHING
-- columns: bare or custodian trustee; simple trustee in Scotland
#ASSERT `sch 1 para 6(3) the person is treated as not interested in the shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 6(3) the person is treated as not interested in the shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 6(3) the person is treated as not interested in the shares` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4) the interest is disregarded` `sch 1 para 6(4)(a) an authorised unit trust scheme (within the meaning of section 237 of the Financial Services and Markets Act 2000)` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(4) the interest is disregarded` `sch 1 para 6(4)(b) a scheme made under a charities or trustee investments enactment named in paragraph (b)` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(4) the interest is disregarded` `sch 1 para 6(4)(c) the scheme set out in the Schedule to the Church Funds Investment Measure 1958` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(4) the interest is disregarded` `sch 1 para 6(4) another basis` EQUALS NOTHING
#ASSERT `sch 1 para 6(5) the interest is disregarded` `sch 1 para 6(5)(a) an interest of the Church of Scotland General Trustees or of the Church of Scotland Trust in shares held by them` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) the interest is disregarded` `sch 1 para 6(5)(b) an interest of any other person in shares held by those Trustees or that Trust otherwise than as simple trustees` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) the interest is disregarded` `sch 1 para 6(5) another interest` EQUALS NOTHING
#ASSERT `sch 1 para 6(5) the body is the Church of Scotland General Trustees or the Church of Scotland Trust` `sch 1 para 6(5) the body incorporated by the order confirmed by the Church of Scotland (General Trustees) Order Confirmation Act 1921` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) the body is the Church of Scotland General Trustees or the Church of Scotland Trust` `sch 1 para 6(5) the body incorporated by the order confirmed by the Church of Scotland Trust Order Confirmation Act 1932` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(5) the body is the Church of Scotland General Trustees or the Church of Scotland Trust` `sch 1 para 6(5) another body` EQUALS JUST FALSE

-- ---- the gathering function: an exclusion that holds wins; one route is enough; no route is not "no interest"
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` (LIST (JUST TRUE)) EMPTY EQUALS JUST TRUE
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` (LIST (JUST FALSE), (JUST TRUE), NOTHING) EMPTY EQUALS JUST TRUE
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` (LIST (JUST TRUE)) (LIST (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` (LIST (JUST TRUE)) (LIST NOTHING, (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` (LIST (JUST FALSE), NOTHING) EMPTY EQUALS NOTHING
#ASSERT `sch 1 paras 2 to 6 the person has an interest in the shares or debentures for sections 254 and 255` EMPTY EMPTY EQUALS NOTHING

-- ---- gathering within a paragraph
#ASSERT `sch 1 para 3 the person has an interest in the shares by virtue of paragraph 3` (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 3 the person has an interest in the shares by virtue of paragraph 3` (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 3 the person has an interest in the shares by virtue of paragraph 3` (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 1 para 3 the person has an interest in the shares by virtue of paragraph 3` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 3 the person has an interest in the shares by virtue of paragraph 3` (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `sch 1 para 4 the person has an interest in the shares by virtue of paragraph 4` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 4 the person has an interest in the shares by virtue of paragraph 4` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1 para 4 the person has an interest in the shares by virtue of paragraph 4` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 1 para 4 the person has an interest in the shares by virtue of paragraph 4` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 6 the beneficiary has an interest in the shares by virtue of paragraph 6` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1 para 6 the beneficiary has an interest in the shares by virtue of paragraph 6` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1 para 6 the beneficiary has an interest in the shares by virtue of paragraph 6` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 1 para 6 the beneficiary has an interest in the shares by virtue of paragraph 6` (JUST FALSE) NOTHING EQUALS JUST FALSE
