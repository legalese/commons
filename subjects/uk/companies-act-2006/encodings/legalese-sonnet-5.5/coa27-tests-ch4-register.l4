IMPORT prelude
IMPORT `coa-core`
IMPORT `coa27-definitions`
IMPORT `coa27-ch4-register`

-- coa27-tests-ch4-register.l4: tests for coa27-ch4-register.l4 (ss 1239, 1240, 1240A). Expected values are decided
-- from the text and written beside each assertion.

-- ---- fixtures: fields are (form, eligible for appointment as statutory auditor, eligible by virtue of Chapter 2, third country auditor)
`s 1239 test entrant: individual statutory auditor by Chapter 2` MEANS `s 1239 entrant` OF `s 1239 an individual`, TRUE, TRUE, FALSE
`s 1239 test entrant: individual statutory auditor not by Chapter 2` MEANS `s 1239 entrant` OF `s 1239 an individual`, TRUE, FALSE, FALSE
`s 1239 test entrant: body corporate statutory auditor by Chapter 2` MEANS `s 1239 entrant` OF (`s 1239 a firm` `s 1239(3)(a) a body corporate other than a limited liability partnership`), TRUE, TRUE, FALSE
`s 1239 test entrant: partnership statutory auditor not by Chapter 2` MEANS `s 1239 entrant` OF (`s 1239 a firm` `s 1239(3)(d) a partnership`), TRUE, FALSE, FALSE
`s 1239 test entrant: third country auditor firm` MEANS `s 1239 entrant` OF (`s 1239 a firm` `s 1239(3)(a) a body corporate other than a limited liability partnership`), FALSE, FALSE, TRUE
`s 1239 test entrant: third country auditor individual` MEANS `s 1239 entrant` OF `s 1239 an individual`, FALSE, FALSE, TRUE
`s 1239 test entrant: neither` MEANS `s 1239 entrant` OF `s 1239 an individual`, FALSE, FALSE, FALSE

-- ---- s 1239(1): a register of (a) the persons eligible for appointment as a statutory auditor and (b) third country auditors who apply ... and in relation to whom specified requirements are met
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: individual statutory auditor by Chapter 2` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: third country auditor firm` TRUE TRUE EQUALS JUST TRUE
-- a third country auditor who has not applied, or in relation to whom the specified requirements are not met, is outside (b), and the text does not say he is excluded
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: third country auditor firm` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: third country auditor firm` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1239(1) the person is to be entered in the register` `s 1239 test entrant: neither` TRUE TRUE EQUALS NOTHING

-- ---- s 1239(2): what each entry must contain
-- (a) his name and address: each person
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor by Chapter 2` `s 1239(2)(a) his name and address` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor individual` `s 1239(2)(a) his name and address` EQUALS JUST TRUE
-- (b) an individual eligible for appointment as a statutory auditor
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor by Chapter 2` `s 1239(2)(b) the specified information relating to any firm on whose behalf the individual is responsible for statutory audit work` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor not by Chapter 2` `s 1239(2)(b) the specified information relating to any firm on whose behalf the individual is responsible for statutory audit work` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` `s 1239(2)(b) the specified information relating to any firm on whose behalf the individual is responsible for statutory audit work` EQUALS NOTHING
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor individual` `s 1239(2)(b) the specified information relating to any firm on whose behalf the individual is responsible for statutory audit work` EQUALS NOTHING
-- (c) a firm eligible for appointment as a statutory auditor
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` `s 1239(2)(c) the specified information relating to the individuals responsible for statutory audit work on the firm's behalf` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: partnership statutory auditor not by Chapter 2` `s 1239(2)(c) the specified information relating to the individuals responsible for statutory audit work on the firm's behalf` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor by Chapter 2` `s 1239(2)(c) the specified information relating to the individuals responsible for statutory audit work on the firm's behalf` EQUALS NOTHING
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor firm` `s 1239(2)(c) the specified information relating to the individuals responsible for statutory audit work on the firm's behalf` EQUALS NOTHING
-- (d) an individual or firm eligible by virtue of Chapter 2: the relevant supervisory body
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor by Chapter 2` `s 1239(2)(d) the name of the relevant supervisory body` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` `s 1239(2)(d) the name of the relevant supervisory body` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor not by Chapter 2` `s 1239(2)(d) the name of the relevant supervisory body` EQUALS NOTHING
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor firm` `s 1239(2)(d) the name of the relevant supervisory body` EQUALS NOTHING
-- (e) a firm eligible by virtue of Chapter 2: the information in subsection (3)
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` `s 1239(2)(e) the information mentioned in subsection (3)` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: partnership statutory auditor not by Chapter 2` `s 1239(2)(e) the information mentioned in subsection (3)` EQUALS NOTHING
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: individual statutory auditor by Chapter 2` `s 1239(2)(e) the information mentioned in subsection (3)` EQUALS NOTHING
-- (f) a third country auditor which is a firm
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor firm` `s 1239(2)(f) the name and address of each owner or shareholder of the firm and of each member of its administrative or management body` EQUALS JUST TRUE
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: third country auditor individual` `s 1239(2)(f) the name and address of each owner or shareholder of the firm and of each member of its administrative or management body` EQUALS NOTHING
#ASSERT `s 1239(2) the regulations must require the entry to contain` `s 1239 test entrant: body corporate statutory auditor by Chapter 2` `s 1239(2)(f) the name and address of each owner or shareholder of the firm and of each member of its administrative or management body` EQUALS NOTHING

-- ---- s 1239(3): the information referred to in subsection (2)(e), by kind of firm
#ASSERT `s 1239(3) the information referred to in subsection (2)(e) for a` `s 1239(3)(a) a body corporate other than a limited liability partnership` EQUALS `s 1239(3)(a) the name and address of each person who is a director of the body or holds any shares in it`
#ASSERT `s 1239(3) the information referred to in subsection (2)(e) for a` `s 1239(3)(b) a limited liability partnership` EQUALS `s 1239(3)(b) the name and address of each member of the partnership`
#ASSERT `s 1239(3) the information referred to in subsection (2)(e) for a` `s 1239(3)(c) a corporation sole` EQUALS `s 1239(3)(c) the name and address of the individual for the time being holding the office by the name of which he is the corporation sole`
#ASSERT `s 1239(3) the information referred to in subsection (2)(e) for a` `s 1239(3)(d) a partnership` EQUALS `s 1239(3)(d) the name and address of each partner`

-- ---- s 1239(7): the Secretary of State may direct in writing that the requirements are not to apply
#ASSERT `s 1239(7) the requirements imposed by the regulations apply to the registered third country auditor` TRUE TRUE TRUE EQUALS JUST FALSE
-- a direction not in writing, one that does not cover this auditor, or one that does not cover this requirement does not take it out
#ASSERT `s 1239(7) the requirements imposed by the regulations apply to the registered third country auditor` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1239(7) the requirements imposed by the regulations apply to the registered third country auditor` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1239(7) the requirements imposed by the regulations apply to the registered third country auditor` TRUE TRUE FALSE EQUALS NOTHING

-- ---- s 1239(8): enforceable on the application of the Secretary of State by injunction or, in Scotland, by an order under section 45 of the Court of Session Act 1988
#ASSERT `s 1239(8) the obligation is enforceable by` TRUE TRUE FALSE EQUALS JUST `s 1239(8) an injunction`
#ASSERT `s 1239(8) the obligation is enforceable by` TRUE TRUE TRUE EQUALS JUST `s 1239(8) an order under section 45 of the Court of Session Act 1988`
-- not on the Secretary of State's application, or an obligation on some other person: this subsection does not say
#ASSERT `s 1239(8) the obligation is enforceable by` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1239(8) the obligation is enforceable by` FALSE TRUE FALSE EQUALS NOTHING

-- ---- s 1239(9) and s 1240(3): "specified" means specified by regulations under this section
#ASSERT `s 1239(9) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1239(9) the matter is specified` FALSE EQUALS JUST FALSE
#ASSERT `s 1240(3) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1240(3) the matter is specified` FALSE EQUALS JUST FALSE

-- ---- s 1240A(3): "audit regulatory regime" means the system of public oversight, quality assurance, investigations and sanctions for auditors
#ASSERT `s 1240A(3) the system is an audit regulatory regime` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1240A(3) the system is an audit regulatory regime` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1240A(3) the system is an audit regulatory regime` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1240A(3) the system is an audit regulatory regime` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1240A(3) the system is an audit regulatory regime` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
