IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa23-nouns`
IMPORT `coa23-part35-register`

-- coa23-tests-part35-register.l4: tests for coa23-part35-register.l4 (ss 1080 to 1092B). Every expected value is written
-- here from the text of the section named beside it, before the module was run; none is copied from its output.
-- A failing assertion would be a finding, not an edit to the expected value. A #TRACE cannot be asserted on this binary, so each is
-- preceded by an -- EXPECT: line that work/check-traces.py compares with the binary's output.


-- s 1080(1): the registrar keeps records of (a) the information in documents delivered and (b) certificates issued; other records are not decided
#ASSERT `s 1080(1) the registrar must keep records of the matter` `s 1080(1)(a) the information contained in documents delivered to the registrar under any enactment` EQUALS JUST TRUE
#ASSERT `s 1080(1) the registrar must keep records of the matter` `s 1080(1)(b) certificates issued by the registrar under any enactment` EQUALS JUST TRUE
#ASSERT `s 1080(1) the registrar must keep records of the matter` `s 1080(1) other records` EQUALS NOTHING

-- s 1080(2): "the register" is the records relating to companies
#ASSERT `s 1080(2) the record is part of the register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1080(2) the record is part of the register` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1080(2) the record is part of the register` FALSE TRUE EQUALS JUST FALSE

-- s 1080(3): information deriving from an enhanced disclosure document must be kept in electronic form
#ASSERT `s 1080(3) the information is kept as the subsection requires` TRUE `electronic form` EQUALS JUST TRUE
#ASSERT `s 1080(3) the information is kept as the subsection requires` TRUE `hard copy form` EQUALS JUST FALSE
#ASSERT `s 1080(3) the information is kept as the subsection requires` FALSE `hard copy form` EQUALS NOTHING
#ASSERT `s 1080(3) the information is kept as the subsection requires` FALSE `electronic form` EQUALS NOTHING

-- s 1080(4): other information may be kept in any form the registrar thinks fit, provided it can be inspected and copied; subject to subsection (3)
#ASSERT `s 1080(4) the information may be recorded and kept in the form` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1080(4) the information may be recorded and kept in the form` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1080(4) the information may be recorded and kept in the form` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1080(4) the information may be recorded and kept in the form` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1080(4) the information may be recorded and kept in the form` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1080(4) the recording and keeping is sufficient compliance with the registrar's duty to keep, file or register the document or to record the information` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1080(4) the recording and keeping is sufficient compliance with the registrar's duty to keep, file or register the document or to record the information` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1080(4) the recording and keeping is sufficient compliance with the registrar's duty to keep, file or register the document or to record the information` NOTHING EQUALS NOTHING

-- s 1080(5): the records must associate information with the body, so that all of it can be retrieved
#ASSERT `s 1080(5) the records are such as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1080(5) the records are such as the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1080(5) the records are such as the subsection requires` TRUE FALSE EQUALS JUST FALSE

-- s 1081(1): the note the registrar must place, by occasion
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1)(a) a document is delivered to the registrar` EQUALS (JUST (LIST "the date on which the document is delivered to the registrar"))
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1)(c) a document is replaced (whether or not material derived from it is removed)` EQUALS (JUST (LIST "the fact that it has been replaced", "the date of delivery of the replacement"))
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1)(d) material is removed` EQUALS (JUST (LIST "what was removed (giving a general description of its contents)", "under what power", "the date on which that was done"))
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1)(e) a document is rectified under section 859M` EQUALS (JUST (LIST "the nature of the rectification", "the date of the rectification"))
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1)(f) a document is replaced under section 859N` EQUALS (JUST (LIST "the fact that it has been replaced", "the date of delivery of the replacement"))
#ASSERT `s 1081(1) what the note in the register must record` `s 1081(1) another occasion` EQUALS NOTHING

-- s 1081(3), (4), (5), (6)
#ASSERT `s 1081(3) an annotation is required for the document` TRUE EQUALS JUST FALSE
#ASSERT `s 1081(3) an annotation is required for the document` FALSE EQUALS NOTHING
#ASSERT `s 1081(4) the note may be removed` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1081(4) the note may be removed` FALSE EQUALS JUST FALSE; name-test sweep: a function named for a grant answers NOTHING, not JUST FALSE, when the "if" gate of the grant fails (the Guide's "limits a grant ... in its own wording"); the failed "if" is not the text's own "may not" (fork F30)
#ASSERT `s 1081(4) the note may be removed` FALSE EQUALS NOTHING
#ASSERT `s 1081(5) the registrar's duty or power with respect to annotation yields to the court's direction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1081(5) the registrar's duty or power with respect to annotation yields to the court's direction` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1081(5) the registrar's duty or power with respect to annotation yields to the court's direction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1081(5) the registrar's duty or power with respect to annotation yields to the court's direction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1081(6) the note is part of the register for all purposes of the Companies Acts` TRUE EQUALS JUST TRUE
#ASSERT `s 1081(6) the note is part of the register for all purposes of the Companies Acts` FALSE EQUALS NOTHING

-- s 1081A: the registrar's objectives, while performing the registrar's functions
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 1 (that any person required to deliver a document to the registrar does so, and that the requirements for proper delivery are complied with)` TRUE EQUALS JUST TRUE
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 1 (that any person required to deliver a document to the registrar does so, and that the requirements for proper delivery are complied with)` FALSE EQUALS NOTHING
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 2 (that information contained in the register is accurate and that the register contains everything it ought to contain)` TRUE EQUALS JUST TRUE
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 2 (that information contained in the register is accurate and that the register contains everything it ought to contain)` FALSE EQUALS NOTHING
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 3 (that records kept by the registrar do not create a false or misleading impression to members of the public)` TRUE EQUALS JUST TRUE
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 3 (that records kept by the registrar do not create a false or misleading impression to members of the public)` FALSE EQUALS NOTHING
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 4 (to prevent companies and others from carrying out unlawful activities or facilitating the carrying out by others of unlawful activities)` TRUE EQUALS JUST TRUE
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) Objective 4 (to prevent companies and others from carrying out unlawful activities or facilitating the carrying out by others of unlawful activities)` FALSE EQUALS NOTHING
#ASSERT `s 1081A(1) the registrar must seek to promote the objective` `s 1081A(1) another aim` TRUE EQUALS NOTHING
#ASSERT `s 1081A(2) the reference to the register in Objective 2 includes the records` TRUE EQUALS JUST TRUE
#ASSERT `s 1081A(2) the reference to the register in Objective 2 includes the records` FALSE EQUALS NOTHING

-- s 1082(1): the positions regulations may give a unique identifier for
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1)(a) a director of a company` EQUALS JUST TRUE
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1)(b) the secretary (or a joint secretary) of a company` EQUALS JUST TRUE
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1)(ba) an authorised corporate service provider` EQUALS JUST TRUE
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1)(bb) an individual whose identity is verified` EQUALS JUST TRUE
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1)(c) in the case of an overseas company whose particulars are registered under section 1046, a person who holds a position specified by regulations under that section` EQUALS JUST TRUE
#ASSERT `s 1082(1) regulations may provide for a unique identifier to identify the person` `s 1082(1) another position` EQUALS NOTHING

-- s 1083(1): originals in hard copy kept for two years after receipt (received 10 March 2020: kept through 10 March 2022), after which they may be destroyed provided the information is recorded
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 1 1 2021) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 10 3 2022) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 11 3 2022) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 11 3 2022) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 1 1 2030) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1083(1) the registrar may destroy the original` FALSE (Date 10 3 2020) (Date 11 3 2022) TRUE FALSE EQUALS NOTHING
#ASSERT `s 1083(1) the registrar may destroy the original` TRUE (Date 10 3 2020) (Date 11 3 2022) TRUE TRUE EQUALS NOTHING

-- s 1083(2): no obligation to keep originals delivered in electronic form, provided the information is recorded
#ASSERT `s 1083(2) the registrar is under no obligation to keep the original` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1083(2) the registrar is under no obligation to keep the original` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1083(2) the registrar is under no obligation to keep the original` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1083(2) the registrar is under no obligation to keep the original` FALSE FALSE EQUALS NOTHING

-- s 1084(1): the three occasions; the relevant date
#ASSERT `s 1084(1) this section applies` `s 1084(1)(a) a company is dissolved` EQUALS JUST TRUE
#ASSERT `s 1084(1) the relevant date` `s 1084(1)(a) a company is dissolved` (Date 1 7 2000) EQUALS (JUST (Date 1 7 2000))
#ASSERT `s 1084(1) this section applies` `s 1084(1)(b) an overseas company ceases to have any connection with the United Kingdom by virtue of which it is required to register particulars under section 1046` EQUALS JUST TRUE
#ASSERT `s 1084(1) the relevant date` `s 1084(1)(b) an overseas company ceases to have any connection with the United Kingdom by virtue of which it is required to register particulars under section 1046` (Date 1 7 2000) EQUALS (JUST (Date 1 7 2000))
#ASSERT `s 1084(1) this section applies` `s 1084(1)(c) a credit or financial institution ceases to be within section 1050 (overseas institutions required to file accounts with the registrar)` EQUALS JUST TRUE
#ASSERT `s 1084(1) the relevant date` `s 1084(1)(c) a credit or financial institution ceases to be within section 1050 (overseas institutions required to file accounts with the registrar)` (Date 1 7 2000) EQUALS (JUST (Date 1 7 2000))
#ASSERT `s 1084(1) this section applies` `s 1084(1) another occasion` EQUALS JUST FALSE
#ASSERT `s 1084(1) the relevant date` `s 1084(1) another occasion` (Date 1 7 2000) EQUALS NOTHING

-- s 1084(1A): after the end of the period of 20 years beginning with the relevant date (1 July 2000: ends 30 June 2020; 29 February 2000: ends 28 February 2020)
#ASSERT `s 1084(1A) the registrar need not make the information available for public inspection on the day` (Date 1 7 2000) (Date 30 6 2020) EQUALS JUST FALSE
#ASSERT `s 1084(1A) the registrar need not make the information available for public inspection on the day` (Date 1 7 2000) (Date 1 7 2020) EQUALS JUST TRUE
#ASSERT `s 1084(1A) the registrar need not make the information available for public inspection on the day` (Date 1 7 2000) (Date 1 7 2019) EQUALS JUST FALSE
#ASSERT `s 1084(1A) the registrar need not make the information available for public inspection on the day` (Date 29 2 2000) (Date 28 2 2020) EQUALS JUST FALSE
#ASSERT `s 1084(1A) the registrar need not make the information available for public inspection on the day` (Date 29 2 2000) (Date 29 2 2020) EQUALS JUST TRUE

-- s 1084(2) and (2AA): at any time after the period of two years beginning with the relevant date (1 July 2000: ends 30 June 2002)
#ASSERT `s 1084(2) the registrar of companies for England and Wales may direct that the records be removed to the Public Record Office on the day` (Date 1 7 2000) (Date 30 6 2002) EQUALS JUST FALSE
#ASSERT `s 1084(2) the registrar of companies for England and Wales may direct that the records be removed to the Public Record Office on the day` (Date 1 7 2000) (Date 1 7 2002) EQUALS JUST TRUE
#ASSERT `s 1084(2) the registrar of companies for England and Wales may direct that the records be removed to the Public Record Office on the day` (Date 1 7 2000) (Date 1 1 2001) EQUALS JUST FALSE
#ASSERT `s 1084(2AA) the registrar of companies for Northern Ireland may direct that the records be removed to the Public Record Office of Northern Ireland on the day` (Date 1 7 2000) (Date 30 6 2002) EQUALS JUST FALSE
#ASSERT `s 1084(2AA) the registrar of companies for Northern Ireland may direct that the records be removed to the Public Record Office of Northern Ireland on the day` (Date 1 7 2000) (Date 1 7 2002) EQUALS JUST TRUE
#ASSERT `s 1084(2AA) the registrar of companies for Northern Ireland may direct that the records be removed to the Public Record Office of Northern Ireland on the day` (Date 1 7 2000) (Date 1 1 2001) EQUALS JUST FALSE
#ASSERT `s 1084(2) the registrar of companies for England and Wales may direct that the records be removed to the Public Record Office on the day` (Date 29 2 2000) (Date 28 2 2002) EQUALS JUST FALSE
#ASSERT `s 1084(2) the registrar of companies for England and Wales may direct that the records be removed to the Public Record Office on the day` (Date 29 2 2000) (Date 1 3 2002) EQUALS JUST TRUE
#ASSERT `s 1084(3) the records are to be disposed of under the enactments relating to the Public Record Office` TRUE EQUALS JUST TRUE
#ASSERT `s 1084(3) the records are to be disposed of under the enactments relating to the Public Record Office` FALSE EQUALS NOTHING
#ASSERT `s 1084(4) the body is a company for the purposes of subsection (1)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 1084(4) the body is a company for the purposes of subsection (1)(a)` FALSE EQUALS NOTHING

-- s 1084A(2): "optional information" means information about the company that it is neither obliged nor authorised to deliver but for the regulations
#ASSERT `s 1084A(2) the information is optional information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1084A(2) the information is optional information` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1084A(2) the information is optional information` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1084A(2) the information is optional information` TRUE TRUE FALSE EQUALS JUST FALSE

-- s 1085(1): any person may inspect the register, subject to the provisions named in subsection (3); (2): originals if, and only if, the record is illegible or unavailable
#ASSERT `s 1085(1) the person may inspect the material on the register` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1085(1) the person may inspect the material on the register` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1085(1) the person may inspect the material on the register` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1085(1) the person may inspect the material on the register` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1085(2) the right of inspection extends to the original` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1085(2) the right of inspection extends to the original` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1085(2) the right of inspection extends to the original` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1085(2) the right of inspection extends to the original` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1085(2) the right of inspection extends to the original` FALSE TRUE FALSE EQUALS NOTHING

-- s 1086: a copy of material available for public inspection; the fee for a copy of enhanced disclosure document material must not exceed the administrative cost
#ASSERT `s 1086(1) the person may require a copy of the material` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1086(1) the person may require a copy of the material` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1086(1) the person may require a copy of the material` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1086(2) the fee complies with the limit` TRUE 5 5 EQUALS JUST TRUE
#ASSERT `s 1086(2) the fee complies with the limit` TRUE 4 5 EQUALS JUST TRUE
#ASSERT `s 1086(2) the fee complies with the limit` TRUE 6 5 EQUALS JUST FALSE
#ASSERT `s 1086(2) the fee complies with the limit` FALSE 100 5 EQUALS NOTHING

-- s 1087(1): every listed kind of material must not be made available for public inspection, so far as it forms part of the register; other material is not decided
