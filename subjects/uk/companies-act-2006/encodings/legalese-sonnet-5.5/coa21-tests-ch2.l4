IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa21-ch2-opting-in`

-- coa21-tests-ch2.l4: tests for coa21-ch2-opting-in.l4 (Part 28, Chapter 2, ss 966 to 972).
-- Every expected value is written from the text of the section named beside it, before the run, and never copied from the code's output.

§ `Tests for Chapter 2`

-- s 971(1): the definitions ("means": a case outside the definition is JUST FALSE).
#ASSERT `s 971(1) the rights are voting rights` TRUE EQUALS JUST TRUE
#ASSERT `s 971(1) the rights are voting rights` FALSE EQUALS JUST FALSE
#ASSERT `s 971(1) the shares are voting shares` TRUE EQUALS JUST TRUE
#ASSERT `s 971(1) the shares are voting shares` FALSE EQUALS JUST FALSE
#ASSERT `s 971(1) the person is the offeror` TRUE EQUALS JUST TRUE
#ASSERT `s 971(1) the person is the offeror` FALSE EQUALS JUST FALSE
#ASSERT `s 971(1) the day is within the offer period` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 971(1) the day is within the offer period` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 971(1) the day is within the offer period` NOTHING EQUALS NOTHING
#ASSERT `s 971(1) the offer is a takeover bid` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 971(1) the offer is a takeover bid` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 971(1) the offer is a takeover bid` NOTHING EQUALS NOTHING

-- s 971(2): securities convertible into shares, and debentures carrying voting rights, are treated as shares.
#ASSERT `s 971(2) the securities are treated as shares in the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 971(2) the securities are treated as shares in the company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 971(2) the securities are treated as shares in the company` FALSE FALSE EQUALS JUST FALSE

-- s 966(2): the first condition: voting shares admitted to trading on a UK regulated market.
#ASSERT `s 966(2) the first condition is met` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 966(2) the first condition is met` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 966(2) the first condition is met` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 966(2) the first condition is met` FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 966(3): the second condition: no transfer restrictions, or both disapplications.
#ASSERT `s 966(3) the second condition is met` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 966(3) the second condition is met` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 966(3) the second condition is met` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3) the second condition is met` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 966(3) the second condition is met` TRUE FALSE FALSE EQUALS JUST FALSE

-- s 966(3A): the third condition: no voting restrictions, or disapplied at both kinds of meeting, or compensated by specific pecuniary advantages.
#ASSERT `s 966(3A) the third condition is met` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 966(3A) the third condition is met` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 966(3A) the third condition is met` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 966(3A) the third condition is met` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3A) the third condition is met` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3A) the third condition is met` TRUE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 966(3B), (3C): the fourth condition: no other provision incompatible with requirement (a), (b) or (c).
#ASSERT `s 966(3B) the fourth condition is met` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 966(3B) the fourth condition is met` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3B) the fourth condition is met` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3B) the fourth condition is met` FALSE FALSE TRUE EQUALS JUST FALSE

-- s 966(3D), (3E), (3F), (3G).
#ASSERT `s 966(3D) the vote is within subsections (3A)(b) and (3C)(a)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 966(3D) the vote is within subsections (3A)(b) and (3C)(a)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 966(3D) the vote is within subsections (3A)(b) and (3C)(a)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 966(3E) the action might result in the frustration of the takeover bid` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 966(3E) the action might result in the frustration of the takeover bid` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 966(3E) the action might result in the frustration of the takeover bid` NOTHING EQUALS NOTHING
#ASSERT `s 966(3F) the thing is voting shares for subsections (3), (3A) and (3C)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 966(3F) the thing is voting shares for subsections (3), (3A) and (3C)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 966(3F) the thing is voting shares for subsections (3), (3A) and (3C)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 966(3G) the shares are multiple-vote shares` TRUE 2 EQUALS JUST TRUE
#ASSERT `s 966(3G) the shares are multiple-vote shares` TRUE 1 EQUALS JUST FALSE
#ASSERT `s 966(3G) the shares are multiple-vote shares` FALSE 2 EQUALS JUST FALSE

-- s 966(4): the fifth condition: no special rights held by or exercisable for a minister.
#ASSERT `s 966(4) the fifth condition is met` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 966(4) the fifth condition is met` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 966(4) the fifth condition is met` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 966(4) the fifth condition is met` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 966(4) the fifth condition is met` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

