-- s 970(4): on summary conviction a fine not exceeding level 3 and a daily default fine not exceeding one-tenth of level 3.
#ASSERT `s 970(4) the penalty` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 970(4) the penalty` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 970(4) the penalty` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 970(4) the penalty` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 970(4) the penalty` `on conviction on indictment` EQUALS NOTHING

-- s 972(1): the transitory provisions apply where a bid is made for an opted-in company, until the repeal of the 1985 Act sections.
#ASSERT `s 972(1) the 1985 Act provisions have effect as the section provides` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 972(1) the 1985 Act provisions have effect as the section provides` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 972(1) the 1985 Act provisions have effect as the section provides` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 972(1) the 1985 Act provisions have effect as the section provides` NOTHING FALSE EQUALS NOTHING

-- s 972(2): the offeror's requisition counts as a members' requisition if he holds not less than 75% in value at the deposit (boundary).
#ASSERT `s 972(2) the requisition is treated as a members' requisition` (JUST TRUE) TRUE 75 100 EQUALS JUST TRUE
#ASSERT `s 972(2) the requisition is treated as a members' requisition` (JUST TRUE) TRUE 74 100 EQUALS NOTHING
#ASSERT `s 972(2) the requisition is treated as a members' requisition` (JUST TRUE) FALSE 90 100 EQUALS NOTHING
#ASSERT `s 972(2) the requisition is treated as a members' requisition` (JUST FALSE) TRUE 90 100 EQUALS NOTHING

-- s 972(3): 14 days' notice for the first meeting after the offer period, held while the offeror holds not less than 75% (boundary).
#ASSERT `s 972(3) the days' notice for a special resolution` (JUST TRUE) TRUE 75 100 EQUALS JUST 14
#ASSERT `s 972(3) the days' notice for a special resolution` (JUST TRUE) TRUE 74 100 EQUALS NOTHING
#ASSERT `s 972(3) the days' notice for a special resolution` (JUST TRUE) FALSE 90 100 EQUALS NOTHING
#ASSERT `s 972(3) the days' notice for a special resolution` NOTHING TRUE 90 100 EQUALS NOTHING
#ASSERT `s 972(4) the thing is voting shares for section 972` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 972(4) the thing is voting shares for section 972` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 972(4) the thing is voting shares for section 972` FALSE FALSE EQUALS NOTHING
