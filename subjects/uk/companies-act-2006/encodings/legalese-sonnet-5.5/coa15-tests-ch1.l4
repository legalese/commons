    `s 663(3) states prescribed particulars of the rights attached to the shares of the class` IS FALSE
    `s 663(3) states the total number of shares of the class` IS TRUE
    `s 663(3) states the aggregate nominal value of the shares of the class` IS TRUE

`fixture: a class entry without the number` MEANS `s 663(3) class entry` WITH
    `s 663(3) states prescribed particulars of the rights attached to the shares of the class` IS TRUE
    `s 663(3) states the total number of shares of the class` IS FALSE
    `s 663(3) states the aggregate nominal value of the shares of the class` IS TRUE

