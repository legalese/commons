-- expect: FULFILLED
#TRACE `s 661(4)(a) the subscriber or director may apply to the court` Director AT 0 WITH
    PARTY Director DOES `s 661(4)(a) apply to the court for relief` AT 3
-- (a permission with no WITHIN stands)
-- expect: RESIDUAL
#TRACE `s 661(4)(a) the subscriber or director may apply to the court` `Subscriber to the memorandum` AT 0 WITH
    (WAITUNTIL 5)

-- ---- s 662 ---------------------------------------------------------------------------------------------

`fixture: forfeited` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(a) forfeited, or surrendered in lieu of forfeiture, in pursuance of the articles, for failure to pay a sum payable in respect of the shares`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: forfeited, below the authorised minimum` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(a) forfeited, or surrendered in lieu of forfeiture, in pursuance of the articles, for failure to pay a sum payable in respect of the shares`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS TRUE

`fixture: forfeited, then disposed of` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(a) forfeited, or surrendered in lieu of forfeiture, in pursuance of the articles, for failure to pay a sum payable in respect of the shares`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS TRUE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS TRUE

`fixture: surrendered under the Building Societies Act` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(b) surrendered to the company in pursuance of section 102C(1)(b) of the Building Societies Act 1986`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: acquired by the company, beneficial interest` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(c) acquired by the company otherwise than in accordance with Part 18 or Part 30`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS TRUE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: acquired by the company, no beneficial interest` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(c) acquired by the company otherwise than in accordance with Part 18 or Part 30`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: acquired by a nominee, beneficial interest` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(d) acquired by a nominee of the company from a third party without financial assistance given by the company`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS TRUE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: acquired with financial assistance, beneficial interest` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1)(e) acquired by a person with financial assistance given to him by the company for the purpose of or in connection with the acquisition`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS TRUE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: another way of holding` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS TRUE
    `s 662(1) how the shares come to be held` IS `s 662(1) in another way`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

`fixture: a private company` MEANS `s 662(1) shares held by or for a public company` WITH
    `s 662(1) the company is a public company` IS FALSE
    `s 662(1) how the shares come to be held` IS `s 662(1)(a) forfeited, or surrendered in lieu of forfeiture, in pursuance of the articles, for failure to pay a sum payable in respect of the shares`
    `s 662(1)(c) to (e) the company has a beneficial interest in the shares` IS FALSE
    `s 662(2) the shares or any interest of the company in them have been previously disposed of` IS FALSE
    `s 662(2)(b) the cancellation brings the nominal value of the company's allotted share capital below the authorised minimum` IS FALSE

#ASSERT `s 662(1) this section applies to the shares` `fixture: forfeited` EQUALS JUST TRUE
#ASSERT `s 662(1) this section applies to the shares` `fixture: surrendered under the Building Societies Act` EQUALS JUST TRUE
