IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch1`

-- coa15-tests-ch1.l4: tests of coa15-ch1.l4 (ss 658 to 676). Expected values are written from the text, one rule at a time,
-- before the run; none is copied from an output. A failing assertion is a finding.
-- A regulative rule is exercised with #TRACE; the expected outcome is written in a comment beside it (a DEONTIC value cannot be
-- compared with EQUALS on the stable binary), and `work/trace-expect.py` reads those comments back against the run.

-- ---- s 658 ---------------------------------------------------------------------------------------------

-- limited company, acquisition in accordance with the Part: the exception ("except in accordance with") says no to the prohibition
#ASSERT `s 658(1) a limited company must not make the acquisition` TRUE (JUST TRUE) EQUALS JUST FALSE
-- limited company, acquisition not in accordance: the prohibition bites
#ASSERT `s 658(1) a limited company must not make the acquisition` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 658(1) a limited company must not make the acquisition` TRUE NOTHING EQUALS NOTHING
-- not a limited company: the text speaks of "A limited company" only
#ASSERT `s 658(1) a limited company must not make the acquisition` FALSE (JUST FALSE) EQUALS NOTHING

-- expect: BREACH
#TRACE `s 658(1) the limited company shant acquire its own shares` AT 0 WITH
    PARTY Company DOES `s 658(1) acquire its own shares, whether by purchase, subscription or otherwise` AT 5
-- (a prohibition with no WITHIN stands: waiting does not discharge it)
-- expect: RESIDUAL
#TRACE `s 658(1) the limited company shant acquire its own shares` AT 0 WITH
    (WAITUNTIL 5)

#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) the company` NOTHING EQUALS JUST TRUE
#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) an officer of the company` NOTHING EQUALS NOTHING
#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) a director of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 658(2)(a) the person commits an offence` TRUE `s 658(2) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 658(2)(a) the person commits an offence` FALSE `s 658(2) the company` NOTHING EQUALS JUST FALSE

#ASSERT `s 658(2)(b) the purported acquisition is void` TRUE EQUALS JUST TRUE
#ASSERT `s 658(2)(b) the purported acquisition is void` FALSE EQUALS JUST FALSE

-- s 658(3): (a) two years or a fine or both; (b)(i) England and Wales twelve months; (ii) Scotland or Northern Ireland six months
#ASSERT `s 658(3) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 658(3) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 658(3) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 658(3) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 658(3) the penalty on conviction` `on summary conviction` EQUALS NOTHING

-- ---- s 659 ---------------------------------------------------------------------------------------------

#ASSERT `s 659(1) a limited company may acquire its own shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 659(1) a limited company may acquire its own shares` FALSE FALSE EQUALS NOTHING
#ASSERT `s 659(1) a limited company may acquire its own shares` TRUE TRUE EQUALS NOTHING

#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(a) an acquisition of shares in a reduction of capital duly made` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(b)(i) a purchase in pursuance of an order of the court under section 98` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(b)(ii) a purchase in pursuance of an order of the court under section 721(6)` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(b)(iii) a purchase in pursuance of an order of the court under section 759` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(b)(iv) a purchase in pursuance of an order of the court under Part 30` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2)(c) a forfeiture of shares, or acceptance of shares surrendered in lieu, in pursuance of the articles, for failure to pay a sum payable in respect of the shares` EQUALS JUST TRUE
#ASSERT `s 659(2) section 658 does not prohibit the acquisition` `s 659(2) any other acquisition` EQUALS NOTHING

-- ---- ss 660 and 661: fixtures --------------------------------------------------------------------------

-- A nominee holds shares taken by a subscriber to the memorandum; the company has no beneficial interest.
`fixture: subscriber's nominee` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(a) taken by a subscriber to the memorandum as nominee of the company`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS FALSE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS FALSE

-- Shares issued to a nominee (route (b)).
`fixture: issued to a nominee` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(b) issued to a nominee of the company`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS FALSE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS FALSE

-- Shares acquired by a nominee of a public company with financial assistance, the company having a beneficial interest: s 660(3)(a).
`fixture: public company nominee with assistance` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(c) acquired by a nominee of the company, partly paid up, from a third person`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS TRUE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS TRUE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS TRUE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS TRUE

-- The same, but the company has no beneficial interest: s 660(3)(b).
`fixture: nominee, no beneficial interest` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(c) acquired by a nominee of the company, partly paid up, from a third person`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS FALSE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS TRUE

`fixture: nominee, company has a beneficial interest` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(c) acquired by a nominee of the company, partly paid up, from a third person`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS TRUE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS TRUE

`fixture: public nominee without assistance` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(c) acquired by a nominee of the company, partly paid up, from a third person`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS TRUE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS TRUE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS TRUE

`fixture: another way` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS TRUE
    `s 660(1) how the shares come to the nominee` IS `s 660(1) in another way`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS FALSE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS FALSE

`fixture: unlimited company` MEANS `s 660(1) shares held by a nominee` WITH
    `s 660(1) the company is a limited company` IS FALSE
    `s 660(1) how the shares come to the nominee` IS `s 660(1)(b) issued to a nominee of the company`
    `s 660(3)(a) the shares were acquired otherwise than by subscription by a nominee of a public company` IS FALSE
    `s 660(3)(a)(i) a person acquires shares in the company with financial assistance given to him by the company for the purpose of or in connection with the acquisition` IS FALSE
    `s 660(3)(a)(ii) the company has a beneficial interest in the shares` IS FALSE
    `s 660(3)(b) the shares were acquired by a nominee of the company` IS FALSE

-- ---- s 660 ---------------------------------------------------------------------------------------------

#ASSERT `s 660(1) this section applies to the shares` `fixture: subscriber's nominee` EQUALS JUST TRUE
#ASSERT `s 660(1) this section applies to the shares` `fixture: issued to a nominee` EQUALS JUST TRUE
#ASSERT `s 660(1) this section applies to the shares` `fixture: nominee, no beneficial interest` EQUALS JUST TRUE
#ASSERT `s 660(1) this section applies to the shares` `fixture: another way` EQUALS JUST FALSE
#ASSERT `s 660(1) this section applies to the shares` `fixture: unlimited company` EQUALS JUST FALSE

#ASSERT `s 660(3)(a) section 660 does not apply to the shares` `fixture: public company nominee with assistance` EQUALS JUST TRUE
#ASSERT `s 660(3)(a) section 660 does not apply to the shares` `fixture: nominee, no beneficial interest` EQUALS NOTHING
#ASSERT `s 660(3)(a) section 660 does not apply to the shares` `fixture: subscriber's nominee` EQUALS NOTHING
-- a nominee of a public company, but no financial assistance: the "where" limb fails
#ASSERT `s 660(3)(a) section 660 does not apply to the shares` `fixture: public nominee without assistance` EQUALS JUST FALSE

#ASSERT `s 660(3)(b) section 660 does not apply to the shares` `fixture: nominee, no beneficial interest` EQUALS JUST TRUE
#ASSERT `s 660(3)(b) section 660 does not apply to the shares` `fixture: nominee, company has a beneficial interest` EQUALS JUST FALSE
#ASSERT `s 660(3)(b) section 660 does not apply to the shares` `fixture: subscriber's nominee` EQUALS NOTHING

#ASSERT `s 660(2)(a) the shares are treated as held by the nominee on his own account` `fixture: subscriber's nominee` EQUALS JUST TRUE
#ASSERT `s 660(2)(a) the shares are treated as held by the nominee on his own account` `fixture: issued to a nominee` EQUALS JUST TRUE
#ASSERT `s 660(2)(a) the shares are treated as held by the nominee on his own account` `fixture: public company nominee with assistance` EQUALS JUST FALSE
#ASSERT `s 660(2)(a) the shares are treated as held by the nominee on his own account` `fixture: nominee, no beneficial interest` EQUALS JUST FALSE
#ASSERT `s 660(2)(a) the shares are treated as held by the nominee on his own account` `fixture: another way` EQUALS JUST FALSE
#ASSERT `s 660(2)(b) the company is regarded as having no beneficial interest in the shares` `fixture: subscriber's nominee` EQUALS JUST TRUE
#ASSERT `s 660(2)(b) the company is regarded as having no beneficial interest in the shares` `fixture: nominee, no beneficial interest` EQUALS JUST FALSE

-- ---- s 661 ---------------------------------------------------------------------------------------------

#ASSERT `s 661(1) this section applies to the shares` `fixture: subscriber's nominee` EQUALS JUST TRUE
#ASSERT `s 661(1) this section applies to the shares` `fixture: nominee, company has a beneficial interest` EQUALS JUST TRUE
#ASSERT `s 661(1) this section applies to the shares` `fixture: nominee, no beneficial interest` EQUALS JUST FALSE
#ASSERT `s 661(1) this section applies to the shares` `fixture: another way` EQUALS JUST FALSE
#ASSERT `s 661(1) this section applies to the shares` `fixture: unlimited company` EQUALS JUST FALSE
#ASSERT `s 661(5) section 661 does not apply to the shares` `fixture: nominee, no beneficial interest` EQUALS JUST TRUE
#ASSERT `s 661(5) section 661 does not apply to the shares` `fixture: nominee, company has a beneficial interest` EQUALS JUST FALSE
#ASSERT `s 661(5) section 661 does not apply to the shares` `fixture: subscriber's nominee` EQUALS NOTHING

-- Called on to pay on 1 March 2026: 21 days from being called on ends on 22 March 2026.
-- Another subscriber, shares agreed to be taken as subscriber (route (a)): not yet 21 days (22 March): no liability yet.
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: subscriber's nominee` `s 661(2)(a) another subscriber to the memorandum` (Date 1 3 2026) NOTHING (Date 22 3 2026) EQUALS JUST FALSE
-- 23 March 2026, nothing paid: the other subscribers are liable on route (a)
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: subscriber's nominee` `s 661(2)(a) another subscriber to the memorandum` (Date 1 3 2026) NOTHING (Date 23 3 2026) EQUALS JUST TRUE
-- a director is not the person route (a) names
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: subscriber's nominee` `s 661(2)(b) a director of the company when the shares were issued to or acquired by the nominee` (Date 1 3 2026) NOTHING (Date 23 3 2026) EQUALS NOTHING
-- route (b) (issued to a nominee): the directors when the shares were issued are liable
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: issued to a nominee` `s 661(2)(b) a director of the company when the shares were issued to or acquired by the nominee` (Date 1 3 2026) NOTHING (Date 23 3 2026) EQUALS JUST TRUE
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: issued to a nominee` `s 661(2)(a) another subscriber to the memorandum` (Date 1 3 2026) NOTHING (Date 23 3 2026) EQUALS NOTHING
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: issued to a nominee` `s 661(2) any other person` (Date 1 3 2026) NOTHING (Date 23 3 2026) EQUALS NOTHING
-- paid on the last day (22 March): no failure
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: issued to a nominee` `s 661(2)(b) a director of the company when the shares were issued to or acquired by the nominee` (Date 1 3 2026) (JUST (Date 22 3 2026)) (Date 30 3 2026) EQUALS JUST FALSE
-- paid late (23 March): the failure occurred
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: issued to a nominee` `s 661(2)(b) a director of the company when the shares were issued to or acquired by the nominee` (Date 1 3 2026) (JUST (Date 23 3 2026)) (Date 30 3 2026) EQUALS JUST TRUE
-- the section does not apply (no beneficial interest on a nominee's acquisition)
#ASSERT `s 661(2) the person is jointly and severally liable with the nominee to pay the amount` `fixture: nominee, no beneficial interest` `s 661(2)(b) a director of the company when the shares were issued to or acquired by the nominee` (Date 1 3 2026) NOTHING (Date 30 3 2026) EQUALS JUST FALSE

#ASSERT `s 661(3) the court may relieve the subscriber or director from his liability` TRUE TRUE TRUE EQUALS JUST TRUE
