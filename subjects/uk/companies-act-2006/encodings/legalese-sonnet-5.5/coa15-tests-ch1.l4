#ASSERT `s 670(2) the charge is permitted` (`fixture: a charge` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(2) the charge is permitted` (`fixture: a charge` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(3) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 670(3) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 670(3) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(3) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(4) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 670(4) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(4) the charge is permitted` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE
-- void unless one of the three limbs permits
#ASSERT `s 670(1) the lien or charge is void` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 670(1) the lien or charge is void` (`fixture: a charge` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(1) the lien or charge is void` (`fixture: a charge` TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 670(1) the lien or charge is void` (`fixture: a charge` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 670(1) the lien or charge is void` (`fixture: a charge` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING

