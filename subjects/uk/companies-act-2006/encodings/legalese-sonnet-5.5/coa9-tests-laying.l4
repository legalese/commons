IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-laying`


-- Tests for coa9-laying.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5842-5851 of ukpga-2006-46.txt).

-- ---- s 437 ---------------------------------------------------------------------------------------------------
-- a public company whose directors laid the copies
#ASSERT (`s 437(1) the directors of the public company have laid copies of the annual accounts and reports before the company in general meeting` TRUE TRUE) EQUALS JUST TRUE
-- a public company whose directors did not
#ASSERT (`s 437(1) the directors of the public company have laid copies of the annual accounts and reports before the company in general meeting` TRUE FALSE) EQUALS JUST FALSE
-- not a public company: outside "The directors of a public company"
#ASSERT (`s 437(1) the directors of the public company have laid copies of the annual accounts and reports before the company in general meeting` FALSE TRUE) EQUALS NOTHING
-- not a public company
#ASSERT (`s 437(1) the directors of the public company have laid copies of the annual accounts and reports before the company in general meeting` FALSE FALSE) EQUALS NOTHING
-- The end of the period for filing is 30 June 2028 (an input: section 442 is in another part).
-- laid on the last day: "not later than the end of the period"
#ASSERT (`s 437(2) the directors laid the copies in time` (Date 30 6 2028) (Date 30 6 2028)) EQUALS JUST TRUE
-- laid the day before
#ASSERT (`s 437(2) the directors laid the copies in time` (Date 29 6 2028) (Date 30 6 2028)) EQUALS JUST TRUE
-- laid the day after
#ASSERT (`s 437(2) the directors laid the copies in time` (Date 1 7 2028) (Date 30 6 2028)) EQUALS JUST FALSE
-- a public company: a general meeting at which the accounts and reports are laid
#ASSERT (`s 437(3) the meeting is an accounts meeting` TRUE TRUE) EQUALS JUST TRUE
-- a public company: a "means" definition
#ASSERT (`s 437(3) the meeting is an accounts meeting` TRUE FALSE) EQUALS JUST FALSE
-- "in relation to a public company": not a public company
#ASSERT (`s 437(3) the meeting is an accounts meeting` FALSE TRUE) EQUALS NOTHING

-- ---- s 437 as a regulative rule ---------------------------------------------------------------------------------
-- The obligation arises on 1 June 2028 and the period for filing ends on 30 June 2028: 29 days. Expected by reading the section:
-- copies laid on day 29 are laid by the end of the period; nothing laid by day 30 is a breach by the directors.
#TRACE `s 437 the directors of a public company must lay copies before the company in general meeting` (Date 1 6 2028) (Date 30 6 2028) AT 0 WITH
    PARTY Director DOES `s 437 lay copies of the annual accounts and reports before the company in general meeting` AT 29
-- expected: FULFILLED

#TRACE `s 437 the directors of a public company must lay copies before the company in general meeting` (Date 1 6 2028) (Date 30 6 2028) AT 0 WITH
    PARTY Director DOES `s 437 lay copies of the annual accounts and reports before the company in general meeting` AT 30
-- expected: BREACH BY Director (an act after the last day)

#TRACE `s 437 the directors of a public company must lay copies before the company in general meeting` (Date 1 6 2028) (Date 30 6 2028) AT 0 WITH
    (WAITUNTIL 30)
-- expected: BREACH BY Director (nothing laid by the last day)


-- ---- s 438 ---------------------------------------------------------------------------------------------------
-- not complied with; a director immediately before the end of the period
#ASSERT (`s 438(1) the person commits an offence` TRUE TRUE) EQUALS JUST TRUE
-- not a director at that time: outside "every person who ... was a director"
#ASSERT (`s 438(1) the person commits an offence` TRUE FALSE) EQUALS NOTHING
-- complied with: the "If" fails
#ASSERT (`s 438(1) the person commits an offence` FALSE TRUE) EQUALS JUST FALSE
-- charged, and proves all reasonable steps were taken
#ASSERT (`s 438(2) this section gives the person a defence on these facts` TRUE TRUE) EQUALS JUST TRUE
-- charged, but proves no such steps: this section gives no defence on these facts
#ASSERT (`s 438(2) this section gives the person a defence on these facts` TRUE FALSE) EQUALS JUST FALSE
-- not charged: "a person charged with such an offence"
#ASSERT (`s 438(2) this section gives the person a defence on these facts` FALSE TRUE) EQUALS NOTHING
-- "It is not a defence to prove that the documents in question were not in fact prepared"
#ASSERT (`s 438(3) proof that the documents were not in fact prepared as required is a defence` TRUE) EQUALS JUST FALSE
-- the subsection says nothing of other proofs
#ASSERT (`s 438(3) proof that the documents were not in fact prepared as required is a defence` FALSE) EQUALS NOTHING
-- level 5; the daily default fine is NOTHING because the text carries two versions (fork F30)
#ASSERT (`s 438(4) the penalty for an offence under section 438` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 5 1), NOTHING, FALSE)
-- only summary conviction is provided for
#ASSERT (`s 438(4) the penalty for an offence under section 438` `on conviction on indictment`) EQUALS NOTHING
-- The first version is one-tenth of level 5; the second is one-tenth of the greater of 5,000 pounds and level 4. Level 5 is taken as 5,000 and level 4 as 2,500 or 10,000.
-- one-tenth of level 5
#ASSERT (`s 438(4) the most the daily default fine may be in pounds on the version` `s 438(4) the first version: one-tenth of level 5 on the standard scale` 2500 5000) EQUALS 500
-- level 4 below 5,000: the greater is 5,000
#ASSERT (`s 438(4) the most the daily default fine may be in pounds on the version` `s 438(4) the second version: one-tenth of the greater of £5,000 or level 4 on the standard scale` 2500 5000) EQUALS 500
-- level 4 above 5,000: the greater is level 4
#ASSERT (`s 438(4) the most the daily default fine may be in pounds on the version` `s 438(4) the second version: one-tenth of the greater of £5,000 or level 4 on the standard scale` 10000 20000) EQUALS 1000
-- level 4 equal to 5,000
#ASSERT (`s 438(4) the most the daily default fine may be in pounds on the version` `s 438(4) the second version: one-tenth of the greater of £5,000 or level 4 on the standard scale` 5000 20000) EQUALS 500

