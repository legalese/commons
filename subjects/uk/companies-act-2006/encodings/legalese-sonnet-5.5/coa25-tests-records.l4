IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa25-records`

-- coa25-tests-records.l4: tests for coa25-records.l4 (ss 1134 to 1138).
-- Every expected value was decided by reading the section and written down before the run; none is copied from
-- the encoding's own output. The pounds in the fine-limit tests are TEST NUMBERS chosen for the arithmetic, not the
-- value of any level on the standard scale (the Act does not state them).

-- The penalty that s 1135(4) and s 1138(3) state, written out by hand from the text: "liable on summary conviction
-- to a fine not exceeding level 3 on the standard scale and, for continued contravention, a daily default fine not
-- exceeding one-tenth of level 3 on the standard scale".
`s 1135 test penalty level 3 with a tenth` MEANS
    Penalty WITH `how convicted` IS `on summary conviction`
                 `imprisonment not exceeding` IS NOTHING
                 `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 3 1)
                 `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
                 `imprisonment and fine together` IS FALSE

-- ---- s 1134 (arguments: a provision requires the document to be kept; s 2(1) answer; it is a debenture register)
#ASSERT `s 1134 the document is a company record` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE -- limb (a)
#ASSERT `s 1134 the document is a company record` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE -- required, but not by the Companies Acts
#ASSERT `s 1134 the document is a company record` TRUE NOTHING FALSE EQUALS NOTHING -- the s 2(1) answer is not known
#ASSERT `s 1134 the document is a company record` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE -- "means": no provision requires it
#ASSERT `s 1134 the document is a company record` FALSE NOTHING TRUE EQUALS JUST TRUE -- limb (b), a register of debenture holders
#ASSERT `s 1134 the document is a company record` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE -- limb (b) holds whatever (a) says

-- ---- s 1135(1) (arguments: form; arranged as the directors think fit; adequately recorded)
#ASSERT `s 1135(1) the company may keep its records in this way` `hard copy form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1135(1) the company may keep its records in this way` `electronic form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1135(1) the company may keep its records in this way` `electronic form` FALSE TRUE EQUALS NOTHING -- not arranged as the directors think fit
#ASSERT `s 1135(1) the company may keep its records in this way` `hard copy form` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1135(1) the company may keep its records in this way` `hard copy form` TRUE FALSE EQUALS JUST FALSE -- "provided" the information is adequately recorded
#ASSERT `s 1135(1) the company may keep its records in this way` `electronic form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1135(1) the company may keep its records in this way` `electronic form` FALSE FALSE EQUALS JUST FALSE

-- ---- s 1135(2)
#ASSERT `s 1135(2) the requirement of reproduction in hard copy form applies` `electronic form` EQUALS JUST TRUE
#ASSERT `s 1135(2) the requirement of reproduction in hard copy form applies` `hard copy form` EQUALS JUST FALSE -- "Where the records are kept in electronic form"
#ASSERT `s 1135(2) the company has met the requirement of reproduction in hard copy form` `electronic form` TRUE EQUALS JUST TRUE
#ASSERT `s 1135(2) the company has met the requirement of reproduction in hard copy form` `electronic form` FALSE EQUALS JUST FALSE
#ASSERT `s 1135(2) the company has met the requirement of reproduction in hard copy form` `hard copy form` FALSE EQUALS JUST TRUE -- nothing engages

-- ---- s 1135 as a whole (arguments: form; adequately recorded; capable of reproduction)
#ASSERT `s 1135 the company has complied with this section` `hard copy form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1135 the company has complied with this section` `hard copy form` FALSE TRUE EQUALS JUST FALSE -- the proviso of (1)
#ASSERT `s 1135 the company has complied with this section` `electronic form` TRUE FALSE EQUALS JUST FALSE -- (2) not met
#ASSERT `s 1135 the company has complied with this section` `electronic form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1135 the company has complied with this section` `electronic form` FALSE TRUE EQUALS JUST FALSE

-- ---- s 1135(3) (arguments: the s 1135 answer; the s 1121 answer)
#ASSERT `s 1135(3) an officer of the company commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE -- the company failed; the officer is in default
#ASSERT `s 1135(3) an officer of the company commits an offence` (JUST FALSE) (JUST FALSE) EQUALS NOTHING -- an officer not in default: limited by its own wording
#ASSERT `s 1135(3) an officer of the company commits an offence` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 1135(3) an officer of the company commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE -- the company did not fail
#ASSERT `s 1135(3) an officer of the company commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING

-- ---- s 1135(4)
#ASSERT `s 1135(4) the penalty for an offence under s 1135` (JUST TRUE) EQUALS JUST `s 1135 test penalty level 3 with a tenth`
#ASSERT `s 1135(4) the penalty for an offence under s 1135` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1135(4) the penalty for an offence under s 1135` NOTHING EQUALS NOTHING

-- the pounds a fine limit stands for (arguments: the limit; test pounds for the level; test pounds for the statutory maximum)
#ASSERT `s 1135(4) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 3 1) 1000 5000 EQUALS JUST 1000
#ASSERT `s 1135(4) the fine limit in pounds` (`a fine not exceeding a level on the standard scale` 3 0.1) 1000 5000 EQUALS JUST 100 -- one-tenth of level 3
#ASSERT `s 1135(4) the fine limit in pounds` (`a fine not exceeding the statutory maximum` 1) 1000 5000 EQUALS JUST 5000
#ASSERT `s 1135(4) the fine limit in pounds` (`a fine not exceeding an amount in pounds` 250) 1000 5000 EQUALS JUST 250
#ASSERT `s 1135(4) the fine limit in pounds` `a fine without a stated limit` 1000 5000 EQUALS NOTHING

-- ---- s 1135(5): "before 12th February 1979" (arguments: the date the instrument was made; it requires a hard copy register)
#ASSERT `s 1135(5) the instrument's requirement is to be read as requiring hard copy or electronic form` (Date 11 2 1979) TRUE EQUALS JUST TRUE -- the day before
#ASSERT `s 1135(5) the instrument's requirement is to be read as requiring hard copy or electronic form` (Date 12 2 1979) TRUE EQUALS NOTHING -- the day itself is not "before"
#ASSERT `s 1135(5) the instrument's requirement is to be read as requiring hard copy or electronic form` (Date 11 2 1979) FALSE EQUALS NOTHING -- the instrument does not require hard copy
#ASSERT `s 1135(5) the instrument's requirement is to be read as requiring hard copy or electronic form` (Date 1 1 1970) TRUE EQUALS JUST TRUE

-- ---- s 1136(2): the ten relevant provisions that are not shown as dots, and three that are not in the list
#ASSERT `s 1136(2) the provision is a relevant provision` "114" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "228" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "237" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "358" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "702" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "720" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "743" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "805" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "809" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "859Q" EQUALS JUST TRUE
#ASSERT `s 1136(2) the provision is a relevant provision` "859" EQUALS JUST FALSE
#ASSERT `s 1136(2) the provision is a relevant provision` "1136" EQUALS JUST FALSE
#ASSERT `s 1136(2) the provision is a relevant provision` "115" EQUALS JUST FALSE

-- ---- s 1136(6) (arguments: the place is specified in the regulations; all the records are kept there)
#ASSERT `s 1136(6) keeping the records available for inspection at the place complies with the requirement` TRUE FALSE EQUALS JUST FALSE -- "unless all the company's records ... are kept there"
#ASSERT `s 1136(6) keeping the records available for inspection at the place complies with the requirement` TRUE TRUE EQUALS NOTHING -- a necessary condition only
#ASSERT `s 1136(6) keeping the records available for inspection at the place complies with the requirement` FALSE TRUE EQUALS NOTHING -- not a place the regulations specify
#ASSERT `s 1136(6) keeping the records available for inspection at the place complies with the requirement` FALSE FALSE EQUALS NOTHING

-- ---- s 1137(2) (arguments: the obligation the regulations concern; the company fails to comply)
#ASSERT `s 1137(2) the company is treated as having refused or failed` `s 1137 keeping company records available for inspection` TRUE EQUALS JUST `s 1137 treated as having refused inspection`
#ASSERT `s 1137(2) the company is treated as having refused or failed` `s 1137 providing copies of company records` TRUE EQUALS JUST `s 1137 treated as having failed to provide a copy`
#ASSERT `s 1137(2) the company is treated as having refused or failed` `s 1137 keeping company records available for inspection` FALSE EQUALS NOTHING
#ASSERT `s 1137(2) the company is treated as having refused or failed` `s 1137 providing copies of company records` FALSE EQUALS NOTHING

-- ---- s 1137(5)
#ASSERT `s 1137(5)(a) the company is prevented from affording more extensive facilities than the regulations require` TRUE EQUALS JUST FALSE
#ASSERT `s 1137(5)(a) the company is prevented from affording more extensive facilities than the regulations require` FALSE EQUALS NOTHING
#ASSERT `s 1137(5)(b) the company is prevented from charging a lesser fee or none at all` TRUE TRUE EQUALS JUST FALSE -- (arguments: a fee may be charged; the fee charged is lesser or none)
#ASSERT `s 1137(5)(b) the company is prevented from charging a lesser fee or none at all` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1137(5)(b) the company is prevented from charging a lesser fee or none at all` FALSE TRUE EQUALS NOTHING -- no fee may be charged: "where a fee may be charged"
#ASSERT `s 1137(5)(b) the company is prevented from charging a lesser fee or none at all` FALSE FALSE EQUALS NOTHING

-- ---- s 1138(4)
#ASSERT `s 1138(4) this section applies to the company record` `s 1138 a copy of a director's service contract or a memorandum of its terms (s 228)` EQUALS JUST FALSE
#ASSERT `s 1138(4) this section applies to the company record` `s 1138 a qualifying indemnity provision (s 237)` EQUALS JUST FALSE
#ASSERT `s 1138(4) this section applies to the company record` `s 1138 another company record` EQUALS NOTHING

-- ---- s 1138(1)
#ASSERT `s 1138(1) the duty to take precautions applies to the records` TRUE EQUALS JUST TRUE
#ASSERT `s 1138(1) the duty to take precautions applies to the records` FALSE EQUALS JUST FALSE -- bound books: "Where company records are kept otherwise than in bound books"

-- ---- s 1138 as a whole (arguments: the kind of record; kept otherwise than in bound books; precautions against falsification; precautions to discover it)
#ASSERT `s 1138 the company has complied with this section` `s 1138 another company record` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1138 the company has complied with this section` `s 1138 another company record` TRUE TRUE FALSE EQUALS JUST FALSE -- (b) not met
#ASSERT `s 1138 the company has complied with this section` `s 1138 another company record` TRUE FALSE TRUE EQUALS JUST FALSE -- (a) not met
#ASSERT `s 1138 the company has complied with this section` `s 1138 another company record` FALSE FALSE FALSE EQUALS JUST TRUE -- bound books: the duty does not engage
#ASSERT `s 1138 the company has complied with this section` `s 1138 a copy of a director's service contract or a memorandum of its terms (s 228)` TRUE FALSE FALSE EQUALS JUST TRUE -- the section does not apply to an s 228 document
#ASSERT `s 1138 the company has complied with this section` `s 1138 a qualifying indemnity provision (s 237)` TRUE FALSE FALSE EQUALS JUST TRUE

-- ---- s 1138(2) and (3)
#ASSERT `s 1138(2) an officer of the company commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1138(2) an officer of the company commits an offence` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1138(2) an officer of the company commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1138(2) an officer of the company commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1138(2) an officer of the company commits an offence` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 1138(3) the penalty for an offence under s 1138` (JUST TRUE) EQUALS JUST `s 1135 test penalty level 3 with a tenth`
#ASSERT `s 1138(3) the penalty for an offence under s 1138` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1138(3) the penalty for an offence under s 1138` NOTHING EQUALS NOTHING

-- ---- The regulative rules, run with #TRACE. A DEONTIC value cannot be compared with EQUALS on the stable binary,
-- so the outcome of each trace is written beside it, decided from the text before the run.
-- s 1135(2): the company keeps the records so that they can be reproduced: expected FULFILLED.
#TRACE `s 1135(2) the company must keep electronic records capable of reproduction in hard copy form` AT 0 WITH
    PARTY Company DOES `s 1135 keep the electronic records capable of being reproduced in hard copy form` AT 1

-- s 1138(1): the company takes the precautions: expected FULFILLED.
#TRACE `s 1138(1) the company must take adequate precautions against falsification` AT 0 WITH
    PARTY Company DOES `s 1138 take adequate precautions against falsification of the records` AT 1
