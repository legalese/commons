IMPORT prelude
IMPORT daydate
IMPORT `coa16-part19-register`

-- coa16-tests-part19-register.l4: tests for coa16-part19-register.l4 (ss 743 to 748).
-- Every expected value is written from the text beside the assertion, never from the code's output.
-- #TRACE results are read by hand (an assertion cannot compare a DEONTIC); each trace carries its expected result.

-- ---- s 743(6): "include a duplicate" ---------------------------------------------------------------------
#ASSERT `s 743(6) the document is a register of debenture holders for this section` `s 743(6) a register of debenture holders` EQUALS JUST TRUE
#ASSERT `s 743(6) the document is a register of debenture holders for this section` `s 743(6) a duplicate of a register of debenture holders that is kept outside the United Kingdom` EQUALS JUST TRUE
#ASSERT `s 743(6) the document is a register of debenture holders for this section` `s 743(6) a duplicate of part of such a register` EQUALS JUST TRUE
#ASSERT `s 743(6) the document is a register of debenture holders for this section` `s 743(6) something else` EQUALS NOTHING

-- ---- s 743(1): "must be kept available for inspection (a) at the registered office, or (b) at a place specified" ---
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a register of debenture holders` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a register of debenture holders` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a register of debenture holders` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- not at the registered office and the s 1136 answer is not known: not covered
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a register of debenture holders` TRUE FALSE NOTHING EQUALS NOTHING
-- a register the company does not keep: "that is kept by the company" is a limit of the provision
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a register of debenture holders` FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- a duplicate of a register kept outside the United Kingdom counts as the register
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) a duplicate of a register of debenture holders that is kept outside the United Kingdom` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 743(1) the register is kept available for inspection as the subsection requires` `s 743(6) something else` TRUE TRUE (JUST TRUE) EQUALS NOTHING

-- ---- s 743(3): "No such notice is required if the register has, at all times ..., been kept ... at the registered office" ---
#ASSERT `s 743(3) the company is excused from giving the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 743(3) the company is excused from giving the notice` FALSE EQUALS JUST FALSE

-- ---- s 743(2): notice to the registrar -------------------------------------------------------------------------
-- the register has always been at the registered office: no notice is required, so nothing is left undone
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) a register of debenture holders` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- kept elsewhere, place notified, no change
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) a register of debenture holders` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- kept elsewhere, place notified, place changed and the change not notified
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) a register of debenture holders` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- kept elsewhere, place notified, place changed and the change notified
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) a register of debenture holders` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- kept elsewhere and never notified
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 743(2) the company has given the notice to the registrar as the subsection requires` `s 743(6) something else` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- s 743(2) as a regulative rule: excused: expected FULFILLED
#TRACE `s 743(2) the company must give notice to the registrar` TRUE AT 0 WITH
    (WAITUNTIL 40)
-- not excused and the notice given on day 5: expected FULFILLED
#TRACE `s 743(2) the company must give notice to the registrar` FALSE AT 0 WITH
    PARTY Company DOES `s 743 give the registrar notice of the place where the register is kept available for inspection` AT 5
-- not excused, nothing done: the text states no time, so the duty stands (expected: the standing obligation, no breach)
#TRACE `s 743(2) the company must give notice to the registrar` FALSE AT 0 WITH
    (WAITUNTIL 40)

-- ---- s 743(4): "makes default for 14 days" -----------------------------------------------------------------------
#ASSERT `s 743(4) the company has made default for 14 days` 13 EQUALS JUST FALSE
#ASSERT `s 743(4) the company has made default for 14 days` 14 EQUALS JUST TRUE
#ASSERT `s 743(4) the company has made default for 14 days` 15 EQUALS JUST TRUE
#ASSERT `s 743(4) the company has made default for 14 days` 0 EQUALS JUST FALSE
-- the offence: the company in default for 14 days
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 14 `s 743(4) the company` EQUALS JUST TRUE
-- one day short of 14
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 13 `s 743(4) the company` EQUALS JUST FALSE
-- the company gave the notice: no default
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE TRUE FALSE FALSE 40 `s 743(4) the company` EQUALS JUST FALSE
-- no notice required (always at the registered office)
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` TRUE FALSE FALSE FALSE 40 `s 743(4) the company` EQUALS JUST FALSE
-- officers
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 14 (`s 743(4) an officer of the company` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 14 (`s 743(4) an officer of the company` (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 14 (`s 743(4) an officer of the company` NOTHING) EQUALS NOTHING
#ASSERT `s 743(4) the person commits an offence` `s 743(6) a register of debenture holders` FALSE FALSE FALSE FALSE 14 `s 743(4) another person` EQUALS NOTHING
-- a document the subsection does not govern
#ASSERT `s 743(4) the person commits an offence` `s 743(6) something else` FALSE FALSE FALSE FALSE 14 `s 743(4) the company` EQUALS NOTHING
-- (5) the penalty: level 3, and one-tenth of level 3 a day
#ASSERT `s 743(5) the penalty for the offence` EQUALS Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE

-- ---- s 744(6) -------------------------------------------------------------------------------------------------
#ASSERT `s 744(6) the document is a register of debenture holders for this section` `s 744(6) a register of debenture holders` EQUALS JUST TRUE
#ASSERT `s 744(6) the document is a register of debenture holders for this section` `s 744(6) a duplicate of a register of debenture holders that is kept outside the United Kingdom` EQUALS JUST TRUE
#ASSERT `s 744(6) the document is a register of debenture holders for this section` `s 744(6) a duplicate of part of such a register` EQUALS JUST TRUE
#ASSERT `s 744(6) the document is a register of debenture holders for this section` `s 744(6) something else` EQUALS NOTHING

-- ---- s 744(5): "duly closed" -----------------------------------------------------------------------------------
-- closure record: closed, (a) articles or debentures, (b) stock certificates, (c) trust deed, total days closed in the year
-- (a), 30 days: the total "must not exceed 30 days", so 30 is within it
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF TRUE, TRUE, FALSE, FALSE, 30) EQUALS JUST TRUE
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF TRUE, TRUE, FALSE, FALSE, 31) EQUALS JUST FALSE
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF TRUE, FALSE, TRUE, FALSE, 10) EQUALS JUST TRUE
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF TRUE, FALSE, FALSE, TRUE, 10) EQUALS JUST TRUE
-- closed with no provision in (a), (b) or (c)
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF TRUE, FALSE, FALSE, FALSE, 5) EQUALS JUST FALSE
-- not closed at all
#ASSERT `s 744(5) the register is duly closed` (`s 744(5) closure of the register` OF FALSE, TRUE, TRUE, TRUE, 0) EQUALS JUST FALSE

-- ---- s 744(1): who may inspect, and on what terms ----------------------------------------------------------------
-- open register, a registered holder of the debentures: without charge
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF FALSE, FALSE, FALSE, FALSE, 0) TRUE FALSE EQUALS JUST `s 744(1) open to inspection without charge`
-- a holder of shares: without charge
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF FALSE, FALSE, FALSE, FALSE, 0) FALSE TRUE EQUALS JUST `s 744(1) open to inspection without charge`
-- any other person: on payment of the prescribed fee
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF FALSE, FALSE, FALSE, FALSE, 0) FALSE FALSE EQUALS JUST `s 744(1) open to inspection on payment of the prescribed fee`
-- duly closed (30 days under the articles): "except when duly closed"
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF TRUE, TRUE, FALSE, FALSE, 30) TRUE FALSE EQUALS JUST `s 744(1) not open to inspection because the register is duly closed`
-- closed for 31 days: not duly closed, so open
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF TRUE, TRUE, FALSE, FALSE, 31) TRUE FALSE EQUALS JUST `s 744(1) open to inspection without charge`
-- closed but not in accordance with any provision: not duly closed, so open
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a register of debenture holders` (`s 744(5) closure of the register` OF TRUE, FALSE, FALSE, FALSE, 5) FALSE FALSE EQUALS JUST `s 744(1) open to inspection on payment of the prescribed fee`
-- a duplicate counts as the register
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) a duplicate of part of such a register` (`s 744(5) closure of the register` OF FALSE, FALSE, FALSE, FALSE, 0) TRUE FALSE EQUALS JUST `s 744(1) open to inspection without charge`
#ASSERT `s 744(1) the terms on which the person may inspect the register` `s 744(6) something else` (`s 744(5) closure of the register` OF FALSE, FALSE, FALSE, FALSE, 0) TRUE FALSE EQUALS NOTHING

-- ---- s 744(2): a copy "on payment of such fee as may be prescribed" ----------------------------------------------
#ASSERT `s 744(2) the person may require a copy of the register or any part of it` `s 744(6) a register of debenture holders` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 744(2) the person may require a copy of the register or any part of it` `s 744(6) a register of debenture holders` FALSE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 744(2) the person may require a copy of the register or any part of it` `s 744(6) a register of debenture holders` FALSE EQUALS JUST FALSE
#ASSERT `s 744(2) the person may require a copy of the register or any part of it` `s 744(6) a duplicate of a register of debenture holders that is kept outside the United Kingdom` TRUE EQUALS JUST TRUE
#ASSERT `s 744(2) the person may require a copy of the register or any part of it` `s 744(6) something else` TRUE EQUALS NOTHING

-- ---- s 744(3): "must make a request to the company" ---------------------------------------------------------------
#ASSERT `s 744(3) the person has made the request the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 744(3) the person has made the request the subsection requires` FALSE EQUALS JUST FALSE

-- ---- s 744(4): what the request must contain ---------------------------------------------------------------------
-- fields in order: individual, (a) name and address, (b) responsible individual for an organisation, (c) purpose, (d) says whether
-- disclosed, (d) will be disclosed, (d)(i) other person is an individual, (d)(i) their name and address, (d)(ii) responsible
-- individual for that organisation, (d)(iii) purpose of that person
-- an individual who gives name and address, states a purpose and says the information will not be disclosed
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- an individual who gives no name and address
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- an organisation that names the responsible individual
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- an organisation that gives only the (a) information
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- no purpose stated
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- does not say whether the information will be disclosed
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- disclosed to another individual: name and address and purpose given
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST TRUE
-- disclosed to another individual: name and address missing
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE) EQUALS JUST FALSE
-- disclosed to another individual: that person's purpose missing
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- disclosed to an organisation: the responsible individual and the purpose given
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
-- disclosed to an organisation: the responsible individual missing
#ASSERT `s 744(4) the request contains the information the subsection requires` (`s 744(4) request for the register` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST FALSE

-- ---- s 745(1): the response within five working days -----------------------------------------------------------------
-- complied on working day 5: in time
#ASSERT `s 745(1) the company has responded to the request in time` TRUE TRUE FALSE 5 EQUALS JUST TRUE
#ASSERT `s 745(1) the company has responded to the request in time` TRUE TRUE FALSE 6 EQUALS JUST FALSE
#ASSERT `s 745(1) the company has responded to the request in time` TRUE FALSE TRUE 5 EQUALS JUST TRUE
#ASSERT `s 745(1) the company has responded to the request in time` TRUE FALSE TRUE 6 EQUALS JUST FALSE
-- neither yet: on working day 5 there is still no answer; on working day 6 the duty has not been met
#ASSERT `s 745(1) the company has responded to the request in time` TRUE FALSE FALSE 5 EQUALS NOTHING
#ASSERT `s 745(1) the company has responded to the request in time` TRUE FALSE FALSE 6 EQUALS JUST FALSE
#ASSERT `s 745(1) the company has responded to the request in time` FALSE FALSE FALSE 6 EQUALS NOTHING

-- s 745(1)-(2) as a regulative rule (day 0 = receipt; days are working days).
-- complied on day 3: expected FULFILLED
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    PARTY Company DOES `s 745 comply with the request` AT 3
-- applied on day 3 and notified on day 4: expected FULFILLED
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    PARTY Company DOES `s 745 apply to the court` AT 3
    PARTY Company DOES `s 745 notify the person who made the request` AT 4
-- neither by day 6: expected DEONTIC BREACHED (both limbs breached)
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    (WAITUNTIL 6)
-- applied on day 3 and not yet notified: expected the standing obligation to notify (no breach yet)
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    PARTY Company DOES `s 745 apply to the court` AT 3
-- complied on day 5, the last day: expected FULFILLED
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    PARTY Company DOES `s 745 comply with the request` AT 5
-- complied on day 6: expected DEONTIC BREACHED
#TRACE `s 745(1) the company must comply with the request or apply to the court` AT 0 WITH
    PARTY Company DOES `s 745 comply with the request` AT 6

-- ---- s 745(2) -------------------------------------------------------------------------------------------------------
#ASSERT `s 745(2) the company has notified the person making the request as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745(2) the company has notified the person making the request as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 745(2) the company has notified the person making the request as the subsection requires` FALSE FALSE EQUALS NOTHING
#ASSERT `s 745(2) the company has notified the person making the request as the subsection requires` FALSE TRUE EQUALS NOTHING

-- ---- s 745(3) -------------------------------------------------------------------------------------------------------
#ASSERT `s 745(3)(a) the court shall direct the company not to comply with the request` TRUE EQUALS JUST TRUE
#ASSERT `s 745(3)(a) the court shall direct the company not to comply with the request` FALSE EQUALS JUST FALSE
-- costs: "even if he is not a party to the application"
#ASSERT `s 745(3)(b) the court may order the person who made the request to pay the company's costs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745(3)(b) the court may order the person who made the request to pay the company's costs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 745(3)(b) the court may order the person who made the request to pay the company's costs` FALSE TRUE EQUALS NOTHING

-- ---- s 745(4) -------------------------------------------------------------------------------------------------------
#ASSERT `s 745(4) the court may direct that the company is not to comply with any such request` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745(4) the court may direct that the company is not to comply with any such request` TRUE FALSE EQUALS NOTHING
#ASSERT `s 745(4) the court may direct that the company is not to comply with any such request` FALSE TRUE EQUALS NOTHING
#ASSERT `s 745(4) the order identifies the requests to which it applies` TRUE EQUALS JUST TRUE
#ASSERT `s 745(4) the order identifies the requests to which it applies` FALSE EQUALS JUST FALSE

-- ---- s 745(5) -------------------------------------------------------------------------------------------------------
-- application made, no direction, decision given: the company must comply immediately
#ASSERT `s 745(5) the company must comply with the request immediately` TRUE FALSE TRUE EQUALS JUST TRUE
-- the court directed the company not to comply: the condition is not met
#ASSERT `s 745(5) the company must comply with the request immediately` TRUE TRUE TRUE EQUALS JUST FALSE
-- no decision yet and not discontinued
#ASSERT `s 745(5) the company must comply with the request immediately` TRUE FALSE FALSE EQUALS NOTHING
-- no application under section 745
#ASSERT `s 745(5) the company must comply with the request immediately` FALSE FALSE TRUE EQUALS NOTHING

-- ---- s 746 ----------------------------------------------------------------------------------------------------------
-- inspection refused, no court order: the company commits an offence
#ASSERT `s 746(1) the person commits an offence` TRUE FALSE FALSE `s 746(1) the company` EQUALS JUST TRUE
-- default in providing a copy: an officer in default
#ASSERT `s 746(1) the person commits an offence` FALSE TRUE FALSE (`s 746(1) an officer of the company` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 746(1) the person commits an offence` FALSE TRUE FALSE (`s 746(1) an officer of the company` (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 746(1) the person commits an offence` FALSE TRUE FALSE (`s 746(1) an officer of the company` NOTHING) EQUALS NOTHING
#ASSERT `s 746(1) the person commits an offence` FALSE TRUE FALSE `s 746(1) another person` EQUALS NOTHING
-- the refusal is in accordance with an order of the court
#ASSERT `s 746(1) the person commits an offence` TRUE FALSE TRUE `s 746(1) the company` EQUALS JUST FALSE
#ASSERT `s 746(1) the person commits an offence` FALSE TRUE TRUE `s 746(1) the company` EQUALS JUST FALSE
-- no refusal and no default
#ASSERT `s 746(1) the person commits an offence` FALSE FALSE FALSE `s 746(1) the company` EQUALS JUST FALSE
#ASSERT `s 746(2) the penalty for the offence` EQUALS Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE
#ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` FALSE TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` FALSE FALSE FALSE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` FALSE FALSE FALSE EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` TRUE FALSE TRUE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 746(3) the court may by order compel an immediate inspection or direct that the copy be sent` TRUE FALSE TRUE EQUALS JUST FALSE

-- ---- s 747 ----------------------------------------------------------------------------------------------------------
-- (1) statement made, misleading, knowingly / recklessly
#ASSERT `s 747(1) the person commits an offence by a statement in a request` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 747(1) the person commits an offence by a statement in a request` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- neither knowing nor reckless: outside the offence
#ASSERT `s 747(1) the person commits an offence by a statement in a request` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- not misleading, false or deceptive
#ASSERT `s 747(1) the person commits an offence by a statement in a request` TRUE FALSE TRUE FALSE EQUALS NOTHING
-- no statement in a request
#ASSERT `s 747(1) the person commits an offence by a statement in a request` FALSE TRUE TRUE FALSE EQUALS NOTHING
-- (2) in possession, did something / failed to do something, knowing or having reason to suspect
#ASSERT `s 747(2) the person commits an offence by disclosure of information` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 747(2) the person commits an offence by disclosure of information` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- no knowledge or reason to suspect
#ASSERT `s 747(2) the person commits an offence by disclosure of information` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- information not obtained by exercising the section 744 rights
#ASSERT `s 747(2) the person commits an offence by disclosure of information` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- no disclosure and no failure
#ASSERT `s 747(2) the person commits an offence by disclosure of information` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- (3) the penalties
#ASSERT `s 747(3) the penalty for the offence` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, (JUST (Period OF 2, Years)), (JUST `a fine without a stated limit`), NOTHING, TRUE)
#ASSERT `s 747(3) the penalty for the offence` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, (JUST (Period OF 12, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
#ASSERT `s 747(3) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
#ASSERT `s 747(3) the penalty for the offence` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
-- a summary conviction with no place named: the text distinguishes the places
#ASSERT `s 747(3) the penalty for the offence` `on summary conviction` EQUALS NOTHING
#ASSERT `s 747(3) the number of months in the period` (Period OF 2, Years) EQUALS JUST 24
#ASSERT `s 747(3) the number of months in the period` (Period OF 12, Months) EQUALS JUST 12
#ASSERT `s 747(3) the number of months in the period` (Period OF 6, Months) EQUALS JUST 6
#ASSERT `s 747(3) the number of months in the period` (Period OF 6, Days) EQUALS NOTHING

-- ---- s 748: the ten-year limit ------------------------------------------------------------------------------------------
-- entry made 1 June 2010: ten years later is 1 June 2020; "more than ten years after" starts on 2 June 2020
#ASSERT `s 748(1) the liability is barred by the ten-year limit` TRUE FALSE (Date 1 6 2010) (Date 31 5 2020) EQUALS NOTHING
#ASSERT `s 748(1) the liability is barred by the ten-year limit` TRUE FALSE (Date 1 6 2010) (Date 1 6 2020) EQUALS NOTHING
#ASSERT `s 748(1) the liability is barred by the ten-year limit` TRUE FALSE (Date 1 6 2010) (Date 2 6 2020) EQUALS JUST TRUE
-- a failure to make or delete an entry
#ASSERT `s 748(1) the liability is barred by the ten-year limit` FALSE TRUE (Date 1 6 2010) (Date 2 6 2020) EQUALS JUST TRUE
#ASSERT `s 748(1) the liability is barred by the ten-year limit` FALSE TRUE (Date 1 6 2010) (Date 1 6 2020) EQUALS NOTHING
-- a liability that does not arise from an entry or failure: not covered, however late
#ASSERT `s 748(1) the liability is barred by the ten-year limit` FALSE FALSE (Date 1 6 2010) (Date 2 6 2030) EQUALS NOTHING
-- an entry made on 29 February 2016: ten years on is 28 February 2026 (a day that exists), so 1 March 2026 is more than ten years after
#ASSERT `s 748(1) the liability is barred by the ten-year limit` TRUE FALSE (Date 29 2 2016) (Date 28 2 2026) EQUALS NOTHING
#ASSERT `s 748(1) the liability is barred by the ten-year limit` TRUE FALSE (Date 29 2 2016) (Date 1 3 2026) EQUALS JUST TRUE
-- (2) a lesser period of limitation is preserved
#ASSERT `s 748(2) the ten-year limit leaves a lesser period of limitation in place` TRUE EQUALS JUST TRUE
#ASSERT `s 748(2) the ten-year limit leaves a lesser period of limitation in place` FALSE EQUALS NOTHING
