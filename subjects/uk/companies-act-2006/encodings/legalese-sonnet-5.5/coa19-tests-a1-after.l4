#ASSERT `s 859L(4) the particulars set out in subsection (4) are delivered` TRUE TRUE (Date 5 4 2013) TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 859L(4) the particulars set out in subsection (4) are delivered` TRUE TRUE (Date 5 4 2013) TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 859L(4) the particulars set out in subsection (4) are delivered` TRUE TRUE (Date 5 4 2013) TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 859L(4) the particulars set out in subsection (4) are delivered` TRUE TRUE (Date 6 4 2013) TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 859L(4) the particulars set out in subsection (4) are delivered` TRUE TRUE (Date 6 4 2013) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
