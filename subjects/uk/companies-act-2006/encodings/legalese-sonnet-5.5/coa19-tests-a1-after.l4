#ASSERT `s 859O(2) the person may deliver to the registrar the certified copy and the statement of particulars` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(2) the person may deliver to the registrar the certified copy and the statement of particulars` NOTHING TRUE FALSE EQUALS NOTHING
-- (3) the statement: name and number, then (b) for a charge created before 6 April 2013 or (c) for one created on or after, with "(where allocated)" for the code
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 5 4 2013) TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 5 4 2013) FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 5 4 2013) TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 5 4 2013) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 5 4 2013) TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` FALSE (Date 5 4 2013) TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 6 4 2013) TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 6 4 2013) TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 6 4 2013) TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 859O(3) the statement contains the particulars the subsection lists` TRUE (Date 6 4 2013) TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- (4) subsections (1) to (3) do not affect s 466 of the Companies Act 1985; whether s 466 continues to apply is outside the sources
#ASSERT `s 859O(4) subsections (1) to (3) affect the continued application of section 466 of the Companies Act 1985` EQUALS JUST FALSE
#ASSERT `s 859O(4) section 466 of the Companies Act 1985 continues to apply` EQUALS NOTHING
-- (5) fixed security: the borrowed answer is an input
#ASSERT `s 859O(5) the arrangement is fixed security` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 859O(5) the arrangement is fixed security` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 859O(5) the arrangement is fixed security` NOTHING EQUALS NOTHING
