IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch10-part1`

-- coa30-tests-sch10-part1.l4: tests for coa30-sch10-part1.l4 (Schedule 10 Part 1, paragraphs 1 to 5).
-- Every expected value is decided from the text of the paragraph (the line range is in the module) before running.
-- Arguments are positional, in the order of the GIVEN lines of each function.

§ `Tests: Schedule 10 Part 1`

-- the helper: the first day after a period of N months beginning with a date (corresponding-date rule, the month-end fork in NOTES.md)
-- "the period of three months beginning with 1 January" is 1 January to 31 March, so the first day after is 1 April.
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 1 1 2026) 3 EQUALS Date 1 4 2026
-- beginning with 15 November, three months run to 14 February: the first day after is 15 February.
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 15 11 2025) 3 EQUALS Date 15 2 2026
-- beginning with 31 December, three months run to 30 March: the first day after is 31 March (month with 31 days).
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 31 12 2025) 3 EQUALS Date 31 3 2026
-- beginning with 30 November, three months would end in a February with no 30th: the period ends on 28 February, the first day after is 1 March (the month-end fork, assumed).
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 30 11 2025) 3 EQUALS Date 1 3 2026
-- beginning with 31 January, one month ends on the last day of February; first day after is 1 March.
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 31 1 2026) 1 EQUALS Date 1 3 2026
-- twelve months from 29 February 2024: the first day after is 1 March 2025.
#ASSERT `sch 10 para 3(2) the first day after a period of months beginning with a date` (Date 29 2 2024) 12 EQUALS Date 1 3 2025

-- ---- paragraph 1 ----
-- 1(1): "A supervisory body may apply": a supervisory body can; a body that is not one is not covered; unknown stays unknown.
#ASSERT `sch 10 para 1(1) the body may apply to the Secretary of State for a recognition order` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 10 para 1(1) the body may apply to the Secretary of State for a recognition order` (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 10 para 1(1) the body may apply to the Secretary of State for a recognition order` NOTHING EQUALS NOTHING
-- 1(2): both limbs "must": either missing is a no.
#ASSERT `sch 10 para 1(2) the application is made and accompanied as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(2) the application is made and accompanied as required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 1(2) the application is made and accompanied as required` TRUE FALSE EQUALS JUST FALSE
-- 1(3): after receiving and before determining.
#ASSERT `sch 10 para 1(3) the Secretary of State may require the applicant to furnish additional information` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(3) the Secretary of State may require the applicant to furnish additional information` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 1(3) the Secretary of State may require the applicant to furnish additional information` TRUE TRUE EQUALS JUST FALSE
-- 1(4): directions under (2) or (3) may differ between applications; otherwise the text is silent.
#ASSERT `sch 10 para 1(4) the directions and requirements may differ as between different applications` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(4) the directions and requirements may differ as between different applications` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(4) the directions and requirements may differ as between different applications` FALSE FALSE EQUALS NOTHING
-- 1(5)
#ASSERT `sch 10 para 1(5) the Secretary of State may specify the form or manner of verification` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(5) the Secretary of State may specify the form or manner of verification` FALSE EQUALS NOTHING
-- 1(6): rules always; guidance only if any was issued.
#ASSERT `sch 10 para 1(6) the application is accompanied as required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(6) the application is accompanied as required` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(6) the application is accompanied as required` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 1(6) the application is accompanied as required` FALSE FALSE FALSE EQUALS JUST FALSE
-- 1(7): all three of (a), (b), (c).
#ASSERT `sch 10 para 1(7) the guidance is guidance issued by the applicant` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 1(7) the guidance is guidance issued by the applicant` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 1(7) the guidance is guidance issued by the applicant` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 1(7) the guidance is guidance issued by the applicant` TRUE TRUE FALSE EQUALS JUST FALSE

-- ---- paragraph 2 ----
#ASSERT `sch 10 para 2(1) the Secretary of State may make or refuse to make a recognition order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 2(1) the Secretary of State may make or refuse to make a recognition order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 2(1) the Secretary of State may make or refuse to make a recognition order` FALSE TRUE EQUALS JUST FALSE
-- 2(2): "only if" all three.
#ASSERT `sch 10 para 2(2) the Secretary of State may make a recognition order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 2(2) the Secretary of State may make a recognition order` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 2(2) the Secretary of State may make a recognition order` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 2(2) the Secretary of State may make a recognition order` TRUE TRUE FALSE EQUALS JUST FALSE
-- 2(3)
#ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` TRUE TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` FALSE TRUE TRUE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` FALSE TRUE TRUE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` TRUE FALSE TRUE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` TRUE FALSE TRUE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` TRUE TRUE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 2(3) the Secretary of State may refuse to make a recognition order` TRUE TRUE FALSE EQUALS NOTHING
-- 2(4): notice, and either (a) or (b).
#ASSERT `sch 10 para 2(4) the notice of refusal is given as required` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 2(4) the notice of refusal is given as required` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 2(4) the notice of refusal is given as required` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 2(4) the notice of refusal is given as required` FALSE TRUE TRUE EQUALS JUST FALSE
-- 2(5)
#ASSERT `sch 10 para 2(5) the recognition order is made as required` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 2(5) the recognition order is made as required` FALSE EQUALS JUST FALSE

-- ---- paragraph 3 ----
-- 3(1): limb (a) counts only if the requirement is not about a delegated task; (b) likewise; (c) stands alone.
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1) the Secretary of State may revoke the recognition order` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- 3(1A)
#ASSERT `sch 10 para 3(1A) the Secretary of State may revoke the recognition order` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1A) the Secretary of State may revoke the recognition order` TRUE FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1A) the Secretary of State may revoke the recognition order` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(1A) the Secretary of State may revoke the recognition order` FALSE TRUE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(1A) the Secretary of State may revoke the recognition order` FALSE TRUE EQUALS NOTHING
-- 3(2): the order made on 10 January 2026: the period of three months beginning with that date is 10 January to 9 April; the date of effect must be after it.
#ASSERT `sch 10 para 3(2) the revocation order states a valid date of effect` TRUE (Date 10 1 2026) (Date 10 4 2026) EQUALS JUST TRUE
#ASSERT `sch 10 para 3(2) the revocation order states a valid date of effect` TRUE (Date 10 1 2026) (Date 9 4 2026) EQUALS JUST FALSE
#ASSERT `sch 10 para 3(2) the revocation order states a valid date of effect` TRUE (Date 10 1 2026) (Date 11 4 2026) EQUALS JUST TRUE
#ASSERT `sch 10 para 3(2) the revocation order states a valid date of effect` FALSE (Date 10 1 2026) (Date 10 6 2026) EQUALS JUST FALSE
-- 3(3)
#ASSERT `sch 10 para 3(3) the Secretary of State has done what he must do before revoking` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(3) the Secretary of State has done what he must do before revoking` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(3) the Secretary of State has done what he must do before revoking` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(3) the Secretary of State has done what he must do before revoking` TRUE TRUE FALSE EQUALS JUST FALSE
-- 3(4)
#ASSERT `sch 10 para 3(4) the notice has the contents required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(4) the notice has the contents required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(4) the notice has the contents required` FALSE TRUE EQUALS JUST FALSE
-- 3(5): the notice served/published on 1 January 2026: three months beginning with that date end on 31 March.
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST TRUE) (Date 1 1 2026) (Date 31 3 2026) NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST TRUE) (Date 1 1 2026) (Date 1 4 2026) NOTHING EQUALS JUST FALSE
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST TRUE) (Date 1 1 2026) (Date 1 1 2026) NOTHING EQUALS JUST TRUE
-- a longer period the Secretary of State allowed, to 30 April: 30 April is in, 1 May is out.
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST TRUE) (Date 1 1 2026) (Date 30 4 2026) (JUST (Date 30 4 2026)) EQUALS JUST TRUE
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST TRUE) (Date 1 1 2026) (Date 1 5 2026) (JUST (Date 30 4 2026)) EQUALS JUST FALSE
-- not within sub-paragraph (6): "A person within sub-paragraph (6) may" is limited by its own wording.
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` (JUST FALSE) (Date 1 1 2026) (Date 2 1 2026) NOTHING EQUALS NOTHING
#ASSERT `sch 10 para 3(5) the person may make written and oral representations` NOTHING (Date 1 1 2026) (Date 2 1 2026) NOTHING EQUALS NOTHING
-- 3(6): (a) the body, (b) a member, (c) any other person who appears to be affected.
#ASSERT `sch 10 para 3(6) the person is within this sub-paragraph` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(6) the person is within this sub-paragraph` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(6) the person is within this sub-paragraph` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(6) the person is within this sub-paragraph` FALSE FALSE FALSE EQUALS JUST FALSE
-- 3(7)
#ASSERT `sch 10 para 3(7) the Secretary of State has had regard to the representations` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(7) the Secretary of State has had regard to the representations` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(7) the Secretary of State has had regard to the representations` FALSE FALSE EQUALS NOTHING
-- 3(8)
#ASSERT `sch 10 para 3(8) the Secretary of State may revoke without regard to the restriction in sub-paragraph (2)` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `sch 10 para 3(8) the Secretary of State may revoke without regard to the restriction in sub-paragraph (2)` FALSE EQUALS JUST FALSE; name-test sweep: a power named for a grant whose "if" gate fails answers NOTHING, not JUST FALSE (a failed "if" is not the text's own no)
#ASSERT `sch 10 para 3(8) the Secretary of State may revoke without regard to the restriction in sub-paragraph (2)` FALSE EQUALS NOTHING
-- 3(9), 3(10)
#ASSERT `sch 10 para 3(9) the revocation order may contain the transitional provision` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(9) the revocation order may contain the transitional provision` FALSE EQUALS NOTHING
#ASSERT `sch 10 para 3(10) the revocation is not subject to the restrictions and requirements listed` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(10) the revocation is not subject to the restrictions and requirements listed` FALSE EQUALS NOTHING
-- 3(11)
#ASSERT `sch 10 para 3(11) the Secretary of State has done what he must do on making the revocation order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 3(11) the Secretary of State has done what he must do on making the revocation order` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(11) the Secretary of State has done what he must do on making the revocation order` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 3(11) the Secretary of State has done what he must do on making the revocation order` TRUE TRUE FALSE EQUALS JUST FALSE

-- ---- paragraphs 4 and 5 ----
#ASSERT `sch 10 para 4 the order has effect after commencement as an order made under paragraph 2(1) of this Schedule` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 4 the order has effect after commencement as an order made under paragraph 2(1) of this Schedule` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 10 para 4 the order has effect after commencement as an order made under paragraph 2(1) of this Schedule` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 10 para 5 the order is to be made by statutory instrument` TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 5 the order is to be made by statutory instrument` FALSE EQUALS NOTHING
