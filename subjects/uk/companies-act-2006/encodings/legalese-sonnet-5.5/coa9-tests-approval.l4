IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-approval`


-- Tests for coa9-approval.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5852-5894 of ukpga-2006-46.txt).

-- ---- s 439 ---------------------------------------------------------------------------------------------------
-- a quoted company that gave the notice
#ASSERT (`s 439(1) the quoted company has given notice of the resolution approving the directors' remuneration report` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- a quoted company that did not
#ASSERT (`s 439(1) the quoted company has given notice of the resolution approving the directors' remuneration report` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 439(1) the quoted company has given notice of the resolution approving the directors' remuneration report` (JUST FALSE) TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 439(1) the quoted company has given notice of the resolution approving the directors' remuneration report` NOTHING TRUE) EQUALS NOTHING
-- The accounts meeting is on 15 September 2028; "prior to" is read as strictly before that day (fork F28).
-- the day before the meeting
#ASSERT (`s 439(1) the last day on which the quoted company may give notice` (Date 15 9 2028)) EQUALS Date 14 9 2028
-- the day before the meeting
#ASSERT (`s 439(1) the quoted company gave notice prior to the accounts meeting` (Date 14 9 2028) (Date 15 9 2028)) EQUALS JUST TRUE
-- the day of the meeting is not "prior to" it
#ASSERT (`s 439(1) the quoted company gave notice prior to the accounts meeting` (Date 15 9 2028) (Date 15 9 2028)) EQUALS JUST FALSE
-- a fortnight before
#ASSERT (`s 439(1) the quoted company gave notice prior to the accounts meeting` (Date 1 9 2028) (Date 15 9 2028)) EQUALS JUST TRUE
-- a manner permitted for the service on the member of notice of the meeting
#ASSERT (`s 439(2) the notice may be given in the manner` TRUE) EQUALS JUST TRUE
-- other manners are not mentioned
#ASSERT (`s 439(2) the notice may be given in the manner` FALSE) EQUALS NOTHING
-- notwithstanding any default in complying with subsection (1) or (2)
#ASSERT (`s 439(3) the business that may be dealt with at the accounts meeting includes the resolution` TRUE) EQUALS JUST TRUE
-- no default
#ASSERT (`s 439(3) the business that may be dealt with at the accounts meeting includes the resolution` FALSE) EQUALS JUST TRUE
-- an existing director; the resolution was put to the vote
#ASSERT (`s 439(4) the existing director has ensured that the resolution is put to the vote of the meeting` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- an existing director; the resolution was not put to the vote
#ASSERT (`s 439(4) the existing director has ensured that the resolution is put to the vote of the meeting` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- not an existing director
#ASSERT (`s 439(4) the existing director has ensured that the resolution is put to the vote of the meeting` (JUST FALSE) FALSE) EQUALS NOTHING
-- the status was not answered
#ASSERT (`s 439(4) the existing director has ensured that the resolution is put to the vote of the meeting` NOTHING FALSE) EQUALS NOTHING
-- "No entitlement of a person to remuneration is made conditional ... by reason only of the provision made by this section"
#ASSERT (`s 439(5) the entitlement to remuneration is made conditional on the resolution being passed` TRUE) EQUALS JUST FALSE
-- an entitlement made conditional for another reason is not mentioned
#ASSERT (`s 439(5) the entitlement to remuneration is made conditional on the resolution being passed` FALSE) EQUALS NOTHING
-- the general meeting before which the annual accounts are to be laid
#ASSERT (`s 439(6) the meeting is the accounts meeting` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 439(6) the meeting is the accounts meeting` FALSE) EQUALS JUST FALSE
-- a director immediately before that meeting
#ASSERT (`s 439(6) the person is an existing director` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 439(6) the person is an existing director` FALSE) EQUALS JUST FALSE

-- ---- s 439(1) as a regulative rule ------------------------------------------------------------------------------
-- The obligation arises on 1 September 2028 and the last day for notice is 14 September 2028: 13 days. Expected by reading the section:
-- notice on day 13 is prior to the meeting; no notice by day 14 is a breach by the company.
#TRACE `s 439(1) the quoted company must give notice prior to the accounts meeting` (Date 1 9 2028) (Date 15 9 2028) AT 0 WITH
    PARTY Company DOES `s 439(1) give notice of the intention to move the resolution` AT 13
-- expected: FULFILLED

#TRACE `s 439(1) the quoted company must give notice prior to the accounts meeting` (Date 1 9 2028) (Date 15 9 2028) AT 0 WITH
    PARTY Company DOES `s 439(1) give notice of the intention to move the resolution` AT 14
-- expected: BREACH BY Company (notice on the day of the meeting)

#TRACE `s 439(1) the quoted company must give notice prior to the accounts meeting` (Date 1 9 2028) (Date 15 9 2028) AT 0 WITH
    (WAITUNTIL 14)
-- expected: BREACH BY Company (no notice by the day of the meeting)


-- ---- s 439A: financial years are numbered consecutively (fork F29) ----------------------------------------------
-- a quoted company; the accounts meeting in the first financial year that begins on or after the day it becomes quoted
#ASSERT (`s 439A(1)(a) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at the accounts meeting` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- a later accounts meeting: paragraph (a) names the first
#ASSERT (`s 439A(1)(a) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at the accounts meeting` (JUST TRUE) FALSE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`s 439A(1)(a) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at the accounts meeting` (JUST TRUE) FALSE) EQUALS NOTHING; a later accounts meeting: outside "the first financial year which begins on or after" the day, a period the text fixes in its own words (fork F35; the other reading is NOTHING)
-- not a quoted company
#ASSERT (`s 439A(1)(a) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at the accounts meeting` (JUST FALSE) TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 439A(1)(a) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at the accounts meeting` NOTHING TRUE) EQUALS NOTHING
-- The last meeting at which notice was given was in financial year 5; the three-year period begins with year 6, so it ends with year 8.
-- the third financial year after the year of the last meeting
#ASSERT (`s 439A(1)(b) the last financial year in which the next meeting at which notice is given may be held` 5) EQUALS 8
-- held in the last financial year of the period
#ASSERT (`s 439A(1)(b) the meeting is held no later than the end of the period of three financial years` 5 8) EQUALS JUST TRUE
-- held in the first financial year of the period
#ASSERT (`s 439A(1)(b) the meeting is held no later than the end of the period of three financial years` 5 6) EQUALS JUST TRUE
-- held in the year after the period ends
#ASSERT (`s 439A(1)(b) the meeting is held no later than the end of the period of three financial years` 5 9) EQUALS JUST FALSE
-- held in the same financial year as the last notice: not later than the end of the period
#ASSERT (`s 439A(1)(b) the meeting is held no later than the end of the period of three financial years` 5 5) EQUALS JUST TRUE
-- a quoted company; the section 439 resolution was not passed; no notice was given
#ASSERT (`s 439A(2) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts meeting` (JUST TRUE) TRUE TRUE) EQUALS JUST TRUE
-- the resolution was passed: (a) fails
#ASSERT (`s 439A(2) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts meeting` (JUST TRUE) FALSE TRUE) EQUALS JUST FALSE
-- notice was given: (b) fails
#ASSERT (`s 439A(2) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts meeting` (JUST TRUE) TRUE FALSE) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 439A(2) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts meeting` (JUST FALSE) TRUE TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 439A(2) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts meeting` NOTHING TRUE TRUE) EQUALS NOTHING
-- a quoted company; a resolution was not passed; no notice was given
#ASSERT (`s 439A(2A) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts or other general meeting` (JUST TRUE) TRUE TRUE) EQUALS JUST TRUE
-- the resolution was passed: (a) fails
#ASSERT (`s 439A(2A) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts or other general meeting` (JUST TRUE) FALSE TRUE) EQUALS JUST FALSE
-- notice was given: (b) fails
#ASSERT (`s 439A(2A) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts or other general meeting` (JUST TRUE) TRUE FALSE) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 439A(2A) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts or other general meeting` (JUST FALSE) TRUE TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 439A(2A) the quoted company must give notice of the intention to move the resolution approving the relevant directors' remuneration policy at an accounts or other general meeting` NOTHING TRUE TRUE) EQUALS NOTHING
-- before the first meeting for which it gives notice under subsection (1)
#ASSERT (`s 439A(3) subsection (2) does not apply in relation to the quoted company` TRUE) EQUALS JUST TRUE
-- the subsection says nothing of a later time
#ASSERT (`s 439A(3) subsection (2) does not apply in relation to the quoted company` FALSE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`s 439A(3) subsection (2) does not apply in relation to the quoted company` FALSE) EQUALS NOTHING; the meeting is not before the first meeting for which notice is given: outside "before the first meeting in relation to which it gives notice", a period the text fixes in its own words (fork F35; the other reading is NOTHING)
-- no notice under (2) or (2A): the notice under (1) counts
#ASSERT (`s 439A(4) the financial year number treated as that of the last notice under subsection (1)` 5 NOTHING) EQUALS 5
-- a later notice under (2) or (2A) is treated as given under (1)
#ASSERT (`s 439A(4) the financial year number treated as that of the last notice under subsection (1)` 5 (JUST 7)) EQUALS 7
-- an earlier notice does not move the period back
#ASSERT (`s 439A(4) the financial year number treated as that of the last notice under subsection (1)` 5 (JUST 3)) EQUALS 5
-- a resolution to which the section applies; notice given prior to the meeting to the entitled members
#ASSERT (`s 439A(5) notice of the intention to move the resolution was given as the subsection requires` TRUE TRUE) EQUALS JUST TRUE
-- notice not given
#ASSERT (`s 439A(5) notice of the intention to move the resolution was given as the subsection requires` TRUE FALSE) EQUALS JUST FALSE
-- not a resolution to which the section applies
#ASSERT (`s 439A(5) notice of the intention to move the resolution was given as the subsection requires` FALSE TRUE) EQUALS NOTHING
-- subsection (2) applies
#ASSERT (`s 439A(6) the subsection of section 439 applies for the purposes of the resolution` TRUE `s 439A(6) section 439(2) (manner of giving notice)`) EQUALS JUST TRUE
-- subsection (3) applies
#ASSERT (`s 439A(6) the subsection of section 439 applies for the purposes of the resolution` TRUE `s 439A(6) section 439(3) (business that may be dealt with)`) EQUALS JUST TRUE
-- subsection (4) applies
#ASSERT (`s 439A(6) the subsection of section 439 applies for the purposes of the resolution` TRUE `s 439A(6) section 439(4) (existing directors to ensure a vote)`) EQUALS JUST TRUE
-- not within "Subsections (2) to (4)"
#ASSERT (`s 439A(6) the subsection of section 439 applies for the purposes of the resolution` TRUE `s 439A(6) another subsection of section 439`) EQUALS NOTHING
-- not a resolution to which the section applies
#ASSERT (`s 439A(6) the subsection of section 439 applies for the purposes of the resolution` FALSE `s 439A(6) section 439(2) (manner of giving notice)`) EQUALS NOTHING
-- a resolution relating to a general meeting other than an accounts meeting
#ASSERT (`s 439A(6) in section 439(3) "general meeting" is read for "accounts meeting"` TRUE) EQUALS JUST TRUE
-- an accounts meeting: no substitution is stated
#ASSERT (`s 439A(6) in section 439(3) "general meeting" is read for "accounts meeting"` FALSE) EQUALS NOTHING
-- (a) notice in relation to an accounts meeting
#ASSERT (`s 439A(7) the relevant directors' remuneration policy` TRUE FALSE) EQUALS `s 439A(7)(a) the remuneration policy contained in the directors' remuneration report to be voted on at that accounts meeting`
-- (b)(i) another general meeting, policy not revised
#ASSERT (`s 439A(7) the relevant directors' remuneration policy` FALSE FALSE) EQUALS `s 439A(7)(b)(i) the remuneration policy contained in the directors' remuneration report voted on at the last accounts meeting before that other general meeting`
-- (b)(ii) another general meeting, policy revised
#ASSERT (`s 439A(7) the relevant directors' remuneration policy` FALSE TRUE) EQUALS `s 439A(7)(b)(ii) that policy as revised in accordance with section 422A`
-- a general meeting before which the annual accounts are to be laid
#ASSERT (`s 439A(8)(a) the meeting is an accounts meeting` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 439A(8)(a) the meeting is an accounts meeting` FALSE) EQUALS JUST FALSE
-- the policy with respect to the matters in section 421(2A)
#ASSERT (`s 439A(8)(b) the policy is a directors' remuneration policy` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 439A(8)(b) the policy is a directors' remuneration policy` FALSE) EQUALS JUST FALSE

-- ---- s 440 ---------------------------------------------------------------------------------------------------
-- default; the officer is in default
#ASSERT (`s 440(1) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- default; the officer is not in default
#ASSERT (`s 440(1) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 440(1) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no default
#ASSERT (`s 440(1) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- the resolution was not put to the vote; an existing director
#ASSERT (`s 440(2) the existing director commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- not an existing director: outside "each existing director"
#ASSERT (`s 440(2) the existing director commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- the status was not answered
#ASSERT (`s 440(2) the existing director commits an offence` TRUE NOTHING) EQUALS NOTHING
-- the resolution was put to the vote: the "If" fails
#ASSERT (`s 440(2) the existing director commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- charged, and proves all reasonable steps were taken
#ASSERT (`s 440(3) this section gives the person a defence on these facts` TRUE TRUE) EQUALS JUST TRUE
-- charged, but proves no such steps: this section gives no defence on these facts
#ASSERT (`s 440(3) this section gives the person a defence on these facts` TRUE FALSE) EQUALS JUST FALSE
-- not charged under subsection (2)
#ASSERT (`s 440(3) this section gives the person a defence on these facts` FALSE TRUE) EQUALS NOTHING
-- level 3
#ASSERT (`s 440(4) the penalty for an offence under section 440` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for
#ASSERT (`s 440(4) the penalty for an offence under section 440` `on conviction on indictment`) EQUALS NOTHING
-- a director immediately before that meeting
#ASSERT (`s 440(5) the person is an existing director` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 440(5) the person is an existing director` FALSE) EQUALS JUST FALSE

