-- ---- s 790LQ -----------------------------------------------------------------------------------------------------
-- (2)(a) the relevant period begins with the event that applies
#ASSERT `s 790LQ(2)(a) the day on which the relevant period begins` `s 790LQ(2)(a)(i) the incorporation of the company, where the person became a registrable person on its incorporation and the application included a statement under section 12B(2) in respect of the person` (Date 1 3 2027) EQUALS Date 1 3 2027
#ASSERT `s 790LQ(2)(a) the day on which the relevant period begins` `s 790LQ(2)(a)(ii) the delivery to the registrar of a statement in respect of the person under section 790LB(1), where the person became a registrable person after the incorporation of the company` (Date 2 3 2027) EQUALS Date 2 3 2027
#ASSERT `s 790LQ(2)(a) the day on which the relevant period begins` `s 790LQ(2)(a)(iii) the expiry of the period for complying with the direction under section 790LM, where a direction is given to the person` (Date 3 3 2027) EQUALS Date 3 3 2027
#ASSERT `s 790LQ(2)(a) the day on which the relevant period begins` `s 790LQ(2)(a)(iv) the expiry of the period for complying with section 790LN, where that section applies to the person` (Date 4 3 2027) EQUALS Date 4 3 2027
-- (2)(b) ending on the giving of a notice under section 790LF
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) (JUST (Date 1 9 2027)) (Date 1 3 2027) FALSE EQUALS JUST TRUE
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) (JUST (Date 1 9 2027)) (Date 1 9 2027) FALSE EQUALS JUST TRUE
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) (JUST (Date 1 9 2027)) (Date 2 9 2027) FALSE EQUALS JUST FALSE
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) (JUST (Date 1 9 2027)) (Date 28 2 2027) FALSE EQUALS JUST FALSE
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) NOTHING (Date 1 1 2030) FALSE EQUALS JUST TRUE
#ASSERT `s 790LQ(1) the day falls in the relevant period` (Date 1 3 2027) NOTHING (Date 1 3 2027) TRUE EQUALS JUST FALSE
-- (1) in breach where the day is in the relevant period and the identity is not verified (section 1110A: a seam)
#ASSERT `s 790LQ(1) the registrable person is in breach on the day` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 790LQ(1) the registrable person is in breach on the day` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 790LQ(1) the registrable person is in breach on the day` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 790LQ(1) the registrable person is in breach on the day` (JUST TRUE) NOTHING EQUALS NOTHING

-- ---- s 790LR -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LR(2) the registered officer is the person` FALSE EQUALS `s 790LR(2)(a) the person whose name is specified in a statement delivered under section 12B(3), 790LB(2), 790LO(2) or 790LP(2)`
#ASSERT `s 790LR(2) the registered officer is the person` TRUE EQUALS `s 790LR(2)(b) the person specified in the latest notice under section 790LS, the entity having changed its registered officer`
-- (3)(a) the relevant period begins with the event that applies (the text says "the direction 790LO" in (iii))
#ASSERT `s 790LR(3)(a) the day on which the relevant period begins` `s 790LR(3)(a)(i) the incorporation of the company, where the entity became a registrable relevant legal entity on the incorporation of the company and the application included a statement under section 12B(3) in respect of the entity` (Date 1 3 2027) EQUALS Date 1 3 2027
#ASSERT `s 790LR(3)(a) the day on which the relevant period begins` `s 790LR(3)(a)(ii) the delivery to the registrar of a statement in respect of the registrable relevant legal entity under section 790LB(2), where the entity became a registrable relevant legal entity after the incorporation of the company` (Date 2 3 2027) EQUALS Date 2 3 2027
#ASSERT `s 790LR(3)(a) the day on which the relevant period begins` `s 790LR(3)(a)(iii) the expiry of the period for complying with the direction 790LO, where the entity is given a direction under that section` (Date 3 3 2027) EQUALS Date 3 3 2027
#ASSERT `s 790LR(3)(a) the day on which the relevant period begins` `s 790LR(3)(a)(iv) the expiry of the period for complying with section 790LP, where that section applies to the entity` (Date 4 3 2027) EQUALS Date 4 3 2027
#ASSERT `s 790LR(3)(b) the day is after the notice that the entity has ceased` (JUST (Date 1 9 2027)) (Date 2 9 2027) EQUALS TRUE
#ASSERT `s 790LR(3)(b) the day is after the notice that the entity has ceased` (JUST (Date 1 9 2027)) (Date 1 9 2027) EQUALS FALSE
#ASSERT `s 790LR(3)(b) the day is after the notice that the entity has ceased` NOTHING (Date 1 9 2027) EQUALS FALSE
-- (3) the relevant period; (4) it does not include the 28 days beginning with the day the registered officer ceases to be a relevant officer (10 May gives 10 May to 6 June)
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING NOTHING (Date 15 4 2027) EQUALS JUST TRUE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING NOTHING (Date 28 2 2027) EQUALS JUST FALSE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) (JUST (Date 1 9 2027)) NOTHING (Date 2 9 2027) EQUALS JUST FALSE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING (JUST (Date 10 5 2027)) (Date 9 5 2027) EQUALS JUST TRUE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING (JUST (Date 10 5 2027)) (Date 10 5 2027) EQUALS JUST FALSE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING (JUST (Date 10 5 2027)) (Date 6 6 2027) EQUALS JUST FALSE
#ASSERT `s 790LR(3) the day falls in the relevant period` (Date 1 3 2027) NOTHING (JUST (Date 10 5 2027)) (Date 7 6 2027) EQUALS JUST TRUE
-- (1) in breach where the registered officer is not a relevant officer, or is not an individual whose identity is verified
#ASSERT `s 790LR(1) the registrable relevant legal entity is in breach on the day` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 790LR(1) the registrable relevant legal entity is in breach on the day` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 790LR(1) the registrable relevant legal entity is in breach on the day` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 790LR(1) the registrable relevant legal entity is in breach on the day` (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 790LR(1) the registrable relevant legal entity is in breach on the day` (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 790LR(5) the individual is a relevant officer` `s 790LO(6)(c) any other legal entity` FALSE FALSE TRUE EQUALS JUST TRUE

-- ---- s 790LS -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LS(1) the entity may change its registered officer for the purposes of section 790LR by giving notice to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 790LS(1) the entity may change its registered officer for the purposes of section 790LR by giving notice to the registrar` FALSE EQUALS NOTHING
#ASSERT `s 790LS(2) the notice contains what subsections (2) and (3) require` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LS(2) the notice contains what subsections (2) and (3) require` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LS(2) the notice contains what subsections (2) and (3) require` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LS(4) the individual is a relevant officer` `s 790LO(6)(a) a company` TRUE FALSE FALSE EQUALS JUST TRUE

-- ---- s 790LT -----------------------------------------------------------------------------------------------------
#ASSERT `s 790LT(1) the person commits an offence` `s 790LT(1)(a) section 790LN` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LT(1) the person commits an offence` `s 790LT(1)(a) section 790LP` TRUE FALSE EQUALS JUST TRUE
