IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa17-helpers`
IMPORT `coa17-part21a-ch2a-id`

-- coa17-tests-part21a-ch2a-id.l4: tests for ss 790LM-790LT (coa17-part21a-ch2a-id.l4). Expected values are written by hand
-- from the text of the section named beside each group.

§ `Tests: Part 21A Chapter 2A, identity verification`

-- ---- s 790LM -----------------------------------------------------------------------------------------------------
-- Case 1: (a) incorporated on an application with a 12A(1)(a) statement naming the person, (b) no 12B(2) statement or it appears false, (c) no 790LG notice
#ASSERT `s 790LM(1) Case 1 applies` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790LM(1) Case 1 applies` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 790LM(1) Case 1 applies` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 790LM(1) Case 1 applies` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LM(1) Case 1 applies` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- Case 2: (a) the registrar is notified (the text says under section 790LF), (b) no 790LB(1) statement or it appears false
#ASSERT `s 790LM(1) Case 2 applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LM(1) Case 2 applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790LM(1) Case 2 applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LM(1) Case 2 applies` FALSE TRUE TRUE EQUALS JUST FALSE
-- (2) the registrar must direct the registrable person; (6) not a person mentioned in section 790C(12)(a) to (d)
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` (JUST FALSE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 790LM(2) the registrar must direct the registrable person to deliver a statement confirming that the person's identity is verified` NOTHING (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
-- within 14 days beginning with the date of the direction: 5 January gives 18 January
#ASSERT `s 790LM(2) the last day for the registrable person to deliver the statement` (Date 5 1 2026) EQUALS Date 18 1 2026
#ASSERT `s 790LM(2) the registrable person delivered the statement in time` (Date 5 1 2026) (JUST (Date 18 1 2026)) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 790LM(2) the registrable person delivered the statement in time` (Date 5 1 2026) (JUST (Date 19 1 2026)) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 790LM(2) the registrable person delivered the statement in time` (Date 5 1 2026) NOTHING (Date 18 1 2026) EQUALS NOTHING
-- (3) extend by up to 14 days at a time
#ASSERT `s 790LM(3) the last day of the period as extended by the further direction` (Date 18 1 2026) 14 EQUALS JUST (Date 1 2 2026)
#ASSERT `s 790LM(3) the last day of the period as extended by the further direction` (Date 18 1 2026) 7 EQUALS JUST (Date 25 1 2026)
#ASSERT `s 790LM(3) the last day of the period as extended by the further direction` (Date 18 1 2026) 15 EQUALS NOTHING
#ASSERT `s 790LM(3) the last day of the period as extended by the further direction` (Date 18 1 2026) 0 EQUALS NOTHING
-- (4) in writing; (5) lapses if notice is later given under section 790LG(1)
#ASSERT `s 790LM(4) the direction meets the requirement as to form` TRUE EQUALS JUST TRUE
#ASSERT `s 790LM(4) the direction meets the requirement as to form` FALSE EQUALS JUST FALSE
#ASSERT `s 790LM(5) the direction lapses` TRUE EQUALS JUST TRUE
#ASSERT `s 790LM(5) the direction lapses` FALSE EQUALS JUST FALSE

-- ---- s 790LN -----------------------------------------------------------------------------------------------------
