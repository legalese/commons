#ASSERT `s 790LN(1) the person must deliver to the registrar the statement required by this section` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 790LN(1) the person must deliver to the registrar the statement required by this section` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LN(1) the person must deliver to the registrar the statement required by this section` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 790LN(1) the person must deliver to the registrar the statement required by this section` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 790LN(1) the person must deliver to the registrar the statement required by this section` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 790LN(2) the statement is the statement required by this section` TRUE EQUALS JUST TRUE
#ASSERT `s 790LN(2) the statement is the statement required by this section` FALSE EQUALS JUST FALSE
