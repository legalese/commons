#ASSERT `s 790LO(1) Case 1 applies` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790LO(1) Case 1 applies` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 790LO(1) Case 1 applies` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
