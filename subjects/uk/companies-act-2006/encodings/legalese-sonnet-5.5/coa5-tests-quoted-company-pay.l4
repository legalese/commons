#ASSERT `s 226F(2) the approval obtained for Chapter 4 is treated as satisfying section 226B(1)(b) or 226C(1)(b)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226F(2) the approval obtained for Chapter 4 is treated as satisfying section 226B(1)(b) or 226C(1)(b)` TRUE TRUE FALSE EQUALS NOTHING
