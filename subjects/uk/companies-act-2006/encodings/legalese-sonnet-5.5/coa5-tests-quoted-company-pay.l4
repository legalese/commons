IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-quoted-company-pay`

-- coa5-tests-quoted-company-pay.l4: tests for ss 226A to 226F (coa5-quoted-company-pay.l4). Expected values read from the text, not from the code.

§ `Tests: s 226A`

-- the two definitions that carry another provision's answer unchanged
#ASSERT `s 226A(1) the company is a quoted company in this Chapter` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 226A(1) the company is a quoted company in this Chapter` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 226A(1) the company is a quoted company in this Chapter` NOTHING EQUALS NOTHING
#ASSERT `s 226A(1) the payment is a payment for loss of office in this Chapter` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 226A(1) the payment is a payment for loss of office in this Chapter` NOTHING EQUALS NOTHING

-- s 226A(1) "remuneration payment": consideration for holding office as director; or other office or employment held while a director; other than a payment for loss of office
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(a) holding, agreeing to hold or having held office as director of a company` TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(b)(i) holding, agreeing to hold or having held any other office or employment in connection with the management of the affairs of the company` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(b)(i) holding, agreeing to hold or having held any other office or employment in connection with the management of the affairs of the company` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(b)(ii) holding, agreeing to hold or having held any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(b)(ii) holding, agreeing to hold or having held any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(a) holding, agreeing to hold or having held office as director of a company` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(a) holding, agreeing to hold or having held office as director of a company` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1) something else` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 226A(1) the payment is a remuneration payment` `s 226A(1)(a) holding, agreeing to hold or having held office as director of a company` FALSE FALSE (JUST FALSE) EQUALS JUST FALSE

-- s 226A(1) "directors' remuneration policy": the policy of a quoted company on remuneration payments and payments for loss of office
#ASSERT `s 226A(1) the policy is a directors' remuneration policy` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 226A(1) the policy is a directors' remuneration policy` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 226A(1) the policy is a directors' remuneration policy` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 226A(1) the policy is a directors' remuneration policy` NOTHING TRUE EQUALS NOTHING

-- s 226A(4) "relevant transfer"
#ASSERT `s 226A(4) the transfer is a relevant transfer` `s 226A(4)(a) a transfer of the whole or any part of the undertaking or property of the company or a subsidiary of the company` EQUALS JUST TRUE
#ASSERT `s 226A(4) the transfer is a relevant transfer` `s 226A(4)(b) a transfer of shares in the company, or in a subsidiary of the company, resulting from a takeover bid` EQUALS JUST TRUE
#ASSERT `s 226A(4) the transfer is a relevant transfer` `s 226A(4) some other transfer` EQUALS JUST FALSE

-- s 226A(2): subsection (3) applies where, in connection with a relevant transfer, a director of a quoted company is to cease to hold office or another office
#ASSERT `s 226A(2) subsection (3) applies` (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 226A(2) subsection (3) applies` (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 226A(2) subsection (3) applies` (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 226A(2) subsection (3) applies` (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226A(2) subsection (3) applies` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226A(2) subsection (3) applies` NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 226A(2) subsection (3) applies` (JUST TRUE) NOTHING TRUE TRUE EQUALS NOTHING

-- s 226A(3): (a) the excess of the price over what other holders could have obtained; (b) the money value of valuable consideration from a person other than the company
#ASSERT `s 226A(3)(a) the excess taken to have been a payment for loss of office for section 226C` (JUST TRUE) 150_000 100_000 EQUALS JUST 50_000
#ASSERT `s 226A(3)(a) the excess taken to have been a payment for loss of office for section 226C` (JUST TRUE) 100_000 100_000 EQUALS JUST 0
#ASSERT `s 226A(3)(a) the excess taken to have been a payment for loss of office for section 226C` (JUST FALSE) 150_000 100_000 EQUALS NOTHING
#ASSERT `s 226A(3)(a) the excess taken to have been a payment for loss of office for section 226C` NOTHING 150_000 100_000 EQUALS NOTHING
#ASSERT `s 226A(3)(b) the money value taken to have been a payment for loss of office for section 226C` (JUST TRUE) TRUE 7_000 EQUALS JUST 7_000
#ASSERT `s 226A(3)(b) the money value taken to have been a payment for loss of office for section 226C` (JUST TRUE) FALSE 7_000 EQUALS NOTHING
#ASSERT `s 226A(3)(b) the money value taken to have been a payment for loss of office for section 226C` (JUST FALSE) TRUE 7_000 EQUALS NOTHING

-- s 226A(5) to (10)
#ASSERT `s 226A(5) the reference is read in accordance with section 226A` TRUE EQUALS JUST TRUE
#ASSERT `s 226A(5) the reference is read in accordance with section 226A` FALSE EQUALS NOTHING
#ASSERT `s 226A(6) the payment is treated as a payment by the company` TRUE EQUALS JUST TRUE
#ASSERT `s 226A(6) the payment is treated as a payment by the company` FALSE EQUALS NOTHING
#ASSERT `s 226A(7) the payment is treated as a payment to B who is, has been or is to be a director` `s 226A(7)(a) a person connected with B` EQUALS JUST TRUE
#ASSERT `s 226A(7) the payment is treated as a payment to B who is, has been or is to be a director` `s 226A(7)(b) a person at the direction of, or for the benefit of, B or a person connected with B` EQUALS JUST TRUE
#ASSERT `s 226A(7) the payment is treated as a payment to B who is, has been or is to be a director` `s 226A(7) B himself` EQUALS NOTHING
#ASSERT `s 226A(7) the payment is treated as a payment to B who is, has been or is to be a director` `s 226A(7) someone else` EQUALS NOTHING
#ASSERT `s 226A(8) section 252 applies to determine whether a person is connected with the person` TRUE EQUALS JUST TRUE
#ASSERT `s 226A(8) section 252 applies to determine whether a person is connected with the person` FALSE EQUALS NOTHING
#ASSERT `s 226A(9) the reference includes the shadow director` `s 226A(9) a reference to a director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 226A(9) the reference includes the shadow director` `s 226A(9) a reference to a director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 226A(9) the reference includes the shadow director` `s 226A(9) a reference to a director` NOTHING EQUALS NOTHING
#ASSERT `s 226A(9) the reference includes the shadow director` `s 226A(9) a reference to loss of office as a director` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 226A(9) the reference includes the shadow director` `s 226A(9) a reference to loss of office as a director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 226A(10) the reference to a director includes the person` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 226A(10) the reference to a director includes the person` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 226A(10) the reference to a director includes the person` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 226A(10) the reference to a director includes the person` FALSE TRUE FALSE EQUALS NOTHING

§ `Tests: ss 226B and 226C`

-- s 226B(2), s 226C(2): the approved policy is the most recent policy approved by the members in general meeting
#ASSERT `s 226B(2) the policy is the approved directors' remuneration policy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226B(2) the policy is the approved directors' remuneration policy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 226B(2) the policy is the approved directors' remuneration policy` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 226C(2) the policy is the approved directors' remuneration policy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226C(2) the policy is the approved directors' remuneration policy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 226C(2) the policy is the approved directors' remuneration policy` FALSE FALSE EQUALS JUST FALSE

-- s 226B(1): a quoted company may not make a remuneration payment unless consistent with the approved policy or approved by resolution
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 226B(1) the quoted company may not make the remuneration payment` NOTHING TRUE FALSE FALSE EQUALS NOTHING

-- s 226C(1): no payment for loss of office may be made to a director of a quoted company unless consistent with the approved policy or approved by resolution
#ASSERT `s 226C(1) no person may make the payment for loss of office` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 226C(1) no person may make the payment for loss of office` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 226C(1) no person may make the payment for loss of office` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 226C(1) no person may make the payment for loss of office` (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 226C(1) no person may make the payment for loss of office` (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 226C(1) no person may make the payment for loss of office` NOTHING TRUE FALSE FALSE EQUALS NOTHING

-- the duty (traces read, not asserted)
-- TRACE EXPECT: BREACHED
#TRACE `s 226B(1) and s 226C(1) the duty not to make the payment` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 226B make the remuneration payment or payment for loss of office` AT 2

-- TRACE EXPECT: STANDING
#TRACE `s 226B(1) and s 226C(1) the duty not to make the payment` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 9)

-- TRACE EXPECT: FULFILLED
#TRACE `s 226B(1) and s 226C(1) the duty not to make the payment` (JUST FALSE) AT 0 WITH
    PARTY Company DOES `s 226B make the remuneration payment or payment for loss of office` AT 2

§ `Tests: s 226D`

-- s 226D(1): memorandum made available at the registered office for not less than 15 days ending with the meeting date, and at the meeting
#ASSERT `s 226D(1) the resolution approving the payment must not be passed` TRUE TRUE (Date 6 3 2025) (Date 20 3 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 226D(1) the resolution approving the payment must not be passed` TRUE TRUE (Date 7 3 2025) (Date 20 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 226D(1) the resolution approving the payment must not be passed` TRUE TRUE (Date 6 3 2025) (Date 20 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `s 226D(1) the resolution approving the payment must not be passed` TRUE FALSE (Date 1 1 2025) (Date 20 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 226D(1) the resolution approving the payment must not be passed` FALSE TRUE (Date 6 3 2025) (Date 20 3 2025) TRUE EQUALS NOTHING
#ASSERT `s 226D(2) the memorandum meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 226D(2) the memorandum meets the requirement` FALSE EQUALS JUST FALSE

-- s 226D(3): on the website from the first day of inspection until the next accounts meeting
#ASSERT `s 226D(3) the company has ensured the memorandum is available on its website` (Date 6 3 2025) (Date 6 3 2025) (Date 30 6 2025) (Date 30 6 2025) EQUALS JUST TRUE
#ASSERT `s 226D(3) the company has ensured the memorandum is available on its website` (Date 6 3 2025) (Date 5 3 2025) (Date 1 7 2025) (Date 30 6 2025) EQUALS JUST TRUE
#ASSERT `s 226D(3) the company has ensured the memorandum is available on its website` (Date 6 3 2025) (Date 7 3 2025) (Date 30 6 2025) (Date 30 6 2025) EQUALS JUST FALSE
#ASSERT `s 226D(3) the company has ensured the memorandum is available on its website` (Date 6 3 2025) (Date 6 3 2025) (Date 29 6 2025) (Date 30 6 2025) EQUALS JUST FALSE

#ASSERT `s 226D(4) the failure affects the validity of the meeting or of anything done at it` TRUE EQUALS JUST FALSE
#ASSERT `s 226D(4) the failure affects the validity of the meeting or of anything done at it` FALSE EQUALS NOTHING
#ASSERT `s 226D(5) section 226B or 226C authorises the payment` TRUE EQUALS JUST FALSE
#ASSERT `s 226D(5) section 226B or 226C authorises the payment` FALSE EQUALS NOTHING
#ASSERT `s 226D(7) the website is the company's website` TRUE EQUALS JUST TRUE
#ASSERT `s 226D(7) the website is the company's website` FALSE EQUALS JUST FALSE

-- s 226D(6): nothing in ss 226B and 226C applies before the earlier of the end of the first financial year beginning on or after becoming quoted, and the date the first policy takes effect
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 1 2025) (Date 31 12 2025) NOTHING EQUALS JUST FALSE
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 31 12 2025) (Date 31 12 2025) NOTHING EQUALS NOTHING
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 1 2026) (Date 31 12 2025) NOTHING EQUALS NOTHING
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 6 2025) (Date 31 12 2025) (JUST (Date 1 7 2025)) EQUALS JUST FALSE
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 8 2025) (Date 31 12 2025) (JUST (Date 1 7 2025)) EQUALS NOTHING
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 7 2025) (Date 31 12 2025) (JUST (Date 1 7 2025)) EQUALS NOTHING
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 1 2026) (Date 31 12 2025) (JUST (Date 1 7 2026)) EQUALS NOTHING
#ASSERT `s 226D(6) sections 226B and 226C apply to the payment` (Date 1 6 2025) (Date 31 12 2025) (JUST (Date 1 7 2026)) EQUALS JUST FALSE

§ `Tests: s 226E and s 226F`

`s 226E test: plain` MEANS `s 226E(2) a payment in contravention of section 226B or 226C (neither (3) nor (4) applies)`
`s 226E test: transfer of undertaking` MEANS `s 226E(3) a payment for loss of office in contravention of section 226C to a director of a quoted company in connection with a transfer of the undertaking or property of the company or a subsidiary`
`s 226E test: takeover bid` MEANS `s 226E(4) a payment for loss of office in contravention of section 226C to a director of a quoted company in connection with a transfer of shares resulting from a takeover bid`

#ASSERT `s 226E(1) the obligation has effect` TRUE EQUALS JUST FALSE
#ASSERT `s 226E(1) the obligation has effect` FALSE EQUALS NOTHING

#ASSERT `s 226E the payment is held by the recipient on trust for` `s 226E test: plain` EQUALS JUST `s 226E(2)(a) the company or other person making the payment`
#ASSERT `s 226E the payment is held by the recipient on trust for` `s 226E test: transfer of undertaking` EQUALS JUST `s 226E(3)(b) the company whose undertaking or property is or is proposed to be transferred`
#ASSERT `s 226E the payment is held by the recipient on trust for` `s 226E test: takeover bid` EQUALS JUST `s 226E(4)(b) the persons who have sold their shares as a result of the offer made`
#ASSERT `s 226E the payment is held by the recipient on trust for` `s 226E some other payment` EQUALS NOTHING

#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E test: plain` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E test: plain` TRUE FALSE EQUALS NOTHING
#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E test: plain` FALSE TRUE EQUALS NOTHING
#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E test: transfer of undertaking` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E test: takeover bid` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226E(2)(b) the director is jointly and severally liable to indemnify the company that made the payment` `s 226E some other payment` TRUE TRUE EQUALS NOTHING
#ASSERT `s 226E(4)(c) the expenses incurred by the recipient in distributing the sum are borne by the recipient and not retained out of the sum` `s 226E test: takeover bid` EQUALS JUST TRUE
#ASSERT `s 226E(4)(c) the expenses incurred by the recipient in distributing the sum are borne by the recipient and not retained out of the sum` `s 226E test: plain` EQUALS NOTHING

#ASSERT `s 226E(5) the court may relieve the director from liability` TRUE TRUE TRUE EQUALS JUST TRUE
