IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch7`
IMPORT `coa7-ch3b`

-- coa7-tests-ch3b.l4: tests for coa7-ch3b.l4 (Part 13 Chapter 3, ss 307 to 313).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 3, ss 307 to 313`

-- s 307(A1): (a) a meeting of a company that is not a traded company; (b) a traded company's opted-in takeover meeting
#ASSERT `s 307(A1) this section applies to the general meeting` FALSE NOTHING FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE (JUST TRUE) TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE (JUST TRUE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE (JUST TRUE) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE (JUST FALSE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 307(A1) this section applies to the general meeting` TRUE NOTHING TRUE (JUST TRUE) EQUALS NOTHING
-- s 307(A2)
#ASSERT `s 307(A2) section 307A is the corresponding provision for the meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 307(A2) section 307A is the corresponding provision for the meeting` TRUE TRUE EQUALS NOTHING
#ASSERT `s 307(A2) section 307A is the corresponding provision for the meeting` FALSE FALSE EQUALS NOTHING
-- s 307(1): a private company's general meeting (other than an adjourned meeting): at least 14 days
#ASSERT `s 307(1) the days of notice required of a general meeting of a private company` FALSE FALSE EQUALS JUST 14
#ASSERT `s 307(1) the days of notice required of a general meeting of a private company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 307(1) the days of notice required of a general meeting of a private company` FALSE TRUE EQUALS NOTHING
-- s 307(2): a public company's: AGM at least 21 days, any other at least 14
#ASSERT `s 307(2) the days of notice required of a general meeting of a public company` TRUE FALSE TRUE EQUALS JUST 21
#ASSERT `s 307(2) the days of notice required of a general meeting of a public company` TRUE FALSE FALSE EQUALS JUST 14
#ASSERT `s 307(2) the days of notice required of a general meeting of a public company` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 307(2) the days of notice required of a general meeting of a public company` TRUE TRUE TRUE EQUALS NOTHING
-- s 307(3): the articles may require a longer period
#ASSERT `s 307(3) the days of notice required` (JUST 14) NOTHING EQUALS JUST 14
#ASSERT `s 307(3) the days of notice required` (JUST 14) (JUST 28) EQUALS JUST 28
#ASSERT `s 307(3) the days of notice required` (JUST 14) (JUST 7) EQUALS JUST 14
#ASSERT `s 307(3) the days of notice required` (JUST 14) (JUST 14) EQUALS JUST 14
#ASSERT `s 307(3) the days of notice required` NOTHING (JUST 28) EQUALS NOTHING
-- s 307(1) and (2) in clear days (s 360): notice on 1 March for a meeting on 16 March gives 14 clear days
#ASSERT `s 307(3) the notice given is at least the notice required` 14 (Date 1 3 2026) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 307(3) the notice given is at least the notice required` 14 (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 307(3) the notice given is at least the notice required` 21 (Date 1 3 2026) (Date 23 3 2026) EQUALS JUST TRUE
#ASSERT `s 307(3) the notice given is at least the notice required` 21 (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST FALSE
-- s 307(4)
#ASSERT `s 307(4) the meeting may be called by shorter notice than otherwise required` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 307(4) the meeting may be called by shorter notice than otherwise required` FALSE EQUALS JUST FALSE; s 307(4) is named for a permission (may be called by shorter notice) and its gate is 'if shorter notice is agreed', which the text does not close with 'only'; a failed gate is NOTHING (fork F22, name-test sweep); the facts are unchanged, JUST FALSE becomes NOTHING.
#ASSERT `s 307(4) the meeting may be called by shorter notice than otherwise required` FALSE EQUALS NOTHING
-- s 307(5): a majority in number (6 of 10) who hold not less than the requisite percentage (90%) of the nominal value (90 of 100)
#ASSERT `s 307(5) the shorter notice has been agreed to as this subsection requires` TRUE 10 6 90 100 0 0 0.9 EQUALS JUST TRUE
#ASSERT `s 307(5) the shorter notice has been agreed to as this subsection requires` TRUE 10 5 90 100 0 0 0.9 EQUALS JUST FALSE
#ASSERT `s 307(5) the shorter notice has been agreed to as this subsection requires` TRUE 10 6 89 100 0 0 0.9 EQUALS JUST FALSE
#ASSERT `s 307(5) the shorter notice has been agreed to as this subsection requires` FALSE 10 6 0 0 90 100 0.9 EQUALS JUST TRUE
#ASSERT `s 307(5) the shorter notice has been agreed to as this subsection requires` FALSE 10 6 0 0 89 100 0.9 EQUALS JUST FALSE
-- s 307(6): 90% (or a higher percentage in the articles, not above 95%) for a private company; 95% for a public company
#ASSERT `s 307(6) the requisite percentage` FALSE NOTHING EQUALS JUST 0.9
#ASSERT `s 307(6) the requisite percentage` FALSE (JUST 0.95) EQUALS JUST 0.95
#ASSERT `s 307(6) the requisite percentage` FALSE (JUST 0.92) EQUALS JUST 0.92
#ASSERT `s 307(6) the requisite percentage` FALSE (JUST 0.96) EQUALS NOTHING
#ASSERT `s 307(6) the requisite percentage` FALSE (JUST 0.85) EQUALS NOTHING
#ASSERT `s 307(6) the requisite percentage` TRUE NOTHING EQUALS JUST 0.95
-- s 307(7)
#ASSERT `s 307(7) subsections (5) and (6) do not apply to the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 307(7) subsections (5) and (6) do not apply to the meeting` FALSE EQUALS NOTHING

-- s 307A(2): condition A is that the meeting is not an AGM
#ASSERT `s 307A(2) condition A is met` FALSE EQUALS JUST TRUE
#ASSERT `s 307A(2) condition A is met` TRUE EQUALS JUST FALSE
-- s 307A(3): condition B
#ASSERT `s 307A(3) condition B is met` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 307A(3) condition B is met` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 307A(3) condition B is met` FALSE FALSE EQUALS JUST FALSE
-- s 307A(4): condition C: a special resolution at the preceding AGM or at a general meeting since
#ASSERT `s 307A(4) condition C is met` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 307A(4) condition C is met` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 307A(4) condition C is met` FALSE FALSE EQUALS JUST FALSE
-- s 307A(5): a company that has not yet held an AGM
#ASSERT `s 307A(5) condition C is met by a company that has not yet held an annual general meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 307A(5) condition C is met by a company that has not yet held an annual general meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 307A(5) condition C is met by a company that has not yet held an annual general meeting` FALSE TRUE EQUALS JUST FALSE
-- s 307A(1): 14 days if conditions A to C are met, otherwise 21
#ASSERT `s 307A(1) the days of notice required of a general meeting of a traded company` FALSE TRUE TRUE TRUE EQUALS JUST 14
#ASSERT `s 307A(1) the days of notice required of a general meeting of a traded company` FALSE FALSE TRUE TRUE EQUALS JUST 21
#ASSERT `s 307A(1) the days of notice required of a general meeting of a traded company` FALSE TRUE FALSE TRUE EQUALS JUST 21
#ASSERT `s 307A(1) the days of notice required of a general meeting of a traded company` FALSE TRUE TRUE FALSE EQUALS JUST 21
#ASSERT `s 307A(1) the days of notice required of a general meeting of a traded company` TRUE TRUE TRUE TRUE EQUALS NOTHING
-- s 307A(6)
#ASSERT `s 307A(6) the days of notice required` (JUST 14) (JUST 28) EQUALS JUST 28
#ASSERT `s 307A(6) the days of notice required` (JUST 21) (JUST 14) EQUALS JUST 21
#ASSERT `s 307A(6) the days of notice required` (JUST 21) NOTHING EQUALS JUST 21
#ASSERT `s 307A(6) the days of notice required` NOTHING (JUST 28) EQUALS NOTHING
-- s 307A(7): an adjourned meeting; after an adjournment for lack of a quorum, only if no new business and held at least 10 days after the original (1 March + 10 is 11 March)
#ASSERT `s 307A(7) the adjourned meeting may be called by shorter notice` FALSE FALSE TRUE (Date 1 3 2026) (Date 11 3 2026) EQUALS JUST FALSE
#ASSERT `s 307A(7) the adjourned meeting may be called by shorter notice` TRUE FALSE FALSE (Date 1 3 2026) (Date 2 3 2026) EQUALS JUST TRUE
#ASSERT `s 307A(7) the adjourned meeting may be called by shorter notice` TRUE TRUE TRUE (Date 1 3 2026) (Date 11 3 2026) EQUALS JUST TRUE
#ASSERT `s 307A(7) the adjourned meeting may be called by shorter notice` TRUE TRUE TRUE (Date 1 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
#ASSERT `s 307A(7) the adjourned meeting may be called by shorter notice` TRUE TRUE FALSE (Date 1 3 2026) (Date 11 3 2026) EQUALS JUST FALSE
-- s 307A(8)
#ASSERT `s 307A(8) nothing in this section applies to the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 307A(8) nothing in this section applies to the meeting` FALSE EQUALS NOTHING

-- s 308: hard copy, electronic form, website, or partly by one and partly another
#ASSERT `s 308 the notice of the general meeting is given in a manner this section allows` `s 308(a) in hard copy form` EQUALS JUST TRUE
#ASSERT `s 308 the notice of the general meeting is given in a manner this section allows` `s 308(b) in electronic form` EQUALS JUST TRUE
#ASSERT `s 308 the notice of the general meeting is given in a manner this section allows` `s 308(c) by means of a website (see section 309)` EQUALS JUST TRUE
#ASSERT `s 308 the notice of the general meeting is given in a manner this section allows` `s 308 partly by one such means and partly by another` EQUALS JUST TRUE
#ASSERT `s 308 the notice of the general meeting is given in a manner this section allows` `s 308 some other manner` EQUALS JUST FALSE
-- s 309(2): the notification states it concerns a notice of a company meeting, specifies place, date and time, and (public company) whether an AGM
#ASSERT `s 309(2) the notification to the member meets the requirements of this subsection` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 309(2) the notification to the member meets the requirements of this subsection` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 309(2) the notification to the member meets the requirements of this subsection` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 309(2) the notification to the member meets the requirements of this subsection` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 309(2) the notification to the member meets the requirements of this subsection` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 309(3): available throughout the period from the notification to the conclusion of the meeting
#ASSERT `s 309(3) the notice was available on the website throughout the period this subsection requires` (Date 1 3 2026) (Date 1 3 2026) (Date 20 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 309(3) the notice was available on the website throughout the period this subsection requires` (Date 1 3 2026) (Date 2 3 2026) (Date 20 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 309(3) the notice was available on the website throughout the period this subsection requires` (Date 1 3 2026) (Date 1 3 2026) (Date 19 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- s 309(1): the bar (TRUE: not validly given; FALSE: the bar does not apply)
#ASSERT `s 309(1) notice given by means of a website is not validly given` FALSE EQUALS JUST TRUE
#ASSERT `s 309(1) notice given by means of a website is not validly given` TRUE EQUALS JUST FALSE

-- s 310(1): to every member and every director
#ASSERT `s 310(1) notice of a general meeting must be sent to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 310(1) notice of a general meeting must be sent to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 310(1) notice of a general meeting must be sent to the person` FALSE FALSE EQUALS NOTHING
