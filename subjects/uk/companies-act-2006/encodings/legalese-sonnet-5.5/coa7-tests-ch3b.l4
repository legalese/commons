#ASSERT `s 310(3) the event is within the reference to the bankruptcy of a member` `s 310(3)(a) the sequestration of the estate of a member` EQUALS JUST TRUE
#ASSERT `s 310(3) the event is within the reference to the bankruptcy of a member` `s 310(3)(b) a member's estate being the subject of a protected trust deed (within the meaning of the Bankruptcy (Scotland) Act 2016)` EQUALS JUST TRUE
#ASSERT `s 310(3) the event is within the reference to the bankruptcy of a member` `s 310(3) another event` EQUALS NOTHING
-- s 310(4)
#ASSERT `s 310(4) the rule of this section has effect` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 310(4) the rule of this section has effect` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 310(4) the rule of this section has effect` FALSE FALSE EQUALS JUST TRUE

