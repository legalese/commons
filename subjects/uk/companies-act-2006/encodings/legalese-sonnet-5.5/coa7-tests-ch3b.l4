-- s 312(1): notice at least 28 clear days before the meeting (1 March to 30 March: 28 clear days)
#ASSERT `s 312(1) the resolution is not effective` (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 312(1) the resolution is not effective` (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
-- s 312(2): where practicable, in the same manner and at the same time as the notice of the meeting
#ASSERT `s 312(2) the company has given its members notice of the resolution as this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 312(2) the company has given its members notice of the resolution as this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 312(2) the company has given its members notice of the resolution as this subsection requires` FALSE FALSE EQUALS NOTHING
-- s 312(3): where not practicable, at least 14 clear days before the meeting, by advertisement or as the articles allow
#ASSERT `s 312(3) the company has given its members notice at least 14 days before the meeting in a manner this subsection requires` FALSE (Date 1 3 2026) (Date 16 3 2026) `s 312(3)(a) by advertisement in a newspaper having an appropriate circulation` EQUALS JUST TRUE
#ASSERT `s 312(3) the company has given its members notice at least 14 days before the meeting in a manner this subsection requires` FALSE (Date 1 3 2026) (Date 16 3 2026) `s 312(3)(b) in any other manner allowed by the company's articles` EQUALS JUST TRUE
#ASSERT `s 312(3) the company has given its members notice at least 14 days before the meeting in a manner this subsection requires` FALSE (Date 1 3 2026) (Date 15 3 2026) `s 312(3)(a) by advertisement in a newspaper having an appropriate circulation` EQUALS JUST FALSE
#ASSERT `s 312(3) the company has given its members notice at least 14 days before the meeting in a manner this subsection requires` FALSE (Date 1 3 2026) (Date 16 3 2026) `s 312(3) some other manner` EQUALS JUST FALSE
#ASSERT `s 312(3) the company has given its members notice at least 14 days before the meeting in a manner this subsection requires` TRUE (Date 1 3 2026) (Date 16 3 2026) `s 312(3)(a) by advertisement in a newspaper having an appropriate circulation` EQUALS NOTHING
-- s 312(4): a meeting called for a date 28 days or less after the notice (1 March + 28 is 29 March)
#ASSERT `s 312(4) the notice is deemed to have been properly given though not given within the time required` (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 312(4) the notice is deemed to have been properly given though not given within the time required` (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE

-- s 313(1): an accidental failure is disregarded
#ASSERT `s 313(1) the failure is disregarded in determining whether notice is duly given` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 313(1) the failure is disregarded in determining whether notice is duly given` TRUE FALSE EQUALS NOTHING
#ASSERT `s 313(1) the failure is disregarded in determining whether notice is duly given` FALSE TRUE EQUALS NOTHING
-- s 313(2): subject to the articles, except for notices under ss 304, 305 and 339
#ASSERT `s 313(2) subsection (1) has effect subject to any provision of the company's articles` `s 313(2) any other notice` EQUALS JUST TRUE
#ASSERT `s 313(2) subsection (1) has effect subject to any provision of the company's articles` `s 313(2)(a) notice given under section 304 (notice of meetings required by members)` EQUALS JUST FALSE
#ASSERT `s 313(2) subsection (1) has effect subject to any provision of the company's articles` `s 313(2)(b) notice given under section 305 (notice of meetings called by members)` EQUALS JUST FALSE
#ASSERT `s 313(2) subsection (1) has effect subject to any provision of the company's articles` `s 313(2)(c) notice given under section 339 (notice of resolutions at AGMs proposed by members)` EQUALS JUST FALSE
