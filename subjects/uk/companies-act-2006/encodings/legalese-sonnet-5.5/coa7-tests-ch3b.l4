#ASSERT `s 310(2) the person is a member for the purposes of subsection (1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 310(2) the person is a member for the purposes of subsection (1)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 310(2) the person is a member for the purposes of subsection (1)` FALSE TRUE EQUALS NOTHING
