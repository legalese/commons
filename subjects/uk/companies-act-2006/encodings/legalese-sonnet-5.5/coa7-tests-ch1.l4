IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch1`

-- coa7-tests-ch1.l4: tests for coa7-ch1.l4 (Part 13 Chapter 1, ss 281 to 287).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.
-- No top-level fixtures: every case is built inside its assertion, so no name can collide with another part's.

§ `Tests for Chapter 1 (ss 281 to 287)`

-- s 281(1): a private company's resolution "must be passed (a) as a written resolution in accordance with Chapter 2, or (b) at a meeting"
#ASSERT `s 281(1) a private company's resolution is passed in a way this section allows` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 281(1) a private company's resolution is passed in a way this section allows` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 281(1) a private company's resolution is passed in a way this section allows` FALSE FALSE FALSE EQUALS JUST FALSE
-- the subsection speaks of "a private company": a public company is outside it
#ASSERT `s 281(1) a private company's resolution is passed in a way this section allows` TRUE TRUE FALSE EQUALS NOTHING
-- s 281(2): a public company's resolution "must be passed at a meeting of the members"
#ASSERT `s 281(2) a public company's resolution is passed in the way this section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 281(2) a public company's resolution is passed in the way this section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 281(2) a public company's resolution is passed in the way this section requires` FALSE TRUE EQUALS NOTHING
-- s 281(3): an ordinary resolution unless the articles require a higher majority (or unanimity)
#ASSERT `s 281(3) what the Companies Acts require where the kind of resolution is not specified` TRUE FALSE FALSE EQUALS JUST `s 281(3) an ordinary resolution`
#ASSERT `s 281(3) what the Companies Acts require where the kind of resolution is not specified` TRUE FALSE TRUE EQUALS JUST `s 281(3) the higher majority or unanimity the articles require`
#ASSERT `s 281(3) what the Companies Acts require where the kind of resolution is not specified` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 281(3) what the Companies Acts require where the kind of resolution is not specified` FALSE FALSE FALSE EQUALS NOTHING
-- s 281(4): the three saved matters, and a matter outside them
#ASSERT `s 281(4) this Part leaves any enactment or rule of law on the matter unaffected` `s 281(4) things done otherwise than by passing a resolution` EQUALS JUST TRUE
#ASSERT `s 281(4) this Part leaves any enactment or rule of law on the matter unaffected` `s 281(4) circumstances in which a resolution is or is not treated as having been passed` EQUALS JUST TRUE
#ASSERT `s 281(4) this Part leaves any enactment or rule of law on the matter unaffected` `s 281(4) cases in which a person is precluded from alleging that a resolution has not been duly passed` EQUALS JUST TRUE
#ASSERT `s 281(4) this Part leaves any enactment or rule of law on the matter unaffected` `s 281(4) another matter` EQUALS NOTHING

-- s 282(2): written resolution: members representing a simple majority (more than half) of the total voting rights of eligible members
#ASSERT `s 282(2) a written resolution is passed by a simple majority` (`s 282 vote count` OF 51, 0, 100) EQUALS JUST TRUE
#ASSERT `s 282(2) a written resolution is passed by a simple majority` (`s 282 vote count` OF 50, 0, 100) EQUALS JUST FALSE
#ASSERT `s 282(2) a written resolution is passed by a simple majority` (`s 282 vote count` OF 40, 10, 100) EQUALS JUST FALSE
-- s 282(3): show of hands: a simple majority of the votes cast
#ASSERT `s 282(3) a resolution passed on a show of hands is passed by a simple majority` (`s 282 vote count` OF 3, 2, 0) EQUALS JUST TRUE
#ASSERT `s 282(3) a resolution passed on a show of hands is passed by a simple majority` (`s 282 vote count` OF 2, 2, 0) EQUALS JUST FALSE
#ASSERT `s 282(3) a resolution passed on a show of hands is passed by a simple majority` (`s 282 vote count` OF 2, 3, 0) EQUALS JUST FALSE
-- s 282(4): poll: a simple majority of the voting rights of members who vote
#ASSERT `s 282(4) a resolution passed on a poll is passed by a simple majority` (`s 282 vote count` OF 600, 400, 0) EQUALS JUST TRUE
#ASSERT `s 282(4) a resolution passed on a poll is passed by a simple majority` (`s 282 vote count` OF 500, 500, 0) EQUALS JUST FALSE
-- s 282(1): the way the resolution is passed picks the count. 40 for, 10 against, 100 eligible: a show of hands (40 of 50 cast) passes, a written resolution (40 of 100) does not
#ASSERT `s 282(1) the resolution is an ordinary resolution` `at a meeting on a show of hands` (`s 282 vote count` OF 40, 10, 100) EQUALS JUST TRUE
#ASSERT `s 282(1) the resolution is an ordinary resolution` `as a written resolution` (`s 282 vote count` OF 40, 10, 100) EQUALS JUST FALSE
#ASSERT `s 282(1) the resolution is an ordinary resolution` `at a meeting on a poll` (`s 282 vote count` OF 40, 10, 100) EQUALS JUST TRUE
#ASSERT `s 282(1) the resolution is an ordinary resolution` `at a meeting on a poll` (`s 282 vote count` OF 10, 40, 100) EQUALS JUST FALSE
-- s 282(5)
#ASSERT `s 282(5) the thing may also be done by special resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 282(5) the thing may also be done by special resolution` FALSE EQUALS NOTHING

-- s 283(2): written resolution: not less than 75% of the total voting rights of eligible members
#ASSERT `s 283(2) a written resolution is passed by a majority of not less than 75%` (`s 282 vote count` OF 75, 0, 100) EQUALS JUST TRUE
#ASSERT `s 283(2) a written resolution is passed by a majority of not less than 75%` (`s 282 vote count` OF 74, 0, 100) EQUALS JUST FALSE
-- s 283(4): show of hands: not less than 75% of the votes cast (exactly 75% passes)
#ASSERT `s 283(4) a resolution passed on a show of hands is passed by a majority of not less than 75%` (`s 282 vote count` OF 3, 1, 0) EQUALS JUST TRUE
#ASSERT `s 283(4) a resolution passed on a show of hands is passed by a majority of not less than 75%` (`s 282 vote count` OF 74, 26, 0) EQUALS JUST FALSE
-- s 283(5): poll
#ASSERT `s 283(5) a resolution passed on a poll is passed by a majority of not less than 75%` (`s 282 vote count` OF 750, 250, 0) EQUALS JUST TRUE
#ASSERT `s 283(5) a resolution passed on a poll is passed by a majority of not less than 75%` (`s 282 vote count` OF 749, 251, 0) EQUALS JUST FALSE
-- s 283(1)
#ASSERT `s 283(1) the resolution is a special resolution` `as a written resolution` (`s 282 vote count` OF 75, 0, 100) EQUALS JUST TRUE
#ASSERT `s 283(1) the resolution is a special resolution` `at a meeting on a show of hands` (`s 282 vote count` OF 75, 25, 0) EQUALS JUST TRUE
#ASSERT `s 283(1) the resolution is a special resolution` `at a meeting on a poll` (`s 282 vote count` OF 74, 26, 0) EQUALS JUST FALSE
-- s 283(3)(a): a private company's written resolution is not a special resolution unless it stated it was proposed as one
#ASSERT `s 283(3)(a) the written resolution of the private company is not a special resolution` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 283(3)(a) the written resolution of the private company is not a special resolution` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 283(3)(a) the written resolution of the private company is not a special resolution` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 283(3)(a) the written resolution of the private company is not a special resolution` FALSE FALSE FALSE EQUALS JUST FALSE
-- s 283(3)(b): "if the resolution so stated, it may only be passed as a special resolution"
#ASSERT `s 283(3)(b) the written resolution may only be passed as a special resolution` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 283(3)(b) the written resolution may only be passed as a special resolution` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 283(3)(b) the written resolution may only be passed as a special resolution` TRUE TRUE TRUE EQUALS JUST FALSE
-- s 283(6)(a): at a meeting, not a special resolution unless the notice included the text AND specified the intention
#ASSERT `s 283(6)(a) the resolution passed at the meeting is not a special resolution` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 283(6)(a) the resolution passed at the meeting is not a special resolution` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 283(6)(a) the resolution passed at the meeting is not a special resolution` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 283(6)(a) the resolution passed at the meeting is not a special resolution` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 283(6)(a) the resolution passed at the meeting is not a special resolution` FALSE TRUE TRUE EQUALS JUST FALSE
-- s 283(6)(b)
#ASSERT `s 283(6)(b) the resolution passed at the meeting may only be passed as a special resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 283(6)(b) the resolution passed at the meeting may only be passed as a special resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 283(6)(b) the resolution passed at the meeting may only be passed as a special resolution` FALSE TRUE EQUALS JUST FALSE

-- s 284(4): the rules of the section give way to a provision of the articles
#ASSERT `s 284(4) the rules of this section have effect` FALSE EQUALS JUST TRUE
#ASSERT `s 284(4) the rules of this section have effect` TRUE EQUALS JUST FALSE
-- s 284(1): a share capital: one vote per share or each £10 of stock (10 shares and £35 of stock: 10 + 3 whole tens); otherwise one vote
#ASSERT `s 284(1) the member's votes on a written resolution` FALSE TRUE 10 35 EQUALS JUST 13
#ASSERT `s 284(1) the member's votes on a written resolution` FALSE TRUE 10 0 EQUALS JUST 10
#ASSERT `s 284(1) the member's votes on a written resolution` FALSE FALSE 0 0 EQUALS JUST 1
#ASSERT `s 284(1) the member's votes on a written resolution` TRUE TRUE 10 35 EQUALS NOTHING
-- s 284(2): each member present in person has one vote
#ASSERT `s 284(2) the member's votes on a show of hands` FALSE TRUE EQUALS JUST 1
#ASSERT `s 284(2) the member's votes on a show of hands` FALSE FALSE EQUALS NOTHING
#ASSERT `s 284(2) the member's votes on a show of hands` TRUE TRUE EQUALS NOTHING
-- s 284(3): poll, as (1)
#ASSERT `s 284(3) the member's votes on a poll` FALSE TRUE 100 0 EQUALS JUST 100
#ASSERT `s 284(3) the member's votes on a poll` FALSE FALSE 0 0 EQUALS JUST 1
#ASSERT `s 284(3) the member's votes on a poll` TRUE FALSE 0 0 EQUALS NOTHING
-- s 284(5): the five saved sections
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) section 152 (exercise of rights by nominees)` EQUALS JUST TRUE
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) section 285 (voting by proxy)` EQUALS JUST TRUE
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) section 322 (exercise of voting rights on poll)` EQUALS JUST TRUE
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) section 322A (voting on a poll: votes cast in advance)` EQUALS JUST TRUE
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) section 323 (representation of corporations at meetings)` EQUALS JUST TRUE
#ASSERT `s 284(5) this section is not to be read as restricting the effect of the section` `s 284(5) another section` EQUALS NOTHING

-- s 285(1): a proxy present and duly appointed has one vote
#ASSERT `s 285(1) the proxy's votes on a show of hands` TRUE TRUE EQUALS JUST 1
#ASSERT `s 285(1) the proxy's votes on a show of hands` FALSE TRUE EQUALS NOTHING
#ASSERT `s 285(1) the proxy's votes on a show of hands` TRUE FALSE EQUALS NOTHING
-- s 285(2): one vote for and one against if appointed by more than one member, instructed for by one or more and against by one or more others
#ASSERT `s 285(2) the proxy has one vote for and one vote against the resolution` 2 1 1 EQUALS JUST TRUE
#ASSERT `s 285(2) the proxy has one vote for and one vote against the resolution` 5 3 2 EQUALS JUST TRUE
#ASSERT `s 285(2) the proxy has one vote for and one vote against the resolution` 1 1 0 EQUALS JUST FALSE
#ASSERT `s 285(2) the proxy has one vote for and one vote against the resolution` 2 2 0 EQUALS JUST FALSE
#ASSERT `s 285(2) the proxy has one vote for and one vote against the resolution` 2 0 2 EQUALS JUST FALSE
-- s 285(3)
#ASSERT `s 285(3) the member's voting rights on a poll may be exercised by the proxy` TRUE EQUALS JUST TRUE
#ASSERT `s 285(3) the member's voting rights on a poll may be exercised by the proxy` FALSE EQUALS NOTHING
-- s 285(4): more than one proxy; together they may not exercise more than the member in person (100 rights)
#ASSERT `s 285(4) subsection (3) authorises the proxies together to exercise these rights` TRUE 101 100 EQUALS JUST FALSE
#ASSERT `s 285(4) subsection (3) authorises the proxies together to exercise these rights` TRUE 100 100 EQUALS NOTHING
#ASSERT `s 285(4) subsection (3) authorises the proxies together to exercise these rights` TRUE 60 100 EQUALS NOTHING
#ASSERT `s 285(4) subsection (3) authorises the proxies together to exercise these rights` FALSE 60 100 EQUALS JUST FALSE
-- s 285(5)
#ASSERT `s 285(5) subsections (1) and (2) have effect` FALSE EQUALS JUST TRUE
#ASSERT `s 285(5) subsections (1) and (2) have effect` TRUE EQUALS JUST FALSE

-- s 285A: a private company's articles give a different number of votes on a poll and on a written resolution
#ASSERT `s 285A(a) the articles' provision about votes on a poll is void` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 285A(a) the articles' provision about votes on a poll is void` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 285A(a) the articles' provision about votes on a poll is void` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 285A(a) the articles' provision about votes on a poll is void` FALSE TRUE FALSE EQUALS JUST FALSE
-- s 285A(b): the member has on the poll the same number of votes as on the written resolution
#ASSERT `s 285A the member's votes on a poll` FALSE TRUE TRUE 7 EQUALS JUST 7
#ASSERT `s 285A the member's votes on a poll` TRUE TRUE TRUE 7 EQUALS NOTHING
#ASSERT `s 285A the member's votes on a poll` FALSE TRUE FALSE 7 EQUALS NOTHING

-- s 286(2): the senior holder who votes is the first in the register's order among those who vote
#ASSERT `s 286(2) the senior holder who votes` (LIST "A", "B", "C") (LIST "C", "B") EQUALS JUST "B"
#ASSERT `s 286(2) the senior holder who votes` (LIST "A", "B", "C") (LIST "A", "B", "C") EQUALS JUST "A"
#ASSERT `s 286(2) the senior holder who votes` (LIST "A", "B", "C") EMPTY EQUALS NOTHING
-- s 286(1): only the senior holder who votes (and proxies duly authorised by that holder) may be counted
#ASSERT `s 286(1) the holder's own vote may be counted by the company` "B" FALSE (LIST "A", "B", "C") (LIST "B", "C") EQUALS JUST TRUE
#ASSERT `s 286(1) the holder's own vote may be counted by the company` "C" FALSE (LIST "A", "B", "C") (LIST "B", "C") EQUALS JUST FALSE
#ASSERT `s 286(1) the holder's own vote may be counted by the company` "A" FALSE (LIST "A", "B", "C") (LIST "B", "C") EQUALS NOTHING
#ASSERT `s 286(1) the holder's own vote may be counted by the company` "B" TRUE (LIST "A", "B", "C") (LIST "B", "C") EQUALS NOTHING
#ASSERT `s 286(1) a vote by a proxy duly authorised by the holder may be counted by the company` "B" FALSE (LIST "A", "B", "C") (LIST "B", "C") EQUALS JUST TRUE
#ASSERT `s 286(1) a vote by a proxy duly authorised by the holder may be counted by the company` "C" FALSE (LIST "A", "B", "C") (LIST "B", "C") EQUALS JUST FALSE
#ASSERT `s 286(1) a vote by a proxy duly authorised by the holder may be counted by the company` "B" TRUE (LIST "A", "B", "C") (LIST "B", "C") EQUALS NOTHING
-- s 286(3)
#ASSERT `s 286(3) subsections (1) and (2) have effect` FALSE EQUALS JUST TRUE
#ASSERT `s 286(3) subsections (1) and (2) have effect` TRUE EQUALS JUST FALSE

-- s 287
#ASSERT `s 287 this Chapter leaves the matter unaffected` `s 287(a) a provision of the articles requiring an objection to a person's entitlement to vote to be made in accordance with the articles and for its determination to be final and conclusive` EQUALS JUST TRUE
#ASSERT `s 287 this Chapter leaves the matter unaffected` `s 287(b) the grounds on which such a determination may be questioned in legal proceedings` EQUALS JUST TRUE
#ASSERT `s 287 this Chapter leaves the matter unaffected` `s 287 another matter` EQUALS NOTHING
