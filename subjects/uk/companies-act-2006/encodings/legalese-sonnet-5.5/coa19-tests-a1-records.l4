IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa19-nouns`
IMPORT `coa19-a1-records`

-- coa19-tests-a1-records.l4: tests for coa19-a1-records.l4 (ss 859P and 859Q).
-- Every expected value is written from the text of the section named in the comment above it, not from the code's output.

§ `Tests: ss 859P and 859Q`

§§ `s 859P Companies to keep copies of instruments creating and amending charges`
-- (1) every instrument creating a charge capable of registration, and every instrument varying or amending one; no other kind is decided
#ASSERT `s 859P(1) the company must keep a copy of the instrument available for inspection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 859P(1) the company must keep a copy of the instrument available for inspection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 859P(1) the company must keep a copy of the instrument available for inspection` FALSE FALSE EQUALS NOTHING
-- (2) in the case of a series of uniform debentures a copy of one is sufficient
#ASSERT `s 859P(2) a copy of one of the debentures is sufficient for subsection (1)(a)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 859P(2) a copy of one of the debentures is sufficient for subsection (1)(a)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 859P(2) a copy of one of the debentures is sufficient for subsection (1)(a)` FALSE TRUE EQUALS JUST FALSE
-- (3) particulars contained in other documents incorporated into the instrument: the company must keep those too
#ASSERT `s 859P(3) the company must also keep a copy of those other documents available for inspection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 859P(3) the company must also keep a copy of those other documents available for inspection` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 859P(3) the company must also keep a copy of those other documents available for inspection` FALSE TRUE EQUALS JUST FALSE
-- (4) a copy in the form delivered to the registrar is sufficient
#ASSERT `s 859P(4) keeping a copy in the form delivered to the registrar is sufficient for subsection (1)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 859P(4) keeping a copy in the form delivered to the registrar is sufficient for subsection (1)(a)` FALSE EQUALS NOTHING
-- (5) a translation delivered in accordance with s 1105 (a seam)
#ASSERT `s 859P(5) the company must keep a copy of the translation available for inspection` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 859P(5) the company must keep a copy of the translation available for inspection` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 859P(5) the company must keep a copy of the translation available for inspection` NOTHING EQUALS NOTHING

§§ `s 859Q Instruments creating charges to be available for inspection`
-- (1) applies to documents required to be kept under s 859P
#ASSERT `s 859Q(1) this section applies to the documents` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 859Q(1) this section applies to the documents` FALSE EQUALS JUST FALSE; s 859Q(1): a scope statement with no "only" does not give the text's no outside it (as s 860(7), fork F-C2)
#ASSERT `s 859Q(1) this section applies to the documents` FALSE EQUALS NOTHING
-- (2) at the registered office or at a place specified in regulations under s 1136
#ASSERT `s 859Q(2) the documents are kept at a place the subsection allows` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 859Q(2) the documents are kept at a place the subsection allows` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 859Q(2) the documents are kept at a place the subsection allows` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 859Q(2) the documents are kept at a place the subsection allows` FALSE NOTHING EQUALS NOTHING
-- (3) notice of the place and of any change, unless the documents have at all times been at the registered office
#ASSERT `s 859Q(3) the company must give notice to the registrar of the place and of any change in that place` TRUE EQUALS JUST FALSE
#ASSERT `s 859Q(3) the company must give notice to the registrar of the place and of any change in that place` FALSE EQUALS JUST TRUE
-- (4) creditors and members without charge; any other person on payment of the prescribed fee (the fee is an input; 5 pounds is illustrative)
#ASSERT `s 859Q(4) the terms on which the documents must be open to the inspection of the person` TRUE 5 EQUALS `s 859Q(4)(a) open to inspection without charge`
#ASSERT `s 859Q(4) the terms on which the documents must be open to the inspection of the person` FALSE 5 EQUALS `s 859Q(4)(b) open to inspection on payment of the prescribed fee` 5
-- (5) an offence if default is made for 14 days in complying with (3), or an inspection is refused: 13 days is not enough, 14 is
#ASSERT `s 859Q(5) an offence is committed` 14 FALSE EQUALS JUST TRUE
#ASSERT `s 859Q(5) an offence is committed` 13 FALSE EQUALS JUST FALSE
#ASSERT `s 859Q(5) an offence is committed` 0 TRUE EQUALS JUST TRUE
#ASSERT `s 859Q(5) an offence is committed` 30 TRUE EQUALS JUST TRUE
-- (5)(a) the company
#ASSERT `s 859Q(5)(a) the company commits the offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 859Q(5)(a) the company commits the offence` (JUST FALSE) EQUALS JUST FALSE
-- (5)(b) every officer of the company who is in default (s 1121 is a seam; "officer" is s 1173(1))
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 859Q(5)(b) the officer commits the offence` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
-- (6) the penalty: summary conviction, level 3, and a daily default fine of one-tenth of level 3
#ASSERT (`s 859Q(6) the penalty for the offence`'s `how convicted`) EQUALS `on summary conviction`
#ASSERT (`s 859Q(6) the penalty for the offence`'s `fine not exceeding`) EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 859Q(6) the penalty for the offence`'s `daily default fine for continued contravention`) EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
-- (7) the court may compel an immediate inspection if one is refused
#ASSERT `s 859Q(7) the court may by order compel an immediate inspection` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 859Q(7) the court may by order compel an immediate inspection` FALSE EQUALS JUST FALSE; s 859Q(7): the power is given on the gate quoted and the text does not say the person has none otherwise, so NOTHING (name-test sweep: a grant is not turned into a bar)
#ASSERT `s 859Q(7) the court may by order compel an immediate inspection` FALSE EQUALS NOTHING
-- (8) electronic inspection where the company and the person agree
#ASSERT `s 859Q(8) the inspection may be carried out by electronic means` TRUE EQUALS JUST TRUE
#ASSERT `s 859Q(8) the inspection may be carried out by electronic means` FALSE EQUALS JUST FALSE
