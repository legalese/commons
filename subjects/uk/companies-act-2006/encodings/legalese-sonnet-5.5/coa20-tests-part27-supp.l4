IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa20-part26`
IMPORT `coa20-part26a`
IMPORT `coa20-part27-merger`
IMPORT `coa20-part27-division`
IMPORT `coa20-part27-supp`

-- coa20-tests-part27-supp.l4: tests for coa20-part27-supp.l4 (ss 935-941). Expected values are written from the text of each section.

§ `Tests -- s 935 Expert's report: valuation by another person`
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` TRUE TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` FALSE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 935(1) the expert may arrange for or accept the valuation` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 935(2) the expert's report states what the section requires` TRUE TRUE TRUE TRUE TRUE EQUALS `s 903(1) requirement complied with`
#ASSERT `s 935(2) the expert's report states what the section requires` TRUE FALSE TRUE TRUE TRUE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 935(2) the expert's report states what the section requires` TRUE TRUE FALSE TRUE TRUE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 935(2) the expert's report states what the section requires` TRUE TRUE TRUE FALSE TRUE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 935(2) the expert's report states what the section requires` TRUE TRUE TRUE TRUE FALSE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 935(2) the expert's report states what the section requires` FALSE FALSE FALSE FALSE FALSE EQUALS `s 903(1) requirement does not apply`

§ `Tests -- s 936 Experts and valuers: independence requirement`
-- s 936(1): "only if": no officer, employee or partner link to a company concerned or its associated undertaking, and no connection specified by regulations
#ASSERT `s 936(1) the person meets the independence requirement` FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 936(1) the person meets the independence requirement` TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 936(1) the person meets the independence requirement` FALSE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 936(1) the person meets the independence requirement` FALSE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 936(1) the person meets the independence requirement` FALSE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 936(1) the person meets the independence requirement` FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 936(1) the person meets the independence requirement` FALSE FALSE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 936(1) the person meets the independence requirement` TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 936(2) the person is regarded as an officer or employee of the company for the purposes of section 936` TRUE EQUALS JUST FALSE
#ASSERT `s 936(2) the person is regarded as an officer or employee of the company for the purposes of section 936` FALSE EQUALS NOTHING
#ASSERT `s 936(3)(a) the company is a company concerned in the scheme` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 936(3)(a) the company is a company concerned in the scheme` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 936(3)(a) the company is a company concerned in the scheme` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 936(3)(b) the undertaking is an associated undertaking of the company` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 936(3)(b) the undertaking is an associated undertaking of the company` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 936(3)(b) the undertaking is an associated undertaking of the company` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 936(3)(b) the undertaking is an associated undertaking of the company` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 936(3)(c) the person is an associate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 936(3)(c) the person is an associate` NOTHING EQUALS NOTHING

§ `Tests -- s 937 Experts and valuers: meaning of "associate"`
#ASSERT `s 937(1) the definition applies` TRUE EQUALS JUST TRUE
#ASSERT `s 937(1) the definition applies` FALSE EQUALS NOTHING
-- individual: spouse, civil partner, minor child or step-child; a body corporate of which he is a director; an employee or partner
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 a spouse, civil partner, minor child or step-child of the individual` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 a body corporate of which the other is a director (for a limited liability partnership, a member)` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 an employee of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 a partner of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 a body corporate in the same group as the other` EQUALS JUST FALSE
#ASSERT `s 937 the person is an associate` `s 937(2) an individual` `s 937 any other relationship` EQUALS JUST FALSE
-- body corporate: a body corporate of which it is a director; in the same group; an employee or partner of it or of a body corporate in the same group
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 a body corporate of which the other is a director (for a limited liability partnership, a member)` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 a body corporate in the same group as the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 an employee of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 a partner of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 an employee or partner of a body corporate in the same group as the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(3) a body corporate` `s 937 a spouse, civil partner, minor child or step-child of the individual` EQUALS JUST FALSE
-- partnership that is a legal person: a body corporate of which it is a director; an employee of or partner in it; an associate of a partner
#ASSERT `s 937 the person is an associate` `s 937(4) a partnership that is a legal person under the law by which it is governed` `s 937 a body corporate of which the other is a director (for a limited liability partnership, a member)` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(4) a partnership that is a legal person under the law by which it is governed` `s 937 an employee of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(4) a partnership that is a legal person under the law by which it is governed` `s 937 a partner of the other` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(4) a partnership that is a legal person under the law by which it is governed` `s 937 a person who is an associate of a partner in the partnership` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(4) a partnership that is a legal person under the law by which it is governed` `s 937 a body corporate in the same group as the other` EQUALS JUST FALSE
-- partnership that is not a legal person: any person who is an associate of any of the partners
#ASSERT `s 937 the person is an associate` `s 937(5) a partnership that is not a legal person under the law by which it is governed` `s 937 a person who is an associate of a partner in the partnership` EQUALS JUST TRUE
#ASSERT `s 937 the person is an associate` `s 937(5) a partnership that is not a legal person under the law by which it is governed` `s 937 an employee of the other` EQUALS JUST FALSE

§ `Tests -- s 938 Power of court to summon meeting of members or creditors of existing transferee company`
#ASSERT `s 938(1) the court may order a meeting of the members or creditors of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 938(1) the court may order a meeting of the members or creditors of the company` FALSE EQUALS NOTHING
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) a creditor of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) a member of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) the liquidator of the company` TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 938(2) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F33)
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) the administrator of the company` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 938(2) the person may apply to the court` `s 896(2) the administrator of the company` TRUE FALSE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F33)
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) the administrator of the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 938(2) the person may apply to the court` `s 896(2) any other person` TRUE TRUE EQUALS NOTHING
#ASSERT `s 938(3) section 323 applies to the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 938(3) section 323 applies to the meeting` FALSE EQUALS NOTHING

§ `Tests -- s 939 Court to fix date for transfer of undertaking etc of transferor company`
#ASSERT `s 939(1) the court has fixed a date for the transfer` TRUE TRUE EQUALS `s 903(1) requirement complied with`
#ASSERT `s 939(1) the court has fixed a date for the transfer` TRUE FALSE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 939(1) the court has fixed a date for the transfer` FALSE FALSE EQUALS `s 903(1) requirement does not apply`
#ASSERT `s 939(2) the order fixes the same date for the dissolution` TRUE TRUE EQUALS `s 903(1) requirement complied with`
#ASSERT `s 939(2) the order fixes the same date for the dissolution` TRUE FALSE EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 939(2) the order fixes the same date for the dissolution` FALSE FALSE EQUALS `s 903(1) requirement does not apply`
-- s 939(3): not later than six months after the date fixed under (1): date fixed 31 July 2026: six months later is 31 January 2027
#ASSERT `s 939(3) the court has fixed a date for the steps within six months` TRUE (Date 31 7 2026) (Date 31 1 2027) EQUALS `s 903(1) requirement complied with`
#ASSERT `s 939(3) the court has fixed a date for the steps within six months` TRUE (Date 31 7 2026) (Date 1 2 2027) EQUALS `s 903(1) requirement not complied with`
#ASSERT `s 939(3) the court has fixed a date for the steps within six months` TRUE (Date 31 7 2026) (Date 1 8 2026) EQUALS `s 903(1) requirement complied with`
#ASSERT `s 939(3) the court has fixed a date for the steps within six months` FALSE (Date 31 7 2026) (Date 1 8 2027) EQUALS `s 903(1) requirement does not apply`
#ASSERT `s 939(4) the court may postpone the dissolution of the transferor company until that date` TRUE EQUALS JUST TRUE
#ASSERT `s 939(4) the court may postpone the dissolution of the transferor company until that date` FALSE EQUALS NOTHING
#ASSERT `s 939(5) the court may postpone or further postpone the date` TRUE EQUALS JUST TRUE
#ASSERT `s 939(5) the court may postpone or further postpone the date` FALSE EQUALS NOTHING

§ `Tests -- s 940 Liability of transferee companies for each other's defaults`
-- s 940(2) (Part 26): a majority in number (more than half) representing 75% in value; s 940(2A) (Part 26A): 75% in value
#ASSERT `s 940(2) subsection (1) does not apply in relation to the liabilities owed to those creditors` `s 940(2) Part 26` 100 51 1000 750 EQUALS JUST TRUE
#ASSERT `s 940(2) subsection (1) does not apply in relation to the liabilities owed to those creditors` `s 940(2) Part 26` 100 50 1000 750 EQUALS JUST FALSE
#ASSERT `s 940(2) subsection (1) does not apply in relation to the liabilities owed to those creditors` `s 940(2) Part 26` 100 51 1000 749 EQUALS JUST FALSE
#ASSERT `s 940(2) subsection (1) does not apply in relation to the liabilities owed to those creditors` `s 940(2A) Part 26A` 100 10 1000 750 EQUALS JUST TRUE
#ASSERT `s 940(2) subsection (1) does not apply in relation to the liabilities owed to those creditors` `s 940(2A) Part 26A` 100 90 1000 749 EQUALS JUST FALSE
-- s 940(3): the net value transferred is the value of the property less the liabilities (nil if negative: fork F12)
#ASSERT `s 940(3) the net value transferred` 1000 400 EQUALS 600
#ASSERT `s 940(3) the net value transferred` 400 400 EQUALS 0
#ASSERT `s 940(3) the net value transferred` 300 400 EQUALS 0
-- s 940(1): jointly and severally liable for the defaulted amount, at most the net value, and not at all where (2) or (2A) applies
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE TRUE (JUST FALSE) 200 600 EQUALS JUST 200
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE TRUE (JUST FALSE) 600 600 EQUALS JUST 600
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE TRUE (JUST FALSE) 601 600 EQUALS JUST 600
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE TRUE (JUST TRUE) 200 600 EQUALS JUST 0
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE TRUE NOTHING 200 600 EQUALS NOTHING
#ASSERT `s 940(1) the amount for which the transferee company is liable` FALSE TRUE (JUST FALSE) 200 600 EQUALS NOTHING
#ASSERT `s 940(1) the amount for which the transferee company is liable` TRUE FALSE (JUST FALSE) 200 600 EQUALS NOTHING

§ `Tests -- s 940A Disregard of website failures beyond control of company`
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(a) section 906A(6)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(b) section 911A(4)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(c) section 916(3B) and (4B)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(d) section 917(3B) and (4B)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(e) section 918(2B) and (3B)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(f) section 921A(6)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(g) section 926A(4)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(h) section 931(3B) and (4B)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2)(i) section 932(2B) and (3B)` EQUALS JUST TRUE
#ASSERT `s 940A(2) the provision is one of those to which section 940A(1) applies` `s 940A(2) any other provision` EQUALS JUST FALSE
#ASSERT `s 940A(1) the failure is to be disregarded` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 940A(1) the failure is to be disregarded` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 940A(1) the failure is to be disregarded` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 940A(1) the failure is to be disregarded` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 940A(1) the failure is to be disregarded` NOTHING TRUE TRUE EQUALS NOTHING

§ `Tests -- s 941 Meaning of "liabilities" and "property"`
#ASSERT `s 941 the thing is a liability` TRUE EQUALS JUST TRUE
#ASSERT `s 941 the thing is a liability` FALSE EQUALS NOTHING
#ASSERT `s 941 the thing is property` TRUE EQUALS JUST TRUE
#ASSERT `s 941 the thing is property` FALSE EQUALS NOTHING
