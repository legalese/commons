-- s 1216(4)(a), (b)
#ASSERT `s 1216(4)(a) the partnership is regarded as succeeding to the practice of the former partnership` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1216(4)(a) the partnership is regarded as succeeding to the practice of the former partnership` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1216(4)(a) the partnership is regarded as succeeding to the practice of the former partnership` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1216(4)(b) the partnership or other person is regarded as succeeding to the practice of the former partnership` TRUE EQUALS NOTHING
#ASSERT `s 1216(4)(b) the partnership or other person is regarded as succeeding to the practice of the former partnership` FALSE EQUALS JUST FALSE
-- s 1216(6). order: eligible by virtue of Chapter 2, the s 1214(1) answer
#ASSERT `s 1216(6) the partnership or other person is appropriate` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1216(6) the partnership or other person is appropriate` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 1216(6) the partnership or other person is appropriate` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1216(6) the partnership or other person is appropriate` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1216(6) the partnership or other person is appropriate` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1216(6) the partnership or other person is appropriate` NOTHING (JUST FALSE) EQUALS JUST FALSE
-- s 1216(3). order: ceases, appropriate partnership which in fact succeeds, other appropriate person who in fact succeeds, (4)(a) answer, (4)(b) answer
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE (JUST FALSE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` FALSE (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1216(3) the appointment is treated as extending to the successor` TRUE NOTHING (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
-- s 1216(5). order: ceases, treated under (3) as extending (MAYBE), the audited person consents, successor appropriate (MAYBE), successor succeeds to the business or the agreed part
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST FALSE) TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE NOTHING TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` FALSE (JUST FALSE) TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST TRUE) TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST FALSE) FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST FALSE) TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST FALSE) TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 1216(5) the appointment may be treated as extending to the successor` TRUE (JUST FALSE) TRUE NOTHING TRUE EQUALS NOTHING

-- The four duties as regulative rules. A DEONTIC outcome cannot be asserted with EQUALS on the stable binary, so these are traced and
-- the outcome is recorded in NOTES.md (read from l4 run): the duties above are asserted as decision functions.
-- s 1213(1): an ineligible person who acts breaches the prohibition
#TRACE `s 1213(1) the prohibition on acting while ineligible` TRUE AT 0 WITH
    PARTY Auditor DOES `s 1213(1) acts as statutory auditor of the audited person` AT 3
-- s 1213(1): an eligible person is not bound
#TRACE `s 1213(1) the prohibition on acting while ineligible` FALSE AT 0 WITH
    PARTY Auditor DOES `s 1213(1) acts as statutory auditor of the audited person` AT 3
-- s 1213(2): resigns and gives notice at once: fulfilled
#TRACE `s 1213(2) the duty of a statutory auditor who becomes ineligible` AT 0 WITH
    PARTY Auditor DOES `s 1213(2)(a) resigns his office with immediate effect` AT 0
    PARTY Auditor DOES `s 1213(2)(b) gives notice in writing that he has resigned by reason of his becoming ineligible` AT 0
-- s 1213(2): resigns but never gives notice: breach for the notice
#TRACE `s 1213(2) the duty of a statutory auditor who becomes ineligible` AT 0 WITH
    PARTY Auditor DOES `s 1213(2)(a) resigns his office with immediate effect` AT 0
    WAITUNTIL 2
-- s 1213(2): does not resign at once: breach
#TRACE `s 1213(2) the duty of a statutory auditor who becomes ineligible` AT 0 WITH
    WAITUNTIL 1
-- s 1214(1): the prohibition when subsection (2), (3) or (4) applies
#TRACE `s 1214(1) the prohibition on acting without independence` TRUE AT 0 WITH
    PARTY Auditor DOES `s 1214(1) acts as statutory auditor of the audited person` AT 1
#TRACE `s 1214(1) the prohibition on acting without independence` FALSE AT 0 WITH
    PARTY Auditor DOES `s 1214(1) acts as statutory auditor of the audited person` AT 1
-- s 1215(1): the duty on becoming prohibited from acting
#TRACE `s 1215(1) the duty of a statutory auditor who becomes prohibited from acting` AT 0 WITH
    PARTY Auditor DOES `s 1215(1)(a) resigns his office with immediate effect` AT 0
    PARTY Auditor DOES `s 1215(1)(b) gives notice in writing that he has resigned by reason of his lack of independence` AT 0
#TRACE `s 1215(1) the duty of a statutory auditor who becomes prohibited from acting` AT 0 WITH
    PARTY Auditor DOES `s 1215(1)(a) resigns his office with immediate effect` AT 0
    WAITUNTIL 2
#TRACE `s 1215(1) the duty of a statutory auditor who becomes prohibited from acting` AT 0 WITH
    WAITUNTIL 1
