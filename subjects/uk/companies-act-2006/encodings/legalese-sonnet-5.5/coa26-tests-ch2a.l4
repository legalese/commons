#ASSERT (`s 1215(3) the penalty for an offence under subsection (2)` `on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT (`s 1215(3) the penalty for an offence under subsection (2)` `on summary conviction in Scotland`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT (`s 1215(3) the penalty for an offence under subsection (2)` `on summary conviction`)'s `imprisonment not exceeding` EQUALS NOTHING
-- s 1215(4), (5)
#ASSERT `s 1215(4) the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1215(4) the person is guilty of an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1215(4) the person is guilty of an offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1215(5) the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1215(5) the person is guilty of an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1215(5) the person is guilty of an offence` FALSE TRUE EQUALS JUST FALSE
-- s 1215(6): the same daily fine as s 1213(7)
#ASSERT `s 1215(6) the penalty for an offence under subsection (4) or (5)` `on conviction on indictment` 2500 EQUALS `s 1213(7) a fine without a stated limit`
#ASSERT `s 1215(6) the penalty for an offence under subsection (4) or (5)` `on summary conviction` 2500 EQUALS `s 1213(7) a fine not exceeding a sum for each day on which the act or the failure continues` 500
#ASSERT `s 1215(6) the penalty for an offence under subsection (4) or (5)` `on summary conviction` 8000 EQUALS `s 1213(7) a fine not exceeding a sum for each day on which the act or the failure continues` 800
#ASSERT `s 1215(6) the penalty for an offence under subsection (4) or (5)` `on summary conviction in Northern Ireland` 5000 EQUALS `s 1213(7) a fine not exceeding a sum for each day on which the act or the failure continues` 500
