#ASSERT `s 1215(7) the defence is made out` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1215(7) the defence is made out` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1215(7) the defence is made out` FALSE TRUE EQUALS JUST FALSE

-- s 1216(1). order: England and Wales, Northern Ireland, other place where a partnership is not a legal person, appointed by virtue of Chapter 2
#ASSERT `s 1216(1) this section applies` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1216(1) this section applies` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1216(1) this section applies` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1216(1) this section applies` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1216(1) this section applies` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 1216(2). order: section applies (MAYBE), contrary intention appears
#ASSERT `s 1216(2) the appointment is an appointment of the partnership as such and not of the partners` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 1216(2) the appointment is an appointment of the partnership as such and not of the partners` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 1216(2) the appointment is an appointment of the partnership as such and not of the partners` (JUST FALSE) FALSE EQUALS NOTHING
