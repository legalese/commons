    WHEN `s 853H(2A)(a) a description specified in section 790B(1)(a)` THEN
        IF `the statement specifies whether the company falls within the description specified in section 790B(1)(a) or a description specified in regulations under section 790B(1)(b)`
        THEN JUST TRUE
        ELSE JUST FALSE -- FALSE-kind (the text says no in its own words): "The statement under subsection (2) must specify— (a) whether the company falls within the description specified in section 790B(1)(a) or a description specified in regulations under section 790B(1)(b)"
    WHEN `s 853H(2A)(b) a description specified in regulations under section 790B(1)(b)` THEN
        IF     `the statement specifies whether the company falls within the description specified in section 790B(1)(a) or a description specified in regulations under section 790B(1)(b)`
           AND `the statement specifies what that description is`
        THEN JUST TRUE
        ELSE JUST FALSE -- FALSE-kind (the text says no in its own words): "(b) if it falls within a description specified in regulations under section 790B(1)(b), what that description is."

