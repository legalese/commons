IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa26-support`
IMPORT `coa26-ch2c`

-- Tests for coa26-ch2c.l4 (ss 1223-1224B). Expected values are written by hand from the text.

-- s 1223(1): the power reaches the named body, for requirement (a) or (b); anything else is outside the grant. order: body answer, (a), (b)
#ASSERT `s 1223(1) the Secretary of State may require the body to notify or give information` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1223(1) the Secretary of State may require the body to notify or give information` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1223(1) the Secretary of State may require the body to notify or give information` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 1223(1) the Secretary of State may require the body to notify or give information` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1223(1) the Secretary of State may require the body to notify or give information` NOTHING TRUE TRUE EQUALS NOTHING
-- s 1223(2): the requirement must be reasonable
#ASSERT `s 1223(2) the notice or information required is within subsection (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 1223(2) the notice or information required is within subsection (2)` FALSE EQUALS JUST FALSE
-- s 1223(3)
#ASSERT `s 1223(3) the Secretary of State may require the information to be given in a specified form or verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1223(3) the Secretary of State may require the information to be given in a specified form or verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1223(3) the Secretary of State may require the information to be given in a specified form or verified in a specified manner` FALSE TRUE EQUALS NOTHING
-- s 1223(4): in writing unless another manner is specified or approved. order: required under this section, other manner specified or approved
#ASSERT `s 1223(4) the notice or information must be given in writing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1223(4) the notice or information must be given in writing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1223(4) the notice or information must be given in writing` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1223(4) the notice or information must be given in writing` FALSE TRUE EQUALS NOTHING
-- s 1223ZA(1): the power reaches the named body, for requirement (a) or (b); anything else is outside the grant. order: body answer, (a), (b)
#ASSERT `s 1223ZA(1) the competent authority may require the body to notify or give information` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1223ZA(1) the competent authority may require the body to notify or give information` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1223ZA(1) the competent authority may require the body to notify or give information` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 1223ZA(1) the competent authority may require the body to notify or give information` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1223ZA(1) the competent authority may require the body to notify or give information` NOTHING TRUE TRUE EQUALS NOTHING
-- s 1223ZA(2): the requirement must be reasonable
#ASSERT `s 1223ZA(2) the notice or information required is within subsection (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 1223ZA(2) the notice or information required is within subsection (2)` FALSE EQUALS JUST FALSE
-- s 1223ZA(3)
#ASSERT `s 1223ZA(3) the competent authority may require the information to be given in a specified form or verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1223ZA(3) the competent authority may require the information to be given in a specified form or verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1223ZA(3) the competent authority may require the information to be given in a specified form or verified in a specified manner` FALSE TRUE EQUALS NOTHING
-- s 1223ZA(4): in writing unless another manner is specified or approved. order: required under this section, other manner specified or approved
#ASSERT `s 1223ZA(4) the notice or information must be given in writing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1223ZA(4) the notice or information must be given in writing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1223ZA(4) the notice or information must be given in writing` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1223ZA(4) the notice or information must be given in writing` FALSE TRUE EQUALS NOTHING
-- s 1224(1). order: the person is within the persons named (MAYBE), the requirement is by notice in writing, the information is reasonably required
#ASSERT `s 1224(1) the Secretary of State may by notice in writing require the person to give the information` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1224(1) the Secretary of State may by notice in writing require the person to give the information` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 1224(1) the Secretary of State may by notice in writing require the person to give the information` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 1224(1) the Secretary of State may by notice in writing require the person to give the information` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1224(1) the Secretary of State may by notice in writing require the person to give the information` NOTHING TRUE TRUE EQUALS NOTHING
-- s 1224(2): the persons named. order: recognised supervisory body, recognised qualifying body, eligible by virtue of Chapter 2
#ASSERT `s 1224(2) the person is within subsection (2)` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224(2) the person is within subsection (2)` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224(2) the person is within subsection (2)` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1224(2) the person is within subsection (2)` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1224(2) the person is within subsection (2)` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
-- s 1224(3): a reasonable time and a specified manner of verification
#ASSERT `s 1224(3) the Secretary of State may require the information to be given within a reasonable time and verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1224(3) the Secretary of State may require the information to be given within a reasonable time and verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1224(3) the Secretary of State may require the information to be given within a reasonable time and verified in a specified manner` FALSE TRUE EQUALS NOTHING
-- s 1224ZA(1). order: the person is within the persons named (MAYBE), the requirement is by notice in writing, the information is reasonably required
#ASSERT `s 1224ZA(1) the competent authority may by notice in writing require the person to give the information` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1224ZA(1) the competent authority may by notice in writing require the person to give the information` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 1224ZA(1) the competent authority may by notice in writing require the person to give the information` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 1224ZA(1) the competent authority may by notice in writing require the person to give the information` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1224ZA(1) the competent authority may by notice in writing require the person to give the information` NOTHING TRUE TRUE EQUALS NOTHING
-- s 1224ZA(2): a reasonable time and a specified manner of verification
#ASSERT `s 1224ZA(2) the competent authority may require the information to be given within a reasonable time and verified in a specified manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1224ZA(2) the competent authority may require the information to be given within a reasonable time and verified in a specified manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1224ZA(2) the competent authority may require the information to be given within a reasonable time and verified in a specified manner` FALSE TRUE EQUALS NOTHING

-- s 1223A(3): a notifiable person is a member who is also an approved third country auditor and whose approving authority is not the body itself
-- order: member of the recognised supervisory body, approved third country auditor (MAYBE), the approving authority is the body itself
#ASSERT `s 1223A(3) the person is a notifiable person` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 1223A(3) the person is a notifiable person` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(3) the person is a notifiable person` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 1223A(3) the person is a notifiable person` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(3) the person is a notifiable person` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
-- s 1223A(1)(a): notify when a notifiable person becomes eligible, unless an individual. order: notifiable (MAYBE), becomes eligible, is an individual
#ASSERT `s 1223A(1)(a) the recognised supervisory body must notify the Secretary of State that the notifiable person has become eligible` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1223A(1)(a) the recognised supervisory body must notify the Secretary of State that the notifiable person has become eligible` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1223A(1)(a) the recognised supervisory body must notify the Secretary of State that the notifiable person has become eligible` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(1)(a) the recognised supervisory body must notify the Secretary of State that the notifiable person has become eligible` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(1)(a) the recognised supervisory body must notify the Secretary of State that the notifiable person has become eligible` NOTHING TRUE FALSE EQUALS NOTHING
-- s 1223A(1)(b), (c): withdrawal of eligibility, and its reasons. order: notifiable (MAYBE), eligibility withdrawn
#ASSERT `s 1223A(1)(b) the recognised supervisory body must notify the Secretary of State that the notifiable person's eligibility is withdrawn` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1223A(1)(b) the recognised supervisory body must notify the Secretary of State that the notifiable person's eligibility is withdrawn` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(1)(b) the recognised supervisory body must notify the Secretary of State that the notifiable person's eligibility is withdrawn` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 1223A(1)(c) the recognised supervisory body must notify the Secretary of State of the reasons for the withdrawal` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1223A(1)(c) the recognised supervisory body must notify the Secretary of State of the reasons for the withdrawal` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(1)(c) the recognised supervisory body must notify the Secretary of State of the reasons for the withdrawal` (JUST FALSE) TRUE EQUALS JUST FALSE
-- s 1223A(2)
#ASSERT `s 1223A(2) the recognised supervisory body must notify the Secretary of State of its grounds for suspecting a contravention` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1223A(2) the recognised supervisory body must notify the Secretary of State of its grounds for suspecting a contravention` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1223A(2) the recognised supervisory body must notify the Secretary of State of its grounds for suspecting a contravention` FALSE TRUE EQUALS JUST FALSE

-- s 1224A(2): the bodies. order: recognised supervisory body, recognised qualifying body, competent authority, Independent Supervisor, Secretary of State, body designated under s 1252
#ASSERT `s 1224A(2) the section applies to the body` (JUST TRUE) (JUST FALSE) FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST TRUE) FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST FALSE) TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST FALSE) FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST FALSE) FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1224A(2) the section applies to the body` (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- s 1224A(1). order: private affairs of an individual, any particular business, provided to a body within (2) (MAYBE), in connection with functions
#ASSERT `s 1224A(1) the section applies to the information` TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1224A(1) the section applies to the information` FALSE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1224A(1) the section applies to the information` FALSE FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 1224A(1) the section applies to the information` TRUE FALSE (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1224A(1) the section applies to the information` TRUE FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 1224A(1) the section applies to the information` TRUE FALSE (JUST TRUE) FALSE EQUALS NOTHING
-- s 1224A(4). order: to facilitate the body's functions, to a person in Part 1 of Sch 11A, of a description in Part 2, in accordance with Part 3
#ASSERT `s 1224A(4) subsection (3) does not apply to the disclosure` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1224A(4) subsection (3) does not apply to the disclosure` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1224A(4) subsection (3) does not apply to the disclosure` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1224A(4) subsection (3) does not apply to the disclosure` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1224A(4) subsection (3) does not apply to the disclosure` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 1224A(6), (7)
#ASSERT `s 1224A(6) the section does not prohibit the disclosure` TRUE EQUALS JUST TRUE
#ASSERT `s 1224A(6) the section does not prohibit the disclosure` FALSE EQUALS NOTHING
#ASSERT `s 1224A(7) the section authorises the disclosure` TRUE EQUALS JUST FALSE
#ASSERT `s 1224A(7) the section authorises the disclosure` FALSE EQUALS NOTHING
-- s 1224A(3): order: subsection (1) applies (MAYBE), alive or business continues, consent, (4) applies (MAYBE), (6) applies (MAYBE)
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) TRUE FALSE NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) TRUE TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) FALSE FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) TRUE FALSE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) TRUE FALSE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1224A(3) the information may be disclosed` (JUST TRUE) TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1224A(3) the information may be disclosed` (JUST FALSE) TRUE FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 1224A(3) the information may be disclosed` NOTHING TRUE FALSE NOTHING NOTHING EQUALS NOTHING

-- s 1224B(1): order: the person discloses, the s 1224A(3) answer, did not know and had no reason to suspect, took all reasonable steps and due diligence
#ASSERT `s 1224B(1) the person is guilty of an offence` TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1224B(1) the person is guilty of an offence` FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1224B(1) the person is guilty of an offence` TRUE NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 1224B(1) the person is guilty of an offence` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1224B(1) the person is guilty of an offence` TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1224B(1) the person is guilty of an offence` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE
-- s 1224B(2): imprisonment and fine; no figure for a summary conviction in no stated place
#ASSERT (`s 1224B(2) the penalty for an offence under section 1224B` `on conviction on indictment`) EQUALS JUST (Penalty WITH `how convicted` IS `on conviction on indictment`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 2, unit IS Years), `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT (`s 1224B(2) the penalty for an offence under section 1224B` `on summary conviction in Scotland`) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 12, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT (`s 1224B(2) the penalty for an offence under section 1224B` `on summary conviction in England and Wales`) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 3, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT (`s 1224B(2) the penalty for an offence under section 1224B` `on summary conviction in Northern Ireland`) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 3, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1224B(2) the penalty for an offence under section 1224B` `on summary conviction` EQUALS NOTHING
