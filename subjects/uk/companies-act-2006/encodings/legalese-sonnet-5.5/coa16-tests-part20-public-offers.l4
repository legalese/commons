IMPORT prelude
IMPORT daydate
IMPORT `coa16-part20-public-offers`

-- coa16-tests-part20-public-offers.l4: tests for coa16-part20-public-offers.l4 (ss 755 to 760).
-- Every expected value is written from the text beside the assertion, never from the code's output.
-- #TRACE results are read by hand (an assertion cannot compare a DEONTIC); each trace carries its expected result.

-- ---- s 756(6): the members of a person's family ---------------------------------------------------------------------
-- relationship: spouse or civil partner, child (including a step-child), descendant of such a child
#ASSERT `s 756(6) the person is a member of the other person's family` (`s 756(6) relationship to another person` OF TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(6) the person is a member of the other person's family` (`s 756(6) relationship to another person` OF FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(6) the person is a member of the other person's family` (`s 756(6) relationship to another person` OF FALSE, FALSE, TRUE) EQUALS JUST TRUE
-- a sibling or a parent is not on the list: "are" closes it
#ASSERT `s 756(6) the person is a member of the other person's family` (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE) EQUALS JUST FALSE

-- ---- s 756(5): a person already connected with the company ------------------------------------------------------------
-- facts: (a) existing member (s 112), (a) existing employee, (b) relationship to a member or employee, (c) widow/widower/surviving civil partner,
-- (d) existing debenture holder, (e) trustee of a trust whose principal beneficiary is within (a) to (d)
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST TRUE), FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), TRUE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), FALSE, (`s 756(6) relationship to another person` OF FALSE, TRUE, FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, TRUE) EQUALS JUST TRUE
-- none of the limbs: "means" closes the list
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF (JUST FALSE), FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- membership not known and no other limb holds: not covered; membership not known but an employee: covered
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF NOTHING, FALSE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 756(5) the person is already connected with the company` (`s 756(5) facts about the person` OF NOTHING, TRUE, (`s 756(6) relationship to another person` OF FALSE, FALSE, FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE

-- ---- s 756(4), (3), (2), (1): an offer ----------------------------------------------------------------------------------
-- offer fields in order: (2) made to the public or a section of it, (3)(a) not calculated to make securities available to others,
-- (3)(b) otherwise a private concern, (4)(a) made to a person already connected, (4)(a) renunciation allowed, (4)(a) only to connected persons,
-- (4)(b) employees' share scheme offer, (4)(b) renunciation allowed, (4)(b)(i)/(ii) only to scheme or connected persons, the contrary is proved
-- A. a plain offer to the public
#ASSERT `s 756(4)(a) the offer is made to a person already connected, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(4)(b) the offer is for securities to be held under an employees' share scheme, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(2) the offer is an offer to the public by inclusion` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- B. an offer to a person already connected, with no right to renounce: presumed a private concern, so not an offer to the public
#ASSERT `s 756(4)(a) the offer is made to a person already connected, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- C. connected, renunciation allowed but only in favour of connected persons
#ASSERT `s 756(4)(a) the offer is made to a person already connected, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), TRUE, TRUE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- D. connected, renunciation allowed to anyone: not within (a)
#ASSERT `s 756(4)(a) the offer is made to a person already connected, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), TRUE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), TRUE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), TRUE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- E. an employees' share scheme offer with no right to renounce
#ASSERT `s 756(4)(b) the offer is for securities to be held under an employees' share scheme, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST TRUE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST TRUE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST TRUE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- F. a scheme offer, renunciation allowed: only to scheme or connected persons, or to anyone
#ASSERT `s 756(4)(b) the offer is for securities to be held under an employees' share scheme, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST TRUE), TRUE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(4)(b) the offer is for securities to be held under an employees' share scheme, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST TRUE), TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- G. the contrary is proved: the presumption does not apply
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, TRUE) EQUALS JUST TRUE
-- H. subsection (3) judgments: (a) not calculated to make securities available to others; (b) otherwise a private concern
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, TRUE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, FALSE, TRUE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, TRUE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- I. not made to the public or any section of it, and nothing excludes it: the text does not say
#ASSERT `s 756(2) the offer is an offer to the public by inclusion` (`s 756 offer` OF FALSE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF FALSE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
-- J. whether the offeree is already connected is not known
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, NOTHING, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 756(3) the offer is excluded from being an offer to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, NOTHING, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 756(1) the offer is an offer of securities to the public` (`s 756 offer` OF TRUE, FALSE, FALSE, NOTHING, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, FALSE) EQUALS NOTHING
-- K. offeree status not known but limb (b) holds
#ASSERT `s 756(4) the presumption that the offer is a private concern applies` (`s 756 offer` OF TRUE, FALSE, FALSE, NOTHING, FALSE, FALSE, (JUST TRUE), FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- the scheme status is not known
#ASSERT `s 756(4)(b) the offer is for securities to be held under an employees' share scheme, on terms allowing renunciation only to such persons` (`s 756 offer` OF TRUE, FALSE, FALSE, (JUST FALSE), FALSE, FALSE, NOTHING, FALSE, FALSE, FALSE) EQUALS NOTHING

-- ---- s 755(5): "securities" means shares or debentures ----------------------------------------------------------------------
#ASSERT `s 755(5) the instrument is a security for this Chapter` `s 738 a share in a company` EQUALS JUST TRUE
#ASSERT `s 755(5) the instrument is a security for this Chapter` `s 738 debenture stock` EQUALS JUST TRUE
#ASSERT `s 755(5) the instrument is a security for this Chapter` `s 738 a bond` EQUALS JUST TRUE
#ASSERT `s 755(5) the instrument is a security for this Chapter` `s 738 another security of a company` EQUALS JUST TRUE
#ASSERT `s 755(5) the instrument is a security for this Chapter` `s 738 something that is not a security of a company` EQUALS NOTHING

-- ---- s 755(1): the company the prohibition binds ----------------------------------------------------------------------------
-- Company profile: place, liability of the members, a share capital, certificate states it is a public company; then the s 4(2)(b) fact
-- a private company limited by shares
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, FALSE) FALSE EQUALS JUST TRUE
-- a private company limited by guarantee and having a share capital
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF Scotland, `liability limited to the amount the members undertake to contribute on a winding up`, TRUE, FALSE) FALSE EQUALS JUST TRUE
-- limited by guarantee with no share capital
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF `England and Wales`, `liability limited to the amount the members undertake to contribute on a winding up`, FALSE, FALSE) FALSE EQUALS NOTHING
-- an unlimited private company
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF `England and Wales`, `liability not limited`, TRUE, FALSE) FALSE EQUALS NOTHING
-- a public company (certificate states it, requirements complied with)
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE EQUALS NOTHING
-- the certificate states it is public but the requirements were not complied with: not a public company, so private
#ASSERT `s 755(1) the company is within the prohibition` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) FALSE EQUALS JUST TRUE

-- ---- s 755(1)(a): offering securities to the public ----------------------------------------------------------------------------
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- subsection 756(3) excludes the offer
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
-- no offer made
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- not shares or debentures
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 755(1)(a) the company offers securities of the company to the public` TRUE NOTHING (JUST TRUE) EQUALS NOTHING

-- ---- s 755(2): the presumption: six months, and the consideration ---------------------------------------------------------------
-- (a) allotment 1 June 2023: an offer on 1 December 2023 is within six months; 2 December is not; an offer before the allotment is not "after" it
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 1 6 2023) (Date 1 12 2023) EQUALS TRUE
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 1 6 2023) (Date 2 12 2023) EQUALS FALSE
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 1 6 2023) (Date 1 6 2023) EQUALS TRUE
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 1 6 2023) (Date 31 5 2023) EQUALS FALSE
-- allotment 31 August 2023: six months on is 29 February 2024 (a day that exists)
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 31 8 2023) (Date 29 2 2024) EQUALS TRUE
#ASSERT `s 755(2)(a) the offer is made within six months after the allotment or agreement to allot` (Date 31 8 2023) (Date 1 3 2024) EQUALS FALSE
-- (b) before the receipt of the whole of the consideration: not yet received; received after; received on the day; received before
#ASSERT `s 755(2)(b) the offer is made before the company receives the whole of the consideration` (Date 10 6 2023) NOTHING EQUALS TRUE
#ASSERT `s 755(2)(b) the offer is made before the company receives the whole of the consideration` (Date 10 6 2023) (JUST (Date 11 6 2023)) EQUALS TRUE
#ASSERT `s 755(2)(b) the offer is made before the company receives the whole of the consideration` (Date 10 6 2023) (JUST (Date 10 6 2023)) EQUALS FALSE
#ASSERT `s 755(2)(b) the offer is made before the company receives the whole of the consideration` (Date 10 6 2023) (JUST (Date 9 6 2023)) EQUALS FALSE
-- the presumption as a whole: offered, allotment date, offer date, consideration received, the contrary proved
#ASSERT `s 755(2) the presumption that the allotment was made with a view to the securities being offered to the public applies` TRUE (Date 1 1 2023) (Date 1 5 2023) (JUST (Date 1 3 2023)) FALSE EQUALS JUST TRUE
-- more than six months after, and the consideration already received
#ASSERT `s 755(2) the presumption that the allotment was made with a view to the securities being offered to the public applies` TRUE (Date 1 1 2023) (Date 1 9 2023) (JUST (Date 1 3 2023)) FALSE EQUALS JUST FALSE
-- more than six months after, but the consideration is still not received
#ASSERT `s 755(2) the presumption that the allotment was made with a view to the securities being offered to the public applies` TRUE (Date 1 1 2023) (Date 1 9 2023) NOTHING FALSE EQUALS JUST TRUE
-- no offer to the public
#ASSERT `s 755(2) the presumption that the allotment was made with a view to the securities being offered to the public applies` FALSE (Date 1 1 2023) (Date 1 5 2023) NOTHING FALSE EQUALS JUST FALSE
-- the contrary is proved
#ASSERT `s 755(2) the presumption that the allotment was made with a view to the securities being offered to the public applies` TRUE (Date 1 1 2023) (Date 1 5 2023) NOTHING TRUE EQUALS JUST FALSE

-- ---- s 755(1)(b): allotting with a view to a public offer -----------------------------------------------------------------------------
-- allotted, a security, the view in fact, the presumption applies
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE (JUST TRUE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE (JUST TRUE) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` FALSE (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE (JUST FALSE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 755(1)(b) the company allots or agrees to allot securities with a view to their being offered to the public` TRUE NOTHING TRUE (JUST TRUE) EQUALS NOTHING

-- ---- s 755(4): the specified period ------------------------------------------------------------------------------------------------------
-- offer made 1 January 2023: a period ending 1 July 2023 is six months on; 30 June is earlier; 2 July is later
#ASSERT `s 755(4) the specified period ends in time` (Date 1 1 2023) (Date 1 7 2023) EQUALS JUST TRUE
#ASSERT `s 755(4) the specified period ends in time` (Date 1 1 2023) (Date 30 6 2023) EQUALS JUST TRUE
#ASSERT `s 755(4) the specified period ends in time` (Date 1 1 2023) (Date 2 7 2023) EQUALS JUST FALSE
-- offer made 31 August 2023: six months on is 29 February 2024
#ASSERT `s 755(4) the specified period ends in time` (Date 31 8 2023) (Date 29 2 2024) EQUALS JUST TRUE
#ASSERT `s 755(4) the specified period ends in time` (Date 31 8 2023) (Date 1 3 2024) EQUALS JUST FALSE

-- ---- s 755(3): the exceptions ---------------------------------------------------------------------------------------------------------------------
-- good faith, arrangements to re-register before allotment, undertaking in the terms of the offer, undertaking complied with, day offer made, last day of the specified period
#ASSERT `s 755(3) the company is excepted from the prohibition` TRUE TRUE FALSE FALSE (Date 1 1 2023) (Date 1 1 2023) EQUALS JUST TRUE
-- good faith but no such arrangements
#ASSERT `s 755(3) the company is excepted from the prohibition` TRUE FALSE FALSE FALSE (Date 1 1 2023) (Date 1 1 2023) EQUALS JUST FALSE
-- such arrangements but not in good faith
#ASSERT `s 755(3) the company is excepted from the prohibition` FALSE TRUE FALSE FALSE (Date 1 1 2023) (Date 1 1 2023) EQUALS JUST FALSE
-- (b): an undertaking, complied with, in a period ending in time
#ASSERT `s 755(3) the company is excepted from the prohibition` FALSE FALSE TRUE TRUE (Date 1 1 2023) (Date 1 7 2023) EQUALS JUST TRUE
-- (b): the undertaking is not complied with
#ASSERT `s 755(3) the company is excepted from the prohibition` FALSE FALSE TRUE FALSE (Date 1 1 2023) (Date 1 7 2023) EQUALS JUST FALSE
-- (b): the specified period ends more than six months after the offer
#ASSERT `s 755(3) the company is excepted from the prohibition` FALSE FALSE TRUE TRUE (Date 1 1 2023) (Date 2 7 2023) EQUALS JUST FALSE
-- neither
#ASSERT `s 755(3) the company is excepted from the prohibition` FALSE FALSE FALSE FALSE (Date 1 1 2023) (Date 1 1 2023) EQUALS JUST FALSE

-- ---- s 755(1) as a whole: within the prohibition, an act, not excepted ---------------------------------------------------------------------
-- within, offered to the public, not excepted: contravenes
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) (JUST TRUE) NOTHING (JUST FALSE) EQUALS JUST TRUE
-- within, allotted with a view, not excepted: contravenes
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- the exception applies: "A company does not contravene this section if"
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE
-- whether the exception applies is not known
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS NOTHING
-- the offer is not an offer to the public and no allotment with a view
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- neither act shown
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) NOTHING NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
-- a company outside the prohibition, or not known to be within it
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` NOTHING (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 755(1) the company contravenes the prohibition, subject to subsection (3)` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING

-- s 755(1) as a regulative rule: a company within the prohibition.  Offers securities to the public on day 5: expected DEONTIC BREACHED
#TRACE `s 755(1) the company must not offer securities to the public or allot them with a view to a public offer` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 755 offer securities of the company to the public` AT 5
-- allots with a view to a public offer on day 5: expected DEONTIC BREACHED
#TRACE `s 755(1) the company must not offer securities to the public or allot them with a view to a public offer` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 755 allot or agree to allot securities of the company with a view to their being offered to the public` AT 5
-- does nothing: expected the standing prohibition (no breach)
#TRACE `s 755(1) the company must not offer securities to the public or allot them with a view to a public offer` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 400)
-- a company outside the prohibition: expected FULFILLED
#TRACE `s 755(1) the company must not offer securities to the public or allot them with a view to a public offer` NOTHING AT 0 WITH
    PARTY Company DOES `s 755 offer securities of the company to the public` AT 5

-- ---- s 757 ------------------------------------------------------------------------------------------------------------------------------------------
-- it appears to the court that the company is proposing to contravene; an application; Part 30 proceedings
#ASSERT `s 757(1) the court shall make an order restraining the company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 757(1) the court shall make an order restraining the company` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 757(1) the court shall make an order restraining the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 757(1) the court shall make an order restraining the company` FALSE TRUE FALSE EQUALS JUST FALSE
-- the duty as a regulative rule: the court orders on day 5: expected FULFILLED
#TRACE `s 757(1) the court must make the order` (JUST TRUE) AT 0 WITH
    PARTY Court DOES `s 757 make an order restraining the company from contravening section 755` AT 5
-- the duty stands, nothing done: expected the standing obligation
#TRACE `s 757(1) the court must make the order` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 30)
-- the duty does not arise: expected FULFILLED
#TRACE `s 757(1) the court must make the order` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 30)
#ASSERT `s 757(2) the order is an order under this section` TRUE EQUALS JUST TRUE
#ASSERT `s 757(2) the order is an order under this section` FALSE EQUALS JUST FALSE
-- (3) who may apply: a member (s 112), a creditor, the Secretary of State
#ASSERT `s 757(3) the person may apply for an order under this section` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 757(3) the person may apply for an order under this section` NOTHING TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 757(3) the person may apply for an order under this section` (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 757(3) the person may apply for an order under this section` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 757(3) the person may apply for an order under this section` NOTHING FALSE FALSE EQUALS NOTHING

-- ---- s 758 ------------------------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 758(1) the section applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 758(1) the section applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 758(1) the section applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 758(1) the section applies` FALSE TRUE FALSE EQUALS JUST FALSE
-- (2) contravention; application; Part 30; the company does not meet the re-registration requirements; impractical or undesirable
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- one limb of the exception alone is not enough
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- both limbs: the exception
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- the section does not apply
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 758(2) the court must make an order requiring the company to re-register as a public company` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the duty as a regulative rule: ordered on day 5: expected FULFILLED; nothing done: expected the standing obligation
#TRACE `s 758(2) the court must order the company to re-register` (JUST TRUE) AT 0 WITH
    PARTY Court DOES `s 758 make an order requiring the company to re-register as a public company` AT 5
#TRACE `s 758(2) the court must order the company to re-register` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 30)
#TRACE `s 758(2) the court must order the company to re-register` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 30)
