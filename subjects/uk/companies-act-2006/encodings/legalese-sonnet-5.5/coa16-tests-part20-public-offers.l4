#ASSERT `s 758(3)(a) the court may make a remedial order` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 758(3)(a) the court may make a remedial order` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 758(3)(a) the court may make a remedial order` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 758(3)(b) the court may make an order for the compulsory winding up of the company` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 758(3)(b) the court may make an order for the compulsory winding up of the company` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 758(3)(b) the court may make an order for the compulsory winding up of the company` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- (4) who may apply: a member then, a member as a result of the offer, a creditor then, the Secretary of State
#ASSERT `s 758(4) the person may apply for an order under this section` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 758(4) the person may apply for an order under this section` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 758(4) the person may apply for an order under this section` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 758(4) the person may apply for an order under this section` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 758(4) the person may apply for an order under this section` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- ---- s 759 ------------------------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 759(1) the order is a remedial order` TRUE EQUALS JUST TRUE
#ASSERT `s 759(1) the order is a remedial order` FALSE EQUALS JUST FALSE
-- (2) without prejudice to the generality: listed or not listed
#ASSERT `s 759(2) the court may make a remedial order of this form` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 759(2) the court may make a remedial order of this form` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 759(2) the court may make a remedial order of this form` (JUST FALSE) TRUE EQUALS NOTHING
