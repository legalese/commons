    IF `the person is guilty of an offence under this section`
    THEN JUST (LIST (Penalty WITH
            `how convicted` IS `on conviction on indictment`
            `imprisonment not exceeding` IS NOTHING
            `fine not exceeding` IS JUST `a fine without a stated limit`
            `daily default fine for continued contravention` IS NOTHING
            `imprisonment and fine together` IS FALSE),
                    (Penalty WITH
            `how convicted` IS `on summary conviction`
            `imprisonment not exceeding` IS NOTHING
            `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1)
            `daily default fine for continued contravention` IS NOTHING
            `imprisonment and fine together` IS FALSE))
    ELSE NOTHING -- NOTHING-kind (limited by its own wording): "A person guilty of an offence under this section is liable"


§§ `s 648 Court order confirming reduction`

