IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-period`
IMPORT `coa10-filing`
IMPORT `coa10-exemptions`

-- coa10-tests-exemptions.l4: tests for coa10-exemptions.l4 (ss 448 to 448C). Every expected value was written down from
-- the text of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 448(2): the conditions (lines 6062-6066) ----
#ASSERT `s 448(2) the undertaking was limited at that time` TRUE EQUALS JUST TRUE
#ASSERT `s 448(2) the undertaking was limited at that time` FALSE EQUALS JUST FALSE
#ASSERT `s 448(2)(a) the condition is met` TRUE EQUALS JUST FALSE
#ASSERT `s 448(2)(a) the condition is met` FALSE EQUALS JUST TRUE
#ASSERT `s 448(2)(b) the condition is met` TRUE EQUALS JUST FALSE
#ASSERT `s 448(2)(b) the condition is met` FALSE EQUALS JUST TRUE
#ASSERT `s 448(2)(c) the condition is met` TRUE EQUALS JUST FALSE
#ASSERT `s 448(2)(c) the condition is met` FALSE EQUALS JUST TRUE
#ASSERT `s 448(2) the conditions are met` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 448(2) the conditions are met` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 448(2) the conditions are met` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 448(2) the conditions are met` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 448(2) the conditions are met` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 448(2) the conditions are met` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE

-- ---- s 448(3): the exceptions (lines 6067-6074) ----
#ASSERT `s 448(3)(a) the company is a banking or insurance company or the parent company of a banking or insurance group` TRUE FALSE FALSE FALSE
#ASSERT `s 448(3)(a) the company is a banking or insurance company or the parent company of a banking or insurance group` FALSE TRUE FALSE FALSE
#ASSERT `s 448(3)(a) the company is a banking or insurance company or the parent company of a banking or insurance group` FALSE FALSE TRUE FALSE
#ASSERT `s 448(3)(a) the company is a banking or insurance company or the parent company of a banking or insurance group` FALSE FALSE FALSE TRUE
#ASSERT NOT `s 448(3)(a) the company is a banking or insurance company or the parent company of a banking or insurance group` FALSE FALSE FALSE FALSE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 a limited company`, `s 448 a limited company`) EQUALS JUST TRUE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 a limited company`, `s 448 another unlimited company each of whose members is a limited company`) EQUALS JUST TRUE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 a Scottish partnership which is not a limited partnership, each of whose members is a limited company`) EQUALS JUST TRUE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 a Scottish partnership which is a limited partnership, each of whose general partners is a limited company`) EQUALS JUST TRUE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 a limited company`, `s 448 any other kind of member`) EQUALS JUST FALSE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (LIST `s 448 any other kind of member`) EQUALS JUST FALSE
#ASSERT `s 448(3)(b) each of the members of the company is of a kind that paragraph (b) names` (EMPTY) EQUALS NOTHING
#ASSERT `s 448(3) the undertaking counts as a member of a kind that paragraph (b) names` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 448(3) the undertaking counts as a member of a kind that paragraph (b) names` TRUE FALSE EQUALS NOTHING
#ASSERT `s 448(3) the undertaking counts as a member of a kind that paragraph (b) names` FALSE TRUE EQUALS NOTHING
#ASSERT `s 448(3) the section bars the exemption` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 448(3) the section bars the exemption` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 448(3) the section bars the exemption` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 448(3) the section bars the exemption` FALSE NOTHING EQUALS NOTHING

-- ---- s 448(1): the exemption itself (lines 6060-6061) ----
-- Not an unlimited company: the section speaks only of unlimited companies.
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` FALSE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- Unlimited, conditions met, not barred: exempt.
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- Barred by (3): not exempt, whatever the conditions say.
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- A condition fails: not exempt.
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE (JUST FALSE) NOTHING EQUALS JUST FALSE
-- Not known.
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 448(1) the directors of the unlimited company are not required to deliver accounts and reports` TRUE NOTHING NOTHING EQUALS NOTHING

-- ---- s 448(4): the substitutions (lines 6075-6077) ----
