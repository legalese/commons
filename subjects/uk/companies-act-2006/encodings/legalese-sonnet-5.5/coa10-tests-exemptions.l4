-- ---- s 448C: the guarantee (lines 6107-6117) ----
#ASSERT `s 448C(1) a guarantee is given by the parent undertaking` TRUE EQUALS JUST TRUE
#ASSERT `s 448C(1) a guarantee is given by the parent undertaking` FALSE EQUALS JUST FALSE
-- (2): five items, and authentication. (c) is blank in the text.
#ASSERT `s 448C(2) the statement meets the requirements of the section` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 448C(2) the statement meets the requirements of the section` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 448C(2) the statement meets the requirements of the section` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
