#ASSERT `s 448(5) the person is a general partner` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 448(5) the partnership is a limited partnership` TRUE EQUALS JUST TRUE
#ASSERT `s 448(5) the partnership is a limited partnership` FALSE EQUALS JUST FALSE
#ASSERT `s 448(5) the accounting reference period is the relevant accounting reference period in relation to the financial year` TRUE EQUALS JUST TRUE
#ASSERT `s 448(5) the accounting reference period is the relevant accounting reference period in relation to the financial year` FALSE EQUALS JUST FALSE

