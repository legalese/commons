IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch1`
IMPORT `coa15-ch4`
IMPORT `coa15-ch5`

-- coa15-tests-ch5.l4: tests of coa15-ch5.l4 (ss 709 to 723). Expected values are written from the text before the run.
-- Dates: a resolution passed on 1 June 2026 is used throughout; five weeks after it is 6 July 2026 and seven weeks after it is 20 July 2026.

-- ---- ss 709 and 710 ------------------------------------------------------------------------------------

#ASSERT `s 709(1) the private limited company may make the payment out of capital` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 709(1) the private limited company may make the payment out of capital` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE`; the function is named for a grant or a power and its "if" gate fails here, so it answers NOTHING and not JUST FALSE (fork F-grant-709-1)
#ASSERT `s 709(1) the private limited company may make the payment out of capital` TRUE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 709(1) the private limited company may make the payment out of capital` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 709(1) the private limited company may make the payment out of capital` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 709(1) the private limited company may make the payment out of capital` FALSE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 709(2) the payment is a payment out of capital for the purposes of this Chapter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 709(2) the payment is a payment out of capital for the purposes of this Chapter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 709(2) the payment is a payment out of capital for the purposes of this Chapter` FALSE TRUE EQUALS NOTHING
#ASSERT `s 709(3) the requirements of Chapter 5 are displaced by section 692(1ZA)` TRUE EQUALS JUST TRUE
#ASSERT `s 709(3) the requirements of Chapter 5 are displaced by section 692(1ZA)` FALSE EQUALS NOTHING

-- the price 1,000: the available profits and the proceeds of a fresh issue are applied first
#ASSERT `s 710(1) the permissible capital payment` 1000 300 200 EQUALS 500
#ASSERT `s 710(1) the permissible capital payment` 1000 800 200 EQUALS 0
#ASSERT `s 710(1) the permissible capital payment` 1000 900 300 EQUALS 0
#ASSERT `s 710(1) the permissible capital payment` 1000 799 200 EQUALS 1
#ASSERT `s 710(1) the permissible capital payment` 1000 0 200 EQUALS 800
#ASSERT `s 710(1) the permissible capital payment` 1000 (0 MINUS 50) 200 EQUALS 800
#ASSERT `s 710(1) the permissible capital payment` 1000 0 0 EQUALS 1000

-- ---- ss 711 and 712 ------------------------------------------------------------------------------------

`fixture: a distribution on 15 February` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(3)(a) a distribution lawfully made by the company`
    `s 712(3) amount of the payment` IS 1000
    `s 712(3) date of the payment` IS Date 15 2 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: financial assistance on 20 February` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(4)(a) financial assistance lawfully given out of distributable profits in accordance with Chapter 2`
    `s 712(3) amount of the payment` IS 500
    `s 712(3) date of the payment` IS Date 20 2 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: a payment on the date of the accounts` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(3)(a) a distribution lawfully made by the company`
    `s 712(3) amount of the payment` IS 7000
    `s 712(3) date of the payment` IS Date 1 1 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: a payment on the last day of the period` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(3)(a) a distribution lawfully made by the company`
    `s 712(3) amount of the payment` IS 7000
    `s 712(3) date of the payment` IS Date 31 3 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: an unlawful payment` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(3)(a) a distribution lawfully made by the company`
    `s 712(3) amount of the payment` IS 200
    `s 712(3) date of the payment` IS Date 10 3 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS FALSE
`fixture: a payment of another kind in the period` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(4) another kind of payment`
    `s 712(3) amount of the payment` IS 300
    `s 712(3) date of the payment` IS Date 5 3 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: a payment of another kind outside the period` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(4) another kind of payment`
    `s 712(3) amount of the payment` IS 300
    `s 712(3) date of the payment` IS Date 1 1 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: a purchase payment` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(4)(b) a payment lawfully made out of distributable profits in respect of the purchase by the company of shares in the company`
    `s 712(3) amount of the payment` IS 40
    `s 712(3) date of the payment` IS Date 2 3 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE
`fixture: a section 705 payment` MEANS `s 712(3) payment` WITH
    `s 712(3) kind of payment` IS `s 712(4)(c) a payment of a description specified in section 705 lawfully made by the company`
    `s 712(3) amount of the payment` IS 60
    `s 712(3) date of the payment` IS Date 3 3 2026
    `s 712(3) the payment was lawfully made by the company out of distributable profits` IS TRUE

#ASSERT `s 712(2) the profits of the company before the reductions` 10000 EQUALS 10000
-- accounts as at 1 January 2026; the relevant period ends on 31 March 2026: the payments of 1,000 and 500 count; the payment on the date of the accounts and the one on the last day of the period do not (not "after" and not "before"); the unlawful one does not
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a distribution on 15 February`, `fixture: financial assistance on 20 February`) EQUALS JUST 8500
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a distribution on 15 February`, `fixture: financial assistance on 20 February`, `fixture: a payment on the date of the accounts`, `fixture: a payment on the last day of the period`, `fixture: an unlawful payment`) EQUALS JUST 8500
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a distribution on 15 February`, `fixture: a purchase payment`, `fixture: a section 705 payment`) EQUALS JUST 8900
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) EMPTY EQUALS JUST 10000
-- a payment of a kind the text does not decide is NOTHING when it falls in the period, and is ignored when it does not
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a payment of another kind in the period`) EQUALS NOTHING
#ASSERT `s 712(3) the amount after the reduction` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a payment of another kind outside the period`) EQUALS JUST 10000
#ASSERT `s 712(4) the payment is an other relevant payment lawfully made` `fixture: financial assistance on 20 February` EQUALS JUST TRUE
#ASSERT `s 712(4) the payment is an other relevant payment lawfully made` `fixture: a purchase payment` EQUALS JUST TRUE
#ASSERT `s 712(4) the payment is an other relevant payment lawfully made` `fixture: a section 705 payment` EQUALS JUST TRUE
#ASSERT `s 712(4) the payment is an other relevant payment lawfully made` `fixture: a distribution on 15 February` EQUALS JUST FALSE
#ASSERT `s 712(4) the payment is an other relevant payment lawfully made` `fixture: a payment of another kind in the period` EQUALS NOTHING
#ASSERT `s 712(5) the amount of the available profits` (JUST 8500) EQUALS JUST 8500
#ASSERT `s 712(5) the amount of the available profits` NOTHING EQUALS NOTHING
#ASSERT `s 711(2) the available profits of the company for the purposes of Chapter 5` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a distribution on 15 February`, `fixture: financial assistance on 20 February`) EQUALS JUST 8500
#ASSERT `s 711(2) the available profits of the company for the purposes of Chapter 5` 10000 (Date 1 1 2026) (Date 31 3 2026) (LIST `fixture: a payment of another kind in the period`) EQUALS NOTHING
-- the relevant period: three months ending with the date of the statement
#ASSERT `s 712(7) the first day of the relevant period` (Date 15 6 2026) EQUALS Date 16 3 2026
#ASSERT `s 712(7) the first day of the relevant period` (Date 31 5 2026) EQUALS Date 1 3 2026
#ASSERT `s 712(6) the accounts are the relevant accounts` (Date 16 3 2026) (Date 16 3 2026) (Date 15 6 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 712(6) the accounts are the relevant accounts` (Date 15 6 2026) (Date 16 3 2026) (Date 15 6 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 712(6) the accounts are the relevant accounts` (Date 15 3 2026) (Date 16 3 2026) (Date 15 6 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 712(6) the accounts are the relevant accounts` (Date 16 6 2026) (Date 16 3 2026) (Date 15 6 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 712(6) the accounts are the relevant accounts` (Date 1 5 2026) (Date 16 3 2026) (Date 15 6 2026) FALSE EQUALS JUST FALSE

