#ASSERT `s 713(1) the payment out of capital is not lawful` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 713(1) the payment out of capital is not lawful` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 713(1) the payment out of capital is not lawful` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 713(1) the payment out of capital is not lawful` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 713(1) the payment out of capital is not lawful` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
