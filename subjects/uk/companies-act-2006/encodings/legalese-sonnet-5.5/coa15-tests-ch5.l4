#ASSERT `s 714(3) the statement states what the subsection requires` (`fixture: a statement` 500 TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(3) the statement states what the subsection requires` (`fixture: a statement` 500 TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(4) the directors took into account the liabilities the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 714(4) the directors took into account the liabilities the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(5) the statement is in the form and contains the information the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 714(5) the statement is in the form and contains the information the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(5) the statement is in the form and contains the information the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(6) the statement has annexed to it the report the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 714(6) the statement has annexed to it the report the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(6) the statement has annexed to it the report the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(6) the statement has annexed to it the report the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 714(6) the statement has annexed to it the report the subsection requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- the whole of section 714 together: the statement specifies 500 and 500 is the amount section 710 gives
#ASSERT `s 714 the statement and report contain everything section 714 requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) 500 EQUALS JUST TRUE
#ASSERT `s 714 the statement and report contain everything section 714 requires` (`fixture: a statement` 501 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) 500 EQUALS JUST FALSE
#ASSERT `s 714 the statement and report contain everything section 714 requires` (`fixture: a statement` 500 FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) 500 EQUALS JUST FALSE
#ASSERT `s 714 the statement and report contain everything section 714 requires` (`fixture: a statement` 500 TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) 500 EQUALS JUST FALSE
#ASSERT `s 714 the statement and report contain everything section 714 requires` (`fixture: a statement` 500 TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE) 500 EQUALS JUST FALSE
-- expect: FULFILLED
#TRACE `s 714(1) the directors must make a statement` AT 0 WITH
    PARTY Director DOES `s 714(1) make a statement in accordance with section 714` AT 3
-- (the text states no period for the statement itself: the duty stands until it is done)
-- expect: RESIDUAL
#TRACE `s 714(1) the directors must make a statement` AT 0 WITH
    (WAITUNTIL 30)

