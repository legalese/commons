IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch2`

-- coa15-tests-ch2.l4: tests of coa15-ch2.l4 (ss 677 to 683). Expected values are written from the text before the run.

-- ---- s 677 ---------------------------------------------------------------------------------------------

-- arguments: form, net assets reduced to a material extent, the net assets as s 677(2) works them out
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(a) a gift` FALSE 100 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(b)(i) a guarantee, security or indemnity` FALSE 100 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(b)(ii) a release or waiver` FALSE 100 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(c)(i) a loan, or another agreement under which any of the obligations of the person giving the assistance are to be fulfilled at a time when any obligation of another party remains unfulfilled` FALSE 100 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(c)(ii) a novation of, or an assignment of rights arising under, a loan or such other agreement` FALSE 100 EQUALS JUST TRUE
-- an indemnity for the indemnifier's own neglect is outside (b)(i): only paragraph (d) can catch it
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(b)(i) an indemnity in respect of the indemnifier's own neglect or default` FALSE 100 EQUALS JUST FALSE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(b)(i) an indemnity in respect of the indemnifier's own neglect or default` TRUE 100 EQUALS JUST TRUE
-- paragraph (d): any other assistance is financial assistance only if net assets are materially reduced or the company has no net assets
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(d) any other financial assistance` TRUE 100 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(d) any other financial assistance` FALSE 100 EQUALS JUST FALSE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(d) any other financial assistance` FALSE 0 EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(d) any other financial assistance` FALSE (0 MINUS 5) EQUALS JUST TRUE
#ASSERT `s 677(1) the assistance given by the company is financial assistance` `s 677(1)(d) any other financial assistance` FALSE 1 EQUALS JUST FALSE

#ASSERT `s 677(2) the net assets of the company` 500 200 EQUALS 300
#ASSERT `s 677(2) the net assets of the company` 200 500 EQUALS 0 MINUS 300
-- liabilities include Companies Act provisions of the kind specified under s 396 and, for IAS accounts, any provision made
#ASSERT `s 677(3) the aggregate amount of the company's liabilities` 1000 TRUE 50 FALSE 70 EQUALS 1050
#ASSERT `s 677(3) the aggregate amount of the company's liabilities` 1000 FALSE 50 TRUE 70 EQUALS 1070
#ASSERT `s 677(3) the aggregate amount of the company's liabilities` 1000 FALSE 50 FALSE 70 EQUALS 1000

-- ---- ss 678 and 679 ------------------------------------------------------------------------------------

-- arguments of s 678(1): a person is acquiring shares in a public company, who gives, financial assistance?, for the purpose, before or at the same time
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) a company that is a subsidiary of that company` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) another company` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` FALSE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
-- assistance given after the acquisition is not within subsection (1) (subsection (3) deals with it)
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) the company whose shares are acquired` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 678(1) it is not lawful for the company to give the financial assistance` TRUE `s 678(1) the company whose shares are acquired` NOTHING TRUE TRUE EQUALS NOTHING
-- expect: BREACH
#TRACE `s 678(1) the company shant give the financial assistance` AT 0 WITH
    PARTY Company DOES `s 678(1) give financial assistance directly or indirectly for the purpose of an acquisition of shares` AT 3
-- expect: RESIDUAL
#TRACE `s 678(1) the company shant give the financial assistance` AT 0 WITH
    (WAITUNTIL 9)

-- exceptions of s 678(2): principal purpose not the acquisition, or only an incidental part of a larger purpose, and good faith
#ASSERT `s 678(2) subsection (1) does not prohibit the assistance` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 678(2) subsection (1) does not prohibit the assistance` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(2) subsection (1) does not prohibit the assistance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 678(2) subsection (1) does not prohibit the assistance` FALSE FALSE TRUE EQUALS JUST FALSE

-- s 678(3): a person has acquired shares, a liability was incurred, who gives, financial assistance?, for the purpose of reducing the liability, public company at the time
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) a company that is a subsidiary of that company` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) another company` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` FALSE TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE FALSE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
-- the company in which the shares were acquired is no longer a public company when the assistance is given
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) the company whose shares are acquired` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 678(3) it is not lawful for the company to give the financial assistance to reduce or discharge the liability` TRUE TRUE `s 678(1) the company whose shares are acquired` NOTHING TRUE TRUE EQUALS NOTHING
-- expect: BREACH
#TRACE `s 678(3) the company shant give the financial assistance to reduce or discharge the liability` AT 0 WITH
    PARTY Company DOES `s 678(3) give financial assistance directly or indirectly for the purpose of reducing or discharging a liability incurred for an acquisition of shares` AT 3
#ASSERT `s 678(4) subsection (3) does not prohibit the assistance` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 678(4) subsection (3) does not prohibit the assistance` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 678(4) subsection (3) does not prohibit the assistance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 678(4) subsection (3) does not prohibit the assistance` FALSE FALSE TRUE EQUALS JUST FALSE

-- s 678(5): subject to ss 681 and 682. arguments: the prohibition, the (2)/(4) exception, s 681, s 682
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 678(5) the assistance is prohibited by section 678 as it has effect subject to sections 681 and 682` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE

-- s 679(1): a person is acquiring shares in a private company, the giver is a public company subsidiary, financial assistance?, for the purpose, before or at the same time
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` TRUE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` TRUE FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` FALSE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` TRUE TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` TRUE TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 679(1) it is not lawful for the public company to give the financial assistance` TRUE TRUE NOTHING TRUE TRUE EQUALS NOTHING
-- expect: BREACH
#TRACE `s 679(1) the public company shant give the financial assistance` AT 0 WITH
    PARTY Company DOES `s 679(1) give financial assistance directly or indirectly for the purpose of an acquisition of shares in its private holding company` AT 1
#ASSERT `s 679(2) subsection (1) does not prohibit the assistance` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 679(2) subsection (1) does not prohibit the assistance` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 679(2) subsection (1) does not prohibit the assistance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 679(2) subsection (1) does not prohibit the assistance` FALSE FALSE TRUE EQUALS JUST FALSE
-- s 679(3): a person has acquired shares in a private company, a liability was incurred, the giver is a public company subsidiary, financial assistance?, for the purpose of reducing the liability
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` TRUE TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` FALSE TRUE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` TRUE FALSE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` TRUE TRUE FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` TRUE TRUE TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 679(3) it is not lawful for the public company to give the financial assistance to reduce or discharge the liability` TRUE TRUE TRUE NOTHING TRUE EQUALS NOTHING
-- expect: BREACH
#TRACE `s 679(3) the public company shant give the financial assistance to reduce or discharge the liability` AT 0 WITH
    PARTY Company DOES `s 679(3) give financial assistance directly or indirectly for the purpose of reducing or discharging a liability incurred for an acquisition of shares in its private holding company` AT 1
#ASSERT `s 679(4) subsection (3) does not prohibit the assistance` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 679(4) subsection (3) does not prohibit the assistance` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 679(4) subsection (3) does not prohibit the assistance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 679(4) subsection (3) does not prohibit the assistance` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 679(5) the assistance is prohibited by section 679 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 679(5) the assistance is prohibited by section 679 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 679(5) the assistance is prohibited by section 679 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 679(5) the assistance is prohibited by section 679 as it has effect subject to sections 681 and 682` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
