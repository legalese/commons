-- ---- s 680 ---------------------------------------------------------------------------------------------

#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) the company` NOTHING EQUALS JUST TRUE
#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) an officer of the company` NOTHING EQUALS NOTHING
#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) a director of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 680(1) the person commits an offence` TRUE `s 658(2) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 680(1) the person commits an offence` FALSE `s 658(2) the company` NOTHING EQUALS JUST FALSE
-- s 680(2): the same penalties as s 658(3)
#ASSERT `s 680(2) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 680(2) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 680(2) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 680(2) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 680(2) the penalty on conviction` `on summary conviction` EQUALS NOTHING

