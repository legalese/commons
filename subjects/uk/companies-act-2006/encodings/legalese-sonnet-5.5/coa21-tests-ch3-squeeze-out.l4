-- s 980(1): the prescribed manner.
#ASSERT `s 980(1) the notice was given in the prescribed manner` TRUE EQUALS JUST TRUE
#ASSERT `s 980(1) the notice was given in the prescribed manner` FALSE EQUALS JUST FALSE
-- s 980(3): subsection (3) applies where the time for acceptance is not governed by rules made under paragraph 13 or 14 of Schedule 1C.
#ASSERT `s 980(3) this subsection applies to the offer` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 980(3) this subsection applies to the offer` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 980(3) this subsection applies to the offer` NOTHING EQUALS NOTHING
-- s 980(2)(a): three months beginning with the day after the last day for acceptance (31 March: the period begins 1 April and ends 30 June; 30 November: ends 29 February 2028; 30 January: the corresponding date is missing, so it ends on the last day of April).
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 31 3 2027) EQUALS Date 30 6 2027
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 30 11 2027) EQUALS Date 29 2 2028
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 30 1 2027) EQUALS Date 30 4 2027
-- s 980(2)(b): six months beginning with the date of the offer (15 March: ends 14 September).
#ASSERT `s 980(2)(b) the last day of the six-month period` (Date 15 3 2027) EQUALS Date 14 9 2027
-- s 980(2): the last day for a notice: the six-month period only where it ends earlier and subsection (3) applies.
#ASSERT `s 980(2) the last day on which a notice may be given` (Date 30 6 2027) (Date 1 1 2027) (JUST TRUE) EQUALS JUST (Date 30 6 2027)
#ASSERT `s 980(2) the last day on which a notice may be given` (Date 30 6 2027) (Date 1 1 2027) (JUST FALSE) EQUALS JUST (Date 30 9 2027)
#ASSERT `s 980(2) the last day on which a notice may be given` (Date 31 3 2027) (Date 15 1 2027) (JUST TRUE) EQUALS JUST (Date 30 6 2027)
#ASSERT `s 980(2) the last day on which a notice may be given` (Date 31 3 2027) (Date 15 1 2027) NOTHING EQUALS NOTHING
#ASSERT `s 980(2) the notice is given in time` (Date 30 6 2027) (JUST (Date 30 6 2027)) EQUALS JUST TRUE
#ASSERT `s 980(2) the notice is given in time` (Date 1 7 2027) (JUST (Date 30 6 2027)) EQUALS JUST FALSE
#ASSERT `s 980(2) the notice is given in time` (Date 29 6 2027) (JUST (Date 30 6 2027)) EQUALS JUST TRUE
#ASSERT `s 980(2) the notice is given in time` (Date 29 6 2027) NOTHING EQUALS NOTHING
