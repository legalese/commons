#ASSERT `s 981(6) the offeror has done what the subsection requires` (JUST FALSE) FALSE FALSE EQUALS NOTHING
-- s 981(6) as a regulative rule: done at the moment the six weeks end is in time; one tick later is a breach.
#TRACE `s 981(6) the offeror's duty to send a copy of the notice and pay the company` AT 0 WITH
    PARTY `s 981 the offeror` DOES `s 981(6) send a copy of the notice to the company and pay or transfer the consideration to it` AT 0

#TRACE `s 981(6) the offeror's duty to send a copy of the notice and pay the company` AT 0 WITH
    (WAITUNTIL 1)
-- s 981(7), (8), (9).
#ASSERT `s 981(7) the company must register the offeror as the holder of the shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 981(7) the company must register the offeror as the holder of the shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 981(7) the company must register the offeror as the holder of the shares` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 981(8) the company must issue the offeror with warrants and those already in issue become void` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 981(8) the company must issue the offeror with warrants and those already in issue become void` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 981(8) the company must issue the offeror with warrants and those already in issue become void` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 981(9) the company holds the consideration on trust for the person who was entitled to the shares` TRUE EQUALS JUST TRUE
#ASSERT `s 981(9) the company holds the consideration on trust for the person who was entitled to the shares` FALSE EQUALS NOTHING

-- s 982(3): a bank account complies if it bears interest at an appropriate rate and can be withdrawn by appropriate notice.
#ASSERT `s 982(3) the bank account complies with the subsection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 982(3) the bank account complies with the subsection` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 982(3) the bank account complies with the subsection` FALSE TRUE EQUALS JUST FALSE
-- s 982(2).
#ASSERT `s 982(2) the company has paid into the account as the subsection requires` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 982(2) the company has paid into the account as the subsection requires` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 982(2) the company has paid into the account as the subsection requires` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 982(2) the company has paid into the account as the subsection requires` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
-- s 982(5): reasonable enquiries and twelve years since receipt (boundary: the twelfth anniversary), or the company is wound up.
#ASSERT `s 982(5) this subsection applies` TRUE (Date 10 3 2027) (Date 10 3 2039) FALSE EQUALS JUST TRUE
#ASSERT `s 982(5) this subsection applies` TRUE (Date 10 3 2027) (Date 9 3 2039) FALSE EQUALS JUST FALSE
#ASSERT `s 982(5) this subsection applies` TRUE (Date 10 3 2027) (Date 9 3 2030) TRUE EQUALS JUST TRUE
#ASSERT `s 982(5) this subsection applies` FALSE (Date 10 3 2027) (Date 10 3 2040) FALSE EQUALS JUST FALSE
-- s 982(4): pay into court (not for a Scottish company); s 982(7) and (8): for a Scottish company.
#ASSERT `s 982(4) the consideration must be paid into court` TRUE (JUST TRUE) `England and Wales` EQUALS JUST TRUE
#ASSERT `s 982(4) the consideration must be paid into court` TRUE (JUST TRUE) `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 982(4) the consideration must be paid into court` FALSE (JUST TRUE) `England and Wales` EQUALS JUST FALSE
#ASSERT `s 982(4) the consideration must be paid into court` TRUE (JUST FALSE) `England and Wales` EQUALS JUST FALSE
#ASSERT `s 982(4) the consideration must be paid into court` TRUE (JUST TRUE) `Scotland` EQUALS NOTHING
#ASSERT `s 982(7) the trust terminates and the sum must be deposited in the name of the Accountant of Court` TRUE (JUST TRUE) `Scotland` EQUALS JUST TRUE
#ASSERT `s 982(7) the trust terminates and the sum must be deposited in the name of the Accountant of Court` TRUE (JUST TRUE) `England and Wales` EQUALS NOTHING
#ASSERT `s 982(7) the trust terminates and the sum must be deposited in the name of the Accountant of Court` FALSE (JUST TRUE) `Scotland` EQUALS NOTHING
#ASSERT `s 982(7) the trust terminates and the sum must be deposited in the name of the Accountant of Court` TRUE (JUST FALSE) `Scotland` EQUALS NOTHING
#ASSERT `s 982(8) section 150 of the Bankruptcy (Scotland) Act 2016 applies to the sum` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 982(8) section 150 of the Bankruptcy (Scotland) Act 2016 applies to the sum` NOTHING EQUALS NOTHING
#ASSERT `s 982(9) the expenses may be paid out of the money or other property held on trust` TRUE EQUALS JUST TRUE
#ASSERT `s 982(9) the expenses may be paid out of the money or other property held on trust` FALSE EQUALS NOTHING

-- Counting "three months beginning with the day after the last day on which the offer can be accepted" (s 980(2)(a); fork F3): the period ends the day before the corresponding date, or on the last day of the month where that month has no such date.
-- Each date below is worked from the calendar, not from the code: a year end, a month end, a leap February and an ordinary one.
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 31 12 2027) EQUALS Date 31 3 2028
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 29 11 2027) EQUALS Date 29 2 2028
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 31 8 2027) EQUALS Date 30 11 2027
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 28 2 2027) EQUALS Date 31 5 2027
#ASSERT `s 980(2)(a) the last day of the three-month period` (Date 29 11 2026) EQUALS Date 28 2 2027
-- "six months beginning with the date of the offer" (s 980(2)(b)): 31 August 2027 has no corresponding date in February 2028, so the period ends on 29 February 2028; 15 March 2027 ends on 14 September 2027.
#ASSERT `s 980(2)(b) the last day of the six-month period` (Date 31 8 2027) EQUALS Date 29 2 2028
#ASSERT `s 980(2)(b) the last day of the six-month period` (Date 15 3 2027) EQUALS Date 14 9 2027
#ASSERT `s 980(2)(b) the last day of the six-month period` (Date 31 8 2026) EQUALS Date 28 2 2027
