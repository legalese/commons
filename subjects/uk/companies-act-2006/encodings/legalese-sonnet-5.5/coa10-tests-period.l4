IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-period`

-- coa10-tests-period.l4: tests for coa10-period.l4 (ss 442 and 443). Every expected value was written down from the
-- text of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 443(1): when the section applies (line 5928) ----
#ASSERT `s 443(1) section 443 applies to the period for filing` TRUE EQUALS JUST TRUE
#ASSERT `s 443(1) section 443 applies to the period for filing` FALSE EQUALS NOTHING

-- ---- s 443(5): "the month that is the specified number of months after the month in which the specified date ... falls" (line 5935) ----
#ASSERT `s 443(5) the appropriate month` (Date 15 11 2025) 3 EQUALS 2
#ASSERT `s 443(5) the year of the appropriate month` (Date 15 11 2025) 3 EQUALS 2026
#ASSERT `s 443(5) the appropriate month` (Date 15 11 2025) 14 EQUALS 1
#ASSERT `s 443(5) the year of the appropriate month` (Date 15 11 2025) 14 EQUALS 2027
#ASSERT `s 443(5) the appropriate month` (Date 31 12 2025) 9 EQUALS 9
#ASSERT `s 443(5) the year of the appropriate month` (Date 31 12 2025) 9 EQUALS 2026
#ASSERT `s 443(5) the appropriate month` (Date 15 1 2025) 0 EQUALS 1
#ASSERT `s 443(5) the year of the appropriate month` (Date 15 12 2025) 1 EQUALS 2026
#ASSERT `s 443(5) the appropriate month` (Date 15 12 2025) 1 EQUALS 1

-- ---- s 443(3): "the last day of a month" (line 5930) ----
#ASSERT `s 443(3) the specified date is the last day of a month` (Date 30 4 2025)
#ASSERT NOT `s 443(3) the specified date is the last day of a month` (Date 29 4 2025)
#ASSERT `s 443(3) the specified date is the last day of a month` (Date 28 2 2025)
#ASSERT NOT `s 443(3) the specified date is the last day of a month` (Date 28 2 2024)
#ASSERT `s 443(3) the specified date is the last day of a month` (Date 29 2 2024)
#ASSERT `s 443(3) the specified date is the last day of a month` (Date 31 1 2025)
#ASSERT NOT `s 443(3) the specified date is the last day of a month` (Date 30 1 2025)

-- ---- s 443(4): "not the last day of a month but is the 29th or 30th", and the appropriate month is February (lines 5931-5934) ----
#ASSERT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 29 1 2025) 1
#ASSERT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 30 1 2025) 1
#ASSERT NOT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 28 1 2025) 1
#ASSERT NOT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 29 1 2025) 2
#ASSERT NOT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 31 1 2025) 1
#ASSERT NOT `s 443(4) the specified date is the 29th or 30th but not the last day of a month and the appropriate month is February` (Date 29 2 2024) 12

-- ---- s 443(2) with (3) and (4): the date the period ends with (lines 5929-5934) ----
-- (2): the corresponding date.
#ASSERT `s 443(2) the period ends with` (Date 15 3 2025) 9 EQUALS Date 15 12 2025
#ASSERT `s 443(2) the period ends with` (Date 15 5 2025) 9 EQUALS Date 15 2 2026
#ASSERT `s 443(2) the period ends with` (Date 28 1 2024) 1 EQUALS Date 28 2 2024
-- (3): the last day of the appropriate month, "whether or not that is the corresponding date".
#ASSERT `s 443(2) the period ends with` (Date 30 4 2025) 9 EQUALS Date 31 1 2026
#ASSERT `s 443(2) the period ends with` (Date 28 2 2025) 9 EQUALS Date 30 11 2025
#ASSERT `s 443(2) the period ends with` (Date 30 6 2025) 6 EQUALS Date 31 12 2025
#ASSERT `s 443(2) the period ends with` (Date 31 12 2025) 9 EQUALS Date 30 9 2026
#ASSERT `s 443(2) the period ends with` (Date 31 12 2025) 6 EQUALS Date 30 6 2026
#ASSERT `s 443(2) the period ends with` (Date 29 2 2024) 12 EQUALS Date 28 2 2025
#ASSERT `s 443(2) the period ends with` (Date 31 8 2025) 6 EQUALS Date 28 2 2026
-- (4): the 29th or 30th and the appropriate month is February: the last day of February.
#ASSERT `s 443(2) the period ends with` (Date 29 1 2025) 1 EQUALS Date 28 2 2025
#ASSERT `s 443(2) the period ends with` (Date 30 1 2024) 1 EQUALS Date 29 2 2024
#ASSERT `s 443(2) the period ends with` (Date 30 11 2025) 3 EQUALS Date 28 2 2026
#ASSERT `s 443(2) the period ends with` (Date 29 8 2025) 6 EQUALS Date 28 2 2026
-- A 29th that is NOT in a February month gets the corresponding date, not the end of the month.
#ASSERT `s 443(2) the period ends with` (Date 29 3 2025) 1 EQUALS Date 29 4 2025
#ASSERT `s 443(2) the period ends with` (Date 30 3 2025) 1 EQUALS Date 30 4 2025
-- The year carries.
#ASSERT `s 443(2) the period ends with` (Date 15 11 2025) 14 EQUALS Date 15 1 2027

-- ---- s 442(6): status immediately before the end of the accounting reference period decides (line 5925) ----
#ASSERT `s 442(6) the period for a public company applies` FALSE TRUE EQUALS FALSE
#ASSERT `s 442(6) the period for a public company applies` TRUE FALSE EQUALS TRUE

-- ---- s 442(7): the relevant accounting reference period (line 5926) ----
#ASSERT `s 442(7) the accounting reference period is the relevant accounting reference period` TRUE EQUALS JUST TRUE
#ASSERT `s 442(7) the accounting reference period is the relevant accounting reference period` FALSE EQUALS JUST FALSE

-- ---- s 442(2): nine months for a private company, six for a public company (lines 5911-5913) ----
#ASSERT `s 442(2) the period for filing ends on` (Date 31 12 2025) FALSE EQUALS Date 30 9 2026
#ASSERT `s 442(2) the period for filing ends on` (Date 31 12 2025) TRUE EQUALS Date 30 6 2026
#ASSERT `s 442(2) the period for filing ends on` (Date 30 4 2025) FALSE EQUALS Date 31 1 2026
#ASSERT `s 442(2) the period for filing ends on` (Date 15 3 2025) FALSE EQUALS Date 15 12 2025
#ASSERT `s 442(2) the period for filing ends on` (Date 31 8 2025) TRUE EQUALS Date 28 2 2026
#ASSERT `s 442(2) the period for filing ends on` (Date 30 6 2025) TRUE EQUALS Date 31 12 2025

-- ---- s 442(3): a first accounting reference period of more than twelve months (lines 5915-5918) ----
-- "more than twelve months": twelve months exactly is not more.
#ASSERT NOT `s 442(3) the relevant accounting reference period is a period of more than twelve months` (Date 1 1 2025) (Date 31 12 2025)
#ASSERT `s 442(3) the relevant accounting reference period is a period of more than twelve months` (Date 1 1 2025) (Date 1 1 2026)
#ASSERT NOT `s 442(3) the relevant accounting reference period is a period of more than twelve months` (Date 15 1 2025) (Date 14 1 2026)
#ASSERT `s 442(3) the relevant accounting reference period is a period of more than twelve months` (Date 15 1 2025) (Date 15 1 2026)
#ASSERT `s 442(3) the relevant accounting reference period is a period of more than twelve months` (Date 10 1 2024) (Date 31 1 2025)
-- incorporated 10 Jan 2024, first period to 31 Jan 2025. Private: (a) nine months from the first anniversary (10 Jan 2025) is 10 Oct 2025; (b) three months after 31 Jan 2025 (the last day of a month) is 30 Apr 2025; the later is 10 Oct 2025.
#ASSERT `s 442(3) the period for filing ends on for a first accounting reference period of more than twelve months` (Date 10 1 2024) (Date 31 1 2025) FALSE EQUALS Date 10 10 2025
-- Public: (a) six months from 10 Jan 2025 is 10 Jul 2025; (b) is 30 Apr 2025; the later is 10 Jul 2025.
#ASSERT `s 442(3) the period for filing ends on for a first accounting reference period of more than twelve months` (Date 10 1 2024) (Date 31 1 2025) TRUE EQUALS Date 10 7 2025
-- incorporated 1 Mar 2024, first period to 31 Jul 2025 (17 months). Public: (a) is 1 Sep 2025; (b) three months after 31 Jul 2025 is 31 Oct 2025: (b) is later.
#ASSERT `s 442(3) the period for filing ends on for a first accounting reference period of more than twelve months` (Date 1 3 2024) (Date 31 7 2025) TRUE EQUALS Date 31 10 2025

-- ---- s 442(4): an accounting reference period shortened by a notice under section 392 (lines 5919-5922) ----
-- Base 30 Sep 2026. Notice 1 Jul 2026: three months from the notice is 1 Oct 2026, which expires last.
#ASSERT `s 442(4) the period for filing ends on where the accounting reference period is treated as shortened` (Date 30 9 2026) TRUE (Date 1 7 2026) EQUALS Date 1 10 2026
-- Notice 15 Jun 2026: three months from the notice is 15 Sep 2026; the base expires last.
#ASSERT `s 442(4) the period for filing ends on where the accounting reference period is treated as shortened` (Date 30 9 2026) TRUE (Date 15 6 2026) EQUALS Date 30 9 2026
-- Not shortened: the base stands whatever the date given.
#ASSERT `s 442(4) the period for filing ends on where the accounting reference period is treated as shortened` (Date 30 9 2026) FALSE (Date 1 7 2026) EQUALS Date 30 9 2026

-- ---- s 442(5): the Secretary of State may extend, on an application made before the expiry (line 5923) ----
#ASSERT `s 442(5) the Secretary of State may extend the period for filing` (Date 30 9 2026) (Date 30 9 2026) TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 442(5) the Secretary of State may extend the period for filing` (Date 30 9 2026) (Date 1 9 2026) FALSE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F18)
#ASSERT `s 442(5) the Secretary of State may extend the period for filing` (Date 30 9 2026) (Date 1 9 2026) FALSE EQUALS NOTHING
#ASSERT `s 442(5) the Secretary of State may extend the period for filing` (Date 30 9 2026) (Date 1 10 2026) TRUE EQUALS NOTHING

-- ---- s 442(5A): not more than twelve months after the end of the accounting reference period (line 5924) ----
-- Accounting reference period ending 31 Dec 2025: the limit is 31 Dec 2026.
#ASSERT `s 442(5A) the extension complies with the limit of twelve months after the end of the accounting reference period` (Date 31 12 2025) (Date 31 12 2026) EQUALS JUST TRUE
#ASSERT `s 442(5A) the extension complies with the limit of twelve months after the end of the accounting reference period` (Date 31 12 2025) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 442(5A) the period for filing ends on after any extension` (Date 30 9 2026) (Date 31 12 2025) FALSE (Date 1 1 2027) EQUALS JUST (Date 30 9 2026)
#ASSERT `s 442(5A) the period for filing ends on after any extension` (Date 30 9 2026) (Date 31 12 2025) TRUE (Date 30 11 2026) EQUALS JUST (Date 30 11 2026)
#ASSERT `s 442(5A) the period for filing ends on after any extension` (Date 30 9 2026) (Date 31 12 2025) TRUE (Date 1 1 2027) EQUALS NOTHING

-- ---- s 442(1): the whole section, from one record ----
`s 442 fixture an ordinary private company` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS FALSE
    `s 442 the date of the company's incorporation` IS Date 5 6 2010
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS FALSE
    `s 442 the date to which the notice extends the period for filing` IS Date 1 1 2025

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture an ordinary private company` EQUALS JUST (Date 30 9 2026)
-- 31 Dec 2025 to 30 Sep 2026: 31+28+31+30+31+30+31+31+30 = 273 days.
#ASSERT `s 442(1) the number of days from the end of the accounting reference period to the end of the period for filing` `s 442 fixture an ordinary private company` EQUALS JUST 273

`s 442 fixture an ordinary public company` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS FALSE
    `s 442 the date of the company's incorporation` IS Date 5 6 2010
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS TRUE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS FALSE
    `s 442 the date to which the notice extends the period for filing` IS Date 1 1 2025

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture an ordinary public company` EQUALS JUST (Date 30 6 2026)

`s 442 fixture a first long period` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 10 1 2024
    `s 442 the end of the relevant accounting reference period` IS Date 31 1 2025
    `s 442 the relevant accounting reference period is the company's first` IS TRUE
    `s 442 the date of the company's incorporation` IS Date 10 1 2024
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS FALSE
    `s 442 the date to which the notice extends the period for filing` IS Date 1 1 2025

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture a first long period` EQUALS JUST (Date 10 10 2025)

-- A first period of exactly twelve months is not "more than twelve months", so (2) applies: nine months after 31 Dec 2025.
`s 442 fixture a first period of twelve months` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS TRUE
    `s 442 the date of the company's incorporation` IS Date 1 1 2025
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS FALSE
    `s 442 the date to which the notice extends the period for filing` IS Date 1 1 2025

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture a first period of twelve months` EQUALS JUST (Date 30 9 2026)

`s 442 fixture a shortened period` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS FALSE
    `s 442 the date of the company's incorporation` IS Date 5 6 2010
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS TRUE
    `s 442 the date of the notice under section 392` IS Date 1 7 2026
    `s 442 the Secretary of State has given a notice extending the period for filing` IS FALSE
    `s 442 the date to which the notice extends the period for filing` IS Date 1 1 2025

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture a shortened period` EQUALS JUST (Date 1 10 2026)

`s 442 fixture an extended period` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS FALSE
    `s 442 the date of the company's incorporation` IS Date 5 6 2010
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS TRUE
    `s 442 the date to which the notice extends the period for filing` IS Date 31 12 2026

#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture an extended period` EQUALS JUST (Date 31 12 2026)

`s 442 fixture an extension past the limit` MEANS `s 442 facts about the accounting reference period` WITH
    `s 442 the first day of the relevant accounting reference period` IS Date 1 1 2025
    `s 442 the end of the relevant accounting reference period` IS Date 31 12 2025
    `s 442 the relevant accounting reference period is the company's first` IS FALSE
    `s 442 the date of the company's incorporation` IS Date 5 6 2010
    `s 442 the company was a public company immediately before the end of the relevant accounting reference period` IS FALSE
    `s 442 the period is treated as shortened by virtue of a notice under section 392` IS FALSE
    `s 442 the date of the notice under section 392` IS Date 1 1 2025
    `s 442 the Secretary of State has given a notice extending the period for filing` IS TRUE
    `s 442 the date to which the notice extends the period for filing` IS Date 2 1 2027

-- Not covered: the text does not say what the notice achieves when it passes the limit.
#ASSERT `s 442(1) the period for filing ends on` `s 442 fixture an extension past the limit` EQUALS NOTHING
#ASSERT `s 442(1) the number of days from the end of the accounting reference period to the end of the period for filing` `s 442 fixture an extension past the limit` EQUALS NOTHING
