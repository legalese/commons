IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch7`
IMPORT `coa7-ch5`

-- coa7-tests-ch5.l4: tests for coa7-ch5.l4 (Part 13 Chapter 5, ss 341 to 354).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 5 (ss 341 to 354)`

-- s 341(1): a poll at a general meeting of a quoted company that is not a traded company: four items on a website
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST TRUE) FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST TRUE) FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 341(1) the quoted company has made the information available on a website` (JUST FALSE) FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 341(1) the quoted company has made the information available on a website` NOTHING FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- s 341(1A): a traded company: seven items on a website, abstentions only if counted
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 341(1A) the traded company has made the information available on a website` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 341(1A) the traded company has made the information available on a website` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- s 341(1B): by the end of 16 days beginning with the day of the meeting (1 March: 16 March) or, if later, the end of the first working day after the result is declared
#ASSERT `s 341(1B) the traded company has complied with subsection (1A) in time` (Date 1 3 2026) (Date 10 3 2026) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 341(1B) the traded company has complied with subsection (1A) in time` (Date 1 3 2026) (Date 10 3 2026) (Date 17 3 2026) EQUALS JUST FALSE
#ASSERT `s 341(1B) the traded company has complied with subsection (1A) in time` (Date 1 3 2026) (Date 20 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 341(1B) the traded company has complied with subsection (1A) in time` (Date 1 3 2026) (Date 20 3 2026) (Date 21 3 2026) EQUALS JUST FALSE
#ASSERT `s 341(2) the provision of section 353 applies for the purposes of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 341(2) the provision of section 353 applies for the purposes of this section` FALSE EQUALS NOTHING
#ASSERT `s 341(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 341(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 341(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 341(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 341(4) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 341(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 341(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 341(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 341(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 341(5) the failure affects the validity of the poll or of the resolution or other business to which the poll relates` TRUE EQUALS JUST FALSE
#ASSERT `s 341(5) the failure affects the validity of the poll or of the resolution or other business to which the poll relates` FALSE EQUALS NOTHING
#ASSERT `s 341(6) this section applies to the poll` TRUE EQUALS JUST TRUE
#ASSERT `s 341(6) this section applies to the poll` FALSE EQUALS JUST FALSE

-- s 342(1)
#ASSERT `s 342(1) the members may require the directors to obtain an independent report on a poll` (JUST TRUE) EQUALS JUST TRUE
