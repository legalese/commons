#ASSERT `s 342(3) subsection (2) is satisfied in relation to each poll` FALSE (LIST TRUE) EQUALS JUST FALSE
-- s 342(4): received not later than one week after the date on which the poll is taken (1 March + 7 is 8 March)
#ASSERT `s 342(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 1 3 2026) (Date 8 3 2026) EQUALS JUST TRUE
#ASSERT `s 342(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 342(4) the request meets the requirements of this subsection` TRUE FALSE TRUE (Date 1 3 2026) (Date 8 3 2026) EQUALS JUST FALSE
#ASSERT `s 342(4) the request meets the requirements of this subsection` FALSE TRUE TRUE (Date 1 3 2026) (Date 8 3 2026) EQUALS NOTHING

