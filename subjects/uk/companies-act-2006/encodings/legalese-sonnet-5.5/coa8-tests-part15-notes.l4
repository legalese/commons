IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-notes`

-- Tests of ss 409 to 413 (information to be given in notes to the accounts). Every expected value was written from the text before the run.

-- s 409(4): the directors' opinion (about any of four businesses) and the Secretary of State's agreement
#ASSERT `s 409(4) the conditions for non-disclosure are met` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409(4) the conditions for non-disclosure are met` FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409(4) the conditions for non-disclosure are met` FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409(4) the conditions for non-disclosure are met` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 409(4) the conditions for non-disclosure are met` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 409(4) the conditions for non-disclosure are met` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 409(5) the fact that advantage is taken of the exemption must be stated in a note to the annual accounts` TRUE EQUALS JUST TRUE
#ASSERT `s 409(5) the fact that advantage is taken of the exemption must be stated in a note to the annual accounts` FALSE EQUALS JUST FALSE

-- s 410A(1), (4), (2), (5)
#ASSERT `s 410A(1) the information required by section 410A must be given in the notes to the annual accounts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 410A(1) the information required by section 410A must be given in the notes to the annual accounts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 410A(1) the information required by section 410A must be given in the notes to the annual accounts` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 410A(4) the company need not comply with subsection (2)(b)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 410A(4) the company need not comply with subsection (2)(b)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 410A(4) the company need not comply with subsection (2)(b)` NOTHING EQUALS NOTHING
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(a) the nature and business purpose of the arrangements` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(a) the nature and business purpose of the arrangements` NOTHING TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(a) the nature and business purpose of the arrangements` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(a) the nature and business purpose of the arrangements` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(b) the financial impact of the arrangements on the company` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(b) the financial impact of the arrangements on the company` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(b) the financial impact of the arrangements on the company` (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 410A(2) the item of information must be given in the notes` `s 410A(2)(b) the financial impact of the arrangements on the company` (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 410A(5) the entity whose arrangements are tested in the accounts` TRUE EQUALS `s 410A(5) the undertakings included in the consolidation, as if they were a single company`
#ASSERT `s 410A(5) the entity whose arrangements are tested in the accounts` FALSE EQUALS `s 410A(5) the company`

-- s 411
#ASSERT `s 411(1) the notes must disclose the average number of persons employed by the company in the financial year` TRUE EQUALS JUST TRUE
#ASSERT `s 411(1) the notes must disclose the average number of persons employed by the company in the financial year` FALSE EQUALS NOTHING
#ASSERT `s 411(1A) the notes must also disclose the average number of persons within each category` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 411(1A) the notes must also disclose the average number of persons within each category` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 411(1A) the notes must also disclose the average number of persons within each category` NOTHING EQUALS NOTHING
#ASSERT `s 411(2) the categories are ones the directors may select` TRUE EQUALS JUST TRUE
#ASSERT `s 411(2) the categories are ones the directors may select` FALSE EQUALS NOTHING
#ASSERT `s 411(3) the average number` 120 12 EQUALS JUST 10
#ASSERT `s 411(3) the average number` 125 12 EQUALS JUST (125 DIVIDED BY 12)
#ASSERT `s 411(3) the average number` 60 6 EQUALS JUST 10
#ASSERT `s 411(3) the average number` 60 0 EQUALS NOTHING
#ASSERT `s 411(4)(a) the relevant annual number for subsection (1)` (LIST 10, 12, 11) EQUALS 33
#ASSERT `s 411(4)(a) the relevant annual number for subsection (1)` EMPTY EQUALS 0
#ASSERT `s 411(4)(b) the relevant annual number for subsection (1A)` (LIST 4, 5) EQUALS 9
#ASSERT `s 411(5) the notes or the profit and loss account must disclose the total staff costs` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 411(5) the notes or the profit and loss account must disclose the total staff costs` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 411(5) the notes or the profit and loss account must disclose the total staff costs` NOTHING EQUALS NOTHING
#ASSERT `s 411(5) the total staff costs` 100000 12000 5000 EQUALS 117000
#ASSERT `s 411(6) the cost is a pension cost` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 411(6) the cost is a pension cost` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 411(6) the cost is a pension cost` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 411(6) the cost is a pension cost` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 411(6) the cost is a social security cost` TRUE EQUALS JUST TRUE
#ASSERT `s 411(6) the cost is a social security cost` FALSE EQUALS JUST FALSE
#ASSERT `s 411(7) the entity whose employees and staff costs are counted in the accounts` TRUE EQUALS `s 411(7) the undertakings included in the consolidation, as if they were a single company`
#ASSERT `s 411(7) the entity whose employees and staff costs are counted in the accounts` FALSE EQUALS `s 411(7) the company`

-- s 412(4): connected persons and controlled bodies
#ASSERT `s 412(4) the amount is treated as paid to or receivable by the director` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 412(4) the amount is treated as paid to or receivable by the director` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 412(4) the amount is treated as paid to or receivable by the director` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 412(4) the amount is treated as paid to or receivable by the director` NOTHING (JUST FALSE) EQUALS NOTHING
-- s 412(5): any director, and anyone who was a director at any time in the preceding five years (asked on 15 June 2026: back to 15 June 2021)
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` (JUST TRUE) NOTHING (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` (JUST FALSE) (JUST (Date 15 6 2021)) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` (JUST FALSE) (JUST (Date 14 6 2021)) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` (JUST FALSE) NOTHING (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` NOTHING (JUST (Date 15 6 2021)) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` NOTHING (JUST (Date 14 6 2021)) (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 412(5) the person is under the duty to give notice to the company of such matters relating to himself as regulations require` NOTHING NOTHING (Date 15 6 2026) EQUALS NOTHING
-- s 412(6)
#ASSERT `s 412(6) the person commits an offence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 412(6) the person commits an offence` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 412(6) the person commits an offence` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 412(6) the person commits an offence` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 412(6) the person commits an offence` NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 412(6) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
#ASSERT `s 412(6) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
#ASSERT `s 412(6) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING

-- s 413(1), (2), (3), (4)
#ASSERT `s 413(1) the details must be shown in the notes to the company's individual accounts` TRUE EQUALS JUST TRUE
#ASSERT `s 413(1) the details must be shown in the notes to the company's individual accounts` FALSE EQUALS NOTHING
#ASSERT `s 413(2) the details must be shown in the notes to the group accounts` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 413(2) the details must be shown in the notes to the group accounts` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 413(2) the details must be shown in the notes to the group accounts` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 413(2) the details must be shown in the notes to the group accounts` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 413(3) the details of an advance or credit are given as subsection (3) requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 413(4) the details of a guarantee are given as subsection (4) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 413(4) the details of a guarantee are given as subsection (4) requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 413(4) the details of a guarantee are given as subsection (4) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 413(4) the details of a guarantee are given as subsection (4) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 413(5): totals. Advances: 1000 (200 repaid, 100 written off, 50 waived) and 500; guarantees: 10000 maximum (400 paid) and 5000
#ASSERT `s 413(5) the totals to be stated` (LIST (`s 413 advance or credit` OF 1000, 200, 100, 50), (`s 413 advance or credit` OF 500, 0, 0, 0)) (LIST (`s 413 guarantee` OF 10000, 400), (`s 413 guarantee` OF 5000, 0)) EQUALS `s 413(5) totals` OF 1500, 200, 100, 50, 15000, 400
#ASSERT `s 413(5) the totals to be stated` EMPTY EMPTY EQUALS `s 413(5) totals` OF 0, 0, 0, 0, 0, 0
-- s 413(8): a banking company, or the holding company of a credit institution, need only state (5)(a) and (5)(c)
#ASSERT `s 413(8) the total must be stated` `s 413(5)(a) the total of the amounts stated under subsection (3)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(c) the total of the amounts stated under subsection (4)(b)` TRUE EQUALS JUST TRUE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(b) the total of the amounts stated under subsection (3)(d)` TRUE EQUALS JUST FALSE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(ba) the total of the amounts stated under subsection (3)(e)` TRUE EQUALS JUST FALSE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(bb) the total of the amounts stated under subsection (3)(f)` TRUE EQUALS JUST FALSE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(d) the total of the amounts stated under subsection (4)(c)` TRUE EQUALS JUST FALSE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(b) the total of the amounts stated under subsection (3)(d)` FALSE EQUALS JUST TRUE
#ASSERT `s 413(8) the total must be stated` `s 413(5)(d) the total of the amounts stated under subsection (4)(c)` FALSE EQUALS JUST TRUE
-- s 413(6), (7)
#ASSERT `s 413(6) the person is one of the directors for the purposes of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 413(6) the person is one of the directors for the purposes of this section` FALSE EQUALS JUST FALSE
#ASSERT `s 413(7) the requirements of the section apply to the advance, credit or guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 413(7) the requirements of the section apply to the advance, credit or guarantee` FALSE EQUALS NOTHING
