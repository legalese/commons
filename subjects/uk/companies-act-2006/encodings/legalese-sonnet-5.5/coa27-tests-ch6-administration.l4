IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa27-definitions`
IMPORT `coa27-ch4-register`
IMPORT `coa27-ch6-administration`

-- coa27-tests-ch6-administration.l4: tests for coa27-ch6-administration.l4 (ss 1251 to 1254, 1258, 1259).
-- Expected values are decided from the text and written beside each assertion. Amounts are illustrative INPUTS.

-- ---- s 1251(1): an applicant for a recognition order must pay the fee the Secretary of State prescribes (illustrative 1,500); no application is duly made unless it is paid
#ASSERT `s 1251(1) the fee the applicant must pay in pounds` TRUE 1500 EQUALS JUST 1500
#ASSERT `s 1251(1) the fee the applicant must pay in pounds` FALSE 1500 EQUALS NOTHING
#ASSERT `s 1251(1) the application is duly made` FALSE EQUALS JUST FALSE
-- paying is necessary and the text does not say it is sufficient
#ASSERT `s 1251(1) the application is duly made` TRUE EQUALS NOTHING
#ASSERT `s 1251(3) the fees are to be paid into the Consolidated Fund` TRUE EQUALS JUST TRUE
#ASSERT `s 1251(3) the fees are to be paid into the Consolidated Fund` FALSE EQUALS NOTHING

-- ---- s 1251A: at least once in every calendar year
`s 1251A test reports` MEANS LIST (Date 20 3 2026), (Date 5 11 2027)
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2026 `s 1251A test reports` EQUALS JUST TRUE
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2027 `s 1251A test reports` EQUALS JUST TRUE
-- 2028 has no report: the duty for that year was not met
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2028 `s 1251A test reports` EQUALS JUST FALSE
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2026 (EMPTY) EQUALS JUST FALSE
-- one report on 31 December and one on 1 January are in different calendar years
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2029 (LIST (Date 31 12 2028)) EQUALS JUST FALSE
#ASSERT `s 1251A the Secretary of State has published the report required for the calendar year` 2029 (LIST (Date 1 1 2029)) EQUALS JUST TRUE

-- ---- s 1252(2): the body designated may be either (a) a body corporate established by the order or (b) an existing body, subject to s 1253
#ASSERT `s 1252(2) the body may be designated by a delegation order` `s 1252(2)(a) a body corporate established by the order` NOTHING EQUALS JUST TRUE
#ASSERT `s 1252(2) the body may be designated by a delegation order` `s 1252(2)(b) an existing body` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1252(2) the body may be designated by a delegation order` `s 1252(2)(b) an existing body` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1252(2) the body may be designated by a delegation order` `s 1252(2)(b) an existing body` NOTHING EQUALS NOTHING
#ASSERT `s 1252(2) the body may be designated by a delegation order` `s 1252(2) some other body` (JUST TRUE) EQUALS JUST FALSE
-- (3) designated under s 5 of the Freedom of Information Act 2000
#ASSERT `s 1252(3) the body is designated under section 5 of the Freedom of Information Act 2000` TRUE EQUALS JUST TRUE
#ASSERT `s 1252(3) the body is designated under section 5 of the Freedom of Information Act 2000` FALSE EQUALS NOTHING
-- (4) all functions transferred, except those in relation to the body itself and those under s 1228, and subject to exceptions the order specifies
#ASSERT `s 1252(4) the function is transferred to the designated body` `s 1252(4) another function under this Part` FALSE EQUALS JUST TRUE
#ASSERT `s 1252(4) the function is transferred to the designated body` `s 1252(4) another function under this Part` TRUE EQUALS JUST FALSE
#ASSERT `s 1252(4) the function is transferred to the designated body` `s 1252(4)(b)(i) a function in relation to the body itself` FALSE EQUALS JUST FALSE
#ASSERT `s 1252(4) the function is transferred to the designated body` `s 1252(4)(b)(ii) a function under section 1228 (appointment of Independent Supervisor)` FALSE EQUALS JUST FALSE
#ASSERT `s 1252(4) the function is transferred to the designated body` `s 1252(6)(a) a function under section 1224 (power to call for information from recognised bodies etc)` FALSE EQUALS JUST TRUE
-- (6) concurrent exercise: ss 1224, 1244, 1254
#ASSERT `s 1252(6) the transfer is subject to the reservation that the function remains exercisable concurrently by the Secretary of State` `s 1252(6)(a) a function under section 1224 (power to call for information from recognised bodies etc)` EQUALS JUST TRUE
#ASSERT `s 1252(6) the transfer is subject to the reservation that the function remains exercisable concurrently by the Secretary of State` `s 1252(6)(b) a function under section 1244 (power to call for information from registered third country auditors)` EQUALS JUST TRUE
#ASSERT `s 1252(6) the transfer is subject to the reservation that the function remains exercisable concurrently by the Secretary of State` `s 1252(6)(c) a function under section 1254 (directions to comply with international obligations)` EQUALS JUST TRUE
#ASSERT `s 1252(6) the transfer is subject to the reservation that the function remains exercisable concurrently by the Secretary of State` `s 1252(4) another function under this Part` EQUALS NOTHING
-- (7) exercisable only with the consent of the Secretary of State
#ASSERT `s 1252(7) the transfer is subject to the reservation that the function is exercisable only with the consent of the Secretary of State` `s 1252(7)(a) the function of refusing to make a declaration under section 1221(1) on the grounds referred to in section 1221(4)` EQUALS JUST TRUE
#ASSERT `s 1252(7) the transfer is subject to the reservation that the function is exercisable only with the consent of the Secretary of State` `s 1252(7)(b) the function of withdrawing a declaration under section 1221(7) on those grounds` EQUALS JUST TRUE
#ASSERT `s 1252(7) the transfer is subject to the reservation that the function is exercisable only with the consent of the Secretary of State` `s 1252(6)(a) a function under section 1224 (power to call for information from recognised bodies etc)` EQUALS NOTHING

-- ---- s 1253(3) the conditions: (a) exercised effectively; (b) where the order contains requirements under (4), exercised in accordance with them
#ASSERT `s 1253(3) the conditions are met` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1253(3) the conditions are met` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1253(3) the conditions are met` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1253(3) the conditions are met` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1253(3) the conditions are met` FALSE TRUE TRUE EQUALS JUST FALSE
-- (2) may make the order if it appears to him that (a) and (b)
#ASSERT `s 1253(2) the Secretary of State may make the delegation order designating the existing body` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1253(2) the Secretary of State may make the delegation order designating the existing body` TRUE FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q3)
#ASSERT `s 1253(2) the Secretary of State may make the delegation order designating the existing body` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 1253(2) the Secretary of State may make the delegation order designating the existing body` FALSE TRUE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q3)
#ASSERT `s 1253(2) the Secretary of State may make the delegation order designating the existing body` FALSE TRUE EQUALS NOTHING
-- (5) despite involvement in Schedule 12 arrangements
#ASSERT `s 1253(5) the existing body may be designated and may exercise the functions despite its involvement` TRUE EQUALS JUST TRUE
#ASSERT `s 1253(5) the existing body may be designated and may exercise the functions despite its involvement` FALSE EQUALS NOTHING

-- ---- s 1254(1): a direction to the bodies named, if it appears to the Secretary of State that (a) proposed action would be incompatible or (b) action is required to implement obligations
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(i) a recognised supervisory body` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(ii) a recognised qualifying body` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(iii) a person keeping a register of auditors, or part of such a register, in accordance with regulations under section 1239(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(iv) a body exercising functions under arrangements within Schedule 12` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(v) the Independent Supervisor` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(vi) the competent authority` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(vii) a body designated by order under section 1252` TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(i) a recognised supervisory body` FALSE FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q4)
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1)(a)(i) a recognised supervisory body` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1254(1) the Secretary of State may direct the body not to take or to take the action` `s 1254(1) another body` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1254(2) the direction may include the requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 1254(2) the direction may include the requirement` FALSE EQUALS NOTHING
#ASSERT `s 1254(3) the direction is enforceable by` TRUE TRUE FALSE EQUALS JUST `s 1239(8) an injunction`
#ASSERT `s 1254(3) the direction is enforceable by` TRUE TRUE TRUE EQUALS JUST `s 1239(8) an order under section 45 of the Court of Session Act 1988`
#ASSERT `s 1254(3) the direction is enforceable by` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1254(3) the direction is enforceable by` TRUE FALSE FALSE EQUALS NOTHING

-- ---- s 1258(1): a document to be given to or served on any person other than the Secretary of State
#ASSERT `s 1258(1) this section has effect in relation to the document` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1258(1) this section has effect in relation to the document` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1258(1) this section has effect in relation to the document` FALSE FALSE EQUALS NOTHING
-- (2) methods
#ASSERT `s 1258(2) the document may be given to or served on the person by the method` `s 1258(2)(a) delivering it to him` EQUALS JUST TRUE
#ASSERT `s 1258(2) the document may be given to or served on the person by the method` `s 1258(2)(b) leaving it at his proper address` EQUALS JUST TRUE
#ASSERT `s 1258(2) the document may be given to or served on the person by the method` `s 1258(2)(c) sending it by post to him at that address` EQUALS JUST TRUE
#ASSERT `s 1258(2) the document may be given to or served on the person by the method` `s 1258(2) another method` EQUALS NOTHING
-- (3) on an officer, a partner, a member of the governing body
#ASSERT `s 1258(3) service on the person is service on the recipient` `s 1258(3)(a) a body corporate` TRUE EQUALS JUST TRUE
#ASSERT `s 1258(3) service on the person is service on the recipient` `s 1258(3)(b) a partnership` TRUE EQUALS JUST TRUE
#ASSERT `s 1258(3) service on the person is service on the recipient` `s 1258(3)(c) an unincorporated association other than a partnership` TRUE EQUALS JUST TRUE
#ASSERT `s 1258(3) service on the person is service on the recipient` `s 1258(3)(a) a body corporate` FALSE EQUALS NOTHING
-- (4) proper address: last known address, and also (a), (b), (c)
#ASSERT `s 1258(4) the address is a proper address of the person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1258(4) the address is a proper address of the person` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1258(4) the address is a proper address of the person` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1258(4) the address is a proper address of the person` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1258(4) the address is a proper address of the person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- s 1259
#ASSERT `s 1259(1) this section applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1259(1) this section applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1259(1) this section applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1259(1) this section applies` FALSE TRUE FALSE EQUALS JUST FALSE
-- (2) the transmission has effect as a delivery, but only if the recipient has indicated his willingness
#ASSERT `s 1259(2) the transmission has effect as a delivery of the document to the recipient` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1259(2) the transmission has effect as a delivery of the document to the recipient` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1259(2) the transmission has effect as a delivery of the document to the recipient` FALSE TRUE EQUALS NOTHING
-- (3) the indication: (a) manner, (c) address, (d) other information
#ASSERT `s 1259(3) the indication meets the requirements of subsection (3)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1259(3) the indication meets the requirements of subsection (3)` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1259(3) the indication meets the requirements of subsection (3)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1259(3) the indication meets the requirements of subsection (3)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1259(3)(b) the indication covers the document` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1259(3)(b) the indication covers the document` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1259(3)(b) the indication covers the document` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1259(3)(e) the indication has been modified or withdrawn` TRUE EQUALS JUST TRUE
#ASSERT `s 1259(3)(e) the indication has been modified or withdrawn` FALSE EQUALS NOTHING
#ASSERT `s 1259(4) the network is an electronic communications network` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1259(4) the network is an electronic communications network` NOTHING EQUALS NOTHING
