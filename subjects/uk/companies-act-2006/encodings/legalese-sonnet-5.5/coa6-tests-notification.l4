IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa6-notification-of-changes`

-- coa6-tests-notification.l4: tests of coa6-notification-of-changes.l4 (ss 279G, 279H, 279I).
-- Every expected value was decided by reading the sections (lines 3646-3670 of ukpga-2006-46.txt) before the encoding was run,
-- and is written beside its assertion. The 14-day period counts the first day as day 1, so its last day is the first day plus 13.
-- 2024 is a leap year (29 February 2024 exists).

§ `Tests: ss 279G, 279H and 279I`

-- ---- s 279G(1) and (4) ------------------------------------------------------------------------------------------------------------
-- arguments: the change, the person becomes secretary on the company's incorporation?, the person is named in the s 12 statement?
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE EQUALS JUST TRUE
-- (4): on incorporation and named in the s 12 statement: no notice is required
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` TRUE TRUE EQUALS JUST FALSE
-- on incorporation but NOT named in the statement: (4) does not apply
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` TRUE FALSE EQUALS JUST TRUE
-- named in the statement but becoming secretary later, not on incorporation: (4) does not apply
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE TRUE EQUALS JUST TRUE
-- (1)(b): ceasing to be the secretary needs a notice whatever else is true (subsection (4) is about (1)(a) only)
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` TRUE TRUE EQUALS JUST TRUE
-- no change in the secretaries: the "if" of (1) is not met
#ASSERT `s 279G(1) the company must give notice to the registrar` `s 279G no such change` FALSE FALSE EQUALS JUST FALSE

-- ---- s 279G(2) and (3) -------------------------------------------------------------------------------------------------------------
#ASSERT `s 279G(2) the notice specifies the date` TRUE EQUALS JUST TRUE
#ASSERT `s 279G(2) the notice specifies the date` FALSE EQUALS JUST FALSE
-- (3) arguments: the change, statement of the required information?, statement of consent?
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE EQUALS JUST FALSE
-- a notice of ceasing is not "a notice under subsection (1)(a)"
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 279G(3) the notice under subsection (1)(a) contains the statements required` `s 279G no such change` FALSE FALSE EQUALS NOTHING

-- ---- s 279G(5): the 14 days beginning with the day --------------------------------------------------------------------------------
#ASSERT `s 279G(5) the days in the period` EQUALS 14
-- the person becomes secretary on 1 March 2024: day 1 is 1 March, day 14 is 14 March
#ASSERT `s 279G(5) the last day of the period` (Date 1 3 2024) EQUALS Date 14 3 2024
-- across a leap day: day 1 is 20 February 2024, day 14 is 4 March 2024
#ASSERT `s 279G(5) the last day of the period` (Date 20 2 2024) EQUALS Date 4 3 2024
#ASSERT `s 279G(5) the notice was given within the period` (Date 1 3 2024) (Date 1 3 2024) EQUALS JUST TRUE
#ASSERT `s 279G(5) the notice was given within the period` (Date 1 3 2024) (Date 14 3 2024) EQUALS JUST TRUE
#ASSERT `s 279G(5) the notice was given within the period` (Date 1 3 2024) (Date 15 3 2024) EQUALS JUST FALSE
-- before the period begins is outside the period (fork F-early in NOTES.md)
#ASSERT `s 279G(5) the notice was given within the period` (Date 1 3 2024) (Date 29 2 2024) EQUALS JUST FALSE

-- ---- s 279G: failure to comply ------------------------------------------------------------------------------------------------------
-- arguments: change, on incorporation?, named in s 12 statement?, the day of the change, the notice (if any), the day of the question
-- a complete notice of becoming, on the last day: no failure
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 14 3 2024), TRUE, TRUE, TRUE)) (Date 20 3 2024) EQUALS JUST FALSE
-- one day late
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 15 3 2024), TRUE, TRUE, TRUE)) (Date 20 3 2024) EQUALS JUST TRUE
-- in time but without the date (2)
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 5 3 2024), FALSE, TRUE, TRUE)) (Date 20 3 2024) EQUALS JUST TRUE
-- in time but without the statement of the required information (3)(a)
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 5 3 2024), TRUE, FALSE, TRUE)) (Date 20 3 2024) EQUALS JUST TRUE
-- in time but without the statement of consent (3)(b)
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 5 3 2024), TRUE, TRUE, FALSE)) (Date 20 3 2024) EQUALS JUST TRUE
-- a notice of ceasing needs the date and nothing else
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 5 3 2024), TRUE, FALSE, FALSE)) (Date 20 3 2024) EQUALS JUST FALSE
-- no notice yet: not decided while the period runs, a failure once it has ended
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) NOTHING (Date 14 3 2024) EQUALS NOTHING
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(b) a person ceases to be the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) NOTHING (Date 15 3 2024) EQUALS JUST TRUE
-- the (4) exception: nothing was required, so nothing is failed
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` TRUE TRUE (Date 1 3 2024) NOTHING (Date 30 3 2024) EQUALS JUST FALSE
#ASSERT `s 279G the company has failed to comply with section 279G` `s 279G no such change` FALSE FALSE (Date 1 3 2024) NOTHING (Date 30 3 2024) EQUALS JUST FALSE

-- The duty as a regulative rule: notice on day 13 (the 14th day) fulfils it; on day 14 (the 15th day) it is a breach.
-- (A #TRACE prints its outcome and moves no count; the outcomes are recorded in NOTES.md.)
#TRACE `s 279G(1) and (5) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in the secretaries (s 279G(1))" AT 13
#TRACE `s 279G(1) and (5) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in the secretaries (s 279G(1))" AT 14

-- ---- s 279H -----------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 279H(1) the company must give notice to the registrar of the change` TRUE EQUALS JUST TRUE
-- no change in the required information: the duty is limited to "any change", so the text does not answer
#ASSERT `s 279H(1) the company must give notice to the registrar of the change` FALSE EQUALS NOTHING
#ASSERT `s 279H(2) the notice specifies the date` TRUE EQUALS JUST TRUE
#ASSERT `s 279H(2) the notice specifies the date` FALSE EQUALS JUST FALSE
#ASSERT `s 279H(3) the days in the period` EQUALS 14
-- the change occurs on 31 January 2024: day 14 is 13 February 2024
#ASSERT `s 279H(3) the last day of the period` (Date 31 1 2024) EQUALS Date 13 2 2024
#ASSERT `s 279H(3) the notice was given within the period` (Date 31 1 2024) (Date 13 2 2024) EQUALS JUST TRUE
#ASSERT `s 279H(3) the notice was given within the period` (Date 31 1 2024) (Date 14 2 2024) EQUALS JUST FALSE
#ASSERT `s 279H(3) the notice was given within the period` (Date 31 1 2024) (Date 31 1 2024) EQUALS JUST TRUE
#ASSERT `s 279H(3) the notice was given within the period` (Date 31 1 2024) (Date 30 1 2024) EQUALS JUST FALSE
-- failure to comply (arguments: the answer of (1), the day of the change, the notice, the day of the question)
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST TRUE) (Date 31 1 2024) (JUST (`s 279H notice given` OF (Date 13 2 2024), TRUE)) (Date 20 2 2024) EQUALS JUST FALSE
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST TRUE) (Date 31 1 2024) (JUST (`s 279H notice given` OF (Date 14 2 2024), TRUE)) (Date 20 2 2024) EQUALS JUST TRUE
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST TRUE) (Date 31 1 2024) (JUST (`s 279H notice given` OF (Date 13 2 2024), FALSE)) (Date 20 2 2024) EQUALS JUST TRUE
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST TRUE) (Date 31 1 2024) NOTHING (Date 13 2 2024) EQUALS NOTHING
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST TRUE) (Date 31 1 2024) NOTHING (Date 14 2 2024) EQUALS JUST TRUE
#ASSERT `s 279H the company has failed to comply with section 279H` (JUST FALSE) (Date 31 1 2024) NOTHING (Date 14 2 2024) EQUALS JUST FALSE
#ASSERT `s 279H the company has failed to comply with section 279H` NOTHING (Date 31 1 2024) NOTHING (Date 14 2 2024) EQUALS NOTHING
#TRACE `s 279H(1) and (3) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in the required information (s 279H(1))" AT 13
#TRACE `s 279H(1) and (3) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in the required information (s 279H(1))" AT 14

-- ---- s 279I(1) ---------------------------------------------------------------------------------------------------------------------------
-- arguments: named in the s 12 statement as the proposed secretary or a proposed joint secretary?, did not become the secretary on incorporation?
#ASSERT `s 279I(1) the company must give notice to the registrar that a proposed secretary did not become the secretary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 279I(1) the company must give notice to the registrar that a proposed secretary did not become the secretary` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 279I(1) the company must give notice to the registrar that a proposed secretary did not become the secretary` FALSE TRUE EQUALS JUST FALSE

-- ---- s 279I(2) and (3) ------------------------------------------------------------------------------------------------------------------
-- The application was delivered on 1 February 2024 and the company was incorporated on 20 February 2024.
-- arguments: proposed secretary?, a change in the required information?, the day of the change, the day the application was
-- delivered (s 9), the day of incorporation, the company gives notice under (1) for the person?
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 10 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS JUST TRUE
-- the day after delivery and the day before incorporation are inside the window
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 2 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS JUST TRUE
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 19 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS JUST TRUE
-- before the application was delivered: outside "after the application ... was delivered"
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 31 1 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS JUST FALSE
-- after the company was incorporated: outside "before the company was incorporated"
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 21 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS JUST FALSE
-- on the day the application was delivered, or on the day of incorporation: the text compares events, not days
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 1 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS NOTHING
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 20 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS NOTHING
-- (3): not required in respect of a person for whom it gives notice under (1)
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE TRUE (Date 10 2 2024) (Date 1 2 2024) (Date 20 2 2024) TRUE EQUALS JUST FALSE
-- not a proposed secretary, or no change: outside "any change in the required information about a proposed secretary"
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` FALSE TRUE (Date 10 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS NOTHING
#ASSERT `s 279I(2) the company must give notice to the registrar of the change in the required information` TRUE FALSE (Date 10 2 2024) (Date 1 2 2024) (Date 20 2 2024) FALSE EQUALS NOTHING

-- ---- s 279I(4) and (5) -----------------------------------------------------------------------------------------------------------------
#ASSERT `s 279I(4) the notice under subsection (2) specifies the date` TRUE EQUALS JUST TRUE
#ASSERT `s 279I(4) the notice under subsection (2) specifies the date` FALSE EQUALS JUST FALSE
#ASSERT `s 279I(5) the days in the period` EQUALS 14
-- incorporated on 20 February 2024: day 14 is 4 March 2024 (2024 is a leap year)
#ASSERT `s 279I(5) the last day of the period` (Date 20 2 2024) EQUALS Date 4 3 2024
#ASSERT `s 279I(5) the notice was given within the period` (Date 20 2 2024) (Date 20 2 2024) EQUALS JUST TRUE
#ASSERT `s 279I(5) the notice was given within the period` (Date 20 2 2024) (Date 4 3 2024) EQUALS JUST TRUE
#ASSERT `s 279I(5) the notice was given within the period` (Date 20 2 2024) (Date 5 3 2024) EQUALS JUST FALSE
#ASSERT `s 279I(5) the notice was given within the period` (Date 20 2 2024) (Date 19 2 2024) EQUALS JUST FALSE

-- ---- s 279I: failure to comply -----------------------------------------------------------------------------------------------------------
-- arguments: the answer of (1), the answer of (2), the day of incorporation, the notice, the day of the question
-- (1) required, notice in time
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST TRUE) (JUST FALSE) (Date 20 2 2024) (JUST (`s 279I notice given` OF (Date 4 3 2024), FALSE)) (Date 10 3 2024) EQUALS JUST FALSE
-- (1) required, notice one day late
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST TRUE) (JUST FALSE) (Date 20 2 2024) (JUST (`s 279I notice given` OF (Date 5 3 2024), FALSE)) (Date 10 3 2024) EQUALS JUST TRUE
-- (1) required, no notice yet
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST TRUE) (JUST FALSE) (Date 20 2 2024) NOTHING (Date 4 3 2024) EQUALS NOTHING
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST TRUE) (JUST FALSE) (Date 20 2 2024) NOTHING (Date 5 3 2024) EQUALS JUST TRUE
-- (2) required: the notice must also specify the date on which the change occurred (4)
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST FALSE) (JUST TRUE) (Date 20 2 2024) (JUST (`s 279I notice given` OF (Date 4 3 2024), TRUE)) (Date 10 3 2024) EQUALS JUST FALSE
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST FALSE) (JUST TRUE) (Date 20 2 2024) (JUST (`s 279I notice given` OF (Date 4 3 2024), FALSE)) (Date 10 3 2024) EQUALS JUST TRUE
-- neither (1) nor (2) required a notice
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST FALSE) (JUST FALSE) (Date 20 2 2024) NOTHING (Date 10 3 2024) EQUALS JUST FALSE
-- (2) is not settled and (1) did not require a notice
#ASSERT `s 279I the company has failed to comply with section 279I` (JUST FALSE) NOTHING (Date 20 2 2024) NOTHING (Date 10 3 2024) EQUALS NOTHING
#TRACE `s 279I(1), (2) and (5) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change occurring before incorporation (s 279I(1) or (2))" AT 13
#TRACE `s 279I(1), (2) and (5) the company's duty as a regulative rule` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change occurring before incorporation (s 279I(1) or (2))" AT 14
