#ASSERT `s 76C(2)(b) the registrar must place a note of the determination in the register` FALSE EQUALS JUST FALSE
-- s 76C(3): (a) a direction under s 76B does not affect the registrar's power; (b) if the registrar acts, the direction lapses
#ASSERT `s 76C(3)(a) the direction does not affect the registrar's power to act under subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 76C(3)(a) the direction does not affect the registrar's power to act under subsection (1)` FALSE EQUALS NOTHING
#ASSERT `s 76C(3)(b) the direction lapses` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76C(3)(b) the direction lapses` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76C(3)(b) the direction lapses` FALSE TRUE EQUALS JUST FALSE
-- s 76D(2): the directions referred to are those under section 64, 67, 75, 76, 76A or 76B
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 64` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 67` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 75` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 76` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 76A` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) a direction under section 76B` EQUALS JUST TRUE
#ASSERT `s 76D(2) the direction is one referred to in subsection (1)` `s 76D(2) another direction` EQUALS JUST FALSE
-- s 76D(1): where a company fails to comply with a direction to change its name, the registrar may determine a new name
#ASSERT `s 76D(1) the registrar may determine a new name for the company` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 76D(1) the registrar may determine a new name for the company` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 76D(1) the registrar may determine a new name for the company` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 76D(1) the registrar may determine a new name for the company` FALSE (JUST TRUE) EQUALS JUST FALSE
-- s 76D(3): the registrar must (a) give the company notice and (b) place a note in the register
#ASSERT `s 76D(3)(a) the registrar must give the company notice of the determination` TRUE EQUALS JUST TRUE
#ASSERT `s 76D(3)(a) the registrar must give the company notice of the determination` FALSE EQUALS JUST FALSE
#ASSERT `s 76D(3)(b) the registrar must place a note of the determination in the register` TRUE EQUALS JUST TRUE
#ASSERT `s 76D(3)(b) the registrar must place a note of the determination in the register` FALSE EQUALS JUST FALSE
-- s 76E(2)(a): "crime" means conduct which (i) constitutes a criminal offence or (ii) corresponds to conduct that would in any one part of the UK
#ASSERT `s 76E(2)(a) the conduct is crime` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76E(2)(a) the conduct is crime` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76E(2)(a) the conduct is crime` FALSE FALSE EQUALS JUST FALSE
-- s 76E(2)(b): crime is "serious" if the maximum sentence is imprisonment for 3 years or more, or the conduct involves violence, substantial financial gain or a large number of persons
#ASSERT `s 76E(2)(b) the crime is serious` 3 FALSE FALSE FALSE EQUALS JUST TRUE -- 3 years: "3 years or more"
#ASSERT `s 76E(2)(b) the crime is serious` 2 FALSE FALSE FALSE EQUALS JUST FALSE -- under 3 years
#ASSERT `s 76E(2)(b) the crime is serious` 1 TRUE FALSE FALSE EQUALS JUST TRUE -- violence
#ASSERT `s 76E(2)(b) the crime is serious` 1 FALSE TRUE FALSE EQUALS JUST TRUE -- substantial financial gain
#ASSERT `s 76E(2)(b) the crime is serious` 1 FALSE FALSE TRUE EQUALS JUST TRUE -- a large number of persons
#ASSERT `s 76E(2)(b) the crime is serious` 0 FALSE FALSE FALSE EQUALS JUST FALSE
-- s 76E(1): nothing in this Part prevents registration if the Secretary of State is satisfied it is necessary (a) in the interests of national security or (b) for preventing or detecting serious crime
#ASSERT `s 76E(1) Part 5 does not prevent the registration of the company by the name` TRUE FALSE NOTHING EQUALS JUST TRUE -- (a)
#ASSERT `s 76E(1) Part 5 does not prevent the registration of the company by the name` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE -- (b)
#ASSERT `s 76E(1) Part 5 does not prevent the registration of the company by the name` FALSE TRUE (JUST FALSE) EQUALS NOTHING -- (b) needs serious crime
#ASSERT `s 76E(1) Part 5 does not prevent the registration of the company by the name` FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 76E(1) Part 5 does not prevent the registration of the company by the name` FALSE FALSE (JUST TRUE) EQUALS NOTHING -- neither satisfaction
