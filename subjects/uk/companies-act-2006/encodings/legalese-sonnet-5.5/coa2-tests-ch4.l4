IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-ch4-other-powers`

-- coa2-tests-ch4.l4: tests for coa2-ch4-other-powers.l4 (ss 75-76E).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.

-- s 75(1): if it appears to the Secretary of State (a) misleading information was given for registration by a name, or (b) an undertaking or assurance given for that purpose was not fulfilled
#ASSERT `s 75(1) the Secretary of State may direct the company to change its name` TRUE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 75(1) the Secretary of State may direct the company to change its name` FALSE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 75(1) the Secretary of State may direct the company to change its name` FALSE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 75(1) the Secretary of State may direct the company to change its name` FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 14)
-- s 75(2)(a): a direction must be given within five years of the registration (registered 10 June 2022)
#ASSERT `s 75(2)(a) the direction is given within five years of the company's registration by that name` (Date 10 6 2022) (Date 10 6 2027) EQUALS JUST TRUE -- the last day
#ASSERT `s 75(2)(a) the direction is given within five years of the company's registration by that name` (Date 10 6 2022) (Date 9 6 2027) EQUALS JUST TRUE
#ASSERT `s 75(2)(a) the direction is given within five years of the company's registration by that name` (Date 10 6 2022) (Date 11 6 2027) EQUALS JUST FALSE -- the day after
#ASSERT `s 75(2)(b) the direction specifies the period` TRUE EQUALS JUST TRUE
#ASSERT `s 75(2)(b) the direction specifies the period` FALSE EQUALS JUST FALSE
#ASSERT `s 75(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- 28 days beginning with the date of the direction
#ASSERT `s 75(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 27 3 2027) EQUALS JUST FALSE -- 27 days
#ASSERT `s 75(3) the Secretary of State may give a further direction extending the period` (Date 28 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- fork 2: on the last day
#ASSERT `s 75(3) the Secretary of State may give a further direction extending the period` (Date 27 3 2027) (Date 28 3 2027) EQUALS JUST TRUE
#ASSERT `s 75(3) the Secretary of State may give a further direction extending the period` (Date 29 3 2027) (Date 28 3 2027) EQUALS JUST FALSE
#ASSERT `s 75(4) the direction meets the requirement of being in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 75(4) the direction meets the requirement of being in writing` FALSE EQUALS JUST FALSE
#ASSERT `s 75(4A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` TRUE EQUALS JUST TRUE
#ASSERT `s 75(4A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` FALSE EQUALS JUST FALSE
-- s 75(5): the duty to comply with the direction within the period it specifies (28 days here)
#TRACE `s 75(5) the company's duty to change its name as directed` 28 AT 0 WITH
    PARTY Company DOES `s 75(5) change the company's name as the direction requires` AT 28
-- TRACE-EXPECT: FULFILLED

#TRACE `s 75(5) the company's duty to change its name as directed` 28 AT 0 WITH
    (WAITUNTIL 29)
-- TRACE-EXPECT: BREACHED

-- s 75(5): who commits the offence: the company and every officer in default; a shadow director is treated as an officer
#ASSERT `s 75(5) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE -- the company did not fail to comply
#ASSERT `s 75(5) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE -- (a) the company
#ASSERT `s 75(5) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE -- (b) every officer in default
#ASSERT `s 75(5) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 75(5) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING -- an officer not in default
#ASSERT `s 75(5) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 75(5) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS JUST TRUE -- "a shadow director is treated as an officer of the company"
#ASSERT `s 75(5) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING -- not named
-- s 75(6): level 3 on the standard scale; daily default fine one-tenth of level 3
#ASSERT (`s 75(6) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 75(6) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 75(6) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
#ASSERT (`s 75(6) the penalty on summary conviction`)'s `imprisonment not exceeding` EQUALS NOTHING

-- s 76: misleading indication of activities
#ASSERT `s 76(1) the Secretary of State may direct the company to change its name` TRUE EQUALS JUST TRUE -- in the opinion of the Secretary of State the name gives so misleading an indication as to pose a risk of harm
#ASSERT `s 76(1) the Secretary of State may direct the company to change its name` FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 76(1) the Secretary of State may direct the company to change its name` FALSE EQUALS JUST FALSE; the function is named for a power, the "if in the opinion" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 15)
-- s 76(2): the direction must be in writing and must specify the period
#ASSERT `s 76(2) the direction meets the requirements of subsection (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(2) the direction meets the requirements of subsection (2)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(2) the direction meets the requirements of subsection (2)` FALSE TRUE EQUALS JUST FALSE
-- s 76(3): at least 28 days beginning with the date of the direction
#ASSERT `s 76(3) the period meets the requirement of subsection (3)` (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- 28 days
#ASSERT `s 76(3) the period meets the requirement of subsection (3)` (Date 1 3 2027) (Date 27 3 2027) EQUALS JUST FALSE -- 27 days
-- s 76(3A): a further direction in writing, before the end of the period for the time being specified (fork 2)
#ASSERT `s 76(3A) the Secretary of State may give a further direction extending the period` TRUE (Date 28 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `s 76(3A) the Secretary of State may give a further direction extending the period` TRUE (Date 29 3 2027) (Date 28 3 2027) EQUALS JUST FALSE
#ASSERT `s 76(3A) the Secretary of State may give a further direction extending the period` FALSE (Date 1 3 2027) (Date 28 3 2027) EQUALS NOTHING -- not in writing -- RECONCILED 2026-11-12: was #ASSERT `s 76(3A) the Secretary of State may give a further direction extending the period` FALSE (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST FALSE; the function is named for a power, the "in writing" complement failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 19)
#ASSERT `s 76(3A) the Secretary of State may give a further direction extending the period` TRUE (Date 27 3 2027) (Date 28 3 2027) EQUALS JUST TRUE
-- s 76(4): the company may apply to the court to set the direction aside
#ASSERT `s 76(4) the company may apply to the court to set the direction aside` TRUE EQUALS JUST TRUE
#ASSERT `s 76(4) the company may apply to the court to set the direction aside` FALSE EQUALS NOTHING
-- s 76(4A): within the period of three weeks beginning with the date of the direction (1 March to 21 March)
#ASSERT `s 76(4A) the application is made in time` (Date 1 3 2027) (Date 21 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `s 76(4A) the application is made in time` (Date 1 3 2027) (Date 22 3 2027) EQUALS JUST FALSE -- the day after
#ASSERT `s 76(4A) the application is made in time` (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST TRUE -- the first day
-- s 76(5): the court may set the direction aside or confirm it; if confirmed it must specify the period
#ASSERT `s 76(5) the court may set the direction aside or confirm it` TRUE EQUALS JUST TRUE
#ASSERT `s 76(5) the court may set the direction aside or confirm it` FALSE EQUALS NOTHING
#ASSERT `s 76(5) the court must specify the period within which the direction is to be complied with` TRUE EQUALS JUST TRUE
#ASSERT `s 76(5) the court must specify the period within which the direction is to be complied with` FALSE EQUALS JUST FALSE
-- s 76(5A): the company is not required to comply while the proceedings are ongoing
#ASSERT `s 76(5A) the company is not required to comply with the direction while the proceedings are ongoing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(5A) the company is not required to comply with the direction while the proceedings are ongoing` TRUE FALSE EQUALS JUST FALSE -- the proceedings have ended
#ASSERT `s 76(5A) the company is not required to comply with the direction while the proceedings are ongoing` FALSE TRUE EQUALS JUST FALSE -- no application
-- s 76(5B): the registrar may omit the name from the public register
#ASSERT `s 76(5B) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` TRUE EQUALS JUST TRUE
#ASSERT `s 76(5B) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` FALSE EQUALS JUST FALSE
