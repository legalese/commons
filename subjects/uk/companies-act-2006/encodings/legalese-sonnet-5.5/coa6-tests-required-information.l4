IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa6-required-information`

-- coa6-tests-required-information.l4: tests of coa6-required-information.l4 (ss 279J, 279K, 279L).
-- Every expected value was decided by reading the sections (lines 3671-3705 of ukpga-2006-46.txt) before the encoding was run,
-- and is written beside its assertion.

§ `Tests: ss 279J, 279K and 279L`

-- ---- s 279J(1): the items ------------------------------------------------------------------------------------------------------------
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `an individual` EQUALS JUST (LIST `s 279J(1)(a) name`, `s 279J(1)(b) any relevant former names`, `s 279J(1)(c) a service address`)
-- anything that is not an individual is outside "who is an individual" (a body corporate or firm is s 279K)
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `a company registered under the Companies Act 2006` EQUALS NOTHING
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `another body corporate incorporated in the United Kingdom` EQUALS NOTHING
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `a body corporate incorporated outside the United Kingdom` EQUALS NOTHING
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `a corporation sole` EQUALS NOTHING
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `a partnership` EQUALS NOTHING
#ASSERT `s 279J(1) the required information about a secretary or joint secretary who is an individual` `an unincorporated association` EQUALS NOTHING
-- the list is read as closed: an item it does not name is not part of the required information
#ASSERT `s 279J(1) the item is part of the required information about an individual` `s 279J(1)(a) name` EQUALS JUST TRUE
#ASSERT `s 279J(1) the item is part of the required information about an individual` `s 279J(1)(b) any relevant former names` EQUALS JUST TRUE
#ASSERT `s 279J(1) the item is part of the required information about an individual` `s 279J(1)(c) a service address` EQUALS JUST TRUE
#ASSERT `s 279J(1) the item is part of the required information about an individual` `s 279J(1) any other item` EQUALS JUST FALSE

-- ---- s 279J(1)(c): the service address -------------------------------------------------------------------------------------------------
-- arguments: the statement given, the answer of s 1141 (is it a service address?)
#ASSERT `s 279J(1)(c) the statement given is an acceptable statement of the service address` "The company’s registered office" NOTHING EQUALS JUST TRUE
#ASSERT `s 279J(1)(c) the statement given is an acceptable statement of the service address` "The company’s registered office" (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 279J(1)(c) the statement given is an acceptable statement of the service address` "1 High Street, Reading" (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 279J(1)(c) the statement given is an acceptable statement of the service address` "1 High Street, Reading" (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 279J(1)(c) the statement given is an acceptable statement of the service address` "1 High Street, Reading" NOTHING EQUALS NOTHING

-- ---- s 279J(3): the defined terms -------------------------------------------------------------------------------------------------------
#ASSERT `s 279J(3) the name is a former name` TRUE EQUALS JUST TRUE
#ASSERT `s 279J(3) the name is a former name` FALSE EQUALS JUST FALSE
#ASSERT `s 279J(3) the individual's name` "Ada" "Lovelace" EQUALS `s 279J(3) name` OF "Ada", "Lovelace"
#ASSERT NOT (`s 279J(3) the individual's name` "Ada" "Lovelace" EQUALS `s 279J(3) name` OF "Lovelace", "Ada")

-- ---- s 279J(2): "relevant former name" ---------------------------------------------------------------------------------------------------
-- arguments: is a former name?, peer or British title?, the name known before the title?, date of birth, the day the name was
-- changed or disused, the day of the question, s 1088 (registrar required to refrain?)
-- The person was born on 10 May 1980, so attained 16 on 10 May 1996.
-- A name that is a former name, no exclusion applying (changed 1 January 2010, 15 years before the question): relevant.
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST FALSE) EQUALS JUST TRUE
-- not a former name at all ("former name" means a name formerly known for business purposes)
#ASSERT `s 279J(2) the former name is a relevant former name` FALSE FALSE FALSE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST FALSE) EQUALS JUST FALSE
-- (a) the name known before the title, of a peer or an individual normally known by a British title: excluded
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE TRUE TRUE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST FALSE) EQUALS JUST FALSE
-- a peer's other former name is not excluded by (a)
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE TRUE FALSE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST FALSE) EQUALS JUST TRUE
-- the pre-title name of someone who is neither a peer nor normally known by a title is not excluded by (a)
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE TRUE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST FALSE) EQUALS JUST TRUE
-- (b)(i) changed or disused before the person attained 16: the day before the 16th birthday is excluded, the birthday is not
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 9 5 1996) (Date 1 6 2010) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 10 5 1996) (Date 1 6 2010) (JUST FALSE) EQUALS JUST TRUE
-- (b)(ii) changed or disused for 20 years or more: the 20th anniversary is excluded, the day before it is not
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 6 2005) (Date 31 5 2025) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 6 2005) (Date 1 6 2025) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 6 2005) (Date 2 6 2025) (JUST FALSE) EQUALS JUST FALSE
-- (b)(iii) the registrar is required to refrain (s 1088): excluded
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) (JUST TRUE) EQUALS JUST FALSE
-- s 1088 not settled and no other exclusion: not covered
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 1 1 2010) (Date 1 6 2025) NOTHING EQUALS NOTHING
-- s 1088 not settled but another exclusion holds: the other exclusion decides
#ASSERT `s 279J(2) the former name is a relevant former name` TRUE FALSE FALSE (Date 10 5 1980) (Date 9 5 1996) (Date 1 6 2010) NOTHING EQUALS JUST FALSE

-- ---- s 279J(4): the title instead of the forename and surname ------------------------------------------------------------------------
#ASSERT `s 279J(4) the requirement to provide the name is satisfied by providing the title` TRUE TRUE EQUALS JUST TRUE
-- a grant: a peer who gives the forename and surname is not covered by (4)
#ASSERT `s 279J(4) the requirement to provide the name is satisfied by providing the title` TRUE FALSE EQUALS NOTHING
-- an individual not usually known by a title who gives a title is outside (4)
#ASSERT `s 279J(4) the requirement to provide the name is satisfied by providing the title` FALSE TRUE EQUALS NOTHING

-- ---- s 279K(1) -----------------------------------------------------------------------------------------------------------------------------
-- arguments: a body corporate or a firm that is a legal person?, limited company (s 3(1))?, UK-registered company (s 1158)?,
-- entered in a register?
-- (d): a limited company that is a UK-registered company: the registered number
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(d) the registered number`)
-- (e): in any other case, legal form and law, and (if applicable) the register and registration number
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`)
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`, `s 279K(1)(e)(ii) if applicable, the register in which it is entered (including details of the state) and its registration number in that register`)
-- an unlimited company is not "a limited company": the other case; and its register, if entered
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`, `s 279K(1)(e)(ii) if applicable, the register in which it is entered (including details of the state) and its registration number in that register`)
-- a limited company is not settled to be UK-registered, or the other way round: neither (d) nor (e) can be chosen
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE NOTHING (JUST TRUE) FALSE EQUALS NOTHING
-- one of the two is settled to be no: "in any other case"
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` TRUE NOTHING (JUST FALSE) FALSE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`)
-- an individual, or a firm that is not a legal person, is outside s 279K(1)
#ASSERT `s 279K(1) the required information about a secretary or joint secretary that is a body corporate or a firm that is a legal person` FALSE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
-- (1)(c): as in s 279J(1)(c)
#ASSERT `s 279K(1)(c) the statement given is an acceptable statement of the service address` "The company’s registered office" NOTHING EQUALS JUST TRUE
#ASSERT `s 279K(1)(c) the statement given is an acceptable statement of the service address` "2 Low Road, Leeds" (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 279K(1)(c) the statement given is an acceptable statement of the service address` "2 Low Road, Leeds" (JUST TRUE) EQUALS JUST TRUE

-- ---- s 279L ----------------------------------------------------------------------------------------------------------------------------------
-- (1) arguments: all the members in the firm are joint secretaries?, the firm is not a legal person?
#ASSERT `s 279L(1) this section applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 279L(1) this section applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 279L(1) this section applies` TRUE FALSE EQUALS JUST FALSE
-- (2) arguments: all the members ...?, the firm is not a legal person?, the information provided is the information that would be
-- required if the firm were a legal person?
#ASSERT `s 279L(2) the requirement is satisfied by providing the firm's information instead` TRUE TRUE TRUE EQUALS JUST TRUE
-- a grant: the information provided is something else, or the section does not apply: not covered
#ASSERT `s 279L(2) the requirement is satisfied by providing the firm's information instead` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 279L(2) the requirement is satisfied by providing the firm's information instead` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 279L(2) the requirement is satisfied by providing the firm's information instead` TRUE FALSE TRUE EQUALS NOTHING
-- what the firm's information is: (e), a firm that is not a legal person being no limited company
#ASSERT `s 279L(2) the information that would be required if the firm were a legal person and had been appointed as secretary` FALSE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`)
#ASSERT `s 279L(2) the information that would be required if the firm were a legal person and had been appointed as secretary` TRUE EQUALS JUST (LIST `s 279K(1)(a) corporate or firm name`, `s 279K(1)(b) principal office`, `s 279K(1)(c) a service address`, `s 279K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed`, `s 279K(1)(e)(ii) if applicable, the register in which it is entered (including details of the state) and its registration number in that register`)
