IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa27-definitions`
IMPORT `coa27-ch5-third-country`

-- coa27-tests-ch5-third-country.l4: tests for coa27-ch5-third-country.l4 (ss 1241 to 1246). Expected values are
-- decided from the text and written beside each assertion.

-- ---- s 1241(1): "registered third country auditor" means a third country auditor who is entered in the register
#ASSERT `s 1241(1) the person is a registered third country auditor` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1241(1) the person is a registered third country auditor` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1241(1) the person is a registered third country auditor` FALSE TRUE EQUALS JUST FALSE

-- ---- s 1241(2): "UK-traded third country company" means a body corporate (a) incorporated or formed under the law of a third country, (b) whose transferable securities are admitted to trading on a UK regulated market, and (c) not excluded by order
#ASSERT `s 1241(2) the body corporate is a UK-traded third country company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1241(2) the body corporate is a UK-traded third country company` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1241(2) the body corporate is a UK-traded third country company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1241(2) the body corporate is a UK-traded third country company` TRUE TRUE TRUE EQUALS JUST FALSE

-- ---- s 1242(4): a written direction disapplies subsections (1) to (3) for the auditor, company or audit it names
-- (a) a direction about a particular auditor (or class): only the auditor must fit
#ASSERT `s 1242(4) the direction fits the audit` `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` TRUE FALSE
#ASSERT NOT (`s 1242(4) the direction fits the audit` `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` FALSE TRUE)
-- (b) a direction about a particular company (or class): only the company must fit
#ASSERT `s 1242(4) the direction fits the audit` `s 1242(4)(b) a direction about audits of the accounts of a particular UK-traded third country company or class of them` FALSE TRUE
#ASSERT NOT (`s 1242(4) the direction fits the audit` `s 1242(4)(b) a direction about audits of the accounts of a particular UK-traded third country company or class of them` TRUE FALSE)
-- (c) a direction about audits by an auditor of the accounts of a company: both must fit
#ASSERT `s 1242(4) the direction fits the audit` `s 1242(4)(c) a direction about audits by a particular registered third country auditor or class of them of the accounts of a particular company or class of them` TRUE TRUE
#ASSERT NOT (`s 1242(4) the direction fits the audit` `s 1242(4)(c) a direction about audits by a particular registered third country auditor or class of them of the accounts of a particular company or class of them` TRUE FALSE)
#ASSERT NOT (`s 1242(4) the direction fits the audit` `s 1242(4)(c) a direction about audits by a particular registered third country auditor or class of them of the accounts of a particular company or class of them` FALSE TRUE)
-- the answer to "do subsections (1) to (3) apply to the audit?"
#ASSERT `s 1242(4) subsections (1) to (3) apply to the audit` TRUE `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1242(4) subsections (1) to (3) apply to the audit` TRUE `s 1242(4)(b) a direction about audits of the accounts of a particular UK-traded third country company or class of them` FALSE TRUE TRUE EQUALS JUST FALSE
-- a direction not in writing is not a direction under (4)
#ASSERT `s 1242(4) subsections (1) to (3) apply to the audit` FALSE `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` TRUE FALSE TRUE EQUALS NOTHING
-- a direction that does not reach the subsection in question
#ASSERT `s 1242(4) subsections (1) to (3) apply to the audit` TRUE `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` TRUE FALSE FALSE EQUALS NOTHING
-- a direction about another auditor
#ASSERT `s 1242(4) subsections (1) to (3) apply to the audit` TRUE `s 1242(4)(a) a direction about a particular registered third country auditor or class of them` FALSE FALSE TRUE EQUALS NOTHING

-- ---- s 1242(1): a registered third country auditor who audits the accounts of a UK-traded third country company must participate
#ASSERT `s 1242(1) the registered third country auditor must participate in the Schedule 12 arrangements` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1242(1) the registered third country auditor must participate in the Schedule 12 arrangements` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1242(1) the registered third country auditor must participate in the Schedule 12 arrangements` FALSE TRUE FALSE EQUALS NOTHING
-- a direction under (4) takes the audit out
#ASSERT `s 1242(1) the registered third country auditor must participate in the Schedule 12 arrangements` TRUE TRUE TRUE EQUALS JUST FALSE

-- ---- s 1242(2)(a) and (b)
#ASSERT `s 1242(2)(a) the registered third country auditor must take the step` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1242(2)(a) the registered third country auditor must take the step` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1242(2)(a) the registered third country auditor must take the step` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1242(2)(a) the registered third country auditor must take the step` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1242(2)(b) the registered third country auditor must comply with the decision` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1242(2)(b) the registered third country auditor must comply with the decision` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1242(2)(b) the registered third country auditor must comply with the decision` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1242(2)(b) the registered third country auditor must comply with the decision` TRUE TRUE TRUE EQUALS JUST FALSE

-- ---- s 1243: matters to be notified
#ASSERT `s 1243(1) the registered third country auditor must notify or give the information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1243(1) the registered third country auditor must notify or give the information` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1243(1) the registered third country auditor must notify or give the information` TRUE FALSE TRUE EQUALS NOTHING
-- (2): the notices and information "must be such as the Secretary of State may reasonably require"
#ASSERT `s 1243(1) the registered third country auditor must notify or give the information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1243(3) the registered third country auditor must give the information in the form or verified in the manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1243(3) the registered third country auditor must give the information in the form or verified in the manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1243(3) the registered third country auditor must give the information in the form or verified in the manner` FALSE TRUE EQUALS NOTHING
-- (4) in writing unless the Secretary of State specifies or approves some other manner
#ASSERT `s 1243(4) the notice or information is given as required` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1243(4) the notice or information is given as required` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1243(4) the notice or information is given as required` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1243(4) the notice or information is given as required` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1243(4) the notice or information is given as required` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- s 1244: power to call for information
#ASSERT `s 1244(1) the registered third country auditor must give the information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1244(1) the registered third country auditor must give the information` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1244(1) the registered third country auditor must give the information` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1244(1) the registered third country auditor must give the information` TRUE TRUE FALSE EQUALS NOTHING
-- (2): reasonable time specified by the Secretary of State: last day 31 March 2027 (an input), given on 31 March (in time) and on 1 April (late)
#ASSERT `s 1244(2) the information was given within the time specified` (Date 31 3 2027) (Date 30 3 2027) EQUALS JUST TRUE
#ASSERT `s 1244(2) the information was given within the time specified` (Date 31 3 2027) (Date 31 3 2027) EQUALS JUST TRUE
#ASSERT `s 1244(2) the information was given within the time specified` (Date 31 3 2027) (Date 1 4 2027) EQUALS JUST FALSE

-- ---- s 1245: compliance orders
#ASSERT `s 1245(1) the Secretary of State may apply to the court` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1245(1) the Secretary of State may apply to the court` TRUE FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q1)
#ASSERT `s 1245(1) the Secretary of State may apply to the court` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 1245(1) the Secretary of State may apply to the court` FALSE TRUE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q1)
#ASSERT `s 1245(1) the Secretary of State may apply to the court` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1245(2) the court may order the auditor to take steps` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1245(2) the court may order the auditor to take steps` TRUE FALSE EQUALS NOTHING; the gate is "on an application ... the court decides" (where/when kind), so the site is listed and not flipped
#ASSERT `s 1245(2) the court may order the auditor to take steps` TRUE FALSE EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 1245(2) the court may order the auditor to take steps` FALSE TRUE EQUALS NOTHING; the gate is "on an application ... the court decides" (where/when kind), so the site is listed and not flipped
#ASSERT `s 1245(2) the court may order the auditor to take steps` FALSE TRUE EQUALS JUST FALSE
-- (3) "the court" means the High Court or, in Scotland, the Court of Session
#ASSERT `s 1245(3) the court is` FALSE EQUALS `s 1245(3) the High Court`
#ASSERT `s 1245(3) the court is` TRUE EQUALS `s 1245(3) the Court of Session`

-- ---- s 1246(3): where different parts of the register are kept by different persons, the references are to the person keeping the third country auditors' part
#ASSERT `s 1246(3) the references in this section to the person keeping the register are to` TRUE EQUALS `s 1246(3) the person keeping the part of the register which relates to third country auditors`
#ASSERT `s 1246(3) the references in this section to the person keeping the register are to` FALSE EQUALS `s 1246(3) the person keeping the register in accordance with regulations under section 1239(1)`
