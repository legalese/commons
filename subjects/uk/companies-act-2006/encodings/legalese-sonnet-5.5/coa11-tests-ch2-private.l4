#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` FALSE TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- an auditor was appointed by the end of the period: no deeming
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE FALSE FALSE FALSE (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- no auditor was in office
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE TRUE FALSE (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- (a)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE TRUE (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- (b)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE  -- (c)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST FALSE  -- (d)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE  -- (e)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE (JUST FALSE) FALSE FALSE (JUST TRUE) EQUALS JUST FALSE  -- (f)
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE NOTHING FALSE FALSE (JUST FALSE) EQUALS NOTHING  -- not covered: section 488 not known
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE FALSE FALSE (JUST FALSE) FALSE FALSE NOTHING EQUALS NOTHING  -- not covered: section 485C not known
#ASSERT `s 487(2) the auditor in office is deemed to be re-appointed` TRUE TRUE TRUE FALSE NOTHING FALSE FALSE NOTHING EQUALS JUST FALSE  -- an exception that is met decides, whatever is unknown
