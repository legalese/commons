#ASSERT `s 487(4) the loss is taken into account in ascertaining the compensation or damages payable to the auditor` FALSE EQUALS NOTHING  -- any other loss: the text says nothing

§§ `s 488: prevention by members of deemed re-appointment`

#ASSERT `s 488(2) the requisite percentage` NOTHING EQUALS 0.05  -- 5% unless the articles set a lower one
#ASSERT `s 488(2) the requisite percentage` (JUST 0.03) EQUALS 0.03  -- a lower percentage in the articles
#ASSERT `s 488(2) the requisite percentage` (JUST 0.05) EQUALS 0.05
#ASSERT `s 488(2) the requisite percentage` (JUST 0.1) EQUALS 0.05  -- a higher percentage in the articles is not "such lower percentage"
-- s 488(3) arguments: form, authenticated, the day received, the last day of the accounting reference period
#ASSERT `s 488(3) the notice is a notice under section 488` `hard copy form` TRUE (Date 31 12 2025) (Date 31 12 2025) EQUALS JUST TRUE  -- received on the last day
#ASSERT `s 488(3) the notice is a notice under section 488` `electronic form` TRUE (Date 30 12 2025) (Date 31 12 2025) EQUALS JUST TRUE
#ASSERT `s 488(3) the notice is a notice under section 488` `hard copy form` TRUE (Date 1 1 2026) (Date 31 12 2025) EQUALS JUST FALSE  -- a day late
#ASSERT `s 488(3) the notice is a notice under section 488` `electronic form` FALSE (Date 30 12 2025) (Date 31 12 2025) EQUALS JUST FALSE  -- not authenticated
-- s 488(1) arguments: the fraction of the voting rights represented, the requisite percentage
#ASSERT `s 488(1) the deemed re-appointment is prevented by the members` 0.05 0.05 EQUALS JUST TRUE  -- exactly the requisite percentage: "at least"
#ASSERT `s 488(1) the deemed re-appointment is prevented by the members` 0.0499 0.05 EQUALS JUST FALSE
#ASSERT `s 488(1) the deemed re-appointment is prevented by the members` 0.03 0.03 EQUALS JUST TRUE  -- a lower percentage in the articles
#ASSERT `s 488(1) the deemed re-appointment is prevented by the members` 0.04 0.03 EQUALS JUST TRUE
#ASSERT `s 488(1) the deemed re-appointment is prevented by the members` 0.02 0.03 EQUALS JUST FALSE
