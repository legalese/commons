IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-service-contracts`

-- coa5-tests-service-contracts.l4: tests for ss 227 to 231 (coa5-service-contracts.l4). Expected values read from the text, not from the code.

§ `Tests: s 227`

#ASSERT `s 227(1) the contract is a director's service contract` `s 227(1)(a) a director of the company undertakes personally to perform services (as director or otherwise) for the company, or for a subsidiary of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 227(1) the contract is a director's service contract` `s 227(1)(b) services that a director of the company undertakes personally to perform are made available by a third party to the company, or to a subsidiary of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 227(1) the contract is a director's service contract` `s 227(1) some other arrangement` TRUE EQUALS JUST FALSE
#ASSERT `s 227(1) the contract is a director's service contract` `s 227(1)(a) a director of the company undertakes personally to perform services (as director or otherwise) for the company, or for a subsidiary of the company` FALSE EQUALS JUST FALSE
#ASSERT `s 227(2) the provisions of this Part relating to directors' service contracts apply to the terms` TRUE EQUALS JUST TRUE
#ASSERT `s 227(2) the provisions of this Part relating to directors' service contracts apply to the terms` FALSE EQUALS NOTHING
#ASSERT `s 227(2) the provisions relating to directors' service contracts are restricted to contracts for services outside the scope of the ordinary duties of a director` EQUALS JUST FALSE

§ `Tests: s 228`

-- s 228(6): on summary conviction, a fine not exceeding level 3; for continued contravention a daily default fine not exceeding one-tenth of level 3
#ASSERT `s 228(6) the penalty`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 228(6) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT `s 228(6) the penalty`'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
#ASSERT `s 228(6) the penalty`'s `imprisonment not exceeding` EQUALS NOTHING
-- the pounds a level stands for are an input; the figure below is a round number chosen for the test, not the real level 3
#ASSERT `s 228(6) the largest fine in pounds` 1_000 EQUALS 1_000
#ASSERT `s 228(6) the largest daily default fine in pounds` 1_000 EQUALS 100

-- s 228(1): a copy of a written contract, or if not in writing a written memorandum, kept available for inspection
#ASSERT `s 228(1) the company has kept the copy or memorandum available for inspection` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 228(1) the company has kept the copy or memorandum available for inspection` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 228(1) the company has kept the copy or memorandum available for inspection` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 228(1) the company has kept the copy or memorandum available for inspection` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 228(1) the company has kept the copy or memorandum available for inspection` FALSE TRUE FALSE EQUALS JUST FALSE

-- s 228(2): at the registered office or a place specified in regulations under s 1136
#ASSERT `s 228(2) the copies and memoranda are kept at a permitted place` `s 228(2)(a) the company's registered office` NOTHING EQUALS JUST TRUE
#ASSERT `s 228(2) the copies and memoranda are kept at a permitted place` `s 228(2)(b) a place specified in regulations under section 1136` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 228(2) the copies and memoranda are kept at a permitted place` `s 228(2)(b) a place specified in regulations under section 1136` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 228(2) the copies and memoranda are kept at a permitted place` `s 228(2)(b) a place specified in regulations under section 1136` NOTHING EQUALS NOTHING
#ASSERT `s 228(2) the copies and memoranda are kept at a permitted place` `s 228(2) some other place` (JUST TRUE) EQUALS JUST FALSE

-- s 228(3): retained for at least one year from the date of termination or expiry (the anniversary day counted in: fork F-228-1)
#ASSERT `s 228(3) the copies and memoranda must still be retained and kept available on the date` (Date 15 3 2025) (Date 15 3 2025) EQUALS JUST TRUE
#ASSERT `s 228(3) the copies and memoranda must still be retained and kept available on the date` (Date 15 3 2025) (Date 14 3 2026) EQUALS JUST TRUE
#ASSERT `s 228(3) the copies and memoranda must still be retained and kept available on the date` (Date 15 3 2025) (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `s 228(3) the copies and memoranda must still be retained and kept available on the date` (Date 15 3 2025) (Date 16 3 2026) EQUALS JUST FALSE

-- s 228(4): notice to the registrar of the place and of any change, unless always at the registered office
#ASSERT `s 228(4) the company must give notice to the registrar of the place and of any change in it` FALSE EQUALS JUST TRUE
#ASSERT `s 228(4) the company must give notice to the registrar of the place and of any change in it` TRUE EQUALS JUST FALSE
-- the duty as a rule, with the 14 days of s 228(5): notice on day 14 is in time; on day 15 it is not; with no notice the duty stands
-- TRACE EXPECT: FULFILLED
#TRACE `s 228(4) the company's duty to give notice to the registrar` AT 0 WITH
    PARTY Company DOES `s 228(4) give notice to the registrar of the place` AT 14

-- TRACE EXPECT: BREACHED
#TRACE `s 228(4) the company's duty to give notice to the registrar` AT 0 WITH
    PARTY Company DOES `s 228(4) give notice to the registrar of the place` AT 15

-- TRACE EXPECT: STANDING
#TRACE `s 228(4) the company's duty to give notice to the registrar` AT 0 WITH
    (WAITUNTIL 10)

-- s 228(5): default in (1), (2) or (3), or default for 14 days in (4), is an offence by every officer in default
#ASSERT `s 228(5) the officer commits an offence` TRUE 0 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 228(5) the officer commits an offence` FALSE 14 (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 228(5) the officer commits an offence` FALSE 13 (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 228(5) the officer commits an offence` FALSE 0 (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 228(5) the officer commits an offence` TRUE 0 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 228(5) the officer commits an offence` TRUE 0 NOTHING EQUALS NOTHING

#ASSERT `s 228(7) the provisions of this section apply to the variation as to the original contract` TRUE EQUALS JUST TRUE
#ASSERT `s 228(7) the provisions of this section apply to the variation as to the original contract` FALSE EQUALS NOTHING

§ `Tests: s 229`

-- s 229(1): every copy or memorandum required under s 228 is open to inspection by any member without charge
#ASSERT `s 229(1) the person may inspect the copy or memorandum without charge` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 229(1) the person may inspect the copy or memorandum without charge` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 229(1) the person may inspect the copy or memorandum without charge` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 229(1) the person may inspect the copy or memorandum without charge` (JUST TRUE) FALSE EQUALS NOTHING

-- s 229(2): on request and on payment of the prescribed fee a member is entitled to a copy
#ASSERT `s 229(2) the member is entitled to be provided with a copy` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 229(2) the member is entitled to be provided with a copy` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 229(2) the member is entitled to be provided with a copy` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 229(2) the member is entitled to be provided with a copy` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 229(2) the member is entitled to be provided with a copy` NOTHING TRUE TRUE EQUALS NOTHING

-- s 229(2): the copy is provided within seven days after the request is received
#ASSERT `s 229(2) the copy has been provided in time` (Date 1 4 2025) (Date 8 4 2025) EQUALS JUST TRUE
#ASSERT `s 229(2) the copy has been provided in time` (Date 1 4 2025) (Date 1 4 2025) EQUALS JUST TRUE
#ASSERT `s 229(2) the copy has been provided in time` (Date 1 4 2025) (Date 9 4 2025) EQUALS JUST FALSE
-- TRACE EXPECT: FULFILLED
#TRACE `s 229(2) the company's duty to provide the copy` AT 0 WITH
    PARTY Company DOES `s 229(2) provide the member with a copy` AT 7

-- TRACE EXPECT: BREACHED
#TRACE `s 229(2) the company's duty to provide the copy` AT 0 WITH
    PARTY Company DOES `s 229(2) provide the member with a copy` AT 8

-- TRACE EXPECT: BREACHED
#TRACE `s 229(2) the company's duty to provide the copy` AT 0 WITH
    (WAITUNTIL 8)

-- s 229(3): an offence where inspection is refused or default is made in complying with (2)
#ASSERT `s 229(3) the officer commits an offence` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 229(3) the officer commits an offence` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 229(3) the officer commits an offence` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 229(3) the officer commits an offence` TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 229(3) the officer commits an offence` TRUE FALSE NOTHING EQUALS NOTHING

#ASSERT `s 229(4) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT `s 229(4) the penalty`'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
#ASSERT `s 229(4) the penalty`'s `how convicted` EQUALS `on summary conviction`

#ASSERT `s 229(5) the court may by order compel an immediate inspection or direct that the copy be sent` TRUE EQUALS JUST TRUE
#ASSERT `s 229(5) the court may by order compel an immediate inspection or direct that the copy be sent` FALSE EQUALS NOTHING

§ `Tests: s 230 and s 231`

#ASSERT `s 230 the shadow director is treated as a director for the provisions of this Chapter` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 230 the shadow director is treated as a director for the provisions of this Chapter` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 230 the shadow director is treated as a director for the provisions of this Chapter` NOTHING EQUALS NOTHING

-- s 231(1): a limited company with one member contracts with the sole member, who is a director, outside the ordinary course of business
#ASSERT `s 231(1) this section applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 231(1) this section applies` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 231(1) this section applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 231(1) this section applies` TRUE TRUE TRUE EQUALS JUST FALSE

#ASSERT `s 231(5) the shadow director is treated as a director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 231(5) the shadow director is treated as a director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 231(5) the shadow director is treated as a director` NOTHING EQUALS NOTHING

-- s 231(2): unless the contract is in writing, the terms are set out in a memorandum or recorded in the minutes of the first directors' meeting after the contract
#ASSERT `s 231(2) the company must ensure the terms are set out or recorded` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 231(2) the company must ensure the terms are set out or recorded` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 231(2) the company must ensure the terms are set out or recorded` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 231(2) the company must ensure the terms are set out or recorded` NOTHING FALSE EQUALS NOTHING

#ASSERT `s 231(2) the company has complied` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 231(2) the company has complied` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 231(2) the company has complied` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 231(2) the company has complied` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 231(2) the company has complied` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 231(2) the company has complied` NOTHING FALSE FALSE EQUALS NOTHING

-- the duty as a rule: no time stated: with the act done it is fulfilled; with none the duty stands
-- TRACE EXPECT: FULFILLED
#TRACE `s 231(2) the company's duty to ensure the terms are set out or recorded` AT 0 WITH
    PARTY Company DOES `s 231(2) set the terms out in a written memorandum or record them in the minutes of the first directors' meeting following the contract` AT 30

-- TRACE EXPECT: STANDING
#TRACE `s 231(2) the company's duty to ensure the terms are set out or recorded` AT 0 WITH
    (WAITUNTIL 400)

-- s 231(3): a company that fails to comply: an offence by every officer in default
#ASSERT `s 231(3) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 231(3) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 231(3) the officer commits an offence` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 231(3) the officer commits an offence` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 231(3) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING

#ASSERT `s 231(4) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT `s 231(4) the penalty`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT `s 231(4) the penalty`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 231(4) the largest fine in pounds` 5_000 EQUALS 5_000

#ASSERT `s 231(6) the failure affects the validity of the contract` TRUE EQUALS JUST FALSE
#ASSERT `s 231(6) the failure affects the validity of the contract` FALSE EQUALS NOTHING
#ASSERT `s 231(7) this section excludes the operation of any other enactment or rule of law applying to contracts between a company and a director` EQUALS JUST FALSE
