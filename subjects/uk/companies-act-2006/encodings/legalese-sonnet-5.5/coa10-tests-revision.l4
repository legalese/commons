IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-revision`

-- coa10-tests-revision.l4: tests for coa10-revision.l4 (ss 454 to 457). Every expected value was written down from the text
-- of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 454(1): the directors may prepare revised accounts (lines 6148-6152) ----
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 the company's annual accounts` TRUE EQUALS JUST TRUE
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 the directors' remuneration report` TRUE EQUALS JUST TRUE
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 the directors' report` TRUE EQUALS JUST TRUE
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 a strategic report of the company` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 the company's annual accounts` FALSE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F20)
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 the company's annual accounts` FALSE EQUALS NOTHING
#ASSERT `s 454(1) the directors may prepare revised accounts or a revised report or statement` `s 454 another document` TRUE EQUALS NOTHING

-- ---- s 454(2): confined to correction and consequential alterations once copies have gone out (lines 6153-6155) ----
-- The arguments: sent out to members; delivered to the registrar; a public company; laid before the company in general meeting.
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- laid before the company in general meeting counts only for a public company
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 454(2) the revisions are confined to correction and consequential alterations` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 454(2) the revision is within the limit the section sets` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 454(2) the revision is within the limit the section sets` (JUST TRUE) FALSE EQUALS JUST FALSE
-- Where the confinement does not apply, the section's limit says nothing about the revision.
#ASSERT `s 454(2) the revision is within the limit the section sets` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 454(2) the revision is within the limit the section sets` NOTHING TRUE EQUALS NOTHING

-- ---- s 455(1): where the section applies (lines 6172-6175) ----
#ASSERT `s 455(1) section 455 applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 455(1) section 455 applies` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 455(1) section 455 applies` TRUE TRUE TRUE EQUALS JUST TRUE
-- no copies sent out, delivered or laid
#ASSERT `s 455(1) section 455 applies` FALSE FALSE TRUE EQUALS JUST FALSE
-- copies out, but it does not appear to the Secretary of State that there is a question
#ASSERT `s 455(1) section 455 applies` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 455(2) the Secretary of State may give notice to the directors indicating the respects in which a question arises` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 455(2) the Secretary of State may give notice to the directors indicating the respects in which a question arises` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 455(2) the Secretary of State may give notice to the directors indicating the respects in which a question arises` NOTHING EQUALS NOTHING

-- ---- s 455(3): a period of not less than one month (line 6177) ----
-- Notice dated 15 March 2026: one month is 15 April 2026.
#ASSERT `s 455(3) the period the notice specifies is not less than one month` (Date 15 3 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 455(3) the period the notice specifies is not less than one month` (Date 15 3 2026) (Date 14 4 2026) EQUALS JUST FALSE
#ASSERT `s 455(3) the period the notice specifies is not less than one month` (Date 15 3 2026) (Date 30 4 2026) EQUALS JUST TRUE

-- ---- s 455(4): the Secretary of State may apply to the court (lines 6178-6181) ----
-- Specified period ends 15 April 2026. On 16 April, with neither an explanation nor a revision: may apply.
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 16 4 2026) (Date 15 4 2026) FALSE FALSE EQUALS JUST TRUE
-- At the end of the period (15 April itself): the period has run its course.
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 15 4 2026) (Date 15 4 2026) FALSE FALSE EQUALS JUST TRUE
-- Before the end of the period: no.
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 14 4 2026) (Date 15 4 2026) FALSE FALSE EQUALS JUST FALSE
-- A satisfactory explanation, or a revision, is given: no.
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 16 4 2026) (Date 15 4 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 16 4 2026) (Date 15 4 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 455(4) the Secretary of State may apply to the court` (Date 16 4 2026) (Date 15 4 2026) TRUE TRUE EQUALS JUST FALSE
-- (5): the section applies equally to revised documents.
#ASSERT `s 455(5) section 455 applies equally to the revised document` `s 455 revised annual accounts` EQUALS JUST TRUE
#ASSERT `s 455(5) section 455 applies equally to the revised document` `s 455 a revised strategic report` EQUALS JUST TRUE
#ASSERT `s 455(5) section 455 applies equally to the revised document` `s 455 a revised directors' report` EQUALS JUST TRUE
#ASSERT `s 455(5) section 455 applies equally to the revised document` `s 455 another revised document` EQUALS NOTHING
#ASSERT `s 455(5) the references to revised accounts or reports are read as references to further revised accounts or reports` TRUE EQUALS JUST TRUE
#ASSERT `s 455(5) the references to revised accounts or reports are read as references to further revised accounts or reports` FALSE EQUALS NOTHING

-- ---- s 456(1): who may apply to the court (lines 6185-6188) ----
#ASSERT `s 456(1) the applicant may apply to the court for a declaration and an order` `s 456 the Secretary of State, who has complied with section 455` EQUALS JUST TRUE
#ASSERT `s 456(1) the applicant may apply to the court for a declaration and an order` `s 456 a person authorised by the Secretary of State for the purposes of section 456` EQUALS JUST TRUE
#ASSERT `s 456(1) the applicant may apply to the court for a declaration and an order` `s 456 the Secretary of State, who has not complied with section 455` EQUALS NOTHING
#ASSERT `s 456(1) the applicant may apply to the court for a declaration and an order` `s 456 any other person` EQUALS NOTHING
#ASSERT `s 456(2) the applicant has given the registrar the notice the section requires` TRUE EQUALS JUST TRUE
#ASSERT `s 456(2) the applicant has given the registrar the notice the section requires` FALSE EQUALS JUST FALSE

-- ---- s 456(3), (4): directions (lines 6190-6199) ----
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to the auditing of the accounts` FALSE EQUALS JUST TRUE
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to the revision of any directors' remuneration report, strategic report and supplementary material or directors' report` FALSE EQUALS JUST TRUE
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to the taking of steps by the directors to bring the making of the order to the notice of persons likely to rely on the previous accounts or report` FALSE EQUALS JUST TRUE
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to the review of the report by the auditors` FALSE EQUALS NOTHING
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to another matter` TRUE EQUALS JUST TRUE
#ASSERT `s 456(3) the court may give the direction` TRUE `s 456 as to another matter` FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 456(3) the court may give the direction` FALSE `s 456 as to the auditing of the accounts` TRUE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F21)
#ASSERT `s 456(3) the court may give the direction` FALSE `s 456 as to the auditing of the accounts` TRUE EQUALS NOTHING
#ASSERT `s 456(4) the court may give the direction` TRUE `s 456 as to the review of the report by the auditors` FALSE EQUALS JUST TRUE
#ASSERT `s 456(4) the court may give the direction` TRUE `s 456 as to the taking of steps by the directors to bring the making of the order to the notice of persons likely to rely on the previous accounts or report` FALSE EQUALS JUST TRUE
#ASSERT `s 456(4) the court may give the direction` TRUE `s 456 as to the auditing of the accounts` FALSE EQUALS NOTHING
#ASSERT `s 456(4) the court may give the direction` TRUE `s 456 as to another matter` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 456(4) the court may give the direction` FALSE `s 456 as to the review of the report by the auditors` TRUE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F22)
#ASSERT `s 456(4) the court may give the direction` FALSE `s 456 as to the review of the report by the auditors` TRUE EQUALS NOTHING

-- ---- s 456(5): costs: the directors party to the approval (lines 6200-6204) ----
-- A director at the time of the approval is taken to have been a party unless he shows he took all reasonable steps to prevent it.
#ASSERT `s 456(5) the director is taken to have been a party to the approval of the defective accounts or report` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 456(5) the director is taken to have been a party to the approval of the defective accounts or report` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 456(5) the director is taken to have been a party to the approval of the defective accounts or report` FALSE FALSE EQUALS NOTHING
#ASSERT `s 456(5) the court may order that the director bear the costs and expenses` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 456(5) the court may order that the director bear the costs and expenses` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 456(5) the court may order that the director bear the costs and expenses` TRUE NOTHING EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 456(5) the court may order that the director bear the costs and expenses` FALSE (JUST TRUE) EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F23)
#ASSERT `s 456(5) the court may order that the director bear the costs and expenses` FALSE (JUST TRUE) EQUALS NOTHING
-- (6)
#ASSERT `s 456(6) the court may exclude one or more directors from the order or order the payment of different amounts` TRUE EQUALS JUST TRUE
#ASSERT `s 456(6) the court may exclude one or more directors from the order or order the payment of different amounts` FALSE EQUALS JUST FALSE
#ASSERT `s 456(6) the director knew or ought to have known that the accounts or report did not comply` TRUE FALSE
#ASSERT `s 456(6) the director knew or ought to have known that the accounts or report did not comply` FALSE TRUE
#ASSERT NOT `s 456(6) the director knew or ought to have known that the accounts or report did not comply` FALSE FALSE
-- (7)
#ASSERT `s 456(7) the applicant has complied` `s 456 the court made an order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 456(7) the applicant has complied` `s 456 the court made an order` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 456(7) the applicant has complied` `s 456 the application failed` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 456(7) the applicant has complied` `s 456 the application failed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 456(7) the applicant has complied` `s 456 the application was withdrawn` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 456(7) the applicant has complied` `s 456 the application was withdrawn` FALSE FALSE EQUALS JUST FALSE
-- (8)
#ASSERT `s 456(8) section 456 applies equally to the revised document` `s 455 revised annual accounts` EQUALS JUST TRUE
#ASSERT `s 456(8) section 456 applies equally to the revised document` `s 455 another revised document` EQUALS NOTHING

-- The regulative rule for (7): no time is stated, so no deadline. The applicant sends the order: FULFILLED; nothing is sent: the obligation stays open.
#TRACE `s 456(7) the applicant's duty to inform the registrar` `s 456 the court made an order` AT 0 WITH
    PARTY `s 456 the applicant` DOES `s 456 send to the registrar for registration a copy of the court order` AT 10
#TRACE `s 456(7) the applicant's duty to inform the registrar` `s 456 the application failed` AT 0 WITH
    PARTY `s 456 the applicant` DOES `s 456 give notice to the registrar that the application has failed or been withdrawn` AT 10
#TRACE `s 456(7) the applicant's duty to inform the registrar` `s 456 the application was withdrawn` AT 0 WITH
    PARTY `s 456 the applicant` DOES `s 456 give notice to the registrar that the application has failed or been withdrawn` AT 10
#TRACE `s 456(7) the applicant's duty to inform the registrar` `s 456 the court made an order` AT 0 WITH

