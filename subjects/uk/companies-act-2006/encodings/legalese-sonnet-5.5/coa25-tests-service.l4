IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa25-service`

-- coa25-tests-service.l4: tests for coa25-service.l4 (ss 1139 to 1142).
-- Every expected value was decided by reading the section and written down before the run.

-- ---- s 1139(1) (arguments: a company registered under the Act; left at the registered office; sent by post to it)
#ASSERT `s 1139(1) service of the document on the company is effected` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1139(1) service of the document on the company is effected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1139(1) service of the document on the company is effected` TRUE FALSE FALSE EQUALS NOTHING -- some other way of delivery
#ASSERT `s 1139(1) service of the document on the company is effected` FALSE TRUE TRUE EQUALS NOTHING -- not a company registered under this Act

-- ---- s 1139(2), first text (arguments: particulars registered; (a) delivered to a resident person; (b) precondition; (b) delivered to a place of business)
#ASSERT `s 1139(2) first text: service of the document on the overseas company is effected` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 1139(2) first text: service of the document on the overseas company is effected` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- (b): no such person, then a place of business
#ASSERT `s 1139(2) first text: service of the document on the overseas company is effected` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- (b) is an "if" that is not met
#ASSERT `s 1139(2) first text: service of the document on the overseas company is effected` TRUE FALSE TRUE FALSE EQUALS NOTHING -- neither mode used
#ASSERT `s 1139(2) first text: service of the document on the overseas company is effected` FALSE TRUE FALSE FALSE EQUALS NOTHING -- particulars not registered under s 1046
#ASSERT `s 1139(3) first text: the address is the person's registered address` TRUE EQUALS JUST TRUE
#ASSERT `s 1139(3) first text: the address is the person's registered address` FALSE EQUALS JUST FALSE

-- ---- s 1139(2), second text (arguments: particulars registered; the company's registered address; a resident person's registered address)
#ASSERT `s 1139(2) second text: service of the document on the overseas company is effected` TRUE TRUE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 1139(2) second text: service of the document on the overseas company is effected` TRUE FALSE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 1139(2) second text: service of the document on the overseas company is effected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1139(2) second text: service of the document on the overseas company is effected` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1139(3)(a) second text: the address is the registered address of the overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1139(3)(a) second text: the address is the registered address of the overseas company` FALSE EQUALS JUST FALSE
#ASSERT `s 1139(3)(b) second text: the address is the registered address of a person other than the overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1139(3)(b) second text: the address is the registered address of a person other than the overseas company` FALSE EQUALS JUST FALSE

-- ---- s 1139(4) (arguments: place of registration; carries on business in England and Wales; process of an England and Wales court; left at or posted to the principal place of business; addressed to the manager or head officer)
#ASSERT `s 1139(4) service of the process on the company is effected` Scotland TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1139(4) service of the process on the company is effected` `Northern Ireland` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1139(4) service of the process on the company is effected` `England and Wales` TRUE TRUE TRUE TRUE EQUALS NOTHING -- registered in England and Wales: outside the limit
#ASSERT `s 1139(4) service of the process on the company is effected` Scotland FALSE TRUE TRUE TRUE EQUALS NOTHING -- does not carry on business in England and Wales
#ASSERT `s 1139(4) service of the process on the company is effected` Scotland TRUE FALSE TRUE TRUE EQUALS NOTHING -- not the process of an England and Wales court
#ASSERT `s 1139(4) service of the process on the company is effected` Scotland TRUE TRUE FALSE TRUE EQUALS NOTHING -- delivered elsewhere
#ASSERT `s 1139(4) service of the process on the company is effected` Scotland TRUE TRUE TRUE FALSE EQUALS NOTHING -- not addressed to the manager or head officer
#ASSERT `s 1139(4) the duty to send a copy of the process to the registered office applies` TRUE EQUALS JUST TRUE
#ASSERT `s 1139(4) the duty to send a copy of the process to the registered office applies` FALSE EQUALS JUST FALSE
#ASSERT `s 1139(4) the person issuing out the process has complied with the duty to send a copy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1139(4) the person issuing out the process has complied with the duty to send a copy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1139(4) the person issuing out the process has complied with the duty to send a copy` FALSE FALSE EQUALS JUST TRUE -- not served under (4): nothing is left to fail

-- ---- s 1140(2) (arguments: kind of person; the s 790C answer; the position is specified by regulations under s 1046)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a director or secretary of a company` NOTHING FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a registrable person or a registrable relevant legal entity in relation to a company` (JUST TRUE) FALSE EQUALS JUST TRUE -- (aa)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a registrable person or a registrable relevant legal entity in relation to a company` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a registrable person or a registrable relevant legal entity in relation to a company` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a person holding a position of an overseas company whose particulars are registered under s 1046` NOTHING TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a person holding a position of an overseas company whose particulars are registered under s 1046` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a judicial factor appointed in relation to a company in Scotland` NOTHING FALSE EQUALS JUST TRUE -- (c)(i)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 an interim manager appointed in relation to a company under s 76 of the Charities Act 2011 or s 33 of the Charities Act (Northern Ireland) 2008` NOTHING FALSE EQUALS JUST TRUE -- (c)(ii)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 a manager appointed in relation to a company under s 47 of the Companies (Audit, Investigations and Community Enterprise) Act 2004` NOTHING FALSE EQUALS JUST TRUE -- (c)(iii)
#ASSERT `s 1140(2) the section applies to the person` `s 1140 another kind of person` NOTHING FALSE EQUALS NOTHING -- list not closed

-- ---- s 1140(3), (4)
#ASSERT `s 1140(3) the section applies to the document` `s 1140 a purpose arising out of or in connection with the appointment or position, or with the company concerned` EQUALS JUST TRUE
#ASSERT `s 1140(3) the section applies to the document` `s 1140 any other purpose` EQUALS JUST TRUE
#ASSERT `s 1140(4) the address is the person's registered address` TRUE EQUALS JUST TRUE
#ASSERT `s 1140(4) the address is the person's registered address` FALSE EQUALS JUST FALSE

-- ---- s 1140(5): "the period of 14 days beginning with the date on which notice of the change is registered".
-- Notice registered on 10 January 2026: the 14 days are 10 to 23 January (the day of registration is the first).
#ASSERT `s 1140(5) the document is validly served at the address previously registered` (Date 10 1 2026) (Date 10 1 2026) EQUALS JUST TRUE -- the first day
#ASSERT `s 1140(5) the document is validly served at the address previously registered` (Date 10 1 2026) (Date 23 1 2026) EQUALS JUST TRUE -- the last day, the 14th
#ASSERT `s 1140(5) the document is validly served at the address previously registered` (Date 10 1 2026) (Date 24 1 2026) EQUALS JUST FALSE -- the day after the period ends
#ASSERT `s 1140(5) the document is validly served at the address previously registered` (Date 30 12 2025) (Date 12 1 2026) EQUALS JUST TRUE -- a period that crosses a year end (30 December to 12 January)
#ASSERT `s 1140(5) the document is validly served at the address previously registered` (Date 30 12 2025) (Date 13 1 2026) EQUALS JUST FALSE

-- ---- s 1140(6) (arguments: termination registered; a registered address under another appointment; a (2)(b) position; the overseas company has ceased to have a connection)
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- (a)
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` TRUE TRUE FALSE FALSE EQUALS NOTHING -- (a) is met only if the address is not a registered address under another appointment
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` FALSE FALSE TRUE TRUE EQUALS JUST FALSE -- (b)
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` FALSE FALSE FALSE TRUE EQUALS NOTHING -- not a (2)(b) position
#ASSERT `s 1140(6) service may be effected by virtue of s 1140 at the address` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- ---- s 1140(1) (arguments: the (2) answer; delivered at the address; the (4) answer; the (6) answer)
#ASSERT `s 1140(1) service of the document on the person is effected` (JUST TRUE) TRUE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 1140(1) service of the document on the person is effected` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE -- (6) forbids it
#ASSERT `s 1140(1) service of the document on the person is effected` (JUST TRUE) FALSE (JUST TRUE) NOTHING EQUALS NOTHING -- not left or posted
#ASSERT `s 1140(1) service of the document on the person is effected` (JUST TRUE) TRUE (JUST FALSE) NOTHING EQUALS NOTHING -- not a registered address
#ASSERT `s 1140(1) service of the document on the person is effected` NOTHING TRUE (JUST TRUE) NOTHING EQUALS NOTHING -- the section does not (or may not) apply to the person
#ASSERT `s 1140(1) service of the document on the person is effected` (JUST TRUE) TRUE NOTHING NOTHING EQUALS NOTHING

-- ---- s 1140(8)
#ASSERT `s 1140(8) the section affects the requirement of permission for service out of the jurisdiction` TRUE EQUALS JUST FALSE
#ASSERT `s 1140(8) the section affects the requirement of permission for service out of the jurisdiction` FALSE EQUALS NOTHING

-- ---- s 1141 and s 1142
#ASSERT `s 1141 the address is a service address` TRUE EQUALS JUST TRUE
#ASSERT `s 1141 the address is a service address` FALSE EQUALS JUST FALSE
#ASSERT `s 1142 the address to be given is a service address` TRUE FALSE EQUALS JUST TRUE -- (arguments: an obligation under the Companies Acts to give an address; otherwise expressly provided)
#ASSERT `s 1142 the address to be given is a service address` TRUE TRUE EQUALS NOTHING -- "unless otherwise expressly provided"
#ASSERT `s 1142 the address to be given is a service address` FALSE FALSE EQUALS NOTHING -- not an obligation of that kind
#ASSERT `s 1142 the address to be given is a service address` FALSE TRUE EQUALS NOTHING

-- ---- s 1139(4) as a regulative rule: expected FULFILLED (no time limit in the text; a missed duty is a BREACH).
#TRACE `s 1139(4) the person issuing out the process must send a copy to the registered office` AT 0 WITH
    PARTY `s 1139 the person issuing out the process` DOES `s 1139 send a copy of the process by post to the company's registered office` AT 1
