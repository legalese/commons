IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa3-part8-members`

-- coa3-tests-members.l4: tests for coa3-part8-members.l4 (ss 112, 113 to 113J).
-- Every expected value is written by hand from the text of the section named beside it, before the code was run.
-- JUST TRUE = the text says yes; JUST FALSE = the text says no in its own words; NOTHING = not covered (see the module header).

-- ---- s 112(1): subscribers -------------------------------------------------------------------------------------
-- "The subscribers of a company's memorandum are deemed to have agreed to become members ..., and on its registration become members and must be entered as such"
#ASSERT `s 112(1) the subscriber is deemed to have agreed to become a member of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 112(1) the subscriber is deemed to have agreed to become a member of the company` FALSE EQUALS NOTHING
#ASSERT `s 112(1) the subscriber becomes a member of the company on its registration` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 112(1) the subscriber becomes a member of the company on its registration` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 112(1) the subscriber becomes a member of the company on its registration` FALSE TRUE EQUALS NOTHING
#ASSERT `s 112(1) the subscriber becomes a member of the company on its registration` FALSE FALSE EQUALS NOTHING
#ASSERT `s 112(1) the subscriber must be entered as a member in the register of members` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 112(1) the subscriber must be entered as a member in the register of members` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 112(1) the subscriber must be entered as a member in the register of members` FALSE TRUE EQUALS NOTHING

-- ---- s 112(2): "Every other person who agrees to become a member of a company, and whose name is entered in its register of members, is a member" ----
-- arguments: (the person is a subscriber) (agrees to become a member) (name entered in the register)
#ASSERT `s 112(2) the person is a member of the company` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 112(2) the person is a member of the company` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 112(2) the person is a member of the company` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 112(2) the person is a member of the company` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 112(2) the person is a member of the company` TRUE TRUE TRUE EQUALS NOTHING

-- ---- s 112 as the rest of the Act asks it: arguments (subscriber) (company registered) (agrees) (name entered) ----
#ASSERT `s 112 the person is a member of the company` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 112 the person is a member of the company` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 112 the person is a member of the company` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 112 the person is a member of the company` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 112 the person is a member of the company` FALSE TRUE FALSE TRUE EQUALS NOTHING

-- ---- s 112(4): "Where an individual's name is entered ... but is not in the form required by section 113A, that does not affect ..." ----
-- arguments: (agrees to become a member) (an individual's name is entered) (the name is in the required form)
#ASSERT `s 112(4) the person becomes a member under s 112(2) although the entered name is not in the form required by s 113A` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 112(4) the person becomes a member under s 112(2) although the entered name is not in the form required by s 113A` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 112(4) the person becomes a member under s 112(2) although the entered name is not in the form required by s 113A` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 112(4) the person becomes a member under s 112(2) although the entered name is not in the form required by s 113A` TRUE FALSE FALSE EQUALS JUST FALSE

-- ---- s 113(1) ----------------------------------------------------------------------------------------------------
#ASSERT `s 113(1) the company must keep a register of its members` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(1) the company must keep a register of its members` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(1) the company must keep a register of its members` NOTHING EQUALS NOTHING

-- the duty as a regulative rule: a #TRACE result is printed, never asserted (an #ASSERT over a DEONTIC is an error on the stable binary)
#TRACE `s 113(1) the company must keep a register of its members (duty)` AT 0 WITH
    PARTY Company DOES `s 113(1) the company keeps a register of its members` AT 5

-- ---- s 113(2), first version: (a) names and addresses, (b) date registered, (c) date of ceasing ----------------------
-- arguments: entry, (the entry is in respect of a person who is a member)
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2)(a) the names and addresses of the members` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2)(b) the date on which the person was registered as a member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2)(c) the date at which any person ceased to be a member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2)(a) the required information about each member` TRUE EQUALS NOTHING
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2) some other entry` TRUE EQUALS NOTHING
#ASSERT `s 113(2) (first version) the register must contain the entry` `s 113(2)(a) the names and addresses of the members` FALSE EQUALS NOTHING

-- ---- s 113(2), second version: (a) the required information, (b) date registered; ceasing is in (2A) -----------------
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2)(a) the required information about each member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2)(b) the date on which the person was registered as a member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2)(a) the names and addresses of the members` TRUE EQUALS NOTHING
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2)(c) the date at which any person ceased to be a member` TRUE EQUALS NOTHING
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2) some other entry` TRUE EQUALS NOTHING
#ASSERT `s 113(2) (second version) the register must contain the entry` `s 113(2)(b) the date on which the person was registered as a member` FALSE EQUALS NOTHING

-- ---- s 113(2A): "Where a person ceases to be a member" ---------------------------------------------------------------
#ASSERT `s 113(2A) the register must contain the date at which the person's membership ceased` TRUE EQUALS JUST TRUE
#ASSERT `s 113(2A) the register must contain the date at which the person's membership ceased` FALSE EQUALS JUST FALSE

-- ---- s 113(3): "In the case of a company having a share capital" ------------------------------------------------------
#ASSERT `s 113(3) the register must contain a statement of the shares held by each member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(3) the register must contain a statement of the shares held by each member` FALSE EQUALS JUST FALSE
-- arguments: (the company has a share capital) (the share has a number)
#ASSERT `s 113(3)(a)(i) the register must distinguish the share by its number` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113(3)(a)(i) the register must distinguish the share by its number` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113(3)(a)(i) the register must distinguish the share by its number` FALSE TRUE EQUALS JUST FALSE
-- arguments: (share capital) (more than one class of issued shares)
#ASSERT `s 113(3)(a)(ii) the register must distinguish the share by its class` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113(3)(a)(ii) the register must distinguish the share by its class` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113(3)(a)(ii) the register must distinguish the share by its class` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 113(3)(b) the register must state the amount paid or agreed to be considered as paid on the shares of each member` TRUE EQUALS JUST TRUE
#ASSERT `s 113(3)(b) the register must state the amount paid or agreed to be considered as paid on the shares of each member` FALSE EQUALS JUST FALSE

-- ---- s 113(4): conversion into stock (both conditions) ------------------------------------------------------------
#ASSERT `s 113(4) the register must show the amount and class of stock held by each member instead of the amount of shares and the particulars relating to shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113(4) the register must show the amount and class of stock held by each member instead of the amount of shares and the particulars relating to shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113(4) the register must show the amount and class of stock held by each member instead of the amount of shares and the particulars relating to shares` FALSE TRUE EQUALS JUST FALSE

-- ---- s 113(5): joint holders --------------------------------------------------------------------------------------
#ASSERT `s 113(5) the register must state the names of each joint holder` TRUE EQUALS JUST TRUE
#ASSERT `s 113(5) the register must state the names of each joint holder` FALSE EQUALS JUST FALSE
#ASSERT `s 113(5) joint holders are regarded for the purposes of Chapter 2 as a single member, so that the register must show a single service address` TRUE EQUALS JUST TRUE
#ASSERT `s 113(5) joint holders are regarded for the purposes of Chapter 2 as a single member, so that the register must show a single service address` FALSE EQUALS JUST FALSE

-- ---- s 113(6): no share capital, more than one class of members --------------------------------------------------
-- arguments: (the company has a share capital) (more than one class of members)
#ASSERT `s 113(6) the register must contain a statement of the class to which each member belongs` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113(6) the register must contain a statement of the class to which each member belongs` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113(6) the register must contain a statement of the class to which each member belongs` FALSE FALSE EQUALS JUST FALSE

-- ---- s 113(6A)(a): arguments (information has changed) (s 113(9) non-traded company) (old information already included) ----
#ASSERT `s 113(6A)(a) the change does not relieve the company from including the old information in the register` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 113(6A)(a) the change does not relieve the company from including the old information in the register` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 113(6A)(a) the change does not relieve the company from including the old information in the register` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 113(6A)(a) the change does not relieve the company from including the old information in the register` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 113(6A)(a) the change does not relieve the company from including the old information in the register` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
-- ---- s 113(6A)(b): arguments (information has changed) (non-traded company) (removal authorised by s 121 or s 125) ----
#ASSERT `s 113(6A)(b) the old information must be retained in the register` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 113(6A)(b) the old information must be retained in the register` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 113(6A)(b) the old information must be retained in the register` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 113(6A)(b) the old information must be retained in the register` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 113(6A)(b) the old information must be retained in the register` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
-- ---- s 113(6A)(c): arguments (information has changed) (non-traded company) ----
#ASSERT `s 113(6A)(c) a note must be included in the register recording the date on which the information changed and the date on which the change was entered` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113(6A)(c) a note must be included in the register recording the date on which the information changed and the date on which the change was entered` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 113(6A)(c) a note must be included in the register recording the date on which the information changed and the date on which the change was entered` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 113(6A)(c) a note must be included in the register recording the date on which the information changed and the date on which the change was entered` TRUE (JUST TRUE) EQUALS JUST TRUE
-- ---- s 113(6B): arguments (information has changed) (s 113(9) traded company) ----
#ASSERT `s 113(6B) the company need not include or retain the old information in the register` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113(6B) the company need not include or retain the old information in the register` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(6B) the company need not include or retain the old information in the register` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 113(6B) the company need not include or retain the old information in the register` TRUE NOTHING EQUALS NOTHING

-- ---- s 113(7): the offence. arguments: (default made) (default without reasonable excuse) (person) (s 1121 in default) ----
#ASSERT `s 113(7) the person commits an offence` FALSE TRUE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113(7) the person commits an offence` TRUE FALSE Company (JUST TRUE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT `s 113(7) the person commits an offence` TRUE FALSE Company (JUST TRUE) EQUALS NOTHING; the offence is introduced by "If", with the reasonable excuse inside the gate, so a default with a reasonable excuse now answers JUST FALSE as s 86(3) and s 167L(1) do (fork F35, repair of 2026-11-12; the other reading is NOTHING, the excuse as an exception outside the offence)
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Director NOTHING EQUALS NOTHING
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE `Company secretary` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Member (JUST TRUE) EQUALS NOTHING
#ASSERT `s 113(7) the person commits an offence` TRUE TRUE Auditor NOTHING EQUALS NOTHING
-- the shared limbs (a) the company, (b) every officer of the company who is in default
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Company (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Director NOTHING EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Company secretary` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Company secretary` NOTHING EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Officer in default` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Officer in default` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` `Officer in default` NOTHING EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Member (JUST TRUE) EQUALS NOTHING
#ASSERT `s 113(7)(a)-(b) the person is the company or an officer of the company who is in default` Court NOTHING EQUALS NOTHING

-- ---- s 113(8): "a fine not exceeding level 3 on the standard scale and, for continued contravention, a daily default fine not exceeding one-tenth of level 3" ----
#ASSERT `s 113(8) the penalty for an offence under s 113` EQUALS (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)

-- ---- s 113(9): arguments for "traded company": (admitted to a relevant market) (admitted to another market outside the United Kingdom) ----
#ASSERT `s 113(9) the market is a relevant market` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113(9) the market is a relevant market` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 113(9) the market is a relevant market` NOTHING EQUALS NOTHING
#ASSERT `s 113(9) the company is a traded company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 113(9) the company is a traded company` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 113(9) the company is a traded company` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 113(9) the company is a traded company` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 113(9) the company is a traded company` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 113(9) the company is a non-traded company` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113(9) the company is a non-traded company` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 113(9) the company is a non-traded company` NOTHING EQUALS NOTHING

-- ---- s 113A(1): "The required information about a member who is an individual is (a) name; (b) a service address" ----
#ASSERT `s 113A(1) the item is required information about a member who is an individual` `s 113A(1)(a) name` EQUALS JUST TRUE
#ASSERT `s 113A(1) the item is required information about a member who is an individual` `s 113A(1)(b) a service address` EQUALS JUST TRUE
#ASSERT `s 113A(1) the item is required information about a member who is an individual` `s 113B(a) corporate or firm name` EQUALS JUST FALSE
#ASSERT `s 113A(1) the item is required information about a member who is an individual` `s 113A(1) another item` EQUALS JUST FALSE
#ASSERT `s 113A(2) the name given is the "name" the section requires` TRUE EQUALS JUST TRUE
#ASSERT `s 113A(2) the name given is the "name" the section requires` FALSE EQUALS JUST FALSE
-- s 113A(3): arguments (the member is a peer) (the member is an individual usually known by a title)
#ASSERT `s 113A(3)(a) the requirement to provide the name may be satisfied by providing the title instead` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(3)(a) the requirement to provide the name may be satisfied by providing the title instead` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(3)(a) the requirement to provide the name may be satisfied by providing the title instead` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(3)(a) the requirement to provide the name may be satisfied by providing the title instead` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(3)(b) the title may be entered in the register of members instead of the forename and surname` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(3)(b) the title may be entered in the register of members instead of the forename and surname` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(3)(b) the title may be entered in the register of members instead of the forename and surname` FALSE FALSE EQUALS JUST FALSE

-- ---- s 113B: arguments (the member is a body corporate or a firm that is a legal person) (item) ----
#ASSERT `s 113B the item is required information about a body corporate or a firm that is a legal person` FALSE `s 113B(a) corporate or firm name` EQUALS NOTHING
#ASSERT `s 113B the item is required information about a body corporate or a firm that is a legal person` TRUE `s 113B(a) corporate or firm name` EQUALS JUST TRUE
#ASSERT `s 113B the item is required information about a body corporate or a firm that is a legal person` TRUE `s 113A(1)(b) a service address` EQUALS JUST TRUE
#ASSERT `s 113B the item is required information about a body corporate or a firm that is a legal person` TRUE `s 113A(1)(a) name` EQUALS JUST FALSE
#ASSERT `s 113B the item is required information about a body corporate or a firm that is a legal person` TRUE `s 113A(1) another item` EQUALS JUST FALSE

-- ---- s 113D(1)-(2): arguments (has become a member) (already provided) (became a member on incorporation and the information is in the application) ----
#ASSERT `s 113D(1) the person must provide the company with the required information about the member, subject to s 113D(2)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 113D(1) the person must provide the company with the required information about the member, subject to s 113D(2)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 113D(1) the person must provide the company with the required information about the member, subject to s 113D(2)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113D(1) the person must provide the company with the required information about the member, subject to s 113D(2)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 113D(1) the person must provide the company with the required information about the member, subject to s 113D(2)` TRUE TRUE TRUE EQUALS JUST FALSE

-- ---- counting "the period of N months beginning with a date" (fork F3): the day before the corresponding date; the last day of the month where there is none ----
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 5 1 2023) 2 EQUALS Date 4 3 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 1 1 2023) 1 EQUALS Date 31 1 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 1 1 2023) 2 EQUALS Date 28 2 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 28 1 2023) 1 EQUALS Date 27 2 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 29 1 2023) 1 EQUALS Date 28 2 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 31 12 2022) 2 EQUALS Date 28 2 2023
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 31 12 2023) 2 EQUALS Date 29 2 2024
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 30 11 2022) 1 EQUALS Date 29 12 2022
#ASSERT `s 113D(3) the last day of the period of months beginning with a date` (Date 15 12 2022) 2 EQUALS Date 14 2 2023

-- ---- s 113D(3): a person who became a member on 5 January 2023 has until 4 March 2023 ----
#ASSERT `s 113D(3) the last day for providing the information` (Date 5 1 2023) EQUALS Date 4 3 2023
#ASSERT `s 113D(3) the number of days from becoming a member to the last day for providing the information` (Date 5 1 2023) EQUALS 58
-- arguments: (the date the person became a member) (the date the information was provided)
#ASSERT `s 113D(3) the person provided the information within the period of two months` (Date 5 1 2023) (Date 5 1 2023) EQUALS JUST TRUE
#ASSERT `s 113D(3) the person provided the information within the period of two months` (Date 5 1 2023) (Date 20 1 2023) EQUALS JUST TRUE
#ASSERT `s 113D(3) the person provided the information within the period of two months` (Date 5 1 2023) (Date 4 3 2023) EQUALS JUST TRUE
#ASSERT `s 113D(3) the person provided the information within the period of two months` (Date 5 1 2023) (Date 5 3 2023) EQUALS JUST FALSE
#ASSERT `s 113D(3) the person provided the information within the period of two months` (Date 5 1 2023) (Date 4 1 2023) EQUALS NOTHING
-- the duty as a regulative rule (day 0 = 5 January 2023, last day = day 58): in time at day 58, in breach by day 59
#TRACE `s 113D(1) the new member must provide the company with the required information within two months (duty)` (Date 5 1 2023) AT 0 WITH
    PARTY Member DOES `s 113D(1) the new member provides the required information` AT 58
#TRACE `s 113D(1) the new member must provide the company with the required information within two months (duty)` (Date 5 1 2023) AT 0 WITH
    (WAITUNTIL 59)

-- ---- s 113E ------------------------------------------------------------------------------------------------------
-- arguments: (the person is a member) (there has been a change)
#ASSERT `s 113E(1) the member must give notice to the company of the change in the required information` FALSE TRUE EQUALS NOTHING
#ASSERT `s 113E(1) the member must give notice to the company of the change in the required information` TRUE FALSE EQUALS NOTHING
#ASSERT `s 113E(1) the member must give notice to the company of the change in the required information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113E(2) the notice must specify the date on which the change occurred` TRUE EQUALS JUST TRUE
#ASSERT `s 113E(2) the notice must specify the date on which the change occurred` FALSE EQUALS NOTHING
-- a change on 1 January 2024 (a leap year): the last day is 29 February 2024
#ASSERT `s 113E(3) the last day for giving notice of the change` (Date 1 1 2024) EQUALS Date 29 2 2024
#ASSERT `s 113E(3) the number of days from the change to the last day for giving notice` (Date 1 1 2024) EQUALS 59
#ASSERT `s 113E(3) the member gave notice of the change within the period of two months` (Date 1 1 2024) (Date 29 2 2024) EQUALS JUST TRUE
#ASSERT `s 113E(3) the member gave notice of the change within the period of two months` (Date 1 1 2024) (Date 1 3 2024) EQUALS JUST FALSE
#ASSERT `s 113E(3) the member gave notice of the change within the period of two months` (Date 1 1 2024) (Date 1 1 2024) EQUALS JUST TRUE
#ASSERT `s 113E(3) the member gave notice of the change within the period of two months` (Date 1 1 2024) (Date 31 12 2023) EQUALS NOTHING
#TRACE `s 113E(1) the member must give notice to the company of the change within two months (duty)` (Date 1 1 2024) AT 0 WITH
    PARTY Member DOES `s 113E(1) the member gives notice of the change in the required information` AT 59
#TRACE `s 113E(1) the member must give notice to the company of the change within two months (duty)` (Date 1 1 2024) AT 0 WITH
    (WAITUNTIL 60)

-- ---- s 113F -------------------------------------------------------------------------------------------------------
-- arguments: (a member or former member) (the purpose is ensuring the register includes the required information)
#ASSERT `s 113F(1) the company may require the person to provide the required information about the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 113F(1) the company may require the person to provide the required information about the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113F(1) the company may require the person to provide the required information about the person` TRUE FALSE EQUALS NOTHING
-- a notice given on 15 January 2023: one month beginning with that date ends on 14 February 2023; on 31 January 2023, on 28 February 2023
#ASSERT `s 113F(2) the last day of the period of one month for complying with the notice` (Date 15 1 2023) EQUALS Date 14 2 2023
#ASSERT `s 113F(2) the last day of the period of one month for complying with the notice` (Date 31 1 2023) EQUALS Date 28 2 2023
-- arguments: (the date the notice is given) (the last day the notice allows)
#ASSERT `s 113F(2) the notice requires compliance within the period of one month` (Date 15 1 2023) (Date 14 2 2023) EQUALS JUST TRUE
#ASSERT `s 113F(2) the notice requires compliance within the period of one month` (Date 15 1 2023) (Date 1 2 2023) EQUALS JUST TRUE
#ASSERT `s 113F(2) the notice requires compliance within the period of one month` (Date 15 1 2023) (Date 15 2 2023) EQUALS JUST FALSE

-- ---- s 113G ------------------------------------------------------------------------------------------------------
-- arguments: (failed to comply with 113D or 113E) (failed to comply with a notice under 113F) (the failure was without reasonable excuse)
#ASSERT `s 113G(1)-(2) the person commits an offence by failing to comply` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 113G(1)-(2) the person commits an offence by failing to comply` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113G(1)-(2) the person commits an offence by failing to comply` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 113G(1)-(2) the person commits an offence by failing to comply` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113G(1)-(2) the person commits an offence by failing to comply` FALSE TRUE FALSE EQUALS NOTHING
-- arguments: (the offence is committed by a firm) (s 1121 in default)
#ASSERT `s 113G(3) an officer of the firm commits the offence also` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113G(3) an officer of the firm commits the offence also` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113G(3) an officer of the firm commits the offence also` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113G(3) an officer of the firm commits the offence also` TRUE NOTHING EQUALS NOTHING
-- s 113G(4): the general limit in a magistrates' court is an input; 12 months is a placeholder here, not a number from the Act
#ASSERT `s 113G(4) the penalty for an offence under s 113G` `on conviction on indictment` (Period OF 12, Months) EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 113G(4) the penalty for an offence under s 113G` `on summary conviction in England and Wales` (Period OF 12, Months) EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 113G(4) the penalty for an offence under s 113G` `on summary conviction in Scotland` (Period OF 12, Months) EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), JUST (`a fine not exceeding the statutory maximum` 0.2), TRUE)
#ASSERT `s 113G(4) the penalty for an offence under s 113G` `on summary conviction in Northern Ireland` (Period OF 12, Months) EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), JUST (`a fine not exceeding the statutory maximum` 0.2), TRUE)
#ASSERT `s 113G(4) the penalty for an offence under s 113G` `on summary conviction` (Period OF 12, Months) EQUALS NOTHING

-- ---- s 113H: "A person commits an offence if, in purported compliance with section 113D or 113E and without reasonable excuse, the person makes a statement that is misleading, false or deceptive in a material particular" ----
-- arguments: (a statement in purported compliance) (misleading, false or deceptive in a material particular) (made without reasonable excuse)
#ASSERT `s 113H(1) the person commits an offence by a false statement in purported compliance with s 113D or s 113E` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113H(1) the person commits an offence by a false statement in purported compliance with s 113D or s 113E` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 113H(1) the person commits an offence by a false statement in purported compliance with s 113D or s 113E` TRUE TRUE TRUE EQUALS JUST TRUE
