#ASSERT `s 113H(2) the person commits an offence by a false statement in purported compliance with a notice under s 113F` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113H(2) the person commits an offence by a false statement in purported compliance with a notice under s 113F` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 113H(2) the person commits an offence by a false statement in purported compliance with a notice under s 113F` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113H(2) the person commits an offence by a false statement in purported compliance with a notice under s 113F` TRUE TRUE FALSE EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT `s 113H(2) the person commits an offence by a false statement in purported compliance with a notice under s 113F` TRUE TRUE FALSE EQUALS NOTHING; the offence is introduced by "If", with the reasonable excuse inside the gate, so a default with a reasonable excuse now answers JUST FALSE as s 86(3) and s 167L(1) do (fork F35, repair of 2026-11-12; the other reading is NOTHING, the excuse as an exception outside the offence)
#ASSERT `s 113H(3) an officer of the firm commits the offence also` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 113H(3) an officer of the firm commits the offence also` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 113H(3) an officer of the firm commits the offence also` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 113H(3) an officer of the firm commits the offence also` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 113H(4) the penalty for an offence under s 113H` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 113H(4) the penalty for an offence under s 113H` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 5 1), NOTHING, FALSE)
#ASSERT `s 113H(4) the penalty for an offence under s 113H` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 5 1), NOTHING, FALSE)
#ASSERT `s 113H(4) the penalty for an offence under s 113H` `on summary conviction` EQUALS NOTHING
