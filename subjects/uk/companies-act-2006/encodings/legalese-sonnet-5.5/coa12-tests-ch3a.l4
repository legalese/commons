IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa12-logic`
IMPORT `coa12-ch7-definitions`
IMPORT `coa12-ch3a-report`

-- coa12-tests-ch3a.l4: tests for coa12-logic.l4, coa12-ch7-definitions.l4 and coa12-ch3a-report.l4 (ss 495-498A, s 539).
-- Every expected value is decided from the text before the run and written beside the assertion. A failing assertion is a finding.
-- Argument order is the GIVEN order of each function.

-- ---- coa12-logic: three-valued helpers (JUST TRUE beats NOTHING beats JUST FALSE for OR; JUST FALSE beats NOTHING beats JUST TRUE for AND)
#ASSERT `coa12 either answer holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `coa12 either answer holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `coa12 either answer holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa12 both answers hold` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `coa12 both answers hold` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `coa12 both answers hold` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa12 the opposite answer` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `coa12 the opposite answer` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `coa12 the opposite answer` NOTHING EQUALS NOTHING
#ASSERT `coa12 the answer for the fact` TRUE EQUALS JUST TRUE
#ASSERT `coa12 the answer for the fact` FALSE EQUALS JUST FALSE

-- ---- coa12-logic: the pound conversion of a penalty (the pounds are INPUTS; the Act states none)
-- "a fine not exceeding the statutory maximum": the fraction 1 is the maximum itself.
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE) 5000 1000 EQUALS JUST 5000
-- "level 3 on the standard scale": level 3 is taken from its own input.
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE) 5000 1000 EQUALS JUST 1000
-- A level other than 3 is not an input here: NOT COVERED.
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 4, 1), NOTHING, FALSE) 5000 1000 EQUALS NOTHING
-- "a fine" with no stated limit, and no fine at all: NOT COVERED.
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE) 5000 1000 EQUALS NOTHING
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on conviction on indictment`, NOTHING, NOTHING, NOTHING, FALSE) 5000 1000 EQUALS NOTHING
-- a fraction of the maximum and a fixed amount
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 0.2), NOTHING, FALSE) 5000 1000 EQUALS JUST 1000
#ASSERT `coa12 the largest fine the penalty allows, in pounds` (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding an amount in pounds` OF 250), NOTHING, FALSE) 5000 1000 EQUALS JUST 250

-- ---- s 539 Minor definitions (ch7)
-- "e-money issuer" means (a) or (b): either borrowed answer makes the person one; both no is the text's no; an unknown makes NOTHING unless the other is yes.
#ASSERT `s 539 the person is an e-money issuer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 539 the person is an e-money issuer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 539 the person is an e-money issuer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 539 the person is an e-money issuer` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 539 the person is an e-money issuer` NOTHING (JUST TRUE) EQUALS JUST TRUE
-- "MiFID investment firm" means an investment firm within Article 2(1A), other than (a), (b) and (c).
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 539 the person is a MiFID investment firm` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 539 the person is a MiFID investment firm` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 539 the person is a MiFID investment firm` (JUST TRUE) NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- "qualified": the report does not state the auditor's unqualified opinion (this Act, or the corresponding legislation where this Act does not apply).
#ASSERT `s 539 the report or statement is qualified` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 539 the report or statement is qualified` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 539 the report or statement is qualified` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 539 the report or statement is qualified` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 539 the report or statement is qualified` FALSE TRUE TRUE EQUALS JUST FALSE
-- "turnover": 1000 less trade discounts 50, VAT 100 and other taxes 20 is 830.
#ASSERT `s 539 the turnover of the company` 1000 50 100 20 EQUALS 830
#ASSERT `s 539 the turnover of the company` 1000 0 0 0 EQUALS 1000
-- "UCITS management company" has the meaning the Glossary gives: the borrowed answer passes through.
#ASSERT `s 539 the person is a UCITS management company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 539 the person is a UCITS management company` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 539 the person is a UCITS management company` NOTHING EQUALS NOTHING

-- ---- s 495(1): the duty to report (private company, copies under s 423; public company, copies laid under s 437)
#ASSERT `s 495(1) the auditor must make a report to the members on the annual accounts` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 495(1) the auditor must make a report to the members on the annual accounts` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- a private company whose copies are not to be sent out: not covered (the scope is "of which copies are ... to be sent out")
#ASSERT `s 495(1) the auditor must make a report to the members on the annual accounts` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- a private company whose copies are to be laid under s 437: limb (b) is for a public company: not covered
#ASSERT `s 495(1) the auditor must make a report to the members on the annual accounts` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 495(1) the auditor must make a report to the members on the annual accounts` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the regulative form runs; no period is stated (see NOTES: traces are read, not asserted)
#TRACE `s 495(1) the auditor's duty to report to the members` AT 0 WITH
    PARTY Auditor DOES `Action of a party` OF Auditor, Member, "make a report to the company's members on the annual accounts" AT 30

-- ---- s 495(2): what the report must include
#ASSERT `s 495(2) the auditor's report includes what the subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(2) the auditor's report includes what the subsection requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 495(2) the auditor's report includes what the subsection requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 495(2) the auditor's report includes what the subsection requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 495(2) the auditor's report includes what the subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- ---- s 495(3): the opinions the report must state (balance sheet, profit and loss account, group accounts, framework, this Act)
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` TRUE FALSE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` FALSE TRUE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- the true and fair statements are required only for the kinds of accounts there are
#ASSERT `s 495(3) the report states clearly each opinion the subsection requires` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- the closing words: an expression Part 15 defines has that meaning; any other is not decided here
#ASSERT `s 495(3) the expression has the same meaning as in Part 15` TRUE EQUALS JUST TRUE
#ASSERT `s 495(3) the expression has the same meaning as in Part 15` FALSE EQUALS NOTHING

-- ---- s 495(3A): micro-entity: disregard / have regard / not covered
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS `s 495(3A) the auditors must disregard the provision`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS `s 495(3A) the auditors must disregard the provision`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST TRUE) FALSE FALSE FALSE TRUE EQUALS `s 495(3A) the auditors must have regard to the provision`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS `s 495(3A) not covered`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS `s 495(3A) not covered`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS `s 495(3A) not covered`
#ASSERT `s 495(3A) the auditors' treatment of the provision of an accounting standard` NOTHING TRUE TRUE FALSE FALSE EQUALS `s 495(3A) not covered`

-- ---- s 495(4): unqualified or qualified; emphasis; going concern; place of establishment
#ASSERT `s 495(4)(a) the report is either unqualified or qualified` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 495(4)(a) the report is either unqualified or qualified` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 495(4)(a) the report is either unqualified or qualified` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(4)(b) the report includes the reference the paragraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(4)(b) the report includes the reference the paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 495(4)(b) the report includes the reference the paragraph requires` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 495(4)(c) the report includes the going concern statement the paragraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 495(4)(c) the report includes the going concern statement the paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 495(4)(c) the report includes the going concern statement the paragraph requires` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 495(4)(d) the report identifies the auditor's place of establishment` TRUE EQUALS JUST TRUE
#ASSERT `s 495(4)(d) the report identifies the auditor's place of establishment` FALSE EQUALS JUST FALSE

