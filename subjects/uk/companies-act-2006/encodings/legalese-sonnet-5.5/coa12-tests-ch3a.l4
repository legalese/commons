#ASSERT `s 496(1) the report includes the statements the subsection requires` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 496(1) the report includes the statements the subsection requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 496(1) the report includes the statements the subsection requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 496(1) the report includes the statements the subsection requires` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 496(1) the report includes the statements the subsection requires` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
