#ASSERT `s 498A(a) the auditor must ascertain whether a corporate governance statement has been prepared` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 498A(a) the auditor must ascertain whether a corporate governance statement has been prepared` TRUE FALSE EQUALS JUST FALSE
