-- ---- s 498: duties of the auditor
-- (1): quoted company (s 385), then (a), (b), (c) investigations enable an opinion
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` (JUST FALSE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` NOTHING FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` (JUST FALSE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 498(1) the auditor has carried out such investigations as the subsection requires` NOTHING TRUE TRUE TRUE EQUALS NOTHING
-- (2)(a), (b), (c): the auditor shall state that fact in his report
#ASSERT `s 498(2)(a) the auditor shall state in his report that adequate accounting records have not been kept` TRUE EQUALS JUST TRUE
#ASSERT `s 498(2)(a) the auditor shall state in his report that adequate accounting records have not been kept` FALSE EQUALS JUST FALSE
#ASSERT `s 498(2)(b) the auditor shall state in his report that the individual accounts are not in agreement with the records and returns` TRUE EQUALS JUST TRUE
#ASSERT `s 498(2)(b) the auditor shall state in his report that the individual accounts are not in agreement with the records and returns` FALSE EQUALS JUST FALSE
#ASSERT `s 498(2)(c) the auditor shall state in his report that the auditable part is not in agreement with the records and returns` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 498(2)(c) the auditor shall state in his report that the auditable part is not in agreement with the records and returns` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 498(2)(c) the auditor shall state in his report that the auditable part is not in agreement with the records and returns` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 498(2)(c) the auditor shall state in his report that the auditable part is not in agreement with the records and returns` NOTHING TRUE EQUALS NOTHING
-- (3)
#ASSERT `s 498(3) the auditor shall state in his report that he did not obtain all the information and explanations` TRUE EQUALS JUST TRUE
#ASSERT `s 498(3) the auditor shall state in his report that he did not obtain all the information and explanations` FALSE EQUALS JUST FALSE
-- (4): quoted company, s 412 requirements not complied with, s 421 requirements not complied with
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` (JUST FALSE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` NOTHING FALSE TRUE EQUALS NOTHING
#ASSERT `s 498(4) the auditor must include in his report a statement giving the required particulars, so far as he is reasonably able to do so` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
-- (5): small companies regime or exemption, and the auditor's opinion that they were not entitled
#ASSERT `s 498(5) the auditor shall state in his report that the directors were not entitled to do so` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 498(5) the auditor shall state in his report that the directors were not entitled to do so` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 498(5) the auditor shall state in his report that the directors were not entitled to do so` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 498(5) the auditor shall state in his report that the directors were not entitled to do so` FALSE FALSE TRUE EQUALS JUST FALSE
-- (6): joint auditors
#ASSERT `s 498(6) the persons appointed must include a statement as to whether they agree` TRUE EQUALS JUST TRUE
#ASSERT `s 498(6) the persons appointed must include a statement as to whether they agree` FALSE EQUALS JUST FALSE
#ASSERT `s 498(6) the joint report includes what the subsection requires` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 498(6) the joint report includes what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 498(6) the joint report includes what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 498(6) the joint report includes what the subsection requires` FALSE FALSE FALSE EQUALS JUST FALSE

