#ASSERT `s 495(5) the persons appointed must jointly make a report` TRUE EQUALS JUST TRUE
#ASSERT `s 495(5) the persons appointed must jointly make a report` FALSE EQUALS JUST FALSE
#ASSERT `s 495(5) the joint report includes what the subsection requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
