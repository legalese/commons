#ASSERT `s 495(5) the joint report includes what the subsection requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 495(5) the joint report includes what the subsection requires` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 495(5) the joint report includes what the subsection requires` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

