#ASSERT `s 1164(4) the group is a banking group` F T F EQUALS JUST TRUE
#ASSERT `s 1164(4) the group is a banking group` F T T EQUALS JUST FALSE
#ASSERT `s 1164(4) the group is a banking group` F F F EQUALS JUST FALSE
