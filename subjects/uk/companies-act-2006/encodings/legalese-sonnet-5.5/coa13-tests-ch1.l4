IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa13-ch1-shares`

-- coa13-tests-ch1.l4: tests for coa13-ch1-shares.l4 (ss 540 to 548). Every expected value is written from the text of the
-- section named beside it, before the code was run. A test of a "not covered" case asserts NOTHING.

§ `Tests for Part 17, Chapter 1`

-- s 540(1): "share" ... means share in the company's share capital. Both sides of a "means".
#ASSERT `s 540(1) the thing is a share in relation to the company` TRUE EQUALS JUST TRUE
#ASSERT `s 540(1) the thing is a share in relation to the company` FALSE EQUALS JUST FALSE

-- s 540(2): shares may no longer be converted into stock (flat negative); any other conversion is not decided.
#ASSERT `s 540(2) the company's shares may be converted into stock` TRUE EQUALS JUST FALSE
#ASSERT `s 540(2) the company's shares may be converted into stock` FALSE EQUALS NOTHING

-- s 540(3): stock created before commencement may be reconverted in accordance with s 620.
#ASSERT `s 540(3) the stock may be reconverted into shares` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 540(3) the stock may be reconverted into shares` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 540(3) the stock may be reconverted into shares` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 540(3) the stock may be reconverted into shares` FALSE (JUST TRUE) EQUALS NOTHING

-- s 540(4)(a): references to shares include stock, except where a distinction is express or implied.
#ASSERT `s 540(4)(a) a reference to shares in the Companies Acts includes stock` FALSE EQUALS JUST TRUE
#ASSERT `s 540(4)(a) a reference to shares in the Companies Acts includes stock` TRUE EQUALS JUST FALSE

-- s 540(4)(b): references to a number of shares include an amount of stock where the context admits.
#ASSERT `s 540(4)(b) a reference to a number of shares in the Companies Acts includes an amount of stock` TRUE EQUALS JUST TRUE
#ASSERT `s 540(4)(b) a reference to a number of shares in the Companies Acts includes an amount of stock` FALSE EQUALS JUST FALSE

-- s 541: personal property (moveable property in Scotland); never real estate (heritage).
#ASSERT `s 541 the shares or other interest of a member are personal property` FALSE EQUALS JUST TRUE
#ASSERT `s 541 the shares or other interest of a member are personal property` TRUE EQUALS NOTHING
#ASSERT `s 541 the shares or other interest of a member are moveable property` TRUE EQUALS JUST TRUE
#ASSERT `s 541 the shares or other interest of a member are moveable property` FALSE EQUALS NOTHING
#ASSERT `s 541 the shares or other interest of a member are in the nature of real estate or, in Scotland, heritage` TRUE EQUALS JUST FALSE
#ASSERT `s 541 the shares or other interest of a member are in the nature of real estate or, in Scotland, heritage` FALSE EQUALS JUST FALSE

-- s 542(1): shares in a limited company having a share capital must each have a fixed nominal value.
#ASSERT `s 542(1) the share meets the requirement of a fixed nominal value` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 542(1) the share meets the requirement of a fixed nominal value` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 542(1) the share meets the requirement of a fixed nominal value` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 542(1) the share meets the requirement of a fixed nominal value` TRUE FALSE FALSE EQUALS NOTHING

-- s 542(2): an allotment of a share that does not have a fixed nominal value is void.
#ASSERT `s 542(2) the allotment is void` FALSE EQUALS JUST TRUE
#ASSERT `s 542(2) the allotment is void` TRUE EQUALS NOTHING

-- s 542(3): any currency, and different classes in different currencies, for a limited company having a share capital.
#ASSERT `s 542(3) the shares may be denominated in any currency, and different classes in different currencies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 542(3) the shares may be denominated in any currency, and different classes in different currencies` FALSE TRUE EQUALS NOTHING
#ASSERT `s 542(3) the shares may be denominated in any currency, and different classes in different currencies` TRUE FALSE EQUALS NOTHING

-- s 542(4): an offence is committed by every officer in default where a company purports to allot in contravention.
#ASSERT `s 542(4) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 542(4) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 542(4) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 542(4) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 542(5): on indictment a fine (no limit stated); on summary conviction a fine not exceeding the statutory maximum.
#ASSERT `s 542(5)(a) penalty on conviction on indictment`'s `how convicted` EQUALS `on conviction on indictment`
#ASSERT `s 542(5)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 542(5)(a) penalty on conviction on indictment`'s `imprisonment not exceeding` EQUALS NOTHING
#ASSERT `s 542(5)(b) penalty on summary conviction`'s `how convicted` EQUALS `on summary conviction`
#ASSERT `s 542(5)(b) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 542(5)(b) penalty on summary conviction`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT (count `s 542(5) the penalties for an offence under section 542`) EQUALS 2

-- s 543(2) and (1): no distinguishing number needed while all the shares (or all of the class) are fully paid and pari passu.
#ASSERT `s 543(2) the share need not have a distinguishing number` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 543(2) the share need not have a distinguishing number` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 543(2) the share need not have a distinguishing number` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 543(2) the share need not have a distinguishing number` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 543(2) the share need not have a distinguishing number` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 543(1) the share must be distinguished by its appropriate number` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 543(1) the share must be distinguished by its appropriate number` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 543(1) the share must be distinguished by its appropriate number` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 543(1) the share must be distinguished by its appropriate number` FALSE (JUST FALSE) EQUALS NOTHING

-- s 544(1) and (2): transferable in accordance with the articles, subject to the 1963 Acts and the Part 21 regulations.
#ASSERT `s 544(1) the shares or other interest of the member are transferable` TRUE EQUALS JUST TRUE
#ASSERT `s 544(1) the shares or other interest of the member are transferable` FALSE EQUALS NOTHING
#ASSERT `s 544(2) the transfer is by a process to which section 544(1) is subject` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 544(2) the transfer is by a process to which section 544(1) is subject` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 544(2) the transfer is by a process to which section 544(1) is subject` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 544(2) the transfer is by a process to which section 544(1) is subject` NOTHING NOTHING EQUALS NOTHING

-- s 545: a company having a share capital is one with power under its constitution to issue shares ("are to": closed).
#ASSERT `s 545 the company is a company having a share capital` TRUE EQUALS JUST TRUE
#ASSERT `s 545 the company is a company having a share capital` FALSE EQUALS JUST FALSE

-- s 546: issued and allotted share capital; shares taken by the subscribers on formation are included.
#ASSERT `s 546(2) the shares are included in issued or allotted shares and share capital as shares taken on the formation` TRUE EQUALS JUST TRUE
#ASSERT `s 546(2) the shares are included in issued or allotted shares and share capital as shares taken on the formation` FALSE EQUALS NOTHING
#ASSERT `s 546(1)(a) the shares are issued share capital` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 546(1)(a) the shares are issued share capital` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 546(1)(a) the shares are issued share capital` FALSE FALSE EQUALS NOTHING
#ASSERT `s 546(1)(b) the shares are allotted share capital` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 546(1)(b) the shares are allotted share capital` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 546(1)(b) the shares are allotted share capital` FALSE FALSE EQUALS NOTHING

-- s 547: called-up share capital = calls made (paid or not) + capital paid up without being called + capital to be paid on a
-- specified future date. Worked: 100 + 20 + 30 = 150. Uncalled share capital is the rest: 500 - 150 = 350.
#ASSERT `s 547 the company's called-up share capital` 100 20 30 EQUALS 150
#ASSERT `s 547 the company's called-up share capital` 0 0 0 EQUALS 0
#ASSERT `s 547 the company's uncalled share capital` 500 150 EQUALS 350
#ASSERT `s 547 the company's uncalled share capital` 500 500 EQUALS 0

-- s 548: equity share capital = issued share capital excluding the part that carries no right to participate beyond a
-- specified amount, as respects dividends or capital. Worked: 1000 issued, 400 of it fixed-return only: 600.
#ASSERT `s 548 the company's equity share capital` 1000 400 EQUALS 600
#ASSERT `s 548 the company's equity share capital` 1000 0 EQUALS 1000
#ASSERT `s 548 the shares are equity share capital` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 548 the shares are equity share capital` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 548 the shares are equity share capital` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 548 the shares are equity share capital` FALSE TRUE TRUE EQUALS JUST FALSE
