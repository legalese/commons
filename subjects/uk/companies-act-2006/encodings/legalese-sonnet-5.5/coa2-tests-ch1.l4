IMPORT prelude
IMPORT `coa-core`
IMPORT `coa2-ch1-prohibited-names`

-- coa2-tests-ch1.l4: tests for coa2-ch1-prohibited-names.l4 (ss 53-57C).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.

-- s 53: "must not be registered ... by a name if, in the opinion of the Secretary of State— (a) its use ... would constitute an offence, or (b) it is offensive"
#ASSERT `s 53 the company may be registered by the name` TRUE FALSE EQUALS JUST FALSE -- limb (a) alone
#ASSERT `s 53 the company may be registered by the name` FALSE TRUE EQUALS JUST FALSE -- limb (b) alone
#ASSERT `s 53 the company may be registered by the name` TRUE TRUE EQUALS JUST FALSE -- both limbs
#ASSERT `s 53 the company may be registered by the name` FALSE FALSE EQUALS NOTHING -- neither opinion held: the section is silent

-- s 53A: intended to facilitate (a) an offence involving dishonesty or deception, (b) conduct that would amount to such an offence in any part of the UK
#ASSERT `s 53A the company may be registered by the name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 53A the company may be registered by the name` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 53A the company may be registered by the name` FALSE FALSE EQUALS NOTHING

-- s 54(2) "local authority" means (a) LGA 1972 / Common Council of the City of London / Council of the Isles of Scilly, (b) a council under s 2 of the 1994 Scottish Act, (c) a district council in Northern Ireland
#ASSERT `s 54(2) the body is a local authority` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (a) within the meaning of the Local Government Act 1972
#ASSERT `s 54(2) the body is a local authority` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (a) the Common Council of the City of London
#ASSERT `s 54(2) the body is a local authority` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) the Council of the Isles of Scilly
#ASSERT `s 54(2) the body is a local authority` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (b)
#ASSERT `s 54(2) the body is a local authority` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- (c)
#ASSERT `s 54(2) the body is a local authority` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- "means": a closed definition

-- s 54(2) "public authority" includes any person or body having functions of a public nature
#ASSERT `s 54(2) the person or body is a public authority` TRUE EQUALS JUST TRUE
#ASSERT `s 54(2) the person or body is a public authority` FALSE EQUALS NOTHING -- "includes": the list is not closed

-- s 54(1): approval required for a name likely to give the impression of a connection with (a) HMG etc, (b) a local authority, (c) a specified public authority
#ASSERT `s 54(1) the approval of the Secretary of State is required` TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE -- limb (a)
#ASSERT `s 54(1) the approval of the Secretary of State is required` TRUE FALSE (JUST TRUE) FALSE EQUALS JUST TRUE -- limb (b)
#ASSERT `s 54(1) the approval of the Secretary of State is required` TRUE FALSE (JUST FALSE) TRUE EQUALS JUST TRUE -- limb (c)
#ASSERT `s 54(1) the approval of the Secretary of State is required` TRUE FALSE (JUST FALSE) FALSE EQUALS NOTHING -- a connection with none of (a) to (c)
#ASSERT `s 54(1) the approval of the Secretary of State is required` FALSE TRUE (JUST TRUE) TRUE EQUALS NOTHING -- no impression of a connection
#ASSERT `s 54(1) the approval of the Secretary of State is required` TRUE FALSE NOTHING FALSE EQUALS NOTHING -- "local authority" not known: stays not covered

-- s 55(1)
#ASSERT `s 55(1) the approval of the Secretary of State is required` TRUE EQUALS JUST TRUE
#ASSERT `s 55(1) the approval of the Secretary of State is required` FALSE EQUALS NOTHING

-- s 56(5) "specified" means specified in the regulations
#ASSERT `s 56(5) the department or body is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 56(5) the department or body is specified` FALSE EQUALS JUST FALSE

-- s 56(2) "Where such a requirement applies, the applicant must request ... (in writing)"
#ASSERT `s 56(2) the applicant must request the specified department or body in writing to indicate whether and why it has any objections` TRUE EQUALS JUST TRUE
#ASSERT `s 56(2) the applicant must request the specified department or body in writing to indicate whether and why it has any objections` FALSE EQUALS JUST FALSE

-- s 56(3): where a request is made in connection with an application for registration, the application must (a) include a statement, (b) be accompanied by a copy of any response received
#ASSERT `s 56(3)(a) the application must include a statement that a request under this section has been made` TRUE EQUALS JUST TRUE
#ASSERT `s 56(3)(a) the application must include a statement that a request under this section has been made` FALSE EQUALS JUST FALSE
#ASSERT `s 56(3)(b) the application must be accompanied by a copy of the response received` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 56(3)(b) the application must be accompanied by a copy of the response received` TRUE FALSE EQUALS JUST FALSE -- no response received: nothing to attach
#ASSERT `s 56(3)(b) the application must be accompanied by a copy of the response received` FALSE TRUE EQUALS JUST FALSE -- no request made

-- s 56(4): where a request is made in connection with a change of name, the notice must be accompanied by (a) a statement by a director or secretary, (b) a copy of any response
#ASSERT `s 56(4)(a) the notice of the change must be accompanied by a statement by a director or secretary that a request has been made` TRUE EQUALS JUST TRUE
#ASSERT `s 56(4)(a) the notice of the change must be accompanied by a statement by a director or secretary that a request has been made` FALSE EQUALS JUST FALSE
#ASSERT `s 56(4)(b) the notice of the change must be accompanied by a copy of the response received` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 56(4)(b) the notice of the change must be accompanied by a copy of the response received` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 56(4)(b) the notice of the change must be accompanied by a copy of the response received` FALSE TRUE EQUALS JUST FALSE

-- s 56A: a name that in the Secretary of State's opinion would be likely to give the false impression of a connection with (a) a foreign government etc, (b) an international organisation
#ASSERT `s 56A the company may be registered by the name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 56A the company may be registered by the name` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 56A the company may be registered by the name` FALSE FALSE EQUALS NOTHING

-- s 57(3): "may not be registered ... by a name that consists of or includes anything that is not permitted"
#ASSERT `s 57(3) the company may be registered by the name` TRUE EQUALS JUST FALSE
#ASSERT `s 57(3) the company may be registered by the name` FALSE EQUALS NOTHING

-- s 57(5) "specified"
#ASSERT `s 57(5) the character, sign, symbol, position or style is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 57(5) the character, sign, symbol, position or style is specified` FALSE EQUALS JUST FALSE

-- s 57A: computer code
#ASSERT `s 57A the company may be registered by the name` TRUE EQUALS JUST FALSE
#ASSERT `s 57A the company may be registered by the name` FALSE EQUALS NOTHING

-- s 57B(3): a new name determined under s 76D (or s 73(4)) counts as "changed following a direction" (or "an order")
#ASSERT `s 57B(3)(a) the name is treated as changed following a direction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57B(3)(a) the name is treated as changed following a direction` FALSE TRUE EQUALS JUST TRUE -- "includes a case where a new name is determined ... under section 76D"
#ASSERT `s 57B(3)(a) the name is treated as changed following a direction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 57B(3)(b) the name is treated as changed following an order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57B(3)(b) the name is treated as changed following an order` FALSE TRUE EQUALS JUST TRUE -- "under section 73(4)"
#ASSERT `s 57B(3)(b) the name is treated as changed following an order` FALSE FALSE EQUALS NOTHING

-- s 57B(2): "But subsection (1) does not prevent the registration of the company by any name approved by the Secretary of State"
#ASSERT `s 57B(2) subsection (1) does not prevent registration of the company by the name` TRUE EQUALS JUST TRUE
#ASSERT `s 57B(2) subsection (1) does not prevent registration of the company by the name` FALSE EQUALS NOTHING

-- s 57B(1): after a direction or order, the company must not subsequently be registered by the original name or a similar one
#ASSERT `s 57B(1) the company may be registered by the name` (JUST TRUE) NOTHING TRUE FALSE EQUALS JUST FALSE -- after a direction, original or similar name
#ASSERT `s 57B(1) the company may be registered by the name` NOTHING (JUST TRUE) TRUE FALSE EQUALS JUST FALSE -- after an order under section 73
#ASSERT `s 57B(1) the company may be registered by the name` (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE -- subsection (2): a name approved by the Secretary of State
#ASSERT `s 57B(1) the company may be registered by the name` (JUST TRUE) NOTHING FALSE FALSE EQUALS NOTHING -- a name that is neither the original nor similar
#ASSERT `s 57B(1) the company may be registered by the name` NOTHING NOTHING TRUE FALSE EQUALS NOTHING -- no direction or order: the section does not apply

-- s 57C(4) "relevant relationship": the person is (a) an officer, or (b) a member or former member
#ASSERT `s 57C(4) the person has a relevant relationship with the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57C(4) the person has a relevant relationship with the company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 57C(4) the person has a relevant relationship with the company` FALSE FALSE EQUALS JUST FALSE

-- s 57C(3): "it is irrelevant whether the person has, or has had, a relevant relationship with both companies at the same time"
#ASSERT `s 57C(3) it matters whether the relationships coincided in time` TRUE EQUALS JUST FALSE
#ASSERT `s 57C(3) it matters whether the relationships coincided in time` FALSE EQUALS JUST FALSE

-- s 57C(5): a new name determined under s 76D (or s 73(4)) counts
#ASSERT `s 57C(5)(a) the company is treated as directed to change its name` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57C(5)(a) the company is treated as directed to change its name` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 57C(5)(a) the company is treated as directed to change its name` FALSE FALSE EQUALS NOTHING
#ASSERT `s 57C(5)(b) the company is treated as ordered to change its name` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57C(5)(b) the company is treated as ordered to change its name` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 57C(5)(b) the company is treated as ordered to change its name` FALSE FALSE EQUALS NOTHING

-- s 57C(2)
#ASSERT `s 57C(2) subsection (1) does not prevent registration of the company by the name` TRUE EQUALS JUST TRUE
#ASSERT `s 57C(2) subsection (1) does not prevent registration of the company by the name` FALSE EQUALS NOTHING

-- s 57C(1): no other company may be registered by that name or a similar one if (a) that company is an existing company and a person has a relevant relationship with both, or (b) an application has been made and on incorporation there will be such a person
-- argument order: directed, ordered, same-or-similar, existing, application made, person now, person on incorporation, approved
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- limb (a)
#ASSERT `s 57C(1) the other company may be registered by the name` NOTHING (JUST TRUE) TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- limb (b), after an order
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- limb (a) but no person with a relevant relationship to both
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING -- a person exists but the other company is not an existing company and no application is made
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING TRUE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING -- limb (b) needs the person to exist on incorporation, not now
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- a name that is neither that name nor similar
#ASSERT `s 57C(1) the other company may be registered by the name` NOTHING NOTHING TRUE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- no company has been directed or ordered
#ASSERT `s 57C(1) the other company may be registered by the name` (JUST TRUE) NOTHING TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- subsection (2): a name approved by the Secretary of State
