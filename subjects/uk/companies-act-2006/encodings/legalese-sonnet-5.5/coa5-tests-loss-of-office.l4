#ASSERT `s 221(4) the conditions are met` TRUE TRUE FALSE EQUALS JUST FALSE

-- s 221(2): other relevant payments are payments for loss of office meeting the conditions in (3) or (4) as the payment in question requires
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(3) a payment to which section 217 applies` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(3) a payment to which section 217 applies` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(4) a payment to which section 218 or 219 applies` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(4) a payment to which section 218 or 219 applies` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(3) a payment to which section 217 applies` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 221(2) the other payment is one of the other relevant payments` `s 221(2) some other payment` TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING

-- s 221(1): made by the company or a subsidiary, and the payment with other relevant payments does not exceed 200 pounds
#ASSERT `s 221(1) approval under section 217, 218 or 219 is not required by this section` TRUE 100 100 EQUALS JUST TRUE
#ASSERT `s 221(1) approval under section 217, 218 or 219 is not required by this section` TRUE 150 51 EQUALS JUST FALSE
#ASSERT `s 221(1) approval under section 217, 218 or 219 is not required by this section` TRUE 200 0 EQUALS JUST TRUE
#ASSERT `s 221(1) approval under section 217, 218 or 219 is not required by this section` TRUE 201 0 EQUALS JUST FALSE
#ASSERT `s 221(1) approval under section 217, 218 or 219 is not required by this section` FALSE 100 0 EQUALS JUST FALSE

§ `Tests: s 222`

-- s 222(1) to (5): which subsection applies, and for whom the payment is held on trust
#ASSERT `s 222(1) subsection (1) applies to the payment` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 222(1) subsection (1) applies to the payment` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 222(1) subsection (1) applies to the payment` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 222(1) subsection (1) applies to the payment` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 222(1) subsection (1) applies to the payment` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 222(2) subsection (2) applies to the payment` TRUE EQUALS JUST TRUE
#ASSERT `s 222(2) subsection (2) applies to the payment` FALSE EQUALS NOTHING
#ASSERT `s 222(3) subsection (3) applies to the payment` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 222(3) subsection (3) applies to the payment` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 222(3) subsection (3) applies to the payment` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 222(3) subsection (3) applies to the payment` FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `s 222 the payment is held by the recipient on trust for` (JUST TRUE) NOTHING NOTHING EQUALS JUST `s 222(1)(a) the company making the payment`
#ASSERT `s 222 the payment is held by the recipient on trust for` (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST `s 222(2) the company whose undertaking or property is or is proposed to be transferred`
#ASSERT `s 222 the payment is held by the recipient on trust for` (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST `s 222(3)(a) the persons who have sold their shares as a result of the offer made`
#ASSERT `s 222 the payment is held by the recipient on trust for` NOTHING NOTHING NOTHING EQUALS NOTHING

#ASSERT `s 222(1)(b) the director is jointly and severally liable to indemnify the company that made the payment` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 222(1)(b) the director is jointly and severally liable to indemnify the company that made the payment` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 222(1)(b) the director is jointly and severally liable to indemnify the company that made the payment` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 222(3)(b) the expenses incurred by the recipient in distributing the sum are borne by him and not retained out of the sum` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 222(3)(b) the expenses incurred by the recipient in distributing the sum are borne by him and not retained out of the sum` NOTHING EQUALS NOTHING
