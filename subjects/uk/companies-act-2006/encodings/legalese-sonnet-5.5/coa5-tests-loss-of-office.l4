IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-loss-of-office`

-- coa5-tests-loss-of-office.l4: tests for ss 215 to 222 (coa5-loss-of-office.l4).
-- Every expected value was decided by reading the section's words and written beside the assertion; none was copied from the code's output.

§ `Tests: s 215`

-- s 215(1): "means a payment made to a director or past director": (a), (c) outright; (b) and (d) only for loss or retirement while director or in connection with ceasing to be one
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(a) compensation for loss of office as director of the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(c) consideration for or in connection with retirement from office as director of the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(b)(i) compensation for loss of any other office or employment in connection with the management of the affairs of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(b)(i) compensation for loss of any other office or employment in connection with the management of the affairs of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(b)(ii) compensation for loss of any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(b)(ii) compensation for loss of any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(d)(i) consideration for or in connection with retirement from any other office or employment in connection with the management of the affairs of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(d)(i) consideration for or in connection with retirement from any other office or employment in connection with the management of the affairs of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(d)(ii) consideration for or in connection with retirement from any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(d)(ii) consideration for or in connection with retirement from any office (as director or otherwise) or employment in connection with the management of the affairs of a subsidiary undertaking of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1) some other payment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215(1) the payment is a payment for loss of office` `s 215(1)(a) compensation for loss of office as director of the company` FALSE TRUE EQUALS JUST FALSE

-- s 215(2): "include benefits otherwise than in cash"
#ASSERT `s 215(2) the benefit counts as compensation, consideration or payment` TRUE EQUALS JUST TRUE
#ASSERT `s 215(2) the benefit counts as compensation, consideration or payment` FALSE EQUALS NOTHING

-- s 215(3): for ss 217 to 221, payment to a connected person, or at the direction of or for the benefit of a director or connected person, is treated as payment to the director
#ASSERT `s 215(3) the payment is treated as payment to the director` `s 215(3)(a) a person connected with a director` TRUE EQUALS JUST TRUE
#ASSERT `s 215(3) the payment is treated as payment to the director` `s 215(3)(b) any person at the direction of, or for the benefit of, a director or a person connected with him` TRUE EQUALS JUST TRUE
#ASSERT `s 215(3) the payment is treated as payment to the director` `s 215(3) the director himself` TRUE EQUALS NOTHING
#ASSERT `s 215(3) the payment is treated as payment to the director` `s 215(3) someone else` TRUE EQUALS NOTHING
#ASSERT `s 215(3) the payment is treated as payment to the director` `s 215(3)(a) a person connected with a director` FALSE EQUALS NOTHING

-- s 215(4): "include payment by another person at the direction of, or on behalf of, the person referred to"
#ASSERT `s 215(4) the payment is treated as a payment by the person` TRUE EQUALS JUST TRUE
#ASSERT `s 215(4) the payment is treated as a payment by the person` FALSE EQUALS NOTHING

-- s 215(5): "Nothing in this section or sections 216 to 222 applies" to a payment to a director of a quoted company, other than one to which s 226C does not apply by virtue of s 226D(6)
#ASSERT `s 215(5) section 215 and sections 216 to 222 apply to the payment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215(5) section 215 and sections 216 to 222 apply to the payment` TRUE TRUE EQUALS NOTHING
#ASSERT `s 215(5) section 215 and sections 216 to 222 apply to the payment` FALSE FALSE EQUALS NOTHING

§ `Tests: s 216`

-- s 216(1): applies where in connection with a transfer under s 218 or 219 the director is to cease to hold office or another office
#ASSERT `s 216(1) this section applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 216(1) this section applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 216(1) this section applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 216(1) this section applies` FALSE TRUE TRUE EQUALS JUST FALSE

-- s 216(2)(a): the excess of the price paid to the director over the price other holders could have obtained is taken to be a payment
#ASSERT `s 216(2)(a) the excess taken to have been a payment for loss of office` (JUST TRUE) 120_000 100_000 EQUALS JUST 20_000
#ASSERT `s 216(2)(a) the excess taken to have been a payment for loss of office` (JUST TRUE) 100_000 100_000 EQUALS JUST 0
#ASSERT `s 216(2)(a) the excess taken to have been a payment for loss of office` (JUST TRUE) 90_000 100_000 EQUALS JUST 0
#ASSERT `s 216(2)(a) the excess taken to have been a payment for loss of office` (JUST FALSE) 120_000 100_000 EQUALS NOTHING
#ASSERT `s 216(2)(a) the excess taken to have been a payment for loss of office` NOTHING 120_000 100_000 EQUALS NOTHING

-- s 216(2)(b): the money value of valuable consideration given to the director by a person other than the company is taken to be a payment
#ASSERT `s 216(2)(b) the money value taken to have been a payment for loss of office` (JUST TRUE) TRUE 5_000 EQUALS JUST 5_000
#ASSERT `s 216(2)(b) the money value taken to have been a payment for loss of office` (JUST TRUE) FALSE 5_000 EQUALS NOTHING
#ASSERT `s 216(2)(b) the money value taken to have been a payment for loss of office` (JUST FALSE) TRUE 5_000 EQUALS NOTHING
#ASSERT `s 216(2)(b) the money value taken to have been a payment for loss of office` NOTHING TRUE 5_000 EQUALS NOTHING

§ `Tests: s 217`

-- s 217(4): no approval of the members of a body corporate that is not a UK-registered company or is a wholly-owned subsidiary
#ASSERT `s 217(4) no approval is required under section 217 on the part of the members of the body corporate` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 217(4) no approval is required under section 217 on the part of the members of the body corporate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 217(4) no approval is required under section 217 on the part of the members of the body corporate` TRUE FALSE EQUALS NOTHING

-- s 217(1): a company may not pay a director of the company unless approved by a resolution of the members
#ASSERT `s 217(1) the company may not make the payment` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 217(1) the company may not make the payment` TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 217(1) the company may not make the payment` TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 217(1) the company may not make the payment` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 217(1) the company may not make the payment` FALSE FALSE NOTHING EQUALS NOTHING

-- s 217(2): a payment to a director of its holding company needs the approval of the members of each of the two companies
#ASSERT `s 217(2) the company may not make the payment` TRUE TRUE TRUE NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 217(2) the company may not make the payment` TRUE TRUE FALSE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 217(2) the company may not make the payment` TRUE FALSE TRUE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 217(2) the company may not make the payment` TRUE FALSE FALSE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 217(2) the company may not make the payment` TRUE TRUE FALSE NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 217(2) the company may not make the payment` TRUE FALSE FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 217(2) the company may not make the payment` TRUE FALSE TRUE (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 217(2) the company may not make the payment` FALSE TRUE TRUE NOTHING NOTHING EQUALS NOTHING

-- s 217(1) and (2) as a duty (traces are read in NOTES.md; a trace cannot be asserted on the stable binary):
--   bar applies, no event: the standing prohibition (residual); bar applies and the Company makes the payment at 3: BREACH by Company
--   bar lifted: FULFILLED.
-- TRACE EXPECT: BREACHED
#TRACE `s 217(1) and (2) the company's duty not to make the payment` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 217 make the payment for loss of office` AT 3

-- TRACE EXPECT: STANDING
#TRACE `s 217(1) and (2) the company's duty not to make the payment` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 5)

-- TRACE EXPECT: FULFILLED
#TRACE `s 217(1) and (2) the company's duty not to make the payment` (JUST FALSE) AT 0 WITH
    PARTY Company DOES `s 217 make the payment for loss of office` AT 3

-- s 217(3): the memorandum.  Fixture ruler: made available, sent to every eligible member in time (written resolution), first day of inspection, date of meeting, available at the meeting
`s 217(3) test: written resolution, memorandum sent in time` MEANS `s 217(3) memorandum` OF TRUE, TRUE, Date 1 1 2025, Date 1 1 2025, FALSE
`s 217(3) test: written resolution, memorandum not sent in time` MEANS `s 217(3) memorandum` OF TRUE, FALSE, Date 1 1 2025, Date 1 1 2025, FALSE
`s 217(3) test: not made available at all` MEANS `s 217(3) memorandum` OF FALSE, TRUE, Date 1 3 2025, Date 20 3 2025, TRUE
`s 217(3) test: meeting, 15 days ending with the meeting date, and at the meeting` MEANS `s 217(3) memorandum` OF TRUE, FALSE, Date 6 3 2025, Date 20 3 2025, TRUE
`s 217(3) test: meeting, 14 days only` MEANS `s 217(3) memorandum` OF TRUE, FALSE, Date 7 3 2025, Date 20 3 2025, TRUE
`s 217(3) test: meeting, 15 days but not at the meeting` MEANS `s 217(3) memorandum` OF TRUE, FALSE, Date 6 3 2025, Date 20 3 2025, FALSE
`s 217(3) test: meeting, 30 days and at the meeting` MEANS `s 217(3) memorandum` OF TRUE, FALSE, Date 18 2 2025, Date 20 3 2025, TRUE

#ASSERT `s 217(3) the resolution approving the payment must not be passed` `as a written resolution` TRUE `s 217(3) test: written resolution, memorandum sent in time` EQUALS JUST FALSE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `as a written resolution` TRUE `s 217(3) test: written resolution, memorandum not sent in time` EQUALS JUST TRUE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a show of hands` TRUE `s 217(3) test: not made available at all` EQUALS JUST TRUE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a show of hands` TRUE `s 217(3) test: meeting, 15 days ending with the meeting date, and at the meeting` EQUALS JUST FALSE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a poll` TRUE `s 217(3) test: meeting, 14 days only` EQUALS JUST TRUE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a show of hands` TRUE `s 217(3) test: meeting, 15 days but not at the meeting` EQUALS JUST TRUE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a poll` TRUE `s 217(3) test: meeting, 30 days and at the meeting` EQUALS JUST FALSE
#ASSERT `s 217(3) the resolution approving the payment must not be passed` `at a meeting on a poll` FALSE `s 217(3) test: meeting, 14 days only` EQUALS NOTHING

