IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-part7-private-to-public`

-- coa2-tests-part7a.l4: tests for coa2-part7-private-to-public.l4 (ss 89-96).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.
-- Amounts in pounds are hypothetical inputs (the authorised minimum is s 763's, outside this part).

-- s 89: a company may by re-registration alter its status (a) private to public, (b) public to private, (c) private limited to unlimited, (d) unlimited private to limited, (e) public to unlimited private
-- (public, private, limited, the alteration)
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE TRUE `s 89(a) from a private company to a public company` EQUALS JUST TRUE
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` TRUE FALSE TRUE `s 89(a) from a private company to a public company` EQUALS NOTHING
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` TRUE FALSE TRUE `s 89(b) from a public company to a private company` EQUALS JUST TRUE
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE TRUE `s 89(b) from a public company to a private company` EQUALS NOTHING
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE TRUE `s 89(c) from a private limited company to an unlimited company` EQUALS JUST TRUE
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE FALSE `s 89(c) from a private limited company to an unlimited company` EQUALS NOTHING -- already unlimited
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` TRUE FALSE TRUE `s 89(c) from a private limited company to an unlimited company` EQUALS NOTHING -- a public company
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE FALSE `s 89(d) from an unlimited private company to a limited company` EQUALS JUST TRUE
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE TRUE `s 89(d) from an unlimited private company to a limited company` EQUALS NOTHING -- already limited
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` TRUE FALSE TRUE `s 89(e) from a public company to an unlimited private company` EQUALS JUST TRUE
#ASSERT `s 89 the company may by re-registration under Part 7 alter its status in that way` FALSE TRUE TRUE `s 89(e) from a public company to an unlimited private company` EQUALS NOTHING

-- the conjunction helper: any JUST FALSE makes JUST FALSE, otherwise any NOTHING makes NOTHING
#ASSERT `s 90(1) all of the answers hold` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 90(1) all of the answers hold` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 90(1) all of the answers hold` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 90(1) all of the answers hold` (LIST JUST TRUE, JUST FALSE, NOTHING) EQUALS JUST FALSE

-- s 90(2): the conditions (a) a share capital, (b) s 91, (c) s 92, (d) if s 93 applies, that its requirements are met, (e) not previously re-registered as unlimited
-- (share capital, s 91, s 92, s 93 applies, s 93 met, previously unlimited)
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING FALSE EQUALS JUST TRUE -- s 93 does not apply
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE -- s 93 applies and is met
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE -- (d)
#ASSERT `s 90(2) the conditions are met` FALSE (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING FALSE EQUALS JUST FALSE -- (a)
#ASSERT `s 90(2) the conditions are met` TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING FALSE EQUALS JUST FALSE -- (b)
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING FALSE EQUALS JUST FALSE -- (c)
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING TRUE EQUALS JUST FALSE -- (e)
#ASSERT `s 90(2) the conditions are met` TRUE (JUST TRUE) (JUST TRUE) NOTHING NOTHING FALSE EQUALS NOTHING -- whether s 93 applies is not known
#ASSERT `s 90(2) the conditions are met` TRUE NOTHING (JUST TRUE) (JUST FALSE) NOTHING FALSE EQUALS NOTHING -- s 91 not known

-- s 90(1): a private company may be re-registered as public if (a) a special resolution is passed, (b) the conditions are met, (c) an application with the documents and a statement of compliance is delivered
-- (private, special resolution, conditions, application delivered, statement of compliance)
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING -- a public company
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE -- (a)
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING -- s 283 not known
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE -- (b)
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE -- (c) no application
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE -- (c)(ii) no statement of compliance
#ASSERT `s 90(1) the private company may be re-registered as a public company limited by shares` TRUE NOTHING (JUST FALSE) TRUE TRUE EQUALS JUST FALSE

-- s 90(3), (4): the company must make the necessary changes in its name and articles; an unlimited company must also become a company limited by shares
#ASSERT `s 90(3)(a) the company must make such changes in its name as are necessary in connection with its becoming a public company` TRUE EQUALS JUST TRUE
#ASSERT `s 90(3)(a) the company must make such changes in its name as are necessary in connection with its becoming a public company` FALSE EQUALS NOTHING
#ASSERT `s 90(3)(b) the company must make such changes in its articles as are necessary in connection with its becoming a public company` TRUE EQUALS JUST TRUE
#ASSERT `s 90(3)(b) the company must make such changes in its articles as are necessary in connection with its becoming a public company` FALSE EQUALS NOTHING
#ASSERT `s 90(4) the company must also make such changes in its articles as are necessary in connection with its becoming a company limited by shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 90(4) the company must also make such changes in its articles as are necessary in connection with its becoming a company limited by shares` TRUE FALSE EQUALS JUST FALSE -- "If the company is unlimited": it is limited
#ASSERT `s 90(4) the company must also make such changes in its articles as are necessary in connection with its becoming a company limited by shares` FALSE TRUE EQUALS NOTHING

-- s 91: test allotments (nominal value, paid on nominal, premium, paid on premium, date, employees' scheme, paid by work undertaking, that undertaking performed, non-cash with undertaking, that undertaking performed, contract within five years)
GIVEN nominal IS A NUMBER
      paidNominal IS A NUMBER
      premium IS A NUMBER
      paidPremium IS A NUMBER
      date IS A DATE
      employee IS A BOOLEAN
      work IS A BOOLEAN
      workDone IS A BOOLEAN
      nonCash IS A BOOLEAN
      nonCashDone IS A BOOLEAN
      contract IS A BOOLEAN
GIVETH A `s 91 allotment`
`s 91 test allotment` MEANS
    `s 91 allotment` WITH
        `nominal value of the shares in the allotment` IS nominal
        `amount paid up on those shares on account of their nominal value` IS paidNominal
        `premium on those shares` IS premium
        `amount paid up on those shares on account of the premium` IS paidPremium
        `date of the allotment` IS date
        `allotted in pursuance of an employees' share scheme` IS employee
        `paid up by an undertaking that he or another should do work or perform services` IS work
        `that undertaking has been performed or otherwise discharged` IS workDone
        `allotted otherwise than in cash, the consideration including an undertaking to the company other than one in paragraph (c)` IS nonCash
        `the undertaking to the company has been performed or otherwise discharged` IS nonCashDone
        `a contract provides for the undertaking to be performed within five years from the time the special resolution is passed` IS contract

-- one quarter of 50,000 is 12,500 and the premium of 10,000 is paid in full
`s 91 test compliant` MEANS `s 91 test allotment` 50000 12500 10000 10000 (Date 1 1 2020) FALSE FALSE FALSE FALSE FALSE FALSE
`s 91 test short of a quarter` MEANS `s 91 test allotment` 50000 12499 10000 10000 (Date 1 1 2020) FALSE FALSE FALSE FALSE FALSE FALSE
`s 91 test premium not paid` MEANS `s 91 test allotment` 50000 12500 10000 9999 (Date 1 1 2020) FALSE FALSE FALSE FALSE FALSE FALSE
-- a shortfall of 5,000 nominal allotted on 1 June 1982
`s 91 test old shortfall of 5000` MEANS `s 91 test allotment` 5000 0 0 0 (Date 1 6 1982) FALSE FALSE FALSE FALSE FALSE FALSE
`s 91 test old shortfall of 6000` MEANS `s 91 test allotment` 6000 0 0 0 (Date 1 6 1982) FALSE FALSE FALSE FALSE FALSE FALSE
`s 91 test new shortfall` MEANS `s 91 test allotment` 5000 0 0 0 (Date 1 1 2020) FALSE FALSE FALSE FALSE FALSE FALSE
-- employees' share scheme allotments, 8,000 nominal, nothing paid
`s 91 test scheme shortfall` MEANS `s 91 test allotment` 8000 0 0 0 (Date 1 1 2020) TRUE FALSE FALSE FALSE FALSE FALSE
`s 91 test scheme shortfall and work undertaking unperformed` MEANS `s 91 test allotment` 8000 0 0 0 (Date 1 1 2020) TRUE TRUE FALSE FALSE FALSE FALSE
`s 91 test scheme fully paid` MEANS `s 91 test allotment` 8000 2000 0 0 (Date 1 1 2020) TRUE FALSE FALSE FALSE FALSE FALSE

-- s 91(1)(b): paid up at least as to one-quarter of the nominal value and the whole of any premium
#ASSERT `s 91(1)(b) the allotment is paid up as the paragraph requires` `s 91 test compliant` EQUALS JUST TRUE -- exactly one quarter
#ASSERT `s 91(1)(b) the allotment is paid up as the paragraph requires` `s 91 test short of a quarter` EQUALS JUST FALSE
#ASSERT `s 91(1)(b) the allotment is paid up as the paragraph requires` `s 91 test premium not paid` EQUALS JUST FALSE
-- s 91(1)(c): an undertaking to do work or perform services must have been performed or discharged
#ASSERT `s 91(1)(c) the allotment meets the paragraph` (`s 91 test allotment` 50000 12500 0 0 (Date 1 1 2020) FALSE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 91(1)(c) the allotment meets the paragraph` (`s 91 test allotment` 50000 12500 0 0 (Date 1 1 2020) FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 91(1)(c) the allotment meets the paragraph` `s 91 test compliant` EQUALS JUST TRUE -- no such undertaking: nothing required (fork 4)
-- s 91(1)(d): another undertaking to the company: performed, or a contract for performance within five years
#ASSERT `s 91(1)(d) the allotment meets the paragraph` (`s 91 test allotment` 50000 12500 0 0 (Date 1 1 2020) FALSE FALSE FALSE TRUE TRUE FALSE) EQUALS JUST TRUE -- (i)
#ASSERT `s 91(1)(d) the allotment meets the paragraph` (`s 91 test allotment` 50000 12500 0 0 (Date 1 1 2020) FALSE FALSE FALSE TRUE FALSE TRUE) EQUALS JUST TRUE -- (ii)
#ASSERT `s 91(1)(d) the allotment meets the paragraph` (`s 91 test allotment` 50000 12500 0 0 (Date 1 1 2020) FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 91(1)(d) the allotment meets the paragraph` `s 91 test compliant` EQUALS JUST TRUE -- allotted for cash: nothing required (fork 4)
-- s 91(2)(a): shares allotted before 22 June 1982 (Great Britain) or before 31 December 1984 (Northern Ireland) may be disregarded
#ASSERT `s 91(2)(a) the allotment may be disregarded` `England and Wales` (`s 91 test allotment` 1 0 0 0 (Date 21 6 1982) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 91(2)(a) the allotment may be disregarded` Scotland (`s 91 test allotment` 1 0 0 0 (Date 21 6 1982) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 91(2)(a) the allotment may be disregarded` `England and Wales` (`s 91 test allotment` 1 0 0 0 (Date 22 6 1982) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING -- "before" 22 June 1982
#ASSERT `s 91(2)(a) the allotment may be disregarded` `England and Wales` (`s 91 test allotment` 1 0 0 0 (Date 1 1 1983) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING -- after the Great Britain date, before the Northern Ireland one
#ASSERT `s 91(2)(a) the allotment may be disregarded` `Northern Ireland` (`s 91 test allotment` 1 0 0 0 (Date 1 1 1983) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 91(2)(a) the allotment may be disregarded` `Northern Ireland` (`s 91 test allotment` 1 0 0 0 (Date 30 12 1984) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 91(2)(a) the allotment may be disregarded` `Northern Ireland` (`s 91 test allotment` 1 0 0 0 (Date 31 12 1984) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- s 91(2)(b): shares under an employees' share scheme that alone preclude paragraph (b)
#ASSERT `s 91(2)(b) the allotment may be disregarded` `s 91 test scheme shortfall` EQUALS JUST TRUE
#ASSERT `s 91(2)(b) the allotment may be disregarded` `s 91 test scheme fully paid` EQUALS NOTHING -- no shortfall to disregard
#ASSERT `s 91(2)(b) the allotment may be disregarded` `s 91 test new shortfall` EQUALS NOTHING -- not under an employees' share scheme
-- s 91(3): no more than one-tenth of the nominal value of the allotted share capital is to be disregarded under (2)(a)
#ASSERT `s 91(3) the disregard under subsection (2)(a) is within the limit` 1000 100 EQUALS JUST TRUE
#ASSERT `s 91(3) the disregard under subsection (2)(a) is within the limit` 1000 101 EQUALS JUST FALSE
-- s 91(1) paragraphs (b) to (d) over all the allotments (county of the company: Great Britain)
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`) `England and Wales` EQUALS JUST TRUE
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test short of a quarter`) `England and Wales` EQUALS JUST FALSE
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test old shortfall of 5000`) `England and Wales` EQUALS JUST TRUE -- 5,000 is within one-tenth of 55,000 (5,500)
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test old shortfall of 6000`) `England and Wales` EQUALS JUST FALSE -- 6,000 is more than one-tenth of 56,000 (5,600)
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test new shortfall`) `England and Wales` EQUALS JUST FALSE -- allotted after the relevant date
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test scheme shortfall`) `England and Wales` EQUALS JUST TRUE -- (2)(b)
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test scheme shortfall and work undertaking unperformed`) `England and Wales` EQUALS JUST FALSE -- (2)(b) excuses only a paragraph (b) shortfall
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test scheme fully paid`) `England and Wales` EQUALS JUST TRUE
#ASSERT `s 91(1) the requirements of paragraphs (b) to (d) are met` (LIST `s 91 test compliant`, `s 91 test old shortfall of 6000`) `Northern Ireland` EQUALS JUST FALSE
-- s 91(4): shares disregarded under (2) do not form part of the allotted share capital for paragraph (a)
#ASSERT `s 91(4) the nominal value of the allotted share capital for paragraph (a)` (LIST `s 91 test compliant`) `England and Wales` EQUALS 50000
#ASSERT `s 91(4) the nominal value of the allotted share capital for paragraph (a)` (LIST `s 91 test compliant`, `s 91 test old shortfall of 5000`) `England and Wales` EQUALS 50000 -- 55,000 less the 5,000 disregarded
#ASSERT `s 91(4) the nominal value of the allotted share capital for paragraph (a)` (LIST `s 91 test compliant`, `s 91 test scheme shortfall`) `England and Wales` EQUALS 50000 -- 58,000 less the 8,000 disregarded
#ASSERT `s 91(4) the nominal value of the allotted share capital for paragraph (a)` (LIST `s 91 test compliant`, `s 91 test scheme fully paid`) `England and Wales` EQUALS 58000 -- a compliant scheme allotment is not disregarded
-- s 91(1)(a): not less than the authorised minimum (hypothetical 50,000)
#ASSERT `s 91(1)(a) the nominal value of the allotted share capital is not less than the authorised minimum` 60000 50000 EQUALS JUST TRUE
#ASSERT `s 91(1)(a) the nominal value of the allotted share capital is not less than the authorised minimum` 50000 50000 EQUALS JUST TRUE -- "not less than"
#ASSERT `s 91(1)(a) the nominal value of the allotted share capital is not less than the authorised minimum` 49999 50000 EQUALS JUST FALSE
-- s 91(5): a company must not be re-registered if it has resolved to reduce its capital by (i) s 626, (ii) a solvency statement (s 643) or (iii) a court order (s 648), taking it below the authorised minimum
-- (resolved to reduce, s 626, s 643, s 648, nominal value after the reduction, the authorised minimum)
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) 49999 50000 EQUALS JUST FALSE -- (b)(i)
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE) 49999 50000 EQUALS JUST FALSE -- (b)(ii)
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) 49999 50000 EQUALS JUST FALSE -- (b)(iii)
#ASSERT `s 91(5) the company may be re-registered as a public company` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) 49999 50000 EQUALS NOTHING -- (a) no resolution
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) 49999 50000 EQUALS NOTHING -- (b) none of the three
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) 50000 50000 EQUALS NOTHING -- (c) not below the minimum
#ASSERT `s 91(5) the company may be re-registered as a public company` TRUE NOTHING (JUST FALSE) (JUST FALSE) 49999 50000 EQUALS NOTHING -- the s 626 answer is not known

-- s 92(1)(a): a balance sheet as at a date not more than seven months before the application is delivered (balance sheet 31 January 2027)
#ASSERT `s 92(1)(a) the balance sheet is prepared as at a date not more than seven months before the application is delivered` (Date 31 1 2027) (Date 31 8 2027) EQUALS JUST TRUE -- seven months to the day
#ASSERT `s 92(1)(a) the balance sheet is prepared as at a date not more than seven months before the application is delivered` (Date 31 1 2027) (Date 31 7 2027) EQUALS JUST TRUE
#ASSERT `s 92(1)(a) the balance sheet is prepared as at a date not more than seven months before the application is delivered` (Date 31 1 2027) (Date 1 9 2027) EQUALS JUST FALSE -- the day after
-- s 92(5): a qualification is material unless the auditor states that it is not material
#ASSERT `s 92(5) a qualification is material` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 92(5) a qualification is material` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 92(5) a qualification is material` FALSE FALSE EQUALS NOTHING -- no qualification
-- s 92(3): an unqualified report states without material qualification the auditor's opinion that the balance sheet has been properly prepared
-- (prepared for a financial year, opinion (a), opinion (b), a material qualification)
#ASSERT `s 92(3) the report is an unqualified report` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE -- (a)
#ASSERT `s 92(3) the report is an unqualified report` FALSE FALSE TRUE NOTHING EQUALS JUST TRUE -- (b)
#ASSERT `s 92(3) the report is an unqualified report` TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE -- the opinion of (b) given for a financial-year balance sheet
#ASSERT `s 92(3) the report is an unqualified report` FALSE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 92(3) the report is an unqualified report` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE -- a material qualification
-- s 92(1)(b): an unqualified report by the company's auditor
#ASSERT `s 92(1)(b) the company has obtained an unqualified report by its auditor on the balance sheet` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 92(1)(b) the company has obtained an unqualified report by its auditor on the balance sheet` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 92(1)(b) the company has obtained an unqualified report by its auditor on the balance sheet` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 92(1)(b) the company has obtained an unqualified report by its auditor on the balance sheet` TRUE NOTHING EQUALS NOTHING
-- s 92(1)(c): the aggregate of called-up share capital and undistributable reserves, and the auditor's written statement
#ASSERT `s 92(1)(c) the aggregate of the company's called-up share capital and undistributable reserves` 40000 7000 EQUALS 47000
#ASSERT `s 92(1)(c) the company has obtained the auditor's written statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 92(1)(c) the company has obtained the auditor's written statement` TRUE FALSE EQUALS JUST FALSE -- a statement that does not say the net assets were not less
#ASSERT `s 92(1)(c) the company has obtained the auditor's written statement` FALSE TRUE EQUALS JUST FALSE
-- s 92(2): no change in the financial position that results in net assets becoming less than the aggregate
-- (net assets and aggregate at the balance sheet date, net assets and aggregate on the application date)
#ASSERT `s 92(2) there is no change in the company's financial position of the kind the subsection excludes` 50000 47000 46999 47000 EQUALS JUST FALSE -- becoming less
#ASSERT `s 92(2) there is no change in the company's financial position of the kind the subsection excludes` 50000 47000 47000 47000 EQUALS JUST TRUE -- equal is not less
#ASSERT `s 92(2) there is no change in the company's financial position of the kind the subsection excludes` 46000 47000 45000 47000 EQUALS JUST TRUE -- already less at the balance sheet date: not "becoming" less
#ASSERT `s 92(2) there is no change in the company's financial position of the kind the subsection excludes` 50000 47000 60000 47000 EQUALS JUST TRUE
-- s 92 together
#ASSERT `s 92 the requirements as to net assets are met` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 92 the requirements as to net assets are met` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 92 the requirements as to net assets are met` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 92 the requirements as to net assets are met` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

-- s 93(1): applies where (a) shares are allotted between the balance sheet date and the resolution and (b) they are allotted otherwise than in cash
#ASSERT `s 93(1) section 93 applies (recent allotment of shares for non-cash consideration)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(1) section 93 applies (recent allotment of shares for non-cash consideration)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 93(1) section 93 applies (recent allotment of shares for non-cash consideration)` FALSE TRUE EQUALS JUST FALSE
-- s 93(7)(b): "arrangement" means any agreement, scheme or arrangement (including those sanctioned under Part 26 or 26A or s 110 of the Insolvency Act 1986)
#ASSERT `s 93(7)(b) the thing is an arrangement` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 93(7)(b) the thing is an arrangement` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(7)(b) the thing is an arrangement` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 93(7)(b) the thing is an arrangement` FALSE FALSE FALSE EQUALS JUST FALSE
-- s 93(4): shares held by the allotting company, its holding company, its subsidiary or a subsidiary of its holding company (or nominees) are disregarded
#ASSERT `s 93(4) the shares are disregarded in determining whether a person is a holder of shares` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 93(4) the shares are disregarded in determining whether a person is a holder of shares` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 93(4) the shares are disregarded in determining whether a person is a holder of shares` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(4) the shares are disregarded in determining whether a person is a holder of shares` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 93(4) the shares are disregarded in determining whether a person is a holder of shares` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 93(3): in connection with a share exchange if (a) allotted under an arrangement with consideration by (i) transfer or (ii) cancellation of shares in another company, and (b) open to all holders
#ASSERT `s 93(3) the allotment is in connection with a share exchange` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- (a)(i)
#ASSERT `s 93(3) the allotment is in connection with a share exchange` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- (a)(ii)
#ASSERT `s 93(3) the allotment is in connection with a share exchange` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- neither transfer nor cancellation
#ASSERT `s 93(3) the allotment is in connection with a share exchange` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- (b) not open to all holders
#ASSERT `s 93(3) the allotment is in connection with a share exchange` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- s 93(5): whether the arrangement involves an issue of shares in the other company is immaterial
#ASSERT `s 93(5) it matters whether the arrangement involves an issue of shares in the other company` TRUE EQUALS JUST FALSE
#ASSERT `s 93(5) it matters whether the arrangement involves an issue of shares in the other company` FALSE EQUALS JUST FALSE
-- s 93(6): a proposed merger (whether or not accompanied by a cash payment); "another company" includes any body corporate
#ASSERT `s 93(6) there is a proposed merger with another company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(6) there is a proposed merger with another company` TRUE TRUE TRUE EQUALS JUST TRUE -- with a cash payment
#ASSERT `s 93(6) there is a proposed merger with another company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 93(6) there is a proposed merger with another company` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 93(6) the body is another company` TRUE EQUALS JUST TRUE
#ASSERT `s 93(6) the body is another company` FALSE EQUALS NOTHING
-- s 93(7)(a): the consideration for an allotment does not include reserves applied in paying up shares
#ASSERT `s 93(7)(a) the amount counts as consideration for the allotment` TRUE EQUALS JUST FALSE
#ASSERT `s 93(7)(a) the amount counts as consideration for the allotment` FALSE EQUALS NOTHING
-- s 93(2): the registrar shall not entertain the application unless (a) s 593(1) is complied with or (b) a share exchange or merger
-- (s 93 applies, s 593(1) complied with, share exchange, proposed merger)
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE -- (a)
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- (b)(i)
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE -- (b)(ii)
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING -- s 93 does not apply
#ASSERT `s 93(2) the registrar may entertain the application for re-registration` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

-- s 94(1): the application must contain (a) a statement of the proposed name, (b) in the case of a company without a secretary, a statement of its proposed secretary
#ASSERT `s 94(1) the application contains what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 94(1) the application contains what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE -- (b) missing for a company without a secretary
#ASSERT `s 94(1) the application contains what the subsection requires` TRUE FALSE FALSE EQUALS JUST TRUE -- the company has a secretary
#ASSERT `s 94(1) the application contains what the subsection requires` FALSE FALSE FALSE EQUALS JUST FALSE -- (a) missing
#ASSERT `s 94(1) the application contains what the subsection requires` TRUE FALSE TRUE EQUALS JUST TRUE -- the company has a secretary and a proposed secretary is stated anyway
#ASSERT `s 94(1) the application contains what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- s 94(2): accompanied by (a) a copy of the resolution (unless already forwarded), (b) the articles, (c) the balance sheet and documents, (d) the valuation report if s 93 applies, (e) a statement of the amount paid up
-- (resolution copy, already forwarded, articles, balance sheet, s 93 applies and a report exists, report copy, statement of amount)
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` FALSE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- (a) already forwarded
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` FALSE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- (a)
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- (b)
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- (c)
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (d) with the report
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- (d) report not copied
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- (e)
#ASSERT `s 94(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- a valuation report copy accompanies although s 93 does not apply
-- s 94(3), (4)
#ASSERT `s 94(3) the statement meets the description of the statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 94(3) the statement meets the description of the statement of compliance` FALSE EQUALS JUST FALSE
#ASSERT `s 94(4) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a public company` TRUE EQUALS JUST TRUE
#ASSERT `s 94(4) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a public company` FALSE EQUALS NOTHING

-- s 95(1): the statement contains the required information (individuals: s 279J; corporate secretaries and firms: s 279K)
#ASSERT `s 95(1) the statement of the company's proposed secretary contains the required information` `s 95(2) an individual` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 95(1) the statement of the company's proposed secretary contains the required information` `s 95(2) an individual` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 95(1) the statement of the company's proposed secretary contains the required information` `s 95(2) a corporate secretary or a firm` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 95(1) the statement of the company's proposed secretary contains the required information` `s 95(2) a corporate secretary or a firm` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 95(1) the statement of the company's proposed secretary contains the required information` `s 95(2) an individual` NOTHING (JUST TRUE) EQUALS NOTHING
-- s 95(3): the statement must include the company's statement of consent; one partner may consent on behalf of all
#ASSERT `s 95(3) the statement of the proposed secretary includes the company's statement of consent` TRUE EQUALS JUST TRUE
#ASSERT `s 95(3) the statement of the proposed secretary includes the company's statement of consent` FALSE EQUALS JUST FALSE
#ASSERT `s 95(3) consent may be given by one partner on behalf of all of them` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 95(3) consent may be given by one partner on behalf of all of them` TRUE FALSE EQUALS NOTHING
#ASSERT `s 95(3) consent may be given by one partner on behalf of all of them` FALSE TRUE EQUALS NOTHING

-- s 96(1)-(5): the certificate of incorporation on re-registration as a public company (certificate issued 10 April 2027)
#ASSERT `s 96(1) the company shall be re-registered as a public company` TRUE EQUALS JUST TRUE
#ASSERT `s 96(1) the company shall be re-registered as a public company` FALSE EQUALS JUST FALSE
#ASSERT `s 96(2) the registrar must issue a certificate of incorporation altered to meet the circumstances of the case` TRUE EQUALS JUST TRUE
#ASSERT `s 96(2) the registrar must issue a certificate of incorporation altered to meet the circumstances of the case` FALSE EQUALS NOTHING
#ASSERT `s 96(3) the certificate meets the requirement of subsection (3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 96(3) the certificate meets the requirement of subsection (3)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 96(3) the certificate meets the requirement of subsection (3)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 96(4)(a) the company is a public company on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 96(4)(a) the company is a public company on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(4)(a) the company is a public company on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 96(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(4)(b) the changes in the company's name and articles have taken effect on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(4)(c) the person named in the statement as secretary is deemed to have been appointed on the day` TRUE (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 96(4)(c) the person named in the statement as secretary is deemed to have been appointed on the day` FALSE (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS NOTHING -- the application contained no statement under s 95
#ASSERT `s 96(4)(c) the person named in the statement as secretary is deemed to have been appointed on the day` TRUE (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(4)(c) the person named in the statement as secretary is deemed to have been appointed on the day` TRUE NOTHING (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 96(5) the certificate is conclusive evidence that the requirements of this Act as to re-registration have been complied with` TRUE EQUALS JUST TRUE
#ASSERT `s 96(5) the certificate is conclusive evidence that the requirements of this Act as to re-registration have been complied with` FALSE EQUALS NOTHING

-- s 92(4): for an auditor's report on a balance sheet not prepared for a financial year, the provisions of this Act apply with such modifications as are necessary
#ASSERT `s 92(4) the provisions of this Act apply to the auditor's report with such modifications as are necessary` TRUE EQUALS JUST TRUE
#ASSERT `s 92(4) the provisions of this Act apply to the auditor's report with such modifications as are necessary` FALSE EQUALS NOTHING
-- s 92(6): "net assets" and "undistributable reserves" have the same meaning as in s 831: the figure is that section's
#ASSERT `s 92(6) the amount of the company's net assets or undistributable reserves` 12345 EQUALS 12345
