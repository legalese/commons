IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa25-part40`

-- coa25-tests-part40.l4: tests for coa25-part40.l4 (ss 1182 to 1191).
-- Every expected value was decided by reading the section and written down before the run. The general limit in a
-- magistrates' court (12 months below) is a TEST number: the Act does not state it.

-- The penalties s 1186(2) and s 1191(2) state, written out by hand from the text.
`s 1186 test penalty on indictment` MEANS
    Penalty WITH `how convicted` IS `on conviction on indictment`
                 `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 2, unit IS Years)
                 `fine not exceeding` IS JUST `a fine without a stated limit`
                 `daily default fine for continued contravention` IS NOTHING
                 `imprisonment and fine together` IS TRUE

GIVEN months IS A NUMBER
GIVETH A Penalty
`s 1186 test penalty on summary conviction in England and Wales` MEANS
    Penalty WITH `how convicted` IS `on summary conviction in England and Wales`
                 `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS months, unit IS Months)
                 `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1)
                 `daily default fine for continued contravention` IS NOTHING
                 `imprisonment and fine together` IS TRUE

`s 1186 test penalty on summary conviction in Scotland` MEANS
    Penalty WITH `how convicted` IS `on summary conviction in Scotland`
                 `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 6, unit IS Months)
                 `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1)
                 `daily default fine for continued contravention` IS NOTHING
                 `imprisonment and fine together` IS TRUE

`s 1186 test penalty on summary conviction in Northern Ireland` MEANS
    Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`
                 `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 6, unit IS Months)
                 `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1)
                 `daily default fine for continued contravention` IS NOTHING
                 `imprisonment and fine together` IS TRUE

-- ---- s 1182(3)
#ASSERT `s 1182(3) the activity is acting in connection with the affairs of a company` `s 1182 being a director of a company` EQUALS JUST TRUE
#ASSERT `s 1182(3) the activity is acting in connection with the affairs of a company` `s 1182 acting as receiver of a company's property` EQUALS JUST TRUE
#ASSERT `s 1182(3) the activity is acting in connection with the affairs of a company` `s 1182 being concerned or taking part in the promotion, formation or management of a company` EQUALS JUST TRUE
#ASSERT `s 1182(3) the activity is acting in connection with the affairs of a company` `s 1182 any other activity` EQUALS JUST FALSE

-- ---- s 1182(2) (arguments: under the law outside the United Kingdom; the activity; (a) disqualified; (b) required to obtain permission or meet a condition; (c) undertakings given)
#ASSERT `s 1182(2) the person is subject to foreign restrictions` TRUE `s 1182 being a director of a company` TRUE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 1182(2) the person is subject to foreign restrictions` TRUE `s 1182 acting as receiver of a company's property` FALSE TRUE FALSE EQUALS JUST TRUE -- (b)
#ASSERT `s 1182(2) the person is subject to foreign restrictions` TRUE `s 1182 being concerned or taking part in the promotion, formation or management of a company` FALSE FALSE TRUE EQUALS JUST TRUE -- (c)
#ASSERT `s 1182(2) the person is subject to foreign restrictions` TRUE `s 1182 being a director of a company` FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a) to (c)
#ASSERT `s 1182(2) the person is subject to foreign restrictions` FALSE `s 1182 being a director of a company` TRUE TRUE TRUE EQUALS JUST FALSE -- not under the law of a country or territory outside the United Kingdom
#ASSERT `s 1182(2) the person is subject to foreign restrictions` TRUE `s 1182 any other activity` TRUE TRUE TRUE EQUALS JUST FALSE -- not acting in connection with the affairs of a company

-- ---- s 1182(4)
#ASSERT `s 1182(4)(a) the body is a company for the purposes of s 1182` TRUE EQUALS JUST TRUE
#ASSERT `s 1182(4)(a) the body is a company for the purposes of s 1182` FALSE EQUALS JUST FALSE
#ASSERT `s 1182(4)(b) the person is a director of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 1182(4)(b) the person is a director of the company` FALSE EQUALS JUST FALSE
#ASSERT `s 1182(4)(b) the officer is a receiver of the company` TRUE FALSE EQUALS JUST TRUE -- (arguments: a receiver; a corresponding officer)
#ASSERT `s 1182(4)(b) the officer is a receiver of the company` FALSE TRUE EQUALS JUST TRUE -- "includes any corresponding officer"
#ASSERT `s 1182(4)(b) the officer is a receiver of the company` FALSE FALSE EQUALS NOTHING

-- ---- s 1183
#ASSERT `s 1183 the courts that are "the court" in Part 40 for the part of the United Kingdom` `England and Wales` EQUALS LIST `s 1183 the High Court in England and Wales`, `s 1183 the county court`
#ASSERT `s 1183 the courts that are "the court" in Part 40 for the part of the United Kingdom` Scotland EQUALS LIST `s 1183 the Court of Session`, `s 1183 the sheriff court`
#ASSERT `s 1183 the courts that are "the court" in Part 40 for the part of the United Kingdom` `Northern Ireland` EQUALS LIST `s 1183 the High Court in Northern Ireland`
#ASSERT `s 1183 the tribunal is the court` `England and Wales` `s 1183 the county court` EQUALS JUST TRUE
#ASSERT `s 1183 the tribunal is the court` `England and Wales` `s 1183 the sheriff court` EQUALS JUST FALSE
#ASSERT `s 1183 the tribunal is the court` Scotland `s 1183 the Court of Session` EQUALS JUST TRUE
#ASSERT `s 1183 the tribunal is the court` Scotland `s 1183 the High Court in Northern Ireland` EQUALS JUST FALSE
#ASSERT `s 1183 the tribunal is the court` `Northern Ireland` `s 1183 the High Court in Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 1183 the tribunal is the court` `Northern Ireland` `s 1183 the High Court in England and Wales` EQUALS JUST FALSE
#ASSERT `s 1183 the company is a UK company` TRUE EQUALS JUST TRUE
#ASSERT `s 1183 the company is a UK company` FALSE EQUALS JUST FALSE

-- ---- s 1184(3) (arguments: accepted by the Secretary of State under the regulations; from a person subject to foreign restrictions; that he will not breach a disqualification)
#ASSERT `s 1184(3) the undertaking is a disqualification undertaking` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1184(3) the undertaking is a disqualification undertaking` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1184(3) the undertaking is a disqualification undertaking` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1184(3) the undertaking is a disqualification undertaking` TRUE TRUE FALSE EQUALS JUST FALSE

-- ---- s 1184(4) (arguments for (a): disqualified automatically; disqualified by court order; has given and is subject to an undertaking)
#ASSERT `s 1184(4)(a) the person is a person disqualified under this Part` TRUE FALSE FALSE EQUALS JUST TRUE -- (2)(a)
#ASSERT `s 1184(4)(a) the person is a person disqualified under this Part` FALSE TRUE FALSE EQUALS JUST TRUE -- (2)(b)
#ASSERT `s 1184(4)(a) the person is a person disqualified under this Part` FALSE FALSE TRUE EQUALS JUST TRUE -- (ii)
#ASSERT `s 1184(4)(a) the person is a person disqualified under this Part` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1184(4)(b) the act is a breach of a disqualification` TRUE FALSE EQUALS JUST TRUE -- (arguments: a breach of a disqualification; a breach of a disqualification undertaking)
#ASSERT `s 1184(4)(b) the act is a breach of a disqualification` FALSE TRUE EQUALS JUST TRUE -- "include a breach of a disqualification undertaking"
#ASSERT `s 1184(4)(b) the act is a breach of a disqualification` FALSE FALSE EQUALS NOTHING

-- ---- s 1186(2) and (3) (arguments: how convicted; the date the offence was committed; the general limit in months)
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on conviction on indictment` (Date 1 1 2020) 12 EQUALS JUST `s 1186 test penalty on indictment`
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on conviction on indictment` (Date 1 1 2030) 12 EQUALS JUST `s 1186 test penalty on indictment`
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 1 5 2022) 12 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 6) -- 1 May 2022: before 2 May 2022, so six months
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 2 5 2022) 12 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 12) -- 2 May 2022: the general limit
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 31 12 2021) 12 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 6)
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 1 1 2026) 9 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 9) -- whatever the general limit is
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in Scotland` (Date 1 1 2026) 12 EQUALS JUST `s 1186 test penalty on summary conviction in Scotland` -- six months, whatever the general limit
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction in Northern Ireland` (Date 1 1 2026) 12 EQUALS JUST `s 1186 test penalty on summary conviction in Northern Ireland`
#ASSERT `s 1186(2) the greatest penalty that the regulations may provide` `on summary conviction` (Date 1 1 2026) 12 EQUALS NOTHING

-- ---- s 1191(2) and (3)
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on conviction on indictment` (Date 1 1 2026) 12 EQUALS JUST `s 1186 test penalty on indictment`
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 1 5 2022) 12 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 6)
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on summary conviction in England and Wales` (Date 2 5 2022) 12 EQUALS JUST (`s 1186 test penalty on summary conviction in England and Wales` 12)
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on summary conviction in Scotland` (Date 1 1 2026) 12 EQUALS JUST `s 1186 test penalty on summary conviction in Scotland`
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on summary conviction in Northern Ireland` (Date 1 1 2026) 12 EQUALS JUST `s 1186 test penalty on summary conviction in Northern Ireland`
#ASSERT `s 1191(2) the greatest penalty that the regulations may provide` `on summary conviction` (Date 1 1 2026) 12 EQUALS NOTHING

-- ---- s 1187(2), (3) (arguments for (2): personally responsible by virtue of s 1187; the other)
#ASSERT `s 1187(2) the person is jointly and severally liable with the other` TRUE `s 1187 the company` EQUALS JUST TRUE
#ASSERT `s 1187(2) the person is jointly and severally liable with the other` TRUE `s 1187 another person who is liable for the debts and liabilities, by virtue of s 1187 or otherwise` EQUALS JUST TRUE
#ASSERT `s 1187(2) the person is jointly and severally liable with the other` TRUE `s 1187 someone else` EQUALS NOTHING
#ASSERT `s 1187(2) the person is jointly and severally liable with the other` FALSE `s 1187 the company` EQUALS NOTHING
#ASSERT `s 1187(3) the person is involved in the management of the company` TRUE FALSE EQUALS JUST TRUE -- (arguments: concerned directly or indirectly; takes part)
#ASSERT `s 1187(3) the person is involved in the management of the company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1187(3) the person is involved in the management of the company` FALSE FALSE EQUALS JUST FALSE

-- ---- s 1190(5)
#ASSERT `s 1190(5) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1190(5) the matter is specified` FALSE EQUALS JUST FALSE
