IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-ch2-company-type`

-- coa2-tests-ch2.l4: tests for coa2-ch2-company-type.l4 (ss 58-65).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.
-- Amounts in pounds used below are hypothetical inputs (the Act does not state what a level on the standard scale is).

-- s 58(1): "The name of a limited company that is a public company must end with" ...; s 58(3): not community interest companies
-- (limited, public, community interest company)
#ASSERT `s 58(1) the name of the company must end with public limited company or p.l.c.` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 58(1) the name of the company must end with public limited company or p.l.c.` TRUE TRUE TRUE EQUALS JUST FALSE -- s 58(3)
#ASSERT `s 58(1) the name of the company must end with public limited company or p.l.c.` TRUE FALSE FALSE EQUALS NOTHING -- a private limited company
#ASSERT `s 58(1) the name of the company must end with public limited company or p.l.c.` FALSE TRUE FALSE EQUALS NOTHING -- not a limited company

-- s 58(1)-(2): the ending; (2) a Welsh company may instead end with "cwmni cyfyngedig cyhoeddus" or "c.c.c."
-- (the section applies, ends in English, Welsh company, ends in Welsh)
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST TRUE) TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST TRUE) FALSE (JUST TRUE) TRUE EQUALS JUST TRUE -- a Welsh company, Welsh ending
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST FALSE -- Welsh ending but not a Welsh company
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST TRUE) FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST TRUE) FALSE NOTHING TRUE EQUALS NOTHING -- Welsh ending, "Welsh company" not known
#ASSERT `s 58(1) the name of the company ends as the section requires` (JUST FALSE) TRUE (JUST FALSE) FALSE EQUALS NOTHING -- the section does not apply
#ASSERT `s 58(1) the name of the company ends as the section requires` NOTHING TRUE (JUST FALSE) FALSE EQUALS NOTHING -- whether it applies is not known

-- s 59(1): limited private company; s 59(3): exempt companies (s 60); s 59(4): not community interest companies
-- (limited, private, community interest company, exempt)
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE -- s 59(3)
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` TRUE TRUE FALSE NOTHING EQUALS NOTHING -- exemption not known
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE -- s 59(4)
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` FALSE TRUE FALSE (JUST FALSE) EQUALS NOTHING -- an unlimited company
#ASSERT `s 59(1) the name of the company must end with limited or ltd.` TRUE FALSE FALSE (JUST FALSE) EQUALS NOTHING -- a public company

-- s 59(1)-(2): the ending; (2) a Welsh company may instead end with "cyfyngedig" or "cyf."
#ASSERT `s 59(1) the name of the company ends as the section requires` (JUST TRUE) TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 59(1) the name of the company ends as the section requires` (JUST TRUE) FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 59(1) the name of the company ends as the section requires` (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 59(1) the name of the company ends as the section requires` (JUST TRUE) FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 59(1) the name of the company ends as the section requires` (JUST FALSE) TRUE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 59(1) the name of the company ends as the section requires` NOTHING TRUE (JUST FALSE) FALSE EQUALS NOTHING

-- s 61(1): a private company limited by shares that (a) on 25th February 1982 was registered in Great Britain and had a name without "limited" by licence, or (b) on 30th June 1983 was registered in Northern Ireland and had such a name
-- (private limited by shares, GB 1982, GB name, NI 1983, NI name)
#ASSERT `s 61(1) the section applies to the company` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 61(1) the section applies to the company` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 61(1) the section applies to the company` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- registered on that date but the name had "limited"
#ASSERT `s 61(1) the section applies to the company` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING -- neither limb complete
#ASSERT `s 61(1) the section applies to the company` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING -- not a private company limited by shares

-- s 61(1)(a) and (b): the dates the text states
#ASSERT `s 61(1)(a) the date on which the company must have been registered in Great Britain` EQUALS Date 25 2 1982
#ASSERT `s 61(1)(b) the date on which the company must have been registered in Northern Ireland` EQUALS Date 30 6 1983

-- s 61(3): the first condition: the objects are the promotion of commerce, art, science, education, religion, charity or any profession ...
#ASSERT `s 61(3) the first condition is met` TRUE EQUALS JUST TRUE
#ASSERT `s 61(3) the first condition is met` FALSE EQUALS JUST FALSE

-- s 61(4): the second condition: the articles (a) require income to be applied in promoting objects, (b) prohibit dividends or return of capital, (c) require assets on winding up to go (i) to a body with similar objects or (ii) to a charity body
-- (income, no dividends or return of capital, assets to similar body, assets to charity body)
#ASSERT `s 61(4) the second condition is met` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- (c)(i)
#ASSERT `s 61(4) the second condition is met` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- (c)(ii)
#ASSERT `s 61(4) the second condition is met` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a) missing
#ASSERT `s 61(4) the second condition is met` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- (b) missing
#ASSERT `s 61(4) the second condition is met` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- (c) missing

-- s 61(2): exempt from s 59 so long as (a) it continues to meet the two conditions and (b) it does not change its name
-- (section applies, first condition, second condition, changed its name)
#ASSERT `s 61(2) the company is exempt from section 59` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 61(2) the company is exempt from section 59` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE -- (b) broken
#ASSERT `s 61(2) the company is exempt from section 59` (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE -- first condition broken
#ASSERT `s 61(2) the company is exempt from section 59` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE -- second condition broken
#ASSERT `s 61(2) the company is exempt from section 59` (JUST TRUE) NOTHING (JUST TRUE) FALSE EQUALS NOTHING -- a condition not known
#ASSERT `s 61(2) the company is exempt from section 59` (JUST FALSE) (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING -- "A company to which this section applies"
#ASSERT `s 61(2) the company is exempt from section 59` NOTHING (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING

-- s 62(2) first condition, s 62(3) second condition (note (b): dividends only, no return of capital)
#ASSERT `s 62(2) the first condition is met` TRUE EQUALS JUST TRUE
#ASSERT `s 62(2) the first condition is met` FALSE EQUALS JUST FALSE
#ASSERT `s 62(3) the second condition is met` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 62(3) the second condition is met` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 62(3) the second condition is met` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 62(3) the second condition is met` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 62(3) the second condition is met` TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- s 62(1): a private company limited by guarantee that immediately before commencement was exempt and had a name without "limited" is exempt so long as ...
-- (private limited by guarantee, was exempt, had such a name, first condition, second condition, changed its name)
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE TRUE NOTHING (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 62(1) the company is exempt from section 59` FALSE TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING -- not limited by guarantee
#ASSERT `s 62(1) the company is exempt from section 59` TRUE FALSE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING -- was not exempt before commencement
#ASSERT `s 62(1) the company is exempt from section 59` TRUE TRUE FALSE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING -- name included "limited"

-- s 60(1): a private company is exempt from s 59 if (a) a charity, (b) exempted by regulations, (c) meets the conditions in s 61 or s 62
-- (private, charity, exempted by regulations, s 61 exemption, s 62 exemption)
#ASSERT `s 60(1) the private company is exempt from section 59` FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING -- a public company: the section speaks of a private company
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE -- (a)
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE -- (b)
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- (c) s 61
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE -- (c) s 62
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE -- none of (a) to (c)
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE NOTHING (JUST FALSE) EQUALS NOTHING -- s 61 answer not known
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE (JUST FALSE) NOTHING EQUALS NOTHING -- s 62 answer not known
#ASSERT `s 60(1) the private company is exempt from section 59` TRUE FALSE FALSE NOTHING (JUST TRUE) EQUALS JUST TRUE -- one route is enough

-- s 60(2): the registrar may refuse a private limited company's name without "limited" unless a statement of exemption has been delivered
-- (private limited company, name lacks "limited", statement delivered)
#ASSERT `s 60(2) the registrar may refuse to register the company by the name` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 60(2) the registrar may refuse to register the company by the name` TRUE TRUE TRUE EQUALS JUST FALSE -- "unless a statement has been delivered"
#ASSERT `s 60(2) the registrar may refuse to register the company by the name` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 60(2) the registrar may refuse to register the company by the name` TRUE FALSE FALSE EQUALS NOTHING -- the name includes "limited"

-- s 60(3): the registrar may accept the statement as sufficient evidence
#ASSERT `s 60(3) the registrar may accept the statement as sufficient evidence of the matters stated in it` TRUE EQUALS JUST TRUE
#ASSERT `s 60(3) the registrar may accept the statement as sufficient evidence of the matters stated in it` FALSE EQUALS NOTHING

-- s 63(1): an exempt private company whose name lacks "limited" must not amend its articles so that it ceases to comply with the conditions
-- (private, exempt under s 61 or 62, name lacks "limited", amendment would cease to comply)
#ASSERT `s 63(1) the company may amend its articles as proposed` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 63(1) the company may amend its articles as proposed` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 63(1) the company may amend its articles as proposed` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING -- not an exempt company
#ASSERT `s 63(1) the company may amend its articles as proposed` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING -- its name includes "limited"
#ASSERT `s 63(1) the company may amend its articles as proposed` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING -- the amendment keeps the conditions
#ASSERT `s 63(1) the company may amend its articles as proposed` TRUE NOTHING TRUE TRUE EQUALS NOTHING -- exemption not known

-- s 63(1) as a duty (a prohibition on the company, no time limit): doing the act is the breach; otherwise the prohibition stays standing
#TRACE `s 63(1) the company's duty not to amend its articles` AT 0 WITH
    PARTY Company DOES `s 63(1) amend its articles so that it ceases to comply with the conditions for exemption under that section` AT 5
-- TRACE-EXPECT: BREACHED

#TRACE `s 63(1) the company's duty not to amend its articles` AT 0 WITH
    (WAITUNTIL 400)
-- TRACE-EXPECT: MUST NOT

-- s 63(2): if (1) is contravened an offence is committed by (a) the company and (b) every officer in default; a shadow director is treated as an officer
-- (subsection (1) contravened, the person, the officer is in default)
#ASSERT `s 63(2) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE -- no contravention
#ASSERT `s 63(2) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE -- (a)
#ASSERT `s 63(2) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE -- (b)
#ASSERT `s 63(2) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 63(2) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING -- an officer not in default
#ASSERT `s 63(2) the person commits an offence` TRUE Director NOTHING EQUALS NOTHING -- default not known
#ASSERT `s 63(2) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 63(2) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS JUST TRUE -- "a shadow director is treated as an officer"
#ASSERT `s 63(2) the person commits an offence` TRUE `Shadow director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 63(2) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING -- not named

-- s 63(3): level 5 on the standard scale on summary conviction; the daily default fine is in two wordings (fork 1)
#ASSERT (`s 63(3) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 63(3) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 63(3) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT `s 63(3) the daily default fine in pounds on the first wording` 50000 EQUALS 5000 -- one-tenth of a hypothetical level 5 of 50,000
#ASSERT `s 63(3) the daily default fine in pounds on the second wording` 2500 EQUALS 500 -- one-tenth of the greater of 5,000 and a hypothetical level 4 of 2,500
#ASSERT `s 63(3) the daily default fine in pounds on the second wording` 20000 EQUALS 2000 -- one-tenth of the greater of 5,000 and a hypothetical level 4 of 20,000
#ASSERT `s 63(3) the daily default fine in pounds on the second wording` 5000 EQUALS 500 -- equal: either is the greater

-- s 64(1): the Secretary of State may direct a change of name if it appears that (a) the company has ceased to be entitled to exemption under s 60(1)(a) or (b), or (b) a company within s 61 or 62 has carried on other business or acted inconsistently
-- (name lacks "limited", ceased to be exempt, within s 61 or 62, other business, acted inconsistently)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE -- (b)(i)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- (b)(ii)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING -- (b) needs a company within s 61 or 62 -- RECONCILED 2026-11-12: was #ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 10)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 64(1) the Secretary of State may direct the company to change its name` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 10)
#ASSERT `s 64(1) the Secretary of State may direct the company to change its name` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- the name already includes "limited" -- RECONCILED 2026-11-12: was #ASSERT `s 64(1) the Secretary of State may direct the company to change its name` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 10)

-- s 64(2): the direction must be in writing and must specify the period
#ASSERT `s 64(2) the direction meets the requirements of subsection (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 64(2) the direction meets the requirements of subsection (2)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 64(2) the direction meets the requirements of subsection (2)` FALSE TRUE EQUALS JUST FALSE

-- s 64(2A): at least 28 days beginning with the date of the direction: 1 March to 28 March is 28 days
#ASSERT `s 64(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- exactly 28 days
#ASSERT `s 64(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 27 3 2027) EQUALS JUST FALSE -- 27 days
#ASSERT `s 64(2A) the period meets the requirement of subsection (2A)` (Date 5 12 2026) (Date 1 1 2027) EQUALS JUST TRUE -- 5 December to 1 January is 28 days
#ASSERT `s 64(2A) the period meets the requirement of subsection (2A)` (Date 5 12 2026) (Date 31 12 2026) EQUALS JUST FALSE -- 27 days

-- s 64(2B): a further direction in writing, given before the end of the period for the time being specified (fork 2: the last day counts as before the end)
#ASSERT `s 64(2B) the Secretary of State may give a further direction extending the period` TRUE (Date 28 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `s 64(2B) the Secretary of State may give a further direction extending the period` TRUE (Date 27 3 2027) (Date 28 3 2027) EQUALS JUST TRUE
#ASSERT `s 64(2B) the Secretary of State may give a further direction extending the period` TRUE (Date 29 3 2027) (Date 28 3 2027) EQUALS JUST FALSE -- after the period has ended
#ASSERT `s 64(2B) the Secretary of State may give a further direction extending the period` FALSE (Date 1 3 2027) (Date 28 3 2027) EQUALS NOTHING -- not in writing -- RECONCILED 2026-11-12: was #ASSERT `s 64(2B) the Secretary of State may give a further direction extending the period` FALSE (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST FALSE; the function is named for a power, the "in writing" complement failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 18)

-- s 64(3): a change of name to comply may be made by resolution of the directors; without prejudice to any other method
#ASSERT `s 64(3) the company may change its name by resolution of the directors` TRUE EQUALS JUST TRUE
#ASSERT `s 64(3) the company may change its name by resolution of the directors` FALSE EQUALS NOTHING
#ASSERT `s 64(3) the resolution method does not prejudice another method of changing the name` TRUE EQUALS JUST TRUE
#ASSERT `s 64(3) the resolution method does not prejudice another method of changing the name` FALSE EQUALS NOTHING

-- s 64(4): where a resolution of the directors is passed under (3), the company must give notice to the registrar
#ASSERT `s 64(4) the company must give notice to the registrar of the change` TRUE EQUALS JUST TRUE
#ASSERT `s 64(4) the company must give notice to the registrar of the change` FALSE EQUALS JUST FALSE

-- s 64(5): the duty to comply with the direction, within the period it specifies (28 days here)
#TRACE `s 64(5) the company's duty to change its name as directed` 28 AT 0 WITH
    PARTY Company DOES `s 64 change the company's name so that it ends with “limited” or one of the permitted alternatives` AT 28
-- TRACE-EXPECT: FULFILLED

#TRACE `s 64(5) the company's duty to change its name as directed` 28 AT 0 WITH
    (WAITUNTIL 29)
-- TRACE-EXPECT: BREACHED

-- s 64(5): who commits the offence: the company and every officer in default (no shadow-director sentence in this section)
#ASSERT `s 64(5) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 64(5) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 64(5) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE
#ASSERT `s 64(5) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 64(5) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 64(5) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 64(5) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS NOTHING -- silent: no sentence treating a shadow director as an officer in this section
#ASSERT `s 64(5) the person commits an offence` TRUE Registrar (JUST TRUE) EQUALS NOTHING

-- s 64(6): level 5 on summary conviction; the daily default fine in two wordings (fork 1)
#ASSERT (`s 64(6) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 64(6) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 5 1)
#ASSERT (`s 64(6) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT `s 64(6) the daily default fine in pounds on the first wording` 50000 EQUALS 5000
#ASSERT `s 64(6) the daily default fine in pounds on the second wording` 2500 EQUALS 500
#ASSERT `s 64(6) the daily default fine in pounds on the second wording` 20000 EQUALS 2000

-- s 64(6A): where a direction is given under (1), the registrar may omit the name from the public register
#ASSERT `s 64(6A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` TRUE EQUALS JUST TRUE
#ASSERT `s 64(6A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` FALSE EQUALS JUST FALSE

-- s 64(7): a company directed to change its name may not, without approval, later change to a name without "limited"; not on re-registration or conversion to a CIC
-- (directed, new name lacks "limited", change on re-registration or conversion)
#ASSERT `s 64(7) the approval of the Secretary of State is required for the change of name` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 64(7) the approval of the Secretary of State is required for the change of name` TRUE TRUE TRUE EQUALS JUST FALSE -- "This does not apply to a change of name on re-registration or on conversion"
#ASSERT `s 64(7) the approval of the Secretary of State is required for the change of name` FALSE TRUE FALSE EQUALS NOTHING -- a company never directed
#ASSERT `s 64(7) the approval of the Secretary of State is required for the change of name` TRUE FALSE FALSE EQUALS NOTHING -- the new name includes "limited"

-- s 65(3): a name that consists of or includes anything prohibited by regulations; s 65(4) "specified"
#ASSERT `s 65(3) the company may be registered by the name` TRUE EQUALS JUST FALSE
#ASSERT `s 65(3) the company may be registered by the name` FALSE EQUALS NOTHING
#ASSERT `s 65(4) the word, expression, indication, part of the name or accompanying word is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 65(4) the word, expression, indication, part of the name or accompanying word is specified` FALSE EQUALS JUST FALSE
