IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-small`

-- Tests of ss 380 to 385 (scheme of Part 15, small companies regime, micro-entities, quoted companies).
-- Every expected value was written from the text before the run.

-- s 380(1)
#ASSERT `s 380(1) the requirements of this Part as to accounts and reports apply in relation to the period` TRUE EQUALS JUST TRUE
#ASSERT `s 380(1) the requirements of this Part as to accounts and reports apply in relation to the period` FALSE EQUALS NOTHING

-- s 381: applies where the company (a) qualifies as small and (b) is not excluded
#ASSERT `s 381 the small companies regime applies to the company for the financial year` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 381 the small companies regime applies to the company for the financial year` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 381 the small companies regime applies to the company for the financial year` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 381 the small companies regime applies to the company for the financial year` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 381 the small companies regime applies to the company for the financial year` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 381 the small companies regime applies to the company for the financial year` NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 381 the small companies regime applies to the company for the financial year` (JUST FALSE) NOTHING EQUALS JUST FALSE

-- s 382(3): the three figures in the table
#ASSERT `s 382(3) the turnover limit, in pounds` EQUALS 15000000
#ASSERT `s 382(3) the balance sheet total limit, in pounds` EQUALS 7500000
#ASSERT `s 382(3) the employees limit` EQUALS 50
-- s 382(4), (5), (6)
#ASSERT `s 382(4) the maximum figure for turnover adjusted to the length of the period` 15000000 0.5 EQUALS 7500000
#ASSERT `s 382(4) the maximum figure for turnover adjusted to the length of the period` 15000000 1 EQUALS 15000000
#ASSERT `s 382(5) the balance sheet total` (LIST 1000000, 2500000) EQUALS 3500000
#ASSERT `s 382(5) the balance sheet total` EMPTY EQUALS 0
#ASSERT `s 382(6) the number of employees` (LIST 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10) EQUALS JUST 10
#ASSERT `s 382(6) the number of employees` (LIST 10, 20) EQUALS JUST 15
#ASSERT `s 382(6) the number of employees` (LIST 10, 11, 12) EQUALS JUST 11
#ASSERT `s 382(6) the number of employees` EMPTY EQUALS NOTHING
-- the three requirements, on both sides of each limit (turnover limit adjusted by the proportion of a year)
#ASSERT `s 382(3) row 1 the turnover is not more than the limit` 15000000 1 EQUALS JUST TRUE
#ASSERT `s 382(3) row 1 the turnover is not more than the limit` 15000001 1 EQUALS JUST FALSE
#ASSERT `s 382(3) row 1 the turnover is not more than the limit` 7500000 0.5 EQUALS JUST TRUE
#ASSERT `s 382(3) row 1 the turnover is not more than the limit` 7500001 0.5 EQUALS JUST FALSE
#ASSERT `s 382(3) row 2 the balance sheet total is not more than the limit` 7500000 EQUALS JUST TRUE
#ASSERT `s 382(3) row 2 the balance sheet total is not more than the limit` 7500001 EQUALS JUST FALSE
#ASSERT `s 382(3) row 3 the number of employees is not more than the limit` 50 EQUALS JUST TRUE
#ASSERT `s 382(3) row 3 the number of employees is not more than the limit` 51 EQUALS JUST FALSE
#ASSERT `s 382(3) row 3 the number of employees is not more than the limit` 50.5 EQUALS JUST FALSE
-- two or more of the three
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000000 7500000 50 1 EQUALS JUST TRUE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000001 7500000 50 1 EQUALS JUST TRUE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000000 7500001 50 1 EQUALS JUST TRUE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000000 7500000 51 1 EQUALS JUST TRUE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000001 7500001 50 1 EQUALS JUST FALSE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000001 7500000 51 1 EQUALS JUST FALSE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000000 7500001 51 1 EQUALS JUST FALSE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 15000001 7500001 51 1 EQUALS JUST FALSE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 7500001 7500000 50 0.5 EQUALS JUST TRUE
#ASSERT `s 382(3) the qualifying conditions are met in the year` 7500001 7500001 50 0.5 EQUALS JUST FALSE
-- s 382(1): first financial year
#ASSERT `s 382(1) the company qualifies as small in its first financial year` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 382(1) the company qualifies as small in its first financial year` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382(1) the company qualifies as small in its first financial year` NOTHING EQUALS NOTHING
-- s 382(2): this year met?, previous year met?, qualified as small in the previous year? A change counts only if it occurs in two consecutive years
#ASSERT `s 382(2) the change in whether the qualifying conditions are met affects the company's qualification` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 382(2) the change in whether the qualifying conditions are met affects the company's qualification` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 382(2) the change in whether the qualifying conditions are met affects the company's qualification` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 382(2) the change in whether the qualifying conditions are met affects the company's qualification` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 382(2) the change in whether the qualifying conditions are met affects the company's qualification` TRUE TRUE FALSE EQUALS JUST TRUE
-- s 382(1A): a subsequent year (a small company stays small until it fails in two consecutive years; a larger one becomes small only after two)
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 382(1A) the company qualifies as small in a subsequent financial year` FALSE TRUE FALSE EQUALS JUST FALSE

-- s 383(1): a parent company qualifies as small only if its group does
#ASSERT `s 383(1) the parent company qualifies as a small company` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 383(1) the parent company qualifies as a small company` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 383(1) the parent company qualifies as a small company` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 383(1) the parent company qualifies as a small company` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 383(1) the parent company qualifies as a small company` NOTHING (JUST TRUE) EQUALS NOTHING
-- s 383(4): the group's table, net or gross
#ASSERT `s 383(4) the aggregate turnover limit, net, in pounds` EQUALS 15000000
#ASSERT `s 383(4) the aggregate turnover limit, gross, in pounds` EQUALS 18000000
#ASSERT `s 383(4) the aggregate balance sheet total limit, net, in pounds` EQUALS 7500000
#ASSERT `s 383(4) the aggregate balance sheet total limit, gross, in pounds` EQUALS 9000000
#ASSERT `s 383(4) the aggregate number of employees limit` EQUALS 50
#ASSERT `s 383(6) the requirement is satisfied on the net or the gross basis` 15000000 20000000 15000000 18000000 EQUALS JUST TRUE
#ASSERT `s 383(6) the requirement is satisfied on the net or the gross basis` 16000000 18000000 15000000 18000000 EQUALS JUST TRUE
#ASSERT `s 383(6) the requirement is satisfied on the net or the gross basis` 16000000 18000001 15000000 18000000 EQUALS JUST FALSE
#ASSERT `s 383(4) row 1 the aggregate turnover is not more than the limit` 15000000 20000000 EQUALS JUST TRUE
#ASSERT `s 383(4) row 1 the aggregate turnover is not more than the limit` 15000001 18000000 EQUALS JUST TRUE
#ASSERT `s 383(4) row 1 the aggregate turnover is not more than the limit` 15000001 18000001 EQUALS JUST FALSE
#ASSERT `s 383(4) row 2 the aggregate balance sheet total is not more than the limit` 7500000 10000000 EQUALS JUST TRUE
#ASSERT `s 383(4) row 2 the aggregate balance sheet total is not more than the limit` 7500001 9000000 EQUALS JUST TRUE
#ASSERT `s 383(4) row 2 the aggregate balance sheet total is not more than the limit` 7500001 9000001 EQUALS JUST FALSE
#ASSERT `s 383(4) row 3 the aggregate number of employees is not more than the limit` 50 EQUALS JUST TRUE
#ASSERT `s 383(4) row 3 the aggregate number of employees is not more than the limit` 51 EQUALS JUST FALSE
#ASSERT `s 383(4) the qualifying conditions are met by the group in the year` 15000000 20000000 7500000 10000000 50 EQUALS JUST TRUE
#ASSERT `s 383(4) the qualifying conditions are met by the group in the year` 16000000 19000000 7500000 9000000 50 EQUALS JUST TRUE
#ASSERT `s 383(4) the qualifying conditions are met by the group in the year` 16000000 19000000 8000000 9500000 50 EQUALS JUST FALSE
#ASSERT `s 383(4) the qualifying conditions are met by the group in the year` 15000000 18000000 7500000 9000000 51 EQUALS JUST TRUE
#ASSERT `s 383(4) the qualifying conditions are met by the group in the year` 16000000 19000000 7500000 9000000 51 EQUALS JUST FALSE
-- s 383(2), (2A), (3)
#ASSERT `s 383(2) the group qualifies as small in the parent company's first financial year` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 383(2) the group qualifies as small in the parent company's first financial year` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 383(2) the group qualifies as small in the parent company's first financial year` NOTHING EQUALS NOTHING
#ASSERT `s 383(3) the change in whether the group meets the qualifying conditions affects the group's qualification` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 383(3) the change in whether the group meets the qualifying conditions affects the group's qualification` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 383(3) the change in whether the group meets the qualifying conditions affects the group's qualification` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 383(2A) the group qualifies as small in a subsequent financial year` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 383(2A) the group qualifies as small in a subsequent financial year` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 383(2A) the group qualifies as small in a subsequent financial year` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 383(2A) the group qualifies as small in a subsequent financial year` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 383(2A) the group qualifies as small in a subsequent financial year` TRUE TRUE FALSE EQUALS JUST TRUE
-- s 383(5), (6), (7)
#ASSERT `s 383(5) the aggregate figure` (LIST 10, 20, 30) EQUALS 60
#ASSERT `s 383(5) the aggregate figure` EMPTY EQUALS 0
#ASSERT `s 383(6) the net figure` `s 383(6)(a) Companies Act accounts` 20000000 (JUST 4000000) (JUST 1) EQUALS JUST 16000000
#ASSERT `s 383(6) the net figure` `s 383(6)(b) IAS accounts` 20000000 (JUST 4000000) (JUST 1) EQUALS JUST 19999999
#ASSERT `s 383(6) the net figure` `s 383(6)(a) Companies Act accounts` 20000000 NOTHING (JUST 1) EQUALS NOTHING
#ASSERT `s 383(6) the net figure` `s 383(6)(b) IAS accounts` 20000000 (JUST 4000000) NOTHING EQUALS NOTHING
#ASSERT `s 383(6) the gross figure` 20000000 EQUALS 20000000
#ASSERT `s 383(7) which financial year's figures are taken for the subsidiary undertaking` TRUE TRUE EQUALS `s 383(7)(a) the subsidiary undertaking's financial year that ends with that of the parent company`
#ASSERT `s 383(7) which financial year's figures are taken for the subsidiary undertaking` FALSE TRUE EQUALS `s 383(7)(b) the subsidiary undertaking's financial year ending last before the end of the financial year of the parent company`
#ASSERT `s 383(7) which financial year's figures are taken for the subsidiary undertaking` TRUE FALSE EQUALS `s 383(7) the latest available figures`
#ASSERT `s 383(7) which financial year's figures are taken for the subsidiary undertaking` FALSE FALSE EQUALS `s 383(7) the latest available figures`

-- s 384(3): a small company for the purposes of subsection (2)
#ASSERT `s 384(3) the company is a small company for the purposes of subsection (2)` TRUE EQUALS JUST TRUE
