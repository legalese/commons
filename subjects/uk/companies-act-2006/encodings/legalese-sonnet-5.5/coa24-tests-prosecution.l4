#ASSERT elem "section 70 of the Criminal Procedure (Scotland) Act 1995" (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` Scotland)
#ASSERT elem "section 143 of the Criminal Procedure (Scotland) Act 1995" (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` Scotland)
#ASSERT count (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` `Northern Ireland`) EQUALS 3
#ASSERT elem "section 18 of the Criminal Justice Act (Northern Ireland) 1945" (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` `Northern Ireland`)
#ASSERT elem "Article 166 of the Magistrates' Courts (Northern Ireland) Order 1981" (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` `Northern Ireland`)
#ASSERT elem "Schedule 4 to the Magistrates' Courts (Northern Ireland) Order 1981" (`s 1130(2)(b) the provisions that apply as they apply in relation to a body corporate` `Northern Ireland`)
#ASSERT `s 1130(3) the fine is paid as the subsection requires` TRUE `s 1130(3) the funds of the body` EQUALS JUST TRUE
#ASSERT `s 1130(3) the fine is paid as the subsection requires` TRUE `s 1130(3) the personal funds of a member of the body` EQUALS JUST FALSE
#ASSERT `s 1130(3) the fine is paid as the subsection requires` FALSE `s 1130(3) the personal funds of a member of the body` EQUALS NOTHING

§ `Tests for s 1132`

