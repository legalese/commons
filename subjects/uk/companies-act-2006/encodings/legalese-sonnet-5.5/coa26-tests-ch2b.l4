IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa26-support`
IMPORT `coa26-ch2b`

-- Tests for coa26-ch2b.l4 (ss 1217-1222). Expected values are written by hand from the text.

-- s 1217(1): a supervisory body is a UK body (corporate or not) that maintains and enforces binding rules on eligibility and conduct.
-- order: UK, body corporate or unincorporated association, eligibility rules, conduct rules, binding because of membership
#ASSERT `s 1217(1) the body is a supervisory body` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1217(1) the body is a supervisory body` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1217(1) the body is a supervisory body` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1217(1) the body is a supervisory body` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1217(1) the body is a supervisory body` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1217(1) the body is a supervisory body` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- s 1217(1A)
#ASSERT `s 1217(1A) the specified rules of Schedule 10 must also be binding on the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1217(1A) the specified rules of Schedule 10 must also be binding on the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1217(1A) the specified rules of Schedule 10 must also be binding on the person` FALSE TRUE EQUALS NOTHING
-- s 1217(2): members are those subject to the rules, whether or not members
#ASSERT `s 1217(2) the person is a member of the supervisory body` TRUE EQUALS JUST TRUE
#ASSERT `s 1217(2) the person is a member of the supervisory body` FALSE EQUALS JUST FALSE
-- s 1217(3)
#ASSERT `s 1217(3) the rule is a rule of the supervisory body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1217(3) the rule is a rule of the supervisory body` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1217(3) the rule is a rule of the supervisory body` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1217(3) the rule on admission or expulsion is included among the rules of the supervisory body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1217(3) the rule on admission or expulsion is included among the rules of the supervisory body` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1217(3) the rule on admission or expulsion is included among the rules of the supervisory body` FALSE TRUE EQUALS NOTHING
-- s 1217(4): Schedule 10's answer passes through
#ASSERT `s 1217(4) the supervisory body is a recognised supervisory body for the purposes of Part 42` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1217(4) the supervisory body is a recognised supervisory body for the purposes of Part 42` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1217(4) the supervisory body is a recognised supervisory body for the purposes of Part 42` NOTHING EQUALS NOTHING

-- s 1218(2): the closed list of exempt persons
#ASSERT `s 1218(2) the person is within subsection (2)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(2) the person is within subsection (2)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(2) the person is within subsection (2)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1218(2) the person is within subsection (2)` FALSE FALSE FALSE EQUALS JUST FALSE
-- s 1218(3): the functions the exemption reaches (each of the five limbs alone, then none)
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1218(3) subsection (1) applies to the function of the recognised supervisory body` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 1218(4)
#ASSERT `s 1218(4) the guidance is guidance issued by the recognised supervisory body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1218(4) the guidance is guidance issued by the recognised supervisory body` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1218(4) the guidance is guidance issued by the recognised supervisory body` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1218(4) the guidance on admission or expulsion is included as guidance issued by the recognised supervisory body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1218(4) the guidance on admission or expulsion is included as guidance issued by the recognised supervisory body` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1218(4) the guidance on admission or expulsion is included as guidance issued by the recognised supervisory body` FALSE TRUE EQUALS NOTHING
-- s 1218(5): bad faith, or the Human Rights Act 1998 section 6(1) ground, takes the case out of subsection (1)
#ASSERT `s 1218(5) subsection (1) does not apply to the act or omission` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1218(5) subsection (1) does not apply to the act or omission` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1218(5) subsection (1) does not apply to the act or omission` FALSE FALSE EQUALS JUST FALSE
-- s 1218(1): no liability in damages when within (2), within (3), and not excepted by (5); NOTHING otherwise (never JUST TRUE)
#ASSERT `s 1218(1) the person is liable in damages for anything done or omitted in the discharge or purported discharge of the function` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1218(1) the person is liable in damages for anything done or omitted in the discharge or purported discharge of the function` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1218(1) the person is liable in damages for anything done or omitted in the discharge or purported discharge of the function` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1218(1) the person is liable in damages for anything done or omitted in the discharge or purported discharge of the function` (JUST TRUE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1218(1) the person is liable in damages for anything done or omitted in the discharge or purported discharge of the function` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING

-- s 1219(2): began a course before 1 January 1990; obtained on or after 1 January 1990 and before 1 January 1996; approved before 1 October 2018
-- order: began, UK accountancy qualification, obtained, approval date (if any)
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 1 1 1990) (JUST (Date 30 9 2018)) EQUALS JUST TRUE
#ASSERT `s 1219(2) the person is within this subsection` (Date 1 1 1990) TRUE (Date 1 1 1990) (JUST (Date 30 9 2018)) EQUALS JUST FALSE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) FALSE (Date 1 1 1990) (JUST (Date 30 9 2018)) EQUALS JUST FALSE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 31 12 1989) (JUST (Date 30 9 2018)) EQUALS JUST FALSE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 31 12 1995) (JUST (Date 30 9 2018)) EQUALS JUST TRUE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 1 1 1996) (JUST (Date 30 9 2018)) EQUALS JUST FALSE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 1 1 1990) (JUST (Date 1 10 2018)) EQUALS JUST FALSE
#ASSERT `s 1219(2) the person is within this subsection` (Date 31 12 1989) TRUE (Date 1 1 1990) NOTHING EQUALS JUST FALSE

-- s 1219(1): "if and only if". Each limb alone; none holding; a borrowed answer unknown.
-- order: (a) obtained in UK, Schedule 11 answer, (b)(i), (b)(ii), (c)(i), (c)(ii), (d) answer, (f) answer, direction applies, holds the additional qualifications
-- (a) a recognised professional qualification obtained in the United Kingdom
#ASSERT `s 1219(1) the person holds an appropriate qualification` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
-- (a) obtained in the UK but the qualification is not recognised under Schedule 11, no other limb
#ASSERT `s 1219(1) the person holds an appropriate qualification` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- (a) not obtained in the UK: the Schedule 11 answer is irrelevant
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST TRUE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- (a) recognised status not known: not covered
#ASSERT `s 1219(1) the person holds an appropriate qualification` TRUE NOTHING FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS NOTHING
-- (b)(i), (b)(ii) the 1989 Act routes
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) TRUE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
-- (c)(i), (c)(ii) the Northern Ireland routes
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
-- (d) within subsection (2)
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST TRUE) (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
-- (f) approved third country qualification, with no direction; with a direction and without / with the additional qualifications
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
-- (f) not known
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) NOTHING FALSE FALSE EQUALS NOTHING
-- no limb holds
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE (JUST FALSE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- one limb holding decides the answer even when others are not known
#ASSERT `s 1219(1) the person holds an appropriate qualification` FALSE NOTHING TRUE FALSE FALSE FALSE NOTHING NOTHING FALSE FALSE EQUALS JUST TRUE

-- s 1220(1)
#ASSERT `s 1220(1) the body is a qualifying body` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1220(1) the body is a qualifying body` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1220(1) the body is a qualifying body` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1220(1) the body is a qualifying body` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 1220(2)
#ASSERT `s 1220(2) the rule is a rule of the qualifying body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1220(2) the rule is a rule of the qualifying body` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1220(2) the rule is a rule of the qualifying body` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1220(2) the rule is included among the rules of the qualifying body` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1220(2) the rule is included among the rules of the qualifying body` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1220(2) the rule is included among the rules of the qualifying body` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1220(2) the rule is included among the rules of the qualifying body` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1220(2) the rule is included among the rules of the qualifying body` FALSE FALSE FALSE TRUE EQUALS NOTHING
-- s 1220(3): Schedule 11's answer passes through
#ASSERT `s 1220(3) the professional qualification is a recognised professional qualification for the purposes of Part 42` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1220(3) the professional qualification is a recognised professional qualification for the purposes of Part 42` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1220(3) the professional qualification is a recognised professional qualification for the purposes of Part 42` NOTHING EQUALS NOTHING

-- s 1221(3), (4): "only if he is satisfied"
#ASSERT `s 1221(3) the condition for making a declaration under subsection (1) is met` TRUE EQUALS JUST TRUE
#ASSERT `s 1221(3) the condition for making a declaration under subsection (1) is met` FALSE EQUALS JUST FALSE
#ASSERT `s 1221(4) the condition for making a declaration under subsection (1) is met` TRUE EQUALS JUST TRUE
#ASSERT `s 1221(4) the condition for making a declaration under subsection (1) is met` FALSE EQUALS JUST FALSE
-- s 1221(1): the power needs a described group of persons and both conditions
#ASSERT `s 1221(1) the Secretary of State may declare that the persons are regarded as holding an approved third country qualification` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1221(1) the Secretary of State may declare that the persons are regarded as holding an approved third country qualification` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1221(1) the Secretary of State may declare that the persons are regarded as holding an approved third country qualification` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1221(1) the Secretary of State may declare that the persons are regarded as holding an approved third country qualification` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 1221(1) the Secretary of State may declare that the persons are regarded as holding an approved third country qualification` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- s 1221(1A): "unless" (a) or (b). order: (a)(i), (a)(ii), holds a qualification not complying with (a), met the (1B) requirement
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` TRUE TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` FALSE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` FALSE FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` FALSE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` FALSE FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1221(1A) the person may be regarded as holding an approved third country qualification` FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
-- s 1221(1B): the way the declaration specifies. order: way, passed the aptitude test, completed the adaptation period
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(a) only by passing an aptitude test` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(a) only by passing an aptitude test` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(b) only by completing an adaptation period` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(b) only by completing an adaptation period` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(c) either by passing an aptitude test or by completing an adaptation period` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(c) either by passing an aptitude test or by completing an adaptation period` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(1B) the person has met the requirement the declaration specifies` `s 1221(1B)(c) either by passing an aptitude test or by completing an adaptation period` FALSE FALSE EQUALS JUST FALSE
-- s 1221(2)
#ASSERT `s 1221(2) the declaration may be expressed to be subject to the satisfaction of the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(2) the declaration may be expressed to be subject to the satisfaction of the requirement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1221(2) the declaration may be expressed to be subject to the satisfaction of the requirement` TRUE FALSE EQUALS NOTHING
-- s 1221(5), (6), (7), (8): powers limited by their own wording
#ASSERT `s 1221(5) the Secretary of State may direct that the persons are not treated as holding an appropriate qualification unless they hold the additional educational qualifications` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(5) the Secretary of State may direct that the persons are not treated as holding an appropriate qualification unless they hold the additional educational qualifications` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1221(5) the Secretary of State may direct that the persons are not treated as holding an appropriate qualification unless they hold the additional educational qualifications` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1221(6) the Secretary of State may give different directions` TRUE EQUALS JUST TRUE
#ASSERT `s 1221(6) the Secretary of State may give different directions` FALSE EQUALS NOTHING
#ASSERT `s 1221(7) the Secretary of State may withdraw a declaration under subsection (1)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(7) the Secretary of State may withdraw a declaration under subsection (1)` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1221(7) the Secretary of State may withdraw a declaration under subsection (1)` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1221(7) the Secretary of State may withdraw a declaration under subsection (1)` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1221(8) the Secretary of State may vary or revoke the requirement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(8) the Secretary of State may vary or revoke the requirement` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1221(8) the Secretary of State may vary or revoke the requirement` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1221(8) the Secretary of State may vary or revoke the requirement` TRUE TRUE FALSE EQUALS NOTHING
-- s 1221(7A): what the aptitude test must, may and must not test
#ASSERT `s 1221(7A) the status of the matter in an aptitude test required for the purposes of subsection (1B)` `s 1221(7A)(a) the person's knowledge of required subjects and skills` EQUALS `s 1221(7A) the test must cover it`
#ASSERT `s 1221(7A) the status of the matter in an aptitude test required for the purposes of subsection (1B)` `s 1221(7A)(b) the person's knowledge of rules of professional conduct` EQUALS `s 1221(7A) the test may cover it`
#ASSERT `s 1221(7A) the status of the matter in an aptitude test required for the purposes of subsection (1B)` `s 1221(7A)(c) the person's knowledge of any other matters` EQUALS `s 1221(7A) the test must not cover it`
-- s 1221(7AA): a required subject. order: covered, essential, existing does not cover, existing does not demonstrate
#ASSERT `s 1221(7AA) the subject or skill is a required subject or skill` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1221(7AA) the subject or skill is a required subject or skill` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(7AA) the subject or skill is a required subject or skill` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1221(7AA) the subject or skill is a required subject or skill` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1221(7AA) the subject or skill is a required subject or skill` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- s 1221(7C): an adaptation period of not more than three years (36 months), under supervision, with an assessment
#ASSERT `s 1221(7C) the period is an adaptation period` 36 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1221(7C) the period is an adaptation period` 37 TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1221(7C) the period is an adaptation period` 12 FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1221(7C) the period is an adaptation period` 12 TRUE FALSE EQUALS JUST FALSE
-- s 1221(7D)
#ASSERT `s 1221(7D) the adaptation period and the ability assessment accord with subsection (7D)` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1221(7D) the adaptation period and the ability assessment accord with subsection (7D)` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1221(7D) the adaptation period and the ability assessment accord with subsection (7D)` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1221(7D) the adaptation period and the ability assessment accord with subsection (7D)` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1221(7D) the adaptation period and the ability assessment accord with subsection (7D)` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 1222(2): "unquoted" if neither the company nor any parent undertaking is a quoted company
#ASSERT `s 1222(2) the company is unquoted` (JUST FALSE) (LIST JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1222(2) the company is unquoted` (JUST FALSE) EMPTY EQUALS JUST TRUE
#ASSERT `s 1222(2) the company is unquoted` (JUST TRUE) (LIST JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1222(2) the company is unquoted` (JUST FALSE) (LIST JUST FALSE, JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1222(2) the company is unquoted` (JUST FALSE) (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `s 1222(2) the company is unquoted` NOTHING (LIST JUST TRUE) EQUALS JUST FALSE
-- s 1222(1): eligible only for an unquoted company
#ASSERT `s 1222(1) the person is eligible for appointment as auditor of the company` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1222(1) the person is eligible for appointment as auditor of the company` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1222(1) the person is eligible for appointment as auditor of the company` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1222(1) the person is eligible for appointment as auditor of the company` FALSE (JUST FALSE) EQUALS NOTHING
-- s 1222(3)
#ASSERT `s 1222(3) the reference to a person eligible for appointment as a statutory auditor includes the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1222(3) the reference to a person eligible for appointment as a statutory auditor includes the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1222(3) the reference to a person eligible for appointment as a statutory auditor includes the person` TRUE FALSE EQUALS NOTHING
