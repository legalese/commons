IMPORT prelude

-- coa8-helpers.l4: three-valued logic over MAYBE BOOLEAN, used by every coa8 module.
-- Not a provision of the Act: the names begin `s 362 helper` (s 362 is a heading row of coa8's range and no other
-- part defines a name with that beginning).
--   JUST TRUE / JUST FALSE / NOTHING (the text does not decide).
-- A limb that decides the answer decides it whatever the other limb is (strong Kleene logic): `JUST FALSE AND NOTHING`
-- is JUST FALSE and `JUST TRUE OR NOTHING` is JUST TRUE. NOTHING survives only where no limb decides.

GIVEN a IS A MAYBE BOOLEAN
      b IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 362 helper either answer` MEANS
    CONSIDER a
    WHEN JUST x THEN
        IF x
        THEN JUST TRUE
        ELSE b
    WHEN NOTHING THEN
        CONSIDER b
        WHEN JUST y THEN
            IF y
            THEN JUST TRUE
            ELSE NOTHING
        WHEN NOTHING THEN NOTHING

GIVEN a IS A MAYBE BOOLEAN
      b IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 362 helper both answers` MEANS
    CONSIDER a
    WHEN JUST x THEN
        IF x
        THEN b
        ELSE JUST FALSE
    WHEN NOTHING THEN
        CONSIDER b
        WHEN JUST y THEN
            IF y
            THEN NOTHING
            ELSE JUST FALSE
        WHEN NOTHING THEN NOTHING

GIVEN a IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 362 helper the opposite answer` MEANS
    CONSIDER a
    WHEN JUST x THEN JUST (NOT x)
    WHEN NOTHING THEN NOTHING

GIVEN xs IS A LIST OF MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 362 helper every answer` MEANS
    CONSIDER xs
    WHEN EMPTY THEN JUST TRUE
    WHEN x FOLLOWED BY rest THEN `s 362 helper both answers` x (`s 362 helper every answer` rest)

GIVEN xs IS A LIST OF MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`s 362 helper some answer` MEANS
    CONSIDER xs
    WHEN EMPTY THEN JUST FALSE
    WHEN x FOLLOWED BY rest THEN `s 362 helper either answer` x (`s 362 helper some answer` rest)
