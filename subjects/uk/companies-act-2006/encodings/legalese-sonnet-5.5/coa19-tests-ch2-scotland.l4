IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa19-nouns`
IMPORT `coa19-ch2-scotland`

-- coa19-tests-ch2-scotland.l4: tests for coa19-ch2-scotland.l4 (ss 878 to 892).
-- Every expected value is written from the text of the section named in the comment above it, not from the code's output.

§ `Tests: ss 878 to 892`

§§ `s 879(6) "company"`
-- In this Chapter "company" means an incorporated company registered in Scotland.
#ASSERT `s 879(6) the body is a company` TRUE `Scotland` EQUALS JUST TRUE
#ASSERT `s 879(6) the body is a company` FALSE `Scotland` EQUALS JUST FALSE
#ASSERT `s 879(6) the body is a company` TRUE `England and Wales` EQUALS JUST FALSE
#ASSERT `s 879(6) the body is a company` TRUE `Northern Ireland` EQUALS JUST FALSE

§§ `s 878 Charges created by a company`
-- (7) the kinds, in the order of the record: land, rent charge, goodwill, patent, trademark, copyright, registered design, design right, book debts, uncalled capital or calls, ship or aircraft, floating charge
`s 878 test: land` MEANS `s 878(7) what the charge is` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: rent charge on land` MEANS `s 878(7) what the charge is` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: goodwill` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: patent` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: trademark` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: copyright` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: registered design` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 878 test: design right` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`s 878 test: book debts` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`s 878 test: uncalled share capital or calls` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`s 878 test: ship or aircraft` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`s 878 test: floating charge` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`s 878 test: none of the listed kinds` MEANS `s 878(7) what the charge is` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: land` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: goodwill` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: patent` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: trademark` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: copyright` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: registered design` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: design right` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: book debts` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: uncalled share capital or calls` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: ship or aircraft` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: floating charge` EQUALS JUST TRUE
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: rent charge on land` EQUALS NOTHING
#ASSERT `s 878(7) the charge is one to which section 878 applies` `s 878 test: none of the listed kinds` EQUALS NOTHING
-- (1) the duty of an incorporated company registered in Scotland that creates a charge to which the section applies
#ASSERT `s 878(1) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` `Scotland` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 878(1) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` `England and Wales` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 878(1) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` `Scotland` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 878(1) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` `Scotland` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 878(1) the company must deliver the prescribed particulars and a certified copy of the instrument to the registrar` `Scotland` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 878(2) registration may be effected on the application of the person` TRUE EQUALS JUST TRUE
#ASSERT `s 878(2) registration may be effected on the application of the person` FALSE EQUALS NOTHING
#ASSERT `s 878(3) the person is entitled to recover from the company the fees properly paid` TRUE EQUALS JUST TRUE
#ASSERT `s 878(3) the person is entitled to recover from the company the fees properly paid` FALSE EQUALS JUST FALSE
#ASSERT `s 878(6) subsection (4) applies` TRUE EQUALS JUST FALSE
#ASSERT `s 878(6) subsection (4) applies` FALSE EQUALS NOTHING
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 878(4) the company fails to comply with subsection (1), so that an offence is committed` NOTHING (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 878(4)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 878(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 878(4)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 878(4)(b) the officer commits an offence` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT (count (`s 878(5) the penalties for the offence`)) EQUALS 2
#ASSERT ((`s 878(5) the penalties for the offence`) EQUALS (LIST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE), (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)))

§§ `s 879 Charges which have to be registered: supplementary`
-- (1) a charge on land includes a heritable security (a borrowed term, an input)
