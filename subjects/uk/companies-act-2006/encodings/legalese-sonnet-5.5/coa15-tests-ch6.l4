IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch1`
IMPORT `coa15-ch6`

-- coa15-tests-ch6.l4: tests of coa15-ch6.l4 (ss 724 to 732). Expected values are written from the text before the run.

#ASSERT `s 724(1) this section applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 724(1) this section applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 724(1) this section applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 724(3) the company may do it with the shares` (JUST TRUE) `s 724(3)(a) hold the shares` EQUALS JUST TRUE
#ASSERT `s 724(3) the company may do it with the shares` (JUST TRUE) `s 724(3)(b) deal with the shares in accordance with section 727 or 729` EQUALS JUST TRUE
#ASSERT `s 724(3) the company may do it with the shares` (JUST TRUE) `s 724(3) deal with the shares in another way` EQUALS NOTHING
#ASSERT `s 724(3) the company may do it with the shares` (JUST FALSE) `s 724(3)(a) hold the shares` EQUALS JUST FALSE
#ASSERT `s 724(3) the company may do it with the shares` NOTHING `s 724(3)(a) hold the shares` EQUALS NOTHING
#ASSERT `s 724(4) the company must be entered in its register of members as the member holding the shares` TRUE EQUALS JUST TRUE
#ASSERT `s 724(4) the company must be entered in its register of members as the member holding the shares` FALSE EQUALS JUST FALSE
-- expect: FULFILLED
#TRACE `s 724(4) the company must be entered in its register of members` AT 0 WITH
    PARTY Company DOES `s 724(4) be entered in its register of members as the member holding the shares` AT 2
-- expect: RESIDUAL
#TRACE `s 724(4) the company must be entered in its register of members` AT 0 WITH
    (WAITUNTIL 9)
#ASSERT `s 724(5) the company holds the shares as treasury shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 724(5) the company holds the shares as treasury shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 724(5) the company holds the shares as treasury shares` FALSE TRUE EQUALS JUST FALSE

#ASSERT `s 726(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 726(1) this section applies` FALSE EQUALS JUST FALSE
#ASSERT `s 726(2) the company may exercise a right in respect of the treasury shares` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 726(2) the company may exercise a right in respect of the treasury shares` (JUST FALSE) EQUALS NOTHING
-- expect: BREACH
#TRACE `s 726(2) the company shant exercise a right in respect of the treasury shares` AT 0 WITH
    PARTY Company DOES `s 726(2) exercise a right in respect of the treasury shares` AT 2
-- expect: RESIDUAL
#TRACE `s 726(2) the company shant exercise a right in respect of the treasury shares` AT 0 WITH
    (WAITUNTIL 9)
#ASSERT `s 726(2) the purported exercise of the right is void` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 726(2) the purported exercise of the right is void` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 726(3) a dividend or other distribution may be paid or made to the company in respect of the treasury shares` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 726(3) a dividend or other distribution may be paid or made to the company in respect of the treasury shares` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 726(4) section 726 prevents the transaction` (JUST TRUE) `s 726(4)(a) an allotment of shares as fully paid bonus shares in respect of the treasury shares` FALSE EQUALS JUST FALSE
#ASSERT `s 726(4) section 726 prevents the transaction` (JUST TRUE) `s 726(4)(b) the payment of an amount payable on the redemption of the treasury shares` TRUE EQUALS JUST FALSE
#ASSERT `s 726(4) section 726 prevents the transaction` (JUST TRUE) `s 726(4)(b) the payment of an amount payable on the redemption of the treasury shares` FALSE EQUALS NOTHING
#ASSERT `s 726(4) section 726 prevents the transaction` (JUST TRUE) `s 726(4) any other transaction` FALSE EQUALS NOTHING
#ASSERT `s 726(4) section 726 prevents the transaction` (JUST FALSE) `s 726(4)(a) an allotment of shares as fully paid bonus shares in respect of the treasury shares` FALSE EQUALS NOTHING
#ASSERT `s 726(5) the shares are treated as purchased by the company, at the time they were allotted, in circumstances in which section 724(1) applied` TRUE EQUALS JUST TRUE
#ASSERT `s 726(5) the shares are treated as purchased by the company, at the time they were allotted, in circumstances in which section 724(1) applied` FALSE EQUALS NOTHING

#ASSERT `s 727(1) the company may dispose of the shares in that way` TRUE `s 727(1)(a) a sale of the shares for a cash consideration` EQUALS JUST TRUE
#ASSERT `s 727(1) the company may dispose of the shares in that way` TRUE `s 727(1)(b) a transfer of the shares for the purposes of or pursuant to an employees' share scheme` EQUALS JUST TRUE
#ASSERT `s 727(1) the company may dispose of the shares in that way` TRUE `s 727(1) any other disposal` EQUALS NOTHING
#ASSERT `s 727(1) the company may dispose of the shares in that way` FALSE `s 727(1)(a) a sale of the shares for a cash consideration` EQUALS JUST FALSE
#ASSERT `s 727(2) the consideration is a cash consideration` `s 727(2)(a) cash received by the company` EQUALS JUST TRUE
#ASSERT `s 727(2) the consideration is a cash consideration` (`s 727(2)(b) a cheque received by the company` TRUE) EQUALS JUST TRUE
#ASSERT `s 727(2) the consideration is a cash consideration` (`s 727(2)(b) a cheque received by the company` FALSE) EQUALS JUST FALSE
#ASSERT `s 727(2) the consideration is a cash consideration` `s 727(2)(c) a release of a liability of the company for a liquidated sum` EQUALS JUST TRUE
-- an undertaking to pay cash: not more than 90 days after the agreement to sell
#ASSERT `s 727(2) the consideration is a cash consideration` (`s 727(2)(d) an undertaking to pay cash to the company` 90) EQUALS JUST TRUE
#ASSERT `s 727(2) the consideration is a cash consideration` (`s 727(2)(d) an undertaking to pay cash to the company` 91) EQUALS JUST FALSE
#ASSERT `s 727(2) the consideration is a cash consideration` (`s 727(2)(d) an undertaking to pay cash to the company` 0) EQUALS JUST TRUE
#ASSERT `s 727(2) the consideration is a cash consideration` `s 727(2)(e) payment by any other means giving rise to a present or future entitlement to a payment, or credit equivalent to payment, in cash` EQUALS JUST TRUE
#ASSERT `s 727(2) the consideration is a cash consideration` `s 727(2) any other consideration` EQUALS JUST FALSE
#ASSERT `s 727(2) the money is cash` TRUE EQUALS JUST TRUE
#ASSERT `s 727(2) the money is cash` FALSE EQUALS NOTHING
#ASSERT `s 727(3) the means of payment is regarded as falling within subsection (2)(e)` TRUE EQUALS JUST TRUE
#ASSERT `s 727(3) the means of payment is regarded as falling within subsection (2)(e)` FALSE EQUALS NOTHING
#ASSERT `s 727(4) the sale or transfer is barred` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 727(4) the sale or transfer is barred` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 727(4) the sale or transfer is barred` FALSE FALSE EQUALS JUST FALSE
-- expect: BREACH
#TRACE `s 727(4) the company shant sell or transfer the shares except to the person who gave the notice` AT 0 WITH
    PARTY Company DOES `s 727(4) sell or transfer the shares to which the notice relates to a person other than the person who gave the notice` AT 3

-- s 728(1): not later than 28 days after the shares are disposed of
#ASSERT `s 728(1) the last day for delivering the return to the registrar` (Date 1 3 2026) EQUALS Date 29 3 2026
#ASSERT `s 728(1) the last day for delivering the return to the registrar` (Date 15 2 2026) EQUALS Date 15 3 2026
#ASSERT `s 728(1) the return was delivered not later than 28 days after the shares were disposed of` (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 728(1) the return was delivered not later than 28 days after the shares were disposed of` (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 728(1) the return was delivered not later than 28 days after the shares were disposed of` (Date 1 3 2026) (Date 28 2 2026) EQUALS JUST FALSE
-- expect: FULFILLED
#TRACE `s 728(1) the company must deliver a return to the registrar` AT 0 WITH
    PARTY Company DOES `s 728(1) deliver a return to the registrar of the shares sold or transferred for the purposes of an employees' share scheme` AT 28
-- expect: BREACH
#TRACE `s 728(1) the company must deliver a return to the registrar` AT 0 WITH
    PARTY Company DOES `s 728(1) deliver a return to the registrar of the shares sold or transferred for the purposes of an employees' share scheme` AT 29

`fixture: full disposal entry` MEANS `s 728(2) class entry` WITH
    `s 728(2) states the number and nominal value of the shares of the class disposed of` IS TRUE
    `s 728(2) states the date on which they were disposed of` IS TRUE
`fixture: disposal entry without the date` MEANS `s 728(2) class entry` WITH
    `s 728(2) states the number and nominal value of the shares of the class disposed of` IS TRUE
    `s 728(2) states the date on which they were disposed of` IS FALSE
`fixture: disposal entry without the number` MEANS `s 728(2) class entry` WITH
    `s 728(2) states the number and nominal value of the shares of the class disposed of` IS FALSE
    `s 728(2) states the date on which they were disposed of` IS TRUE
#ASSERT `s 728(2) the return states what the section requires` (LIST `fixture: full disposal entry`) EQUALS JUST TRUE
#ASSERT `s 728(2) the return states what the section requires` (LIST `fixture: full disposal entry`, `fixture: full disposal entry`) EQUALS JUST TRUE
#ASSERT `s 728(2) the return states what the section requires` (LIST `fixture: disposal entry without the date`) EQUALS JUST FALSE
#ASSERT `s 728(2) the return states what the section requires` (LIST `fixture: disposal entry without the number`) EQUALS JUST FALSE
#ASSERT `s 728(2) the return states what the section requires` (LIST `fixture: full disposal entry`, `fixture: disposal entry without the date`) EQUALS JUST FALSE
#ASSERT `s 728(2) the return states what the section requires` EMPTY EQUALS NOTHING
#ASSERT `s 728(3) the particulars may be included in a single return` TRUE EQUALS JUST TRUE
#ASSERT `s 728(3) the particulars may be included in a single return` FALSE EQUALS NOTHING
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) the company` NOTHING EQUALS NOTHING
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) an officer of the company` NOTHING EQUALS NOTHING
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) a director of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 728(4) the person commits an offence` TRUE `s 658(2) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 728(4) the person commits an offence` FALSE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST FALSE

-- s 728(5): the text shows two wordings of the daily default fine; the penalty answers by which one is in force
#ASSERT `s 728(5) the penalty on conviction` `on conviction on indictment` NOTHING EQUALS JUST (`s 707(7) penalty` OF `on conviction on indictment`, JUST `a fine without a stated limit`, NOTHING)
#ASSERT `s 728(5) the penalty on conviction` `on summary conviction` (JUST FALSE) EQUALS JUST (`s 707(7) penalty` OF `on summary conviction`, JUST (`a fine not exceeding the statutory maximum` 1), JUST `s 707(7) one-tenth of the statutory maximum`)
#ASSERT `s 728(5) the penalty on conviction` `on summary conviction` (JUST TRUE) EQUALS JUST (`s 707(7) penalty` OF `on summary conviction`, JUST (`a fine not exceeding the statutory maximum` 1), JUST (`s 707(7) one-tenth of the greater of an amount in pounds and the amount corresponding to a level on the standard scale` 5000 4))
#ASSERT `s 728(5) the penalty on conviction` `on summary conviction` NOTHING EQUALS NOTHING
#ASSERT `s 728(5) the penalty on conviction` `on summary conviction in Scotland` (JUST TRUE) EQUALS JUST (`s 707(7) penalty` OF `on summary conviction in Scotland`, JUST (`a fine not exceeding the statutory maximum` 1), JUST (`s 707(7) one-tenth of the greater of an amount in pounds and the amount corresponding to a level on the standard scale` 5000 4))

#ASSERT `s 729(1) the company may cancel the shares` TRUE EQUALS JUST TRUE
#ASSERT `s 729(1) the company may cancel the shares` FALSE EQUALS JUST FALSE
#ASSERT `s 729(4) the amount of the company's share capital after the cancellation` TRUE 10000 1500 EQUALS 8500
#ASSERT `s 729(4) the amount of the company's share capital after the cancellation` FALSE 10000 1500 EQUALS 10000
#ASSERT `s 729(5) the directors may take the steps without complying with Chapter 10 of Part 17` TRUE EQUALS JUST TRUE
#ASSERT `s 729(5) the directors may take the steps without complying with Chapter 10 of Part 17` FALSE EQUALS NOTHING

#ASSERT `s 730(1) the last day for delivering the return to the registrar` (Date 1 3 2026) EQUALS Date 29 3 2026
#ASSERT `s 730(1) the return was delivered not later than 28 days after the shares were cancelled` FALSE (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 730(1) the return was delivered not later than 28 days after the shares were cancelled` FALSE (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
-- shares cancelled forthwith on their acquisition: section 708 applies, not section 730
#ASSERT `s 730(1) the return was delivered not later than 28 days after the shares were cancelled` TRUE (Date 1 3 2026) (Date 30 3 2026) EQUALS NOTHING
-- expect: FULFILLED
#TRACE `s 730(1) the company must deliver a return to the registrar` AT 0 WITH
    PARTY Company DOES `s 730(1) deliver a return to the registrar of the shares cancelled` AT 28
-- expect: BREACH
#TRACE `s 730(1) the company must deliver a return to the registrar` AT 0 WITH
    (WAITUNTIL 29)

`fixture: full cancellation entry` MEANS `s 730(2) class entry` WITH
    `s 730(2) states the number and nominal value of the shares of the class cancelled` IS TRUE
    `s 730(2) states the date on which they were cancelled` IS TRUE
`fixture: cancellation entry without the date` MEANS `s 730(2) class entry` WITH
    `s 730(2) states the number and nominal value of the shares of the class cancelled` IS TRUE
    `s 730(2) states the date on which they were cancelled` IS FALSE
#ASSERT `s 730(2) the return states what the section requires` (LIST `fixture: full cancellation entry`) EQUALS JUST TRUE
#ASSERT `s 730(2) the return states what the section requires` (LIST `fixture: cancellation entry without the date`) EQUALS JUST FALSE
#ASSERT `s 730(2) the return states what the section requires` EMPTY EQUALS NOTHING
#ASSERT `s 730(3) the particulars may be included in a single return` TRUE EQUALS JUST TRUE
#ASSERT `s 730(3) the particulars may be included in a single return` FALSE EQUALS NOTHING
#ASSERT `s 730(4) the notice is accompanied by a statement of capital` TRUE EQUALS JUST TRUE
#ASSERT `s 730(4) the notice is accompanied by a statement of capital` FALSE EQUALS JUST FALSE

`fixture: an entry` MEANS `s 663(3) class entry` WITH
    `s 663(3) states prescribed particulars of the rights attached to the shares of the class` IS TRUE
    `s 663(3) states the total number of shares of the class` IS TRUE
    `s 663(3) states the aggregate nominal value of the shares of the class` IS TRUE
`fixture: a statement` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS TRUE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS TRUE
    `s 663(3) entries for the classes of shares` IS LIST `fixture: an entry`
`fixture: a statement without the number of shares` MEANS `s 663(3) statement of capital` WITH
    `s 663(3) states the total number of shares of the company` IS FALSE
    `s 663(3) states the aggregate nominal value of those shares` IS TRUE
    `s 663(3) states the aggregate amount unpaid on those shares` IS TRUE
    `s 663(3) entries for the classes of shares` IS LIST `fixture: an entry`
#ASSERT `s 730(5) the statement of capital states what the section requires` `fixture: a statement` EQUALS JUST TRUE
#ASSERT `s 730(5) the statement of capital states what the section requires` `fixture: a statement without the number of shares` EQUALS JUST FALSE
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) the company` NOTHING EQUALS JUST TRUE
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) an officer of the company` NOTHING EQUALS NOTHING
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) a director of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 730(6) the person commits an offence` TRUE `s 658(2) any other person` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 730(6) the person commits an offence` FALSE `s 658(2) the company` NOTHING EQUALS JUST FALSE
#ASSERT `s 730(7) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 730(7) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 730(7) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 730(7) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
#ASSERT `s 730(7) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)

-- s 731: the proceeds of sale against the purchase price paid of 100
#ASSERT `s 731(1) this section applies to the proceeds of sale` TRUE EQUALS JUST TRUE
#ASSERT `s 731(1) this section applies to the proceeds of sale` FALSE EQUALS JUST FALSE
#ASSERT `s 731(2) the amount treated as a realised profit of the company for the purposes of Part 23` 80 100 EQUALS JUST 80
#ASSERT `s 731(2) the amount treated as a realised profit of the company for the purposes of Part 23` 100 100 EQUALS JUST 100
#ASSERT `s 731(2) the amount treated as a realised profit of the company for the purposes of Part 23` 101 100 EQUALS NOTHING
