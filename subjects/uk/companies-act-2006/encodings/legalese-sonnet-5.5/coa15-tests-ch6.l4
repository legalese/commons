#ASSERT `s 731(3)(a) the amount treated as a realised profit of the company` 100 100 EQUALS NOTHING
#ASSERT `s 731(3)(a) the amount treated as a realised profit of the company` 250 100 EQUALS JUST 100
#ASSERT `s 731(3)(b) the amount to be transferred to the company's share premium account` 101 100 EQUALS JUST 1
#ASSERT `s 731(3)(b) the amount to be transferred to the company's share premium account` 250 100 EQUALS JUST 150
#ASSERT `s 731(3)(b) the amount to be transferred to the company's share premium account` 100 100 EQUALS NOTHING
-- weighted average: 300 paid for 3 shares held; selling 2 sold shares cost 200
#ASSERT `s 731(4)(a) the purchase price paid by the company for the shares sold` 300 3 2 EQUALS JUST 200
#ASSERT `s 731(4)(a) the purchase price paid by the company for the shares sold` 300 0 2 EQUALS NOTHING
#ASSERT `s 731(4)(b) the purchase price paid for the shares` TRUE EQUALS JUST 0
#ASSERT `s 731(4)(b) the purchase price paid for the shares` FALSE EQUALS NOTHING

