#ASSERT `s 984(6) the section gives the offeror a defence` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 984(6) the section gives the offeror a defence` TRUE TRUE EQUALS NOTHING
-- s 984(7): the penalty.
#ASSERT `s 984(7) the penalty` `on conviction on indictment` FALSE EQUALS JUST (`s 980(8) penalty` OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 984(7) the penalty` `on summary conviction` FALSE EQUALS JUST (`s 980(8) penalty` OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), JUST (`s 980(8) a fraction of the statutory maximum` 0.02), FALSE)
#ASSERT `s 984(7) the penalty` `on summary conviction` TRUE EQUALS JUST (`s 980(8) penalty` OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), JUST (`s 980(8) a fraction of the greater of an amount in pounds and a level on the standard scale for summary offences` 0.02 5000 4), FALSE)
#ASSERT `s 984(7) the penalty` `on summary conviction in Scotland` FALSE EQUALS JUST (`s 980(8) penalty` OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), JUST (`s 980(8) a fraction of the statutory maximum` 0.02), FALSE)

