IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa24-officers`

-- coa24-tests-officers.l4: tests for ss 1121-1123 (coa24-officers.l4). Every expected value below was decided from the
-- text of the section before the run; none was copied from the module's output.

§ `Tests for s 1121`

-- s 1121(1): the section has effect only for a provision of the Companies Acts that makes every officer in default liable.
#ASSERT `s 1121(1) the section has effect for the provision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1121(1) the section has effect for the provision` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1121(1) the section has effect for the provision` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1121(1) the section has effect for the provision` FALSE FALSE EQUALS NOTHING

-- s 1121(2): "officer" includes a director, manager or secretary, and a person treated as an officer for the provision.
#ASSERT `s 1121(2) the person is an officer of the company` `s 1121(2)(a) a director` EQUALS JUST TRUE
#ASSERT `s 1121(2) the person is an officer of the company` `s 1121(2)(a) a manager` EQUALS JUST TRUE
#ASSERT `s 1121(2) the person is an officer of the company` `s 1121(2)(a) a secretary` EQUALS JUST TRUE
#ASSERT `s 1121(2) the person is an officer of the company` `s 1121(2)(b) a person treated as an officer of the company for the purposes of the provision in question` EQUALS JUST TRUE
-- "includes" does not close the list: a person in none of these positions is not covered, and not excluded either.
#ASSERT `s 1121(2) the person is an officer of the company` `s 1121(2) none of these positions` EQUALS NOTHING

-- s 1121(3): "in default" if he authorises or permits, participates in, or fails to take all reasonable steps to prevent.
#ASSERT `s 1121(3) the officer is in default` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1121(3) the officer is in default` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1121(3) the officer is in default` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1121(3) the officer is in default` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1121(3) the officer is in default` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1121(3) the officer is in default` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Tests for s 1121 (both limbs together)`

`a director who permitted the contravention` MEANS `s 1121(3) conduct of the officer` WITH
    `s 1121(3) authorises or permits` IS TRUE
    `s 1121(3) participates in` IS FALSE
    `s 1121(3) fails to take all reasonable steps to prevent` IS FALSE

`a director who did nothing wrong` MEANS `s 1121(3) conduct of the officer` WITH
    `s 1121(3) authorises or permits` IS FALSE
    `s 1121(3) participates in` IS FALSE
    `s 1121(3) fails to take all reasonable steps to prevent` IS FALSE

`a person who failed to take reasonable steps` MEANS `s 1121(3) conduct of the officer` WITH
    `s 1121(3) authorises or permits` IS FALSE
    `s 1121(3) participates in` IS FALSE
    `s 1121(3) fails to take all reasonable steps to prevent` IS TRUE

#ASSERT `s 1121 the person is an officer in default` `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS JUST TRUE
#ASSERT `s 1121 the person is an officer in default` `s 1121(2)(a) a secretary` `a person who failed to take reasonable steps` EQUALS JUST TRUE
#ASSERT `s 1121 the person is an officer in default` `s 1121(2)(b) a person treated as an officer of the company for the purposes of the provision in question` `a person who failed to take reasonable steps` EQUALS JUST TRUE
-- A director who is not in default is not caught.
#ASSERT `s 1121 the person is an officer in default` `s 1121(2)(a) a director` `a director who did nothing wrong` EQUALS JUST FALSE
-- Not in default means not caught, whatever the position.
#ASSERT `s 1121 the person is an officer in default` `s 1121(2) none of these positions` `a director who did nothing wrong` EQUALS JUST FALSE
-- In default, but the position is not one s 1121(2) lists: the list is not closed, so not covered.
#ASSERT `s 1121 the person is an officer in default` `s 1121(2) none of these positions` `a director who permitted the contravention` EQUALS NOTHING

§ `Tests for s 1122`

-- s 1122(1): a company that is an officer of another company does not commit the offence unless one of its officers is in default.
#ASSERT `s 1122(1) the company commits an offence as an officer in default` TRUE FALSE EQUALS JUST FALSE
-- The bar lifts when one of its officers is in default; the text does not then say the company commits it.
#ASSERT `s 1122(1) the company commits an offence as an officer in default` TRUE TRUE EQUALS NOTHING
-- Not an officer of another company: the subsection does not speak.
#ASSERT `s 1122(1) the company commits an offence as an officer in default` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1122(1) the company commits an offence as an officer in default` FALSE TRUE EQUALS NOTHING

-- s 1122(2): where such an offence is committed by a company the officer in question also commits it.
#ASSERT `s 1122(2) the officer in question also commits the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1122(2) the officer in question also commits the offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1122(2) the officer in question also commits the offence` TRUE FALSE EQUALS NOTHING

-- s 1122(3): both terms take their meaning from s 1121.
#ASSERT `s 1122(3) the section that gives the meaning of the term` `s 1122(3) officer` EQUALS 1121
#ASSERT `s 1122(3) the section that gives the meaning of the term` `s 1122(3) in default` EQUALS 1121

§ `Tests for s 1123`

-- s 1123(1): section 1121 applies to a body other than a company as it applies to a company.
#ASSERT `s 1123(1) section 1121 applies to the body` `s 1123 a body corporate other than a company` EQUALS JUST TRUE
#ASSERT `s 1123(1) section 1121 applies to the body` `s 1123 a partnership` EQUALS JUST TRUE
#ASSERT `s 1123(1) section 1121 applies to the body` `s 1123 an unincorporated body other than a partnership` EQUALS JUST TRUE
#ASSERT `s 1123(1) section 1121 applies to the body` `s 1123 a company` EQUALS NOTHING

-- s 1123(2)(a): a body corporate other than a company. Managed by its members: a member of the body is the "director".
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a body corporate other than a company` TRUE `s 1123 a member of the body` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a body corporate other than a company` TRUE `s 1123 a corresponding officer of the body` EQUALS NOTHING
-- In any other case: any corresponding officer.
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a body corporate other than a company` FALSE `s 1123 a corresponding officer of the body` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a body corporate other than a company` FALSE `s 1123 a member of the body` EQUALS NOTHING
-- s 1123(3)(a): a partnership: a member of the partnership.
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a partnership` FALSE `s 1123 a member of the partnership` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a partnership` FALSE `s 1123 a corresponding officer of the body` EQUALS NOTHING
-- s 1123(4)(a): an unincorporated body other than a partnership.
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 an unincorporated body other than a partnership` TRUE `s 1123 a member of the body` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 an unincorporated body other than a partnership` TRUE `s 1123 a member of the governing body` EQUALS NOTHING
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 an unincorporated body other than a partnership` FALSE `s 1123 a member of the governing body` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 an unincorporated body other than a partnership` FALSE `s 1123 a member of the body` EQUALS NOTHING
-- A company is outside section 1123.
#ASSERT `s 1123 the person is read as a director for the purposes of section 1121(2)(a)` `s 1123 a company` FALSE `s 1123 a member of the body` EQUALS NOTHING

-- Manager or secretary, in each kind of body: any manager, secretary or similar officer.
#ASSERT `s 1123 the person is read as a manager or secretary for the purposes of section 1121(2)(a)` `s 1123 a body corporate other than a company` `s 1123 a manager, secretary or similar officer` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a manager or secretary for the purposes of section 1121(2)(a)` `s 1123 a partnership` `s 1123 a manager, secretary or similar officer` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a manager or secretary for the purposes of section 1121(2)(a)` `s 1123 an unincorporated body other than a partnership` `s 1123 a manager, secretary or similar officer` EQUALS JUST TRUE
#ASSERT `s 1123 the person is read as a manager or secretary for the purposes of section 1121(2)(a)` `s 1123 a partnership` `s 1123 some other role` EQUALS NOTHING
#ASSERT `s 1123 the person is read as a manager or secretary for the purposes of section 1121(2)(a)` `s 1123 a company` `s 1123 a manager, secretary or similar officer` EQUALS NOTHING
