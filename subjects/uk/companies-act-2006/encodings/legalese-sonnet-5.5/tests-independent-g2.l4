#ASSERT `Under section 458(5), what is the greatest penalty for the offence on this kind of conviction` `on conviction on indictment` EQUALS (JUST (Penalty OF `on conviction on indictment`, (JUST (Period OF 2, Years)), (JUST `a fine without a stated limit`), NOTHING, TRUE)) -- 501 | s458(5)(a) l.6220 two years or a fine (or both)
#ASSERT `s 485(5) the appointment is made in accordance with a route the section allows` FALSE FALSE FALSE EQUALS JUST FALSE -- 561 | s485(5) l.6700 (layer-1 rule; no seat question asks it: the directors purport to appoint outside s485(3), s485(4), s486 and s486A); Guide: list closed with 'only'
#ASSERT `s 489(5) the appointment is made in accordance with a route the section allows` FALSE FALSE EQUALS JUST FALSE -- 580 | s489(5) l.6798 (layer-1 rule; no seat question asks it); Guide: list closed with 'only'

