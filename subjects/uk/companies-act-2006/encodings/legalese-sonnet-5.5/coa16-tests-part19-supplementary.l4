IMPORT prelude
IMPORT daydate
IMPORT `coa16-part19-supplementary`

-- coa16-tests-part19-supplementary.l4: tests for coa16-part19-supplementary.l4 (ss 749 to 754).
-- Every expected value is written from the text beside the assertion, never from the code's output.
-- #TRACE results are read by hand (an assertion cannot compare a DEONTIC); each trace carries its expected result.

-- ---- s 749(1): "on request and on payment of such fee as may be prescribed" ------------------------------------------
-- holder, a trust deed, a request, the fee paid
#ASSERT `s 749(1) the holder is entitled to be provided with a copy of the trust deed` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- not a holder of debentures
#ASSERT `s 749(1) the holder is entitled to be provided with a copy of the trust deed` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- no trust deed
#ASSERT `s 749(1) the holder is entitled to be provided with a copy of the trust deed` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- no request yet
#ASSERT `s 749(1) the holder is entitled to be provided with a copy of the trust deed` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- the fee not paid
#ASSERT `s 749(1) the holder is entitled to be provided with a copy of the trust deed` TRUE TRUE TRUE FALSE EQUALS NOTHING

-- s 749(1) as a regulative rule.  Request made and fee paid, copy provided on day 5: expected FULFILLED
#TRACE `s 749(1) the company must provide the holder with a copy of the trust deed` TRUE AT 0 WITH
    PARTY Company DOES `s 749 provide the debenture holder with a copy of the trust deed` AT 5
-- request made and fee paid, nothing provided: the text states no time, so the duty stands (expected: the standing obligation)
#TRACE `s 749(1) the company must provide the holder with a copy of the trust deed` TRUE AT 0 WITH
    (WAITUNTIL 90)
-- no request or fee: no duty (expected FULFILLED)
#TRACE `s 749(1) the company must provide the holder with a copy of the trust deed` FALSE AT 0 WITH
    (WAITUNTIL 90)

-- ---- s 749(2): the officers in default (the company itself is not named) -------------------------------------------------
#ASSERT `s 749(2) the person commits an offence` TRUE (`s 749(2) an officer of the company` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 749(2) the person commits an offence` TRUE (`s 749(2) an officer of the company` (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 749(2) the person commits an offence` TRUE (`s 749(2) an officer of the company` NOTHING) EQUALS NOTHING
-- the company itself, or any other person: the text names only the officers in default
#ASSERT `s 749(2) the person commits an offence` TRUE `s 749(2) another person` EQUALS NOTHING
-- no default
#ASSERT `s 749(2) the person commits an offence` FALSE (`s 749(2) an officer of the company` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 749(3) the penalty for the offence` EQUALS Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE
#ASSERT `s 749(4) the court may direct that the copy required be sent to the person requiring it` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 749(4) the court may direct that the copy required be sent to the person requiring it` FALSE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 749(4) the court may direct that the copy required be sent to the person requiring it` FALSE EQUALS JUST FALSE

-- ---- s 751(1): saving for older provisions -----------------------------------------------------------------------------
-- facts: in force on the relevant date, (i) a person then entitled remains a trustee, (ii) a person afterwards given the benefit remains a trustee, (b) the thing done while in force
#ASSERT `s 751(1)(a) section 750 does not operate to invalidate the provision` (`s 751(1) facts about an older provision` OF TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 751(1)(a) section 750 does not operate to invalidate the provision` (`s 751(1) facts about an older provision` OF TRUE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
-- in force on the relevant date but no person entitled remains a trustee: "so long as" has run out
#ASSERT `s 751(1)(a) section 750 does not operate to invalidate the provision` (`s 751(1) facts about an older provision` OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- not in force on the relevant date
#ASSERT `s 751(1)(a) section 750 does not operate to invalidate the provision` (`s 751(1) facts about an older provision` OF FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 751(1)(b) section 750 does not operate to deprive the person of an exemption or right to be indemnified` (`s 751(1) facts about an older provision` OF FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 751(1)(b) section 750 does not operate to deprive the person of an exemption or right to be indemnified` (`s 751(1) facts about an older provision` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING

-- ---- s 751(2): the relevant date -------------------------------------------------------------------------------------
#ASSERT `s 751(2) the relevant date` TRUE FALSE EQUALS JUST (Date 1 7 1948)
#ASSERT `s 751(2) the relevant date` FALSE TRUE EQUALS JUST (Date 1 7 1961)
-- neither, or both: the text provides for neither
#ASSERT `s 751(2) the relevant date` FALSE FALSE EQUALS NOTHING
#ASSERT `s 751(2) the relevant date` TRUE TRUE EQUALS NOTHING

-- ---- s 751(3): giving the benefit by a 75% resolution --------------------------------------------------------------------
-- trustee entitled, to all trustees, to named trustees, proportion in value who passed it, meeting summoned for the purpose
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` TRUE TRUE FALSE 0.75 TRUE EQUALS JUST TRUE
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` TRUE FALSE TRUE 0.8 TRUE EQUALS JUST TRUE
-- just under 75% in value
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` TRUE TRUE FALSE 0.74 TRUE EQUALS NOTHING
-- no meeting summoned for the purpose
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` TRUE TRUE FALSE 0.9 FALSE EQUALS NOTHING
-- no trustee remains entitled to the benefit
-- RECONCILED 2026-11-12: was #ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` FALSE TRUE FALSE 0.9 TRUE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` FALSE TRUE FALSE 0.9 TRUE EQUALS JUST FALSE
-- neither all trustees nor named trustees
#ASSERT `s 751(3) the benefit of the saved provision may be given by resolution` TRUE FALSE FALSE 0.9 TRUE EQUALS NOTHING

-- ---- s 751(4): summoning the meeting -----------------------------------------------------------------------------------------
-- the deed makes provision and the meeting was summoned in accordance with it
#ASSERT `s 751(4) the meeting was summoned as the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
-- the deed makes provision and the meeting was not summoned in accordance with it (court approval is no help)
#ASSERT `s 751(4) the meeting was summoned as the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- the deed makes no provision: a manner approved by the court
#ASSERT `s 751(4) the meeting was summoned as the subsection requires` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 751(4) the meeting was summoned as the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 751(4) the meeting was summoned as the subsection requires` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- s 750(1) -----------------------------------------------------------------------------------------------------------------
-- facts: (a) in a trust deed, (b) in a contract with the holders, would exempt or indemnify, trustee fails to show care and diligence
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF FALSE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
-- in neither a trust deed nor such a contract
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF FALSE, FALSE, TRUE, TRUE) EQUALS NOTHING
-- no exemption or indemnity
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF TRUE, FALSE, FALSE, TRUE) EQUALS NOTHING
-- the trustee does show the degree of care and diligence required
#ASSERT `s 750(1) the provision is void in so far as it exempts or indemnifies the trustee` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, FALSE) EQUALS NOTHING

-- ---- s 750(2) -----------------------------------------------------------------------------------------------------------------
-- facts: (a) release otherwise validly given, (a) for acts before the release, (b) a provision enabling a release, (b)(i) the majority in value the provision
-- requires, (b)(i) at a meeting summoned for the purpose, (b)(ii) for specific acts or omissions, (b)(ii) on the trustee dying or ceasing to act
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF TRUE, TRUE, FALSE, 0, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- a release not in respect of earlier acts or omissions
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF TRUE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) EQUALS NOTHING
-- (b): a provision requiring 75% at a meeting, for specific acts
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.75, TRUE, TRUE, FALSE) EQUALS JUST FALSE
-- (b): 80% at a meeting, on the trustee dying or ceasing to act
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.8, TRUE, FALSE, TRUE) EQUALS JUST FALSE
-- (b): a majority just under 75% in value
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.74, TRUE, TRUE, FALSE) EQUALS NOTHING
-- (b): no meeting summoned for the purpose
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.8, FALSE, TRUE, FALSE) EQUALS NOTHING
-- (b): neither (ii) limb
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.8, TRUE, FALSE, FALSE) EQUALS NOTHING
-- not a release and not a provision enabling one
#ASSERT `s 750(2) subsection (1) invalidates the release or the provision` (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0.9, TRUE, TRUE, TRUE) EQUALS NOTHING

-- ---- s 750(3): subject to section 751 and subsection (2) ---------------------------------------------------------------------
-- section 750(1) applies and nothing takes the provision out: void
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) (`s 751(1) facts about an older provision` OF FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- subsection (2)(b) takes it out
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, TRUE, 0.8, TRUE, TRUE, FALSE) (`s 751(1) facts about an older provision` OF FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- section 751(1)(a) takes it out
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) (`s 751(1) facts about an older provision` OF TRUE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- section 751(1)(b) takes it out
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) (`s 751(1) facts about an older provision` OF FALSE, FALSE, FALSE, TRUE) EQUALS JUST FALSE
-- an older provision in force on the relevant date, but no person entitled remains a trustee: the saving has run out
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF TRUE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) (`s 751(1) facts about an older provision` OF TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- subsection (1) does not apply to the provision
#ASSERT `s 750(3) the provision is void, subject to subsection (2) and section 751` (`s 750(1) facts about the provision` OF FALSE, FALSE, TRUE, TRUE) (`s 750(2) facts about the release or provision` OF FALSE, FALSE, FALSE, 0, FALSE, FALSE, FALSE) (`s 751(1) facts about an older provision` OF FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING

-- ---- s 752 ---------------------------------------------------------------------------------------------------------------------------
-- (1) redeemed; contrary provision; intention to cancel
#ASSERT `s 752(1) the company may re-issue the redeemed debentures` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 752(1) the company may re-issue the redeemed debentures` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 752(1) the company may re-issue the redeemed debentures` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 752(1) the company may re-issue the redeemed debentures` TRUE TRUE TRUE EQUALS JUST FALSE
-- the debentures were not redeemed: the power is not what the subsection is about
-- RECONCILED 2026-11-12: was #ASSERT `s 752(1) the company may re-issue the redeemed debentures` FALSE FALSE FALSE EQUALS NOTHING; the gate is where/when/upon kind, so the site is listed and answers as ruling (b) gives, not flipped
#ASSERT `s 752(1) the company may re-issue the redeemed debentures` FALSE FALSE FALSE EQUALS JUST FALSE
-- "deemed always to have had effect": any date
#ASSERT `s 752(1) the subsection has effect for a redemption on the date` (Date 1 1 1900) EQUALS JUST TRUE
#ASSERT `s 752(1) the subsection has effect for a redemption on the date` (Date 8 11 2006) EQUALS JUST TRUE
#ASSERT `s 752(1) the subsection has effect for a redemption on the date` (Date 1 1 2040) EQUALS JUST TRUE
-- (2) priorities
#ASSERT `s 752(2) the person entitled has the same priorities as if the debentures had never been redeemed` TRUE EQUALS JUST TRUE
#ASSERT `s 752(2) the person entitled has the same priorities as if the debentures had never been redeemed` FALSE EQUALS NOTHING
-- (3) a new debenture for stamp duty; not for a provision limiting the amount or number; nothing said of other purposes
#ASSERT `s 752(3) the re-issue is treated as the issue of a new debenture` TRUE `s 752(3) stamp duty` EQUALS JUST TRUE
#ASSERT `s 752(3) the re-issue is treated as the issue of a new debenture` TRUE `s 752(3) a provision limiting the amount or number of debentures to be issued` EQUALS JUST FALSE
#ASSERT `s 752(3) the re-issue is treated as the issue of a new debenture` TRUE `s 752(3) another purpose` EQUALS NOTHING
#ASSERT `s 752(3) the re-issue is treated as the issue of a new debenture` FALSE `s 752(3) stamp duty` EQUALS NOTHING
-- (4) lent on the security; appears duly stamped; had notice; might have discovered but for negligence
#ASSERT `s 752(4) the lender may give the debenture in evidence without payment of the stamp duty or any penalty` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 752(4) the lender may give the debenture in evidence without payment of the stamp duty or any penalty` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 752(4) the lender may give the debenture in evidence without payment of the stamp duty or any penalty` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- the debenture does not appear to be duly stamped
#ASSERT `s 752(4) the lender may give the debenture in evidence without payment of the stamp duty or any penalty` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- not a lender on the security of a re-issued debenture
#ASSERT `s 752(4) the lender may give the debenture in evidence without payment of the stamp duty or any penalty` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- "In that case the company is liable"
#ASSERT `s 752(4) the company is liable to pay the proper stamp duty and penalty` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 752(4) the company is liable to pay the proper stamp duty and penalty` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 752(4) the company is liable to pay the proper stamp duty and penalty` FALSE TRUE FALSE FALSE EQUALS NOTHING

-- ---- s 753 --------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 753 the debentures are treated as redeemed by reason only that the account has ceased to be in debit` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 753 the debentures are treated as redeemed by reason only that the account has ceased to be in debit` TRUE FALSE EQUALS NOTHING
#ASSERT `s 753 the debentures are treated as redeemed by reason only that the account has ceased to be in debit` FALSE TRUE EQUALS NOTHING

-- ---- s 754 --------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 754(1) the section applies` `England and Wales` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 754(1) the section applies` `Northern Ireland` TRUE TRUE EQUALS JUST TRUE
-- a company registered in Scotland
#ASSERT `s 754(1) the section applies` `Scotland` TRUE TRUE EQUALS JUST FALSE
-- not secured by a charge; secured by a charge that was fixed as created
#ASSERT `s 754(1) the section applies` `England and Wales` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 754(1) the section applies` `England and Wales` TRUE FALSE EQUALS JUST FALSE
-- (2) possession taken, not in the course of being wound up
#ASSERT `s 754(2) the company's preferential debts are to be paid in priority to the claims on the debentures` `England and Wales` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 754(2) the company's preferential debts are to be paid in priority to the claims on the debentures` `Northern Ireland` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- in the course of being wound up
#ASSERT `s 754(2) the company's preferential debts are to be paid in priority to the claims on the debentures` `England and Wales` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- possession not taken
#ASSERT `s 754(2) the company's preferential debts are to be paid in priority to the claims on the debentures` `England and Wales` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- a Scottish company
#ASSERT `s 754(2) the company's preferential debts are to be paid in priority to the claims on the debentures` `Scotland` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (3) preferential debts: the borrowed Schedule's answer, passed through
#ASSERT `s 754(3) the debt is a preferential debt` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 754(3) the debt is a preferential debt` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 754(3) the debt is a preferential debt` NOTHING EQUALS NOTHING
#ASSERT `s 754(3) the relevant date for those Schedules` (Date 5 3 2024) EQUALS Date 5 3 2024
-- (4) recoupment
#ASSERT `s 754(4) the payment is to be recouped out of the assets available for payment of general creditors` TRUE EQUALS JUST TRUE
#ASSERT `s 754(4) the payment is to be recouped out of the assets available for payment of general creditors` FALSE EQUALS NOTHING
