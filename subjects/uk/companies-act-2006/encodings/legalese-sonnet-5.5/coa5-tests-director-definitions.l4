IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-director-definitions`

-- coa5-tests-director-definitions.l4: tests for ss 250 to 257 (coa5-director-definitions.l4). Expected values read from the text, not from the code.

§ `Tests: ss 250 and 251`

#ASSERT `s 250 the person occupies the position of director` TRUE EQUALS JUST TRUE
#ASSERT `s 250 the person occupies the position of director` FALSE EQUALS NOTHING

#ASSERT `s 251(1) the directors act in accordance with the person's directions or instructions` TRUE EQUALS JUST TRUE
#ASSERT `s 251(1) the directors act in accordance with the person's directions or instructions` FALSE EQUALS JUST FALSE
#ASSERT `s 251(2) the person is not to be regarded as a shadow director by reason only of that` `s 251(2)(a) advice given by that person in a professional capacity` EQUALS JUST TRUE
#ASSERT `s 251(2) the person is not to be regarded as a shadow director by reason only of that` `s 251(2)(b) instructions, a direction, guidance or advice given by that person in the exercise of a function conferred by or under an enactment` EQUALS JUST TRUE
#ASSERT `s 251(2) the person is not to be regarded as a shadow director by reason only of that` `s 251(2)(c) guidance or advice given by that person in that person's capacity as a Minister of the Crown (within the meaning of the Ministers of the Crown Act 1975)` EQUALS JUST TRUE
#ASSERT `s 251(2) the person is not to be regarded as a shadow director by reason only of that` `s 251(2) some other reason` EQUALS NOTHING
-- s 251(3): a body corporate is not a shadow director of its subsidiaries for Chapters 2, 4 and 6 by reason only that their directors are accustomed to act on its directions
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST TRUE) `s 251(3)(a) Chapter 2 (general duties of directors)` TRUE EQUALS JUST TRUE
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST TRUE) `s 251(3)(b) Chapter 4 (transactions requiring members' approval)` TRUE EQUALS JUST TRUE
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST TRUE) `s 251(3)(c) Chapter 6 (contract with sole member who is also a director)` TRUE EQUALS JUST TRUE
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST TRUE) `s 251(3) some other purpose` TRUE EQUALS NOTHING
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` FALSE (JUST TRUE) `s 251(3)(a) Chapter 2 (general duties of directors)` TRUE EQUALS NOTHING
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST TRUE) `s 251(3)(a) Chapter 2 (general duties of directors)` FALSE EQUALS NOTHING
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE (JUST FALSE) `s 251(3)(a) Chapter 2 (general duties of directors)` TRUE EQUALS NOTHING
#ASSERT `s 251(3) the body corporate is not to be regarded as a shadow director of the subsidiary company for the purpose` TRUE NOTHING `s 251(3)(a) Chapter 2 (general duties of directors)` TRUE EQUALS NOTHING
-- s 251: the answer the other parts take
#ASSERT `s 251 the person is a shadow director` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 251 the person is a shadow director` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 251 the person is a shadow director` (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 251 the person is a shadow director` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 251 the person is a shadow director` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 251 the person is a shadow director` NOTHING NOTHING NOTHING EQUALS NOTHING

§ `Tests: s 253`

#ASSERT `s 253(3) subsection (2)(b) applies to the person` TRUE EQUALS JUST FALSE
#ASSERT `s 253(3) subsection (2)(b) applies to the person` FALSE EQUALS NOTHING
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(a) the director's spouse or civil partner` NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(c) the director's children or step-children` NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(e) the director's parents` NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(b) any other person (whether of a different sex or the same sex) with whom the director lives as partner in an enduring family relationship` NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(b) any other person (whether of a different sex or the same sex) with whom the director lives as partner in an enduring family relationship` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(b) any other person (whether of a different sex or the same sex) with whom the director lives as partner in an enduring family relationship` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(d) a child or step-child of a person within paragraph (b), who is not a child or step-child of the director` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2)(d) a child or step-child of a person within paragraph (b), who is not a child or step-child of the director` NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 253(2) the person is a member of the director's family` `s 253(2) some other relationship` NOTHING TRUE EQUALS NOTHING

§ `Tests: s 254`

-- s 254(2): connected if, but only if, interested in at least 20% of the equity share capital by nominal value, or entitled to exercise or control more than 20% of the voting power
-- a body corporate with no equity share capital has no shares comprised in it: limb (a) cannot be met
#ASSERT `s 254(2) the director is connected with the body corporate` 0 0 0 EQUALS JUST FALSE
#ASSERT `s 254(2) the director is connected with the body corporate` 0 0 0.21 EQUALS JUST TRUE
#ASSERT `s 254(2) the director is connected with the body corporate` 20 100 0 EQUALS JUST TRUE
#ASSERT `s 254(2) the director is connected with the body corporate` 19 100 0 EQUALS JUST FALSE
#ASSERT `s 254(2) the director is connected with the body corporate` 0 100 0.21 EQUALS JUST TRUE
#ASSERT `s 254(2) the director is connected with the body corporate` 0 100 0.2 EQUALS JUST FALSE
#ASSERT `s 254(2) the director is connected with the body corporate` 50 100 0 EQUALS JUST TRUE
#ASSERT `s 254(3) the rules in Schedule 1 apply for the purposes of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 254(3) the rules in Schedule 1 apply for the purposes of this section` FALSE EQUALS NOTHING
#ASSERT `s 254(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 254(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 254(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` NOTHING EQUALS NOTHING
#ASSERT `s 254(5) the shares and their voting rights are disregarded` TRUE EQUALS JUST TRUE
#ASSERT `s 254(5) the shares and their voting rights are disregarded` FALSE EQUALS NOTHING
-- s 254(6): circularity guards
#ASSERT `s 254(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 254(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 254(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 254(6)(b) the trustee is not treated as connected with the director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 254(6)(b) the trustee is not treated as connected with the director` TRUE FALSE EQUALS NOTHING
#ASSERT `s 254(6)(b) the trustee is not treated as connected with the director` FALSE TRUE EQUALS NOTHING

§ `Tests: s 255`

-- s 255(2): controls if, but only if, (a) he or a connected person has any interest in the equity capital or any voting power, and (b) he, connected persons and the other directors together hold more than 50%
#ASSERT `s 255(2) the director controls the body corporate` TRUE FALSE 0.51 0 EQUALS JUST TRUE
#ASSERT `s 255(2) the director controls the body corporate` FALSE TRUE 0 0.51 EQUALS JUST TRUE
#ASSERT `s 255(2) the director controls the body corporate` TRUE TRUE 0.5 0.5 EQUALS JUST FALSE
#ASSERT `s 255(2) the director controls the body corporate` TRUE FALSE 0.5 0 EQUALS JUST FALSE
#ASSERT `s 255(2) the director controls the body corporate` FALSE FALSE 0.9 0.9 EQUALS JUST FALSE
#ASSERT `s 255(2) the director controls the body corporate` TRUE TRUE 0.4 0.51 EQUALS JUST TRUE
#ASSERT `s 255(3) the rules in Schedule 1 apply for the purposes of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 255(3) the rules in Schedule 1 apply for the purposes of this section` FALSE EQUALS NOTHING
#ASSERT `s 255(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 255(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 255(4) voting power controlled by a body corporate controlled by the director counts as controlled by the director` NOTHING EQUALS NOTHING
#ASSERT `s 255(5) the shares and their voting rights are disregarded` TRUE EQUALS JUST TRUE
#ASSERT `s 255(5) the shares and their voting rights are disregarded` FALSE EQUALS NOTHING
#ASSERT `s 255(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 255(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 255(6)(a) the body corporate is not treated as connected with the director for the purposes of this section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 255(6)(b) the trustee is not treated as connected with the director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 255(6)(b) the trustee is not treated as connected with the director` TRUE FALSE EQUALS NOTHING

§ `Tests: s 252`

-- (a) and (b) pass the answers of ss 253 and 254 through
#ASSERT `s 252(2)(a) the person is connected with the director as a member of his family` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 252(2)(a) the person is connected with the director as a member of his family` NOTHING EQUALS NOTHING
#ASSERT `s 252(2)(b) the person is connected with the director as a body corporate with which he is connected` (JUST FALSE) EQUALS JUST FALSE

-- (c): trustee of a trust whose beneficiaries include the director or a connected person (or whose trustees' power may be exercised for them), other than an employees' share scheme or pension scheme trust
#ASSERT `s 252(2)(c) the person is connected with the director as a trustee` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 252(2)(c) the person is connected with the director as a trustee` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 252(2)(c) the person is connected with the director as a trustee` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 252(2)(c) the person is connected with the director as a trustee` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 252(2)(c) the person is connected with the director as a trustee` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- (d): partner of the director, or of a person connected under (a), (b) or (c)
#ASSERT `s 252(2)(d) the person is connected with the director as a partner` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 252(2)(d) the person is connected with the director as a partner` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 252(2)(d) the person is connected with the director as a partner` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 252(2)(d) the person is connected with the director as a partner` FALSE TRUE TRUE EQUALS JUST FALSE
-- (e): a firm that is a legal person in which the director is a partner, or a partner is connected, or a partner is such a firm
#ASSERT `s 252(2)(e) the person is connected with the director as a firm` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 252(2)(e) the person is connected with the director as a firm` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 252(2)(e) the person is connected with the director as a firm` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 252(2)(e) the person is connected with the director as a firm` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 252(2)(e) the person is connected with the director as a firm` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- (3): not a person who is himself a director of the company
#ASSERT `s 252(3) a person connected with a director includes the person` TRUE EQUALS JUST FALSE
#ASSERT `s 252(3) a person connected with a director includes the person` FALSE EQUALS NOTHING
-- the answer the other parts take: s 252(3), then (a) to (e)
#ASSERT `s 252 the person is connected with the director` NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 252 the person is connected with the director` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 252 the person is connected with the director` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 252 the person is connected with the director` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 252 the person is connected with the director` NOTHING NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 252 the person is connected with the director` NOTHING NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE

