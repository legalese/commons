IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch10-part1`
IMPORT `coa30-sch11`

-- coa30-tests-sch11.l4: tests for coa30-sch11.l4 (Schedule 11). Expected values are decided from the text of each
-- paragraph before running. Arguments are positional, in GIVEN order.

§ `Tests: Schedule 11`

-- 1(1)
#ASSERT `sch 11 para 1(1) the body may apply to the Secretary of State for a recognition order` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 11 para 1(1) the body may apply to the Secretary of State for a recognition order` (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 11 para 1(1) the body may apply to the Secretary of State for a recognition order` NOTHING EQUALS NOTHING
-- 1(2): "means a qualifying body offering a recognised professional qualification"
#ASSERT `sch 11 para 1(2) the body is a recognised qualifying body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(2) the body is a recognised qualifying body` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(2) the body is a recognised qualifying body` FALSE TRUE EQUALS JUST FALSE
-- 1(3)
#ASSERT `sch 11 para 1(3) the application is made and accompanied as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(3) the application is made and accompanied as required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(3) the application is made and accompanied as required` TRUE FALSE EQUALS JUST FALSE
-- 1(4): after receiving and before determining
#ASSERT `sch 11 para 1(4) the Secretary of State may require the applicant to furnish additional information` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(4) the Secretary of State may require the applicant to furnish additional information` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(4) the Secretary of State may require the applicant to furnish additional information` TRUE TRUE EQUALS JUST FALSE
-- 1(5), 1(6), 1(7)
#ASSERT `sch 11 para 1(5) the directions and requirements may differ as between different applications` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(5) the directions and requirements may differ as between different applications` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(5) the directions and requirements may differ as between different applications` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 11 para 1(6) the Secretary of State may specify the form or manner of verification` TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(6) the Secretary of State may specify the form or manner of verification` FALSE EQUALS NOTHING
#ASSERT `sch 11 para 1(7) the verification required may include independent moderation of the examinations` TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(7) the verification required may include independent moderation of the examinations` FALSE EQUALS NOTHING
-- 1(8): rules always; guidance only if issued
#ASSERT `sch 11 para 1(8) the application is accompanied as required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(8) the application is accompanied as required` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(8) the application is accompanied as required` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(8) the application is accompanied as required` FALSE FALSE FALSE EQUALS JUST FALSE
-- 1(9), 1(10)
#ASSERT `sch 11 para 1(9) the guidance is guidance issued by the applicant` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(9) the guidance is guidance issued by the applicant` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(9) the guidance is guidance issued by the applicant` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(9) the guidance is guidance issued by the applicant` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(10) the matter is within this sub-paragraph` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(10) the matter is within this sub-paragraph` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(10) the matter is within this sub-paragraph` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 1(10) the matter is within this sub-paragraph` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 1(10) the matter is within this sub-paragraph` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- 2(1), 2(2), 2(3), 2(4)
#ASSERT `sch 11 para 2(1) the Secretary of State may make or refuse to make a recognition order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 11 para 2(1) the Secretary of State may make or refuse to make a recognition order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 11 para 2(1) the Secretary of State may make or refuse to make a recognition order` FALSE TRUE EQUALS JUST FALSE
