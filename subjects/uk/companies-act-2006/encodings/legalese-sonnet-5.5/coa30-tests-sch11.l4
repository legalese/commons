-- 3(1): two grounds, either suffices
#ASSERT `sch 11 para 3(1) the Secretary of State may revoke the recognition order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 11 para 3(1) the Secretary of State may revoke the recognition order` FALSE TRUE EQUALS JUST TRUE
