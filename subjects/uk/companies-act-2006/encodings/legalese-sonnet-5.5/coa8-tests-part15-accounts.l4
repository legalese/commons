IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-accounts`

-- Tests of ss 393 to 397 (true and fair view, individual accounts, dormant subsidiaries, accounting framework, contents of individual accounts).
-- Every expected value was written from the text before the run.

-- s 393(1)(a), (1)(b), (2)
#ASSERT `s 393(1)(a) the condition for approving the company's individual accounts is met` TRUE EQUALS JUST TRUE
#ASSERT `s 393(1)(a) the condition for approving the company's individual accounts is met` FALSE EQUALS JUST FALSE
#ASSERT `s 393(1)(b) the condition for approving the company's group accounts is met` TRUE EQUALS JUST TRUE
#ASSERT `s 393(1)(b) the condition for approving the company's group accounts is met` FALSE EQUALS JUST FALSE
#ASSERT `s 393(2) the auditor is required to have regard to the directors' duty under subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 393(2) the auditor is required to have regard to the directors' duty under subsection (1)` FALSE EQUALS NOTHING
-- s 393(1A): a micro-entity's Companies Act individual accounts
#ASSERT `s 393(1A)(a) the directors must disregard an accounting standard provision requiring information additional to the micro-entity minimum accounting items` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 393(1A)(a) the directors must disregard an accounting standard provision requiring information additional to the micro-entity minimum accounting items` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 393(1A)(a) the directors must disregard an accounting standard provision requiring information additional to the micro-entity minimum accounting items` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 393(1A)(a) the directors must disregard an accounting standard provision requiring information additional to the micro-entity minimum accounting items` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 393(1A)(b) the directors must disregard an accounting standard provision requiring further information in relation to the item` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 393(1A)(b) the directors must disregard an accounting standard provision requiring further information in relation to the item` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 393(1A)(b) the directors must disregard an accounting standard provision requiring further information in relation to the item` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 393(1A)(c) the directors must have regard to an accounting standard provision relating to the additional item` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 393(1A)(c) the directors must have regard to an accounting standard provision relating to the additional item` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 393(1A)(c) the directors must have regard to an accounting standard provision relating to the additional item` TRUE FALSE TRUE EQUALS JUST FALSE

