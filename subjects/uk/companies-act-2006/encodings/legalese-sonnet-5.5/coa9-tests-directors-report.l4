IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-directors-report`


-- Tests for coa9-directors-report.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5550-5617 of ukpga-2006-46.txt).

-- ---- s 415(1), (1A) ------------------------------------------------------------------------------------------
-- the directors prepared a directors' report
#ASSERT (`s 415(1) the directors have prepared the directors' report for the financial year` TRUE) EQUALS JUST TRUE
-- none prepared: the duty is not met
#ASSERT (`s 415(1) the directors have prepared the directors' report for the financial year` FALSE) EQUALS JUST FALSE
-- a micro-entity: subsection (1) does not apply
#ASSERT (`s 415(1A) subsection (1) does not apply to the company` (JUST TRUE)) EQUALS JUST TRUE
-- not a micro-entity: the "if" fails
#ASSERT (`s 415(1A) subsection (1) does not apply to the company` (JUST FALSE)) EQUALS JUST FALSE
-- sections 384A and 384B not answered
#ASSERT (`s 415(1A) subsection (1) does not apply to the company` NOTHING) EQUALS NOTHING

-- ---- s 415(2), (3) ------------------------------------------------------------------------------------------
-- a parent company that prepares group accounts
#ASSERT (`s 415(2) the directors' report must be a consolidated report` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- a parent company that prepares no group accounts: (b) fails
#ASSERT (`s 415(2) the directors' report must be a consolidated report` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- group accounts but not a parent company: (a) fails
#ASSERT (`s 415(2) the directors' report must be a consolidated report` (JUST FALSE) TRUE) EQUALS JUST FALSE
-- section 1173(1) not answered
#ASSERT (`s 415(2) the directors' report must be a consolidated report` NOTHING TRUE) EQUALS NOTHING
-- no group accounts: (b) fails whatever (a) says
#ASSERT (`s 415(2) the directors' report must be a consolidated report` NOTHING FALSE) EQUALS JUST FALSE
-- a consolidated report relating to the undertakings included in the consolidation
#ASSERT (`s 415(2) the report is a group directors' report` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 415(2) the report is a group directors' report` FALSE) EQUALS JUST FALSE
-- a group directors' report, where appropriate
#ASSERT (`s 415(3) the group directors' report may give greater emphasis to the matters significant to the undertakings included in the consolidation` TRUE TRUE) EQUALS JUST TRUE
-- not appropriate: the permission is silent
#ASSERT (`s 415(3) the group directors' report may give greater emphasis to the matters significant to the undertakings included in the consolidation` TRUE FALSE) EQUALS NOTHING
-- not a group directors' report
#ASSERT (`s 415(3) the group directors' report may give greater emphasis to the matters significant to the undertakings included in the consolidation` FALSE TRUE) EQUALS NOTHING

-- ---- s 415(4), (5) ------------------------------------------------------------------------------------------
-- failure to prepare; a director immediately before the end of the filing period who took no reasonable steps
#ASSERT (`s 415(4) the person commits an offence` TRUE TRUE TRUE) EQUALS JUST TRUE
-- not a director at that time: outside "every person who"
#ASSERT (`s 415(4) the person commits an offence` TRUE FALSE TRUE) EQUALS NOTHING
-- took all reasonable steps: outside "every person who"
#ASSERT (`s 415(4) the person commits an offence` TRUE TRUE FALSE) EQUALS NOTHING
-- the report was prepared: "In the case of failure" does not arise
#ASSERT (`s 415(4) the person commits an offence` FALSE TRUE TRUE) EQUALS JUST FALSE
-- (a) a fine
#ASSERT (`s 415(5) the penalty for an offence under section 415` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b) a fine not exceeding the statutory maximum
#ASSERT (`s 415(5) the penalty for an offence under section 415` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- the subsection does not distinguish the parts of the United Kingdom
#ASSERT (`s 415(5) the penalty for an offence under section 415` `on summary conviction in Northern Ireland`) EQUALS NOTHING

-- ---- s 415A -------------------------------------------------------------------------------------------------
-- (a) entitled to the small companies regime
#ASSERT (`s 415A(1) the company is entitled to small companies exemption in relation to the directors' report` (JUST TRUE) FALSE) EQUALS JUST TRUE
-- (b) would be but for an ineligible group
#ASSERT (`s 415A(1) the company is entitled to small companies exemption in relation to the directors' report` (JUST FALSE) TRUE) EQUALS JUST TRUE
-- neither (a) nor (b)
#ASSERT (`s 415A(1) the company is entitled to small companies exemption in relation to the directors' report` (JUST FALSE) FALSE) EQUALS JUST FALSE
-- sections 381 to 384 not answered
#ASSERT (`s 415A(1) the company is entitled to small companies exemption in relation to the directors' report` NOTHING FALSE) EQUALS NOTHING
-- (b) holds whatever (a) says
#ASSERT (`s 415A(1) the company is entitled to small companies exemption in relation to the directors' report` NOTHING TRUE) EQUALS JUST TRUE
-- both versions of subsection (2) name section 416(3)
#ASSERT (`s 415A(2) the exemption is relevant to the provision` `s 415A(2) section 416(3) (statement of amount recommended by way of dividend)`) EQUALS JUST TRUE
-- only one of the two versions names them: fork F10
#ASSERT (`s 415A(2) the exemption is relevant to the provision` `s 415A(2) sections 444 to 446 (filing obligations of different descriptions of company)`) EQUALS NOTHING
-- the list is not closed with "only"
#ASSERT (`s 415A(2) the exemption is relevant to the provision` `s 415A(2) another provision`) EQUALS NOTHING

-- ---- s 416 --------------------------------------------------------------------------------------------------
-- a director at some time during the financial year
#ASSERT (`s 416(1)(a) the directors' report must state the name of the person` TRUE) EQUALS JUST TRUE
-- not within "the persons who ... were directors"
#ASSERT (`s 416(1)(a) the directors' report must state the name of the person` FALSE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`s 416(1)(a) the directors' report must state the name of the person` FALSE) EQUALS NOTHING; not a director at any time during the financial year: outside "the persons who, at any time during the financial year, were directors", a period the text fixes in its own words (fork F35; the other reading is NOTHING)
-- not entitled to the small companies exemption: the amount must be stated
#ASSERT (`s 416(3) the directors' report must state the amount (if any) that the directors recommend should be paid by way of dividend` (JUST FALSE)) EQUALS JUST TRUE
-- "Except in the case of a company entitled to the small companies exemption"
#ASSERT (`s 416(3) the directors' report must state the amount (if any) that the directors recommend should be paid by way of dividend` (JUST TRUE)) EQUALS JUST FALSE
-- section 415A(1) not answered
#ASSERT (`s 416(3) the directors' report must state the amount (if any) that the directors recommend should be paid by way of dividend` NOTHING) EQUALS NOTHING

-- ---- s 418 --------------------------------------------------------------------------------------------------
-- audited company
#ASSERT (`s 418(1) this section applies to the company` FALSE FALSE) EQUALS JUST TRUE
-- exempt from audit but the directors do not take advantage
#ASSERT (`s 418(1) this section applies to the company` TRUE FALSE) EQUALS JUST TRUE
-- takes advantage only of an exemption it does not have: "unless (a) and (b)" is not met
#ASSERT (`s 418(1) this section applies to the company` FALSE TRUE) EQUALS JUST TRUE
-- exempt and takes advantage: "unless"
#ASSERT (`s 418(1) this section applies to the company` TRUE TRUE) EQUALS JUST FALSE
-- statements (a) and (b) for each director
#ASSERT (`s 418(2) the directors' report contains the required statement` TRUE TRUE) EQUALS JUST TRUE
-- statement (b) missing
#ASSERT (`s 418(2) the directors' report contains the required statement` TRUE FALSE) EQUALS JUST FALSE
-- statement (a) missing
#ASSERT (`s 418(2) the directors' report contains the required statement` FALSE TRUE) EQUALS JUST FALSE
-- information needed by the auditor in connection with preparing his report
#ASSERT (`s 418(3) the information is relevant audit information` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 418(3) the information is relevant audit information` FALSE) EQUALS JUST FALSE
-- enquiries and other steps (a) and (b)
#ASSERT (`s 418(4) the director is regarded as having taken all the steps that he ought to have taken as a director` TRUE TRUE) EQUALS JUST TRUE
-- no other steps taken: the "if" fails
#ASSERT (`s 418(4) the director is regarded as having taken all the steps that he ought to have taken as a director` TRUE FALSE) EQUALS JUST FALSE
-- no enquiries made: the "if" fails
#ASSERT (`s 418(4) the director is regarded as having taken all the steps that he ought to have taken as a director` FALSE TRUE) EQUALS JUST FALSE
-- approved, false, a director who knew and did not prevent
#ASSERT (`s 418(5) the director commits an offence` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- reckless
#ASSERT (`s 418(5) the director commits an offence` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- neither knew nor reckless: outside "every director ... who"
#ASSERT (`s 418(5) the director commits an offence` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- took reasonable steps to prevent approval
#ASSERT (`s 418(5) the director commits an offence` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- not a director of the company
#ASSERT (`s 418(5) the director commits an offence` TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- the statement is true: "but the statement is false" fails
#ASSERT (`s 418(5) the director commits an offence` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- no report containing the statement was approved
#ASSERT (`s 418(5) the director commits an offence` FALSE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (a) two years or a fine (or both)
#ASSERT (`s 418(6) the penalty for an offence under section 418(5)` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
-- (b)(i) twelve months
#ASSERT (`s 418(6) the penalty for an offence under section 418(5)` `on summary conviction in England and Wales`) EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
-- (b)(ii) six months
#ASSERT (`s 418(6) the penalty for an offence under section 418(5)` `on summary conviction in Scotland`) EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
-- (b)(ii) six months
#ASSERT (`s 418(6) the penalty for an offence under section 418(5)` `on summary conviction in Northern Ireland`) EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
-- summary conviction is divided by place and this does not say where
#ASSERT (`s 418(6) the penalty for an offence under section 418(5)` `on summary conviction`) EQUALS NOTHING

-- ---- s 419 --------------------------------------------------------------------------------------------------
-- approved, signed by a director
#ASSERT (`s 419(1) the directors' report has been approved and signed as required` TRUE TRUE FALSE) EQUALS JUST TRUE
-- approved, signed by the secretary
#ASSERT (`s 419(1) the directors' report has been approved and signed as required` TRUE FALSE TRUE) EQUALS JUST TRUE
-- not signed
#ASSERT (`s 419(1) the directors' report has been approved and signed as required` TRUE FALSE FALSE) EQUALS JUST FALSE
-- not approved by the board
#ASSERT (`s 419(1) the directors' report has been approved and signed as required` FALSE TRUE FALSE) EQUALS JUST FALSE
-- the small companies exemption was taken advantage of
#ASSERT (`s 419(2) the report must contain a statement that advantage is taken of the small companies exemption in a prominent position above the signature` TRUE) EQUALS JUST TRUE
-- the "If" fails
#ASSERT (`s 419(2) the report must contain a statement that advantage is taken of the small companies exemption in a prominent position above the signature` FALSE) EQUALS JUST FALSE
-- a director who knew and took no reasonable steps
#ASSERT (`s 419(3) the director commits an offence` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- reckless
#ASSERT (`s 419(3) the director commits an offence` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- neither knew nor reckless
#ASSERT (`s 419(3) the director commits an offence` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- not a director
#ASSERT (`s 419(3) the director commits an offence` TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- no directors' report approved
#ASSERT (`s 419(3) the director commits an offence` FALSE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- the approved report complies
#ASSERT (`s 419(3) the director commits an offence` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (a) a fine
#ASSERT (`s 419(4) the penalty for an offence under section 419` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b) a fine not exceeding the statutory maximum
#ASSERT (`s 419(4) the penalty for an offence under section 419` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- not distinguished by the subsection
#ASSERT (`s 419(4) the penalty for an offence under section 419` `on summary conviction in Scotland`) EQUALS NOTHING

-- ---- s 419A -------------------------------------------------------------------------------------------------
-- separate statement approved and signed by a director
#ASSERT (`s 419A the separate corporate governance statement has been approved and signed as required` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- signed by the secretary
#ASSERT (`s 419A the separate corporate governance statement has been approved and signed as required` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- not signed
#ASSERT (`s 419A the separate corporate governance statement has been approved and signed as required` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- not approved by the board
#ASSERT (`s 419A the separate corporate governance statement has been approved and signed as required` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
-- not a separate corporate governance statement
#ASSERT (`s 419A the separate corporate governance statement has been approved and signed as required` FALSE TRUE TRUE TRUE) EQUALS NOTHING

