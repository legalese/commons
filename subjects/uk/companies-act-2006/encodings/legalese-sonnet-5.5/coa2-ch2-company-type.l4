    IF `s 61(1) the section applies to the company` EQUALS JUST TRUE
    THEN IF       `s 61(3) the first condition is met` EQUALS JUST TRUE
              AND `s 61(4) the second condition is met` EQUALS JUST TRUE
              AND NOT (`the company has changed its name`)
         THEN JUST TRUE
         ELSE IF       `s 61(3) the first condition is met` EQUALS JUST FALSE
                  OR   `s 61(4) the second condition is met` EQUALS JUST FALSE
                  OR   `the company has changed its name`
              THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "is exempt from section 59 ... so long as— (a) it continues to meet the following two conditions, and (b) it does not change its name"
              ELSE NOTHING -- NOTHING-kind (points outside the text): a condition's answer is not known
    ELSE NOTHING -- NOTHING-kind (limited by its own wording): "A company to which this section applies"

