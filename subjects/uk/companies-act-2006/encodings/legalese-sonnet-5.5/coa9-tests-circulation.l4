IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-circulation`


-- Tests for coa9-circulation.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5658-5706 of ukpga-2006-46.txt).

-- ---- s 423(1) to (6) -----------------------------------------------------------------------------------------
-- a member
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` (JUST TRUE) FALSE FALSE) EQUALS JUST TRUE
-- a holder of the company's debentures
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` (JUST FALSE) TRUE FALSE) EQUALS JUST TRUE
-- a person entitled to receive notice of general meetings
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` (JUST FALSE) FALSE TRUE) EQUALS JUST TRUE
-- none of (a) to (c): the text does not say they need not be sent a copy
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` (JUST FALSE) FALSE FALSE) EQUALS NOTHING
-- section 112 not answered
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` NOTHING FALSE FALSE) EQUALS NOTHING
-- a debenture holder whether or not a member
#ASSERT (`s 423(1) the company must send the person a copy of its annual accounts and reports for the financial year` NOTHING TRUE FALSE) EQUALS JUST TRUE
-- no current address: copies need not be sent
#ASSERT (`s 423(2) copies need not be sent to the person` (JUST FALSE)) EQUALS JUST TRUE
-- a current address: the subsection is silent
#ASSERT (`s 423(2) copies need not be sent to the person` (JUST TRUE)) EQUALS NOTHING
-- the question of a current address not answered
#ASSERT (`s 423(2) copies need not be sent to the person` NOTHING) EQUALS NOTHING
-- an address notified and no reason to believe the documents will not reach him
#ASSERT (`s 423(3) the company has a current address for the person` TRUE TRUE) EQUALS JUST TRUE
-- the company has reason to believe they will not reach him
#ASSERT (`s 423(3) the company has a current address for the person` TRUE FALSE) EQUALS JUST FALSE
-- no address notified
#ASSERT (`s 423(3) the company has a current address for the person` FALSE TRUE) EQUALS JUST FALSE
-- no share capital and not entitled to notices of general meetings
#ASSERT (`s 423(4) copies need not be sent to the person` TRUE FALSE) EQUALS JUST TRUE
-- entitled to notices of general meetings
#ASSERT (`s 423(4) copies need not be sent to the person` TRUE TRUE) EQUALS NOTHING
-- a company with a share capital: outside "a company not having a share capital"
#ASSERT (`s 423(4) copies need not be sent to the person` FALSE FALSE) EQUALS NOTHING
-- sent out over several days: the last day of the period
#ASSERT (`s 423(5) the day on which copies are sent out` TRUE (Date 20 11 2027)) EQUALS JUST (Date 20 11 2027)
-- sent out on a single day: not mentioned
#ASSERT (`s 423(5) the day on which copies are sent out` FALSE (Date 20 11 2027)) EQUALS NOTHING
-- the company uses section 426
#ASSERT (`s 423(6) section 423 gives way to section 426 in the case` TRUE) EQUALS JUST TRUE
-- section 426 not used
#ASSERT (`s 423(6) section 423 gives way to section 426 in the case` FALSE) EQUALS NOTHING

-- ---- s 424(5) ------------------------------------------------------------------------------------------------
-- public immediately before the end of the accounting reference period
#ASSERT (`s 424(5) whether the time allowed is that for a private company or a public company` TRUE) EQUALS `s 424(5) the time allowed for a public company`
-- any other company is private (s 4(1))
#ASSERT (`s 424(5) whether the time allowed is that for a private company or a public company` FALSE) EQUALS `s 424(5) the time allowed for a private company`

-- ---- s 424(2): a private company; tests on both sides of the last day ---------------------------------------
-- End of the filing period 30 September 2027.
-- nothing delivered yet: the end of the filing period
#ASSERT (`s 424(2) the last day on which a private company may send out copies` (Date 30 9 2027) NOTHING) EQUALS Date 30 9 2027
-- delivered earlier: the date of delivery
#ASSERT (`s 424(2) the last day on which a private company may send out copies` (Date 30 9 2027) (JUST (Date 15 8 2027))) EQUALS Date 15 8 2027
-- delivered later: the end of the filing period is the earlier
#ASSERT (`s 424(2) the last day on which a private company may send out copies` (Date 30 9 2027) (JUST (Date 5 10 2027))) EQUALS Date 30 9 2027
-- the last day itself: "not later than"
#ASSERT (`s 424(2) the private company sent the copies out in time` (Date 30 9 2027) (Date 30 9 2027) NOTHING) EQUALS JUST TRUE
-- a day after the end of the filing period
#ASSERT (`s 424(2) the private company sent the copies out in time` (Date 1 10 2027) (Date 30 9 2027) NOTHING) EQUALS JUST FALSE
-- sent on the day it delivered to the registrar
#ASSERT (`s 424(2) the private company sent the copies out in time` (Date 15 8 2027) (Date 30 9 2027) (JUST (Date 15 8 2027))) EQUALS JUST TRUE
-- a day after delivery to the registrar, which was earlier
#ASSERT (`s 424(2) the private company sent the copies out in time` (Date 16 8 2027) (Date 30 9 2027) (JUST (Date 15 8 2027))) EQUALS JUST FALSE
-- delivery was later than the filing period, so (a) governs
#ASSERT (`s 424(2) the private company sent the copies out in time` (Date 1 10 2027) (Date 30 9 2027) (JUST (Date 5 10 2027))) EQUALS JUST FALSE

-- ---- s 424(3): a public company; tests on both sides of the last day ----------------------------------------
-- The relevant accounts meeting is on 22 December 2027, so the last day is 1 December 2027 (21 days before).
-- 21 days before the meeting
#ASSERT (`s 424(3) the last day on which a public company may send out copies` (Date 22 12 2027)) EQUALS Date 1 12 2027
-- exactly 21 days before
#ASSERT (`s 424(3) the public company sent the copies out in time` (Date 1 12 2027) (Date 22 12 2027)) EQUALS JUST TRUE
-- 22 days before
#ASSERT (`s 424(3) the public company sent the copies out in time` (Date 30 11 2027) (Date 22 12 2027)) EQUALS JUST TRUE
-- 20 days before
#ASSERT (`s 424(3) the public company sent the copies out in time` (Date 2 12 2027) (Date 22 12 2027)) EQUALS JUST FALSE
-- on the day of the meeting
#ASSERT (`s 424(3) the public company sent the copies out in time` (Date 22 12 2027) (Date 22 12 2027)) EQUALS JUST FALSE

-- ---- s 424(4), (6) and the whole of section 424 --------------------------------------------------------------
-- a public company, late, all members agree
#ASSERT (`s 424(4) the copies are deemed to have been duly sent` TRUE TRUE TRUE) EQUALS JUST TRUE
-- a public company, late, not all members agree
#ASSERT (`s 424(4) the copies are deemed to have been duly sent` TRUE TRUE FALSE) EQUALS JUST FALSE
-- not a public company: the subsection is not engaged
#ASSERT (`s 424(4) the copies are deemed to have been duly sent` FALSE TRUE TRUE) EQUALS NOTHING
-- not late: the subsection is not engaged
#ASSERT (`s 424(4) the copies are deemed to have been duly sent` TRUE FALSE TRUE) EQUALS NOTHING
-- the accounts meeting at which the accounts and reports are to be laid
#ASSERT (`s 424(6) the meeting is the relevant accounts meeting` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 424(6) the meeting is the relevant accounts meeting` FALSE) EQUALS JUST FALSE
-- public, sent 21 days before
#ASSERT (`s 424(2) to (5) the company sent the copies out within the time allowed` TRUE (Date 1 12 2027) (Date 30 9 2027) NOTHING (Date 22 12 2027) FALSE) EQUALS JUST TRUE
-- public, late, deemed duly sent by agreement
#ASSERT (`s 424(2) to (5) the company sent the copies out within the time allowed` TRUE (Date 2 12 2027) (Date 30 9 2027) NOTHING (Date 22 12 2027) TRUE) EQUALS JUST TRUE
-- public, late, no agreement
#ASSERT (`s 424(2) to (5) the company sent the copies out within the time allowed` TRUE (Date 2 12 2027) (Date 30 9 2027) NOTHING (Date 22 12 2027) FALSE) EQUALS JUST FALSE
-- private, sent on the last day
#ASSERT (`s 424(2) to (5) the company sent the copies out within the time allowed` FALSE (Date 30 9 2027) (Date 30 9 2027) NOTHING (Date 22 12 2027) FALSE) EQUALS JUST TRUE
-- private, a day late
#ASSERT (`s 424(2) to (5) the company sent the copies out within the time allowed` FALSE (Date 1 10 2027) (Date 30 9 2027) NOTHING (Date 22 12 2027) FALSE) EQUALS JUST FALSE

-- ---- s 424(3) as a regulative rule ----------------------------------------------------------------------------
-- The obligation arises on 1 November 2027, 30 days before the last day (1 December 2027). Expected by reading the section:
-- copies sent on day 30 are on time (the last day is inclusive); a wait until day 31 with nothing sent is a breach by the company.
#TRACE `s 424(3) the public company must send out copies` (Date 1 11 2027) (Date 22 12 2027) AT 0 WITH
    PARTY Company DOES `s 424(3) send out copies of the annual accounts and reports` AT 30
-- expected: FULFILLED

#TRACE `s 424(3) the public company must send out copies` (Date 1 11 2027) (Date 22 12 2027) AT 0 WITH
    PARTY Company DOES `s 424(3) send out copies of the annual accounts and reports` AT 31
-- expected: BREACH BY Company (an act after the last day)

#TRACE `s 424(3) the public company must send out copies` (Date 1 11 2027) (Date 22 12 2027) AT 0 WITH
    (WAITUNTIL 31)
-- expected: BREACH BY Company (nothing sent by the last day)


-- ---- s 425 ---------------------------------------------------------------------------------------------------
-- default is made in complying with section 423 or 424
#ASSERT (`s 425(1)(a) the company commits an offence` TRUE) EQUALS JUST TRUE
-- no default
#ASSERT (`s 425(1)(a) the company commits an offence` FALSE) EQUALS JUST FALSE
-- default made; the officer is in default
#ASSERT (`s 425(1)(b) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- default made; the officer is not in default: outside "every officer ... who is in default"
#ASSERT (`s 425(1)(b) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 425(1)(b) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no default by the company
#ASSERT (`s 425(1)(b) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- (a)
#ASSERT (`s 425(2) the penalty for an offence under section 425` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b)
#ASSERT (`s 425(2) the penalty for an offence under section 425` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- not distinguished by the subsection
#ASSERT (`s 425(2) the penalty for an offence under section 425` `on summary conviction in Scotland`) EQUALS NOTHING

-- ---- s 426 and s 426A ----------------------------------------------------------------------------------------
-- a case specified by regulations, conditions complied with
#ASSERT (`s 426(1) the company may provide a copy of the strategic report with the supplementary material instead of copies of the accounts and reports` TRUE TRUE) EQUALS JUST TRUE
-- "provided any conditions so specified are complied with" fails
#ASSERT (`s 426(1) the company may provide a copy of the strategic report with the supplementary material instead of copies of the accounts and reports` TRUE FALSE) EQUALS JUST FALSE
-- not a case the regulations specify: the regulations are outside the sources
#ASSERT (`s 426(1) the company may provide a copy of the strategic report with the supplementary material instead of copies of the accounts and reports` FALSE TRUE) EQUALS NOTHING
-- the option was used; the person is entitled and wishes to receive them
#ASSERT (`s 426(2) the company must send the person copies of the accounts and reports` TRUE TRUE TRUE) EQUALS JUST TRUE
-- the person does not wish to receive them
#ASSERT (`s 426(2) the company must send the person copies of the accounts and reports` TRUE TRUE FALSE) EQUALS NOTHING
-- not entitled under section 423
#ASSERT (`s 426(2) the company must send the person copies of the accounts and reports` TRUE FALSE TRUE) EQUALS NOTHING
-- the option was not used
#ASSERT (`s 426(2) the company must send the person copies of the accounts and reports` FALSE TRUE TRUE) EQUALS NOTHING
-- copies sent under section 146 to a nominated person
#ASSERT (`s 426(5) section 426 applies to the copies as it applies to copies required to be sent out in accordance with section 423 to a member` TRUE) EQUALS JUST TRUE
-- other copies
#ASSERT (`s 426(5) section 426 applies to the copies as it applies to copies required to be sent out in accordance with section 423 to a member` FALSE) EQUALS NOTHING
-- unquoted, (a) to (d) met, nothing qualified
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- unquoted, both reports qualified and set out in full
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- (c) the auditor's report was qualified but not set out in full
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (d) the section 496 statement was qualified but not set out
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- (a) the statement that the strategic report is only part is missing
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (b) how to obtain a full copy is missing
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (c) whether the auditor's report was qualified is not stated
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (d) whether the section 496 statement was qualified is not stated
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST FALSE) TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- quoted, with the single total figure table
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
-- quoted, (e) the single total figure table is missing
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- section 385 not answered
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` NOTHING TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- (a) missing whatever section 385 says
#ASSERT (`s 426A(2) the supplementary material contains what the subsection requires` NOTHING FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE

