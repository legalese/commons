#ASSERT `s 37 the provision is void` `s 32(1) test profile limited by guarantee without a share capital` FALSE TRUE EQUALS NOTHING
#ASSERT `s 37 the provision is void` `s 32(1) test profile limited by guarantee without a share capital` TRUE FALSE EQUALS NOTHING
#ASSERT `s 37 the provision is void` `s 32(1) test profile limited by guarantee with a share capital` TRUE TRUE EQUALS NOTHING
#ASSERT `s 37 the provision is void` `s 32(1) test profile limited by shares with a share capital` TRUE TRUE EQUALS NOTHING
#ASSERT `s 37 the provision is void` `s 32(1) test profile unlimited` TRUE TRUE EQUALS NOTHING
