#ASSERT `s 33(2) the money is a debt due from the member to the company` FALSE EQUALS NOTHING
#ASSERT `s 33(2) the debt is of the nature of an ordinary contract debt` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 33(2) the debt is of the nature of an ordinary contract debt` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 33(2) the debt is of the nature of an ordinary contract debt` `Scotland` EQUALS NOTHING

