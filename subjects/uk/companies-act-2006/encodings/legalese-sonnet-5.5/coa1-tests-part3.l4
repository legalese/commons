#ASSERT `s 32(1) the documents the company must send to the member` `s 32(1) test profile limited by guarantee without a share capital` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `s 32(1)(a) an up-to-date copy of the company's articles`, `s 32(1)(f) a copy of the company's current certificate of incorporation, and of any past certificates`, `s 32(1)(h) a copy of the statement of guarantee`
#ASSERT `s 32(1) the documents the company must send to the member` `s 32(1) test profile unlimited` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `s 32(1)(a) an up-to-date copy of the company's articles`, `s 32(1)(f) a copy of the company's current certificate of incorporation, and of any past certificates`
#ASSERT `s 32(1) the documents the company must send to the member` `s 32(1) test profile limited by guarantee with a share capital` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS LIST `s 32(1)(a) an up-to-date copy of the company's articles`, `s 32(1)(f) a copy of the company's current certificate of incorporation, and of any past certificates`, `s 32(1)(g) a current statement of capital`, `s 32(1)(h) a copy of the statement of guarantee`
#ASSERT `s 32(1) the documents the company must send to the member` `s 32(1) test profile limited by shares with a share capital` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS LIST `s 32(1)(a) an up-to-date copy of the company's articles`, `s 32(1)(b) a copy of a resolution or agreement to which Chapter 3 applies that is for the time being in force`, `s 32(1)(c)(i) a copy of a document sent to the registrar under section 34(2)`, `s 32(1)(c)(ii) a copy of a document sent to the registrar under section 35(2)(a)`, `s 32(1)(d) a copy of a court order under section 899 or 900`, `s 32(1)(da) a copy of a court order under section 901F or 901J`, `s 32(1)(e) a copy of a court order under section 996 that alters the company's constitution`, `s 32(1)(f) a copy of the company's current certificate of incorporation, and of any past certificates`, `s 32(1)(g) a current statement of capital`
-- the duty, run (read, not asserted). Expected: FULFILLED.
#TRACE `s 32(1) the company's duty` AT 0 WITH
    PARTY Company DOES `s 32(1) send the member the documents listed` AT 3
`s 32(2)(c) test class complete` MEANS `s 32(2)(c) statement for a class of shares` OF TRUE, TRUE, TRUE
`s 32(2)(c) test class lacking rights` MEANS `s 32(2)(c) statement for a class of shares` OF FALSE, TRUE, TRUE
`s 32(2)(c) test class lacking number` MEANS `s 32(2)(c) statement for a class of shares` OF TRUE, FALSE, TRUE
`s 32(2)(c) test class lacking value` MEANS `s 32(2)(c) statement for a class of shares` OF TRUE, TRUE, FALSE
-- "(2) The statement of capital required by subsection (1)(g) is a statement of— (a) the total number of shares of the company, (b) the aggregate nominal value of those shares, (ba) the aggregate amount (if any) unpaid on those shares ..., and (c) for each class of shares— (i) prescribed particulars of the rights attached to the shares, (ii) the total number of shares of that class, ... (iii) the aggregate nominal value of shares of that class"
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE TRUE TRUE (LIST `s 32(2)(c) test class complete`, `s 32(2)(c) test class complete`) EQUALS JUST TRUE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` FALSE TRUE TRUE (LIST `s 32(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE FALSE TRUE (LIST `s 32(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE TRUE FALSE (LIST `s 32(2)(c) test class complete`) EQUALS JUST FALSE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE TRUE TRUE (LIST `s 32(2)(c) test class lacking rights`) EQUALS JUST FALSE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE TRUE TRUE (LIST `s 32(2)(c) test class lacking number`) EQUALS JUST FALSE
#ASSERT `s 32(2) the document is the statement of capital required by subsection (1)(g)` TRUE TRUE TRUE (LIST `s 32(2)(c) test class lacking value`) EQUALS JUST FALSE
-- "(3) If a company makes default in complying with this section, an offence is committed by every officer of the company who is in default."
#ASSERT `s 32(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 32(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 32(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 32(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
-- "(4) A person guilty of an offence under this section is liable on summary conviction to a fine not exceeding level 3 on the standard scale." (no daily default fine)
#ASSERT `s 32(4) the penalty`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT `s 32(4) the penalty`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT `s 32(4) the most the person can be fined on summary conviction, in pounds` 1000 EQUALS 1000

-- ---- s 33 ----
