IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa14-nouns`
IMPORT `coa14-ch08-alteration`
IMPORT `coa14-ch10-reduction`

-- coa14-tests-ch10.l4: tests for Chapter 10 (ss 641 to 653). EXPECTED VALUES ARE HAND-WRITTEN FROM THE TEXT, beside each
-- assertion or in the arguments of the generator line that makes a group of them. A failing assertion is a finding.

§ `Tests: Chapter 10 -- Reduction of share capital`

-- fixtures for the statement of capital (the rule is s 619(3); ss 644(2) and 649(2) repeat it)
`s 619 fixture complete class entry` MEANS `s 619(3)(c) class entry in a statement of capital` OF TRUE, TRUE, TRUE
`s 619 fixture class entry without the number` MEANS `s 619(3)(c) class entry in a statement of capital` OF TRUE, FALSE, TRUE
`s 619 fixture complete statement` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement without the aggregate unpaid` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, FALSE, (LIST `s 619 fixture complete class entry`), TRUE
`s 619 fixture statement with a class entry lacking the number` MEANS `s 619(3) statement of capital` OF TRUE, TRUE, TRUE, (LIST `s 619 fixture class entry without the number`), TRUE


§§ `s 641`
-- (1) route (a): a private company limited by shares, by special resolution supported by a solvency statement
--  columns: limited with a share capital, route, private, limited by shares, s 283 special resolution, s 642(1) supported, confirmed by the court
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(a) special resolution supported by a solvency statement` TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(a) special resolution supported by a solvency statement` TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(a) special resolution supported by a solvency statement` TRUE TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(a) special resolution supported by a solvency statement` FALSE TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(a) special resolution supported by a solvency statement` TRUE FALSE (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
-- route (b): in any case, by special resolution confirmed by the court
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(b) special resolution confirmed by the court` FALSE FALSE (JUST TRUE) NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(b) special resolution confirmed by the court` FALSE FALSE (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `s 641(1) the company may reduce its share capital by this route` TRUE `s 641(1)(b) special resolution confirmed by the court` FALSE FALSE (JUST FALSE) NOTHING TRUE EQUALS NOTHING
-- a company that is not a limited company having a share capital
#ASSERT `s 641(1) the company may reduce its share capital by this route` FALSE `s 641(1)(b) special resolution confirmed by the court` FALSE FALSE (JUST TRUE) NOTHING TRUE EQUALS NOTHING
-- (2) no member left holding other than redeemable shares: a bar on route (a) only
#ASSERT `s 641(2) the section bars the reduction under subsection (1)(a)` `s 641(1)(a) special resolution supported by a solvency statement` TRUE EQUALS JUST TRUE
#ASSERT `s 641(2) the section bars the reduction under subsection (1)(a)` `s 641(1)(a) special resolution supported by a solvency statement` FALSE EQUALS JUST FALSE
#ASSERT `s 641(2) the section bars the reduction under subsection (1)(a)` `s 641(1)(b) special resolution confirmed by the court` TRUE EQUALS NOTHING
-- (2C) "scheme" means a compromise or arrangement sanctioned by the court under Part 26 or 26A; "associate" is s 988's
#ASSERT `s 641(2C) the arrangement is a scheme` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 641(2C) the arrangement is a scheme` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 641(2C) the arrangement is a scheme` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 641(2C) the person is an associate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 641(2C) the person is an associate` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 641(2C) the person is an associate` NOTHING EQUALS NOTHING
-- (2B) the carve-out: a new parent undertaking, all or substantially all members move up, in the same or substantially the same proportions
#ASSERT `s 641(2B) subsection (2A) does not apply to the scheme` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 641(2B) subsection (2A) does not apply to the scheme` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 641(2B) subsection (2A) does not apply to the scheme` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 641(2B) subsection (2A) does not apply to the scheme` TRUE TRUE FALSE EQUALS NOTHING
-- (2A) the takeover-scheme bar
--  columns: s 641(2C) scheme, acquire all the shares, more than one class, acquire all the shares of one or more classes, s 641(2B) carve-out
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST TRUE) TRUE FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST TRUE) FALSE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST TRUE) FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST TRUE) FALSE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST TRUE) TRUE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` (JUST FALSE) TRUE FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` NOTHING TRUE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 641(2A) the section bars the reduction as part of the scheme` NOTHING FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
-- (3) subject to (2) to (2B), in any way: subsection (2) is a bar on route (a) only
--  columns: route, s 641(2) bar, s 641(2A) bar
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(a) special resolution supported by a solvency statement` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(a) special resolution supported by a solvency statement` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(a) special resolution supported by a solvency statement` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(a) special resolution supported by a solvency statement` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(a) special resolution supported by a solvency statement` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(b) special resolution confirmed by the court` NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(b) special resolution confirmed by the court` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 641(3) the company may reduce its share capital in the way proposed` `s 641(1)(b) special resolution confirmed by the court` NOTHING (JUST TRUE) EQUALS JUST FALSE
-- (4) in particular
#ASSERT `s 641(4) the reduction is of a kind the section names` `s 641(4)(a) extinguishing or reducing the liability on shares in respect of share capital not paid up` EQUALS JUST TRUE
#ASSERT `s 641(4) the reduction is of a kind the section names` `s 641(4)(b)(i) cancelling paid-up share capital that is lost or unrepresented by available assets` EQUALS JUST TRUE
#ASSERT `s 641(4) the reduction is of a kind the section names` `s 641(4)(b)(ii) repaying paid-up share capital in excess of the company's wants` EQUALS JUST TRUE
#ASSERT `s 641(4) the reduction is of a kind the section names` `s 641(4) some other kind of reduction` EQUALS NOTHING
-- (5) the resolution may not provide for a later effect than the date it has effect under this Chapter (1 March 2023)
#ASSERT `s 641(5) the resolution is barred from providing for that date` (Date 2 3 2023) (Date 1 3 2023) EQUALS JUST TRUE
#ASSERT `s 641(5) the resolution is barred from providing for that date` (Date 1 3 2023) (Date 1 3 2023) EQUALS JUST FALSE
#ASSERT `s 641(5) the resolution is barred from providing for that date` (Date 28 2 2023) (Date 1 3 2023) EQUALS JUST FALSE
-- (6) the articles
#ASSERT `s 641(6) the company's articles bar the reduction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 641(6) the company's articles bar the reduction` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 641(6) the company's articles bar the reduction` FALSE TRUE EQUALS JUST FALSE
-- (7) "the court" means, in England and Wales, the High Court (except in the phrases about Part 26 and 26A)
#ASSERT `s 641(7) the court is the High Court` `England and Wales` FALSE EQUALS JUST TRUE
#ASSERT `s 641(7) the court is the High Court` `England and Wales` TRUE EQUALS NOTHING
#ASSERT `s 641(7) the court is the High Court` `Scotland` FALSE EQUALS NOTHING
#ASSERT `s 641(7) the court is the High Court` `Northern Ireland` FALSE EQUALS NOTHING
-- all together
#ASSERT `s 641 the reduction of share capital is within the section` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 641 the reduction of share capital is within the section` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 641 the reduction of share capital is within the section` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 641 the reduction of share capital is within the section` NOTHING (JUST TRUE) (JUST FALSE) EQUALS NOTHING

§§ `s 642`
-- (1) the statement is made not more than 15 days before the resolution is passed (20 March 2023: from 5 March to 20 March) and both are registered
--  columns: private company limited by shares, date of the statement, date of the resolution, s 643 answer, registered under s 644
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 5 3 2023) (Date 20 3 2023) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 4 3 2023) (Date 20 3 2023) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 20 3 2023) (Date 20 3 2023) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 21 3 2023) (Date 20 3 2023) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 5 3 2023) (Date 20 3 2023) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 5 3 2023) (Date 20 3 2023) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 642(1) the resolution is supported by a solvency statement` TRUE (Date 5 3 2023) (Date 20 3 2023) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 642(1) the resolution is supported by a solvency statement` FALSE (Date 5 3 2023) (Date 20 3 2023) (JUST TRUE) TRUE EQUALS NOTHING
-- (2) written resolution: the copy at or before the time the proposed resolution is sent
#ASSERT `s 642(2) the copy of the solvency statement was sent or submitted to the eligible member in time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 642(2) the copy of the solvency statement was sent or submitted to the eligible member in time` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 642(2) the copy of the solvency statement was sent or submitted to the eligible member in time` FALSE FALSE EQUALS NOTHING
-- (3) general meeting: available for inspection throughout the meeting
#ASSERT `s 642(3) the copy of the solvency statement was made available for inspection throughout the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 642(3) the copy of the solvency statement was made available for inspection throughout the meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 642(3) the copy of the solvency statement was made available for inspection throughout the meeting` FALSE TRUE EQUALS NOTHING
-- (4) the validity of the resolution is not affected by a failure under (2) or (3)
#ASSERT `s 642(4) the failure affects the validity of the resolution` TRUE EQUALS JUST FALSE
#ASSERT `s 642(4) the failure affects the validity of the resolution` FALSE EQUALS NOTHING

§§ `s 643`
-- fixtures: a director's opinions, positionally: (a) no ground to be found unable to pay; (b)(i) debts in full within twelve months of the winding up; (b)(ii) debts as they fall due during the year
`s 643 fixture director who formed the opinions for a winding up` MEANS `s 643(1) director's opinions` OF TRUE, TRUE, FALSE
`s 643 fixture director who formed the opinions for the year` MEANS `s 643(1) director's opinions` OF TRUE, FALSE, TRUE
`s 643 fixture director lacking opinion (a)` MEANS `s 643(1) director's opinions` OF FALSE, TRUE, TRUE
-- (1) a winding up within twelve months is intended: (b)(i) is needed; otherwise (b)(ii)
#ASSERT `s 643(1) the statement is a solvency statement` TRUE (LIST `s 643 fixture director who formed the opinions for a winding up`, `s 643 fixture director who formed the opinions for a winding up`) EQUALS JUST TRUE
#ASSERT `s 643(1) the statement is a solvency statement` TRUE (LIST `s 643 fixture director who formed the opinions for a winding up`, `s 643 fixture director who formed the opinions for the year`) EQUALS JUST FALSE
#ASSERT `s 643(1) the statement is a solvency statement` FALSE (LIST `s 643 fixture director who formed the opinions for the year`, `s 643 fixture director who formed the opinions for the year`) EQUALS JUST TRUE
#ASSERT `s 643(1) the statement is a solvency statement` FALSE (LIST `s 643 fixture director who formed the opinions for the year`, `s 643 fixture director who formed the opinions for a winding up`) EQUALS JUST FALSE
#ASSERT `s 643(1) the statement is a solvency statement` FALSE (LIST `s 643 fixture director lacking opinion (a)`) EQUALS JUST FALSE
#ASSERT `s 643(1) the statement is a solvency statement` TRUE EMPTY EQUALS NOTHING
#ASSERT `s 643(2) the directors took into account what the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 643(2) the directors took into account what the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 643(2) the directors took into account what the section requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 643(3) the solvency statement is in the form and states what the section requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 643(3) the solvency statement is in the form and states what the section requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 643(3) the solvency statement is in the form and states what the section requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 643(3) the solvency statement is in the form and states what the section requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 643 the statement is made in accordance with section 643` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 643 the statement is made in accordance with section 643` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 643 the statement is made in accordance with section 643` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 643 the statement is made in accordance with section 643` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 643 the statement is made in accordance with section 643` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- (4) the offence: no reasonable grounds, delivered to the registrar, a director in default
--  columns: made without reasonable grounds, delivered to the registrar, s 1121 in default
#ASSERT `s 643(4) the director commits an offence` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 643(4) the director commits an offence` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 643(4) the director commits an offence` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 643(4) the director commits an offence` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 643(4) the director commits an offence` TRUE TRUE NOTHING EQUALS NOTHING
-- (5) the penalties: on indictment two years or a fine or both; summary E&W twelve months or the statutory maximum or both; Scotland and Northern Ireland six months
#ASSERT `s 643(5) the penalty for a person guilty of an offence under subsection (4)` TRUE EQUALS JUST (LIST (Penalty OF `on conviction on indictment`, (JUST (Period OF 2, Years)), (JUST `a fine without a stated limit`), NOTHING, TRUE), (Penalty OF `on summary conviction in England and Wales`, (JUST (Period OF 12, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE), (Penalty OF `on summary conviction in Scotland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE), (Penalty OF `on summary conviction in Northern Ireland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE))
#ASSERT `s 643(5) the penalty for a person guilty of an offence under subsection (4)` FALSE EQUALS NOTHING

§§ `s 644`
-- (1) documents within 15 days after the resolution is passed; 20 March 2023: the last day is 4 April 2023
-- s 644(1): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 644(1) the last day for the documents` (Date 20 3 2023) EQUALS Date 4 4 2023
#ASSERT `s 644(1) the number of days allowed for the documents` (Date 20 3 2023) EQUALS 15
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) (JUST (Date 4 4 2023)) (Date 4 4 2023) EQUALS JUST TRUE
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) (JUST (Date 20 3 2023)) (Date 4 4 2023) EQUALS JUST TRUE
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) (JUST (Date 5 4 2023)) (Date 5 4 2023) EQUALS JUST FALSE
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) (JUST (Date 19 3 2023)) (Date 5 4 2023) EQUALS NOTHING
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) NOTHING (Date 5 4 2023) EQUALS JUST FALSE
#ASSERT `s 644(1) the company delivered the documents to the registrar in time` (Date 20 3 2023) NOTHING (Date 4 4 2023) EQUALS NOTHING
-- a month after the 20 2 2023: the last day of a shorter month (the calendar month clamps)
#ASSERT `s 644(1) the last day for the documents` (Date 20 2 2023) EQUALS Date 7 3 2023
-- the regulative duty: acting inside the period fulfils it, waiting past it is a breach (traces; a DEONTIC cannot be compared)
#TRACE `s 644(1) the company's duty to deliver to the registrar a copy of the solvency statement and a statement of capital` 15 AT 0 WITH
    PARTY Company DOES `Action of a party` Company Registrar "deliver to the registrar a copy of the solvency statement and a statement of capital" AT 15
#TRACE `s 644(1) the company's duty to deliver to the registrar a copy of the solvency statement and a statement of capital` 15 AT 0 WITH
    (WAITUNTIL 16)

#ASSERT `s 644(1)(a) a copy of the solvency statement was delivered` TRUE EQUALS JUST TRUE
#ASSERT `s 644(1)(a) a copy of the solvency statement was delivered` FALSE EQUALS JUST FALSE
#ASSERT `s 644(1)(b) a statement of capital was delivered` TRUE EQUALS JUST TRUE
#ASSERT `s 644(1)(b) a statement of capital was delivered` FALSE EQUALS JUST FALSE
#ASSERT `s 644(1) the delivery of the copy of the resolution under Chapter 3 of Part 3 is still required` TRUE EQUALS JUST TRUE
#ASSERT `s 644(1) the delivery of the copy of the resolution under Chapter 3 of Part 3 is still required` FALSE EQUALS JUST TRUE
#ASSERT `s 644(2) the statement of capital states what the section requires` `s 619 fixture complete statement` EQUALS JUST TRUE
#ASSERT `s 644(2) the statement of capital states what the section requires` `s 619 fixture statement without the aggregate unpaid` EQUALS JUST FALSE
#ASSERT `s 644(3) the registrar is obliged to register the documents` TRUE EQUALS JUST TRUE
#ASSERT `s 644(3) the registrar is obliged to register the documents` FALSE EQUALS JUST FALSE
-- (4) the resolution does not take effect until the documents are registered
#ASSERT `s 644(4) the resolution cannot yet take effect` FALSE EQUALS JUST TRUE
#ASSERT `s 644(4) the resolution cannot yet take effect` TRUE EQUALS JUST FALSE
-- (5) the directors' statement, also within 15 days
-- s 644(5): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 644(5) the last day for the directors' statement` (Date 20 3 2023) EQUALS Date 4 4 2023
#ASSERT `s 644(5) the number of days allowed for the directors' statement` (Date 20 3 2023) EQUALS 15
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) (JUST (Date 4 4 2023)) (Date 4 4 2023) EQUALS JUST TRUE
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) (JUST (Date 20 3 2023)) (Date 4 4 2023) EQUALS JUST TRUE
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) (JUST (Date 5 4 2023)) (Date 5 4 2023) EQUALS JUST FALSE
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) (JUST (Date 19 3 2023)) (Date 5 4 2023) EQUALS NOTHING
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) NOTHING (Date 5 4 2023) EQUALS JUST FALSE
#ASSERT `s 644(5) the company delivered the directors' statement to the registrar in time` (Date 20 3 2023) NOTHING (Date 4 4 2023) EQUALS NOTHING
-- the regulative duty: acting inside the period fulfils it, waiting past it is a breach (traces; a DEONTIC cannot be compared)
#TRACE `s 644(5) the company's duty to deliver to the registrar a statement by the directors confirming that the solvency statement was made in time and provided to members` 15 AT 0 WITH
    PARTY Company DOES `Action of a party` Company Registrar "deliver to the registrar a statement by the directors confirming that the solvency statement was made in time and provided to members" AT 15
#TRACE `s 644(5) the company's duty to deliver to the registrar a statement by the directors confirming that the solvency statement was made in time and provided to members` 15 AT 0 WITH
    (WAITUNTIL 16)

#ASSERT `s 644(5)(a) the directors' statement confirms that the solvency statement was made not more than 15 days before the resolution was passed` TRUE EQUALS JUST TRUE
#ASSERT `s 644(5)(a) the directors' statement confirms that the solvency statement was made not more than 15 days before the resolution was passed` FALSE EQUALS JUST FALSE
#ASSERT `s 644(5)(b) the directors' statement confirms that the solvency statement was provided to members in accordance with section 642(2) or (3)` TRUE EQUALS JUST TRUE
#ASSERT `s 644(5)(b) the directors' statement confirms that the solvency statement was provided to members in accordance with section 642(2) or (3)` FALSE EQUALS JUST FALSE
-- (6) validity
#ASSERT `s 644(6) the failure affects the validity of the resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 644(6) the failure affects the validity of the resolution` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 644(6) the failure affects the validity of the resolution` FALSE FALSE EQUALS NOTHING
-- (7) delivering a solvency statement not provided to members: every officer in default
#ASSERT `s 644(7) the officer commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 644(7) the officer commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 644(7) the officer commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 644(7) the officer commits an offence` TRUE NOTHING EQUALS NOTHING
-- (8) default in complying with the section
-- s 644(8): default is made if any requirement is not met
#ASSERT `s 644(8) default is made in complying with this section` (LIST (JUST TRUE), (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 644(8) default is made in complying with this section` (LIST (JUST TRUE), (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 644(8) default is made in complying with this section` (LIST (JUST TRUE), NOTHING) EQUALS NOTHING
#ASSERT `s 644(8) default is made in complying with this section` (LIST NOTHING, (JUST FALSE)) EQUALS JUST TRUE
-- s 644(8): an offence is committed by (a) the company, and (b) every officer who is in default
#ASSERT `s 644(8)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 644(8)(a) the company commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 644(8)(a) the company commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 644(8)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 644(8)(b) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 644(8)(b) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 644(8)(b) the officer commits an offence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 644(8)(b) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING

#ASSERT `s 644(9) the penalty for a person guilty of an offence under subsection (7) or (8)` TRUE EQUALS JUST (LIST (Penalty OF `on conviction on indictment`, NOTHING, (JUST `a fine without a stated limit`), NOTHING, FALSE), (Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, FALSE))
#ASSERT `s 644(9) the penalty for a person guilty of an offence under subsection (7) or (8)` FALSE EQUALS NOTHING


§§ `s 645`
#ASSERT `s 645(1) the company may apply to the court for an order confirming the reduction` TRUE EQUALS JUST TRUE
#ASSERT `s 645(1) the company may apply to the court for an order confirming the reduction` FALSE EQUALS JUST FALSE
