IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-declaration`

-- coa4-tests-declaration.l4: tests for coa4-declaration.l4 (ss 182 to 187). Expected values are written from the text of the
-- section named beside each assertion, before the code was run.

-- s 182(5): arguments: aware of the interest; ought reasonably to be aware of it; aware of the transaction; ought reasonably to be aware of the transaction
#ASSERT `s 182(5) the section requires a declaration so far as the director's awareness goes` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 182(5) the section requires a declaration so far as the director's awareness goes` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 182(5) the section requires a declaration so far as the director's awareness goes` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 182(5) the section requires a declaration so far as the director's awareness goes` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 182(5) the section requires a declaration so far as the director's awareness goes` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 182(6): any one of the five limbs suffices
#ASSERT `s 182(6) the director need not declare the interest under section 182` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 182(6) the director need not declare the interest under section 182` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 182(6) the director need not declare the interest under section 182` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 182(6) the director need not declare the interest under section 182` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 182(6) the director need not declare the interest under section 182` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 182(6) the director need not declare the interest under section 182` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 182(1): arguments: interested in a transaction already entered into; already declared under s 177; the answer under (5); the answer under (6)
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` FALSE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE FALSE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 182(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE FALSE (JUST TRUE) NOTHING EQUALS NOTHING
-- s 182(2): arguments: at a meeting; the person is a shadow director; s 184 notice; s 185 general notice
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` TRUE TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` FALSE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` FALSE FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` FALSE FALSE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 182(2) the declaration is made in a way the subsection requires` FALSE FALSE (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 182(3) a further declaration must be made` TRUE EQUALS JUST TRUE
#ASSERT `s 182(3) a further declaration must be made` FALSE EQUALS JUST FALSE
#ASSERT `s 182(4) the declaration was made as soon as is reasonably practicable` TRUE EQUALS JUST TRUE
#ASSERT `s 182(4) the declaration was made as soon as is reasonably practicable` FALSE EQUALS JUST FALSE
#ASSERT `s 182(4) the failure affects the underlying duty to make the declaration` TRUE EQUALS JUST FALSE
#ASSERT `s 182(4) the failure affects the underlying duty to make the declaration` FALSE EQUALS NOTHING
-- s 182 as a whole: arguments: the answer under (1); declared; the answer under (2); the answer under (4)
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 182 the director has complied with the requirements of section 182` NOTHING TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 182 the director has complied with the requirements of section 182` (JUST TRUE) TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#TRACE `s 182 the director's duty to declare the interest to the other directors` AT 0 WITH
    PARTY Director DOES `Action of a party` OF Director, Director, "declare the nature and extent of the interest to the other directors as soon as is reasonably practicable" AT 1
#TRACE `s 182 the director's duty to declare the interest to the other directors` AT 0 WITH
    (WAITUNTIL 5)

#ASSERT `s 183(1) the director commits an offence` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 183(1) the director commits an offence` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 183(1) the director commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 183(2) the penalty for the offence` `on conviction on indictment` EQUALS JUST (Penalty WITH `how convicted` IS `on conviction on indictment`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 183(2) the penalty for the offence` `on summary conviction` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 183(2) the penalty for the offence` `on summary conviction in Scotland` EQUALS NOTHING
#ASSERT `s 184(1) the section applies to the declaration` TRUE EQUALS JUST TRUE
#ASSERT `s 184(1) the section applies to the declaration` FALSE EQUALS NOTHING
#ASSERT `s 184(2) the director has sent the notice to the other directors` TRUE EQUALS JUST TRUE
#ASSERT `s 184(2) the director has sent the notice to the other directors` FALSE EQUALS JUST FALSE
-- s 184(3): arguments: the form; the recipient has agreed to receive electronic form; the notice is in an agreed electronic form
#ASSERT `s 184(3) the notice is sent in a form the subsection allows` `hard copy form` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 184(3) the notice is sent in a form the subsection allows` `electronic form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(3) the notice is sent in a form the subsection allows` `electronic form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(3) the notice is sent in a form the subsection allows` `electronic form` FALSE TRUE EQUALS JUST FALSE
-- s 184(4): arguments: the means; the recipient has agreed to receive it by electronic means
#ASSERT `s 184(4) the notice is sent by a means the subsection allows` `s 184(4)(a) by hand` FALSE EQUALS JUST TRUE
#ASSERT `s 184(4) the notice is sent by a means the subsection allows` `s 184(4)(a) by post` FALSE EQUALS JUST TRUE
#ASSERT `s 184(4) the notice is sent by a means the subsection allows` `s 184(4)(b) by electronic means` TRUE EQUALS JUST TRUE
#ASSERT `s 184(4) the notice is sent by a means the subsection allows` `s 184(4)(b) by electronic means` FALSE EQUALS JUST FALSE
#ASSERT `s 184(4) the notice is sent by a means the subsection allows` `s 184(4) by another means` TRUE EQUALS NOTHING
#ASSERT `s 184(5)(a) the making of the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` TRUE EQUALS JUST TRUE
#ASSERT `s 184(5)(a) the making of the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` FALSE EQUALS NOTHING
#ASSERT `s 184(5)(b) the provisions of section 248 apply as if the declaration had been made at that meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 184(5)(b) the provisions of section 248 apply as if the declaration had been made at that meeting` FALSE EQUALS NOTHING
#ASSERT `s 184 the notice in writing is in accordance with section 184` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184 the notice in writing is in accordance with section 184` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184 the notice in writing is in accordance with section 184` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184 the notice in writing is in accordance with section 184` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184 the notice in writing is in accordance with section 184` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
-- s 185(2): arguments: to the effect (a) interest in a specified body corporate or firm; to the effect (b) connected with a specified person; s 252 connected
#ASSERT `s 185(2) the notice is general notice` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 185(2) the notice is general notice` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 185(2) the notice is general notice` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(2) the notice is general notice` FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 185(2) the notice is general notice` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 185(3) the notice states what the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 185(3) the notice states what the subsection requires` FALSE EQUALS JUST FALSE
-- s 185(4): arguments: given at a meeting of the directors; reasonable steps to have it brought up and read at the next meeting; shadow director
#ASSERT `s 185(4) section 185(4) makes the general notice ineffective` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 185(4) section 185(4) makes the general notice ineffective` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 185(4) section 185(4) makes the general notice ineffective` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 185(4) section 185(4) makes the general notice ineffective` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 185(1) the general notice is a sufficient declaration of interest in relation to the matters to which it relates` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 185(1) the general notice is a sufficient declaration of interest in relation to the matters to which it relates` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 185(1) the general notice is a sufficient declaration of interest in relation to the matters to which it relates` NOTHING EQUALS NOTHING
#ASSERT `s 185 the general notice is in accordance with section 185` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185 the general notice is in accordance with section 185` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185 the general notice is in accordance with section 185` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185 the general notice is in accordance with section 185` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 185 the general notice is in accordance with section 185` NOTHING (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 186(1)(a) the declaration has been recorded in writing as the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(1)(a) the declaration has been recorded in writing as the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 186(1)(a) the declaration has been recorded in writing as the section requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 186(1)(b) the making of the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` TRUE EQUALS JUST TRUE
#ASSERT `s 186(1)(b) the making of the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` FALSE EQUALS NOTHING
#ASSERT `s 186(1)(c) the provisions of section 248 apply as if the declaration had been made at that meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 186(1)(c) the provisions of section 248 apply as if the declaration had been made at that meeting` FALSE EQUALS NOTHING
#ASSERT `s 186(2) section 186 affects the operation of section 231` EQUALS JUST FALSE
#ASSERT `s 187(1) the provisions of Chapter 3 relating to the duty under section 182 apply to the person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 187(1) the provisions of Chapter 3 relating to the duty under section 182 apply to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 187(1) the provisions of Chapter 3 relating to the duty under section 182 apply to the person` NOTHING EQUALS NOTHING
#ASSERT `s 187(2) section 182(2)(a) applies to the person` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 187(2) section 182(2)(a) applies to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 187(2) section 182(2)(a) applies to the person` NOTHING EQUALS NOTHING
