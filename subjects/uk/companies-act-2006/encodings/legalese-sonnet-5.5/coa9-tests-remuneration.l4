IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-remuneration`


-- Tests for coa9-remuneration.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5618-5657 of ukpga-2006-46.txt).

-- ---- s 420 ---------------------------------------------------------------------------------------------------
-- a quoted company whose directors prepared the report
#ASSERT (`s 420(1) the directors of the quoted company have prepared the directors' remuneration report for the financial year` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- a quoted company whose directors did not
#ASSERT (`s 420(1) the directors of the quoted company have prepared the directors' remuneration report for the financial year` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- not a quoted company: outside "The directors of a quoted company"
#ASSERT (`s 420(1) the directors of the quoted company have prepared the directors' remuneration report for the financial year` (JUST FALSE) TRUE) EQUALS NOTHING
-- not a quoted company
#ASSERT (`s 420(1) the directors of the quoted company have prepared the directors' remuneration report for the financial year` (JUST FALSE) FALSE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 420(1) the directors of the quoted company have prepared the directors' remuneration report for the financial year` NOTHING TRUE) EQUALS NOTHING
-- failure to prepare; a director at the end of the filing period; no reasonable steps
#ASSERT (`s 420(2) the person commits an offence` TRUE TRUE TRUE) EQUALS JUST TRUE
-- not a director at that time
#ASSERT (`s 420(2) the person commits an offence` TRUE FALSE TRUE) EQUALS NOTHING
-- took all reasonable steps
#ASSERT (`s 420(2) the person commits an offence` TRUE TRUE FALSE) EQUALS NOTHING
-- the report was prepared: no failure
#ASSERT (`s 420(2) the person commits an offence` FALSE TRUE TRUE) EQUALS JUST FALSE
-- (a)
#ASSERT (`s 420(3) the penalty for an offence under section 420` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b)
#ASSERT (`s 420(3) the penalty for an offence under section 420` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- not distinguished by the subsection
#ASSERT (`s 420(3) the penalty for an offence under section 420` `on summary conviction in England and Wales`) EQUALS NOTHING

-- ---- s 421(3), (4): "the preceding five years" is a period measured in years: tests on both sides of its end ----
-- The question is asked on 10 November 2026; five years before that is 10 November 2021 (fork F19: the day itself counts as in the period).
-- a director now, with a matter relating to himself that regulations need
#ASSERT (`s 421(3) the person must give notice to the company of the matter` TRUE NOTHING (Date 10 11 2026) TRUE) EQUALS JUST TRUE
-- last a director exactly five years before: within the five years
#ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE (JUST (Date 10 11 2021)) (Date 10 11 2026) TRUE) EQUALS JUST TRUE
-- last a director a day later: within the five years
#ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE (JUST (Date 11 11 2021)) (Date 10 11 2026) TRUE) EQUALS JUST TRUE
-- last a director the day before the window opens: outside "any person who is or has at any time in the preceding five years been a director"
#ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE (JUST (Date 9 11 2021)) (Date 10 11 2026) TRUE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE (JUST (Date 9 11 2021)) (Date 10 11 2026) TRUE) EQUALS NOTHING; last a director the day before the window opens: outside "any person who is or has at any time in the preceding five years been a director"; the text fixes the period in its own words, so the answer is JUST FALSE (fork F35; the other reading is NOTHING)
-- never a director
#ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE NOTHING (Date 10 11 2026) TRUE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE NOTHING (Date 10 11 2026) TRUE) EQUALS NOTHING; never a director: not a director now and not at any time in the preceding five years, so outside the period the text fixes (fork F35; the other reading is NOTHING)
-- not a matter the regulations need
#ASSERT (`s 421(3) the person must give notice to the company of the matter` TRUE NOTHING (Date 10 11 2026) FALSE) EQUALS NOTHING
-- within five years but not a matter the regulations need
#ASSERT (`s 421(3) the person must give notice to the company of the matter` FALSE (JUST (Date 10 11 2021)) (Date 10 11 2026) FALSE) EQUALS NOTHING
-- under the duty and in default
#ASSERT (`s 421(4) the person commits an offence` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- under the duty and not in default: outside "A person who makes default"
#ASSERT (`s 421(4) the person commits an offence` (JUST TRUE) FALSE) EQUALS NOTHING
-- no duty under subsection (3) here
#ASSERT (`s 421(4) the person commits an offence` (JUST FALSE) TRUE) EQUALS NOTHING
-- subsection (3) not answered
#ASSERT (`s 421(4) the person commits an offence` NOTHING TRUE) EQUALS NOTHING
-- liable on summary conviction to a fine not exceeding level 3
#ASSERT (`s 421(4) the penalty for an offence under section 421(4)` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for
#ASSERT (`s 421(4) the penalty for an offence under section 421(4)` `on conviction on indictment`) EQUALS NOTHING

-- ---- s 422 ---------------------------------------------------------------------------------------------------
-- approved, signed by a director
#ASSERT (`s 422(1) the directors' remuneration report has been approved and signed as required` TRUE TRUE FALSE) EQUALS JUST TRUE
-- approved, signed by the secretary
#ASSERT (`s 422(1) the directors' remuneration report has been approved and signed as required` TRUE FALSE TRUE) EQUALS JUST TRUE
-- not signed
#ASSERT (`s 422(1) the directors' remuneration report has been approved and signed as required` TRUE FALSE FALSE) EQUALS JUST FALSE
-- not approved by the board
#ASSERT (`s 422(1) the directors' remuneration report has been approved and signed as required` FALSE TRUE TRUE) EQUALS JUST FALSE
-- a director who knew and took no reasonable steps
#ASSERT (`s 422(2) the director commits an offence` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- reckless
#ASSERT (`s 422(2) the director commits an offence` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- neither knew nor reckless
#ASSERT (`s 422(2) the director commits an offence` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- took reasonable steps
#ASSERT (`s 422(2) the director commits an offence` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- not a director
#ASSERT (`s 422(2) the director commits an offence` TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- no report approved
#ASSERT (`s 422(2) the director commits an offence` FALSE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- the approved report complies
#ASSERT (`s 422(2) the director commits an offence` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (a)
#ASSERT (`s 422(3) the penalty for an offence under section 422` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b)
#ASSERT (`s 422(3) the penalty for an offence under section 422` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- not distinguished by the subsection
#ASSERT (`s 422(3) the penalty for an offence under section 422` `on summary conviction in Scotland`) EQUALS NOTHING

-- ---- s 422A --------------------------------------------------------------------------------------------------
-- the policy contained in a company's directors' remuneration report may be revised
#ASSERT (`s 422A(1) the directors' remuneration policy may be revised` TRUE) EQUALS JUST TRUE
-- not that policy
#ASSERT (`s 422A(1) the directors' remuneration policy may be revised` FALSE) EQUALS NOTHING
-- revised and approved by the board
#ASSERT (`s 422A(2) the revision has been approved by the board of directors as required` TRUE TRUE) EQUALS JUST TRUE
-- revised but not approved by the board
#ASSERT (`s 422A(2) the revision has been approved by the board of directors as required` TRUE FALSE) EQUALS JUST FALSE
-- no revision: "Any such revision" is not engaged
#ASSERT (`s 422A(2) the revision has been approved by the board of directors as required` FALSE TRUE) EQUALS NOTHING
-- set out in a document signed by a director
#ASSERT (`s 422A(3) the revised policy has been set out in a document signed as required` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- signed by the secretary
#ASSERT (`s 422A(3) the revised policy has been set out in a document signed as required` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- unsigned
#ASSERT (`s 422A(3) the revised policy has been set out in a document signed as required` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- not set out in a document
#ASSERT (`s 422A(3) the revised policy has been set out in a document signed as required` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
-- no revision
#ASSERT (`s 422A(3) the revised policy has been set out in a document signed as required` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- section 422(2) is named
#ASSERT (`s 422A(5) the provision applies in relation to the document as it applies in relation to a directors' remuneration report` TRUE `s 422A(5) section 422(2) (offence: approval of a non-complying report)`) EQUALS JUST TRUE
-- section 463 is named
#ASSERT (`s 422A(5) the provision applies in relation to the document as it applies in relation to a directors' remuneration report` TRUE `s 422A(5) section 463 (liability for false or misleading statements in reports)`) EQUALS JUST TRUE
-- not named, and the list is not closed with "only"
#ASSERT (`s 422A(5) the provision applies in relation to the document as it applies in relation to a directors' remuneration report` TRUE `s 422A(5) another provision`) EQUALS NOTHING
-- not such a document
#ASSERT (`s 422A(5) the provision applies in relation to the document as it applies in relation to a directors' remuneration report` FALSE `s 422A(5) section 454 (voluntary revision of accounts and reports)`) EQUALS NOTHING
-- "means the policy of a company with respect to the matters mentioned in section 421(2A)"
#ASSERT (`s 422A(6) the policy is a directors' remuneration policy` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 422A(6) the policy is a directors' remuneration policy` FALSE) EQUALS JUST FALSE

