-- ---- s 434 ---------------------------------------------------------------------------------------------------
-- published with the auditor's report
#ASSERT (`s 434(1) the publication of the statutory accounts is accompanied by the auditor's report as the subsection requires` TRUE TRUE FALSE) EQUALS JUST TRUE
-- published without the auditor's report
