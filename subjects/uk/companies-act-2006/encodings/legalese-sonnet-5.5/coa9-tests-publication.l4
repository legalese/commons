IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-publication`


-- Tests for coa9-publication.l4. Every expected value was decided from the text of the section named beside it
-- before the code was run (lines 5707-5841 of ukpga-2006-46.txt).

-- ---- s 426B -------------------------------------------------------------------------------------------------
-- required by section 414CZA (it does not apply to the company is false) and unquoted
#ASSERT (`s 426B(1) this section applies to the company` (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
-- excused by section 414CZA(2): (a) fails
#ASSERT (`s 426B(1) this section applies to the company` (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
-- a quoted company: (b) fails
#ASSERT (`s 426B(1) this section applies to the company` (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- section 414CZA not answered
#ASSERT (`s 426B(1) this section applies to the company` NOTHING (JUST TRUE)) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 426B(1) this section applies to the company` (JUST FALSE) NOTHING) EQUALS NOTHING
-- excused, whatever section 385 says
#ASSERT (`s 426B(1) this section applies to the company` (JUST TRUE) NOTHING) EQUALS JUST FALSE
-- (i) the next statement is made available
#ASSERT (`s 426B(2)(b) the last day until which the statement must remain available on a website` (JUST (Date 15 6 2028)) FALSE (Date 31 12 2028)) EQUALS JUST (Date 15 6 2028)
-- (ii) no obligation for the next year: the end of that financial year
#ASSERT (`s 426B(2)(b) the last day until which the statement must remain available on a website` NOTHING TRUE (Date 31 12 2028)) EQUALS JUST (Date 31 12 2028)
-- neither has happened yet
#ASSERT (`s 426B(2)(b) the last day until which the statement must remain available on a website` NOTHING FALSE (Date 31 12 2028)) EQUALS NOTHING
-- available and remains available
#ASSERT (`s 426B(2) the company has ensured that the section 172(1) statement is made available on a website and remains so available` TRUE TRUE) EQUALS JUST TRUE
-- (b) fails
#ASSERT (`s 426B(2) the company has ensured that the section 172(1) statement is made available on a website and remains so available` TRUE FALSE) EQUALS JUST FALSE
-- (a) fails
#ASSERT (`s 426B(2) the company has ensured that the section 172(1) statement is made available on a website and remains so available` FALSE TRUE) EQUALS JUST FALSE
-- maintained by or on behalf of the company and identifies it
#ASSERT (`s 426B(3) the website meets the requirements of the subsection` TRUE TRUE) EQUALS JUST TRUE
-- does not identify the company
#ASSERT (`s 426B(3) the website meets the requirements of the subsection` TRUE FALSE) EQUALS JUST FALSE
-- not maintained by or on behalf of the company
#ASSERT (`s 426B(3) the website meets the requirements of the subsection` FALSE TRUE) EQUALS JUST FALSE
-- free and unrestricted
#ASSERT (`s 426B(4) access to the statement meets the requirements of the subsection` FALSE FALSE FALSE) EQUALS JUST TRUE
-- (a) conditional on a fee
#ASSERT (`s 426B(4) access to the statement meets the requirements of the subsection` TRUE FALSE FALSE) EQUALS JUST FALSE
-- (b) otherwise restricted
#ASSERT (`s 426B(4) access to the statement meets the requirements of the subsection` FALSE TRUE FALSE) EQUALS JUST FALSE
-- restricted only so far as necessary to comply with an enactment or regulatory requirement
#ASSERT (`s 426B(4) access to the statement meets the requirements of the subsection` FALSE TRUE TRUE) EQUALS JUST TRUE
-- a fee is never excused by the exception for restrictions
#ASSERT (`s 426B(4) access to the statement meets the requirements of the subsection` TRUE TRUE TRUE) EQUALS JUST FALSE
-- (a) and (b)
#ASSERT (`s 426B(5) the statement was made available and kept available as the subsection requires` TRUE TRUE) EQUALS JUST TRUE
-- (b) not kept available throughout the period
#ASSERT (`s 426B(5) the statement was made available and kept available as the subsection requires` TRUE FALSE) EQUALS JUST FALSE
-- (a) not made available as soon as reasonably practicable
#ASSERT (`s 426B(5) the statement was made available and kept available as the subsection requires` FALSE TRUE) EQUALS JUST FALSE
-- made available for part of the period and wholly attributable to circumstances it could not be expected to prevent
#ASSERT (`s 426B(6) the failure to make the statement available throughout the period is disregarded` TRUE TRUE) EQUALS JUST TRUE
-- the failure was avoidable
#ASSERT (`s 426B(6) the failure to make the statement available throughout the period is disregarded` TRUE FALSE) EQUALS JUST FALSE
-- never made available during the period
#ASSERT (`s 426B(6) the failure to make the statement available throughout the period is disregarded` FALSE TRUE) EQUALS JUST FALSE
-- default; the officer is in default
#ASSERT (`s 426B(7) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- default; the officer is not in default
#ASSERT (`s 426B(7) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 426B(7) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no default
#ASSERT (`s 426B(7) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- summary conviction: a fine not exceeding level 3
#ASSERT (`s 426B(8) the penalty for an offence under section 426B(7)` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for
#ASSERT (`s 426B(8) the penalty for an offence under section 426B(7)` `on conviction on indictment`) EQUALS NOTHING

-- ---- s 430 ---------------------------------------------------------------------------------------------------
-- a quoted company: available and remaining so
#ASSERT (`s 430(1) the quoted company has ensured that its annual accounts and reports are available on a website` (JUST TRUE) TRUE TRUE) EQUALS JUST TRUE
-- does not remain available
#ASSERT (`s 430(1) the quoted company has ensured that its annual accounts and reports are available on a website` (JUST TRUE) TRUE FALSE) EQUALS JUST FALSE
-- not made available
#ASSERT (`s 430(1) the quoted company has ensured that its annual accounts and reports are available on a website` (JUST TRUE) FALSE TRUE) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 430(1) the quoted company has ensured that its annual accounts and reports are available on a website` (JUST FALSE) TRUE TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 430(1) the quoted company has ensured that its annual accounts and reports are available on a website` NOTHING TRUE TRUE) EQUALS NOTHING
-- maintained by or on behalf of the company and identifies it
#ASSERT (`s 430(2) the website meets the requirements of the subsection` TRUE TRUE) EQUALS JUST TRUE
-- not maintained by or on behalf of the company
#ASSERT (`s 430(2) the website meets the requirements of the subsection` FALSE TRUE) EQUALS JUST FALSE
-- a quoted company whose policy is revised
#ASSERT (`s 430(2A) the quoted company must ensure that the revised policy is made available on the website on which its annual accounts and reports are made available` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- policy not revised: the "If" fails
#ASSERT (`s 430(2A) the quoted company must ensure that the revised policy is made available on the website on which its annual accounts and reports are made available` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 430(2A) the quoted company must ensure that the revised policy is made available on the website on which its annual accounts and reports are made available` (JUST FALSE) TRUE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 430(2A) the quoted company must ensure that the revised policy is made available on the website on which its annual accounts and reports are made available` NOTHING TRUE) EQUALS NOTHING
-- (a) the name of the person concerned
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST TRUE) TRUE FALSE `s 430(2B)(a) the name of the person concerned`) EQUALS JUST TRUE
-- (b) a payment made or to be made
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST TRUE) TRUE TRUE `s 430(2B)(b) particulars of any remuneration payment made or to be made to the person after ceasing to be a director, including its amount and how it was calculated`) EQUALS JUST TRUE
-- (b) no such payment: nothing to disclose
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST TRUE) TRUE FALSE `s 430(2B)(b) particulars of any remuneration payment made or to be made to the person after ceasing to be a director, including its amount and how it was calculated`) EQUALS NOTHING
-- (c) a payment for loss of office
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST TRUE) TRUE TRUE `s 430(2B)(c) particulars of any payment for loss of office made or to be made to the person, including its amount and how it was calculated`) EQUALS JUST TRUE
-- nobody has ceased to be a director: the "If" fails
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST TRUE) FALSE TRUE `s 430(2B)(a) the name of the person concerned`) EQUALS JUST FALSE
-- not a quoted company
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` (JUST FALSE) TRUE TRUE `s 430(2B)(a) the name of the person concerned`) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 430(2B) the quoted company must ensure that the information is made available on the website` NOTHING TRUE TRUE `s 430(2B)(a) the name of the person concerned`) EQUALS NOTHING
-- free and unrestricted
#ASSERT (`s 430(3) access to the material meets the requirements of the subsection` FALSE FALSE FALSE) EQUALS JUST TRUE
-- conditional on a fee
#ASSERT (`s 430(3) access to the material meets the requirements of the subsection` TRUE FALSE FALSE) EQUALS JUST FALSE
-- otherwise restricted
#ASSERT (`s 430(3) access to the material meets the requirements of the subsection` FALSE TRUE FALSE) EQUALS JUST FALSE
-- restricted only so far as necessary to comply with an enactment
#ASSERT (`s 430(3) access to the material meets the requirements of the subsection` FALSE TRUE TRUE) EQUALS JUST TRUE
-- (a) and (b)
#ASSERT (`s 430(4) the annual accounts and reports were made available and kept available as the subsection requires` TRUE TRUE) EQUALS JUST TRUE
-- (b) fails
#ASSERT (`s 430(4) the annual accounts and reports were made available and kept available as the subsection requires` TRUE FALSE) EQUALS JUST FALSE
-- (a) fails
#ASSERT (`s 430(4) the annual accounts and reports were made available and kept available as the subsection requires` FALSE TRUE) EQUALS JUST FALSE
-- subsection (2A) or (2B) applies; (a) and (b) met
#ASSERT (`s 430(4A) the material was made available and kept available as the subsection requires` TRUE TRUE TRUE) EQUALS JUST TRUE
-- (b) not kept available until the next remuneration report
#ASSERT (`s 430(4A) the material was made available and kept available as the subsection requires` TRUE TRUE FALSE) EQUALS JUST FALSE
-- (a) not made available promptly
#ASSERT (`s 430(4A) the material was made available and kept available as the subsection requires` TRUE FALSE TRUE) EQUALS JUST FALSE
-- "Where subsection (2A) or (2B) applies" fails
#ASSERT (`s 430(4A) the material was made available and kept available as the subsection requires` FALSE TRUE TRUE) EQUALS JUST FALSE
-- available for part of the period; unavoidable
#ASSERT (`s 430(5) the failure to make material available throughout the period is disregarded` TRUE TRUE) EQUALS JUST TRUE
-- avoidable
#ASSERT (`s 430(5) the failure to make material available throughout the period is disregarded` TRUE FALSE) EQUALS JUST FALSE
-- never available
#ASSERT (`s 430(5) the failure to make material available throughout the period is disregarded` FALSE TRUE) EQUALS JUST FALSE
-- default; the officer is in default
#ASSERT (`s 430(6) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- default; the officer is not in default
#ASSERT (`s 430(6) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 430(6) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no default
#ASSERT (`s 430(6) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- level 3
#ASSERT (`s 430(7) the penalty for an offence under section 430(6)` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for, with no distinction by place
#ASSERT (`s 430(7) the penalty for an offence under section 430(6)` `on summary conviction in Scotland`) EQUALS NOTHING

-- ---- s 431: an unquoted company's members and debenture holders ---------------------------------------------
-- a member of an unquoted company: (a) the last annual accounts
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST TRUE) FALSE TRUE `s 431(1)(a) the company's last annual accounts`) EQUALS JUST TRUE
-- a holder of debentures: (c) the auditor's report
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST FALSE) TRUE TRUE `s 431(1)(c) the auditor's report on those accounts`) EQUALS JUST TRUE
-- (b) the last directors' report
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST TRUE) FALSE TRUE `s 431(1)(b) the last directors' report`) EQUALS JUST TRUE
-- (aa) there is a strategic report
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST TRUE) FALSE TRUE `s 431(1)(aa) the strategic report (if any) for the last financial year`) EQUALS JUST TRUE
-- (aa) "(if any)": there is none
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST TRUE) FALSE FALSE `s 431(1)(aa) the strategic report (if any) for the last financial year`) EQUALS NOTHING
-- neither a member nor a holder of debentures
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) (JUST FALSE) FALSE TRUE `s 431(1)(a) the company's last annual accounts`) EQUALS NOTHING
-- section 112 not answered
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST TRUE) NOTHING FALSE TRUE `s 431(1)(a) the company's last annual accounts`) EQUALS NOTHING
-- a quoted company: section 432 deals with it
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` (JUST FALSE) (JUST TRUE) FALSE TRUE `s 431(1)(a) the company's last annual accounts`) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 431(1) the person is entitled to be provided, on demand and without charge, with a copy of the document` NOTHING (JUST TRUE) FALSE TRUE `s 431(1)(a) the company's last annual accounts`) EQUALS NOTHING
-- a single copy, and no copy under section 423
#ASSERT (`s 431(2) the total number of copies of the documents the person is entitled to under sections 423 and 431` 0) EQUALS 1
-- in addition to the copy to which he is entitled under section 423
#ASSERT (`s 431(2) the total number of copies of the documents the person is entitled to under sections 423 and 431` 1) EQUALS 2
-- The demand is received on 1 March 2027; seven days after is 8 March 2027.
-- complied with on the seventh day
#ASSERT (`s 431(3) the demand was complied with within seven days of receipt` (Date 1 3 2027) (JUST (Date 8 3 2027)) (Date 20 3 2027)) EQUALS JUST TRUE
-- complied with on the eighth day
#ASSERT (`s 431(3) the demand was complied with within seven days of receipt` (Date 1 3 2027) (JUST (Date 9 3 2027)) (Date 20 3 2027)) EQUALS JUST FALSE
-- complied with on the day of receipt
#ASSERT (`s 431(3) the demand was complied with within seven days of receipt` (Date 1 3 2027) (JUST (Date 1 3 2027)) (Date 20 3 2027)) EQUALS JUST TRUE
-- not yet complied with and the seventh day has not passed
#ASSERT (`s 431(3) the demand was complied with within seven days of receipt` (Date 1 3 2027) NOTHING (Date 8 3 2027)) EQUALS NOTHING
-- not complied with and the seventh day has passed
#ASSERT (`s 431(3) the demand was complied with within seven days of receipt` (Date 1 3 2027) NOTHING (Date 9 3 2027)) EQUALS JUST FALSE
-- not complied with within seven days: the company commits an offence
#ASSERT (`s 431(3)(a) the company commits an offence` TRUE) EQUALS JUST TRUE
-- complied with in time
#ASSERT (`s 431(3)(a) the company commits an offence` FALSE) EQUALS JUST FALSE
-- an officer in default
#ASSERT (`s 431(3)(b) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- an officer not in default
#ASSERT (`s 431(3)(b) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 431(3)(b) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- complied with in time
#ASSERT (`s 431(3)(b) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- level 3 and, for continued contravention, one-tenth of level 3
#ASSERT (`s 431(4) the penalty for an offence under section 431` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
-- only summary conviction is provided for
#ASSERT (`s 431(4) the penalty for an offence under section 431` `on conviction on indictment`) EQUALS NOTHING

-- ---- s 431(3) as a regulative rule ----------------------------------------------------------------------------
-- The clock counts days from the receipt of the demand. Expected by reading the section: copies provided on day 7 are in time
-- (within seven days of receipt); nothing provided by day 8 is a breach by the company.
#TRACE `s 431(3) the company must comply with the demand` AT 0 WITH
    PARTY Company DOES `s 431(3) provide the copy demanded` AT 7
-- expected: FULFILLED

#TRACE `s 431(3) the company must comply with the demand` AT 0 WITH
    PARTY Company DOES `s 431(3) provide the copy demanded` AT 8
-- expected: BREACH BY Company (an act on the eighth day)

#TRACE `s 431(3) the company must comply with the demand` AT 0 WITH
    (WAITUNTIL 8)
-- expected: BREACH BY Company (nothing provided by the eighth day)


