-- no auditor's report, but exempt from audit and the directors took advantage
#ASSERT (`s 434(1) the publication of the statutory accounts is accompanied by the auditor's report as the subsection requires` TRUE FALSE TRUE) EQUALS JUST TRUE
-- the company does not publish any of its statutory accounts
#ASSERT (`s 434(1) the publication of the statutory accounts is accompanied by the auditor's report as the subsection requires` FALSE FALSE FALSE) EQUALS NOTHING
-- a company that prepares statutory group accounts is barred
#ASSERT (`s 434(2) the company is barred from publishing its statutory individual accounts for the year without also publishing with them its statutory group accounts` TRUE) EQUALS JUST TRUE
-- a company that prepares none: the bar names only those that do
#ASSERT (`s 434(2) the company is barred from publishing its statutory individual accounts for the year without also publishing with them its statutory group accounts` FALSE) EQUALS NOTHING
-- its accounts as required to be delivered to the registrar under section 441
#ASSERT (`s 434(3) the accounts are the company's statutory accounts` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 434(3) the accounts are the company's statutory accounts` FALSE) EQUALS JUST FALSE
-- the company contravenes a provision of the section
#ASSERT (`s 434(4)(a) the company commits an offence` TRUE) EQUALS JUST TRUE
-- no contravention
#ASSERT (`s 434(4)(a) the company commits an offence` FALSE) EQUALS JUST FALSE
-- an officer in default
#ASSERT (`s 434(4)(b) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- an officer not in default
#ASSERT (`s 434(4)(b) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 434(4)(b) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no contravention
#ASSERT (`s 434(4)(b) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- level 3
#ASSERT (`s 434(5) the penalty for an offence under section 434` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for
#ASSERT (`s 434(5) the penalty for an offence under section 434` `on conviction on indictment`) EQUALS NOTHING

-- ---- s 435 ---------------------------------------------------------------------------------------------------
-- (a): the company publishes non-statutory accounts
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE FALSE `s 435(1)(a) that they are not the company's statutory accounts`) EQUALS JUST TRUE
-- (b)
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE FALSE `s 435(1)(b) whether statutory accounts dealing with any financial year with which the non-statutory accounts purport to deal have been delivered to the registrar`) EQUALS JUST TRUE
-- (c)
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE FALSE `s 435(1)(c) whether an auditor's report has been made on the company's statutory accounts for any such financial year`) EQUALS JUST TRUE
-- (c)(i) where an auditor's report has been made
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE TRUE `s 435(1)(c)(i) whether the report was qualified or unqualified, or included a reference to any matters to which the auditor drew attention by way of emphasis without qualifying the report`) EQUALS JUST TRUE
-- (c)(i) "and if so": no auditor's report was made
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE FALSE `s 435(1)(c)(i) whether the report was qualified or unqualified, or included a reference to any matters to which the auditor drew attention by way of emphasis without qualifying the report`) EQUALS JUST FALSE
-- (c)(ii) where an auditor's report has been made
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE TRUE `s 435(1)(c)(ii) whether the report contained a statement under section 498(2) or section 498(3)`) EQUALS JUST TRUE
-- (c)(ii) "and if so": no auditor's report was made
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` TRUE FALSE `s 435(1)(c)(ii) whether the report contained a statement under section 498(2) or section 498(3)`) EQUALS JUST FALSE
-- the company does not publish non-statutory accounts: the "If" fails
#ASSERT (`s 435(1) the company must publish with the non-statutory accounts a statement indicating the matter` FALSE TRUE `s 435(1)(a) that they are not the company's statutory accounts`) EQUALS JUST FALSE
-- publishing the auditor's report on its statutory accounts with non-statutory accounts: barred
#ASSERT (`s 435(2) the company is barred from publishing the auditor's report on its statutory accounts with the non-statutory accounts` TRUE TRUE) EQUALS JUST TRUE
-- some other document
#ASSERT (`s 435(2) the company is barred from publishing the auditor's report on its statutory accounts with the non-statutory accounts` TRUE FALSE) EQUALS NOTHING
-- not publishing non-statutory accounts
#ASSERT (`s 435(2) the company is barred from publishing the auditor's report on its statutory accounts with the non-statutory accounts` FALSE TRUE) EQUALS NOTHING
-- (a) a balance sheet or profit and loss account, not part of the statutory accounts
#ASSERT (`s 435(3) the publication is the publication of non-statutory accounts` TRUE FALSE FALSE) EQUALS JUST TRUE
-- (b) a group account, not part of the statutory accounts
#ASSERT (`s 435(3) the publication is the publication of non-statutory accounts` FALSE TRUE FALSE) EQUALS JUST TRUE
-- published as part of the statutory accounts: "otherwise than as part of"
#ASSERT (`s 435(3) the publication is the publication of non-statutory accounts` TRUE FALSE TRUE) EQUALS JUST FALSE
-- neither (a) nor (b)
#ASSERT (`s 435(3) the publication is the publication of non-statutory accounts` FALSE FALSE FALSE) EQUALS JUST FALSE
-- the company and any other undertaking, no parent undertaking
#ASSERT (`s 435(4) the group is a group headed by the company` TRUE FALSE) EQUALS JUST TRUE
-- includes a parent undertaking of the company: "other than a parent undertaking"
#ASSERT (`s 435(4) the group is a group headed by the company` TRUE TRUE) EQUALS JUST FALSE
-- not a group of the company and another undertaking
#ASSERT (`s 435(4) the group is a group headed by the company` FALSE FALSE) EQUALS JUST FALSE
-- the company contravenes a provision of the section
#ASSERT (`s 435(5)(a) the company commits an offence` TRUE) EQUALS JUST TRUE
-- no contravention
#ASSERT (`s 435(5)(a) the company commits an offence` FALSE) EQUALS JUST FALSE
-- an officer in default
#ASSERT (`s 435(5)(b) the officer of the company commits an offence` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- an officer not in default
#ASSERT (`s 435(5)(b) the officer of the company commits an offence` TRUE (JUST FALSE)) EQUALS NOTHING
-- section 1121 not answered
#ASSERT (`s 435(5)(b) the officer of the company commits an offence` TRUE NOTHING) EQUALS NOTHING
-- no contravention
#ASSERT (`s 435(5)(b) the officer of the company commits an offence` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- level 3
#ASSERT (`s 435(6) the penalty for an offence under section 435` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), NOTHING, FALSE)
-- only summary conviction is provided for, with no distinction by place
#ASSERT (`s 435(6) the penalty for an offence under section 435` `on summary conviction in Northern Ireland`) EQUALS NOTHING

-- ---- s 436 ---------------------------------------------------------------------------------------------------
-- named in subsection (1)
#ASSERT (`s 436(1) this section has effect for the purposes of the section` `s 436(1) section 433 (name of signatory to be stated in published copies of accounts and reports)`) EQUALS JUST TRUE
-- named in subsection (1)
#ASSERT (`s 436(1) this section has effect for the purposes of the section` `s 436(1) section 435 (requirements in connection with publication of non-statutory accounts)`) EQUALS JUST TRUE
-- not named, and the list is not closed with "only"
#ASSERT (`s 436(1) this section has effect for the purposes of the section` `s 436(1) another section`) EQUALS NOTHING
-- publishes it in a manner calculated to invite the public to read it
#ASSERT (`s 436(2) the company is regarded as publishing the document` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- issues it
#ASSERT (`s 436(2) the company is regarded as publishing the document` FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
-- circulates it
#ASSERT (`s 436(2) the company is regarded as publishing the document` FALSE FALSE TRUE FALSE TRUE) EQUALS JUST TRUE
-- otherwise makes it available for public inspection
#ASSERT (`s 436(2) the company is regarded as publishing the document` FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
-- not in a manner calculated to invite the public to read it (fork F27)
#ASSERT (`s 436(2) the company is regarded as publishing the document` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- none of the four ways
#ASSERT (`s 436(2) the company is regarded as publishing the document` FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE

