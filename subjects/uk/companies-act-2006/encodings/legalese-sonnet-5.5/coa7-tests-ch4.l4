#ASSERT `s 338A(1) the members may request the company to include the matter in the business` TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 338A(1) the members may request the company to include the matter in the business` TRUE FALSE (JUST FALSE) EQUALS NOTHING
