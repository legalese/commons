IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch7`
IMPORT `coa7-ch4`

-- coa7-tests-ch4.l4: tests for coa7-ch4.l4 (Part 13 Chapter 4, ss 336 to 340B).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 4 (ss 336 to 340B)`

-- s 336(1): accounting reference date 30 June 2026: the period of 6 months begins on 1 July 2026 and ends on 31 December 2026
#ASSERT `s 336(1) the annual general meeting was held in the period of 6 months` TRUE (Date 30 6 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 336(1) the annual general meeting was held in the period of 6 months` TRUE (Date 30 6 2026) (Date 31 12 2026) EQUALS JUST TRUE
#ASSERT `s 336(1) the annual general meeting was held in the period of 6 months` TRUE (Date 30 6 2026) (Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 336(1) the annual general meeting was held in the period of 6 months` TRUE (Date 30 6 2026) (Date 30 6 2026) EQUALS JUST FALSE
#ASSERT `s 336(1) the annual general meeting was held in the period of 6 months` FALSE (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
-- s 336(1A): a private traded company: 9 months, ending on 31 March 2027
#ASSERT `s 336(1A) the annual general meeting was held in the period of 9 months` TRUE (Date 30 6 2026) (Date 31 3 2027) EQUALS JUST TRUE
#ASSERT `s 336(1A) the annual general meeting was held in the period of 9 months` TRUE (Date 30 6 2026) (Date 1 4 2027) EQUALS JUST FALSE
#ASSERT `s 336(1A) the annual general meeting was held in the period of 9 months` FALSE (Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
-- s 336(2): altering the accounting reference date: an annual general meeting within 3 months of giving the notice (1 July + 3 months is 1 October)
#ASSERT `s 336(2) the company is treated as having complied with subsection (1)` TRUE TRUE TRUE (Date 1 7 2026) (Date 1 10 2026) EQUALS JUST TRUE
#ASSERT `s 336(2) the company is treated as having complied with subsection (1)` TRUE TRUE TRUE (Date 1 7 2026) (Date 2 10 2026) EQUALS JUST FALSE
#ASSERT `s 336(2) the company is treated as having complied with subsection (1)` FALSE TRUE TRUE (Date 1 7 2026) (Date 1 10 2026) EQUALS NOTHING
#ASSERT `s 336(2) the company is treated as having complied with subsection (1)` TRUE FALSE TRUE (Date 1 7 2026) (Date 1 10 2026) EQUALS NOTHING
#ASSERT `s 336(2) the company is treated as having complied with subsection (1)` TRUE TRUE FALSE (Date 1 7 2026) (Date 1 10 2026) EQUALS NOTHING
#ASSERT `s 336(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 336(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 336(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 336(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 336(4) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 336(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 336(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 336(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 336(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)

-- s 337(1)
#ASSERT `s 337(1) the notice states that the meeting is an annual general meeting` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 337(1) the notice states that the meeting is an annual general meeting` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 337(1) the notice states that the meeting is an annual general meeting` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 337(1) the notice states that the meeting is an annual general meeting` TRUE FALSE TRUE EQUALS NOTHING
-- s 337(2)
#ASSERT `s 337(2) the annual general meeting may be called by shorter notice` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 337(2) the annual general meeting may be called by shorter notice` TRUE FALSE EQUALS JUST FALSE; s 337(2) is named for a permission (may be called by shorter notice) and its gate is 'if all the members ... agree', which the text does not close with 'only'; a failed gate is NOTHING (fork F22, name-test sweep); the facts are unchanged, JUST FALSE becomes NOTHING.
#ASSERT `s 337(2) the annual general meeting may be called by shorter notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 337(2) the annual general meeting may be called by shorter notice` FALSE TRUE EQUALS NOTHING
-- s 337(3): a traded company's notice given more than 6 weeks (more than 42 clear days) before the meeting. 1 January to 14 February is 43 clear days; to 13 February is 42
#ASSERT `s 337(3) the notice includes the statements this subsection requires` TRUE TRUE (Date 1 1 2026) (Date 14 2 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 337(3) the notice includes the statements this subsection requires` TRUE TRUE (Date 1 1 2026) (Date 14 2 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 337(3) the notice includes the statements this subsection requires` TRUE FALSE (Date 1 1 2026) (Date 14 2 2026) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 337(3) the notice includes the statements this subsection requires` TRUE FALSE (Date 1 1 2026) (Date 14 2 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 337(3) the notice includes the statements this subsection requires` TRUE TRUE (Date 1 1 2026) (Date 13 2 2026) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 337(3) the notice includes the statements this subsection requires` FALSE TRUE (Date 1 1 2026) (Date 14 2 2026) TRUE TRUE EQUALS NOTHING

-- s 338(2): may properly be moved unless ineffective, defamatory, or frivolous or vexatious
#ASSERT `s 338(2) the resolution may properly be moved at the annual general meeting` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 338(2) the resolution may properly be moved at the annual general meeting` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 338(2) the resolution may properly be moved at the annual general meeting` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 338(2) the resolution may properly be moved at the annual general meeting` FALSE FALSE TRUE EQUALS JUST FALSE
-- s 338(1)
#ASSERT `s 338(1) the members may require the company to give notice of the resolution` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 338(1) the members may require the company to give notice of the resolution` FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 338(1) the members may require the company to give notice of the resolution` TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 338(1) the members may require the company to give notice of the resolution` TRUE (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 338(1) the members may require the company to give notice of the resolution` TRUE NOTHING TRUE EQUALS NOTHING
-- s 338(3): at least 5% of the voting rights, or at least 100 members with an average of at least £100 paid up
#ASSERT `s 338(3) the company is required to give notice of the resolution` 5 100 0 0 EQUALS JUST TRUE
#ASSERT `s 338(3) the company is required to give notice of the resolution` 4 100 0 0 EQUALS JUST FALSE
#ASSERT `s 338(3) the company is required to give notice of the resolution` 0 100 100 10000 EQUALS JUST TRUE
#ASSERT `s 338(3) the company is required to give notice of the resolution` 0 100 100 9999 EQUALS JUST FALSE
#ASSERT `s 338(3) the company is required to give notice of the resolution` 0 100 99 9900 EQUALS JUST FALSE
-- s 338(4): received not later than 6 weeks (42 clear days) before the meeting, or, if later, when notice of the meeting is given
#ASSERT `s 338(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 1 1 2026) (Date 15 2 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 338(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 10 1 2026) (Date 15 2 2026) (Date 5 2 2026) EQUALS JUST TRUE
#ASSERT `s 338(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 10 2 2026) (Date 15 2 2026) (Date 5 2 2026) EQUALS JUST FALSE
#ASSERT `s 338(4) the request meets the requirements of this subsection` TRUE FALSE TRUE (Date 1 1 2026) (Date 15 2 2026) (Date 1 1 2026) EQUALS JUST FALSE
#ASSERT `s 338(4) the request meets the requirements of this subsection` TRUE TRUE FALSE (Date 1 1 2026) (Date 15 2 2026) (Date 1 1 2026) EQUALS JUST FALSE
#ASSERT `s 338(4) the request meets the requirements of this subsection` FALSE TRUE TRUE (Date 1 1 2026) (Date 15 2 2026) (Date 1 1 2026) EQUALS NOTHING

-- s 338A(2)
#ASSERT `s 338A(2) the matter may properly be included in the business at the annual general meeting` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 338A(2) the matter may properly be included in the business at the annual general meeting` TRUE FALSE EQUALS JUST FALSE
