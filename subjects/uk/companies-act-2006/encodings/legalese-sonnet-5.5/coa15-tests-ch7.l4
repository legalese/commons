IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa15-nouns`
IMPORT `coa15-ch7`

-- coa15-tests-ch7.l4: tests of coa15-ch7.l4 (ss 733 to 736). Expected values are written from the text before the run.

-- expect: FULFILLED
#TRACE `s 733(1) the company must transfer the amount to the capital redemption reserve` AT 0 WITH
    PARTY Company DOES `s 733(1) transfer an amount to the capital redemption reserve` AT 3
-- (the text states no period: the duty stands until it is done)
-- expect: RESIDUAL
#TRACE `s 733(1) the company must transfer the amount to the capital redemption reserve` AT 0 WITH
    (WAITUNTIL 60)
#ASSERT `s 733(2) the amount to be transferred to the capital redemption reserve` TRUE 700 EQUALS 700
#ASSERT `s 733(2) the amount to be transferred to the capital redemption reserve` FALSE 700 EQUALS 0
-- nominal value 1,000; the fresh issue brings in 600: the difference of 400 goes to the reserve
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 600 1000 FALSE FALSE EQUALS 400
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 1000 1000 FALSE FALSE EQUALS 0
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 1100 1000 FALSE FALSE EQUALS 0
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 999 1000 FALSE FALSE EQUALS 1
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` FALSE 600 1000 FALSE FALSE EQUALS 0
-- a private company that also applies a payment out of capital is excepted; a public company is not
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 600 1000 TRUE TRUE EQUALS 0
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 600 1000 TRUE FALSE EQUALS 400
#ASSERT `s 733(3) the amount of the difference to be transferred to the capital redemption reserve` TRUE 600 1000 FALSE TRUE EQUALS 400
#ASSERT `s 733(4) the amount to be transferred to the capital redemption reserve` TRUE 250 EQUALS 250
#ASSERT `s 733(4) the amount to be transferred to the capital redemption reserve` FALSE 250 EQUALS 0
#ASSERT `s 733(5) the company may use the capital redemption reserve to pay up the new shares` TRUE EQUALS JUST TRUE
#ASSERT `s 733(5) the company may use the capital redemption reserve to pay up the new shares` FALSE EQUALS NOTHING
-- a reduction provision treats the reserve as paid up share capital; another provision does not
#ASSERT `s 733(6) the paid up share capital to take for the provision` TRUE 5000 800 EQUALS 5800
#ASSERT `s 733(6) the paid up share capital to take for the provision` FALSE 5000 800 EQUALS 5000

#ASSERT `s 734(1) this section applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 734(1) this section applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 734(1) this section applies` FALSE FALSE EQUALS JUST FALSE
-- a payment under section 692(1ZA): the purchase price, or if less the part met out of that payment and any proceeds of a fresh issue
#ASSERT `s 734(1A) the permissible capital payment for a payment under section 692(1ZA)` 15000 15000 0 EQUALS 15000
#ASSERT `s 734(1A) the permissible capital payment for a payment under section 692(1ZA)` 20000 15000 0 EQUALS 15000
#ASSERT `s 734(1A) the permissible capital payment for a payment under section 692(1ZA)` 20000 15000 3000 EQUALS 18000
#ASSERT `s 734(1A) the permissible capital payment for a payment under section 692(1ZA)` 12000 15000 3000 EQUALS 12000
#ASSERT `s 734(4) the amount to read as the permissible capital payment in subsections (2) and (3)` TRUE 500 200 EQUALS 700
#ASSERT `s 734(4) the amount to read as the permissible capital payment in subsections (2) and (3)` FALSE 500 200 EQUALS 500
-- nominal amount of the shares 1,000
#ASSERT `s 734(2) the amount to be transferred to the capital redemption reserve` 700 1000 EQUALS 300
#ASSERT `s 734(2) the amount to be transferred to the capital redemption reserve` 1000 1000 EQUALS 0
#ASSERT `s 734(2) the amount to be transferred to the capital redemption reserve` 1300 1000 EQUALS 0
#ASSERT `s 734(2) the amount to be transferred to the capital redemption reserve` 999 1000 EQUALS 1
#ASSERT `s 734(3) the most by which the amounts may be reduced` 1300 1000 EQUALS 300
#ASSERT `s 734(3) the most by which the amounts may be reduced` 1000 1000 EQUALS 0
#ASSERT `s 734(3) the most by which the amounts may be reduced` 700 1000 EQUALS 0
#ASSERT `s 734(3) the most by which the amounts may be reduced` 1001 1000 EQUALS 1
#ASSERT `s 734(3) the amount may be reduced` `s 734(3)(a) the amount of any capital redemption reserve` EQUALS JUST TRUE
#ASSERT `s 734(3) the amount may be reduced` `s 734(3)(a) the amount of any share premium account` EQUALS JUST TRUE
#ASSERT `s 734(3) the amount may be reduced` `s 734(3)(a) the amount of any fully paid share capital of the company` EQUALS JUST TRUE
#ASSERT `s 734(3) the amount may be reduced` `s 734(3)(b) any amount representing unrealised profits standing to the credit of a revaluation reserve maintained by the company` EQUALS JUST TRUE
#ASSERT `s 734(3) the amount may be reduced` `s 734(3) any other amount` EQUALS NOTHING

#ASSERT `s 735(1) this section applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 735(1) this section applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 735(1) this section applies` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 735(2) the company is liable in damages for the failure` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 735(2) the company is liable in damages for the failure` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 735(2) the company is liable in damages for the failure` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 735(2) the company is liable in damages for the failure` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 735(2) the holder's right survives the failure` `s 735(2) a right to sue the company for damages in respect of its failure to redeem or purchase` EQUALS JUST FALSE
#ASSERT `s 735(2) the holder's right survives the failure` `s 735(2) any other right of the holder of the shares` EQUALS JUST TRUE
#ASSERT `s 735(3) the court shall not grant specific performance` TRUE EQUALS JUST TRUE
#ASSERT `s 735(3) the court shall not grant specific performance` FALSE EQUALS JUST FALSE
-- expect: BREACH
#TRACE `s 735(3) the court shant grant an order for specific performance` TRUE AT 0 WITH
    PARTY Court DOES `s 735(3) grant an order for specific performance of the terms of redemption or purchase` AT 2
-- when the company does not show inability, there is no prohibition to breach
-- expect: FULFILLED
#TRACE `s 735(3) the court shant grant an order for specific performance` FALSE AT 0 WITH
    PARTY Court DOES `s 735(3) grant an order for specific performance of the terms of redemption or purchase` AT 2
#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` TRUE TRUE NOTHING EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE`; the function is named for a grant or a power and its "if" gate fails here, so it answers NOTHING and not JUST FALSE (fork F-grant-735-4)
#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` FALSE TRUE (JUST FALSE) EQUALS NOTHING
-- RECONCILED 2026-11-12: was `#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE`; the function is named for a grant or a power and its "if" gate fails here, so it answers NOTHING and not JUST FALSE (fork F-grant-735-4)
#ASSERT `s 735(4) the terms of redemption or purchase may be enforced against the company` TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 735(4) the shares are treated as cancelled` TRUE EQUALS JUST TRUE
#ASSERT `s 735(4) the shares are treated as cancelled` FALSE EQUALS NOTHING
-- the winding up commences on 1 September 2026; the terms provided for redemption on 2 September 2026 (later): (a)
#ASSERT `s 735(5) subsection (4) does not apply` (Date 2 9 2026) (Date 1 9 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 735(5) subsection (4) does not apply` (Date 1 9 2026) (Date 1 9 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 735(5) subsection (4) does not apply` (Date 31 8 2026) (Date 1 9 2026) FALSE EQUALS JUST FALSE
-- (b): no distribution of that value could lawfully have been made at any time in the period
#ASSERT `s 735(5) subsection (4) does not apply` (Date 31 8 2026) (Date 1 9 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 735(6) the claim is paid in priority to any amount the company is liable under subsection (4) to pay` `s 735(6)(a) a debt or liability of the company other than one due to members in their character as such` EQUALS JUST TRUE
#ASSERT `s 735(6) the claim is paid in priority to any amount the company is liable under subsection (4) to pay` `s 735(6)(b) an amount due in satisfaction of rights as to capital or income preferred to the rights as to capital attaching to the shares` EQUALS JUST TRUE
#ASSERT `s 735(6) the claim is paid in priority to any amount the company is liable under subsection (4) to pay` `s 735(6) an amount due to members in satisfaction of their rights as members, other than preferred rights` EQUALS JUST FALSE
#ASSERT `s 735(6) the claim is paid in priority to any amount the company is liable under subsection (4) to pay` `s 735(6) a claim of another kind` EQUALS NOTHING

-- s 736: the payment of 1,000 against profits available for distribution
#ASSERT `s 736 the profits are distributable profits in relation to the payment` FALSE 1000 1000 EQUALS JUST TRUE
#ASSERT `s 736 the profits are distributable profits in relation to the payment` FALSE 1500 1000 EQUALS JUST TRUE
#ASSERT `s 736 the profits are distributable profits in relation to the payment` FALSE 999 1000 EQUALS JUST FALSE
#ASSERT `s 736 the profits are distributable profits in relation to the payment` TRUE 5000 1000 EQUALS NOTHING
