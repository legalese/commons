-- s 108(1): a company that on re-registration already has allotted share capital must within 15 days deliver a statement of capital; (2) not if the information has already been sent
-- (already has allotted share capital, already sent in a statement of capital and initial shareholdings, already sent in the last statement of capital)
#ASSERT `s 108(1) the company must deliver a statement of capital to the registrar` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 108(1) the company must deliver a statement of capital to the registrar` TRUE TRUE FALSE EQUALS JUST FALSE -- (2)(a)
#ASSERT `s 108(1) the company must deliver a statement of capital to the registrar` TRUE FALSE TRUE EQUALS JUST FALSE -- (2)(b)
#ASSERT `s 108(1) the company must deliver a statement of capital to the registrar` FALSE FALSE FALSE EQUALS NOTHING -- no allotted share capital
#ASSERT `s 108(1) the statement of capital is delivered within 15 days after the re-registration` (Date 1 3 2027) (Date 16 3 2027) EQUALS JUST TRUE -- 15 days
#ASSERT `s 108(1) the statement of capital is delivered within 15 days after the re-registration` (Date 1 3 2027) (Date 17 3 2027) EQUALS JUST FALSE -- 16 days
#TRACE `s 108(1) the company's duty to deliver a statement of capital` AT 0 WITH
    PARTY Company DOES `s 108(1) deliver a statement of capital to the registrar` AT 15
-- TRACE-EXPECT: FULFILLED

#TRACE `s 108(1) the company's duty to deliver a statement of capital` AT 0 WITH
    (WAITUNTIL 16)
-- TRACE-EXPECT: BREACHED

-- s 108(3): the statement of capital states (a) total number of shares, (b) aggregate nominal value, (ba) aggregate amount unpaid, (c) for each class (i) the prescribed particulars of rights, (ii) the number of shares, (iii) the aggregate nominal value
`s 108(3) test class` MEANS `s 108(3) class of shares in the statement` WITH
    `the prescribed particulars of the rights attached to the shares are stated` IS TRUE
    `the total number of shares of that class is stated` IS TRUE
    `the aggregate nominal value of shares of that class is stated` IS TRUE

`s 108(3) test class without rights` MEANS `s 108(3) class of shares in the statement` WITH
    `the prescribed particulars of the rights attached to the shares are stated` IS FALSE
    `the total number of shares of that class is stated` IS TRUE
    `the aggregate nominal value of shares of that class is stated` IS TRUE

`s 108(3) test class without number` MEANS `s 108(3) class of shares in the statement` WITH
    `the prescribed particulars of the rights attached to the shares are stated` IS TRUE
    `the total number of shares of that class is stated` IS FALSE
    `the aggregate nominal value of shares of that class is stated` IS TRUE

`s 108(3) test class without nominal value` MEANS `s 108(3) class of shares in the statement` WITH
    `the prescribed particulars of the rights attached to the shares are stated` IS TRUE
    `the total number of shares of that class is stated` IS TRUE
    `the aggregate nominal value of shares of that class is stated` IS FALSE

GIVEN total IS A BOOLEAN, nominal IS A BOOLEAN, unpaid IS A BOOLEAN, classes IS A LIST OF `s 108(3) class of shares in the statement`
GIVETH A `s 108(3) statement of capital`
`s 108(3) test statement` MEANS
    `s 108(3) statement of capital` WITH
        `the total number of shares of the company is stated` IS total
        `the aggregate nominal value of those shares is stated` IS nominal
        `the aggregate amount (if any) unpaid on those shares is stated` IS unpaid
        `the classes of shares` IS classes

#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE TRUE TRUE (LIST `s 108(3) test class`, `s 108(3) test class`)) EQUALS JUST TRUE
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` FALSE TRUE TRUE (LIST `s 108(3) test class`)) EQUALS JUST FALSE -- (a)
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE FALSE TRUE (LIST `s 108(3) test class`)) EQUALS JUST FALSE -- (b)
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE TRUE FALSE (LIST `s 108(3) test class`)) EQUALS JUST FALSE -- (ba)
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE TRUE TRUE (LIST `s 108(3) test class`, `s 108(3) test class without rights`)) EQUALS JUST FALSE -- (c)(i) for the second class
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE TRUE TRUE (LIST `s 108(3) test class without number`)) EQUALS JUST FALSE -- (c)(ii)
#ASSERT `s 108(3) the statement of capital states what the subsection requires` (`s 108(3) test statement` TRUE TRUE TRUE (LIST `s 108(3) test class without nominal value`)) EQUALS JUST FALSE -- (c)(iii)
-- s 108(4): if default is made in complying with this section, an offence is committed by the company and every officer in default
#ASSERT `s 108(4) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE -- no failure
#ASSERT `s 108(4) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE -- (a) the company
#ASSERT `s 108(4) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE -- (b) every officer in default
#ASSERT `s 108(4) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 108(4) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING -- an officer not in default
#ASSERT `s 108(4) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 108(4) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS NOTHING -- silent: no sentence treating a shadow director as an officer in this section
#ASSERT `s 108(4) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING -- not named
-- s 108(5): level 3 on the standard scale; daily default fine one-tenth of level 3
#ASSERT (`s 108(5) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 108(5) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 108(5) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)

GIVEN assented IS A BOOLEAN, trusteeEntitled IS A BOOLEAN, trusteeAssented IS A BOOLEAN, deceased IS A BOOLEAN, repAssented IS A BOOLEAN
GIVETH A `s 109(4) member`
`s 109(4) test member` MEANS
    `s 109(4) member` WITH
        `the member has assented` IS assented
        `a trustee in bankruptcy of the member is entitled to assent` IS trusteeEntitled
        `the trustee in bankruptcy has assented` IS trusteeAssented
        `the member is deceased` IS deceased
        `the personal representative of the deceased member has assented on behalf of the deceased` IS repAssented

#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE -- (a) the trustee assented
#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE -- (a) the member's own assent is excluded
#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE -- (b) the personal representative assented
#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE -- (b) not yet assented
#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 109(4) the member's assent is given` (`s 109(4) test member` FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 109(1)(a) all the members of the company have assented` (LIST (`s 109(4) test member` TRUE FALSE FALSE FALSE FALSE), (`s 109(4) test member` FALSE TRUE TRUE FALSE FALSE)) EQUALS JUST TRUE
#ASSERT `s 109(1)(a) all the members of the company have assented` (LIST (`s 109(4) test member` TRUE FALSE FALSE FALSE FALSE), (`s 109(4) test member` FALSE FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
#ASSERT `s 109(5) the person is a trustee in bankruptcy of a member of the company` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 109(5) the person is a trustee in bankruptcy of a member of the company` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 109(5) the person is a trustee in bankruptcy of a member of the company` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 109(5) the person is a trustee in bankruptcy of a member of the company` FALSE FALSE FALSE EQUALS NOTHING
