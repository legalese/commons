IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-part7-other-routes`

-- coa2-tests-part7b.l4: tests for coa2-part7-other-routes.l4 (ss 97-111).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.

-- s 97(1)/(105)/(109)/(102) conjunction helper (the s 97 one)
#ASSERT `s 97(1) all of the answers hold` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 97(1) all of the answers hold` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 97(1) all of the answers hold` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 102(1) all of the answers hold` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 102(1) all of the answers hold` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 102(1) all of the answers hold` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
-- s 97(2): the conditions (a) where no s 98 application is made, (i) none may be made or (ii) the period has expired; (b) where one is made, (i) it is withdrawn or (ii) an order confirming is delivered
-- (an application has been made, none may be made, the period has expired, withdrawn, order delivered)
#ASSERT `s 97(2) the conditions are met` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (a)(i)
#ASSERT `s 97(2) the conditions are met` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (a)(ii)
#ASSERT `s 97(2) the conditions are met` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- (a) neither
#ASSERT `s 97(2) the conditions are met` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (b)(i)
#ASSERT `s 97(2) the conditions are met` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- (b)(ii)
#ASSERT `s 97(2) the conditions are met` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- (b) neither
#ASSERT `s 97(2) the conditions are met` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- an application has been made: only (b) counts
-- s 97(1): a public company may be re-registered as a private limited company if (a) special resolution, (b) conditions, (c) application and statement of compliance
-- (public, special resolution, conditions, application delivered, statement of compliance)
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING -- a private company
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 97(1) the public company may be re-registered as a private limited company` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 97(3)(a) the company must make such changes in its name as are necessary in connection with its becoming a private company limited by shares or by guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 97(3)(a) the company must make such changes in its name as are necessary in connection with its becoming a private company limited by shares or by guarantee` FALSE EQUALS NOTHING
#ASSERT `s 97(3)(b) the company must make such changes in its articles as are necessary in connection with its becoming a private company limited by shares or by guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 97(3)(b) the company must make such changes in its articles as are necessary in connection with its becoming a private company limited by shares or by guarantee` FALSE EQUALS NOTHING
-- s 98(1): application to cancel: (a) holders of not less than 5% in nominal value, (b) if not limited by shares not less than 5% of members, (c) not less than 50 members; but not by a person who consented or voted in favour
-- (resolution passed, limited by shares, nominal value held, nominal value issued, applicant members, total members, an applicant consented)
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 500 10000 2 100 FALSE EQUALS JUST TRUE -- (a) exactly 5%
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 499 10000 2 100 FALSE EQUALS NOTHING -- just under 5%
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE FALSE 0 10000 5 100 FALSE EQUALS JUST TRUE -- (b) exactly 5% of the members of a company not limited by shares
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE FALSE 0 10000 4 100 FALSE EQUALS NOTHING
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 0 10000 5 100 FALSE EQUALS NOTHING -- (b) applies only to a company not limited by shares
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 0 10000 50 1000 FALSE EQUALS JUST TRUE -- (c) 50 members
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 0 10000 49 1000 FALSE EQUALS NOTHING -- 49 members
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` FALSE TRUE 500 10000 2 100 FALSE EQUALS JUST FALSE -- no resolution passed
#ASSERT `s 98(1) the applicants may apply to the court for the cancellation of the resolution` TRUE TRUE 500 10000 2 100 TRUE EQUALS JUST FALSE -- an applicant consented or voted in favour
-- s 98(2): within 28 days after the passing of the resolution (passed 1 March 2027)
#ASSERT `s 98(2) the application is made within 28 days after the passing of the resolution` (Date 1 3 2027) (Date 29 3 2027) EQUALS JUST TRUE -- the 28th day
#ASSERT `s 98(2) the application is made within 28 days after the passing of the resolution` (Date 1 3 2027) (Date 30 3 2027) EQUALS JUST FALSE -- the 29th day
#TRACE `s 98(2) the members' permission to apply to the court` AT 0 WITH
    PARTY Member DOES `s 98(2) apply to the court for the cancellation of the resolution` AT 28
-- TRACE-EXPECT: FULFILLED

#TRACE `s 98(2) the members' permission to apply to the court` AT 0 WITH
    (WAITUNTIL 29)
-- TRACE-EXPECT: FULFILLED

#ASSERT `s 98(2) the application may be made on behalf of the persons entitled to make it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 98(2) the application may be made on behalf of the persons entitled to make it` TRUE FALSE EQUALS NOTHING
#ASSERT `s 98(2) the application may be made on behalf of the persons entitled to make it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 98(3) the court shall make an order either cancelling or confirming the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 98(3) the court shall make an order either cancelling or confirming the resolution` FALSE EQUALS JUST FALSE
#ASSERT `s 98(4) the court may make the order on terms, adjourn for the purchase of dissentient members' interests, and give directions` TRUE EQUALS JUST TRUE
#ASSERT `s 98(4) the court may make the order on terms, adjourn for the purchase of dissentient members' interests, and give directions` FALSE EQUALS NOTHING
#ASSERT `s 98(5) the court's order may provide for the purchase by the company of members' shares and alter the articles` TRUE EQUALS JUST TRUE
#ASSERT `s 98(5) the court's order may provide for the purchase by the company of members' shares and alter the articles` FALSE EQUALS NOTHING
#ASSERT `s 98(6) the court's order may require the company not to amend its articles without the leave of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 98(6) the court's order may require the company not to amend its articles without the leave of the court` FALSE EQUALS NOTHING
#ASSERT `s 98(7) the court is the High Court` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 98(7) the court is the High Court` Scotland EQUALS NOTHING -- the rendering is silent for Scotland (finding 5)
#ASSERT `s 98(7) the court is the High Court` `Northern Ireland` EQUALS NOTHING
-- s 99(1), (2): the applicants and the company must immediately give notice to the registrar
#ASSERT `s 99(1) the applicants must immediately give notice to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 99(1) the applicants must immediately give notice to the registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 99(2) the company must immediately give notice to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 99(2) the company must immediately give notice to the registrar` FALSE EQUALS JUST FALSE
-- s 99(3): within 15 days of the making of the order, or such longer period as the court may direct, the company must deliver a copy of the order
#ASSERT `s 99(3) the number of days allowed for delivering a copy of the order` (JUST 30) EQUALS 30 -- a longer period
#ASSERT `s 99(3) the number of days allowed for delivering a copy of the order` (JUST 10) EQUALS 15 -- a direction of fewer days adds nothing
#ASSERT `s 99(3) the number of days allowed for delivering a copy of the order` (JUST 15) EQUALS 15
#ASSERT `s 99(3) the number of days allowed for delivering a copy of the order` (JUST 16) EQUALS 16
#ASSERT `s 99(3) the number of days allowed for delivering a copy of the order` NOTHING EQUALS 15
#ASSERT `s 99(3) the copy of the order is delivered within the time allowed` (Date 1 3 2027) (Date 16 3 2027) 15 EQUALS JUST TRUE -- 15 days
#ASSERT `s 99(3) the copy of the order is delivered within the time allowed` (Date 1 3 2027) (Date 17 3 2027) 15 EQUALS JUST FALSE -- 16 days
#ASSERT `s 99(3) the copy of the order is delivered within the time allowed` (Date 1 3 2027) (Date 31 3 2027) 30 EQUALS JUST TRUE -- the longer period
#TRACE `s 99(3) the company's duty to deliver a copy of the order` 15 AT 0 WITH
    PARTY Company DOES `s 99(3) deliver a copy of the order to the registrar` AT 15
-- TRACE-EXPECT: FULFILLED

#TRACE `s 99(3) the company's duty to deliver a copy of the order` 15 AT 0 WITH
    (WAITUNTIL 16)
-- TRACE-EXPECT: BREACHED

-- s 99(4): if the company fails to comply with (2) or (3) an offence is committed by the company and every officer in default
#ASSERT `s 99(4) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE -- no failure
#ASSERT `s 99(4) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE -- (a) the company
#ASSERT `s 99(4) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE -- (b) every officer in default
#ASSERT `s 99(4) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 99(4) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING -- an officer not in default
#ASSERT `s 99(4) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 99(4) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS NOTHING -- silent: no sentence treating a shadow director as an officer in this section
#ASSERT `s 99(4) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING -- not named
-- s 99(5): level 3 on the standard scale; daily default fine one-tenth of level 3
#ASSERT (`s 99(5) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 99(5) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 99(5) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
-- s 100(1)-(4)
#ASSERT `s 100(1) the application contains what the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 100(1) the application contains what the subsection requires` FALSE EQUALS JUST FALSE
#ASSERT `s 100(2) the application is accompanied by what the subsection requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 100(2) the application is accompanied by what the subsection requires` FALSE TRUE TRUE EQUALS JUST TRUE -- already forwarded
#ASSERT `s 100(2) the application is accompanied by what the subsection requires` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 100(2) the application is accompanied by what the subsection requires` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 100(3) the statement meets the description of the statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 100(3) the statement meets the description of the statement of compliance` FALSE EQUALS JUST FALSE
#ASSERT `s 100(4) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a private limited company` TRUE EQUALS JUST TRUE
#ASSERT `s 100(4) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a private limited company` FALSE EQUALS NOTHING -- there is no statement of compliance
-- s 101: the certificate of incorporation on re-registration as a private limited company (certificate issued 10 April 2027)
#ASSERT `s 101(1) the company shall be re-registered as a private limited company` TRUE EQUALS JUST TRUE
#ASSERT `s 101(1) the company shall be re-registered as a private limited company` FALSE EQUALS JUST FALSE -- the registrar is not satisfied
#ASSERT `s 101(2) the registrar must issue a certificate of incorporation altered to meet the circumstances of the case` TRUE EQUALS JUST TRUE
#ASSERT `s 101(2) the registrar must issue a certificate of incorporation altered to meet the circumstances of the case` FALSE EQUALS NOTHING
#ASSERT `s 101(3) the certificate meets the requirement of subsection (3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 101(3) the certificate meets the requirement of subsection (3)` TRUE FALSE EQUALS JUST FALSE -- no date stated
#ASSERT `s 101(3) the certificate meets the requirement of subsection (3)` FALSE TRUE EQUALS JUST FALSE -- not stated to be on re-registration
#ASSERT `s 101(4)(a) the company is a private limited company on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE -- the day of issue
#ASSERT `s 101(4)(a) the company is a private limited company on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE -- the day before
#ASSERT `s 101(4)(a) the company is a private limited company on the day` (JUST (Date 10 4 2027)) (Date 11 4 2027) EQUALS JUST TRUE
#ASSERT `s 101(4)(a) the company is a private limited company on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE -- no certificate issued
#ASSERT `s 101(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE -- the day of issue
#ASSERT `s 101(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE -- the day before
#ASSERT `s 101(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 11 4 2027) EQUALS JUST TRUE
#ASSERT `s 101(4)(b) the changes in the company's name and articles have taken effect on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE -- no certificate issued
#ASSERT `s 101(5) the certificate is conclusive evidence that the requirements of this Act as to re-registration have been complied with` TRUE EQUALS JUST TRUE
#ASSERT `s 101(5) the certificate is conclusive evidence that the requirements of this Act as to re-registration have been complied with` FALSE EQUALS NOTHING

-- s 102(4): who may assent for a member (members: assented, a trustee in bankruptcy is entitled, the trustee assented, deceased, the personal representative assented)
GIVEN assented IS A BOOLEAN, trusteeEntitled IS A BOOLEAN, trusteeAssented IS A BOOLEAN, deceased IS A BOOLEAN, repAssented IS A BOOLEAN
GIVETH A `s 102(4) member`
`s 102(4) test member` MEANS
    `s 102(4) member` WITH
        `the member has assented` IS assented
        `a trustee in bankruptcy of the member is entitled to assent` IS trusteeEntitled
        `the trustee in bankruptcy has assented` IS trusteeAssented
        `the member is deceased` IS deceased
        `the personal representative of the deceased member has assented on behalf of the deceased` IS repAssented

#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE -- (a) the trustee assented
#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE -- (a) the member's own assent is excluded
#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE -- (b) the personal representative assented
#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE -- (b) not yet assented
#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE -- an ordinary member who assented
#ASSERT `s 102(4) the member's assent is given` (`s 102(4) test member` FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE -- an ordinary member who has not assented
#ASSERT `s 102(1)(a) all the members of the company have assented` (LIST (`s 102(4) test member` TRUE FALSE FALSE FALSE FALSE), (`s 102(4) test member` FALSE TRUE TRUE FALSE FALSE)) EQUALS JUST TRUE
#ASSERT `s 102(1)(a) all the members of the company have assented` (LIST (`s 102(4) test member` TRUE FALSE FALSE FALSE FALSE), (`s 102(4) test member` FALSE FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE -- one member has not assented
-- s 102(5): "a trustee in bankruptcy of a member" includes a trustee or interim trustee in a Scottish sequestration or a trustee under a protected trust deed
#ASSERT `s 102(5) the person is a trustee in bankruptcy of a member of the company` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 102(5) the person is a trustee in bankruptcy of a member of the company` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 102(5) the person is a trustee in bankruptcy of a member of the company` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 102(5) the person is a trustee in bankruptcy of a member of the company` FALSE FALSE FALSE EQUALS NOTHING -- "includes"
#ASSERT `s 102(2) the condition is met` TRUE EQUALS JUST FALSE
#ASSERT `s 102(2) the condition is met` FALSE EQUALS JUST TRUE
-- s 102(1): a private limited company may be re-registered as unlimited if (a) all members assented, (b) the condition is met, (c) application and statement of compliance
-- (private, limited, all members assented, condition, application delivered, statement of compliance)
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING -- already unlimited
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` FALSE TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING -- a public company
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 102(1) the private limited company may be re-registered as an unlimited company` TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(3)(a) the company must make such changes in its name and its articles as are necessary in connection with its becoming an unlimited company` TRUE EQUALS JUST TRUE
#ASSERT `s 102(3)(a) the company must make such changes in its name and its articles as are necessary in connection with its becoming an unlimited company` FALSE EQUALS NOTHING
#ASSERT `s 102(3)(b) the company must make such further changes as are necessary in connection with its becoming an unlimited company having a share capital` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(3)(b) the company must make such further changes as are necessary in connection with its becoming an unlimited company having a share capital` TRUE FALSE EQUALS JUST FALSE -- no share capital
#ASSERT `s 102(3)(b) the company must make such further changes as are necessary in connection with its becoming an unlimited company having a share capital` FALSE TRUE EQUALS NOTHING
-- s 103
#ASSERT `s 103(1) the application contains what the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1) the application contains what the subsection requires` FALSE EQUALS JUST FALSE
-- (the prescribed form of assent, authenticated by or on behalf of all the members, the articles)
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE -- not authenticated by all
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 103(2) the application is accompanied by what the subsection requires` FALSE NOTHING TRUE EQUALS JUST FALSE
#ASSERT `s 103(3) the statement meets the description of the statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 103(3) the statement meets the description of the statement of compliance` FALSE EQUALS JUST FALSE
#ASSERT `s 103(5) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as an unlimited company` TRUE EQUALS JUST TRUE
#ASSERT `s 103(5) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as an unlimited company` FALSE EQUALS NOTHING -- there is no statement of compliance
-- s 103(4): the directors' statement (a) the persons authenticating are the whole membership, (b) if any member has not authenticated the form himself, reasonable steps were taken
-- (statement (a), some members did not authenticate themselves, statement (b))
#ASSERT `s 103(4) the statement of compliance contains the directors' statement` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 103(4) the statement of compliance contains the directors' statement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 103(4) the statement of compliance contains the directors' statement` TRUE TRUE FALSE EQUALS JUST FALSE -- (b) missing
#ASSERT `s 103(4) the statement of compliance contains the directors' statement` FALSE FALSE FALSE EQUALS JUST FALSE -- (a) missing
