#ASSERT `s 104(4)(a) the company is an unlimited company on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE -- the day of issue
#ASSERT `s 104(4)(a) the company is an unlimited company on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE -- the day before
