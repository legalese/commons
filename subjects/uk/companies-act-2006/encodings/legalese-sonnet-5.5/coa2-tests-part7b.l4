-- s 106(3): each member undertakes to contribute if the company is wound up while he is a member, or within one year after he ceases to be a member
-- (wound up while a member, the date he ceased, the date of the winding up)
#ASSERT `s 106(3) the member's undertaking covers the winding up` TRUE NOTHING (Date 1 6 2027) EQUALS JUST TRUE -- still a member
#ASSERT `s 106(3) the member's undertaking covers the winding up` FALSE (JUST (Date 1 6 2026)) (Date 1 6 2027) EQUALS JUST TRUE -- exactly one year after
#ASSERT `s 106(3) the member's undertaking covers the winding up` FALSE (JUST (Date 1 6 2026)) (Date 2 6 2027) EQUALS JUST FALSE -- one year and a day after
#ASSERT `s 106(3) the member's undertaking covers the winding up` FALSE NOTHING (Date 1 6 2027) EQUALS JUST FALSE
#ASSERT `s 106(3) the statement of guarantee is as required` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 106(3) the statement of guarantee is as required` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- no undertaking stated
#ASSERT `s 106(3) the statement of guarantee is as required` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a)
#ASSERT `s 106(3) the statement of guarantee is as required` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- (b)
#ASSERT `s 106(3) the statement of guarantee is as required` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- (c)
#ASSERT `s 106(3) the statement of guarantee is as required` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- no specified amount
#ASSERT `s 106(4) the statement meets the description of the statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 106(4) the statement meets the description of the statement of compliance` FALSE EQUALS JUST FALSE
#ASSERT `s 106(5) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a limited company` TRUE EQUALS JUST TRUE
#ASSERT `s 106(5) the registrar may accept the statement of compliance as sufficient evidence that the company is entitled to be re-registered as a limited company` FALSE EQUALS NOTHING -- there is no statement of compliance
