#ASSERT `s 104(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE -- the day of issue
#ASSERT `s 104(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 9 4 2027) EQUALS JUST FALSE -- the day before
#ASSERT `s 104(4)(b) the changes in the company's name and articles have taken effect on the day` (JUST (Date 10 4 2027)) (Date 11 4 2027) EQUALS JUST TRUE
#ASSERT `s 104(4)(b) the changes in the company's name and articles have taken effect on the day` NOTHING (Date 10 4 2027) EQUALS JUST FALSE -- no certificate issued
