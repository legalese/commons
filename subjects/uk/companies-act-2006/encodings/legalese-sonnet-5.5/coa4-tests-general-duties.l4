#ASSERT `s 177(6) the director need not declare the interest` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 177(6) the director need not declare the interest` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 177(6) the director need not declare the interest` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 177(6) the director need not declare the interest` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 177(6) the director need not declare the interest` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 177(6) the director need not declare the interest` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 177(1): arguments: interested in a proposed transaction; the answer under s 177(5); the answer under s 177(6)
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 177(1) the director is obliged to declare the nature and extent of the interest to the other directors` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
-- s 177(2): arguments: at a meeting of the directors; s 184 notice in writing; s 185 general notice
#ASSERT `s 177(2) the declaration is made in a way the subsection allows` TRUE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 177(2) the declaration is made in a way the subsection allows` FALSE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 177(2) the declaration is made in a way the subsection allows` FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 177(2) the declaration is made in a way the subsection allows` FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 177(2) the declaration is made in a way the subsection allows` FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 177(3) a further declaration must be made` TRUE EQUALS JUST TRUE
#ASSERT `s 177(3) a further declaration must be made` FALSE EQUALS JUST FALSE
-- s 177(1) and (4): arguments: the answer under s 177(1); declared; declared before the company entered into the transaction
#ASSERT `s 177(4) the director has made the declaration the section requires` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 177(4) the director has made the declaration the section requires` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 177(4) the director has made the declaration the section requires` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 177(4) the director has made the declaration the section requires` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 177(4) the director has made the declaration the section requires` NOTHING TRUE TRUE EQUALS NOTHING
-- `s 177(1) the director's duty to declare the interest to the other directors` as a regulative rule (no deadline in the text): with the event it is FULFILLED; with no event the duty stays standing.
#TRACE `s 177(1) the director's duty to declare the interest to the other directors` AT 0 WITH
    PARTY Director DOES `Action of a party` OF Director, Director, "declare the nature and extent of the interest to the other directors before the company enters into the transaction or arrangement" AT 1
#TRACE `s 177(1) the director's duty to declare the interest to the other directors` AT 0 WITH
    (WAITUNTIL 5)

