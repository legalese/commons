#ASSERT `s 1000(7)(a) the liability of the person continues and may be enforced as if the company had not been dissolved` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 1000(7)(a) the liability of the person continues and may be enforced as if the company had not been dissolved` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 1000(7)(a) the liability of the person continues and may be enforced as if the company had not been dissolved` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 1000(7)(b) nothing in the section affects the power of the court to wind up the company` TRUE EQUALS JUST TRUE
#ASSERT `s 1000(7)(b) nothing in the section affects the power of the court to wind up the company` FALSE EQUALS NOTHING

