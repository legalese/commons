IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa22-part31-ch1`

-- coa22-tests-part31-ch1.l4: tests for Part 31, Chapter 1 (ss 1000 to 1011). Every expected value was decided from
-- the text (quoted in coa22-part31-ch1.l4) before the run and is written beside the assertion; none was copied from
-- the output. T = JUST TRUE, F = JUST FALSE, N = NOTHING ("not covered"). Dates: Date day month year.
-- A trace is not an assertion on the stable binary: each #TRACE carries its expected outcome on the line before it
-- (-- EXPECT:), and check-traces.py compares it with what the binary prints.

§ `Part 31 Chapter 1 tests`

§§ `s 1000 Power to strike off company not carrying on business or in operation`

#ASSERT `s 1000(1) the registrar may send the company a communication inquiring whether it is carrying on business or in operation` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1000(1) the registrar may send the company a communication inquiring whether it is carrying on business or in operation` FALSE EQUALS JUST FALSE; name-test sweep of 2026-11-12: a grant named "may" whose "if" gate fails answers NOTHING, not JUST FALSE (the other reading is JUST FALSE, fork F19); the facts are unchanged
#ASSERT `s 1000(1) the registrar may send the company a communication inquiring whether it is carrying on business or in operation` FALSE EQUALS NOTHING

-- (2) first communication sent 1 March 2026: the 14 days end on 15 March; the second communication is due by 29 March
#ASSERT `s 1000(2) the last day of the 14 days for an answer to the first communication` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 1000(2) the last day for the registrar to send the second communication` (Date 1 3 2026) EQUALS Date 29 3 2026
#ASSERT `s 1000(2) the last day of the 14 days for an answer to the first communication` (Date 25 2 2026) EQUALS Date 11 3 2026
-- args: date sent; date an answer was received (if); date asked about
#ASSERT `s 1000(2) the registrar must send a second communication` (Date 1 3 2026) NOTHING (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 1000(2) the registrar must send a second communication` (Date 1 3 2026) NOTHING (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 1000(2) the registrar must send a second communication` (Date 1 3 2026) (JUST (Date 15 3 2026)) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 1000(2) the registrar must send a second communication` (Date 1 3 2026) (JUST (Date 1 3 2026)) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 1000(2) the registrar must send a second communication` (Date 1 3 2026) (JUST (Date 16 3 2026)) (Date 20 3 2026) EQUALS JUST TRUE
-- args: date first sent; date second sent. The window is after the 14 days and within 14 days after them.
#ASSERT `s 1000(2) the second communication was sent within the time allowed` (Date 1 3 2026) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 1000(2) the second communication was sent within the time allowed` (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 1000(2) the second communication was sent within the time allowed` (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 1000(2) the second communication was sent within the time allowed` (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 1000(2) the second communication was sent within the time allowed` (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST FALSE
-- content: refers to the first; states no answer received; states the Gazette consequence
#ASSERT `s 1000(2) the second communication has the content the text requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1000(2) the second communication has the content the text requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1000(2) the second communication has the content the text requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1000(2) the second communication has the content the text requires` TRUE TRUE FALSE EQUALS JUST FALSE

-- (3)(b) args: date second communication sent (1 April 2026); date an answer was received (if); date asked about
#ASSERT `s 1000(3)(b) the registrar does not within 14 days after sending the second communication receive any answer` (Date 1 4 2026) NOTHING (Date 15 4 2026) EQUALS JUST FALSE
#ASSERT `s 1000(3)(b) the registrar does not within 14 days after sending the second communication receive any answer` (Date 1 4 2026) NOTHING (Date 16 4 2026) EQUALS JUST TRUE
#ASSERT `s 1000(3)(b) the registrar does not within 14 days after sending the second communication receive any answer` (Date 1 4 2026) (JUST (Date 15 4 2026)) (Date 20 4 2026) EQUALS JUST FALSE
#ASSERT `s 1000(3)(b) the registrar does not within 14 days after sending the second communication receive any answer` (Date 1 4 2026) (JUST (Date 16 4 2026)) (Date 20 4 2026) EQUALS JUST TRUE
-- (3) args: an answer to the effect that the company is not carrying on business; the (b) answer
#ASSERT `s 1000(3) the registrar may publish in the Gazette, and send to the company, the notice of intended striking off` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1000(3) the registrar may publish in the Gazette, and send to the company, the notice of intended striking off` FALSE (JUST TRUE) EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1000(3) the registrar may publish in the Gazette, and send to the company, the notice of intended striking off` FALSE (JUST FALSE) EQUALS JUST FALSE; name-test sweep of 2026-11-12: a grant named "may" whose "if" gate fails answers NOTHING, not JUST FALSE (the other reading is JUST FALSE, fork F20); the facts are unchanged
