IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa2-ch3-similarity`

-- coa2-tests-ch3.l4: tests for coa2-ch3-similarity.l4 (ss 66-74).
-- Every expected value is written from the text of the section named beside it, before running.
-- JUST FALSE = the text says no; JUST TRUE = the text says yes; NOTHING = the text does not decide.

-- s 66(1): must not be registered by a name that is the same as another name in the index; (4)(a) regulations may permit it in specified circumstances
-- (same name, permitted by regulations under subsection (4))
#ASSERT `s 66(1) the company may be registered by the name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 66(1) the company may be registered by the name` TRUE TRUE EQUALS JUST TRUE -- (4)(a)
#ASSERT `s 66(1) the company may be registered by the name` FALSE FALSE EQUALS NOTHING -- not the same: the prohibition is silent
#ASSERT `s 66(1) the company may be registered by the name` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 66(6) the circumstances or consent are specified` TRUE EQUALS JUST TRUE
#ASSERT `s 66(6) the circumstances or consent are specified` FALSE EQUALS JUST FALSE

-- s 67(1): the Secretary of State may direct a change of name if it has been registered in a name that is the same as, or in the Secretary of State's opinion too like, (a) a name in the index at the time or (b) a name that should have been
-- (same as, in the opinion too like, appeared in the index, should have appeared)
#ASSERT `s 67(1) the Secretary of State may direct the company to change its name` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- the same as (a)
#ASSERT `s 67(1) the Secretary of State may direct the company to change its name` FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- too like (b)
#ASSERT `s 67(1) the Secretary of State may direct the company to change its name` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not a name in (a) or (b) -- RECONCILED 2026-11-12: was #ASSERT `s 67(1) the Secretary of State may direct the company to change its name` TRUE FALSE FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 11)
#ASSERT `s 67(1) the Secretary of State may direct the company to change its name` FALSE FALSE TRUE TRUE EQUALS NOTHING -- neither the same nor too like -- RECONCILED 2026-11-12: was #ASSERT `s 67(1) the Secretary of State may direct the company to change its name` FALSE FALSE TRUE TRUE EQUALS JUST FALSE; the function is named for a power, the "if" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 11)
#ASSERT `s 67(1A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` TRUE EQUALS JUST TRUE
#ASSERT `s 67(1A) the registrar may omit from the register material available for public inspection any mention of the name to which the direction relates` FALSE EQUALS JUST FALSE
#ASSERT `s 67(6) the circumstances or consent are specified` TRUE EQUALS JUST TRUE
#ASSERT `s 67(6) the circumstances or consent are specified` FALSE EQUALS JUST FALSE

-- s 68(2)(a): a direction must be given within twelve months of the company's registration by the name (registered 15 March 2026)
#ASSERT `s 68(2)(a) the direction is given within twelve months of the company's registration by the name` (Date 15 3 2026) (Date 15 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `s 68(2)(a) the direction is given within twelve months of the company's registration by the name` (Date 15 3 2026) (Date 14 3 2027) EQUALS JUST TRUE
#ASSERT `s 68(2)(a) the direction is given within twelve months of the company's registration by the name` (Date 15 3 2026) (Date 16 3 2027) EQUALS JUST FALSE -- the day after
#ASSERT `s 68(2)(b) the direction specifies the period` TRUE EQUALS JUST TRUE
#ASSERT `s 68(2)(b) the direction specifies the period` FALSE EQUALS JUST FALSE
#ASSERT `s 68(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- 28 days beginning with the date of the direction
#ASSERT `s 68(2A) the period meets the requirement of subsection (2A)` (Date 1 3 2027) (Date 27 3 2027) EQUALS JUST FALSE -- 27 days
#ASSERT `s 68(3) the Secretary of State may give a further direction extending the period` (Date 28 3 2027) (Date 28 3 2027) EQUALS JUST TRUE -- fork 2: on the last day
#ASSERT `s 68(3) the Secretary of State may give a further direction extending the period` (Date 27 3 2027) (Date 28 3 2027) EQUALS JUST TRUE
#ASSERT `s 68(3) the Secretary of State may give a further direction extending the period` (Date 29 3 2027) (Date 28 3 2027) EQUALS JUST FALSE
#ASSERT `s 68(4) the direction meets the requirement of being in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 68(4) the direction meets the requirement of being in writing` FALSE EQUALS JUST FALSE

-- s 68(5): the duty to comply with the direction within the period it specifies (28 days here)
#TRACE `s 68(5) the company's duty to change its name as directed` 28 AT 0 WITH
    PARTY Company DOES `s 68(5) change the company's name as the direction requires` AT 28
-- TRACE-EXPECT: FULFILLED

#TRACE `s 68(5) the company's duty to change its name as directed` 28 AT 0 WITH
    (WAITUNTIL 29)
-- TRACE-EXPECT: BREACHED

-- s 68(5): who commits the offence: the company and every officer in default; a shadow director is treated as an officer
#ASSERT `s 68(5) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 68(5) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 68(5) the person commits an offence` TRUE `Officer in default` NOTHING EQUALS JUST TRUE
#ASSERT `s 68(5) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 68(5) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 68(5) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 68(5) the person commits an offence` TRUE `Shadow director` (JUST TRUE) EQUALS JUST TRUE -- "For this purpose a shadow director is treated as an officer of the company."
#ASSERT `s 68(5) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING

-- s 68(6): level 3 on the standard scale; daily default fine one-tenth of level 3
#ASSERT (`s 68(6) the penalty on summary conviction`)'s `how convicted` EQUALS `on summary conviction`
#ASSERT (`s 68(6) the penalty on summary conviction`)'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 68(6) the penalty on summary conviction`)'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
#ASSERT (`s 68(6) the penalty on summary conviction`)'s `imprisonment not exceeding` EQUALS NOTHING

-- s 69(1): objection on the ground that the name is (a) the same as a name associated with the applicant in which he has goodwill, or (b) sufficiently similar to be likely to mislead
#ASSERT `s 69(1) the applicant may object to the company's registered name` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 69(1) the applicant may object to the company's registered name` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 69(1) the applicant may object to the company's registered name` FALSE FALSE EQUALS NOTHING
#ASSERT `s 69(7) the interest is goodwill` TRUE EQUALS JUST TRUE -- "includes reputation of any description"
#ASSERT `s 69(7) the interest is goodwill` FALSE EQUALS NOTHING
#ASSERT `s 69(2) the objection is made as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 69(2) the objection is made as the subsection requires` FALSE EQUALS JUST FALSE
#ASSERT `s 69(3) the person is the primary respondent to the application` TRUE EQUALS JUST TRUE
#ASSERT `s 69(3) the person is the primary respondent to the application` FALSE EQUALS NOTHING
#ASSERT `s 69(3) the person may be joined as a respondent` TRUE FALSE EQUALS JUST TRUE -- (a) a member or former member at the time
#ASSERT `s 69(3) the person may be joined as a respondent` FALSE TRUE EQUALS JUST TRUE -- (b) a director or former director at the time
#ASSERT `s 69(3) the person may be joined as a respondent` FALSE FALSE EQUALS NOTHING

-- s 69(4): the ground is established; the respondents show (a), (c), (d) or (e); if none is shown the objection is upheld
-- (ground established, (a) registered before the activities, (c) company formation business, (d) good faith, (e) interests not adversely affected)
#ASSERT `s 69(4) the objection is upheld under subsection (4)` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 69(4) the objection is upheld under subsection (4)` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- ground not established
#ASSERT `s 69(4) the objection is upheld under subsection (4)` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- (a) shown
#ASSERT `s 69(4) the objection is upheld under subsection (4)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- (c) shown
#ASSERT `s 69(4) the objection is upheld under subsection (4)` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- (d) shown
#ASSERT `s 69(4) the objection is upheld under subsection (4)` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- (e) shown

-- s 69(5): the objection is nevertheless upheld if the (4)(a) or (c) facts are established and the applicant shows the main purpose was to obtain money or block
#ASSERT `s 69(5) the objection is nevertheless upheld` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 69(5) the objection is nevertheless upheld` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 69(5) the objection is nevertheless upheld` FALSE TRUE EQUALS JUST FALSE -- (4)(d) or (e) was shown, not (a) or (c)

-- s 69(6): if the objection is not upheld under (4) or (5), it shall be dismissed
#ASSERT `s 69(6) the objection is dismissed` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 69(6) the objection is dismissed` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 69(6) the objection is dismissed` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 69(6) the objection is dismissed` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 69(6) the objection is dismissed` (JUST TRUE) NOTHING EQUALS JUST FALSE

-- s 72(1): within 90 days of determining an application the adjudicator must make the decision available
#TRACE `s 72(1) the adjudicator's duty to make the decision available` AT 0 WITH
    PARTY `s 72(1) the company names adjudicator` DOES `s 72(1) make the decision and the reasons for it available to the public` AT 90
-- TRACE-EXPECT: FULFILLED

#TRACE `s 72(1) the adjudicator's duty to make the decision available` AT 0 WITH
    (WAITUNTIL 91)
-- TRACE-EXPECT: BREACHED

#ASSERT `s 72(1) the decision was made available within 90 days of the determination` (Date 1 3 2027) (Date 30 5 2027) EQUALS JUST TRUE -- 1 March plus 90 days is 30 May
#ASSERT `s 72(1) the decision was made available within 90 days of the determination` (Date 1 3 2027) (Date 31 5 2027) EQUALS JUST FALSE
#ASSERT `s 72(2) the adjudicator may make the decision available by the means` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 72(2) the adjudicator may make the decision available by the means` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 72(2) the adjudicator may make the decision available by the means` FALSE FALSE EQUALS NOTHING

-- s 73(2): "offending name" means a name that by reason of its similarity to the name associated with the applicant would be likely (a) to be the subject of a s 67 direction or (b) to give rise to a further s 69 application
-- (similar, likely s 67 direction, likely further application)
#ASSERT `s 73(2) the name is an offending name` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 73(2) the name is an offending name` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 73(2) the name is an offending name` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 73(2) the name is an offending name` FALSE TRUE TRUE EQUALS JUST FALSE

-- s 73(1): if an application under s 69 is upheld, the adjudicator shall make an order (a) requiring the respondent company to change its name, (b) requiring all the respondents to take steps
#ASSERT `s 73(1) the adjudicator must make an order` TRUE EQUALS JUST TRUE
#ASSERT `s 73(1) the adjudicator must make an order` FALSE EQUALS JUST FALSE
#ASSERT `s 73(1)(a) the order requires the person to change its name to one that is not an offending name` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 73(1)(a) the order requires the person to change its name to one that is not an offending name` TRUE FALSE EQUALS NOTHING -- a respondent that is not the company
#ASSERT `s 73(1)(a) the order requires the person to change its name to one that is not an offending name` FALSE TRUE EQUALS NOTHING
#ASSERT `s 73(1)(b) the order requires the person to take the steps and not to cause or permit steps towards another offending name` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 73(1)(b) the order requires the person to take the steps and not to cause or permit steps towards another offending name` TRUE FALSE EQUALS NOTHING
#ASSERT `s 73(1)(b) the order requires the person to take the steps and not to cause or permit steps towards another offending name` FALSE TRUE EQUALS NOTHING

-- s 73(3): the order must specify a date; enforcement (a) in England and Wales or Northern Ireland as an order of the High Court, (b) in Scotland as a decree of the Court of Session
#ASSERT `s 73(3) the order meets the requirement to specify a date` TRUE EQUALS JUST TRUE
#ASSERT `s 73(3) the order meets the requirement to specify a date` FALSE EQUALS JUST FALSE
#ASSERT `s 73(3) the order may be enforced` `England and Wales` EQUALS `s 73(3) in the same way as an order of the High Court`
#ASSERT `s 73(3) the order may be enforced` `Northern Ireland` EQUALS `s 73(3) in the same way as an order of the High Court`
#ASSERT `s 73(3) the order may be enforced` Scotland EQUALS `s 73(3) in the same way as a decree of the Court of Session`

-- s 73(6): a company's name is changed when the change takes effect under s 81(1), on the issue of the new certificate (order date 10 April 2027)
#ASSERT `s 73(6) the name is changed in accordance with the order by the specified date` (JUST (Date 10 4 2027)) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 73(6) the name is changed in accordance with the order by the specified date` (JUST (Date 11 4 2027)) (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 73(6) the name is changed in accordance with the order by the specified date` NOTHING (Date 10 4 2027) EQUALS JUST FALSE -- no certificate issued

-- s 73(4): if the name is not changed in accordance with the order by the specified date, the adjudicator may determine a new name
#ASSERT `s 73(4) the adjudicator may determine a new name for the company` (JUST TRUE) EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 73(4) the adjudicator may determine a new name for the company` (JUST TRUE) EQUALS JUST FALSE; the function is named for a power, the "if the name is not changed" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 12)
#ASSERT `s 73(4) the adjudicator may determine a new name for the company` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 73(4) the adjudicator may determine a new name for the company` NOTHING EQUALS NOTHING

-- s 73(5): notice of the determination to (a) the applicant, (b) the respondents, (c) the registrar
#ASSERT `s 73(5) the adjudicator must give notice of his determination to the recipient` TRUE `s 73(5) the applicant` EQUALS JUST TRUE
#ASSERT `s 73(5) the adjudicator must give notice of his determination to the recipient` TRUE `s 73(5) the respondents` EQUALS JUST TRUE
#ASSERT `s 73(5) the adjudicator must give notice of his determination to the recipient` TRUE `s 73(5) the registrar` EQUALS JUST TRUE
#ASSERT `s 73(5) the adjudicator must give notice of his determination to the recipient` TRUE `s 73(5) another person` EQUALS NOTHING
#ASSERT `s 73(5) the adjudicator must give notice of his determination to the recipient` FALSE `s 73(5) the registrar` EQUALS JUST FALSE

-- s 73(7): where an order is made under (1), the registrar may omit the name from the public register
#ASSERT `s 73(7) the registrar may omit from the register material available for public inspection any mention of the name to which the order relates` TRUE EQUALS JUST TRUE
#ASSERT `s 73(7) the registrar may omit from the register material available for public inspection any mention of the name to which the order relates` FALSE EQUALS JUST FALSE

-- s 74(1): an appeal lies to the court from any decision of a company names adjudicator to uphold or dismiss an application under s 69
#ASSERT `s 74(1) an appeal lies to the court from the decision` TRUE EQUALS JUST TRUE
#ASSERT `s 74(1) an appeal lies to the court from the decision` FALSE EQUALS NOTHING

-- s 74(2): notice of appeal against a decision upholding an application must be given before the date specified in the order (10 April 2027)
-- (decision upholds, date of notice, date specified in the order)
#ASSERT `s 74(2) notice of appeal is given in time` TRUE (Date 9 4 2027) (Date 10 4 2027) EQUALS JUST TRUE
#ASSERT `s 74(2) notice of appeal is given in time` TRUE (Date 10 4 2027) (Date 10 4 2027) EQUALS JUST FALSE -- "before the date": not on it
#ASSERT `s 74(2) notice of appeal is given in time` FALSE (Date 9 4 2027) (Date 10 4 2027) EQUALS NOTHING -- an appeal against a decision dismissing an application

-- s 74(3): if notice of appeal is given against a decision upholding an application, the effect of the order is suspended
#ASSERT `s 74(3) the effect of the adjudicator's order is suspended` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 74(3) the effect of the adjudicator's order is suspended` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 74(3) the effect of the adjudicator's order is suspended` FALSE TRUE EQUALS JUST FALSE

-- s 74(4): if the court affirms a decision to uphold or reverses a decision to dismiss, it may specify the date, remit or make any order the adjudicator might have made
#ASSERT `s 74(4) the court may specify the date, remit the matter or make any order or determination that the adjudicator might have made` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 74(4) the court may specify the date, remit the matter or make any order or determination that the adjudicator might have made` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 74(4) the court may specify the date, remit the matter or make any order or determination that the adjudicator might have made` FALSE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 74(4) the court may specify the date, remit the matter or make any order or determination that the adjudicator might have made` FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if on appeal" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 13)

-- s 74(5): notice of the court's determination to (a) the parties to the appeal and (b) the registrar
#ASSERT `s 74(5) the court must give notice of the determination to the recipient` TRUE `s 74(5) the parties to the appeal` EQUALS JUST TRUE
#ASSERT `s 74(5) the court must give notice of the determination to the recipient` TRUE `s 74(5) the registrar` EQUALS JUST TRUE
#ASSERT `s 74(5) the court must give notice of the determination to the recipient` TRUE `s 74(5) another person` EQUALS NOTHING
#ASSERT `s 74(5) the court must give notice of the determination to the recipient` FALSE `s 74(5) the parties to the appeal` EQUALS JUST FALSE
