IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa26-support`
IMPORT `coa26-ch3a`

-- Tests for coa26-ch3a.l4 (ss 1226-1231). Expected values are written by hand from the text.

-- s 1226(1): the four Auditors General
#ASSERT `s 1226(1) the person is an Auditor General` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1226(1) the person is an Auditor General` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1226(1) the person is an Auditor General` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1226(1) the person is an Auditor General` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1226(1) the person is an Auditor General` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 1226(2), (3). order: is an Auditor General (MAYBE), a suspension notice having effect suspends the eligibility
#ASSERT `s 1226(2) the Auditor General is eligible for appointment as a statutory auditor` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 1226(2) the Auditor General is eligible for appointment as a statutory auditor` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 1226(2) the Auditor General is eligible for appointment as a statutory auditor` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 1226(2) the Auditor General is eligible for appointment as a statutory auditor` NOTHING FALSE EQUALS NOTHING
-- s 1227. order: responsible for statutory audit work on behalf of the Auditor General, the s 1212(1) answer
#ASSERT `s 1227 the Auditor General has secured that the individual is eligible for appointment as a statutory auditor by virtue of Chapter 2` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1227 the Auditor General has secured that the individual is eligible for appointment as a statutory auditor by virtue of Chapter 2` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1227 the Auditor General has secured that the individual is eligible for appointment as a statutory auditor by virtue of Chapter 2` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1227 the Auditor General has secured that the individual is eligible for appointment as a statutory auditor by virtue of Chapter 2` FALSE (JUST FALSE) EQUALS NOTHING

-- s 1228
#ASSERT `s 1228(1) the Secretary of State has appointed the Independent Supervisor` TRUE EQUALS JUST TRUE
#ASSERT `s 1228(1) the Secretary of State has appointed the Independent Supervisor` FALSE EQUALS JUST FALSE
#ASSERT `s 1228(2) the appointment is made in the required form` TRUE EQUALS JUST TRUE
#ASSERT `s 1228(2) the appointment is made in the required form` FALSE EQUALS JUST FALSE
#ASSERT `s 1228(3) the body appointed is designated under section 5 of the Freedom of Information Act 2000` TRUE EQUALS JUST TRUE
#ASSERT `s 1228(3) the body appointed is designated under section 5 of the Freedom of Information Act 2000` FALSE EQUALS NOTHING
-- s 1228(4): only if a body corporate or unincorporated association which appears willing and able and to have the arrangements
#ASSERT `s 1228(4) the conditions for appointing the body are met` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1228(4) the conditions for appointing the body are met` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1228(4) the conditions for appointing the body are met` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1228(4) the conditions for appointing the body are met` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 1228(5). order: exercised effectively, the order contains requirements under (6), exercised in accordance with them
#ASSERT `s 1228(5) the conditions in subsection (5) are met` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1228(5) the conditions in subsection (5) are met` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1228(5) the conditions in subsection (5) are met` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1228(5) the conditions in subsection (5) are met` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1228(6) the order may contain the requirement or provision` TRUE EQUALS JUST TRUE
#ASSERT `s 1228(6) the order may contain the requirement or provision` FALSE EQUALS NOTHING

-- s 1229
#ASSERT `s 1229(1) the Independent Supervisor has complied with the duty to supervise the Auditors General` TRUE EQUALS JUST TRUE
#ASSERT `s 1229(1) the Independent Supervisor has complied with the duty to supervise the Auditors General` FALSE EQUALS JUST FALSE
#ASSERT `s 1229(2) the Independent Supervisor has discharged the duty in subsection (1)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1229(2) the Independent Supervisor has discharged the duty in subsection (1)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1229(2) the Independent Supervisor has discharged the duty in subsection (1)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1229(2A) the Independent Supervisor has complied with the duty to oversee the arrangements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1229(2A) the Independent Supervisor has complied with the duty to oversee the arrangements` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1229(2A) the Independent Supervisor has complied with the duty to oversee the arrangements` FALSE TRUE EQUALS JUST FALSE
-- s 1229(3): the arrangements and all six functions
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1229(3) the arrangements are supervision arrangements` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1229(3A) the requirement applies in relation to the supervision arrangements` TRUE EQUALS JUST TRUE
#ASSERT `s 1229(3A) the requirement applies in relation to the supervision arrangements` FALSE EQUALS NOTHING
#ASSERT `s 1229(4) the Independent Supervisor may enter into supervision arrangements with the body` TRUE EQUALS JUST TRUE
#ASSERT `s 1229(4) the Independent Supervisor may enter into supervision arrangements with the body` FALSE EQUALS NOTHING
#ASSERT `s 1229(5) the Independent Supervisor has complied with the duty to notify each Auditor General` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1229(5) the Independent Supervisor has complied with the duty to notify each Auditor General` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1229(5) the Independent Supervisor has complied with the duty to notify each Auditor General` FALSE TRUE EQUALS JUST FALSE
-- s 1229(5A): at least once in every calendar year (a delivery on 31 December counts for that year, one on 1 January does not)
#ASSERT `s 1229(5A) the Independent Supervisor delivered the summary in the calendar year` 2026 (LIST Date 31 12 2026) EQUALS JUST TRUE
#ASSERT `s 1229(5A) the Independent Supervisor delivered the summary in the calendar year` 2026 (LIST Date 1 1 2027) EQUALS JUST FALSE
#ASSERT `s 1229(5A) the Independent Supervisor delivered the summary in the calendar year` 2026 (LIST Date 1 1 2026, Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 1229(5A) the Independent Supervisor delivered the summary in the calendar year` 2026 (LIST Date 31 12 2025) EQUALS JUST FALSE
#ASSERT `s 1229(5A) the Independent Supervisor delivered the summary in the calendar year` 2026 EMPTY EQUALS JUST FALSE
#ASSERT `s 1229(6) the arrangements may provide for payment of a fine to any person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1229(6) the arrangements may provide for payment of a fine to any person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1229(6) the arrangements may provide for payment of a fine to any person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1229(7) the fine is to be paid into the Consolidated Fund` TRUE EQUALS JUST TRUE
#ASSERT `s 1229(7) the fine is to be paid into the Consolidated Fund` FALSE EQUALS NOTHING

-- s 1230(1): the three duties
#ASSERT `s 1230(1) the Auditor General has complied with the duties in subsection (1)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1230(1) the Auditor General has complied with the duties in subsection (1)` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1230(1) the Auditor General has complied with the duties in subsection (1)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1230(1) the Auditor General has complied with the duties in subsection (1)` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 1230(2): who is paid, and how much
#ASSERT `s 1230(2) who the Auditor General must pay the proportion of the costs to` TRUE FALSE EQUALS `s 1230(2)(a) the Independent Supervisor`
#ASSERT `s 1230(2) who the Auditor General must pay the proportion of the costs to` FALSE TRUE EQUALS `s 1230(2)(b) the body with which the Independent Supervisor has entered into supervision arrangements`
#ASSERT `s 1230(2) who the Auditor General must pay the proportion of the costs to` FALSE FALSE EQUALS `s 1230(2) nobody under this subsection`
#ASSERT `s 1230(2) the amount the Auditor General must pay, in pounds` 10000 (JUST 0.25) EQUALS JUST 2500
#ASSERT `s 1230(2) the amount the Auditor General must pay, in pounds` 10000 (JUST 1) EQUALS JUST 10000
#ASSERT `s 1230(2) the amount the Auditor General must pay, in pounds` 10000 NOTHING EQUALS NOTHING
-- s 1230(3)
#ASSERT `s 1230(3) the expenditure is regarded as` TRUE FALSE EQUALS `s 1230(3)(b) expenditure of the Northern Ireland Audit Office for the purposes of Article 6(1) of the Audit (Northern Ireland) Order 1987`
#ASSERT `s 1230(3) the expenditure is regarded as` FALSE TRUE EQUALS `s 1230(3)(c) expenditure of the Wales Audit Office for the purposes of section 20 of the Public Audit (Wales) Act 2013`
#ASSERT `s 1230(3) the expenditure is regarded as` FALSE FALSE EQUALS `s 1230(3) not covered by this subsection`
#ASSERT `s 1230(4) the arrangements are the supervision arrangements` TRUE EQUALS JUST TRUE
#ASSERT `s 1230(4) the arrangements are the supervision arrangements` FALSE EQUALS JUST FALSE

-- s 1231
#ASSERT `s 1231(1) the Independent Supervisor prepared a report in the calendar year` 2026 (LIST Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 1231(1) the Independent Supervisor prepared a report in the calendar year` 2026 (LIST Date 15 6 2025, Date 15 6 2027) EQUALS JUST FALSE
#ASSERT `s 1231(1) the Independent Supervisor prepared a report in the calendar year` 2026 EMPTY EQUALS JUST FALSE
#ASSERT `s 1231(2) the Independent Supervisor has given a copy of the report to each person named` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1231(2) the Independent Supervisor has given a copy of the report to each person named` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1231(2) the Independent Supervisor has given a copy of the report to each person named` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1231(2) the Independent Supervisor has given a copy of the report to each person named` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1231(2) the Independent Supervisor has given a copy of the report to each person named` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1231(3) the Secretary of State has laid a copy of the report before each House of Parliament` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1231(3) the Secretary of State has laid a copy of the report before each House of Parliament` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1231(3) the Secretary of State has laid a copy of the report before each House of Parliament` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1231(3A) the First Minister for Wales has laid a copy of the report before the National Assembly for Wales` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1231(3A) the First Minister for Wales has laid a copy of the report before the National Assembly for Wales` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1231(3A) the First Minister for Wales has laid a copy of the report before the National Assembly for Wales` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1231(4) the section applies with the modifications specified in the order` TRUE EQUALS JUST TRUE
#ASSERT `s 1231(4) the section applies with the modifications specified in the order` FALSE EQUALS NOTHING
