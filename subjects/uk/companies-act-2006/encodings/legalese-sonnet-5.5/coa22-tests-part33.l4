IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa22-part33`

-- coa22-tests-part33.l4: tests for Part 33 (ss 1040 to 1043). Every expected value was decided from the text (quoted in
-- coa22-part33.l4) before the run and is written beside the assertion. T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Part 33 tests`

§§ `s 1040 Companies authorised to register under this Act`

-- (1) args: in existence on 2 November 1862; formed after that date under an Act of Parliament; under letters patent; otherwise duly constituted; registered under Part 4 of the Risk Transformation Regulations 2017
#ASSERT `s 1040(1) section 1040 applies to the company` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1040(1) section 1040 applies to the company` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1040(1) section 1040 applies to the company` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1040(1) section 1040 applies to the company` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1040(1) section 1040 applies to the company` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- other than a company registered under Part 4 of the Risk Transformation Regulations 2017
#ASSERT `s 1040(1) section 1040 applies to the company` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1040(1) section 1040 applies to the company` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- (2) args: the (1) answer; the company makes an application
#ASSERT `s 1040(2) the company may register under this Act` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1040(2) the company may register under this Act` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1040(2) the company may register under this Act` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1040(2) the company may register under this Act` NOTHING TRUE EQUALS NOTHING
-- (3) args: the (2) answer
#ASSERT `s 1040(3) the company may register as the kind of company, subject to the following provisions` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1040(3) the company may register as the kind of company, subject to the following provisions` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1040(3) the company may register as the kind of company, subject to the following provisions` NOTHING EQUALS NOTHING
-- (4)(a) args: liability limited by Act of Parliament or letters patent; the section 1041(1) answer
#ASSERT `s 1040(4)(a) the company may register under section 1040` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1040(4)(a) the company may register under section 1040` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1040(4)(a) the company may register under section 1040` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1040(4)(a) the company may register under section 1040` FALSE (JUST FALSE) EQUALS NOTHING
-- (4)(b) args: liability limited by Act of Parliament or letters patent; the kind of registration
#ASSERT `s 1040(4)(b) the company may register as the kind of company` TRUE `s 1040(3) as an unlimited company` EQUALS JUST FALSE
#ASSERT `s 1040(4)(b) the company may register as the kind of company` TRUE `s 1040(3) as a company limited by guarantee` EQUALS JUST FALSE
#ASSERT `s 1040(4)(b) the company may register as the kind of company` TRUE `s 1040(3) as a company limited by shares` EQUALS NOTHING
#ASSERT `s 1040(4)(b) the company may register as the kind of company` FALSE `s 1040(3) as an unlimited company` EQUALS NOTHING
-- (5) args: the section 1041(1) answer; the kind of registration
#ASSERT `s 1040(5) the company may register as the kind of company` (JUST FALSE) `s 1040(3) as a company limited by shares` EQUALS JUST FALSE
#ASSERT `s 1040(5) the company may register as the kind of company` (JUST FALSE) `s 1040(3) as an unlimited company` EQUALS NOTHING
#ASSERT `s 1040(5) the company may register as the kind of company` (JUST FALSE) `s 1040(3) as a company limited by guarantee` EQUALS NOTHING
#ASSERT `s 1040(5) the company may register as the kind of company` (JUST TRUE) `s 1040(3) as a company limited by shares` EQUALS NOTHING
#ASSERT `s 1040(5) the company may register as the kind of company` NOTHING `s 1040(3) as a company limited by shares` EQUALS NOTHING
-- (6) not invalid by reason of a view to winding up
#ASSERT `s 1040(6) the registration is invalid by reason that it has taken place with a view to the company's being wound up` TRUE EQUALS JUST FALSE
#ASSERT `s 1040(6) the registration is invalid by reason that it has taken place with a view to the company's being wound up` FALSE EQUALS NOTHING

§§ `s 1041 Definition of "joint stock company"`

-- (1) args: permanent paid-up or nominal share capital of fixed amount; divided into shares of fixed amount, or stock, or both; formed on the principle that the members are the holders of the shares or stock and no other persons
#ASSERT `s 1041(1) the company is a joint stock company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1041(1) the company is a joint stock company` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1041(1) the company is a joint stock company` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1041(1) the company is a joint stock company` TRUE TRUE FALSE EQUALS JUST FALSE
-- (2) args: the (1) answer; registered with limited liability under this Act
#ASSERT `s 1041(2) the company is deemed a company limited by shares` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1041(2) the company is deemed a company limited by shares` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1041(2) the company is deemed a company limited by shares` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1041(2) the company is deemed a company limited by shares` NOTHING TRUE EQUALS NOTHING

§§ `s 1042 Power to make provision by regulations`
-- Inert (reason 2: regulation-making power); nothing to test. See NOTES.md.

§§ `s 1043 Unregistered companies`

-- (1) args: incorporated in the UK; principal place of business in the UK; (a) incorporated or registered under a public general Act; (b) not formed to carry on a business for gain; (c) exempted by direction; (d) open-ended investment company; (e) protected cell company
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1043(1) section 1043 applies to the body` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1043(1) section 1043 applies to the body` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (4)(a) and (b): flat negatives
#ASSERT `s 1043(4)(a) section 1043 repeals or revokes in whole or in part an enactment, royal charter or other instrument constituting or regulating the body` EQUALS JUST FALSE
#ASSERT `s 1043(4)(b) section 1043 restricts the power of Her Majesty to grant a charter in lieu or supplementary to any such charter` EQUALS JUST FALSE
-- (4) the suspension; args: provisions applied by regulations; inconsistent
#ASSERT `s 1043(4) the operation of the enactment, charter or instrument is suspended` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1043(4) the operation of the enactment, charter or instrument is suspended` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1043(4) the operation of the enactment, charter or instrument is suspended` FALSE TRUE EQUALS NOTHING
-- (5) "specified" means specified in the regulations
#ASSERT `s 1043(5) the matter is specified for the purposes of section 1043` TRUE EQUALS JUST TRUE
#ASSERT `s 1043(5) the matter is specified for the purposes of section 1043` FALSE EQUALS JUST FALSE

