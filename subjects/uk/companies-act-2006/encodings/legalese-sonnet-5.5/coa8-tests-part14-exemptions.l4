IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part14-exemptions`

-- Tests of ss 374 to 379 (exemptions and minor definitions of Part 14). Every expected value was written from the text before the run.

-- s 374(3): "trade union" has the meaning given by the 1992 Act or the 1992 Northern Ireland Order (borrowed answers, supplied)
#ASSERT `s 374(3) the body is a trade union` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 374(3) the body is a trade union` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 374(3) the body is a trade union` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 374(3) the body is a trade union` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 374(3) the body is a trade union` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 374(3) the fund is a political fund` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 374(3) the fund is a political fund` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 374(3) the fund is a political fund` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 374(3) the fund is a political fund` NOTHING (JUST FALSE) EQUALS NOTHING

-- s 374(1): a donation to a trade union, other than a contribution to its political fund, is not a political donation
#ASSERT `s 374(1) the donation to the trade union is a political donation for the purposes of this Part` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 374(1) the donation to the trade union is a political donation for the purposes of this Part` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 374(1) the donation to the trade union is a political donation for the purposes of this Part` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 374(1) the donation to the trade union is a political donation for the purposes of this Part` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 374(1) the donation to the trade union is a political donation for the purposes of this Part` (JUST TRUE) NOTHING EQUALS NOTHING
-- s 374(2)
#ASSERT `s 374(2) the trade union is a political organisation for the purposes of section 365` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 374(2) the trade union is a political organisation for the purposes of section 365` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 374(2) the trade union is a political organisation for the purposes of section 365` NOTHING EQUALS NOTHING

-- s 375
#ASSERT `s 375(2) the organisation is a trade association` TRUE EQUALS JUST TRUE
#ASSERT `s 375(2) the organisation is a trade association` FALSE EQUALS JUST FALSE
#ASSERT `s 375(2) the part of the payment that is a subscription` 1000 0 EQUALS 1000
#ASSERT `s 375(2) the part of the payment that is a subscription` 1000 300 EQUALS 700
#ASSERT `s 375(2) the part of the payment that is a subscription` 1000 1000 EQUALS 0
#ASSERT `s 375(1) the subscription is a political donation for the purposes of this Part` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 375(1) the subscription is a political donation for the purposes of this Part` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 375(1) the subscription is a political donation for the purposes of this Part` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 375(1) the subscription is a political donation for the purposes of this Part` NOTHING TRUE EQUALS NOTHING

-- s 376
#ASSERT `s 376(2) the group is an all-party parliamentary group` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 376(2) the group is an all-party parliamentary group` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 376(2) the group is an all-party parliamentary group` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 376(1) the group is a political organisation for the purposes of this Part` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 376(1) the group is a political organisation for the purposes of this Part` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 376(1) the group is a political organisation for the purposes of this Part` NOTHING EQUALS NOTHING

-- s 377: exempt by order (the order is not among the sources: an input)
#ASSERT `s 377(1) authorisation under this Part is not needed for the political expenditure` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 377(1) authorisation under this Part is not needed for the political expenditure` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 377(1) authorisation under this Part is not needed for the political expenditure` NOTHING EQUALS NOTHING
#ASSERT `s 377(3) the amount of the expenditure counted in determining what a resolution authorises` 20000 5000 EQUALS 15000
#ASSERT `s 377(3) the amount of the expenditure counted in determining what a resolution authorises` 20000 20000 EQUALS 0
#ASSERT `s 377(3) the amount of the expenditure counted in determining what a resolution authorises` 20000 0 EQUALS 20000

-- s 378: the limit is £5,000 in any period of 12 months
#ASSERT `s 378(1) the limit on donations in twelve months, in pounds` EQUALS 5000
#ASSERT `s 378(2) the payment is a donation for the purposes of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 378(2) the payment is a donation for the purposes of this section` FALSE EQUALS JUST FALSE
-- (a) a company that is not a subsidiary: its own and its subsidiaries' other donations count; (b) a subsidiary: also its holding companies' and the other subsidiaries of those
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST FALSE) `s 378(2) the company itself` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST FALSE) `s 378(2) a subsidiary of the company` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST FALSE) `s 378(2) a holding company of the company` EQUALS JUST FALSE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST FALSE) `s 378(2) another subsidiary of a holding company of the company` EQUALS JUST FALSE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST FALSE) `s 378(2) none of those` EQUALS JUST FALSE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST TRUE) `s 378(2) the company itself` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST TRUE) `s 378(2) a holding company of the company` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST TRUE) `s 378(2) another subsidiary of a holding company of the company` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` (JUST TRUE) `s 378(2) none of those` EQUALS JUST FALSE
#ASSERT `s 378(2) the other donation is an other relevant donation` NOTHING `s 378(2) a holding company of the company` EQUALS NOTHING
#ASSERT `s 378(2) the other donation is an other relevant donation` NOTHING `s 378(2) the company itself` EQUALS JUST TRUE
#ASSERT `s 378(2) the other donation is an other relevant donation` NOTHING `s 378(2) none of those` EQUALS JUST FALSE
-- the twelve months ending with 15 June 2026 begin on 16 June 2025
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 16 6 2025) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 15 6 2025) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
-- the twelve months ending with 29 February 2024 begin on 1 March 2023
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 1 3 2023) (Date 29 2 2024) EQUALS JUST TRUE
#ASSERT `s 378(1)(b) the other donation falls in the period of 12 months ending with the date of this donation` (Date 28 2 2023) (Date 29 2 2024) EQUALS JUST FALSE
-- the amount: authorisation is needed only to the extent the total exceeds £5,000
#ASSERT `s 378(1) the part of this donation for which authorisation is needed` 5000 0 EQUALS 0
#ASSERT `s 378(1) the part of this donation for which authorisation is needed` 5001 0 EQUALS 1
#ASSERT `s 378(1) the part of this donation for which authorisation is needed` 2000 4000 EQUALS 1000
#ASSERT `s 378(1) the part of this donation for which authorisation is needed` 2000 6000 EQUALS 2000
#ASSERT `s 378(1) the part of this donation for which authorisation is needed` 2000 3000 EQUALS 0
#ASSERT `s 378(1) authorisation is not needed for the whole of this donation` 2000 3000 EQUALS JUST TRUE
#ASSERT `s 378(1) authorisation is not needed for the whole of this donation` 2000 3001 EQUALS NOTHING
#ASSERT `s 378(3) the amount of this donation counted in determining what a resolution authorises` 2000 4000 EQUALS 1000
#ASSERT `s 378(3) the amount of this donation counted in determining what a resolution authorises` 2000 3000 EQUALS 0

