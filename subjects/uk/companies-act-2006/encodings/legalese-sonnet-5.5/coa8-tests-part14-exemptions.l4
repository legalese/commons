#ASSERT `s 379(1) the body is an organisation for the purposes of this Part` `a body corporate incorporated outside the United Kingdom` FALSE EQUALS JUST TRUE
#ASSERT `s 379(1) the body is an organisation for the purposes of this Part` `an unincorporated association` FALSE EQUALS JUST TRUE
