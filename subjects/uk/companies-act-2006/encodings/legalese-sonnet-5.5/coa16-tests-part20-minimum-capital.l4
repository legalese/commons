IMPORT prelude
IMPORT daydate
IMPORT `coa16-part20-minimum-capital`

-- coa16-tests-part20-minimum-capital.l4: tests for coa16-part20-minimum-capital.l4 (ss 761 to 767).
-- Every expected value is written from the text beside the assertion, never from the code's output.
-- #TRACE results are read by hand (an assertion cannot compare a DEONTIC); each trace carries its expected result.
-- The euro equivalent, an order's substituted amount and the spot rates below are made-up test inputs: the Act states none of them.

-- ---- s 763: the authorised minimum -------------------------------------------------------------------------------------
-- (1)(a) "£50,000"
#ASSERT `s 763(1)(a) the sterling amount of the authorised minimum` EQUALS 50000
-- (6) subject to any order under s 764: none, or an order substituting a sterling amount
#ASSERT `s 763(6) the sterling amount of the authorised minimum, subject to any order under section 764` NOTHING EQUALS 50000
#ASSERT `s 763(6) the sterling amount of the authorised minimum, subject to any order under section 764` (JUST 75000) EQUALS 75000
-- (1) in sterling the sterling amount; in euros the prescribed euro equivalent (a test value); in another currency the text states none
#ASSERT `s 763(1) the authorised minimum in the currency` `s 765 sterling` NOTHING 60000 EQUALS JUST 50000
#ASSERT `s 763(1) the authorised minimum in the currency` `s 765 sterling` (JUST 100000) 60000 EQUALS JUST 100000
#ASSERT `s 763(1) the authorised minimum in the currency` `s 765 euros` NOTHING 60000 EQUALS JUST 60000
#ASSERT `s 763(1) the authorised minimum in the currency` `s 765 another currency` NOTHING 60000 EQUALS NOTHING
-- (4) "applying an appropriate spot rate of exchange to the sterling amount and rounding to the nearest 100 euros"
-- 50,000 x 1.1423 = 57,115, nearest 100 is 57,100; x 1.1426 = 57,130, nearest 100 is 57,100; x 1.1451 = 57,255, nearest 100 is 57,300
#ASSERT `s 763(4) the euro amount prescribed for a spot rate` 50000 1.1423 EQUALS 57100
#ASSERT `s 763(4) the euro amount prescribed for a spot rate` 50000 1.1426 EQUALS 57100
#ASSERT `s 763(4) the euro amount prescribed for a spot rate` 50000 1.1451 EQUALS 57300
-- an amount that needs no rounding
#ASSERT `s 763(4) the euro amount prescribed for a spot rate` 50000 1.14 EQUALS 57000
-- a tie (57,250): the text does not say; half rounds up (assumed, fork F19)
#ASSERT `s 763(4) the euro amount prescribed for a spot rate` 50000 1.145 EQUALS 57300

-- ---- s 764(2): the same, for an altered sterling amount ------------------------------------------------------------------------
-- 60,000 x 1.1423 = 68,538, nearest 100 is 68,500
#ASSERT `s 764(2) the euro amount prescribed for a spot rate` 60000 1.1423 EQUALS 68500
-- (3)(a) an order that increases the authorised minimum may require a public company below the new amount to increase its capital or re-register as private
#ASSERT `s 764(3)(a) the order may require the company to increase its capital or re-register as a private company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 764(3)(a) the order may require the company to increase its capital or re-register as a private company` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 764(3)(a) the order may require the company to increase its capital or re-register as a private company` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 764(3)(a) the order may require the company to increase its capital or re-register as a private company` TRUE TRUE FALSE EQUALS NOTHING

-- ---- s 761(3): shares allotted under an employees' share scheme ----------------------------------------------------------------
-- share fields in order: currency, nominal value, allotted under an employees' share scheme, amount paid up, premium, premium paid
-- paid up as to exactly one-quarter of the nominal value, no premium: taken into account ("at least one-quarter")
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 25, 0, 0) EQUALS JUST TRUE
-- just under one-quarter
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 24, 0, 0) EQUALS JUST FALSE
-- a premium of 10, the whole of it paid
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 25, 10, 10) EQUALS JUST TRUE
-- a premium of 10, 9 paid: "the whole of any premium"
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 25, 10, 9) EQUALS JUST FALSE
-- fully paid with its premium
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 100, 5, 5) EQUALS JUST TRUE
-- not a scheme share: subsection (3) says nothing of it
#ASSERT `s 761(3) the scheme share is taken into account` (`s 761(3) allotted share` OF `s 765 sterling`, 100, FALSE, 0, 0, 0) EQUALS NOTHING
-- which shares count towards the nominal value of the allotted share capital
#ASSERT `s 761(2) the share counts towards the nominal value of the allotted share capital` (`s 761(3) allotted share` OF `s 765 sterling`, 100, FALSE, 0, 0, 0) EQUALS TRUE
#ASSERT `s 761(2) the share counts towards the nominal value of the allotted share capital` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 25, 0, 0) EQUALS TRUE
#ASSERT `s 761(2) the share counts towards the nominal value of the allotted share capital` (`s 761(3) allotted share` OF `s 765 sterling`, 100, TRUE, 24, 0, 0) EQUALS FALSE

-- ---- s 765(3): only sterling or euro share capital counts, and each currency on its own ------------------------------------------------
-- 30,000 and 20,000 sterling (ordinary), 5,000 euros, 99,000 in another currency, a scheme share of 10,000 sterling paid up as to 0
#ASSERT `s 765(3) the nominal value of the allotted share capital that counts in the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 30000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 20000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 5000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 another currency`, 99000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 10000, TRUE, 0, 0, 0)) `s 765 sterling` EQUALS 50000
#ASSERT `s 765(3) the nominal value of the allotted share capital that counts in the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 30000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 20000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 5000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 another currency`, 99000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 10000, TRUE, 0, 0, 0)) `s 765 euros` EQUALS 5000
-- the same scheme share, fully paid up: counts
#ASSERT `s 765(3) the nominal value of the allotted share capital that counts in the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 30000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 10000, TRUE, 10000, 0, 0)) `s 765 sterling` EQUALS 40000
-- no shares
#ASSERT `s 765(3) the nominal value of the allotted share capital that counts in the currency` EMPTY `s 765 sterling` EQUALS 0

-- ---- s 765(1): the initial requirement ------------------------------------------------------------------------------------------------
-- sterling share capital of exactly the sterling amount (50,000)
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST TRUE
-- one pound short
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 49999, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST FALSE
-- an order under section 764 has raised the sterling amount to 60,000
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0)) `s 765 sterling` (JUST 60000) 60000 EQUALS JUST FALSE
-- euro share capital of exactly the prescribed euro equivalent (60,000, a test value)
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 euros`, 60000, FALSE, 0, 0, 0)) `s 765 euros` NOTHING 60000 EQUALS JUST TRUE
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 euros`, 59999, FALSE, 0, 0, 0)) `s 765 euros` NOTHING 60000 EQUALS JUST FALSE
-- "but not partly in one and partly in the other": 30,000 pounds and 30,000 euros meet neither
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 30000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 30000, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST FALSE
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 30000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 30000, FALSE, 0, 0, 0)) `s 765 euros` NOTHING 60000 EQUALS JUST FALSE
-- share capital in another currency is not taken into account, and is not a currency to elect
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 another currency`, 900000, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST FALSE
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 another currency`, 900000, FALSE, 0, 0, 0)) `s 765 another currency` NOTHING 60000 EQUALS JUST FALSE
-- scheme shares not paid up enough are left out
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 40000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 10000, TRUE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST FALSE
#ASSERT `s 765(1) the initial requirement is met by reference to the currency` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 40000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 sterling`, 10000, TRUE, 2500, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST TRUE

-- ---- s 765(4): the election -------------------------------------------------------------------------------------------------------------------
-- capital that could meet the requirement in either currency (50,000 pounds, 60,000 euros, as the test euro equivalent is 60,000)
#ASSERT `s 765(4) the company has made the election the subsection requires` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 60000, FALSE, 0, 0, 0)) NOTHING 60000 TRUE EQUALS JUST TRUE
#ASSERT `s 765(4) the company has made the election the subsection requires` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0), (`s 761(3) allotted share` OF `s 765 euros`, 60000, FALSE, 0, 0, 0)) NOTHING 60000 FALSE EQUALS JUST FALSE
-- capital that could meet it in sterling only: no election is required
#ASSERT `s 765(4) the company has made the election the subsection requires` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0)) NOTHING 60000 FALSE EQUALS NOTHING
-- in euros only
#ASSERT `s 765(4) the company has made the election the subsection requires` (LIST (`s 761(3) allotted share` OF `s 765 euros`, 60000, FALSE, 0, 0, 0)) NOTHING 60000 FALSE EQUALS NOTHING
-- in neither
#ASSERT `s 765(4) the company has made the election the subsection requires` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 10, FALSE, 0, 0, 0)) NOTHING 60000 TRUE EQUALS NOTHING

-- ---- s 761(2): the requirement and the registrar's duty -----------------------------------------------------------------------------------
-- the company elects sterling
#ASSERT `s 761(2) the nominal value of the company's allotted share capital is not less than the authorised minimum` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 50000, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST TRUE
#ASSERT `s 761(2) the nominal value of the company's allotted share capital is not less than the authorised minimum` (LIST (`s 761(3) allotted share` OF `s 765 sterling`, 49999, FALSE, 0, 0, 0)) `s 765 sterling` NOTHING 60000 EQUALS JUST FALSE
-- the company elects euros
#ASSERT `s 761(2) the nominal value of the company's allotted share capital is not less than the authorised minimum` (LIST (`s 761(3) allotted share` OF `s 765 euros`, 60000, FALSE, 0, 0, 0)) `s 765 euros` NOTHING 60000 EQUALS JUST TRUE
-- application in accordance with section 762 and the registrar satisfied
#ASSERT `s 761(2) the registrar shall issue a trading certificate` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 761(2) the registrar shall issue a trading certificate` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 761(2) the registrar shall issue a trading certificate` FALSE TRUE EQUALS JUST FALSE
-- the duty as a regulative rule: issued on day 5: expected FULFILLED; nothing done: expected the standing obligation; no duty: expected FULFILLED
#TRACE `s 761(2) the registrar must issue the trading certificate` (JUST TRUE) AT 0 WITH
    PARTY Registrar DOES `s 761 issue the company with a trading certificate` AT 5
#TRACE `s 761(2) the registrar must issue the trading certificate` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 30)
#TRACE `s 761(2) the registrar must issue the trading certificate` (JUST FALSE) AT 0 WITH
    (WAITUNTIL 30)

-- ---- s 761(1): the bar ----------------------------------------------------------------------------------------------------------------------------
-- Company profile: place, liability of the members, a share capital, certificate states it is a public company; then the s 4(2)(b) fact,
-- public by virtue of re-registration, certificate issued by the registrar
-- a public company limited by shares, not by re-registration, no trading certificate: barred
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
-- a public company limited by guarantee with a share capital
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF Scotland, `liability limited to the amount the members undertake to contribute on a winding up`, TRUE, TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
-- with a trading certificate: "unless the registrar has issued it with a certificate"
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
-- public by virtue of re-registration: "otherwise than by virtue of re-registration" leaves it out
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE TRUE FALSE EQUALS NOTHING
-- a private company
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, FALSE) FALSE FALSE FALSE EQUALS NOTHING
-- a company whose certificate says it is public but whose registration requirements were not complied with is not public (s 4(2)(b))
#ASSERT `s 761(1) the company is barred from doing business or exercising any borrowing powers` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) FALSE FALSE FALSE EQUALS NOTHING
-- the bar as a regulative rule: barred, does business on day 5: expected DEONTIC BREACHED
#TRACE `s 761(1) the company must not do business or exercise borrowing powers` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 761 do business` AT 5
-- barred, exercises a borrowing power on day 5: expected DEONTIC BREACHED
#TRACE `s 761(1) the company must not do business or exercise borrowing powers` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 761 exercise a borrowing power` AT 5
-- barred, does nothing: expected the standing prohibition
#TRACE `s 761(1) the company must not do business or exercise borrowing powers` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 300)
-- not barred (certificate issued): expected FULFILLED
#TRACE `s 761(1) the company must not do business or exercise borrowing powers` (JUST FALSE) AT 0 WITH
    PARTY Company DOES `s 761 do business` AT 5
-- a company the bar does not govern: expected FULFILLED
#TRACE `s 761(1) the company must not do business or exercise borrowing powers` NOTHING AT 0 WITH
    PARTY Company DOES `s 761 do business` AT 5

-- ---- s 761(4): the effect of the certificate -----------------------------------------------------------------------------------------------------
-- issued 1 May 2023: effective from that day
#ASSERT `s 761(4) the certificate is conclusive evidence that the company is entitled to do business and exercise any borrowing powers` (JUST (Date 1 5 2023)) (Date 1 5 2023) EQUALS JUST TRUE
#ASSERT `s 761(4) the certificate is conclusive evidence that the company is entitled to do business and exercise any borrowing powers` (JUST (Date 1 5 2023)) (Date 2 5 2023) EQUALS JUST TRUE
#ASSERT `s 761(4) the certificate is conclusive evidence that the company is entitled to do business and exercise any borrowing powers` (JUST (Date 1 5 2023)) (Date 30 4 2023) EQUALS JUST FALSE
-- no certificate issued
#ASSERT `s 761(4) the certificate is conclusive evidence that the company is entitled to do business and exercise any borrowing powers` NOTHING (Date 1 5 2023) EQUALS NOTHING

-- ---- s 762: the application ---------------------------------------------------------------------------------------------------------------------------
#ASSERT `s 762(1) the application is made in accordance with section 762` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 762(1) the application is made in accordance with section 762` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 762(1) the application is made in accordance with section 762` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 762(1) the application is made in accordance with section 762` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 762(1) the application is made in accordance with section 762` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 762(1) the application is made in accordance with section 762` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 762(2) the statement is the statement of compliance` TRUE EQUALS JUST TRUE
#ASSERT `s 762(2) the statement is the statement of compliance` FALSE EQUALS JUST FALSE
#ASSERT `s 762(3) the registrar may accept the statement of compliance as sufficient evidence of the matters stated in it` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 762(3) the registrar may accept the statement of compliance as sufficient evidence of the matters stated in it` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 762(3) the registrar may accept the statement of compliance as sufficient evidence of the matters stated in it` NOTHING EQUALS NOTHING

-- ---- s 767: the offence --------------------------------------------------------------------------------------------------------------------------------
-- a public company (not by re-registration), no trading certificate, doing business
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE TRUE `s 767(1) the company` EQUALS JUST TRUE
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE TRUE (`s 767(1) an officer of the company` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE TRUE (`s 767(1) an officer of the company` (JUST FALSE)) EQUALS NOTHING
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE TRUE (`s 767(1) an officer of the company` NOTHING) EQUALS NOTHING
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE TRUE `s 767(1) another person` EQUALS NOTHING
-- no business done and no borrowing power exercised
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE FALSE FALSE `s 767(1) the company` EQUALS JUST FALSE
-- a trading certificate has been issued: no contravention of section 761
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE FALSE TRUE TRUE `s 767(1) the company` EQUALS JUST FALSE
-- public by virtue of re-registration, or a private company: section 761 does not govern the company
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, TRUE) TRUE TRUE FALSE TRUE `s 767(1) the company` EQUALS NOTHING
#ASSERT `s 767(1) the person commits an offence` (`Company profile` OF `England and Wales`, `liability limited to the amount, if any, unpaid on the shares held`, TRUE, FALSE) FALSE FALSE FALSE TRUE `s 767(1) the company` EQUALS NOTHING
-- (2) the penalties: on indictment a fine; on summary conviction a fine not exceeding the statutory maximum
#ASSERT `s 767(2) the penalty for the offence` `on conviction on indictment` EQUALS Penalty OF `on conviction on indictment`, NOTHING, (JUST `a fine without a stated limit`), NOTHING, FALSE
#ASSERT `s 767(2) the penalty for the offence` `on summary conviction` EQUALS Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, FALSE
#ASSERT `s 767(2) the penalty for the offence` `on summary conviction in Scotland` EQUALS Penalty OF `on summary conviction in Scotland`, NOTHING, (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, FALSE
-- (3) the validity of the transaction is not affected
#ASSERT `s 767(3) the contravention of section 761 affects the validity of the transaction` TRUE EQUALS JUST FALSE
#ASSERT `s 767(3) the contravention of section 761 affects the validity of the transaction` FALSE EQUALS NOTHING
-- (3) the directors' liability: a transaction in contravention, the company has complied, the days from being called on (to compliance, or to now)
-- not complied on day 22: failed within 21 days
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` TRUE FALSE 22 EQUALS JUST TRUE
-- not complied and still on day 21: the last day of the period
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` TRUE FALSE 21 EQUALS NOTHING
-- complied on day 21: in time
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` TRUE TRUE 21 EQUALS JUST FALSE
-- complied on day 22: late
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` TRUE TRUE 22 EQUALS JUST TRUE
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` TRUE FALSE 30 EQUALS JUST TRUE
-- the transaction was not in contravention of section 761
#ASSERT `s 767(3) the directors are jointly and severally liable to indemnify the other party to the transaction` FALSE FALSE 30 EQUALS JUST FALSE
-- the directors' liability as a regulative rule (day 0 = the day the company is called on)
-- complied on day 21: expected FULFILLED
#TRACE `s 767(3) the company must comply with its obligations, failing which the directors must indemnify` TRUE AT 0 WITH
    PARTY Company DOES `s 767 comply with the obligations in connection with the transaction` AT 21
-- complied on day 22: expected the directors' standing obligation to indemnify (the company's duty was breached; its LEST chain moves on)
#TRACE `s 767(3) the company must comply with its obligations, failing which the directors must indemnify` TRUE AT 0 WITH
    (WAITUNTIL 22)
-- the company fails and the directors indemnify on day 30: expected FULFILLED
#TRACE `s 767(3) the company must comply with its obligations, failing which the directors must indemnify` TRUE AT 0 WITH
    (WAITUNTIL 22)
    PARTY Director DOES `s 767 indemnify the other party to the transaction` AT 30
-- no transaction in contravention: expected FULFILLED
#TRACE `s 767(3) the company must comply with its obligations, failing which the directors must indemnify` FALSE AT 0 WITH
    (WAITUNTIL 300)
-- (4) which directors
#ASSERT `s 767(4) the person is one of the directors who are liable` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 767(4) the person is one of the directors who are liable` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 767(4) the person is one of the directors who are liable` NOTHING EQUALS NOTHING

-- (3) with (4): a director's liability.  Arguments: a transaction in contravention, the company complied, the days, was a director then (s 250)
-- a director then, the company failed within 21 days
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE FALSE 22 (JUST TRUE) EQUALS JUST TRUE
-- not a director then: outside the class, however the company behaved
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE FALSE 22 (JUST FALSE) EQUALS JUST FALSE
-- a director then, but the company complied in time
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE TRUE 21 (JUST TRUE) EQUALS JUST FALSE
-- a director then, the 21 days not yet up
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE FALSE 21 (JUST TRUE) EQUALS NOTHING
-- whether the person was a director is not known: liable only if subsection (3) is met, which it is not when the company complied in time
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE FALSE 22 NOTHING EQUALS NOTHING
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` TRUE TRUE 21 NOTHING EQUALS JUST FALSE
-- no transaction in contravention of section 761
#ASSERT `s 767(4) the director is liable to indemnify the other party to the transaction` FALSE FALSE 30 (JUST TRUE) EQUALS JUST FALSE
