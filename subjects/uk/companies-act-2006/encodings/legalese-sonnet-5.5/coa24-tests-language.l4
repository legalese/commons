IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa24-language`

-- coa24-tests-language.l4: tests for ss 1102 to 1110 (coa24-language.l4). Expected values decided from the text before the run.

§ `Tests for s 1102`

#ASSERT `s 1102(1) the language provisions apply to the document` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1102(1) the language provisions apply to the document` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1102(1) the language provisions apply to the document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1102(1) the language provisions apply to the document` FALSE FALSE EQUALS NOTHING
#ASSERT count (`s 1102(3) the provisions that apply under subsection (1)`) EQUALS 4
#ASSERT elem "section 1103 (documents to be drawn up and delivered in English)" (`s 1102(3) the provisions that apply under subsection (1)`)
#ASSERT elem "section 1104 (documents relating to Welsh companies)" (`s 1102(3) the provisions that apply under subsection (1)`)
#ASSERT elem "section 1105 (documents that may be drawn up and delivered in other languages)" (`s 1102(3) the provisions that apply under subsection (1)`)
#ASSERT elem "section 1107 (certified translations)" (`s 1102(3) the provisions that apply under subsection (1)`)
-- Section 1106 is not among the provisions listed in subsection (3).
#ASSERT (NOT (elem "section 1106 (voluntary filing of translations)" (`s 1102(3) the provisions that apply under subsection (1)`)))

§ `Tests for s 1103`

-- The general rule: English, subject to ss 1104 and 1105. Where an exception is made out the rule does not require English;
-- where none is made out (including where the exception sections give NOTHING) the general rule stands.
#ASSERT `s 1103 the document must be drawn up and delivered in English` NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 1103 the document must be drawn up and delivered in English` (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 1103 the document must be drawn up and delivered in English` NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1103 the document must be drawn up and delivered in English` (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 1103 the document must be drawn up and delivered in English` NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1103 the document must be drawn up and delivered in English` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1103 the document must be drawn up and delivered in English` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE

§ `Tests for s 1104`

#ASSERT `s 1104(1) the document may be drawn up and delivered in Welsh` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1104(1) the document may be drawn up and delivered in Welsh` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1104(1) the document may be drawn up and delivered in Welsh` NOTHING EQUALS NOTHING

-- (2): a Welsh document must be accompanied by a certified translation into English unless excepted by regulations or in a form prescribed in Welsh.
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` TRUE NOTHING TRUE EQUALS JUST FALSE
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 1104(2) the document must be accompanied by a certified translation into English` FALSE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 1104(2) the delivery meets the requirement of s 1104(2)` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1104(2) the delivery meets the requirement of s 1104(2)` TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1104(2) the delivery meets the requirement of s 1104(2)` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1104(2) the delivery meets the requirement of s 1104(2)` TRUE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1104(2) the delivery meets the requirement of s 1104(2)` TRUE NOTHING FALSE FALSE EQUALS NOTHING

-- (3): where properly delivered in Welsh without a translation, the registrar must obtain one if the document is to be available for inspection.
#ASSERT `s 1104(3) the registrar must obtain a translation into English` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1104(3) the registrar must obtain a translation into English` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1104(3) the registrar must obtain a translation into English` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1104(3) the translation is treated as delivered in accordance with the same provision as the original` TRUE EQUALS JUST TRUE
#ASSERT `s 1104(3) the translation is treated as delivered in accordance with the same provision as the original` FALSE EQUALS NOTHING

-- (4): a Welsh company may deliver a certified translation into Welsh of an English document.
#ASSERT `s 1104(4) the company may deliver a certified translation into Welsh of the document` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1104(4) the company may deliver a certified translation into Welsh of the document` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 1104(4) the company may deliver a certified translation into Welsh of the document` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1104(4) the company may deliver a certified translation into Welsh of the document` NOTHING TRUE EQUALS NOTHING

-- (5): section 1105 does not apply to a Welsh company's document drawn up and delivered in Welsh.
#ASSERT `s 1104(5) section 1105 applies to the document` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 1104(5) section 1105 applies to the document` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 1104(5) section 1105 applies to the document` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 1104(5) section 1105 applies to the document` NOTHING TRUE EQUALS NOTHING

§ `Tests for s 1105`

#ASSERT `s 1105(2) the section applies to the document` `s 1105(2)(a) an agreement required to be forwarded to the registrar under Chapter 3 of Part 3 (agreements affecting the company's constitution)` EQUALS JUST TRUE
#ASSERT `s 1105(2) the section applies to the document` `s 1105(2)(b) a document required to be delivered under section 400(2)(e) or section 401(2)(f) (company included in accounts of larger group: copy of group accounts)` EQUALS JUST TRUE
#ASSERT `s 1105(2) the section applies to the document` `s 1105(2)(c) a certified copy delivered under Part 25 (company charges)` EQUALS JUST TRUE
#ASSERT `s 1105(2) the section applies to the document` `s 1105(2)(d) a document of any other description specified in regulations made by the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 1105(2) the section applies to the document` `s 1105(2) another document` EQUALS NOTHING

#ASSERT `s 1105(1) the document may be drawn up and delivered in a language other than English` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1105(1) the document may be drawn up and delivered in a language other than English` NOTHING EQUALS NOTHING
#ASSERT `s 1105(1) the delivery meets the requirement of s 1105(1)` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1105(1) the delivery meets the requirement of s 1105(1)` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1105(1) the delivery meets the requirement of s 1105(1)` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 1105(1) the delivery meets the requirement of s 1105(1)` NOTHING TRUE FALSE EQUALS NOTHING

§ `Tests for s 1106`

#ASSERT `s 1106(1) the company may deliver certified translations of the document` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1106(1) the company may deliver certified translations of the document` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1106(1) the company may deliver certified translations of the document` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1106(1) the company may deliver certified translations of the document` FALSE (JUST TRUE) EQUALS NOTHING

-- (3): from 1 January 2007, in relation to all EU official languages and all documents subject to the Directive disclosure requirements.
#ASSERT `s 1106(3) the regulations must provide that the facility is available` (Date 1 1 2007) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1106(3) the regulations must provide that the facility is available` (Date 1 1 2007) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1106(3) the regulations must provide that the facility is available` (Date 15 6 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1106(3) the regulations must provide that the facility is available` (Date 31 12 2006) TRUE TRUE EQUALS NOTHING
#ASSERT `s 1106(3) the regulations must provide that the facility is available` (Date 1 1 2007) FALSE FALSE EQUALS NOTHING

#ASSERT `s 1106(4) the power of the registrar to impose requirements includes power to impose the requirement` `s 1106(4) the identification of the original document` EQUALS JUST TRUE
#ASSERT `s 1106(4) the power of the registrar to impose requirements includes power to impose the requirement` `s 1106(4) the delivery of the translation in a form and manner enabling it to be associated with the original` EQUALS JUST TRUE
#ASSERT `s 1106(4) the power of the registrar to impose requirements includes power to impose the requirement` `s 1106(4) some other requirement as to form and manner of delivery` EQUALS NOTHING

#ASSERT `s 1106(6) section 1106 applies` TRUE EQUALS JUST FALSE
#ASSERT `s 1106(6) section 1106 applies` FALSE EQUALS NOTHING

§ `Tests for s 1107`

#ASSERT `s 1107(1) the translation is a certified translation` TRUE EQUALS JUST TRUE
#ASSERT `s 1107(1) the translation is a certified translation` FALSE EQUALS JUST FALSE
-- (2)(a): in the case of a discrepancy the company may not rely on the translation as against a third party.
#ASSERT `s 1107(2)(a) the company may rely on the translation as against a third party` TRUE EQUALS JUST FALSE
#ASSERT `s 1107(2)(a) the company may rely on the translation as against a third party` FALSE EQUALS NOTHING
-- (2)(b): a third party may rely on it unless the company shows that the third party had knowledge of the original.
#ASSERT `s 1107(2)(b) the third party may rely on the translation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1107(2)(b) the third party may rely on the translation` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1107(2)(b) the third party may rely on the translation` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1107(2)(b) the third party may rely on the translation` FALSE TRUE EQUALS NOTHING
-- (3): a third party is a person other than the company or the registrar.
#ASSERT `s 1107(3) the person is a third party` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1107(3) the person is a third party` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1107(3) the person is a third party` FALSE TRUE EQUALS JUST FALSE

§ `Tests for ss 1108 and 1109`

#ASSERT `s 1108(1) the names and addresses meet the requirement of s 1108(1)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1108(1) the names and addresses meet the requirement of s 1108(1)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1108(1) the names and addresses meet the requirement of s 1108(1)` NOTHING EQUALS NOTHING

#ASSERT `s 1109(1) the company or other body may deliver a transliteration into Roman characters` TRUE EQUALS JUST TRUE
#ASSERT `s 1109(1) the company or other body may deliver a transliteration into Roman characters` FALSE EQUALS NOTHING
#ASSERT `s 1109(2) the power of the registrar to impose requirements includes power to impose the requirement` `s 1109(2) the identification of the original document` EQUALS JUST TRUE
#ASSERT `s 1109(2) the power of the registrar to impose requirements includes power to impose the requirement` `s 1109(2) the delivery of the transliteration in a form and manner enabling it to be associated with the original` EQUALS JUST TRUE
#ASSERT `s 1109(2) the power of the registrar to impose requirements includes power to impose the requirement` `s 1109(2) some other requirement as to form and manner of delivery` EQUALS NOTHING
