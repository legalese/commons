#ASSERT `s 1078(4)(b) the day the last statement of capital is treated as received by the registrar for the purposes of section 1077` FALSE (Date 5 5 2025) EQUALS NOTHING

-- s 1079(2): the five events; another event is not within the section
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2)(a) an amendment of the company's articles` EQUALS JUST TRUE
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2)(b) a change among the company's directors` EQUALS JUST TRUE
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2)(c) as regards service of any document on the company, a change of the company's registered office` EQUALS JUST TRUE
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2)(d) the making of a winding-up order in respect of the company` EQUALS JUST TRUE
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2)(e) the appointment of a liquidator in a voluntary winding up of the company` EQUALS JUST TRUE
#ASSERT `s 1079(2) the section applies to the event` `s 1079(2) another event` EQUALS JUST FALSE

-- s 1079(1): a company may not rely on an event unless it was officially notified at the material time or the company shows the person knew
