#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4)(c) the appointment of a liquidator in a voluntary winding up` TRUE EQUALS JUST TRUE
#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4)(c) the appointment of a liquidator in a voluntary winding up` FALSE EQUALS JUST FALSE
#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4) another event` TRUE EQUALS JUST FALSE

