#ASSERT `s 1077(2) the notice states what it must state` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1077(2) the notice states what it must state` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1077(2) the notice states what it must state` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
