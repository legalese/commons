#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 30 5 2025) (Date 16 6 2025) FALSE (Date 16 6 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 30 5 2025) (Date 17 6 2025) FALSE (Date 16 6 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 30 5 2025) (Date 16 6 2025) FALSE (Date 16 6 2025) FALSE EQUALS NOTHING
#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 2 6 2025) (Date 17 6 2025) TRUE (Date 18 6 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 2 6 2025) (Date 18 6 2025) TRUE (Date 18 6 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 1079(3) the company is barred from relying on the happening of the event against the person` (Date 2 6 2025) (Date 16 6 2025) TRUE (Date 18 6 2025) FALSE EQUALS NOTHING

-- s 1079(4): official notification means notification as the paragraph for the event requires; an event in none of the heads is not officially notified
#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4)(a) an amendment of the company's articles` TRUE EQUALS JUST TRUE
#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4)(a) an amendment of the company's articles` FALSE EQUALS JUST FALSE
#ASSERT `s 1079(4) the event has been officially notified` `s 1079(4)(b) anything else stated in an enhanced disclosure document` TRUE EQUALS JUST TRUE
