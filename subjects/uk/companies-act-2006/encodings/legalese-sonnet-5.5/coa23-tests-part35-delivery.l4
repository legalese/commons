#ASSERT `s 1073(5) the day counts as a day of default in complying with the requirements for proper delivery` TRUE (Date 1 3 2025) TRUE (Date 1 6 2025) FALSE (Date 16 6 2025) EQUALS JUST TRUE
#ASSERT `s 1073(5) the day counts as a day of default in complying with the requirements for proper delivery` TRUE (Date 1 3 2025) TRUE (Date 1 6 2025) FALSE (Date 20 9 2025) EQUALS JUST TRUE
