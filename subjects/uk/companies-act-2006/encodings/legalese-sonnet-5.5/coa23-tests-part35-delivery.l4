#ASSERT `s 1079(1) the company is barred from relying against the person on the happening of the event` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1079(1) the company is barred from relying against the person on the happening of the event` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1079(1) the company is barred from relying against the person on the happening of the event` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1079(1) the company is barred from relying against the person on the happening of the event` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 1079(1) the company is barred from relying against the person on the happening of the event` NOTHING FALSE FALSE EQUALS NOTHING

