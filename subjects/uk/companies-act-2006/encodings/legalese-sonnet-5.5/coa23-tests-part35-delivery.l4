IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa23-nouns`
IMPORT `coa23-part35-delivery`

-- coa23-tests-part35-delivery.l4: tests for coa23-part35-delivery.l4 (ss 1072 to 1079B). Every expected value is written
-- here from the text of the section named beside it, before the module was run; none is copied from its output.
-- A failing assertion would be a finding, not an edit to the expected value. A #TRACE cannot be asserted on this binary, so each is
-- preceded by an -- EXPECT: line that work/check-traces.py compares with the binary's output.


-- s 1072(1): not properly delivered unless ALL the requirements are met: any failing limb is a no; otherwise a limb that cannot be decided leaves it undecided; otherwise yes
#ASSERT `s 1072(1) all the requirements in the list are met` (LIST (JUST TRUE), (JUST TRUE), (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 1072(1) all the requirements in the list are met` (LIST (JUST TRUE), (JUST FALSE), (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 1072(1) all the requirements in the list are met` (LIST (JUST TRUE), NOTHING, (JUST TRUE)) EQUALS NOTHING
#ASSERT `s 1072(1) all the requirements in the list are met` (LIST NOTHING, (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 1072(1) all the requirements in the list are met` EMPTY EQUALS JUST TRUE

-- s 1072: the eleven limbs, in the order of the text: (a)(i), (a)(ii), (aa), (b) 1068, 1068A, 1070, (c) language, (d) characters, (e) section 1111, (f) section 1082, (g) fee
