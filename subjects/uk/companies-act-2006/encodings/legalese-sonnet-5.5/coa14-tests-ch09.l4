§§ `s 635`
-- an order made on 1 March 2023: the copy must be forwarded within 15 days, by 16 March 2023
-- s 635(1): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 635(1) the last day for the copy of the order` (Date 1 3 2023) EQUALS Date 16 3 2023
#ASSERT `s 635(1) the number of days allowed for the copy of the order` (Date 1 3 2023) EQUALS 15
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) (JUST (Date 16 3 2023)) (Date 16 3 2023) EQUALS JUST TRUE
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) (JUST (Date 1 3 2023)) (Date 16 3 2023) EQUALS JUST TRUE
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) (JUST (Date 17 3 2023)) (Date 17 3 2023) EQUALS JUST FALSE
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) (JUST (Date 28 2 2023)) (Date 17 3 2023) EQUALS NOTHING
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) NOTHING (Date 17 3 2023) EQUALS JUST FALSE
#ASSERT `s 635(1) the company forwarded a copy of the order to the registrar in time` (Date 1 3 2023) NOTHING (Date 16 3 2023) EQUALS NOTHING
-- a month after the 20 2 2023: the last day of a shorter month (the calendar month clamps)
#ASSERT `s 635(1) the last day for the copy of the order` (Date 20 2 2023) EQUALS Date 7 3 2023
-- the regulative duty: acting inside the period fulfils it, waiting past it is a breach (traces; a DEONTIC cannot be compared)
#TRACE `s 635(1) the company's duty to forward a copy of the order to the registrar` 15 AT 0 WITH
    PARTY Company DOES `Action of a party` Company Registrar "forward a copy of the order to the registrar" AT 15
#TRACE `s 635(1) the company's duty to forward a copy of the order to the registrar` 15 AT 0 WITH
    (WAITUNTIL 16)

-- s 635(2): default is made if any requirement is not met
#ASSERT `s 635(2) default is made in complying with this section` (LIST (JUST TRUE), (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 635(2) default is made in complying with this section` (LIST (JUST TRUE), (JUST TRUE)) EQUALS JUST FALSE
#ASSERT `s 635(2) default is made in complying with this section` (LIST (JUST TRUE), NOTHING) EQUALS NOTHING
#ASSERT `s 635(2) default is made in complying with this section` (LIST NOTHING, (JUST FALSE)) EQUALS JUST TRUE
-- s 635(2): an offence is committed by (a) the company, and (b) every officer who is in default
#ASSERT `s 635(2)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 635(2)(a) the company commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 635(2)(a) the company commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 635(2)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 635(2)(b) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 635(2)(b) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 635(2)(b) the officer commits an offence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 635(2)(b) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
-- s 635(3): liable on summary conviction to a fine not exceeding level 3 and, for continued contravention, a daily default fine not exceeding one-tenth of level 3
#ASSERT `s 635(3) the penalty for a person guilty of an offence under this section` TRUE EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, (JUST (`a fine not exceeding a level on the standard scale` 3 1)), (JUST (`a fine not exceeding a level on the standard scale` 3 0.1)), FALSE)
#ASSERT `s 635(3) the penalty for a person guilty of an offence under this section` FALSE EQUALS NOTHING


§§ `s 636`
-- a name assigned on 31 January 2024: one month later is 29 February 2024 (a leap year: the last day of the shorter month)
-- s 636(1): the last day, the days allowed, in-time cases (the last day counts; the day after does not; the day of the event counts)
#ASSERT `s 636(1) the last day for the notice` (Date 31 1 2024) EQUALS Date 29 2 2024
#ASSERT `s 636(1) the number of days allowed for the notice` (Date 31 1 2024) EQUALS 29
#ASSERT `s 636(1) the company delivered the notice to the registrar in time` (Date 31 1 2024) (JUST (Date 29 2 2024)) (Date 29 2 2024) EQUALS JUST TRUE
