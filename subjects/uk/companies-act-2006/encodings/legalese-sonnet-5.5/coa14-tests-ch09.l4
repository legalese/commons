#ASSERT `s 636(1) the company delivered the notice to the registrar in time` (Date 31 1 2024) (JUST (Date 30 1 2024)) (Date 1 3 2024) EQUALS NOTHING
#ASSERT `s 636(1) the company delivered the notice to the registrar in time` (Date 31 1 2024) NOTHING (Date 1 3 2024) EQUALS JUST FALSE
#ASSERT `s 636(1) the company delivered the notice to the registrar in time` (Date 31 1 2024) NOTHING (Date 29 2 2024) EQUALS NOTHING
