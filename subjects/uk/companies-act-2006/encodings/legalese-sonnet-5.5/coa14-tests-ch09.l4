IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa14-nouns`
IMPORT `coa14-ch09-classes`

-- coa14-tests-ch09.l4: tests for Chapter 9 (ss 629 to 640). EXPECTED VALUES ARE HAND-WRITTEN FROM THE TEXT, beside each
-- assertion or in the arguments of the generator line that makes a group of them. A failing assertion is a finding.

§ `Tests: Chapter 9 -- Classes of share and class rights`

§§ `s 629`
#ASSERT `s 629(1) the shares are of one class` TRUE EQUALS JUST TRUE
#ASSERT `s 629(1) the shares are of one class` FALSE EQUALS JUST FALSE
#ASSERT `s 629(2) the rights attached to the shares are regarded as different` TRUE EQUALS JUST FALSE
#ASSERT `s 629(2) the rights attached to the shares are regarded as different` FALSE EQUALS NOTHING
-- the seam name PLAN.md gives: uniform rights, or rights that differ only in the first twelve months' dividends, are one class
#ASSERT `s 629 the shares are of the same class` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 629 the shares are of the same class` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 629 the shares are of the same class` FALSE FALSE EQUALS JUST FALSE

§§ `s 630`
--  columns: articles contain provision, variation accords with it, s 630(4) consent given
#ASSERT `s 630(2) the rights attached to the class may be varied in this way` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 630(2) the rights attached to the class may be varied in this way` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 630(2) the rights attached to the class may be varied in this way` FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 630(2) the rights attached to the class may be varied in this way` FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 630(2) the rights attached to the class may be varied in this way` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 630(3) the variation is subject to another restriction` TRUE EQUALS JUST TRUE
#ASSERT `s 630(3) the variation is subject to another restriction` FALSE EQUALS NOTHING
-- (4)(a): consent in writing from the holders of at least three-quarters in nominal value of the issued shares, treasury shares excluded
--  columns: issued, of which treasury, consented in writing, separate general meeting, sanctions, s 283 answer
#ASSERT `s 630(4) the consent required is given` 1000 0 750 FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 630(4) the consent required is given` 1000 0 749 FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 630(4) the consent required is given` 1000 200 600 FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 630(4) the consent required is given` 1000 200 599 FALSE FALSE NOTHING EQUALS JUST FALSE
-- (4)(b): a special resolution passed at a separate general meeting of the holders of that class sanctioning the variation
#ASSERT `s 630(4) the consent required is given` 1000 0 0 TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 630(4) the consent required is given` 1000 0 0 TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 630(4) the consent required is given` 1000 0 0 TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 630(4) the consent required is given` 1000 0 0 FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 630(4) the consent required is given` 1000 0 0 TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- (a) met although the resolution is not special: still given
#ASSERT `s 630(4) the consent required is given` 1000 0 800 TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- no issued shares outside treasury: no three-quarters to take
#ASSERT `s 630(4) the consent required is given` 100 100 0 FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 630(5) the change is treated as a variation of those rights` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 630(5) the change is treated as a variation of those rights` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 630(5) the change is treated as a variation of those rights` FALSE FALSE EQUALS NOTHING
--  columns: variation, abrogation, reference is in a provision of the articles, context otherwise requires
#ASSERT `s 630(6) the act counts as a variation of the rights` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 630(6) the act counts as a variation of the rights` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 630(6) the act counts as a variation of the rights` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 630(6) the act counts as a variation of the rights` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 630(6) the act counts as a variation of the rights` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 630(6) the act counts as a variation of the rights` FALSE FALSE FALSE FALSE EQUALS NOTHING

