§§ `s 633`
#ASSERT `s 633(1) section 633 applies` TRUE EQUALS JUST TRUE
#ASSERT `s 633(1) section 633 applies` FALSE EQUALS JUST FALSE
-- (2) holders of not less in the aggregate than 15% of the issued shares of the class (treasury shares disregarded) who did not consent or vote in favour
--  columns: s 633(1) applies, issued shares of the class, of which treasury, shares held by the applicants, none of them consented or voted in favour
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 1000 0 150 TRUE EQUALS JUST TRUE
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 1000 0 149 TRUE EQUALS NOTHING
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 1000 200 120 TRUE EQUALS JUST TRUE
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 1000 200 119 TRUE EQUALS NOTHING
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 1000 0 500 FALSE EQUALS NOTHING
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST TRUE) 100 100 10 TRUE EQUALS NOTHING
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` (JUST FALSE) 1000 0 500 TRUE EQUALS JUST FALSE
#ASSERT `s 633(2) the holders may apply to the court to have the variation cancelled` NOTHING 1000 0 500 TRUE EQUALS NOTHING
-- (3) no effect unless and until confirmed
--  columns: an application has been made, the court has confirmed
#ASSERT `s 633(3) the variation is without effect unless and until the court confirms it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 633(3) the variation is without effect unless and until the court confirms it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 633(3) the variation is without effect unless and until the court confirms it` FALSE FALSE EQUALS JUST FALSE
-- (4)(a) within 21 days after the consent was given or the resolution was passed (1 March 2023: the last day is 22 March 2023)
#ASSERT `s 633(4)(a) the last day for the application` (Date 1 3 2023) EQUALS Date 22 3 2023
#ASSERT `s 633(4)(a) the application was made in time` (Date 1 3 2023) (Date 22 3 2023) EQUALS JUST TRUE
#ASSERT `s 633(4)(a) the application was made in time` (Date 1 3 2023) (Date 23 3 2023) EQUALS JUST FALSE
#ASSERT `s 633(4)(a) the application was made in time` (Date 1 3 2023) (Date 1 3 2023) EQUALS JUST TRUE
#ASSERT `s 633(4)(a) the application was made in time` (Date 1 3 2023) (Date 28 2 2023) EQUALS NOTHING
#ASSERT `s 633(4)(b) the application may be made on behalf of the shareholders entitled` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 633(4)(b) the application may be made on behalf of the shareholders entitled` TRUE FALSE EQUALS NOTHING
#ASSERT `s 633(4)(b) the application may be made on behalf of the shareholders entitled` FALSE TRUE EQUALS NOTHING
-- (5) the court
#ASSERT `s 633(5) the court shall confirm the variation` FALSE EQUALS JUST TRUE
#ASSERT `s 633(5) the court shall confirm the variation` TRUE EQUALS NOTHING
#ASSERT `s 633(5) the court may disallow the variation` TRUE EQUALS JUST TRUE
#ASSERT `s 633(5) the court may disallow the variation` FALSE EQUALS JUST FALSE
#ASSERT `s 633(5) the decision of the court is final` TRUE EQUALS JUST TRUE
#ASSERT `s 633(5) the decision of the court is final` FALSE EQUALS NOTHING
