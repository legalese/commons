#ASSERT `s 633(6) the act counts as a variation of the rights of holders of a class of shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 633(6) the act counts as a variation of the rights of holders of a class of shares` FALSE FALSE EQUALS NOTHING

