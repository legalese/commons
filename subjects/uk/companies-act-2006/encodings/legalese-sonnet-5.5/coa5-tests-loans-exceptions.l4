IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-loans-exceptions`

-- coa5-tests-loans-exceptions.l4: tests for ss 205 to 214 (coa5-loans-exceptions.l4).
-- Every expected value below was decided by reading the section's words, then written beside the assertion; none was copied from the code's output.

§ `Tests: s 205`

`s 205 test: defending proceedings` MEANS `s 205(1)(a)(i) provides funds to meet expenditure in defending criminal or civil proceedings`
`s 205 test: relief under section 661(3) or (4)` MEANS `s 205(1)(a)(ii) provides funds to meet expenditure in connection with an application for relief` `s 205(5) section 661(3) or (4)`
`s 205 test: relief under section 1157` MEANS `s 205(1)(a)(ii) provides funds to meet expenditure in connection with an application for relief` `s 205(5) section 1157`
`s 205 test: relief under some other provision` MEANS `s 205(1)(a)(ii) provides funds to meet expenditure in connection with an application for relief` `s 205(5) some other provision`
`s 205 test: avoiding expenditure` MEANS `s 205(1)(b) enables the director to avoid incurring such expenditure`

-- s 205(5): relief under s 661(3) or (4), or s 1157, and only those (a definition: "is to")
#ASSERT `s 205(5) the application is an application for relief` `s 205(5) section 661(3) or (4)` EQUALS JUST TRUE
#ASSERT `s 205(5) the application is an application for relief` `s 205(5) section 1157` EQUALS JUST TRUE
#ASSERT `s 205(5) the application is an application for relief` `s 205(5) some other provision` EQUALS JUST FALSE

-- s 205(3): not appealed against: the end of the period for bringing an appeal; appealed: when the appeal (or further appeal) is disposed of
#ASSERT `s 205(3) the date when the conviction, judgment or refusal of relief becomes final` FALSE (Date 10 3 2025) (Date 1 6 2025) EQUALS Date 10 3 2025
#ASSERT `s 205(3) the date when the conviction, judgment or refusal of relief becomes final` TRUE (Date 10 3 2025) (Date 1 6 2025) EQUALS Date 1 6 2025

-- s 205(4): disposed of if (a) determined and the period for any further appeal has ended, or (b) abandoned or otherwise ceases to have effect
#ASSERT `s 205(4) the appeal is disposed of` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(4) the appeal is disposed of` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205(4) the appeal is disposed of` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 205(4) the appeal is disposed of` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(4) the appeal is disposed of` FALSE FALSE FALSE EQUALS JUST FALSE

-- s 205(2): repayment required in the event, and not later than the date the event becomes final (the day itself is "not later than")
#ASSERT `s 205(2) the terms are met` TRUE (Date 10 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 205(2) the terms are met` TRUE (Date 9 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 205(2) the terms are met` TRUE (Date 11 3 2025) (Date 10 3 2025) EQUALS JUST FALSE
#ASSERT `s 205(2) the terms are met` FALSE (Date 1 3 2025) (Date 10 3 2025) EQUALS JUST FALSE

-- s 205(1): scope and "if it is done on the following terms"
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: defending proceedings` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: defending proceedings` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: defending proceedings` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: defending proceedings` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: relief under section 661(3) or (4)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: relief under section 1157` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: relief under some other provision` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: avoiding expenditure` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: avoiding expenditure` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205 test: avoiding expenditure` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 205(1) approval under sections 197, 198, 200 and 201 is not required by this section` `s 205(1) does something else` TRUE TRUE TRUE EQUALS NOTHING

§ `Tests: s 206`

#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206(a)(i) provides funds to meet expenditure in defending himself in an investigation by a regulatory authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206(a)(ii) provides funds to meet expenditure in defending himself against action proposed to be taken by a regulatory authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206(b) enables the director to avoid incurring such expenditure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206 does something else` TRUE TRUE EQUALS NOTHING
#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206(b) enables the director to avoid incurring such expenditure` FALSE TRUE EQUALS NOTHING
#ASSERT `s 206 approval under sections 197, 198, 200 and 201 is not required by this section` `s 206(b) enables the director to avoid incurring such expenditure` TRUE FALSE EQUALS NOTHING

§ `Tests: s 211 values and s 207`

`s 207 test: ten thousand` MEANS `s 211 a specific sum` 10_000
`s 207 test: five thousand` MEANS `s 211 a specific sum` 5_000
`s 207 test: five thousand and one` MEANS `s 211 a specific sum` 5_001
`s 207 test: fifteen thousand` MEANS `s 211 a specific sum` 15_000
`s 207 test: nought` MEANS `s 211 a specific sum` 0

-- s 211(7) the aggregate of two values against a sum (a deemed value exceeds any sum not above 50,000; above that the text is silent)
#ASSERT `s 211(7) the aggregate of the two values exceeds the sum` `s 207 test: five thousand` `s 207 test: five thousand` 10_000 EQUALS JUST FALSE
#ASSERT `s 211(7) the aggregate of the two values exceeds the sum` `s 207 test: five thousand` `s 207 test: five thousand and one` 10_000 EQUALS JUST TRUE
#ASSERT `s 211(7) the aggregate of the two values exceeds the sum` `s 211 deemed to exceed 50000 pounds` `s 207 test: nought` 15_000 EQUALS JUST TRUE
#ASSERT `s 211(7) the aggregate of the two values exceeds the sum` `s 207 test: nought` `s 211 deemed to exceed 50000 pounds` 50_000 EQUALS JUST TRUE
#ASSERT `s 211(7) the aggregate of the two values exceeds the sum` `s 211 deemed to exceed 50000 pounds` `s 207 test: nought` 50_001 EQUALS NOTHING

#ASSERT `s 207(1) the sum in pounds` EQUALS 10_000
#ASSERT `s 207(2) the sum in pounds` EQUALS 15_000

-- s 207(1): loans, quasi-loans and their guarantees or security: aggregate not above 10,000 pounds ("does not exceed")
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a loan` `s 207 test: five thousand` `s 207 test: five thousand` EQUALS JUST TRUE
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a loan` `s 207 test: five thousand` `s 207 test: five thousand and one` EQUALS JUST FALSE
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a quasi-loan` `s 207 test: ten thousand` `s 207 test: nought` EQUALS JUST TRUE
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a guarantee or security in connection with a loan or quasi-loan` `s 207 test: ten thousand` `s 207 test: five thousand` EQUALS JUST FALSE
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a loan` `s 211 deemed to exceed 50000 pounds` `s 207 test: nought` EQUALS JUST FALSE
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a credit transaction` `s 207 test: nought` `s 207 test: nought` EQUALS NOTHING
#ASSERT `s 207(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 another kind of transaction` `s 207 test: nought` `s 207 test: nought` EQUALS NOTHING

-- s 207(2): credit transactions and their guarantees or security: aggregate not above 15,000 pounds
#ASSERT `s 207(2) approval under section 201 is not required by this section` `s 207 a credit transaction` `s 207 test: fifteen thousand` `s 207 test: nought` EQUALS JUST TRUE
#ASSERT `s 207(2) approval under section 201 is not required by this section` `s 207 a credit transaction` `s 207 test: fifteen thousand` `s 207 test: five thousand and one` EQUALS JUST FALSE
#ASSERT `s 207(2) approval under section 201 is not required by this section` `s 207 a guarantee or security in connection with a credit transaction` `s 207 test: ten thousand` `s 207 test: five thousand` EQUALS JUST TRUE
#ASSERT `s 207(2) approval under section 201 is not required by this section` `s 207 a loan` `s 207 test: nought` `s 207 test: nought` EQUALS NOTHING

-- s 207(3): credit transactions in the ordinary course of business, value and terms no better than for an unconnected person
#ASSERT `s 207(3) approval under section 201 is not required by this section` `s 207 a credit transaction` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 207(3) approval under section 201 is not required by this section` `s 207 a credit transaction` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 207(3) approval under section 201 is not required by this section` `s 207 a credit transaction` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 207(3) approval under section 201 is not required by this section` `s 207 a guarantee or security in connection with a credit transaction` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 207(3) approval under section 201 is not required by this section` `s 207 a loan` TRUE TRUE TRUE EQUALS NOTHING

§ `Tests: s 208`

#ASSERT `s 208 approval is not required by this section` `s 208(1)(a) the making of a loan or quasi-loan to the other body corporate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 208 approval is not required by this section` `s 208(1)(b) a guarantee or security in connection with a loan or quasi-loan made to the other body corporate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 208 approval is not required by this section` `s 208(2)(a) a credit transaction entered into as creditor for the benefit of the other body corporate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 208 approval is not required by this section` `s 208(2)(b) a guarantee or security in connection with a credit transaction entered into by any person for the benefit of the other body corporate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 208 approval is not required by this section` `s 208(1)(a) the making of a loan or quasi-loan to the other body corporate` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 208 approval is not required by this section` `s 208(1)(a) the making of a loan or quasi-loan to the other body corporate` NOTHING EQUALS NOTHING
#ASSERT `s 208 approval is not required by this section` `s 208 another kind of transaction` (JUST TRUE) EQUALS NOTHING

§ `Tests: s 209`

-- s 209(2): money-lending company: ordinary business includes the making of loans or quasi-loans, or giving guarantees or security in connection with them
#ASSERT `s 209(2) the company is a money-lending company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 209(2) the company is a money-lending company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 209(2) the company is a money-lending company` FALSE FALSE EQUALS JUST FALSE

-- s 209(4): home loan: (a) purchase, (b) improvement, each for the borrower's only or main residence; (c) substitution; nothing else
#ASSERT `s 209(4) the loan is a home loan` `s 209(4)(a) purchase of the whole or part of a dwelling-house, with land to be occupied and enjoyed with it` TRUE EQUALS JUST TRUE
#ASSERT `s 209(4) the loan is a home loan` `s 209(4)(a) purchase of the whole or part of a dwelling-house, with land to be occupied and enjoyed with it` FALSE EQUALS JUST FALSE
#ASSERT `s 209(4) the loan is a home loan` `s 209(4)(b) improving a dwelling-house or part of one so used, or land occupied and enjoyed with it` TRUE EQUALS JUST TRUE
