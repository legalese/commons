#ASSERT `s 210(5) the transaction or arrangement is not a relevant transaction or arrangement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 210(5) the transaction or arrangement is not a relevant transaction or arrangement` FALSE FALSE EQUALS JUST FALSE

-- s 210(2): previously entered into or at the same time; conditions of (3) or (4) met; not excluded by (5)
#ASSERT `s 210(2) the other transaction or arrangement is a relevant transaction or arrangement` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 210(2) the other transaction or arrangement is a relevant transaction or arrangement` TRUE NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
