#ASSERT `s 209(4) the loan is a home loan` `s 209(4)(c) substitution for a loan made by any person and falling within paragraph (a) or (b)` FALSE EQUALS JUST TRUE
#ASSERT `s 209(4) the loan is a home loan` `s 209(4) some other purpose` TRUE EQUALS JUST FALSE

-- s 209(3): the condition in (1)(b) does not of itself prevent a home loan to a director or an employee, if ordinarily made and terms no more favourable
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(a) a director of the company or of its holding company` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(b) an employee of the company` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(b) an employee of the company` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(b) an employee of the company` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3) someone else` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(a) a director of the company or of its holding company` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 209(3) the condition in subsection (1)(b) does not of itself prevent the company from making the home loan` `s 209(3)(a) a director of the company or of its holding company` NOTHING TRUE TRUE EQUALS NOTHING

-- s 209(1): by a money-lending company, in the ordinary course of business, value and terms no better than for an unconnected person
#ASSERT `s 209(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a loan` (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 209(1) approval under sections 197, 198 and 200 is not required by this section` `s 207 a quasi-loan` (JUST TRUE) TRUE TRUE NOTHING EQUALS JUST TRUE
