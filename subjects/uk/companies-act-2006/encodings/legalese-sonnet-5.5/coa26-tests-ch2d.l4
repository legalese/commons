#ASSERT `s 1225E(4) the Secretary of State must now decide whether to impose a penalty and whether to reduce the proposed amount` FALSE EQUALS JUST FALSE
#ASSERT `s 1225E(5) the Secretary of State has given notice of the decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225E(5) the Secretary of State has given notice of the decision` TRUE FALSE EQUALS JUST FALSE
-- s 1225E(6). order: decides to impose, states imposed and amount, by that time satisfied, states why it appears (i), states why it appeared (ii), specifies a time for payment
#ASSERT `s 1225E(6) the penalty decision notice has the required content` TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1225E(6) the penalty decision notice has the required content` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225E(6) the penalty decision notice has the required content` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
