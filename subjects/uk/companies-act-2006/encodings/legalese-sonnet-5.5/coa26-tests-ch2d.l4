#ASSERT `s 1225E(2) the period specified under subsection (1)(c) is valid` TRUE 21 EQUALS JUST TRUE
#ASSERT `s 1225E(2) the period specified under subsection (1)(c) is valid` TRUE 20 EQUALS JUST FALSE
#ASSERT `s 1225E(2) the period specified under subsection (1)(c) is valid` FALSE 21 EQUALS JUST FALSE
#ASSERT `s 1225E(3) the Secretary of State has complied with the duty to consider the representations` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225E(3) the Secretary of State has complied with the duty to consider the representations` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225E(3) the Secretary of State has complied with the duty to consider the representations` FALSE TRUE EQUALS NOTHING
