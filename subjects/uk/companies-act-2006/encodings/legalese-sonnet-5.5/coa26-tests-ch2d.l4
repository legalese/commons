#ASSERT `s 1225E(9) the rescission of the penalty complies with subsection (9)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225E(9) the rescission of the penalty complies with subsection (9)` FALSE TRUE TRUE EQUALS NOTHING

-- s 1225F(2): the five grounds
#ASSERT `s 1225F(2) an appeal ground is made out` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(2) an appeal ground is made out` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(2) an appeal ground is made out` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(2) an appeal ground is made out` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(2) an appeal ground is made out` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1225F(2) an appeal ground is made out` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 1225F(1)
#ASSERT `s 1225F(1) the body may appeal to the court` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1225F(1) the body may appeal to the court` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1225F(1) the body may appeal to the court` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1225F(1) the body may appeal to the court` FALSE (JUST TRUE) EQUALS NOTHING
-- s 1225F(3): within the period of 3 months beginning with the day the notice is given (notice 10 January 2027: through 9 April 2027)
#ASSERT `s 1225F(3) the appeal is made in time` (Date 10 1 2027) (Date 10 1 2027) EQUALS JUST TRUE
#ASSERT `s 1225F(3) the appeal is made in time` (Date 10 1 2027) (Date 9 4 2027) EQUALS JUST TRUE
#ASSERT `s 1225F(3) the appeal is made in time` (Date 10 1 2027) (Date 10 4 2027) EQUALS JUST FALSE
#ASSERT `s 1225F(3) the appeal is made in time` (Date 10 1 2027) (Date 9 1 2027) EQUALS JUST FALSE
#ASSERT `s 1225F(3) the appeal is made in time` (Date 15 11 2026) (Date 14 2 2027) EQUALS JUST TRUE
#ASSERT `s 1225F(3) the appeal is made in time` (Date 15 11 2026) (Date 15 2 2027) EQUALS JUST FALSE
-- s 1225F(4). order: step, the court considers it appropriate, satisfied of a ground, the ground is the one in (2)(e)
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(a) quash the penalty` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(b) substitute a penalty of such lesser amount as the court considers appropriate` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(c) substitute a later time for the time specified in the notice` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(c) substitute a later time for the time specified in the notice` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(a) quash the penalty` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225F(4) the court may take the step` `s 1225F(4)(a) quash the penalty` TRUE FALSE FALSE EQUALS JUST FALSE
-- s 1225F(5)-(8)
#ASSERT `s 1225F(5) the court may require the payment of interest on the substituted penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 1225F(5) the court may require the payment of interest on the substituted penalty` FALSE EQUALS JUST FALSE
#ASSERT `s 1225F(6) the court may require the payment of interest on the penalty from the substituted time` TRUE EQUALS JUST TRUE
