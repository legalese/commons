-- s 1225F(9), (10)
#ASSERT `s 1225F(9) the validity of the penalty may be questioned in the legal proceedings` FALSE EQUALS JUST FALSE
#ASSERT `s 1225F(9) the validity of the penalty may be questioned in the legal proceedings` TRUE EQUALS NOTHING
#ASSERT `s 1225F(10) the court is` FALSE EQUALS `s 1225F(10) the High Court`
