IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa26-support`
IMPORT `coa26-ch2d`

-- Tests for coa26-ch2d.l4 (ss 1225-1225G). Expected values are written by hand from the text.

-- s 1225(1): any one of the four limbs
#ASSERT `s 1225(1) the section applies` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1225(1) the section applies` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1225(1) the section applies` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225(1) the section applies` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1225(1) the section applies` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 1225(2), (3)
#ASSERT `s 1225(2) the Secretary of State may do any one or more of the things in paragraphs (a) to (c)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1225(2) the Secretary of State may do any one or more of the things in paragraphs (a) to (c)` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1225(2) the Secretary of State may do any one or more of the things in paragraphs (a) to (c)` NOTHING EQUALS NOTHING
#ASSERT `s 1225(3) subsection (2) is without prejudice to the power` TRUE EQUALS JUST TRUE
#ASSERT `s 1225(3) subsection (2) is without prejudice to the power` FALSE EQUALS NOTHING

-- s 1225A
#ASSERT `s 1225A(1) the direction is a direction under section 1225A` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225A(1) the direction is a direction under section 1225A` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1225A(1) the direction is a direction under section 1225A` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1225A(2)(a) the direction may require the body to take the step` TRUE EQUALS JUST TRUE
#ASSERT `s 1225A(2)(a) the direction may require the body to take the step` FALSE EQUALS JUST FALSE
#ASSERT `s 1225A(2)(b) the direction may require the body to refrain from taking a particular course of action` TRUE EQUALS JUST TRUE
#ASSERT `s 1225A(2)(b) the direction may require the body to refrain from taking a particular course of action` FALSE EQUALS NOTHING
#ASSERT `s 1225A(3) the power to give the direction is subject to the provision of another enactment` TRUE EQUALS JUST TRUE
#ASSERT `s 1225A(3) the power to give the direction is subject to the provision of another enactment` FALSE EQUALS NOTHING
#ASSERT `s 1225A(4) the Secretary of State may take the step` TRUE EQUALS JUST TRUE
#ASSERT `s 1225A(4) the Secretary of State may take the step` FALSE EQUALS NOTHING

-- s 1225B
#ASSERT `s 1225B(1) the notice of proposed direction was given before the direction` TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(1) the notice of proposed direction was given before the direction` FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(2) the notice of proposed direction has the required content` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(2) the notice of proposed direction has the required content` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(2) the notice of proposed direction has the required content` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(2) the notice of proposed direction has the required content` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 1225B(3): not less than 14 days, beginning with the date of the notice. order: begins with the date, length in days
#ASSERT `s 1225B(3) the period specified under subsection (2)(c) is valid` TRUE 14 EQUALS JUST TRUE
#ASSERT `s 1225B(3) the period specified under subsection (2)(c) is valid` TRUE 13 EQUALS JUST FALSE
#ASSERT `s 1225B(3) the period specified under subsection (2)(c) is valid` TRUE 30 EQUALS JUST TRUE
#ASSERT `s 1225B(3) the period specified under subsection (2)(c) is valid` FALSE 14 EQUALS JUST FALSE
#ASSERT `s 1225B(4) the Secretary of State has complied with the duty to consider the representations` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(4) the Secretary of State has complied with the duty to consider the representations` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(4) the Secretary of State has complied with the duty to consider the representations` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1225B(5) the Secretary of State must now decide whether to give the proposed direction` TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(5) the Secretary of State must now decide whether to give the proposed direction` FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(6) the Secretary of State has given notice of the decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(6) the Secretary of State has given notice of the decision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(6) the Secretary of State has given notice of the decision` FALSE TRUE EQUALS JUST FALSE
-- s 1225B(7). order: decides to give, contains the direction, states the time it takes effect, specifies the reasons
#ASSERT `s 1225B(7) the direction decision notice has the required content` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(7) the direction decision notice has the required content` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(7) the direction decision notice has the required content` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(7) the direction decision notice has the required content` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(7) the direction decision notice has the required content` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(8) the Secretary of State has published the direction decision notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(8) the Secretary of State has published the direction decision notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(8) the Secretary of State has published the direction decision notice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(9) the revocation of the direction complies with subsection (9)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225B(9) the revocation of the direction complies with subsection (9)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1225B(9) the revocation of the direction complies with subsection (9)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225B(9) the revocation of the direction complies with subsection (9)` FALSE TRUE TRUE EQUALS NOTHING

-- s 1225C
#ASSERT `s 1225C(1) the court may order the body to take such steps as it considers will secure that the requirement is satisfied or the obligation is complied with` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225C(1) the court may order the body to take such steps as it considers will secure that the requirement is satisfied or the obligation is complied with` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1225C(1) the court may order the body to take such steps as it considers will secure that the requirement is satisfied or the obligation is complied with` FALSE TRUE EQUALS JUST FALSE
-- s 1225C(2). order: the obligation is to comply with a direction, requirement not satisfied, obligation not complied with
#ASSERT `s 1225C(2) the court may order compliance with the direction` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225C(2) the court may order compliance with the direction` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1225C(2) the court may order compliance with the direction` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1225C(2) the court may order compliance with the direction` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1225C(3) the court is` FALSE EQUALS `s 1225C(3) the High Court`
#ASSERT `s 1225C(3) the court is` TRUE EQUALS `s 1225C(3) the Court of Session`

-- s 1225D
#ASSERT `s 1225D(1) the amount is a lawful amount of financial penalty` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1225D(1) the amount is a lawful amount of financial penalty` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1225D(1) the amount is a lawful amount of financial penalty` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1225D(1) the amount is a lawful amount of financial penalty` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1225D(2) the Secretary of State has decided the amount in accordance with subsection (2)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1225D(2) the Secretary of State has decided the amount in accordance with subsection (2)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1225D(2) the Secretary of State has decided the amount in accordance with subsection (2)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1225D(3) the penalty is payable to the Secretary of State` TRUE EQUALS JUST TRUE
#ASSERT `s 1225D(3) the penalty is payable to the Secretary of State` FALSE EQUALS NOTHING
#ASSERT `s 1225D(4) the reference to a penalty in sections 1225E to 1225G is to the penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 1225D(4) the reference to a penalty in sections 1225E to 1225G is to the penalty` FALSE EQUALS JUST FALSE

-- s 1225E
#ASSERT `s 1225E(1) the notice of proposed penalty was given and has the required content` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1225E(1) the notice of proposed penalty was given and has the required content` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
