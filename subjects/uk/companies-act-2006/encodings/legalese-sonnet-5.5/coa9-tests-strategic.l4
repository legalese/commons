IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa9-penalties`
IMPORT `coa9-strategic`


-- Tests for coa9-strategic.l4 and coa9-penalties.l4. Every expected value was decided from the text of the
-- section named beside it before the code was run (lines 5418-5549 of ukpga-2006-46.txt).

-- ---- s 414D(3) and the pounds helper ------------------------------------------------------------------------
-- One-tenth of level 3 with level 3 at 1,000 pounds is 100 pounds; the pounds are inputs, not the Act's.
-- one-tenth of a level
#ASSERT (`s 414D(3) the most a fine limit allows in pounds` (`a fine not exceeding a level on the standard scale` 3 0.1) 5000 1000) EQUALS JUST 100
-- the statutory maximum itself
#ASSERT (`s 414D(3) the most a fine limit allows in pounds` (`a fine not exceeding the statutory maximum` 1) 5000 1000) EQUALS JUST 5000
-- half of it
#ASSERT (`s 414D(3) the most a fine limit allows in pounds` (`a fine not exceeding the statutory maximum` 0.5) 5000 1000) EQUALS JUST 2500
-- an amount in pounds
#ASSERT (`s 414D(3) the most a fine limit allows in pounds` (`a fine not exceeding an amount in pounds` 750) 5000 1000) EQUALS JUST 750
-- "to a fine" states no amount
#ASSERT (`s 414D(3) the most a fine limit allows in pounds` `a fine without a stated limit` 5000 1000) EQUALS NOTHING

-- ---- s 414C(2): both items are required ---------------------------------------------------------------------
-- (a) and (b) both present
#ASSERT (`s 414C(2) the strategic report contains the required items` TRUE TRUE) EQUALS JUST TRUE
-- (b) description of principal risks missing
#ASSERT (`s 414C(2) the strategic report contains the required items` TRUE FALSE) EQUALS JUST FALSE
-- (a) fair review missing
#ASSERT (`s 414C(2) the strategic report contains the required items` FALSE TRUE) EQUALS JUST FALSE
-- both missing
#ASSERT (`s 414C(2) the strategic report contains the required items` FALSE FALSE) EQUALS JUST FALSE

-- ---- s 414C(3): the review ------------------------------------------------------------------------------------
-- (a), (b), balanced and consistent with size
#ASSERT (`s 414C(3) the review is the required balanced and comprehensive analysis` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- (a) missing
#ASSERT (`s 414C(3) the review is the required balanced and comprehensive analysis` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- (b) missing
#ASSERT (`s 414C(3) the review is the required balanced and comprehensive analysis` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
-- not balanced and comprehensive
#ASSERT (`s 414C(3) the review is the required balanced and comprehensive analysis` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- not consistent with the size and complexity of the business
#ASSERT (`s 414C(3) the review is the required balanced and comprehensive analysis` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE

-- ---- s 414C(4) ------------------------------------------------------------------------------------------------
-- necessary for an understanding
#ASSERT (`s 414C(4)(a) the review must include analysis using financial key performance indicators` TRUE) EQUALS JUST TRUE
-- "to the extent necessary": outside the limit the text says nothing
#ASSERT (`s 414C(4)(a) the review must include analysis using financial key performance indicators` FALSE) EQUALS NOTHING
-- necessary and appropriate
#ASSERT (`s 414C(4)(b) the review must include analysis using other key performance indicators` TRUE TRUE) EQUALS JUST TRUE
-- appropriate but not necessary
#ASSERT (`s 414C(4)(b) the review must include analysis using other key performance indicators` FALSE TRUE) EQUALS NOTHING
-- "where appropriate" fails
#ASSERT (`s 414C(4)(b) the review must include analysis using other key performance indicators` TRUE FALSE) EQUALS JUST FALSE
-- "where appropriate" fails
#ASSERT (`s 414C(4)(b) the review must include analysis using other key performance indicators` FALSE FALSE) EQUALS JUST FALSE

-- ---- s 414C(5) ------------------------------------------------------------------------------------------------
-- "means factors by reference to which ... can be measured effectively"
#ASSERT (`s 414C(5) the factor is a key performance indicator` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 414C(5) the factor is a key performance indicator` FALSE) EQUALS JUST FALSE

-- ---- s 414C(6): medium-sized companies -----------------------------------------------------------------------
-- a medium-sized company need not comply as to non-financial information
#ASSERT (`s 414C(6) the review need not comply with subsection (4) so far as it relates to non-financial information` (JUST TRUE)) EQUALS JUST TRUE
-- "Where a company qualifies as medium-sized" fails
#ASSERT (`s 414C(6) the review need not comply with subsection (4) so far as it relates to non-financial information` (JUST FALSE)) EQUALS JUST FALSE
-- sections 465 to 467 not answered
#ASSERT (`s 414C(6) the review need not comply with subsection (4) so far as it relates to non-financial information` NOTHING) EQUALS NOTHING

-- ---- s 414C(7): quoted companies -----------------------------------------------------------------------------
-- quoted, necessary
#ASSERT (`s 414C(7) the strategic report of a quoted company must include the information` (JUST TRUE) TRUE `s 414C(7)(a) the main trends and factors likely to affect the future development, performance and position of the company's business`) EQUALS JUST TRUE
-- (b)(iii) is one of the kinds
#ASSERT (`s 414C(7) the strategic report of a quoted company must include the information` (JUST TRUE) TRUE `s 414C(7)(b)(iii) social, community and human rights issues`) EQUALS JUST TRUE
-- not necessary for an understanding
#ASSERT (`s 414C(7) the strategic report of a quoted company must include the information` (JUST TRUE) FALSE `s 414C(7)(b)(ii) the company's employees`) EQUALS NOTHING
-- "In the case of a quoted company": not quoted is outside the scope
#ASSERT (`s 414C(7) the strategic report of a quoted company must include the information` (JUST FALSE) TRUE `s 414C(7)(b)(i) environmental matters (including the impact of the company's business on the environment)`) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 414C(7) the strategic report of a quoted company must include the information` NOTHING TRUE `s 414C(7)(b)(i) environmental matters (including the impact of the company's business on the environment)`) EQUALS NOTHING
-- states the two kinds it lacks
#ASSERT (`s 414C(7) the kinds of information the report must state it does not contain` (JUST TRUE) FALSE TRUE FALSE) EQUALS JUST (LIST `s 414C(7)(b)(i) environmental matters (including the impact of the company's business on the environment)`, `s 414C(7)(b)(iii) social, community and human rights issues`)
-- the report contains all three kinds: nothing to state
#ASSERT (`s 414C(7) the kinds of information the report must state it does not contain` (JUST TRUE) TRUE TRUE TRUE) EQUALS JUST EMPTY
-- lacks all three
#ASSERT (`s 414C(7) the kinds of information the report must state it does not contain` (JUST TRUE) FALSE FALSE FALSE) EQUALS JUST (LIST `s 414C(7)(b)(i) environmental matters (including the impact of the company's business on the environment)`, `s 414C(7)(b)(ii) the company's employees`, `s 414C(7)(b)(iii) social, community and human rights issues`)
-- not a quoted company: the sentence is not addressed to it
#ASSERT (`s 414C(7) the kinds of information the report must state it does not contain` (JUST FALSE) FALSE FALSE FALSE) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 414C(7) the kinds of information the report must state it does not contain` NOTHING FALSE FALSE FALSE) EQUALS NOTHING

-- ---- s 414C(8) ------------------------------------------------------------------------------------------------
-- quoted company
#ASSERT (`s 414C(8) the strategic report of a quoted company must include the item` (JUST TRUE) `s 414C(8)(a) a description of the company's strategy`) EQUALS JUST TRUE
-- the breakdown by sex of employees
#ASSERT (`s 414C(8) the strategic report of a quoted company must include the item` (JUST TRUE) `s 414C(8)(c)(iii) the number of persons of each sex who were employees of the company`) EQUALS JUST TRUE
-- not a quoted company: scope limit
#ASSERT (`s 414C(8) the strategic report of a quoted company must include the item` (JUST FALSE) `s 414C(8)(b) a description of the company's business model`) EQUALS NOTHING
-- section 385 not answered
#ASSERT (`s 414C(8) the strategic report of a quoted company must include the item` NOTHING `s 414C(8)(b) a description of the company's business model`) EQUALS NOTHING
-- a senior manager who is not a director
#ASSERT (`s 414C(8)(c)(ii) the person is counted among the senior managers` TRUE FALSE) EQUALS JUST TRUE
-- "(other than persons falling within sub-paragraph (i))"
#ASSERT (`s 414C(8)(c)(ii) the person is counted among the senior managers` TRUE TRUE) EQUALS JUST FALSE
-- not a senior manager: sub-paragraph (ii) says nothing of other persons
#ASSERT (`s 414C(8)(c)(ii) the person is counted among the senior managers` FALSE FALSE) EQUALS NOTHING
-- a director is within (i) and so outside (ii)
#ASSERT (`s 414C(8)(c)(ii) the person is counted among the senior managers` FALSE TRUE) EQUALS JUST FALSE

-- ---- s 414C(9) ------------------------------------------------------------------------------------------------
-- (a) responsibility and (b) an employee
#ASSERT (`s 414C(9) the person is a senior manager` TRUE TRUE) EQUALS JUST TRUE
-- not an employee
#ASSERT (`s 414C(9) the person is a senior manager` TRUE FALSE) EQUALS JUST FALSE
-- no responsibility for planning, directing or controlling
#ASSERT (`s 414C(9) the person is a senior manager` FALSE TRUE) EQUALS JUST FALSE
-- neither
#ASSERT (`s 414C(9) the person is a senior manager` FALSE FALSE) EQUALS JUST FALSE

-- ---- s 414C(10) ----------------------------------------------------------------------------------------------
-- the reference in (8)(c)(i) is to the parent company
#ASSERT (`s 414C(10)(a) whose directors are counted under subsection (8)(c)(i)` TRUE) EQUALS JUST `s 414C(10)(a) the parent company`
-- not a group strategic report
#ASSERT (`s 414C(10)(a) whose directors are counted under subsection (8)(c)(i)` FALSE) EQUALS NOTHING
-- the directors of the undertakings included in the consolidation are counted
#ASSERT (`s 414C(10)(b) the breakdown under subsection (8)(c)(ii) must include the directors of the undertakings included in the consolidation` TRUE) EQUALS JUST TRUE
-- not a group strategic report
#ASSERT (`s 414C(10)(b) the breakdown under subsection (8)(c)(ii) must include the directors of the undertakings included in the consolidation` FALSE) EQUALS NOTHING

-- ---- s 414C(11), (12), (13), (14) ----------------------------------------------------------------------------
-- a matter from the regulations that the directors consider of strategic importance
#ASSERT (`s 414C(11) the strategic report may also contain the matter` TRUE TRUE) EQUALS JUST TRUE
-- the directors do not consider it of strategic importance
#ASSERT (`s 414C(11) the strategic report may also contain the matter` TRUE FALSE) EQUALS NOTHING
-- not a matter from the regulations
#ASSERT (`s 414C(11) the strategic report may also contain the matter` FALSE TRUE) EQUALS NOTHING
-- where appropriate
#ASSERT (`s 414C(12) the report must include references to and additional explanations of amounts in the annual accounts` TRUE) EQUALS JUST TRUE
-- "where appropriate" fails
#ASSERT (`s 414C(12) the report must include references to and additional explanations of amounts in the annual accounts` FALSE) EQUALS JUST FALSE
-- group strategic report, not the (8)(c)(i) reference
#ASSERT (`s 414C(13) a reference to the company in this section is read as a reference to the undertakings included in the consolidation` TRUE FALSE) EQUALS JUST TRUE
-- "Subject to paragraph (10)": the (8)(c)(i) reference is governed by (10)
#ASSERT (`s 414C(13) a reference to the company in this section is read as a reference to the undertakings included in the consolidation` TRUE TRUE) EQUALS JUST FALSE
-- not a group strategic report
#ASSERT (`s 414C(13) a reference to the company in this section is read as a reference to the undertakings included in the consolidation` FALSE FALSE) EQUALS NOTHING
-- "Nothing in this section requires the disclosure"
#ASSERT (`s 414C(14) this section requires the disclosure of the information` TRUE TRUE) EQUALS JUST FALSE
-- the directors are not of that opinion
#ASSERT (`s 414C(14) this section requires the disclosure of the information` TRUE FALSE) EQUALS NOTHING
-- not information of that kind
#ASSERT (`s 414C(14) this section requires the disclosure of the information` FALSE TRUE) EQUALS NOTHING

-- ---- s 414CZA ------------------------------------------------------------------------------------------------
-- describes how the directors have had regard to the section 172(1)(a) to (f) matters
#ASSERT (`s 414CZA(1) the statement is a section 172(1) statement` TRUE) EQUALS JUST TRUE
-- does not describe it
#ASSERT (`s 414CZA(1) the statement is a section 172(1) statement` FALSE) EQUALS JUST FALSE
-- a statement is included and it describes the required matters
#ASSERT (`s 414CZA(1) the strategic report includes the required section 172(1) statement` TRUE (JUST TRUE)) EQUALS JUST TRUE
-- no statement is included
#ASSERT (`s 414CZA(1) the strategic report includes the required section 172(1) statement` FALSE (JUST TRUE)) EQUALS JUST FALSE
-- a statement is included but it is not a section 172(1) statement
#ASSERT (`s 414CZA(1) the strategic report includes the required section 172(1) statement` TRUE (JUST FALSE)) EQUALS JUST FALSE
-- the description condition is not answered
#ASSERT (`s 414CZA(1) the strategic report includes the required section 172(1) statement` TRUE NOTHING) EQUALS NOTHING
-- medium-sized: subsection (1) does not apply
#ASSERT (`s 414CZA(2) subsection (1) does not apply to the company` (JUST TRUE)) EQUALS JUST TRUE
-- not medium-sized: the "if" fails
#ASSERT (`s 414CZA(2) subsection (1) does not apply to the company` (JUST FALSE)) EQUALS JUST FALSE
-- sections 465 to 467 not answered
#ASSERT (`s 414CZA(2) subsection (1) does not apply to the company` NOTHING) EQUALS NOTHING

-- ---- s 414CA(A1), (1), (1A) ---------------------------------------------------------------------------------
-- subsection (A1) applies and the statement is included
#ASSERT (`s 414CA(A1) the strategic report includes the required non-financial and sustainability information statement` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- subsection (A1) applies and the statement is not included
#ASSERT (`s 414CA(A1) the strategic report includes the required non-financial and sustainability information statement` (JUST TRUE) FALSE) EQUALS JUST FALSE
-- "of a company to which this subsection applies"
#ASSERT (`s 414CA(A1) the strategic report includes the required non-financial and sustainability information statement` (JUST FALSE) TRUE) EQUALS NOTHING
-- applicability not answered
#ASSERT (`s 414CA(A1) the strategic report includes the required non-financial and sustainability information statement` NOTHING TRUE) EQUALS NOTHING
-- a banking company
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` (JUST FALSE) TRUE FALSE FALSE) EQUALS JUST TRUE
-- an authorised insurance company
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` (JUST FALSE) FALSE TRUE FALSE) EQUALS JUST TRUE
-- a company carrying on insurance market activity
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` (JUST FALSE) FALSE FALSE TRUE) EQUALS JUST TRUE
-- a traded company
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` (JUST TRUE) FALSE FALSE FALSE) EQUALS JUST TRUE
-- none of (a) to (d): the "if" fails
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` (JUST FALSE) FALSE FALSE FALSE) EQUALS JUST FALSE
-- section 360C not answered
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` NOTHING FALSE FALSE FALSE) EQUALS NOTHING
-- a banking company whether or not it is traded
#ASSERT (`s 414CA(1)(a) to (d) the company is of a kind described` NOTHING TRUE FALSE FALSE) EQUALS JUST TRUE
-- one of (a) to (d)
#ASSERT (`s 414CA(1) subsection (A1) applies to the company because of its kind` (JUST TRUE) FALSE) EQUALS JUST TRUE
-- (e) shares on the Alternative Investment Market
#ASSERT (`s 414CA(1) subsection (A1) applies to the company because of its kind` (JUST FALSE) TRUE) EQUALS JUST TRUE
-- none of (a) to (e)
#ASSERT (`s 414CA(1) subsection (A1) applies to the company because of its kind` (JUST FALSE) FALSE) EQUALS JUST FALSE
-- paragraph (a) not answered
#ASSERT (`s 414CA(1) subsection (A1) applies to the company because of its kind` NOTHING FALSE) EQUALS NOTHING
-- (e) holds whatever (a) says
#ASSERT (`s 414CA(1) subsection (A1) applies to the company because of its kind` NOTHING TRUE) EQUALS JUST TRUE
-- a high turnover company
#ASSERT (`s 414CA(1A) subsection (A1) also applies to the company because it was a high turnover company` (JUST TRUE)) EQUALS JUST TRUE
-- not a high turnover company
#ASSERT (`s 414CA(1A) subsection (A1) also applies to the company because it was a high turnover company` (JUST FALSE)) EQUALS JUST FALSE
-- the turnover test is not answered
#ASSERT (`s 414CA(1A) subsection (A1) also applies to the company because it was a high turnover company` NOTHING) EQUALS NOTHING

-- ---- s 414CA(1B): the routes in are subject to the ways out ---------------------------------------------------
-- route (1), no exclusion
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
-- route (1A), no exclusion
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
-- excluded by (3): size
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- excluded by (4): employees
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
-- excluded by (7): included in a group strategic report
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
-- no route in
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- an exclusion is unanswered
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
-- route (1) is unanswered
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
-- route (1A) holds whatever (1) says
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
-- (4) excludes even though (3) is unanswered
#ASSERT (`s 414CA(1B) subsection (A1) applies to the company` (JUST TRUE) (JUST FALSE) NOTHING (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
-- a group strategic report needs a consolidated statement
#ASSERT (`s 414CA(2) the statement must be a consolidated group non-financial and sustainability information statement` TRUE) EQUALS JUST TRUE
-- not a group strategic report
#ASSERT (`s 414CA(2) the statement must be a consolidated group non-financial and sustainability information statement` FALSE) EQUALS JUST FALSE

-- ---- s 414CA(2A) to (2D): the turnover test ------------------------------------------------------------------
-- a financial year of a year
#ASSERT (`s 414CA(2B) the turnover threshold of £500 million adjusted to the length of the financial year` 1) EQUALS 500000000
-- a period of six months: proportionately adjusted
#ASSERT (`s 414CA(2B) the turnover threshold of £500 million adjusted to the length of the financial year` 0.5) EQUALS 250000000
-- not a parent company: own turnover more than 500 million
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST FALSE) 500000001 0 1) EQUALS JUST TRUE
-- exactly 500 million is not "more than"; the group figure is irrelevant
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST FALSE) 500000000 900000000 1) EQUALS JUST FALSE
-- a parent company: group aggregate net more than 500 million
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST TRUE) 0 600000000 1) EQUALS JUST TRUE
-- a parent company: its own turnover is irrelevant
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST TRUE) 900000000 400000000 1) EQUALS JUST FALSE
-- six months: 300 million is more than 250 million
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST FALSE) 300000000 0 0.5) EQUALS JUST TRUE
-- six months: exactly 250 million is not more than 250 million
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` (JUST FALSE) 250000000 0 0.5) EQUALS JUST FALSE
-- section 1173(1) parent company not answered
#ASSERT (`s 414CA(2A) the company is a high turnover company in relation to the financial year` NOTHING 900000000 900000000 1) EQUALS NOTHING
-- aggregated over each member of the group
#ASSERT (`s 414CA(2C)(a) the aggregate turnover of the group` (LIST 100, 250, 50)) EQUALS 400
-- no members to aggregate
#ASSERT (`s 414CA(2C)(a) the aggregate turnover of the group` EMPTY) EQUALS 0
-- for the purposes of subsection (2A)(b)
#ASSERT (`s 414CA(2D) section 383(7) applies for the purpose` TRUE) EQUALS JUST TRUE
-- any other purpose
#ASSERT (`s 414CA(2D) section 383(7) applies for the purpose` FALSE) EQUALS NOTHING

-- ---- s 414CA(3) to (8) ---------------------------------------------------------------------------------------
-- the small companies regime
#ASSERT (`s 414CA(3) subsection (A1) does not apply because of the company's size` (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
-- medium-sized
#ASSERT (`s 414CA(3) subsection (A1) does not apply because of the company's size` (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
-- neither
#ASSERT (`s 414CA(3) subsection (A1) does not apply because of the company's size` (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- the small companies regime is unanswered
#ASSERT (`s 414CA(3) subsection (A1) does not apply because of the company's size` NOTHING (JUST FALSE)) EQUALS NOTHING
-- medium-sized whatever the small companies regime says
#ASSERT (`s 414CA(3) subsection (A1) does not apply because of the company's size` NOTHING (JUST TRUE)) EQUALS JUST TRUE
-- not a parent company, no more than 500 employees
#ASSERT (`s 414CA(4) subsection (A1) does not apply because of the number of employees` (JUST FALSE) 500 9999) EQUALS JUST TRUE
-- not a parent company, 501 employees
#ASSERT (`s 414CA(4) subsection (A1) does not apply because of the number of employees` (JUST FALSE) 501 0) EQUALS JUST FALSE
-- a parent company, the group has no more than 500 employees
#ASSERT (`s 414CA(4) subsection (A1) does not apply because of the number of employees` (JUST TRUE) 9999 500) EQUALS JUST TRUE
-- a parent company, the group has 501 employees
#ASSERT (`s 414CA(4) subsection (A1) does not apply because of the number of employees` (JUST TRUE) 0 501) EQUALS JUST FALSE
-- section 1173(1) parent company not answered
#ASSERT (`s 414CA(4) subsection (A1) does not apply because of the number of employees` NOTHING 10 10) EQUALS NOTHING
-- the average of the monthly totals
#ASSERT (`s 414CA(5) the number of employees` (LIST 10, 20, 30)) EQUALS JUST 20
-- no months: nothing to divide by
#ASSERT (`s 414CA(5) the number of employees` EMPTY) EQUALS NOTHING
-- aggregated over the members of the group
#ASSERT (`s 414CA(6) the aggregate number of employees for the group` (LIST 100, 250)) EQUALS 350
-- a subsidiary undertaking included in a qualifying group strategic report
#ASSERT (`s 414CA(7) subsection (A1) does not apply because the company is included in a group strategic report` TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
-- the group strategic report does not satisfy subsection (8)
#ASSERT (`s 414CA(7) subsection (A1) does not apply because the company is included in a group strategic report` TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
-- not included in a group strategic report
#ASSERT (`s 414CA(7) subsection (A1) does not apply because the company is included in a group strategic report` TRUE FALSE (JUST TRUE)) EQUALS JUST FALSE
-- not a subsidiary undertaking at the end of the year
#ASSERT (`s 414CA(7) subsection (A1) does not apply because the company is included in a group strategic report` FALSE TRUE (JUST TRUE)) EQUALS JUST FALSE
-- subsection (8) is unanswered
#ASSERT (`s 414CA(7) subsection (A1) does not apply because the company is included in a group strategic report` TRUE TRUE NOTHING) EQUALS NOTHING
-- (a), (b) and (c)
#ASSERT (`s 414CA(8) the requirements in this subsection are satisfied` TRUE TRUE TRUE) EQUALS JUST TRUE
-- (a) fails
#ASSERT (`s 414CA(8) the requirements in this subsection are satisfied` FALSE TRUE TRUE) EQUALS JUST FALSE
-- (b) fails
#ASSERT (`s 414CA(8) the requirements in this subsection are satisfied` TRUE FALSE TRUE) EQUALS JUST FALSE
-- (c) fails
#ASSERT (`s 414CA(8) the requirements in this subsection are satisfied` TRUE TRUE FALSE) EQUALS JUST FALSE
-- subsection (A1) does not apply, so the company may include a statement
#ASSERT (`s 414CA(10) the company may include a non-financial and sustainability information statement in its strategic report` (JUST FALSE)) EQUALS JUST TRUE
-- subsection (A1) applies: the duty governs
#ASSERT (`s 414CA(10) the company may include a non-financial and sustainability information statement in its strategic report` (JUST TRUE)) EQUALS NOTHING
-- applicability unanswered
#ASSERT (`s 414CA(10) the company may include a non-financial and sustainability information statement in its strategic report` NOTHING) EQUALS NOTHING

-- ---- s 414CB -------------------------------------------------------------------------------------------------
-- listed in (2A)(a)
#ASSERT (`s 414CB(2A) the disclosure is one of the climate-related financial disclosures` `s 414CB(2A)(a) governance arrangements in relation to assessing and managing climate-related risks and opportunities`) EQUALS JUST TRUE
-- listed in (2A)(h)
#ASSERT (`s 414CB(2A) the disclosure is one of the climate-related financial disclosures` `s 414CB(2A)(h) the key performance indicators used to assess progress against those targets, and the calculations behind them`) EQUALS JUST TRUE
-- "mean" closes the list of eight
#ASSERT (`s 414CB(2A) the disclosure is one of the climate-related financial disclosures` `s 414CB(2A) another kind of disclosure`) EQUALS JUST FALSE
-- all eight kinds are contained
#ASSERT (`s 414CB(A1) the statement contains the climate-related financial disclosures` (LIST `s 414CB(2A)(a) governance arrangements in relation to assessing and managing climate-related risks and opportunities`, `s 414CB(2A)(b) how the company identifies, assesses and manages climate-related risks and opportunities`, `s 414CB(2A)(c) how those processes are integrated into the company's overall risk management process`, `s 414CB(2A)(d) the principal climate-related risks and opportunities and the time periods by reference to which they are assessed`, `s 414CB(2A)(e) the actual and potential impacts of the principal climate-related risks and opportunities on the business model and strategy`, `s 414CB(2A)(f) the resilience of the business model and strategy in different climate-related scenarios`, `s 414CB(2A)(g) the targets used to manage climate-related risks and to realise opportunities, and performance against them`, `s 414CB(2A)(h) the key performance indicators used to assess progress against those targets, and the calculations behind them`)) EQUALS JUST TRUE
-- (f) the resilience analysis is missing
#ASSERT (`s 414CB(A1) the statement contains the climate-related financial disclosures` (LIST `s 414CB(2A)(a) governance arrangements in relation to assessing and managing climate-related risks and opportunities`, `s 414CB(2A)(b) how the company identifies, assesses and manages climate-related risks and opportunities`, `s 414CB(2A)(c) how those processes are integrated into the company's overall risk management process`, `s 414CB(2A)(d) the principal climate-related risks and opportunities and the time periods by reference to which they are assessed`, `s 414CB(2A)(e) the actual and potential impacts of the principal climate-related risks and opportunities on the business model and strategy`, `s 414CB(2A)(g) the targets used to manage climate-related risks and to realise opportunities, and performance against them`, `s 414CB(2A)(h) the key performance indicators used to assess progress against those targets, and the calculations behind them`)) EQUALS JUST FALSE
-- nothing contained
#ASSERT (`s 414CB(A1) the statement contains the climate-related financial disclosures` EMPTY) EQUALS JUST FALSE
-- a company of a kind in section 414CA(1)(a) to (d); necessary
#ASSERT (`s 414CB(1) the statement must contain information on the matter` (JUST TRUE) TRUE) EQUALS JUST TRUE
-- "to the extent necessary": not necessary
#ASSERT (`s 414CB(1) the statement must contain information on the matter` (JUST TRUE) FALSE) EQUALS NOTHING
-- the "If the company is of a kind described" fails
#ASSERT (`s 414CB(1) the statement must contain information on the matter` (JUST FALSE) TRUE) EQUALS JUST FALSE
-- section 360C not answered
#ASSERT (`s 414CB(1) the statement must contain information on the matter` NOTHING TRUE) EQUALS NOTHING
-- (a)
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` TRUE TRUE `s 414CB(2)(a) a brief description of the company's business model`) EQUALS JUST TRUE
-- (e) does not depend on relevance and proportionality
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` TRUE FALSE `s 414CB(2)(e) a description of the non-financial key performance indicators relevant to the company's business`) EQUALS JUST TRUE
-- (d)(i) where relevant and proportionate
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` TRUE TRUE `s 414CB(2)(d)(i) a description of business relationships, products and services likely to cause adverse impacts in those areas of risk`) EQUALS JUST TRUE
-- (d)(i) "where relevant and proportionate" fails
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` TRUE FALSE `s 414CB(2)(d)(i) a description of business relationships, products and services likely to cause adverse impacts in those areas of risk`) EQUALS JUST FALSE
-- (d)(ii) "where relevant and proportionate" fails
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` TRUE FALSE `s 414CB(2)(d)(ii) a description of how the company manages the principal risks`) EQUALS JUST FALSE
-- not information required by subsection (1)
#ASSERT (`s 414CB(2) the information required by subsection (1) must include the item` FALSE TRUE `s 414CB(2)(a) a brief description of the company's business model`) EQUALS NOTHING
-- "means factors by reference to which ... can be measured effectively"
#ASSERT (`s 414CB(3) the factor is a key performance indicator` TRUE) EQUALS JUST TRUE
-- a "means" definition
#ASSERT (`s 414CB(3) the factor is a key performance indicator` FALSE) EQUALS JUST FALSE
-- the company pursues no policy on one of the matters: a reasoned explanation is required
#ASSERT (`s 414CB(4) the statement must provide a clear and reasoned explanation for the company's not pursuing policies` TRUE) EQUALS JUST TRUE
-- the "If" fails
#ASSERT (`s 414CB(4) the statement must provide a clear and reasoned explanation for the company's not pursuing policies` FALSE) EQUALS JUST FALSE
-- (e) with a reasonable belief
#ASSERT (`s 414CB(4A) the directors may omit the disclosure or the relevant part of it` `s 414CB(2A)(e) the actual and potential impacts of the principal climate-related risks and opportunities on the business model and strategy` TRUE) EQUALS JUST TRUE
-- (h) without the belief: "Where the directors ... reasonably believe" fails
#ASSERT (`s 414CB(4A) the directors may omit the disclosure or the relevant part of it` `s 414CB(2A)(h) the key performance indicators used to assess progress against those targets, and the calculations behind them` FALSE) EQUALS JUST FALSE
-- (a) is not among (e), (f), (g) or (h)
#ASSERT (`s 414CB(4A) the directors may omit the disclosure or the relevant part of it` `s 414CB(2A)(a) governance arrangements in relation to assessing and managing climate-related risks and opportunities` TRUE) EQUALS NOTHING
-- an omission in reliance on (4A)
#ASSERT (`s 414CB(4B) the statement must provide a clear and reasoned explanation of the directors' reasonable belief` TRUE) EQUALS JUST TRUE
-- "Where the directors omit" fails
#ASSERT (`s 414CB(4B) the statement must provide a clear and reasoned explanation of the directors' reasonable belief` FALSE) EQUALS JUST FALSE
-- where appropriate
#ASSERT (`s 414CB(5) the statement must include references to and additional explanations of amounts in the annual accounts` TRUE) EQUALS JUST TRUE
-- "where appropriate" fails
#ASSERT (`s 414CB(5) the statement must include references to and additional explanations of amounts in the annual accounts` FALSE) EQUALS JUST FALSE
-- published by means of a reporting framework
#ASSERT (`s 414CB(6) the statement must specify the framework or frameworks used instead of including the information` TRUE) EQUALS JUST TRUE
-- the "If" fails
#ASSERT (`s 414CB(6) the statement must specify the framework or frameworks used instead of including the information` FALSE) EQUALS JUST FALSE
-- (a)
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE FALSE FALSE `s 414CB(7)(a) section 414C(4)(b)`) EQUALS JUST TRUE
-- (b) apart from community issues
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE FALSE FALSE `s 414CB(7)(b) section 414C(7)`) EQUALS JUST TRUE
-- (b) "except as it relates to community issues"
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE TRUE FALSE `s 414CB(7)(b) section 414C(7)`) EQUALS JUST FALSE
-- (c)
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE FALSE FALSE `s 414CB(7)(c) section 414C(8)(b)`) EQUALS JUST TRUE
-- (d) so far as relating to (a) to (c)
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE FALSE TRUE `s 414CB(7)(d) section 414C(12)`) EQUALS JUST TRUE
-- (d) outside "so far as relating to the provisions mentioned in paragraphs (a) to (c)"
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` TRUE FALSE FALSE `s 414CB(7)(d) section 414C(12)`) EQUALS NOTHING
-- the statement does not comply with subsections (1) to (6)
#ASSERT (`s 414CB(7) the strategic report is treated as complying with the requirement` FALSE FALSE FALSE `s 414CB(7)(a) section 414C(4)(b)`) EQUALS JUST FALSE
-- a group statement
#ASSERT (`s 414CB(8) a reference to the company in this section is read as a reference to the undertakings included in the consolidation` TRUE) EQUALS JUST TRUE
-- not a group statement
#ASSERT (`s 414CB(8) a reference to the company in this section is read as a reference to the undertakings included in the consolidation` FALSE) EQUALS NOTHING
-- "Nothing in this section requires the disclosure" on all three limbs
#ASSERT (`s 414CB(9) this section requires the disclosure of the information` TRUE TRUE TRUE) EQUALS JUST FALSE
-- the proviso fails: the text then says nothing here
#ASSERT (`s 414CB(9) this section requires the disclosure of the information` TRUE TRUE FALSE) EQUALS NOTHING
-- the directors are not of the opinion
#ASSERT (`s 414CB(9) this section requires the disclosure of the information` TRUE FALSE TRUE) EQUALS NOTHING
-- not information of that kind
#ASSERT (`s 414CB(9) this section requires the disclosure of the information` FALSE TRUE TRUE) EQUALS NOTHING
-- guidance on the climate-related financial disclosures
#ASSERT (`s 414CB(10) the Secretary of State may issue the guidance` TRUE) EQUALS JUST TRUE
-- other matters are not mentioned
#ASSERT (`s 414CB(10) the Secretary of State may issue the guidance` FALSE) EQUALS NOTHING

-- ---- s 414D ---------------------------------------------------------------------------------------------------
-- approved and signed by a director
#ASSERT (`s 414D(1) the strategic report has been approved and signed as required` TRUE TRUE FALSE) EQUALS JUST TRUE
-- approved and signed by the secretary
#ASSERT (`s 414D(1) the strategic report has been approved and signed as required` TRUE FALSE TRUE) EQUALS JUST TRUE
-- approved but not signed
#ASSERT (`s 414D(1) the strategic report has been approved and signed as required` TRUE FALSE FALSE) EQUALS JUST FALSE
-- signed but not approved by the board
#ASSERT (`s 414D(1) the strategic report has been approved and signed as required` FALSE TRUE FALSE) EQUALS JUST FALSE
-- a director who knew and took no reasonable steps
#ASSERT (`s 414D(2) the director commits an offence` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- a director who was reckless and took no reasonable steps
#ASSERT (`s 414D(2) the director commits an offence` TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- neither knew nor reckless: outside "every director ... who"
#ASSERT (`s 414D(2) the director commits an offence` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- took reasonable steps: outside "every director ... who"
#ASSERT (`s 414D(2) the director commits an offence` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- not a director of the company
#ASSERT (`s 414D(2) the director commits an offence` TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- no report was approved: the "If" fails
#ASSERT (`s 414D(2) the director commits an offence` FALSE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- the approved report complies: the "If" fails
#ASSERT (`s 414D(2) the director commits an offence` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (a) a fine
#ASSERT (`s 414D(3) the penalty for an offence under section 414D` `on conviction on indictment`) EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b) a fine not exceeding the statutory maximum
#ASSERT (`s 414D(3) the penalty for an offence under section 414D` `on summary conviction`) EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
-- the subsection does not distinguish the parts of the United Kingdom
#ASSERT (`s 414D(3) the penalty for an offence under section 414D` `on summary conviction in Scotland`) EQUALS NOTHING

