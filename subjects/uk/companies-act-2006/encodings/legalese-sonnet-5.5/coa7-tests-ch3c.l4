IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch7`
IMPORT `coa7-ch3c`

-- coa7-tests-ch3c.l4: tests for coa7-ch3c.l4 (Part 13 Chapter 3, ss 314 to 323).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.
-- The persons present at a meeting are built inside each assertion. Their capacities, from the text of s 318(3):
--   "A": an individual who is a member; "R1" and "R2": representatives of corporation X; "R3": of corporation Y;
--   "P1" and "P2": proxies of member M; "P3": proxy of member N; "Z": none of the three; "AP": a member who is also proxy of M.

§ `Tests for Chapter 3, ss 314 to 323`

-- s 314(1): a statement of not more than 1,000 words about a resolution or other business
#ASSERT `s 314(1) the members may require the company to circulate the statement` 1000 TRUE EQUALS JUST TRUE
#ASSERT `s 314(1) the members may require the company to circulate the statement` 1001 TRUE EQUALS NOTHING
#ASSERT `s 314(1) the members may require the company to circulate the statement` 500 FALSE EQUALS NOTHING
-- s 314(3): the relevant right to vote
#ASSERT `s 314(3) the member has a relevant right to vote` `s 314(3)(a) a statement with respect to a matter referred to in a proposed resolution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 314(3) the member has a relevant right to vote` `s 314(3)(a) a statement with respect to a matter referred to in a proposed resolution` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 314(3) the member has a relevant right to vote` `s 314(3)(b) any other statement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 314(3) the member has a relevant right to vote` `s 314(3)(b) any other statement` TRUE FALSE EQUALS JUST FALSE
-- s 314(2): (a) at least 5% of the voting rights (5 of 100), or (b) at least 100 members with an average of at least £100 paid up
#ASSERT `s 314(2) the company is required to circulate the statement` 5 100 0 0 EQUALS JUST TRUE
#ASSERT `s 314(2) the company is required to circulate the statement` 4 100 0 0 EQUALS JUST FALSE
#ASSERT `s 314(2) the company is required to circulate the statement` 0 100 100 10000 EQUALS JUST TRUE
#ASSERT `s 314(2) the company is required to circulate the statement` 0 100 100 9999 EQUALS JUST FALSE
#ASSERT `s 314(2) the company is required to circulate the statement` 0 100 99 9900 EQUALS JUST FALSE
-- s 314(4): a request in a permitted form, identifying the statement, authenticated, received at least one week (7 clear days) before the meeting
#ASSERT `s 314(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST TRUE
#ASSERT `s 314(4) the request meets the requirements of this subsection` TRUE TRUE TRUE (Date 1 3 2026) (Date 8 3 2026) EQUALS JUST FALSE
#ASSERT `s 314(4) the request meets the requirements of this subsection` TRUE FALSE TRUE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 314(4) the request meets the requirements of this subsection` TRUE TRUE FALSE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 314(4) the request meets the requirements of this subsection` FALSE TRUE TRUE (Date 1 3 2026) (Date 9 3 2026) EQUALS NOTHING

-- s 315(1)
#ASSERT `s 315(1) the company must send a copy of the statement to each member entitled to receive notice of the meeting` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 315(1) the company must send a copy of the statement to each member entitled to receive notice of the meeting` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 315(1) the company must send a copy of the statement to each member entitled to receive notice of the meeting` NOTHING EQUALS NOTHING
#ASSERT `s 315(1)(a) the copy was sent in the manner this paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 315(1)(a) the copy was sent in the manner this paragraph requires` FALSE EQUALS JUST FALSE
#ASSERT `s 315(1)(b) the copy was sent at a time this paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `s 315(1)(b) the copy was sent at a time this paragraph requires` FALSE EQUALS JUST FALSE
-- s 315(2): subject to s 316(2) (deposit) and s 317 (court)
#ASSERT `s 315(2) subsection (1) has effect` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 315(2) subsection (1) has effect` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 315(2) subsection (1) has effect` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 315(2) subsection (1) has effect` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 315(2) subsection (1) has effect` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 315(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 315(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 315(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 315(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 315(4) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 315(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 315(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 315(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 315(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)

-- s 316(1): an AGM of a public company, requests received before the end of the preceding financial year (which ended 31 December 2025)
#ASSERT `s 316(1) the expenses need not be paid by the members who requested the circulation` TRUE (Date 31 12 2025) (Date 31 12 2025) EQUALS JUST TRUE
#ASSERT `s 316(1) the expenses need not be paid by the members who requested the circulation` TRUE (Date 1 1 2026) (Date 31 12 2025) EQUALS JUST FALSE
#ASSERT `s 316(1) the expenses need not be paid by the members who requested the circulation` FALSE (Date 30 6 2025) (Date 31 12 2025) EQUALS JUST FALSE
-- s 316(2)(a): otherwise the members pay unless the company resolves otherwise
#ASSERT `s 316(2)(a) the expenses must be paid by the members who requested the circulation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 316(2)(a) the expenses must be paid by the members who requested the circulation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 316(2)(a) the expenses must be paid by the members who requested the circulation` FALSE FALSE EQUALS JUST TRUE
-- s 316(2)(b): unless previously resolved, not bound unless a sum is deposited or tendered not later than one week (7 clear days) before the meeting
#ASSERT `s 316(2) the company is bound to comply with section 315` TRUE FALSE FALSE (Date 1 3 2026) (Date 9 3 2026) EQUALS NOTHING
#ASSERT `s 316(2) the company is bound to comply with section 315` FALSE TRUE FALSE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST TRUE
#ASSERT `s 316(2) the company is bound to comply with section 315` FALSE FALSE TRUE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST TRUE
#ASSERT `s 316(2) the company is bound to comply with section 315` FALSE FALSE TRUE (Date 1 3 2026) (Date 8 3 2026) EQUALS JUST FALSE
#ASSERT `s 316(2) the company is bound to comply with section 315` FALSE FALSE FALSE (Date 1 3 2026) (Date 9 3 2026) EQUALS JUST FALSE

-- s 317(1), (2)
#ASSERT `s 317(1) the company is not required to circulate the members' statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 317(1) the company is not required to circulate the members' statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 317(1) the company is not required to circulate the members' statement` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 317(2) the court may order the members who requested the circulation to pay the company's costs` TRUE EQUALS JUST TRUE
#ASSERT `s 317(2) the court may order the members who requested the circulation to pay the company's costs` FALSE EQUALS NOTHING

-- s 318(3): a qualifying person is an individual who is a member, a corporation's authorised representative, or a member's proxy
#ASSERT `s 318(3) the person is a qualifying person` (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) EQUALS JUST TRUE
#ASSERT `s 318(3) the person is a qualifying person` (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING) EQUALS JUST TRUE
#ASSERT `s 318(3) the person is a qualifying person` (`s 318 person present` OF "P1", FALSE, NOTHING, JUST "M") EQUALS JUST TRUE
#ASSERT `s 318(3) the person is a qualifying person` (`s 318 person present` OF "Z", FALSE, NOTHING, NOTHING) EQUALS JUST FALSE
-- s 318(1): a company limited by shares or guarantee with only one member: one qualifying person present is a quorum
#ASSERT `s 318(1) one qualifying person present is a quorum` TRUE (LIST (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING)) EQUALS JUST TRUE
#ASSERT `s 318(1) one qualifying person present is a quorum` TRUE EMPTY EQUALS NOTHING
#ASSERT `s 318(1) one qualifying person present is a quorum` TRUE (LIST (`s 318 person present` OF "Z", FALSE, NOTHING, NOTHING)) EQUALS NOTHING
#ASSERT `s 318(1) one qualifying person present is a quorum` FALSE (LIST (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING)) EQUALS NOTHING
-- s 318(2): two qualifying persons are a quorum, unless each is only the representative of the same corporation or only the proxy of the same member
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) (`s 318 person present` OF "B", TRUE, NOTHING, NOTHING) EQUALS JUST TRUE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING) (`s 318 person present` OF "R2", FALSE, JUST "X", NOTHING) EQUALS JUST FALSE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING) (`s 318 person present` OF "R3", FALSE, JUST "Y", NOTHING) EQUALS JUST TRUE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "P1", FALSE, NOTHING, JUST "M") (`s 318 person present` OF "P2", FALSE, NOTHING, JUST "M") EQUALS JUST FALSE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "P1", FALSE, NOTHING, JUST "M") (`s 318 person present` OF "P3", FALSE, NOTHING, JUST "N") EQUALS JUST TRUE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) EQUALS JUST FALSE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) (`s 318 person present` OF "Z", FALSE, NOTHING, NOTHING) EQUALS JUST FALSE
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING) (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING) EQUALS JUST TRUE
-- a member who is also the proxy of M is a qualifying person for another reason, so is not "only" a proxy
#ASSERT `s 318(2) these two persons present are a quorum` (`s 318 person present` OF "AP", TRUE, NOTHING, JUST "M") (`s 318 person present` OF "P2", FALSE, NOTHING, JUST "M") EQUALS JUST TRUE
#ASSERT `s 318(2) two qualifying persons present are a quorum` FALSE (LIST (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING), (`s 318 person present` OF "B", TRUE, NOTHING, NOTHING)) EQUALS JUST TRUE
#ASSERT `s 318(2) two qualifying persons present are a quorum` FALSE (LIST (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING)) EQUALS JUST FALSE
#ASSERT `s 318(2) two qualifying persons present are a quorum` FALSE (LIST (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING), (`s 318 person present` OF "R2", FALSE, JUST "X", NOTHING)) EQUALS JUST FALSE
#ASSERT `s 318(2) two qualifying persons present are a quorum` FALSE (LIST (`s 318 person present` OF "R1", FALSE, JUST "X", NOTHING), (`s 318 person present` OF "R2", FALSE, JUST "X", NOTHING), (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING)) EQUALS JUST TRUE
#ASSERT `s 318(2) two qualifying persons present are a quorum` FALSE (LIST (`s 318 person present` OF "P1", FALSE, NOTHING, JUST "M"), (`s 318 person present` OF "P2", FALSE, NOTHING, JUST "M"), (`s 318 person present` OF "P3", FALSE, NOTHING, JUST "N")) EQUALS JUST TRUE
#ASSERT `s 318(2) two qualifying persons present are a quorum` TRUE (LIST (`s 318 person present` OF "A", TRUE, NOTHING, NOTHING), (`s 318 person present` OF "B", TRUE, NOTHING, NOTHING)) EQUALS NOTHING

-- s 319
#ASSERT `s 319(1) the member may be elected chairman of the general meeting` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 319(1) the member may be elected chairman of the general meeting` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 319(1) the member may be elected chairman of the general meeting` FALSE TRUE FALSE EQUALS NOTHING
-- s 319A(2), (1)
#ASSERT `s 319A(2) no answer need be given` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 319A(2) no answer need be given` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 319A(2) no answer need be given` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 319A(2) no answer need be given` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 319A(2) no answer need be given` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 319A(1) the company must cause the question to be answered` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 319A(1) the company must cause the question to be answered` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 319A(1) the company must cause the question to be answered` TRUE TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 319A(1) the company must cause the question to be answered` FALSE TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 319A(1) the company must cause the question to be answered` TRUE FALSE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 319A(1) the company must cause the question to be answered` TRUE TRUE FALSE (JUST FALSE) EQUALS NOTHING

-- s 320(3): does not have effect if a poll is demanded (and the demand is not withdrawn)
#ASSERT `s 320(3) this section has effect` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 320(3) this section has effect` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 320(3) this section has effect` FALSE FALSE EQUALS JUST TRUE
-- s 320(1)
#ASSERT `s 320(1) the declaration is conclusive evidence of that fact without proof of the number or proportion of the votes` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 320(1) the declaration is conclusive evidence of that fact without proof of the number or proportion of the votes` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 320(1) the declaration is conclusive evidence of that fact without proof of the number or proportion of the votes` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 320(1) the declaration is conclusive evidence of that fact without proof of the number or proportion of the votes` TRUE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 320(1) the declaration is conclusive evidence of that fact without proof of the number or proportion of the votes` TRUE TRUE NOTHING EQUALS NOTHING
-- s 320(2)
#ASSERT `s 320(2) the entry in the minutes is conclusive evidence of that fact without proof` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 320(2) the entry in the minutes is conclusive evidence of that fact without proof` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 320(2) the entry in the minutes is conclusive evidence of that fact without proof` FALSE (JUST TRUE) EQUALS NOTHING

-- s 321(1): void in so far as it excludes the right to demand a poll on any question other than the election of the chairman or an adjournment
#ASSERT `s 321(1) the provision of the articles is void` `s 321 any other question` TRUE EQUALS JUST TRUE
#ASSERT `s 321(1) the provision of the articles is void` `s 321 any other question` FALSE EQUALS NOTHING
#ASSERT `s 321(1) the provision of the articles is void` `s 321(1)(a) the election of the chairman of the meeting` TRUE EQUALS NOTHING
#ASSERT `s 321(1) the provision of the articles is void` `s 321(1)(b) the adjournment of the meeting` TRUE EQUALS NOTHING
-- s 321(2): a demand by 5 members, or by members with 10% of the voting rights, or 10% of the paid-up sum (total rights 100, total paid up 1,000)
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 5 0 100 0 1000 TRUE EQUALS JUST TRUE
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 4 9 100 99 1000 TRUE EQUALS NOTHING
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 0 10 100 0 1000 TRUE EQUALS JUST TRUE
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 0 9 100 100 1000 TRUE EQUALS JUST TRUE
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 0 9 100 99 1000 TRUE EQUALS NOTHING
#ASSERT `s 321(2) the provision of the articles is void` `s 321(1)(a) the election of the chairman of the meeting` 5 0 100 0 1000 TRUE EQUALS NOTHING
#ASSERT `s 321(2) the provision of the articles is void` `s 321 any other question` 5 0 100 0 1000 FALSE EQUALS NOTHING

-- s 322: a member entitled to more than one vote need not use all of them
#ASSERT `s 322 the member need not use all his votes or cast all the votes he uses in the same way` 2 EQUALS JUST TRUE
#ASSERT `s 322 the member need not use all his votes or cast all the votes he uses in the same way` 1 EQUALS NOTHING
-- s 322A(1), (2)
#ASSERT `s 322A(1) the votes on the poll include votes cast in advance` TRUE EQUALS JUST TRUE
#ASSERT `s 322A(1) the votes on the poll include votes cast in advance` FALSE EQUALS NOTHING
#ASSERT `s 322A(2) the provision may be made subject to the requirement or restriction` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 322A(2) the provision may be made subject to the requirement or restriction` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 322A(2) the provision may be made subject to the requirement or restriction` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 322A(2) the provision may be made subject to the requirement or restriction` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 322A(2) the company may require reasonable evidence of the entitlement of the person to vote` TRUE EQUALS JUST TRUE
#ASSERT `s 322A(2) the company may require reasonable evidence of the entitlement of the person to vote` FALSE EQUALS NOTHING
-- s 322A(4), (3): 24 hours before the poll if the poll is taken more than 48 hours after it was demanded; otherwise 48 hours before the meeting; non-working-day hours do not count
#ASSERT `s 322A(4) the hours of the period that are counted` 48 0 EQUALS 48
#ASSERT `s 322A(4) the hours of the period that are counted` 72 24 EQUALS 48
#ASSERT `s 322A(3) the provision of the articles is void` TRUE 24 0 EQUALS NOTHING
#ASSERT `s 322A(3) the provision of the articles is void` TRUE 25 0 EQUALS JUST TRUE
#ASSERT `s 322A(3) the provision of the articles is void` FALSE 48 0 EQUALS NOTHING
#ASSERT `s 322A(3) the provision of the articles is void` FALSE 49 0 EQUALS JUST TRUE
#ASSERT `s 322A(3) the provision of the articles is void` FALSE 72 24 EQUALS NOTHING
#ASSERT `s 322A(3) the provision of the articles is void` FALSE 73 24 EQUALS JUST TRUE
#ASSERT `s 322A(3) the provision of the articles is void` TRUE 49 24 EQUALS JUST TRUE

-- s 323
#ASSERT `s 323(1) the person is authorised to act as the corporation's representative` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 323(1) the person is authorised to act as the corporation's representative` FALSE TRUE EQUALS NOTHING
#ASSERT `s 323(1) the person is authorised to act as the corporation's representative` TRUE FALSE EQUALS NOTHING
#ASSERT `s 323(2) the person is entitled to exercise the same powers on behalf of the corporation as an individual member could` TRUE EQUALS JUST TRUE
#ASSERT `s 323(2) the person is entitled to exercise the same powers on behalf of the corporation as an individual member could` FALSE EQUALS NOTHING
#ASSERT `s 323(3) the voting rights of each authorised person` TRUE 5 EQUALS JUST 5
#ASSERT `s 323(3) the voting rights of each authorised person` FALSE 5 EQUALS NOTHING
#ASSERT `s 323(4) the power is treated` FALSE TRUE TRUE EQUALS JUST `s 323(4)(a) as exercised in that way`
#ASSERT `s 323(4) the power is treated` FALSE TRUE FALSE EQUALS JUST `s 323(4)(b) as not exercised`
#ASSERT `s 323(4) the power is treated` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 323(4) the power is treated` FALSE FALSE TRUE EQUALS NOTHING
