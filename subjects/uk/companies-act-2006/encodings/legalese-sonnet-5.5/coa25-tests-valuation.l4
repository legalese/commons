IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa25-valuation`

-- coa25-tests-valuation.l4: tests for coa25-valuation.l4 (ss 1149 to 1153).
-- Every expected value was decided by reading the section and written down before the run.

-- ---- s 1149
#ASSERT `s 1149 sections 1150 to 1153 apply to the valuation and report` `s 1149 s 93 (re-registration as public company: recent allotment of shares for non-cash consideration)` EQUALS JUST TRUE
#ASSERT `s 1149 sections 1150 to 1153 apply to the valuation and report` `s 1149 s 593 (allotment of shares of public company in consideration of non-cash asset)` EQUALS JUST TRUE
#ASSERT `s 1149 sections 1150 to 1153 apply to the valuation and report` `s 1149 s 599 (transfer of non-cash asset to public company)` EQUALS JUST TRUE
#ASSERT `s 1149 sections 1150 to 1153 apply to the valuation and report` `s 1149 another provision` EQUALS NOTHING

-- ---- s 1150(1) (arguments: the s 1212 answer; the s 1151 answer)
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE -- not eligible as a statutory auditor
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE -- not independent
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1150(1) the person may make the valuation and report` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 1150(1) the person may make the valuation and report` NOTHING (JUST FALSE) EQUALS JUST FALSE -- one limb is enough to fail
#ASSERT `s 1150(1) the person may make the valuation and report` (JUST FALSE) NOTHING EQUALS JUST FALSE

-- ---- s 1150(2) and (3) (arguments for (2): reasonable; requisite knowledge; the other person is an officer or employee other than an auditor)
#ASSERT `s 1150(2) the valuer may arrange for or accept a valuation made by the other person` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1150(2) the valuer may arrange for or accept a valuation made by the other person` TRUE TRUE TRUE EQUALS NOTHING -- an officer or employee of the company
#ASSERT `s 1150(2) the valuer may arrange for or accept a valuation made by the other person` TRUE FALSE FALSE EQUALS NOTHING -- no requisite knowledge
#ASSERT `s 1150(2) the valuer may arrange for or accept a valuation made by the other person` FALSE TRUE FALSE EQUALS NOTHING -- not reasonable
#ASSERT `s 1150(3) the person counts as an officer or employee for subsection (2)(b)` TRUE EQUALS JUST FALSE
#ASSERT `s 1150(3) the person counts as an officer or employee for subsection (2)(b)` FALSE EQUALS NOTHING

-- ---- s 1150(4)
#ASSERT `s 1150(4) the requirement as to the valuer's report applies` TRUE EQUALS JUST TRUE
#ASSERT `s 1150(4) the requirement as to the valuer's report applies` FALSE EQUALS JUST FALSE
-- (arguments: valued by another; states that fact; the name; knowledge and experience; describes the consideration; the method; the date)
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- does not state the fact
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- no name
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- no knowledge and experience
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- does not describe what was valued
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- no method
#ASSERT `s 1150(4) the valuer's report contains what is required` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- no date
#ASSERT `s 1150(4) the valuer's report contains what is required` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- the valuer valued it all: nothing is required

-- ---- s 1151(1) (arguments: officer or employee of the company; partner or employee of such a person; officer or employee of an associated undertaking; partner or employee of that; a regulations connection)
#ASSERT `s 1151(1) the person meets the independence requirement` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1151(1) the person meets the independence requirement` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- (a)(i)
#ASSERT `s 1151(1) the person meets the independence requirement` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- (a)(ii)
#ASSERT `s 1151(1) the person meets the independence requirement` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- (b)(i)
#ASSERT `s 1151(1) the person meets the independence requirement` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- (b)(ii)
#ASSERT `s 1151(1) the person meets the independence requirement` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- (c)
#ASSERT `s 1151(2) the person is regarded as an officer or employee of the company for the independence requirement` TRUE EQUALS JUST FALSE
#ASSERT `s 1151(2) the person is regarded as an officer or employee of the company for the independence requirement` FALSE EQUALS NOTHING
-- (arguments: a parent undertaking of the company; a subsidiary undertaking of the company; a subsidiary undertaking of a parent undertaking of the company)
#ASSERT `s 1151(3) the undertaking is an associated undertaking of the company` TRUE FALSE FALSE EQUALS JUST TRUE -- (a), parent
#ASSERT `s 1151(3) the undertaking is an associated undertaking of the company` FALSE TRUE FALSE EQUALS JUST TRUE -- (a), subsidiary
#ASSERT `s 1151(3) the undertaking is an associated undertaking of the company` FALSE FALSE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 1151(3) the undertaking is an associated undertaking of the company` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- s 1152
#ASSERT `s 1152(2) the other person is an associate of the individual` `s 1152 the individual's spouse or civil partner or minor child or step-child` EQUALS JUST TRUE
#ASSERT `s 1152(2) the other person is an associate of the individual` `s 1152 a body corporate of which the individual is a director` EQUALS JUST TRUE
#ASSERT `s 1152(2) the other person is an associate of the individual` `s 1152 a limited liability partnership of which the individual is a member` EQUALS JUST TRUE -- (6): "member" for "director"
#ASSERT `s 1152(2) the other person is an associate of the individual` `s 1152 an employee or partner of the individual` EQUALS JUST TRUE
#ASSERT `s 1152(2) the other person is an associate of the individual` `s 1152 none of these relationships to the individual` EQUALS JUST FALSE
#ASSERT `s 1152(3) the other person is an associate of the body corporate` `s 1152 a body corporate of which the body is a director` EQUALS JUST TRUE
#ASSERT `s 1152(3) the other person is an associate of the body corporate` `s 1152 a limited liability partnership of which the body is a member` EQUALS JUST TRUE
#ASSERT `s 1152(3) the other person is an associate of the body corporate` `s 1152 a body corporate in the same group as the body` EQUALS JUST TRUE
#ASSERT `s 1152(3) the other person is an associate of the body corporate` `s 1152 an employee or partner of the body or of a body corporate in the same group` EQUALS JUST TRUE
#ASSERT `s 1152(3) the other person is an associate of the body corporate` `s 1152 none of these relationships to the body corporate` EQUALS JUST FALSE
#ASSERT `s 1152(4) the other person is an associate of the partnership that is a legal person` `s 1152 a body corporate of which the partnership is a director` EQUALS JUST TRUE
#ASSERT `s 1152(4) the other person is an associate of the partnership that is a legal person` `s 1152 a limited liability partnership of which the partnership is a member` EQUALS JUST TRUE
#ASSERT `s 1152(4) the other person is an associate of the partnership that is a legal person` `s 1152 an employee of or partner in the partnership` EQUALS JUST TRUE
#ASSERT `s 1152(4) the other person is an associate of the partnership that is a legal person` `s 1152 a person who is an associate of a partner in the partnership` EQUALS JUST TRUE
#ASSERT `s 1152(4) the other person is an associate of the partnership that is a legal person` `s 1152 none of these relationships to the partnership` EQUALS JUST FALSE
#ASSERT `s 1152(5) the other person is an associate of the partnership that is not a legal person` TRUE EQUALS JUST TRUE
#ASSERT `s 1152(5) the other person is an associate of the partnership that is not a legal person` FALSE EQUALS JUST FALSE

-- ---- s 1153(1) (arguments: carrying out a valuation or making a report; information and explanation as he thinks necessary)
#ASSERT `s 1153(1) the person is entitled to require the information and explanation from the officers of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1153(1) the person is entitled to require the information and explanation from the officers of the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1153(1) the person is entitled to require the information and explanation from the officers of the company` FALSE TRUE EQUALS NOTHING

-- ---- s 1153(3) (arguments: made to a person carrying out a valuation or making a report; conveys information that person is entitled to require)
#ASSERT `s 1153(3) the statement is one to which subsection (2) applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1153(3) the statement is one to which subsection (2) applies` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1153(3) the statement is one to which subsection (2) applies` FALSE TRUE EQUALS NOTHING

-- ---- s 1153(2) (arguments: knowingly or recklessly; misleading, false or deceptive in a material particular; the (3) answer)
#ASSERT `s 1153(2) the person commits an offence` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1153(2) the person commits an offence` FALSE TRUE (JUST TRUE) EQUALS NOTHING -- neither knowingly nor recklessly
#ASSERT `s 1153(2) the person commits an offence` TRUE FALSE (JUST TRUE) EQUALS NOTHING -- not misleading, false or deceptive in a material particular
#ASSERT `s 1153(2) the person commits an offence` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- not a statement to which (2) applies
#ASSERT `s 1153(2) the person commits an offence` TRUE TRUE NOTHING EQUALS NOTHING

-- ---- s 1153(4): the four modes of conviction, written out by hand from the text
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on conviction on indictment` (JUST TRUE) EQUALS JUST (Penalty WITH `how convicted` IS `on conviction on indictment`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 2, unit IS Years), `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on summary conviction in England and Wales` (JUST TRUE) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 12, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on summary conviction in Scotland` (JUST TRUE) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 6, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on summary conviction in Northern Ireland` (JUST TRUE) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS JUST (Period WITH `number of units` IS 6, unit IS Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on summary conviction` (JUST TRUE) EQUALS NOTHING -- the part of the United Kingdom is not stated
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on conviction on indictment` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1153(4) the penalty for an offence under s 1153(2)` `on conviction on indictment` NOTHING EQUALS NOTHING

-- ---- s 1150(4) as a regulative rule: the valuer states what is required. The text gives no time limit, so there is no
-- breach to trace; expected FULFILLED:
#TRACE `s 1150(4) the valuer must state in the report what is required` AT 0 WITH
    PARTY `s 1150 the valuer` DOES `s 1150 state in the report that another person valued the consideration, and give that person's name, knowledge and experience, what was valued, the method and the date` AT 1
