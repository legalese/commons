IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa20-part26`
IMPORT `coa20-part26a`
IMPORT `coa20-part27-merger`

-- coa20-tests-part27-merger.l4: tests for coa20-part27-merger.l4 (ss 902-918A). Every expected value is written from the text of the section
-- named beside it, before the code was run. A requirement function answers a `s 903(1) status of a requirement`; an exclusion answers
-- JUST TRUE (the requirement does not apply), JUST FALSE (it does) or NOTHING (not known). T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Tests -- s 902 Application of this Part`
-- s 902(1): all of (a) a public company, a compromise proposed, for a scheme of reconstruction or amalgamation, (c) shares the consideration; and (b) a merger or a division
#ASSERT `s 902(1) this Part applies` TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 902(1) this Part applies` TRUE TRUE TRUE (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 902(1) this Part applies` TRUE TRUE TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 902(1) this Part applies` TRUE TRUE TRUE NOTHING (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 902(1) this Part applies` FALSE TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 902(1) this Part applies` TRUE FALSE TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 902(1) this Part applies` TRUE TRUE FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 902(1) this Part applies` TRUE TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 902(2)(a) the company is a new company` TRUE EQUALS JUST TRUE
#ASSERT `s 902(2)(a) the company is a new company` FALSE EQUALS JUST FALSE
#ASSERT `s 902(2)(b) the company is an existing company` FALSE EQUALS JUST TRUE
#ASSERT `s 902(2)(b) the company is an existing company` TRUE EQUALS JUST FALSE
#ASSERT `s 902(3) the winding up of the company takes the compromise or arrangement out of this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 902(3) the winding up of the company takes the compromise or arrangement out of this Part` FALSE EQUALS NOTHING

§ `Tests -- s 903 Relationship of this Part to Parts 26 and 26A`
-- s 903(1): the court must not sanction unless the relevant requirements are complied with (a requirement that does not apply is no bar)
#ASSERT `s 903(1) the requirements of this Part do not bar the court from sanctioning` (LIST `s 903(1) requirement complied with`, `s 903(1) requirement does not apply`) EQUALS JUST TRUE
#ASSERT `s 903(1) the requirements of this Part do not bar the court from sanctioning` (LIST `s 903(1) requirement complied with`, `s 903(1) requirement not complied with`) EQUALS JUST FALSE
#ASSERT `s 903(1) the requirements of this Part do not bar the court from sanctioning` (LIST `s 903(1) requirement not covered`, `s 903(1) requirement complied with`) EQUALS NOTHING
#ASSERT `s 903(1) the requirements of this Part do not bar the court from sanctioning` (LIST `s 903(1) requirement not covered`, `s 903(1) requirement not complied with`) EQUALS JUST FALSE
#ASSERT `s 903(1) the requirements of this Part do not bar the court from sanctioning` EMPTY EQUALS JUST TRUE
#ASSERT `s 903(2) the requirements applicable to a merger do not bar the court from sanctioning` (LIST `s 903(1) requirement complied with`) EQUALS JUST TRUE
#ASSERT `s 903(2) the requirements applicable to a merger do not bar the court from sanctioning` (LIST `s 903(1) requirement not complied with`) EQUALS JUST FALSE
#ASSERT `s 903(3) the requirements applicable to a division do not bar the court from sanctioning` (LIST `s 903(1) requirement does not apply`) EQUALS JUST TRUE
#ASSERT `s 903(3) the requirements applicable to a division do not bar the court from sanctioning` (LIST `s 903(1) requirement not covered`) EQUALS NOTHING

§ `Tests -- s 904 Mergers and merging companies`
#ASSERT `s 904(1)(a) the scheme involves a merger by absorption` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 904(1)(a) the scheme involves a merger by absorption` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 904(1)(a) the scheme involves a merger by absorption` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 904(1)(b) the scheme involves a merger by formation of a new company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 904(1)(b) the scheme involves a merger by formation of a new company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 904(1)(b) the scheme involves a merger by formation of a new company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 904(1) the scheme involves a merger` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 904(1) the scheme involves a merger` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 904(1) the scheme involves a merger` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 904(1) the scheme involves a merger` (JUST FALSE) NOTHING EQUALS NOTHING
-- s 904(2): absorption: transferor and transferee; formation: the transferor companies only
#ASSERT `s 904(2) the company is one of the merging companies` `s 904(1)(a) a merger by absorption` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 904(2) the company is one of the merging companies` `s 904(1)(a) a merger by absorption` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 904(2) the company is one of the merging companies` `s 904(1)(a) a merger by absorption` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 904(2) the company is one of the merging companies` `s 904(1)(b) a merger by formation of a new company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 904(2) the company is one of the merging companies` `s 904(1)(b) a merger by formation of a new company` FALSE TRUE EQUALS JUST FALSE

