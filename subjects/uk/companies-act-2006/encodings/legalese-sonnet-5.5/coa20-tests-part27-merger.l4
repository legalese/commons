#ASSERT `s 910(4) the balance sheet has been approved and signed as section 414 provides` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 910(5) the report is a half-yearly financial report` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 910(5) the report is a half-yearly financial report` NOTHING EQUALS NOTHING
