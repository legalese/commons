IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa24-disclosure`

-- coa24-tests-disclosure.l4: tests for ss 1110E to 1110G (coa24-disclosure.l4). Expected values decided from the text before the run.

§ `Tests for s 1110E and s 1110F`

#ASSERT `s 1110E the person may disclose the information to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 1110E the person may disclose the information to the registrar` FALSE EQUALS NOTHING

#ASSERT `s 1110F(1) the registrar may disclose the information` `s 1110F(1)(a) any person, for purposes connected with the exercise of any of the registrar's functions` EQUALS JUST TRUE
#ASSERT `s 1110F(1) the registrar may disclose the information` `s 1110F(1)(b) a public authority, for purposes connected with the exercise of any of that public authority's functions` EQUALS JUST TRUE
#ASSERT `s 1110F(1) the registrar may disclose the information` `s 1110F(1)(c) a person of a description, and for a purpose, specified in regulations made by the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 1110F(1) the registrar may disclose the information` `s 1110F(1) another recipient or purpose` EQUALS NOTHING
#ASSERT `s 1110F(3) the person or body is a public authority` TRUE EQUALS JUST TRUE
#ASSERT `s 1110F(3) the person or body is a public authority` FALSE EQUALS NOTHING

§ `Tests for s 1110G`

-- (1): disclosure under s 1110E or 1110F does not breach confidence or any other restriction, except as (2) provides.
#ASSERT `s 1110G(1) the disclosure breaches an obligation of confidence or any other restriction on the disclosure of information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1110G(1) the disclosure breaches an obligation of confidence or any other restriction on the disclosure of information` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1110G(1) the disclosure breaches an obligation of confidence or any other restriction on the disclosure of information` FALSE FALSE EQUALS NOTHING
-- (2): ss 1110E and 1110F do not authorise a disclosure that would contravene the data protection legislation.
#ASSERT `s 1110G(2) sections 1110E and 1110F authorise the disclosure` TRUE EQUALS JUST FALSE
#ASSERT `s 1110G(2) sections 1110E and 1110F authorise the disclosure` FALSE EQUALS NOTHING
-- (3): HMRC information may not be disclosed by the registrar under s 1110F without authorisation from HMRC.
#ASSERT `s 1110G(3) the registrar may disclose the information under section 1110F` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1110G(3) the registrar may disclose the information under section 1110F` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1110G(3) the registrar may disclose the information under section 1110F` FALSE FALSE EQUALS NOTHING
-- (4): the recipient, and anyone obtaining it from them, must not disclose it without authorisation from HMRC.
#ASSERT `s 1110G(4) the recipient, or a person obtaining the information from the recipient, may disclose the information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1110G(4) the recipient, or a person obtaining the information from the recipient, may disclose the information` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1110G(4) the recipient, or a person obtaining the information from the recipient, may disclose the information` FALSE FALSE EQUALS NOTHING
-- (5): the offence.
#ASSERT `s 1110G(5) the person commits an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(5) the person commits an offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1110G(5) the person commits an offence` FALSE TRUE EQUALS NOTHING
-- (6): a defence for a person who proves a reasonable belief that the disclosure was lawful or that the information was already lawfully public.
#ASSERT `s 1110G(6) this section gives a defence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1110G(6) this section gives a defence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(6) this section gives a defence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(6) this section gives a defence` FALSE FALSE EQUALS JUST FALSE
-- (7)
#ASSERT `s 1110G(7) subsections (4) to (7) of section 19 of the Commissioners for Revenue and Customs Act 2005 apply to the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(7) subsections (4) to (7) of section 19 of the Commissioners for Revenue and Customs Act 2005 apply to the offence` FALSE EQUALS NOTHING
-- (8): defined terms.
#ASSERT `s 1110G(8) the information is HMRC information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(8) the information is HMRC information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1110G(8) the information is HMRC information` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1110G(8) the body is HMRC` TRUE EQUALS JUST TRUE
#ASSERT `s 1110G(8) the body is HMRC` FALSE EQUALS JUST FALSE
#ASSERT `s 1110G(8) the provision that gives the meaning of "the data protection legislation"` EQUALS "section 3 of the Data Protection Act 2018"
#ASSERT `s 1110G(8) the provision that gives the meaning of "revenue and customs information relating to a person"` EQUALS "section 19(2) of the Commissioners for Revenue and Customs Act 2005"
