-- test scaffolding only (no expected value in the encoding is read through these): convert a penalty's imprisonment ceiling to months.
GIVEN per IS A Period
GIVETH A NUMBER
`months of` MEANS
  CONSIDER per
  WHEN Period n u THEN
    CONSIDER u
    WHEN Years THEN n * 12
    WHEN Months THEN n
    WHEN Weeks THEN 0 - 1
    WHEN Days THEN 0 - 1
    WHEN `Working days` THEN 0 - 1

GIVEN p IS A MAYBE Penalty
GIVETH A MAYBE NUMBER
`imprisonment in months` MEANS
  CONSIDER p
  WHEN NOTHING THEN NOTHING
  WHEN JUST (Penalty h i f d t) THEN
    CONSIDER i
    WHEN NOTHING THEN NOTHING
    WHEN JUST per THEN JUST (`months of` per)

