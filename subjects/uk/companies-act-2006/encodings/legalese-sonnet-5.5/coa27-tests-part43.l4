-- (3) the burden on foreign-traded issuers must not be greater than on UK-traded issuers (illustrative measures)
#ASSERT `s 1269 FSMA 89O(3) the burden on foreign-traded issuers is within the limit` 5 5 EQUALS JUST TRUE
#ASSERT `s 1269 FSMA 89O(3) the burden on foreign-traded issuers is within the limit` 4 5 EQUALS JUST TRUE
#ASSERT `s 1269 FSMA 89O(3) the burden on foreign-traded issuers is within the limit` 6 5 EQUALS JUST FALSE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a foreign-traded issuer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a foreign-traded issuer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a foreign-traded issuer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a UK-traded issuer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a UK-traded issuer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1269 FSMA 89O(4) the issuer is a UK-traded issuer` FALSE TRUE EQUALS JUST FALSE

-- ---- s 1270 (90A)
-- (1) the publications: (a) reports and statements in response to Article 4, 5 or 6 requirements; (b) a preliminary statement before an Article 4 report, to the extent its information is intended to appear in the report in substantially the same form
#ASSERT `s 1270 FSMA 90A(1) the publication is one to which this section applies` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(1) the publication is one to which this section applies` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(1) the publication is one to which this section applies` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(1) the publication is one to which this section applies` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(1) the publication is one to which this section applies` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- (2) the securities: (a) traded on a UK regulated market; (b) traded on a regulated market outside the UK and issued by an issuer for which the UK is the home Member State
#ASSERT `s 1270 FSMA 90A(2) the securities are ones to which this section applies` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(2) the securities are ones to which this section applies` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(2) the securities are ones to which this section applies` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(2) the securities are ones to which this section applies` FALSE FALSE TRUE EQUALS JUST FALSE
-- (3) the issuer is liable to a person who has acquired the securities and suffered loss as a result of an untrue or misleading statement, or an omission
#ASSERT `s 1270 FSMA 90A(3) the issuer is liable to pay compensation to the person` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(3) the issuer is liable to pay compensation to the person` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(3) the issuer is liable to pay compensation to the person` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(3) the issuer is liable to pay compensation to the person` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(3) the issuer is liable to pay compensation to the person` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- (4) liable only if a person discharging managerial responsibilities knew the statement untrue or misleading (or was reckless), or knew the omission to be dishonest concealment of a material fact
#ASSERT `s 1270 FSMA 90A(4) the limit on the issuer's liability is satisfied` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(4) the limit on the issuer's liability is satisfied` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(4) the limit on the issuer's liability is satisfied` FALSE FALSE EQUALS JUST FALSE
-- (5) a loss is not regarded as suffered as a result unless acquired in reliance and at a time and in circumstances in which it was reasonable to rely
#ASSERT `s 1270 FSMA 90A(5) the loss is regarded as suffered as a result of the statement or omission` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(5) the loss is regarded as suffered as a result of the statement or omission` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(5) the loss is regarded as suffered as a result of the statement or omission` FALSE TRUE EQUALS JUST FALSE
-- (3)-(5) together
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- subsection (3) does not reach the case: the limits cannot create a liability
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- a limit that fails is the text's no, whatever else is not covered
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(3)-(5) the issuer is liable to pay compensation` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
-- (9)(a) persons discharging managerial responsibilities; (9)(b) acquisition includes contracting to acquire
#ASSERT `s 1270 FSMA 90A(9)(a) the person is a person discharging managerial responsibilities in relation to the publication` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(a) the person is a person discharging managerial responsibilities in relation to the publication` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(a) the person is a person discharging managerial responsibilities in relation to the publication` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(a) the person is a person discharging managerial responsibilities in relation to the publication` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(9)(b) the person has acquired securities` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(b) the person has acquired securities` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(b) the person has acquired securities` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(9)(b) the person has acquired securities` FALSE FALSE FALSE EQUALS NOTHING
-- (6) no other liability, except as mentioned in (8)
#ASSERT `s 1270 FSMA 90A(6)(a) the issuer is subject to a liability other than that provided for by this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1270 FSMA 90A(6)(a) the issuer is subject to a liability other than that provided for by this section` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(6)(a) the issuer is subject to a liability other than that provided for by this section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(6)(b) a person other than the issuer is subject to a liability` TRUE FALSE FALSE EQUALS JUST FALSE
-- a liability to the issuer is the exception
#ASSERT `s 1270 FSMA 90A(6)(b) a person other than the issuer is subject to a liability` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(6)(b) a person other than the issuer is subject to a liability` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1270 FSMA 90A(6)(b) a person other than the issuer is subject to a liability` FALSE FALSE FALSE EQUALS NOTHING
-- (7) includes another person's entitlement to a civil remedy or to rescind or repudiate an agreement
#ASSERT `s 1270 FSMA 90A(7) he is subject to a liability` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(7) he is subject to a liability` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1270 FSMA 90A(7) he is subject to a liability` FALSE FALSE EQUALS NOTHING
