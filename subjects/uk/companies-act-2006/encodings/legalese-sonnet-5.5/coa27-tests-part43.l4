#ASSERT `s 1267 FSMA 89J(3) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89J(3) the matter is specified` FALSE EQUALS JUST FALSE
#ASSERT `s 1267 FSMA 89J(3) the person is a voteholder` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89J(3) the person is a voteholder` FALSE TRUE EQUALS JUST TRUE
