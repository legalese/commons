IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa27-part43`

-- coa27-tests-part43.l4: tests for coa27-part43.l4 (ss 1265 to 1271; FSMA ss 89A to 89O, 90A, 100A as inserted).
-- Expected values are decided from the text and written beside each assertion.

-- ---- s 1265: "the transparency obligations directive" means Directive 2004/109/EC
#ASSERT `s 1265 FSMA 103(1) the instrument is the transparency obligations directive` TRUE EQUALS JUST TRUE
#ASSERT `s 1265 FSMA 103(1) the instrument is the transparency obligations directive` FALSE EQUALS JUST FALSE

-- ---- s 89A(5), 89B(3), 89B(7), 89D(4)
#ASSERT `s 1266 FSMA 89A(5) the rules are transparency rules` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89A(5) the rules are transparency rules` FALSE EQUALS NOTHING
#ASSERT `s 1266 FSMA 89B(3) the information is voteholder information` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(3) the information is voteholder information` FALSE EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89B(7) the proportion is designated` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(7) the proportion is designated` FALSE EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89D(4) the proportion is designated` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89D(4) the proportion is designated` FALSE EQUALS JUST FALSE

-- ---- s 89B(6): "notifiable change": (a) from less than a designated proportion to equal or greater; (b) from equal to greater or less; (c) from greater to equal or less. Designated proportion: 0.05 (an illustrative input)
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.04 0.05 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.04 0.06 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.05 0.06 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.05 0.04 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.06 0.05 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.06 0.04 0.05 EQUALS JUST TRUE
-- no change across the designated proportion
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.03 0.04 0.05 EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.06 0.07 0.05 EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89B(6) there is a notifiable change in the proportion of voting rights held by a person` 0.05 0.05 0.05 EQUALS JUST FALSE
-- s 89D(3): the same words for the proportion held by an issuer
#ASSERT `s 1266 FSMA 89D(3) there is a notifiable change in the proportion of voting rights held by a person` 0.04 0.05 0.05 EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89D(3) there is a notifiable change in the proportion of voting rights held by a person` 0.03 0.04 0.05 EQUALS JUST FALSE

-- ---- s 89F
#ASSERT `s 1266 FSMA 89F(1)(a) the voting rights are the voting rights in respect of the voting shares` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(1)(a) the voting rights are the voting rights in respect of the voting shares` FALSE EQUALS JUST FALSE
-- (1)(b): regarded as holding if (i) a shareholder within Article 2.1(e), (ii) entitled in a case in Article 10(a) to (h), (iii) holds a financial instrument that results in an entitlement to acquire the shares and is an Article 13 instrument
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE
-- holds a financial instrument that is not an Article 13 instrument: limb (iii) fails
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST FALSE
-- borrowed answers not known: not covered, never FALSE
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` NOTHING (JUST FALSE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) NOTHING FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) the person is regarded as holding the voting rights in respect of the shares` NOTHING (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST TRUE
-- the helper is a Kleene "or"
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 1266 FSMA 89F(1)(b) either answer holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
-- (1)(c): comparable instrument
#ASSERT `s 1266 FSMA 89F(1)(c) the person holds a comparable instrument in respect of the voting shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(1)(c) the person holds a comparable instrument in respect of the voting shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89F(1)(c) the person holds a comparable instrument in respect of the voting shares` FALSE TRUE EQUALS JUST FALSE
-- (3) two or more persons may each be regarded as holding the same voting rights
#ASSERT `s 1266 FSMA 89F(3) two or more persons may each be regarded as holding the same voting rights` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(3) two or more persons may each be regarded as holding the same voting rights` TRUE FALSE EQUALS NOTHING
-- (4) definitions
#ASSERT `s 1266 FSMA 89F(4) the instrument is an Article 13 instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(4) the instrument is an Article 13 instrument` FALSE EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89F(4) the market is a UK market` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(4) the market is a UK market` FALSE EQUALS JUST FALSE
#ASSERT `s 1266 FSMA 89F(4) the shares are voting shares` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89F(4) the shares are voting shares` FALSE EQUALS JUST FALSE
-- 89G(3)
#ASSERT `s 1266 FSMA 89G(3) the competent authority may make the information public` TRUE EQUALS JUST TRUE
#ASSERT `s 1266 FSMA 89G(3) the competent authority may make the information public` FALSE EQUALS NOTHING

-- ---- s 1267 (89H to 89J)
-- 89H(2) the persons
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(a) an issuer in respect of whom transparency rules have effect` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(b) a voteholder` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(c) an auditor of an issuer to whom this section applies or of a voteholder` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(d) a person who controls a voteholder` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(e) a person controlled by a voteholder` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(f) a director or other similar officer of an issuer to whom this section applies` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2)(g) a director or other similar officer of a voteholder or, where its affairs are managed by its members, a member of the voteholder` EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(2) this section applies to the person` `s 1267 FSMA 89H(2) another kind of person` EQUALS NOTHING
-- 89H(1) and (3): by written notice, to a person to whom it applies, for information reasonably required in connection with functions under ss 89A to 89G
#ASSERT `s 1267 FSMA 89H(1) the person must provide the information or produce the documents` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(1) the person must provide the information or produce the documents` FALSE (JUST TRUE) TRUE EQUALS NOTHING
-- applies "only to information and documents reasonably required"
#ASSERT `s 1267 FSMA 89H(1) the person must provide the information or produce the documents` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1267 FSMA 89H(1) the person must provide the information or produce the documents` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 1267 FSMA 89H(1) the person must provide the information or produce the documents` TRUE (JUST FALSE) TRUE EQUALS NOTHING
-- 89H(4): the period specified (last day 30 June 2027) and the place specified
#ASSERT `s 1267 FSMA 89H(4) the information was provided or the documents were produced as the section requires` (Date 30 6 2027) (Date 30 6 2027) TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(4) the information was provided or the documents were produced as the section requires` (Date 30 6 2027) (Date 29 6 2027) TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89H(4) the information was provided or the documents were produced as the section requires` (Date 30 6 2027) (Date 1 7 2027) TRUE EQUALS JUST FALSE
#ASSERT `s 1267 FSMA 89H(4) the information was provided or the documents were produced as the section requires` (Date 30 6 2027) (Date 29 6 2027) FALSE EQUALS JUST FALSE
-- 89H(5): production does not affect a lien
#ASSERT `s 1267 FSMA 89H(5) the production of the document under this section affects the lien` TRUE EQUALS JUST FALSE
#ASSERT `s 1267 FSMA 89H(5) the production of the document under this section affects the lien` FALSE EQUALS NOTHING
-- 89I(1)-(2)
#ASSERT `s 1267 FSMA 89I(1)-(2) the competent authority may impose the requirement` `s 1267 FSMA 89I(1) that information provided be in a form it reasonably requires` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(1)-(2) the competent authority may impose the requirement` `s 1267 FSMA 89I(2)(a) that information provided be verified in a manner it reasonably requires` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(1)-(2) the competent authority may impose the requirement` `s 1267 FSMA 89I(2)(b) that a document produced be authenticated in a manner it reasonably requires` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(1)-(2) the competent authority may impose the requirement` `s 1267 FSMA 89I(1) that information provided be in a form it reasonably requires` FALSE EQUALS NOTHING
-- 89I(3)
#ASSERT `s 1267 FSMA 89I(3) the competent authority may take the step` `s 1267 FSMA 89I(3)(a) take copies of or extracts from the document` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(3) the competent authority may take the step` `s 1267 FSMA 89I(3)(b) require the person producing the document, or any relevant person, to provide an explanation of the document` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1267 FSMA 89I(3) the competent authority may take the step` `s 1267 FSMA 89I(3)(a) take copies of or extracts from the document` FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q8)
#ASSERT `s 1267 FSMA 89I(3) the competent authority may take the step` `s 1267 FSMA 89I(3)(a) take copies of or extracts from the document` FALSE EQUALS NOTHING
-- 89I(4) "relevant person"
#ASSERT `s 1267 FSMA 89I(4) the person is a relevant person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(4) the person is a relevant person` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(4) the person is a relevant person` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(4) the person is a relevant person` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89I(4) the person is a relevant person` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 89I(5)
#ASSERT `s 1267 FSMA 89I(5) the competent authority may require him to state where the document is` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 1267 FSMA 89I(5) the competent authority may require him to state where the document is` FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q9)
#ASSERT `s 1267 FSMA 89I(5) the competent authority may require him to state where the document is` FALSE EQUALS NOTHING
-- 89J(1), (2)
#ASSERT `s 1267 FSMA 89J(1) the competent authority may require the issuer to make public the information` TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89J(1) the competent authority may require the issuer to make public the information` FALSE EQUALS NOTHING
#ASSERT `s 1267 FSMA 89J(2) the competent authority may make the information public` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1267 FSMA 89J(2) the competent authority may make the information public` TRUE FALSE EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 1267 FSMA 89J(2) the competent authority may make the information public` FALSE TRUE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q10)
#ASSERT `s 1267 FSMA 89J(2) the competent authority may make the information public` FALSE TRUE EQUALS NOTHING
