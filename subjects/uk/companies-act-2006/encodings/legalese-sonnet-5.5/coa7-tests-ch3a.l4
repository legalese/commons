IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch3a`

-- coa7-tests-ch3a.l4: tests for coa7-ch3a.l4 (Part 13 Chapter 3, ss 301 to 306).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 3, ss 301 to 306`

-- s 301: validly passed if notice is given AND the meeting is held and conducted in accordance with the Chapter and the articles
#ASSERT `s 301 the resolution is validly passed at the general meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 301 the resolution is validly passed at the general meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 301 the resolution is validly passed at the general meeting` FALSE TRUE EQUALS JUST FALSE
-- s 302
#ASSERT `s 302 the directors may call a general meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 302 the directors may call a general meeting` FALSE EQUALS NOTHING
-- s 303(1)
#ASSERT `s 303(1) the members may require the directors to call a general meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 303(1) the members may require the directors to call a general meeting` FALSE EQUALS NOTHING
-- s 303(2): at least 5%: share capital (5 of 100 of the voting paid-up capital), or no share capital (5 of 100 voting rights)
#ASSERT `s 303(2) the directors are required to call a general meeting` TRUE 5 100 0 0 EQUALS JUST TRUE
#ASSERT `s 303(2) the directors are required to call a general meeting` TRUE 4 100 0 0 EQUALS JUST FALSE
#ASSERT `s 303(2) the directors are required to call a general meeting` FALSE 0 0 5 100 EQUALS JUST TRUE
#ASSERT `s 303(2) the directors are required to call a general meeting` FALSE 0 0 4 100 EQUALS JUST FALSE
-- s 303(4)(a): the request must state the general nature of the business
#ASSERT `s 303(4)(a) the request meets this requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 303(4)(a) the request meets this requirement` FALSE EQUALS JUST FALSE
-- s 303(5): may properly be moved unless ineffective, defamatory, or frivolous or vexatious
#ASSERT `s 303(5) the resolution may properly be moved at the meeting` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 303(5) the resolution may properly be moved at the meeting` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 303(5) the resolution may properly be moved at the meeting` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 303(5) the resolution may properly be moved at the meeting` FALSE FALSE TRUE EQUALS JUST FALSE
-- s 303(4)(b): the request may include the text of a resolution that may properly be moved and is intended to be moved
#ASSERT `s 303(4)(b) the request may include the text of the resolution` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 303(4)(b) the request may include the text of the resolution` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 303(4)(b) the request may include the text of the resolution` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 303(4)(b) the request may include the text of the resolution` NOTHING TRUE EQUALS NOTHING
-- s 303(6)
#ASSERT `s 303(6) the request meets the requirements of this subsection` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 303(6) the request meets the requirements of this subsection` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 303(6) the request meets the requirements of this subsection` FALSE TRUE EQUALS NOTHING

-- s 304(1)(a): within 21 days from the date on which they become subject to the requirement (1 March + 21 is 22 March)
#ASSERT `s 304(1)(a) the directors called the meeting in time` (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST TRUE
#ASSERT `s 304(1)(a) the directors called the meeting in time` (Date 1 3 2026) (Date 23 3 2026) EQUALS JUST FALSE
-- s 304(1)(b): held on a date not more than 28 days after the date of the notice (1 March + 28 is 29 March)
#ASSERT `s 304(1)(b) the meeting is to be held in time` (Date 1 3 2026) (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 304(1)(b) the meeting is to be held in time` (Date 1 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
-- s 304(2)
#ASSERT `s 304(2) the notice of the meeting must include notice of the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 304(2) the notice of the meeting must include notice of the resolution` FALSE EQUALS JUST FALSE
-- s 304(3): includes
#ASSERT `s 304(3) the resolution is business that may be dealt with at the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 304(3) the resolution is business that may be dealt with at the meeting` FALSE EQUALS NOTHING
-- s 304(4): a special resolution not noticed in accordance with s 283: the directors are treated as not having duly called the meeting
#ASSERT `s 304(4) the directors are treated as not having duly called the meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 304(4) the directors are treated as not having duly called the meeting` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 304(4) the directors are treated as not having duly called the meeting` FALSE FALSE EQUALS JUST FALSE

-- s 305(1): the requesting members (all of them) or any of them representing more than one half of the total voting rights of all of them
#ASSERT `s 305(1) the members may themselves call a general meeting` TRUE TRUE 10 10 EQUALS JUST TRUE
#ASSERT `s 305(1) the members may themselves call a general meeting` TRUE TRUE 6 10 EQUALS JUST TRUE
#ASSERT `s 305(1) the members may themselves call a general meeting` TRUE TRUE 5 10 EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 305(1) the members may themselves call a general meeting` FALSE TRUE 10 10 EQUALS JUST FALSE; s 305(1) is named for a power (the members may themselves call a meeting) and its gate is an 'If' that the text does not close with 'only'; a gate that fails is not the text's no, so NOTHING (fork F22, name-test sweep); the facts are unchanged, JUST FALSE becomes NOTHING.
#ASSERT `s 305(1) the members may themselves call a general meeting` FALSE TRUE 10 10 EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 305(1) the members may themselves call a general meeting` TRUE FALSE 10 10 EQUALS JUST FALSE; s 305(1) is named for a power (the members may themselves call a meeting) and its gate is an 'If' that the text does not close with 'only'; a gate that fails is not the text's no, so NOTHING (fork F22, name-test sweep); the facts are unchanged, JUST FALSE becomes NOTHING.
#ASSERT `s 305(1) the members may themselves call a general meeting` TRUE FALSE 10 10 EQUALS NOTHING
-- s 305(2)
#ASSERT `s 305(2) the notice of the meeting must include notice of the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 305(2) the notice of the meeting must include notice of the resolution` FALSE EQUALS JUST FALSE
-- s 305(3): not more than three months after the directors become subject to the requirement (1 January + 3 months is 1 April)
#ASSERT `s 305(3) the meeting is called for a date in time` (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 305(3) the meeting is called for a date in time` (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST FALSE
-- s 305(4)
#ASSERT `s 305(4) the meeting is called in the manner this subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 305(4) the meeting is called in the manner this subsection requires` FALSE EQUALS JUST FALSE
-- s 305(5)
#ASSERT `s 305(5) the resolution is business that may be dealt with at the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 305(5) the resolution is business that may be dealt with at the meeting` FALSE EQUALS NOTHING
-- s 305(6): reasonable expenses incurred by reason of the directors' failure must be reimbursed
#ASSERT `s 305(6) the company must reimburse the expenses` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 305(6) the company must reimburse the expenses` TRUE FALSE EQUALS NOTHING
#ASSERT `s 305(6) the company must reimburse the expenses` FALSE TRUE EQUALS NOTHING
-- s 305(7)
#ASSERT `s 305(7) the company shall retain the sum out of the sums due to the director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 305(7) the company shall retain the sum out of the sums due to the director` TRUE FALSE EQUALS NOTHING
#ASSERT `s 305(7) the company shall retain the sum out of the sums due to the director` FALSE TRUE EQUALS NOTHING

-- s 306(1): applies if for any reason it is impracticable to call, or to conduct, a meeting
#ASSERT `s 306(1) this section applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 306(1) this section applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 306(1) this section applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 306(1) this section applies` FALSE FALSE EQUALS JUST FALSE
-- s 306(2): on its own motion, or on the application of a director or of a member entitled to vote at the meeting
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST TRUE) `s 306(2) the court of its own motion` EQUALS JUST TRUE
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST TRUE) `s 306(2)(a) a director of the company` EQUALS JUST TRUE
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST TRUE) `s 306(2)(b) a member of the company who would be entitled to vote at the meeting` EQUALS JUST TRUE
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST TRUE) `s 306(2) another person` EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST FALSE) `s 306(2)(a) a director of the company` EQUALS JUST FALSE; s 306(2) is named for a power (the court may order) and its gate is 'This section applies if', which the text does not close with 'only'; a failed gate is NOTHING (fork F22, name-test sweep); the facts are unchanged, JUST FALSE becomes NOTHING.
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` (JUST FALSE) `s 306(2)(a) a director of the company` EQUALS NOTHING
#ASSERT `s 306(2) the court may order a meeting to be called, held and conducted in any manner the court thinks fit` NOTHING `s 306(2)(a) a director of the company` EQUALS NOTHING
-- s 306(3), (4), (5)
#ASSERT `s 306(3) the court may give ancillary or consequential directions` TRUE EQUALS JUST TRUE
#ASSERT `s 306(3) the court may give ancillary or consequential directions` FALSE EQUALS JUST FALSE
#ASSERT `s 306(4) the directions may include a direction that one member present be deemed to constitute a quorum` TRUE EQUALS JUST TRUE
#ASSERT `s 306(4) the directions may include a direction that one member present be deemed to constitute a quorum` FALSE EQUALS NOTHING
#ASSERT `s 306(5) the meeting is deemed for all purposes to be a meeting of the company duly called, held and conducted` TRUE EQUALS JUST TRUE
#ASSERT `s 306(5) the meeting is deemed for all purposes to be a meeting of the company duly called, held and conducted` FALSE EQUALS NOTHING
