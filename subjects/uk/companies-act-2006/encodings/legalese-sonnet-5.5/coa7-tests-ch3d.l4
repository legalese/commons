IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch3d`

-- coa7-tests-ch3d.l4: tests for coa7-ch3d.l4 (Part 13 Chapter 3, ss 324 to 335).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 3, ss 324 to 335`

-- s 324(1), (2)
#ASSERT `s 324(1) the member is entitled to appoint the person as his proxy` TRUE EQUALS JUST TRUE
#ASSERT `s 324(1) the member is entitled to appoint the person as his proxy` FALSE EQUALS NOTHING
#ASSERT `s 324(2) the member may appoint more than one proxy in relation to the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 324(2) the member may appoint more than one proxy in relation to the meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 324(2) the member may appoint more than one proxy in relation to the meeting` FALSE TRUE EQUALS NOTHING
-- s 324A: a proxy must vote in accordance with any instructions
#ASSERT `s 324A the proxy has complied with the instructions given by the member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 324A the proxy has complied with the instructions given by the member` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 324A the proxy has complied with the instructions given by the member` FALSE TRUE EQUALS NOTHING
-- s 325(1): a prominent statement of the rights under s 324 and of any more extensive rights under the articles
#ASSERT `s 325(1) the notice contains the statement this subsection requires` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 325(1) the notice contains the statement this subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 325(1) the notice contains the statement this subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 325(1) the notice contains the statement this subsection requires` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 325(1) the notice contains the statement this subsection requires` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 325(2) the failure affects the validity of the meeting or of anything done at the meeting` TRUE EQUALS JUST FALSE
#ASSERT `s 325(2) the failure affects the validity of the meeting or of anything done at the meeting` FALSE EQUALS NOTHING
#ASSERT `s 325(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 325(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 325(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 325(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 325(4) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 325(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 325(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 325(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 325(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
-- s 326(2): not contravened if a form or list is issued at a member's request and is available on request to all members
#ASSERT `s 326(2) subsection (1) is not contravened` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 326(2) subsection (1) is not contravened` TRUE FALSE EQUALS NOTHING
#ASSERT `s 326(2) subsection (1) is not contravened` FALSE TRUE EQUALS NOTHING
-- s 326(1): invitations issued at the company's expense must go to all members entitled to vote (the safe harbour of (2) is passed in: NOTHING there means it does not hold)
#ASSERT `s 326(1) the invitations contravene this subsection` TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 326(1) the invitations contravene this subsection` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 326(1) the invitations contravene this subsection` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 326(1) the invitations contravene this subsection` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 326(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 326(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 326(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 326(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 326(4) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 326(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 326(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 326(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
#ASSERT `s 326(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), NOTHING, FALSE)
-- s 327(A1)(a), (b)
#ASSERT `s 327(A1)(a) the appointment of the proxy has been notified as this paragraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 327(A1)(a) the appointment of the proxy has been notified as this paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 327(A1)(a) the appointment of the proxy has been notified as this paragraph requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 327(A1)(b) the company may require the evidence` TRUE TRUE `s 327(A1)(b)(i) the identity of the member and of the proxy` EQUALS JUST TRUE
#ASSERT `s 327(A1)(b) the company may require the evidence` TRUE TRUE `s 327(A1)(b)(ii) the member's instructions (if any) as to how the proxy is to vote` EQUALS JUST TRUE
#ASSERT `s 327(A1)(b) the company may require the evidence` TRUE TRUE `s 327(A1)(b)(iii) where the proxy is appointed by a person acting on behalf of the member, the authority of that person to make the appointment` EQUALS JUST TRUE
#ASSERT `s 327(A1)(b) the company may require the evidence` TRUE TRUE `s 327(A1)(b) anything else relating to the appointment` EQUALS JUST FALSE
#ASSERT `s 327(A1)(b) the company may require the evidence` FALSE TRUE `s 327(A1)(b)(i) the identity of the member and of the proxy` EQUALS NOTHING
#ASSERT `s 327(A1)(b) the company may require the evidence` TRUE FALSE `s 327(A1)(b)(i) the identity of the member and of the proxy` EQUALS NOTHING
-- s 327(1)
#ASSERT `s 327(1) the following provisions apply in the case of traded companies and other companies as regards the matter` `s 327(1)(a) the appointment of a proxy` EQUALS JUST TRUE
#ASSERT `s 327(1) the following provisions apply in the case of traded companies and other companies as regards the matter` `s 327(1)(b) any document necessary to show the validity of, or otherwise relating to, the appointment of a proxy` EQUALS JUST TRUE
#ASSERT `s 327(1) the following provisions apply in the case of traded companies and other companies as regards the matter` `s 327(1) another matter` EQUALS NOTHING
-- s 327(3), (2): 48 hours before a meeting, or 24 hours before a poll taken more than 48 hours after it was demanded; non-working-day hours do not count
#ASSERT `s 327(3) the hours of the period that are counted` 48 0 EQUALS 48
#ASSERT `s 327(3) the hours of the period that are counted` 72 24 EQUALS 48
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 48 0 EQUALS NOTHING
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 49 0 EQUALS JUST TRUE
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 72 24 EQUALS NOTHING
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 73 24 EQUALS JUST TRUE
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(b) in the case of a poll taken more than 48 hours after it was demanded, 24 hours before the time appointed for the taking of the poll` 24 0 EQUALS NOTHING
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2)(b) in the case of a poll taken more than 48 hours after it was demanded, 24 hours before the time appointed for the taking of the poll` 25 0 EQUALS JUST TRUE
#ASSERT `s 327(2) the provision of the articles is void` `s 327(2) another case` 100 0 EQUALS NOTHING

-- s 328
#ASSERT `s 328(1) the proxy may be elected chairman of the general meeting` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 328(1) the proxy may be elected chairman of the general meeting` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 328(1) the proxy may be elected chairman of the general meeting` FALSE TRUE FALSE EQUALS NOTHING
-- s 329(1), (2)
#ASSERT `s 329(1) the proxy is authorised to demand, or join in demanding, a poll on the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 329(1) the proxy is authorised to demand, or join in demanding, a poll on the matter` FALSE EQUALS NOTHING
#ASSERT `s 329(2) the demand by the proxy counts` TRUE `s 329(2)(a) paragraph (a) of section 321(2)` EQUALS JUST `s 329(2)(a) a demand by the member`
#ASSERT `s 329(2) the demand by the proxy counts` TRUE `s 329(2)(b) paragraph (b) of section 321(2)` EQUALS JUST `s 329(2)(b) a demand by a member representing the voting rights that the proxy is authorised to exercise`
#ASSERT `s 329(2) the demand by the proxy counts` TRUE `s 329(2)(c) paragraph (c) of section 321(2)` EQUALS JUST `s 329(2)(c) a demand by a member holding the shares to which those rights are attached`
#ASSERT `s 329(2) the demand by the proxy counts` FALSE `s 329(2)(a) paragraph (a) of section 321(2)` EQUALS NOTHING

-- s 330(A1), (1)
#ASSERT `s 330(A1) the termination has been notified as this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(A1) the termination has been notified as this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(A1) the termination has been notified as this subsection requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 330(1) the following provisions apply in the case of traded companies and other companies as regards the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 330(1) the following provisions apply in the case of traded companies and other companies as regards the matter` FALSE EQUALS NOTHING
-- s 330(2): termination does not affect quorum, chairman's acts or a poll he demanded, unless notice reaches the company before the meeting starts
#ASSERT `s 330(2) the termination of the authority of the person to act as proxy does not affect the matter` `s 330(2)(a) whether he counts in deciding whether there is a quorum at a meeting` FALSE EQUALS JUST TRUE
#ASSERT `s 330(2) the termination of the authority of the person to act as proxy does not affect the matter` `s 330(2)(a) whether he counts in deciding whether there is a quorum at a meeting` TRUE EQUALS JUST FALSE
#ASSERT `s 330(2) the termination of the authority of the person to act as proxy does not affect the matter` `s 330(2)(b) the validity of anything he does as chairman of a meeting` TRUE EQUALS JUST FALSE
#ASSERT `s 330(2) the termination of the authority of the person to act as proxy does not affect the matter` `s 330(2)(c) the validity of a poll demanded by him at a meeting` FALSE EQUALS JUST TRUE
-- s 330(3): does not affect a vote unless notice arrives before the meeting, or (poll over 48 hours later) before the poll
#ASSERT `s 330(3) the termination of the authority of the person to act as proxy does not affect the validity of the vote` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 330(3) the termination of the authority of the person to act as proxy does not affect the validity of the vote` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(3) the termination of the authority of the person to act as proxy does not affect the validity of the vote` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 330(3) the termination of the authority of the person to act as proxy does not affect the validity of the vote` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 330(3) the termination of the authority of the person to act as proxy does not affect the validity of the vote` FALSE FALSE FALSE EQUALS JUST TRUE
-- s 330(4)
#ASSERT `s 330(4) the company is treated as having received the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(4) the company is treated as having received the notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 330(4) the company is treated as having received the notice` FALSE TRUE EQUALS NOTHING
-- s 330(5): subject to the articles, but the articles cannot go beyond subsection (6)
#ASSERT `s 330(5) the earlier time required by the articles has effect` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 330(5) the earlier time required by the articles has effect` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(5) the earlier time required by the articles has effect` FALSE FALSE EQUALS NOTHING
-- s 330(7), (6)
#ASSERT `s 330(7) the hours of the period that are counted` 72 24 EQUALS 48
#ASSERT `s 330(6) the provision of the articles is void` `s 330(6)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 48 0 EQUALS NOTHING
#ASSERT `s 330(6) the provision of the articles is void` `s 330(6)(a) in the case of a meeting or adjourned meeting, 48 hours before the time for holding it` 49 0 EQUALS JUST TRUE
#ASSERT `s 330(6) the provision of the articles is void` `s 330(6)(b) in the case of a poll taken more than 48 hours after it was demanded, 24 hours before the time appointed for the taking of the poll` 24 0 EQUALS NOTHING
#ASSERT `s 330(6) the provision of the articles is void` `s 330(6)(b) in the case of a poll taken more than 48 hours after it was demanded, 24 hours before the time appointed for the taking of the poll` 25 0 EQUALS JUST TRUE
#ASSERT `s 330(6) the provision of the articles is void` `s 330(6) another case` 100 0 EQUALS NOTHING
-- s 331
#ASSERT `s 331 sections 324 to 330 prevent the articles from conferring the rights` TRUE EQUALS JUST FALSE
#ASSERT `s 331 sections 324 to 330 prevent the articles from conferring the rights` FALSE EQUALS NOTHING
-- s 332: the date on which it was in fact passed, not an earlier date
#ASSERT `s 332 the date on which the resolution is treated as having been passed` TRUE (Date 5 3 2026) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 332 the date on which the resolution is treated as having been passed` FALSE (Date 5 3 2026) EQUALS NOTHING

-- s 333(1), (2)
#ASSERT `s 333(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 333(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 333(2) the company is deemed to have agreed that the document or information relating to proxies may be sent by electronic means to the address` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333(2) the company is deemed to have agreed that the document or information relating to proxies may be sent by electronic means to the address` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 333(2) the company is deemed to have agreed that the document or information relating to proxies may be sent by electronic means to the address` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333(2) the company is deemed to have agreed that the document or information relating to proxies may be sent by electronic means to the address` TRUE TRUE FALSE EQUALS NOTHING
-- s 333(3), (4)
#ASSERT `s 333(3) the document is a document relating to proxies` `s 333(3)(a) the appointment of a proxy in relation to a meeting` EQUALS JUST TRUE
#ASSERT `s 333(3) the document is a document relating to proxies` `s 333(3)(b) any document necessary to show the validity of, or otherwise relating to, the appointment of a proxy` EQUALS JUST TRUE
#ASSERT `s 333(3) the document is a document relating to proxies` `s 333(3)(c) notice of the termination of the authority of a proxy` EQUALS JUST TRUE
#ASSERT `s 333(3) the document is a document relating to proxies` `s 333(3) another document` EQUALS NOTHING
#ASSERT `s 333(4) the address or number is an electronic address` TRUE EQUALS JUST TRUE
#ASSERT `s 333(4) the address or number is an electronic address` FALSE EQUALS JUST FALSE
-- s 333A
#ASSERT `s 333A(1) the traded company has provided an electronic address` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333A(1) the traded company has provided an electronic address` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the traded company has provided an electronic address` FALSE TRUE EQUALS NOTHING
#ASSERT `s 333A(2) the address was provided in a way this subsection requires` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 333A(2) the address was provided in a way this subsection requires` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 333A(2) the address was provided in a way this subsection requires` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333A(3) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 333A(3) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 333A(3) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 333A(4)(a) the document is a document relating to proxies` `s 333A(4)(a)(i) the appointment of a proxy for a meeting` EQUALS JUST TRUE
#ASSERT `s 333A(4)(a) the document is a document relating to proxies` `s 333A(4)(a)(ii) any document necessary to show the validity of, or otherwise relating to, the appointment of a proxy` EQUALS JUST TRUE
#ASSERT `s 333A(4)(a) the document is a document relating to proxies` `s 333A(4)(a)(iii) notice of the termination of the authority of a proxy` EQUALS JUST TRUE
#ASSERT `s 333A(4)(a) the document is a document relating to proxies` `s 333A(4)(a) another document` EQUALS NOTHING
#ASSERT `s 333A(4)(b) the address or number is an electronic address` TRUE EQUALS JUST TRUE
#ASSERT `s 333A(4)(b) the address or number is an electronic address` FALSE EQUALS JUST FALSE

-- s 334(2): provisions that do not apply to a class meeting of holders of shares
#ASSERT `s 334(2) the provision of this Chapter does not apply in relation to a meeting of holders of a class of shares` "303" EQUALS JUST TRUE
#ASSERT `s 334(2) the provision of this Chapter does not apply in relation to a meeting of holders of a class of shares` "306" EQUALS JUST TRUE
#ASSERT `s 334(2) the provision of this Chapter does not apply in relation to a meeting of holders of a class of shares` "311(3)" EQUALS JUST TRUE
#ASSERT `s 334(2) the provision of this Chapter does not apply in relation to a meeting of holders of a class of shares` "333A" EQUALS JUST TRUE
#ASSERT `s 334(2) the provision of this Chapter does not apply in relation to a meeting of holders of a class of shares` "310" EQUALS NOTHING
-- s 334(2A)
#ASSERT `s 334(2A) the provision applies to a meeting of holders of a class of shares in a traded company` "307(1) to (6)" EQUALS JUST TRUE
#ASSERT `s 334(2A) the provision applies to a meeting of holders of a class of shares in a traded company` "307A" EQUALS JUST FALSE
#ASSERT `s 334(2A) the provision applies to a meeting of holders of a class of shares in a traded company` "308" EQUALS NOTHING
-- s 334(3): not for a variation of class rights meeting: ss 318 and 321
#ASSERT `s 334(3) the provision does not apply in relation to the variation of class rights meeting` "318" TRUE EQUALS JUST TRUE
#ASSERT `s 334(3) the provision does not apply in relation to the variation of class rights meeting` "321" TRUE EQUALS JUST TRUE
#ASSERT `s 334(3) the provision does not apply in relation to the variation of class rights meeting` "318" FALSE EQUALS NOTHING
#ASSERT `s 334(3) the provision does not apply in relation to the variation of class rights meeting` "319" TRUE EQUALS NOTHING
-- s 334(1)
#ASSERT `s 334(1) the provision of this Chapter applies (with necessary modifications) to a meeting of holders of a class of shares` "303" FALSE EQUALS JUST FALSE
#ASSERT `s 334(1) the provision of this Chapter applies (with necessary modifications) to a meeting of holders of a class of shares` "318" TRUE EQUALS JUST FALSE
#ASSERT `s 334(1) the provision of this Chapter applies (with necessary modifications) to a meeting of holders of a class of shares` "318" FALSE EQUALS JUST TRUE
#ASSERT `s 334(1) the provision of this Chapter applies (with necessary modifications) to a meeting of holders of a class of shares` "308" FALSE EQUALS JUST TRUE
-- s 334(4): variation meeting quorum: two persons holding at least one-third in nominal value (1 of 3 is exactly one-third), or one person at an adjourned meeting
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 2 1 3 EQUALS JUST TRUE
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 2 1 4 EQUALS JUST FALSE
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 1 3 3 EQUALS JUST FALSE
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` TRUE TRUE 1 0 3 EQUALS JUST TRUE
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` TRUE TRUE 0 0 3 EQUALS JUST FALSE
#ASSERT `s 334(4) the quorum for the variation of class rights meeting is present` FALSE FALSE 2 1 3 EQUALS NOTHING
-- s 334(5), (6), (7)
#ASSERT `s 334(5) the nominal value of the shares the person is treated as holding` TRUE 40 EQUALS JUST 40
#ASSERT `s 334(5) the nominal value of the shares the person is treated as holding` FALSE 40 EQUALS NOTHING
#ASSERT `s 334(6) the holder may demand a poll` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 334(6) the holder may demand a poll` TRUE FALSE EQUALS NOTHING
#ASSERT `s 334(6) the holder may demand a poll` FALSE TRUE EQUALS NOTHING
#ASSERT `s 334(7) the act is treated as a variation of the rights attached to a class of shares` `s 334(7)(a) any amendment of a provision contained in a company's articles for the variation of the rights attached to a class of shares, or the insertion of any such provision into the articles` EQUALS JUST TRUE
#ASSERT `s 334(7) the act is treated as a variation of the rights attached to a class of shares` `s 334(7)(b) the abrogation of rights attached to a class of shares` EQUALS JUST TRUE
#ASSERT `s 334(7) the act is treated as a variation of the rights attached to a class of shares` `s 334(7) another act` EQUALS NOTHING

-- s 335(2), (3), (1): a class of members of a company without a share capital
#ASSERT `s 335(2) the provision of this Chapter does not apply in relation to a meeting of a class of members` "303" EQUALS JUST TRUE
#ASSERT `s 335(2) the provision of this Chapter does not apply in relation to a meeting of a class of members` "306" EQUALS JUST TRUE
#ASSERT `s 335(2) the provision of this Chapter does not apply in relation to a meeting of a class of members` "311(3)" EQUALS NOTHING
#ASSERT `s 335(3) the provision does not apply in relation to the variation of class rights meeting` "318" TRUE EQUALS JUST TRUE
#ASSERT `s 335(3) the provision does not apply in relation to the variation of class rights meeting` "321" FALSE EQUALS NOTHING
#ASSERT `s 335(1) the provision of this Chapter applies (with necessary modifications) to a meeting of a class of members` "303" FALSE EQUALS JUST FALSE
#ASSERT `s 335(1) the provision of this Chapter applies (with necessary modifications) to a meeting of a class of members` "321" TRUE EQUALS JUST FALSE
#ASSERT `s 335(1) the provision of this Chapter applies (with necessary modifications) to a meeting of a class of members` "311A" FALSE EQUALS JUST TRUE
-- s 335(4): two members present together representing at least one-third of the voting rights of the class, or one at an adjourned meeting
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 2 1 3 EQUALS JUST TRUE
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 2 1 4 EQUALS JUST FALSE
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` TRUE FALSE 1 3 3 EQUALS JUST FALSE
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` TRUE TRUE 1 0 3 EQUALS JUST TRUE
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` TRUE TRUE 0 0 3 EQUALS JUST FALSE
#ASSERT `s 335(4) the quorum for the variation of class rights meeting is present` FALSE FALSE 2 1 3 EQUALS NOTHING
-- s 335(5), (6)
#ASSERT `s 335(5) the member may demand a poll` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 335(5) the member may demand a poll` TRUE FALSE EQUALS NOTHING
#ASSERT `s 335(5) the member may demand a poll` FALSE TRUE EQUALS NOTHING
