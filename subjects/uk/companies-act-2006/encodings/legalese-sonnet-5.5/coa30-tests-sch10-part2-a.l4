IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch10-part1`
IMPORT `coa30-sch10-part2-a`

-- coa30-tests-sch10-part2-a.l4: tests for coa30-sch10-part2-a.l4 (Schedule 10 Part 2, paragraphs 5A to 8).
-- Expected values are decided from the text of each paragraph. Arguments are positional, in GIVEN order.
-- Requirement functions: every limb is required, so all-TRUE is JUST TRUE and each single FALSE is JUST FALSE.

§ `Tests: Schedule 10 Part 2, paragraphs 5A to 8`

-- sch 10 para 5A: every limb that applies is required ("The body (“B”) must have rules providing that")
#ASSERT `sch 10 para 5A the body meets the requirement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 5A the body meets the requirement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 5A the body meets the requirement` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 5A the body meets the requirement` TRUE TRUE FALSE EQUALS JUST FALSE
-- sch 10 para 5B: every limb that applies is required ("The body must consult with the competent authority and with other recognised supervisory bodies")
#ASSERT `sch 10 para 5B the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 5B the body meets the requirement` FALSE EQUALS JUST FALSE
-- 6(1): "not eligible ... unless": the rule bars the person (JUST TRUE) when no unless-limb holds; it does not bar (JUST FALSE) when one holds.
-- individual, not a third country auditor: (a) holds an appropriate qualification
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE FALSE TRUE FALSE NOTHING FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE FALSE FALSE FALSE NOTHING FALSE NOTHING EQUALS JUST TRUE
-- individual who is a third country auditor: (aa)(i) qualification, (ii) authorised by 5 April 2008, (iii) sub-paragraph (1A)
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE TRUE TRUE FALSE (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE TRUE FALSE TRUE (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE TRUE FALSE FALSE (JUST TRUE) FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE TRUE FALSE FALSE (JUST FALSE) FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` TRUE TRUE FALSE FALSE NOTHING FALSE NOTHING EQUALS NOTHING
-- firm: (b)(i) each responsible individual eligible and (ii) controlled by qualified persons
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` FALSE FALSE FALSE FALSE NOTHING TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` FALSE FALSE FALSE FALSE NOTHING FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` FALSE FALSE FALSE FALSE NOTHING TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1) the person is not eligible for appointment as a statutory auditor under the rule the body must have` FALSE FALSE FALSE FALSE NOTHING TRUE NOTHING EQUALS NOTHING

-- 6(1A): (a) a full professional qualification; or (b) an EEA auditor with all of (i), (ii), (iii); or (c) a specified state auditor with comparable qualifications who has met any imposed requirement.
-- args: qual-all, EEA auditor, (b)(i), (b)(ii), (b)(iii), specified state auditor, (c)(i), requirement imposed, requirement met
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(1A) the requirements of this sub-paragraph are met` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 6(1B): the rules must specify one of (a), (b), (c).
#ASSERT `sch 10 para 6(1B) the rules of the body specify one of the requirements listed` `sch 10 para 6(1B)(a) a requirement to pass an aptitude test` EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1B) the rules of the body specify one of the requirements listed` `sch 10 para 6(1B)(b) a requirement to complete an adaptation period` EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1B) the rules of the body specify one of the requirements listed` `sch 10 para 6(1B)(c) a requirement either to pass an aptitude test or to complete an adaptation period at the choice of the individual` EQUALS JUST TRUE
#ASSERT `sch 10 para 6(1B) the rules of the body specify one of the requirements listed` `sch 10 para 6(1B) another requirement` EQUALS JUST FALSE

-- 6(2): the aptitude test may test a subject that is covered by a recognised qualification, not covered by the person's own qualification and essential; may test rules of professional conduct; must not test any other matters.
#ASSERT `sch 10 para 6(2) the aptitude test may test the person's knowledge of the matter` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2) the aptitude test may test the person's knowledge of the matter` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2) the aptitude test may test the person's knowledge of the matter` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2) the aptitude test may test the person's knowledge of the matter` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2) the aptitude test may test the person's knowledge of the matter` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- 6(2)(a): must test each subject that meets (i), (ii) and (iii); otherwise the text does not say it must.
#ASSERT `sch 10 para 6(2)(a) the aptitude test must test the person's knowledge of the subject` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2)(a) the aptitude test must test the person's knowledge of the subject` TRUE FALSE TRUE EQUALS NOTHING
-- 6(2B): not exceeding three years (36 months), supervised, assessed.
#ASSERT `sch 10 para 6(2B) the period is an adaptation period` 36 TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2B) the period is an adaptation period` 37 TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2B) the period is an adaptation period` 12 FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2B) the period is an adaptation period` 12 TRUE FALSE EQUALS JUST FALSE
-- 6(2C): applies only where the rules specify such a requirement.
#ASSERT `sch 10 para 6(2C) the body meets the requirements for the adaptation period` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2C) the body meets the requirements for the adaptation period` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2C) the body meets the requirements for the adaptation period` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2C) the body meets the requirements for the adaptation period` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 6(2C) the body meets the requirements for the adaptation period` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 10 para 6(2C)(b) the applicant may be required to undergo further training during the adaptation period` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 6(2C)(b) the applicant may be required to undergo further training during the adaptation period` FALSE EQUALS NOTHING
-- 6(3): the firm ceased to comply on 15 January 2026: not more than three months is 15 January to 14 April.
#ASSERT `sch 10 para 6(3) the firm may be permitted to remain eligible for appointment as a statutory auditor` TRUE (Date 15 1 2026) (Date 14 4 2026) EQUALS JUST TRUE
#ASSERT `sch 10 para 6(3) the firm may be permitted to remain eligible for appointment as a statutory auditor` TRUE (Date 15 1 2026) (Date 15 4 2026) EQUALS JUST FALSE
#ASSERT `sch 10 para 6(3) the firm may be permitted to remain eligible for appointment as a statutory auditor` TRUE (Date 15 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
#ASSERT `sch 10 para 6(3) the firm may be permitted to remain eligible for appointment as a statutory auditor` FALSE (Date 15 1 2026) (Date 15 4 2026) EQUALS NOTHING

-- 7(2): an individual is qualified by an appropriate qualification, or as a third country auditor meeting 6(1)(aa)(ii)/6(1A); a firm by being eligible.
#ASSERT `sch 10 para 7(2) the person is qualified` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(2) the person is qualified` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(2) the person is qualified` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(2) the person is qualified` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(2) the person is qualified` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- 7(4): "a majority" of voting rights is more than half: 0.5 is not a majority, 0.51 is.
#ASSERT `sch 10 para 7(4) the qualified members are a majority of the members of the firm` TRUE 0.51 FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(4) the qualified members are a majority of the members of the firm` TRUE 0.5 FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(4) the qualified members are a majority of the members of the firm` TRUE 0.5 TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(4) the qualified members are a majority of the members of the firm` FALSE 0.1 TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(4) the qualified members are a majority of the members of the firm` FALSE 0.9 FALSE EQUALS JUST FALSE
-- 7(5)
#ASSERT `sch 10 para 7(5) the qualified members are a majority of the members of the management body of the firm` TRUE 0.6 FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(5) the qualified members are a majority of the members of the management body of the firm` TRUE 0.5 TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(5) the qualified members are a majority of the members of the management body of the firm` FALSE 0 TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(5) the qualified members are a majority of the members of the management body of the firm` FALSE 0 FALSE EQUALS JUST FALSE
-- 7(3): majority of members qualified, and (if there is a management body) a majority of it, or for a two-person body at least one.
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 7(3) the firm is controlled by qualified persons` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- 7(6)
#ASSERT `sch 10 para 7(6) paragraphs 5 to 11 of Schedule 7 apply to the counting of rights` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7(6) paragraphs 5 to 11 of Schedule 7 apply to the counting of rights` FALSE EQUALS NOTHING

-- sch 10 para 7A(1): every limb that applies is required ("The body must have rules and practices governing the adaptation period and the ability assessment")
#ASSERT `sch 10 para 7A(1) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7A(1) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 7A(2): every limb that applies is required ("The body must have regard to the circumstances of each applicant")
#ASSERT `sch 10 para 7A(2) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7A(2) the body meets the requirement` FALSE EQUALS JUST FALSE
-- 7A(3): the applicant may be required to undergo further training in any case within section 1221.
#ASSERT `sch 10 para 7A(3) the applicant may be required to undergo further training during the adaptation period` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 10 para 7A(3) the applicant may be required to undergo further training during the adaptation period` (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 10 para 7A(3) the applicant may be required to undergo further training during the adaptation period` NOTHING EQUALS NOTHING

-- sch 10 para 7A(4): every limb that applies is required ("The applicant’s performance during the adaptation period must be assessed by the body")
#ASSERT `sch 10 para 7A(4) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7A(4) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 7A(5): every limb that applies is required ("The body must determine the applicant’s professional status during the adaptation period")
#ASSERT `sch 10 para 7A(5) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 7A(5) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 8(1): every limb that applies is required ("The body must have adequate rules and practices designed to ensure that the persons eligible under its rules for appointment as a statutory auditor are fit and proper persons")
#ASSERT `sch 10 para 8(1) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 8(1) the body meets the requirement` FALSE EQUALS JUST FALSE
-- 8(2): the matters the body may take into account must include (a) a person employed by or associated with the person; (b)(i)-(iii) in the case of a body corporate; (c)(i)-(iv) in the case of a partnership. The list says "must include", so it is not closed.
-- args: assessed is a body corporate, assessed is a partnership, relation
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE FALSE `sch 10 para 8(2)(a) a person employed by or associated with the person for statutory audit work` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` TRUE FALSE `sch 10 para 8(2)(b)(i) a director or controller of the body corporate` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` TRUE FALSE `sch 10 para 8(2)(b)(ii) another body corporate in the same group` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` TRUE FALSE `sch 10 para 8(2)(b)(iii) a director or controller of such another body corporate` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE TRUE `sch 10 para 8(2)(c)(i) a partner` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE TRUE `sch 10 para 8(2)(c)(ii) a director or controller of a partner` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE TRUE `sch 10 para 8(2)(c)(iii) a body corporate in the same group as a partner` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE TRUE `sch 10 para 8(2)(c)(iv) a director or controller of such another body corporate in the group of a partner` EQUALS JUST TRUE
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` FALSE TRUE `sch 10 para 8(2)(b)(i) a director or controller of the body corporate` EQUALS NOTHING
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` TRUE FALSE `sch 10 para 8(2)(c)(i) a partner` EQUALS NOTHING
#ASSERT `sch 10 para 8(2) the matters the body may take into account must include a matter relating to this person` TRUE FALSE `sch 10 para 8(2) any other person` EQUALS NOTHING
-- 8(3)
#ASSERT `sch 10 para 8(3) director is to be read as member in sub-paragraph (2)(b)` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 8(3) director is to be read as member in sub-paragraph (2)(b)` FALSE EQUALS NOTHING
-- 8(4): a controller holds 15% or more: 0.15 is, 0.1499 is not.
#ASSERT `sch 10 para 8(4) the person is a controller of the body corporate` TRUE 0.15 EQUALS JUST TRUE
#ASSERT `sch 10 para 8(4) the person is a controller of the body corporate` TRUE 0.1499 EQUALS JUST FALSE
#ASSERT `sch 10 para 8(4) the person is a controller of the body corporate` TRUE 1 EQUALS JUST TRUE
#ASSERT `sch 10 para 8(4) the person is a controller of the body corporate` FALSE 0.5 EQUALS NOTHING
