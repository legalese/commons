#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST TRUE) NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 136(1)(a) the prohibition applies: the body corporate cannot be a member of the company` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- s 136(1)(b): arguments (s 1159(1)) (s 138(1)) (s 141(1))
