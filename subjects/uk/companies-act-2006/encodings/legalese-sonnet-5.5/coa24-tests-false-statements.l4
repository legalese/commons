IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa24-officers`
IMPORT `coa24-penalty`
IMPORT `coa24-false-statements`

-- coa24-tests-false-statements.l4: tests for ss 1112 to 1112B (coa24-false-statements.l4). Expected values decided from the
-- text before the run.

§ `Fixtures`

`a director who permitted the contravention` MEANS `s 1121(3) conduct of the officer` WITH
    `s 1121(3) authorises or permits` IS TRUE
    `s 1121(3) participates in` IS FALSE
    `s 1121(3) fails to take all reasonable steps to prevent` IS FALSE

`a director who did nothing wrong` MEANS `s 1121(3) conduct of the officer` WITH
    `s 1121(3) authorises or permits` IS FALSE
    `s 1121(3) participates in` IS FALSE
    `s 1121(3) fails to take all reasonable steps to prevent` IS FALSE

§ `Tests for s 1112`

-- (1): without reasonable excuse, deliver a document or make a statement that is misleading, false or deceptive in a material particular.
#ASSERT `s 1112(1) the person commits the offence` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112(1) the person commits the offence` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112(1) the person commits the offence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112(1) the person commits the offence` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1112(1) the person commits the offence` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- A reasonable excuse takes the case out of the offence as worded ("without reasonable excuse").
#ASSERT `s 1112(1) the person commits the offence` TRUE FALSE TRUE TRUE EQUALS NOTHING

-- (2): where committed by a firm, every officer in default also commits it.
#ASSERT `s 1112(2) the officer of the firm who is in default also commits the offence` `a company registered under the Companies Act 2006` (JUST TRUE) `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS JUST TRUE
#ASSERT `s 1112(2) the officer of the firm who is in default also commits the offence` `a company registered under the Companies Act 2006` (JUST TRUE) `s 1121(2)(a) a director` `a director who did nothing wrong` EQUALS JUST FALSE
#ASSERT `s 1112(2) the officer of the firm who is in default also commits the offence` `an individual` (JUST TRUE) `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS NOTHING
#ASSERT `s 1112(2) the officer of the firm who is in default also commits the offence` `a company registered under the Companies Act 2006` NOTHING `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS NOTHING

-- (3): England and Wales a fine; Scotland and Northern Ireland a fine not exceeding level 5; no daily default fine in this section.
#ASSERT `s 1112(3) the punishment on summary conviction` `England and Wales` EQUALS Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE
#ASSERT `s 1112(3) the punishment on summary conviction` Scotland EQUALS Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE
#ASSERT `s 1112(3) the punishment on summary conviction` `Northern Ireland` EQUALS Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE
-- No daily default fine, so s 1125 does not speak.
#ASSERT `s 1125(2) the fine limit that applies on this conviction` (`s 1112(3) the punishment on summary conviction` Scotland) TRUE EQUALS NOTHING

§ `Tests for s 1112A`

#ASSERT `s 1112A(1) the person commits the offence` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1112A(1) the person commits the offence` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1112A(1) the person commits the offence` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1112A(1) the person commits the offence` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1112A(1) the person commits the offence` FALSE FALSE TRUE TRUE EQUALS NOTHING

#ASSERT `s 1112A(2) the officer of the firm who is in default also commits the offence` `a partnership` (JUST TRUE) `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS JUST TRUE
#ASSERT `s 1112A(2) the officer of the firm who is in default also commits the offence` `a partnership` (JUST TRUE) `s 1121(2)(a) a director` `a director who did nothing wrong` EQUALS JUST FALSE
#ASSERT `s 1112A(2) the officer of the firm who is in default also commits the offence` `an individual` (JUST TRUE) `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS NOTHING
#ASSERT `s 1112A(2) the officer of the firm who is in default also commits the offence` `a partnership` NOTHING `s 1121(2)(a) a director` `a director who permitted the contravention` EQUALS NOTHING

-- (3)(a) on indictment: two years or a fine (or both).
#ASSERT `s 1112A(3) the punishment for the offence` `on conviction on indictment` (Date 1 6 2026) NOTHING EQUALS JUST (Penalty WITH `how convicted` IS `on conviction on indictment`, `imprisonment not exceeding` IS JUST (Period OF 2, Years), `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
-- (3)(b)(i) England and Wales: the general limit in a magistrates' court or a fine (or both). An offence committed before 2 May 2022: six months (s 1131(2)).
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction in England and Wales` (Date 1 5 2022) (JUST (Period OF 12, Months)) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS JUST (Period OF 6, Months), `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
-- Committed on 2 May 2022: the general limit (a test figure of 12 months).
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction in England and Wales` (Date 2 5 2022) (JUST (Period OF 12, Months)) EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS JUST (Period OF 12, Months), `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
-- Committed on or after 2 May 2022 and no general limit supplied: not covered.
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction in England and Wales` (Date 2 5 2022) NOTHING EQUALS NOTHING
-- (3)(b)(ii) Scotland: 12 months or a fine not exceeding the statutory maximum (or both).
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction in Scotland` (Date 1 6 2026) NOTHING EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS JUST (Period OF 12, Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` OF 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
-- (3)(b)(iii) Northern Ireland: 6 months or a fine not exceeding the statutory maximum (or both).
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction in Northern Ireland` (Date 1 6 2026) NOTHING EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS JUST (Period OF 6, Months), `fine not exceeding` IS JUST (`a fine not exceeding the statutory maximum` OF 1), `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS TRUE)
#ASSERT `s 1112A(3) the punishment for the offence` `on summary conviction` (Date 1 6 2026) NOTHING EQUALS NOTHING

§ `Tests for s 1112B`

-- (1): a person to whom a certificate is issued is not liable for the offence.
#ASSERT `s 1112B(1) the person is liable for the commission of the offence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1112B(1) the person is liable for the commission of the offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1112B(1) the person is liable for the commission of the offence` FALSE TRUE EQUALS NOTHING
-- (2): only if satisfied that it is necessary in the interests of national security or to prevent or detect serious crime.
#ASSERT `s 1112B(2) the Secretary of State may issue the certificate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112B(2) the Secretary of State may issue the certificate` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1112B(2) the Secretary of State may issue the certificate` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1112B(3) the Secretary of State may revoke the certificate` TRUE EQUALS JUST TRUE
#ASSERT `s 1112B(3) the Secretary of State may revoke the certificate` FALSE EQUALS NOTHING
#ASSERT `s 1112B(4)(a) the conduct is crime` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(a) the conduct is crime` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(a) the conduct is crime` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1112B(4)(b) the crime is serious` 3 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(b) the crime is serious` 2 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1112B(4)(b) the crime is serious` 0 TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(b) the crime is serious` 0 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(b) the crime is serious` 0 FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1112B(4)(b) the crime is serious` 0 FALSE FALSE FALSE EQUALS JUST FALSE
