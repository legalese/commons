IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-approval`

-- Tests of ss 414 to 414B (approval and signing of accounts; strategic report). Every expected value was written from the text before the run.

-- s 414(1), (2), (3)
#ASSERT `s 414(1) the annual accounts are approved and signed as subsection (1) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 414(1) the annual accounts are approved and signed as subsection (1) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 414(1) the annual accounts are approved and signed as subsection (1) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 414(2) the signature is placed as subsection (2) requires` TRUE EQUALS JUST TRUE
#ASSERT `s 414(2) the signature is placed as subsection (2) requires` FALSE EQUALS JUST FALSE
#ASSERT `s 414(3) the statement the balance sheet must contain in a prominent position above the signature` (JUST TRUE) TRUE EQUALS JUST `s 414(3)(a) a statement that the individual accounts are prepared in accordance with the micro-entity provisions`
#ASSERT `s 414(3) the statement the balance sheet must contain in a prominent position above the signature` (JUST TRUE) FALSE EQUALS JUST `s 414(3)(b) a statement that the accounts have been prepared in accordance with the provisions applicable to companies subject to the small companies regime`
#ASSERT `s 414(3) the statement the balance sheet must contain in a prominent position above the signature` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 414(3) the statement the balance sheet must contain in a prominent position above the signature` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 414(3) the balance sheet contains the statement as subsection (3) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 414(3) the balance sheet contains the statement as subsection (3) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 414(3) the balance sheet contains the statement as subsection (3) requires` FALSE TRUE EQUALS JUST FALSE
-- s 414(4): approved accounts that do not comply, approved by a director who knew or was reckless and failed to take reasonable steps
#ASSERT `s 414(4) the director commits an offence` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 414(4) the director commits an offence` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 414(4) the director commits an offence` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 414(4) the director commits an offence` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 414(4) the director commits an offence` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 414(4) the director commits an offence` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 414(4) the director commits an offence` TRUE NOTHING FALSE TRUE EQUALS JUST FALSE
-- s 414(5): on indictment a fine; on summary conviction a fine not exceeding the statutory maximum
#ASSERT `s 414(5) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 414(5) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 414(5) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 414(5) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 414(5) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)

-- s 414B: entitled to prepare accounts under the small companies regime, or would be but for an ineligible group
#ASSERT `s 414B the company is entitled to the small companies exemption in relation to the strategic report` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 414B the company is entitled to the small companies exemption in relation to the strategic report` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 414B the company is entitled to the small companies exemption in relation to the strategic report` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 414B the company is entitled to the small companies exemption in relation to the strategic report` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 414B the company is entitled to the small companies exemption in relation to the strategic report` NOTHING (JUST TRUE) EQUALS JUST TRUE

-- s 414A(2), (1)
#ASSERT `s 414A(2) subsection (1) applies to the company` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 414A(2) subsection (1) applies to the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 414A(2) subsection (1) applies to the company` NOTHING EQUALS NOTHING
#ASSERT `s 414A(1) the directors are required to prepare a strategic report for the financial year` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 414A(1) the directors are required to prepare a strategic report for the financial year` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 414A(1) the directors are required to prepare a strategic report for the financial year` NOTHING EQUALS NOTHING
-- s 414A(3), (4), (5), (6)
#ASSERT `s 414A(3) the strategic report must be a group strategic report relating to the undertakings included in the consolidation` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 414A(3) the strategic report must be a group strategic report relating to the undertakings included in the consolidation` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 414A(3) the strategic report must be a group strategic report relating to the undertakings included in the consolidation` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 414A(3) the strategic report must be a group strategic report relating to the undertakings included in the consolidation` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 414A(3) the strategic report must be a group strategic report relating to the undertakings included in the consolidation` NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 414A(4) the group strategic report may, where appropriate, give greater emphasis to the matters that are significant to the undertakings included in the consolidation taken as a whole` TRUE EQUALS JUST TRUE
#ASSERT `s 414A(4) the group strategic report may, where appropriate, give greater emphasis to the matters that are significant to the undertakings included in the consolidation taken as a whole` FALSE EQUALS NOTHING
#ASSERT `s 414A(5) the person commits an offence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 414A(5) the person commits an offence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 414A(5) the person commits an offence` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 414A(5) the person commits an offence` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 414A(6) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 414A(6) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
