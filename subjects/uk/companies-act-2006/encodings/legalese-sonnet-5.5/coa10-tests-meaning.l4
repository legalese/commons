IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-meaning`

-- coa10-tests-meaning.l4: tests for coa10-meaning.l4 (ss 464, 471, 472, 472A, 474). Every expected value was written down
-- from the text of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 464 (lines 6345-6346) ----
#ASSERT `s 464(1) the statement is an accounting standard` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 464(1) the statement is an accounting standard` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 464(1) the statement is an accounting standard` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 464(1) the statement is an accounting standard` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 464(2) the accounting standard is applicable to the company's annual accounts` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 464(2) the accounting standard is applicable to the company's annual accounts` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 464(2) the accounting standard is applicable to the company's annual accounts` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 464(2) the accounting standard is applicable to the company's annual accounts` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 464(2) the accounting standard is applicable to the company's annual accounts` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE

-- ---- s 471(1) (lines 6463-6466) ----
#ASSERT `s 471(1) the accounts are part of the company's annual accounts` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 471(1) the accounts are part of the company's annual accounts` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 471(1) the accounts are part of the company's annual accounts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 471(1) the accounts are part of the company's annual accounts` FALSE FALSE EQUALS JUST FALSE
-- subject to section 408: the option to omit the individual profit and loss account
#ASSERT `s 471(1) the individual profit and loss account is part of the annual accounts` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 471(1) the individual profit and loss account is part of the annual accounts` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 471(1) the individual profit and loss account is part of the annual accounts` FALSE FALSE EQUALS NOTHING

-- ---- s 471(2), (3): the annual accounts and reports (lines 6467-6478) ----
-- unquoted, with a strategic report, not exempt from audit: accounts, strategic report, directors' report, auditor's report
#ASSERT `s 471(2) the annual accounts and reports of an unquoted company` TRUE FALSE EQUALS LIST `s 471 the annual accounts`, `s 471 the strategic report`, `s 471 the directors' report`, `s 471 the auditor's report`
-- no strategic report, exempt from audit: accounts and directors' report only
#ASSERT `s 471(2) the annual accounts and reports of an unquoted company` FALSE TRUE EQUALS LIST `s 471 the annual accounts`, `s 471 the directors' report`
#ASSERT `s 471(2) the item is among the annual accounts and reports of the unquoted company` `s 471 the auditor's report` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 471(2) the item is among the annual accounts and reports of the unquoted company` `s 471 the auditor's report` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 471(2) the item is among the annual accounts and reports of the unquoted company` `s 471 the strategic report` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 471(2) the item is among the annual accounts and reports of the unquoted company` `s 471 the directors' remuneration report` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 471(2) the item is among the annual accounts and reports of the unquoted company` `s 471 the directors' report` FALSE FALSE EQUALS JUST TRUE
-- quoted: accounts, remuneration report, strategic report (if any), directors' report, auditor's report
#ASSERT `s 471(3) the annual accounts and reports of a quoted company` TRUE EQUALS LIST `s 471 the annual accounts`, `s 471 the directors' remuneration report`, `s 471 the strategic report`, `s 471 the directors' report`, `s 471 the auditor's report`
#ASSERT `s 471(3) the annual accounts and reports of a quoted company` FALSE EQUALS LIST `s 471 the annual accounts`, `s 471 the directors' remuneration report`, `s 471 the directors' report`, `s 471 the auditor's report`
#ASSERT `s 471(3) the item is among the annual accounts and reports of the quoted company` `s 471 the directors' remuneration report` FALSE EQUALS JUST TRUE
#ASSERT `s 471(3) the item is among the annual accounts and reports of the quoted company` `s 471 the strategic report` FALSE EQUALS JUST FALSE
#ASSERT `s 471(3) the item is among the annual accounts and reports of the quoted company` `s 471 the strategic report` TRUE EQUALS JUST TRUE

