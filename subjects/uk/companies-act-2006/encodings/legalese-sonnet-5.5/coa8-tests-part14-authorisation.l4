IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part14-authorisation`

-- Tests of ss 366 to 368 (authorisation for political donations and expenditure; form and duration of the resolution).
-- Every expected value was written from the text before the run.

-- s 366(4): a relevant holding company was (a) a holding company of the donor, (b) a UK-registered company and (c) not a subsidiary of another UK-registered company
#ASSERT `s 366(4) the other company is a relevant holding company` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 366(4) the other company is a relevant holding company` (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 366(4) the other company is a relevant holding company` (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 366(4) the other company is a relevant holding company` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 366(4) the other company is a relevant holding company` NOTHING TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 366(4) the other company is a relevant holding company` NOTHING FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 366(4) the other company is a relevant holding company` (JUST TRUE) TRUE NOTHING EQUALS NOTHING

-- s 366(3): no resolution is required of a wholly-owned subsidiary of a UK-registered company; otherwise the text is silent here
#ASSERT `s 366(3) no resolution is required on the part of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 366(3) no resolution is required on the part of the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 366(3) no resolution is required on the part of the company` FALSE TRUE EQUALS NOTHING

-- s 366(2)(a): a company that is not a subsidiary needs a resolution of its members
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST FALSE) (JUST TRUE) NOTHING EMPTY EQUALS JUST TRUE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST FALSE) (JUST FALSE) NOTHING EMPTY EQUALS JUST FALSE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST FALSE) NOTHING NOTHING EMPTY EQUALS NOTHING
-- s 366(2)(b): a subsidiary needs its own resolution and a resolution of the members of any relevant holding company
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST TRUE) NOTHING (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST TRUE) NOTHING (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST FALSE) NOTHING (LIST JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST TRUE) NOTHING EMPTY EQUALS JUST TRUE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST TRUE) NOTHING (LIST NOTHING) EQUALS NOTHING
-- s 366(3) takes away the subsidiary's own resolution, not the holding company's
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST FALSE) (JUST TRUE) (LIST JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` (JUST TRUE) (JUST FALSE) (JUST TRUE) (LIST JUST FALSE) EQUALS JUST FALSE
-- the company's own status as a subsidiary is not known
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` NOTHING (JUST FALSE) NOTHING EMPTY EQUALS JUST FALSE
#ASSERT `s 366(2) the donation or expenditure is authorised as section 366(2) requires` NOTHING (JUST TRUE) NOTHING EMPTY EQUALS NOTHING

-- s 366(5): the resolutions must comply with s 367 and be passed before the donation or expenditure
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST TRUE) (LIST Date 1 3 2026) (Date 2 3 2026) EQUALS JUST TRUE
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST TRUE) (LIST Date 2 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST TRUE) (LIST Date 3 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST TRUE) (LIST Date 1 3 2026, Date 3 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST FALSE) (LIST Date 1 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` NOTHING (LIST Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING
#ASSERT `s 366(5) the resolution or resolutions meet the requirements of subsection (5)` (JUST TRUE) EMPTY (Date 2 3 2026) EQUALS NOTHING

-- s 366(6): nothing enables a company to be authorised to do what it could not lawfully do
#ASSERT `s 366(6) section 366 enables the company to be authorised to do it` FALSE EQUALS JUST FALSE
#ASSERT `s 366(6) section 366 enables the company to be authorised to do it` TRUE EQUALS NOTHING

-- s 366(1): forbidden unless authorised
#ASSERT `s 366(1) the company is forbidden to make the donation or incur the expenditure` TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 366(1) the company is forbidden to make the donation or incur the expenditure` FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 366(1) the company is forbidden to make the donation or incur the expenditure` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 366(1) the company is forbidden to make the donation or incur the expenditure` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 366(1) the company is forbidden to make the donation or incur the expenditure` FALSE FALSE (JUST FALSE) EQUALS NOTHING

-- s 367(1): the resolution may relate to the company, its subsidiaries, or both
#ASSERT `s 367(1) the resolution may relate to` `s 367(1)(a) the company passing the resolution` EQUALS JUST TRUE
#ASSERT `s 367(1) the resolution may relate to` `s 367(1)(b) one or more subsidiaries of that company` EQUALS JUST TRUE
#ASSERT `s 367(1) the resolution may relate to` `s 367(1)(c) the company passing the resolution and one or more subsidiaries of that company` EQUALS JUST TRUE
#ASSERT `s 367(1) the resolution may relate to` `s 367(1) some other company` EQUALS NOTHING

-- s 367(2): all subsidiaries at the time of the resolution, or at any time in its period, without naming them
#ASSERT `s 367(2) the resolution may be expressed to relate to all the subsidiaries without identifying them individually` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 367(2) the resolution may be expressed to relate to all the subsidiaries without identifying them individually` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 367(2) the resolution may be expressed to relate to all the subsidiaries without identifying them individually` FALSE FALSE EQUALS NOTHING

-- s 367(3): three heads
#ASSERT `s 367(3) the resolution may authorise donations or expenditure under the head` `s 367(3)(a) donations to political parties or independent election candidates` EQUALS JUST TRUE
#ASSERT `s 367(3) the resolution may authorise donations or expenditure under the head` `s 367(3)(b) donations to political organisations other than political parties` EQUALS JUST TRUE
#ASSERT `s 367(3) the resolution may authorise donations or expenditure under the head` `s 367(3)(c) political expenditure` EQUALS JUST TRUE
#ASSERT `s 367(3) the resolution may authorise donations or expenditure under the head` `s 367(3) some other head` EQUALS NOTHING

-- s 367(4): specify a head or heads: for all the companies together (a resolution under (2)) or for each company (any other)
#ASSERT `s 367(4) the resolution specifies the head or heads as required` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 367(4) the resolution specifies the head or heads as required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 367(4) the resolution specifies the head or heads as required` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 367(4) the resolution specifies the head or heads as required` FALSE TRUE FALSE EQUALS JUST FALSE

-- s 367(5): general terms, and no particular donations or expenditure
#ASSERT `s 367(5) the resolution is expressed in general terms as required` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 367(5) the resolution is expressed in general terms as required` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 367(5) the resolution is expressed in general terms as required` FALSE FALSE EQUALS JUST FALSE

-- s 367(6): a specified amount for each head
#ASSERT `s 367(6) the resolution authorises up to a specified amount for each head` TRUE EQUALS JUST TRUE
#ASSERT `s 367(6) the resolution authorises up to a specified amount for each head` FALSE EQUALS JUST FALSE

-- s 367(7): specify the amounts: all companies together under (2), each company otherwise
#ASSERT `s 367(7) the resolution specifies the amounts as required` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 367(7) the resolution specifies the amounts as required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 367(7) the resolution specifies the amounts as required` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 367(7) the resolution specifies the amounts as required` FALSE TRUE FALSE EQUALS JUST FALSE

-- s 367 as a whole: every limb must hold
#ASSERT `s 367 the resolution is in the form section 367 requires` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 367 the resolution is in the form section 367 requires` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 367 the resolution is in the form section 367 requires` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 367 the resolution is in the form section 367 requires` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

-- s 368(2): subject to any provision of the articles that prevents the directors
#ASSERT `s 368(2) the directors have power to determine a shorter period` TRUE EQUALS JUST FALSE
#ASSERT `s 368(2) the directors have power to determine a shorter period` FALSE EQUALS JUST TRUE

-- s 368: the last day of a period beginning on 15 June 2026 (the day before the anniversary)
#ASSERT `s 368 the last day of a period of the length beginning on` (Date 15 6 2026) (Period OF 10, Days) EQUALS JUST (Date 24 6 2026)
#ASSERT `s 368 the last day of a period of the length beginning on` (Date 15 6 2026) (Period OF 2, Weeks) EQUALS JUST (Date 28 6 2026)
#ASSERT `s 368 the last day of a period of the length beginning on` (Date 15 6 2026) (Period OF 6, Months) EQUALS JUST (Date 14 12 2026)
#ASSERT `s 368 the last day of a period of the length beginning on` (Date 15 6 2026) (Period OF 2, Years) EQUALS JUST (Date 14 6 2028)
#ASSERT `s 368 the last day of a period of the length beginning on` (Date 15 6 2026) (Period OF 5, `Working days`) EQUALS NOTHING

-- s 368(1): four years from the date it is passed unless the directors determine, or the articles require, a shorter period
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) NOTHING NOTHING NOTHING EQUALS JUST (Date 14 6 2030)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 2, Years)) (JUST TRUE) NOTHING EQUALS JUST (Date 14 6 2028)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 2, Years)) (JUST FALSE) NOTHING EQUALS JUST (Date 14 6 2030)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 2, Years)) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) NOTHING NOTHING (JUST (Period OF 18, Months)) EQUALS JUST (Date 14 12 2027)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 2, Years)) (JUST TRUE) (JUST (Period OF 18, Months)) EQUALS JUST (Date 14 12 2027)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 1, Years)) (JUST TRUE) (JUST (Period OF 3, Years)) EQUALS JUST (Date 14 6 2027)
#ASSERT `s 368(1) the last day on which the resolution has effect` (Date 15 6 2026) (JUST (Period OF 2, Years)) (JUST FALSE) (JUST (Period OF 18, Months)) EQUALS JUST (Date 14 12 2027)

-- s 368(1): on which days the resolution has effect (passed 15 June 2026, last day 14 June 2030)
#ASSERT `s 368(1) the resolution has effect on the day` (JUST (Date 14 6 2030)) (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 368(1) the resolution has effect on the day` (JUST (Date 14 6 2030)) (Date 15 6 2026) (Date 14 6 2030) EQUALS JUST TRUE
#ASSERT `s 368(1) the resolution has effect on the day` (JUST (Date 14 6 2030)) (Date 15 6 2026) (Date 15 6 2030) EQUALS JUST FALSE
#ASSERT `s 368(1) the resolution has effect on the day` (JUST (Date 14 6 2030)) (Date 15 6 2026) (Date 14 6 2026) EQUALS JUST FALSE
#ASSERT `s 368(1) the resolution has effect on the day` NOTHING (Date 15 6 2026) (Date 15 6 2026) EQUALS NOTHING
