#ASSERT `sch 1B para 9(4) the person may apply for an order under sub-paragraph (3)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 9(4) the person may apply for an order under sub-paragraph (3)` FALSE FALSE TRUE EQUALS JUST TRUE
