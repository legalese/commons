IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa28-part46`
IMPORT `coa28-sch1b`

-- coa28-tests-sch1b.l4: tests for coa28-sch1b.l4 (Schedule 1B, paragraphs 1 to 14B). Every expected value was decided
-- by reading the paragraph named beside it, before running; none is copied from the encoding's output.

-- ---- paragraph 1
#ASSERT `sch 1B para 1(1) paragraph 1 applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 1(1) paragraph 1 applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(1) paragraph 1 applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(2) the company may give the person a warning notice` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1B para 1(2) the company may give the person a warning notice` (JUST FALSE) EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `sch 1B para 1(2) the company may give the person a warning notice` (JUST FALSE) EQUALS JUST FALSE; a function named for a power answers NOTHING when its "if" gate (paragraph 1 applies) fails (fork F11)
#ASSERT `sch 1B para 1(2) the company may give the person a warning notice` NOTHING EQUALS NOTHING
-- the period of one month beginning with the date: the day before the same day of the next month; the last day of the next month if shorter
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 10 1 2025) EQUALS Date 9 2 2025
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 31 1 2025) EQUALS Date 28 2 2025
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 31 1 2024) EQUALS Date 29 2 2024
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 1 1 2025) EQUALS Date 31 1 2025
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 1 2 2024) EQUALS Date 29 2 2024
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 1 12 2025) EQUALS Date 31 12 2025
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 15 12 2025) EQUALS Date 14 1 2026
#ASSERT `sch 1B para 1(3) the last day of the period of one month beginning with the date on which the warning notice was given` (Date 30 11 2025) EQUALS Date 29 12 2025
-- may issue: warning given 10 January 2025, so the period ends on 9 February; columns: warning date; the day the company wishes to issue; not complied by then; no valid reason provided by then
#ASSERT `sch 1B para 1(3) the company may issue the restrictions notice` (Date 10 1 2025) (Date 10 2 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 1(3) the company may issue the restrictions notice` (Date 10 1 2025) (Date 9 2 2025) TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(3) the company may issue the restrictions notice` (Date 10 1 2025) (Date 1 2 2025) TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(3) the company may issue the restrictions notice` (Date 10 1 2025) (Date 10 2 2025) FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(3) the company may issue the restrictions notice` (Date 10 1 2025) (Date 10 2 2025) TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(4) the restrictions notice is issued on the person` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 1(4) the restrictions notice is issued on the person` FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 1(6) the company has had regard to the effect of the notice on the rights of third parties` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 1(6) the company has had regard to the effect of the notice on the rights of third parties` FALSE EQUALS JUST FALSE
-- The same duty as a regulative rule (a DEONTIC cannot be #ASSERTed on the stable binary; the two outcomes were read from the trace output and are recorded in NOTES.md): with no event the duty stands; when the company has regard it is fulfilled.
#TRACE `sch 1B para 1(6) the company's duty to have regard to the rights of third parties` AT 0 WITH
#TRACE `sch 1B para 1(6) the company's duty to have regard to the rights of third parties` AT 0 WITH
    PARTY Company DOES `sch 1B para 1(6) the company has regard to the effect of the notice on the rights of third parties` AT 3

-- ---- paragraph 2
#ASSERT `sch 1B para 2(1) the person has a relevant interest in the company` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 2(1) the person has a relevant interest in the company` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 2(1) the person has a relevant interest in the company` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 2(1) the person has a relevant interest in the company` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 2(2) the thing is the relevant interest` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 2(2) the thing is the relevant interest` FALSE EQUALS NOTHING
#ASSERT `sch 1B para 2(3) the person is regarded as having the relevant interest` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 2(3) the person is regarded as having the relevant interest` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1B para 2(3) the person is regarded as having the relevant interest` FALSE TRUE EQUALS NOTHING

-- ---- paragraph 3
#ASSERT `sch 1B para 3(7) the provisions of paragraph 3 are subject to the direction` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 3(7) the provisions of paragraph 3 are subject to the direction` FALSE EQUALS NOTHING
-- columns: the act; a restrictions notice is in force; the company is in a liquidation; the provisions are subject to a direction
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(a) a transfer of the interest` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(b) the exercise of a right in respect of the interest` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(c) the issue of shares in right of the interest or in pursuance of an offer made to the interest-holder` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(d) a payment of sums due from the company in respect of the interest, whether in respect of capital or otherwise` TRUE FALSE NOTHING EQUALS JUST TRUE
-- (d) "except in a liquidation": in a liquidation the payment is not barred
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(d) a payment of sums due from the company in respect of the interest, whether in respect of capital or otherwise` TRUE TRUE NOTHING EQUALS JUST FALSE
-- a liquidation does not touch (a) to (c)
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(a) a transfer of the interest` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1) another act` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(a) a transfer of the interest` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 3(1) the effect of the restrictions notice applies to the act` `sch 1B para 3(1)(a) a transfer of the interest` TRUE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 1B para 3(6) the right is an associated right in relation to the relevant interest` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 3(6) the right is an associated right in relation to the relevant interest` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 3(6) the right is an associated right in relation to the relevant interest` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 3(3) sub-paragraph (2) applies to the agreement` TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 3(3) sub-paragraph (2) applies to the agreement` FALSE EQUALS NOTHING
-- columns: the interest is subject to the restriction in (1)(a); the answer of sub-paragraph (3)
#ASSERT `sch 1B para 3(2) the agreement to transfer the interest is void` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(2) the agreement to transfer the interest is void` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1B para 3(2) the agreement to transfer the interest is void` FALSE NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 3(5) sub-paragraph (4) applies to the agreement` TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 3(5) sub-paragraph (4) applies to the agreement` FALSE EQUALS NOTHING
-- columns: the agreement is to transfer an associated right; the transfer is in a liquidation; the answer of sub-paragraph (5)
#ASSERT `sch 1B para 3(4) the agreement to transfer the associated right is void` TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 3(4) the agreement to transfer the associated right is void` TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 3(4) the agreement to transfer the associated right is void` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1B para 3(4) the agreement to transfer the associated right is void` FALSE FALSE NOTHING EQUALS NOTHING

-- ---- paragraph 4
#ASSERT `sch 1B para 4(1) the court may give a direction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 4(1) the court may give a direction` TRUE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `sch 1B para 4(1) the court may give a direction` TRUE FALSE EQUALS JUST FALSE; a function named for a power answers NOTHING when its "if" gate fails (fork F12)
#ASSERT `sch 1B para 4(1) the court may give a direction` FALSE TRUE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `sch 1B para 4(1) the court may give a direction` FALSE TRUE EQUALS JUST FALSE; a function named for a power answers NOTHING when its "if" gate fails (fork F12)
#ASSERT `sch 1B para 4(3) the act does not constitute a breach of the restrictions placed on the relevant interest` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 4(3) the act does not constitute a breach of the restrictions placed on the relevant interest` FALSE EQUALS NOTHING
#ASSERT `sch 1B para 4(4)(a) the order containing the direction meets the requirement to specify the acts` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 4(4)(a) the order containing the direction meets the requirement to specify the acts` FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 4(4)(b) the order may confine the direction to cases where the acts are done by persons or for purposes described in the order` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 4(4)(b) the order may confine the direction to cases where the acts are done by persons or for purposes described in the order` FALSE EQUALS NOTHING
#ASSERT `sch 1B para 4(5) the direction may be given subject to the terms` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 4(5) the direction may be given subject to the terms` FALSE EQUALS NOTHING

-- ---- paragraphs 5, 6, 7
#ASSERT `sch 1B para 7(2) the provisions of paragraphs 5 and 6 are subject to the direction` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 7(2) the provisions of paragraphs 5 and 6 are subject to the direction` FALSE EQUALS NOTHING
-- columns: the thing; the person knows the interest is subject to restrictions; the provisions are subject to a direction
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2)(a) exercising or purporting to exercise any right to dispose of a relevant interest` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2)(b) exercising or purporting to exercise any right to dispose of any right to be issued with a relevant interest` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2)(c) voting in respect of a relevant interest (whether as holder of the interest or as proxy) or appointing a proxy to vote in respect of a relevant interest` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2)(c) voting in respect of a relevant interest (whether as holder of the interest or as proxy) or appointing a proxy to vote in respect of a relevant interest` FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2) another thing` TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 5(1) the person commits an offence` `sch 1B para 5(2)(a) exercising or purporting to exercise any right to dispose of a relevant interest` TRUE (JUST TRUE) EQUALS NOTHING
-- 5(3): holds a known restricted interest; knows another is entitled to vote; does not know that other is aware; fails to notify; direction
#ASSERT `sch 1B para 5(3) the person commits an offence` TRUE TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 5(3) the person commits an offence` FALSE TRUE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(3) the person commits an offence` TRUE FALSE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(3) the person commits an offence` TRUE TRUE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(3) the person commits an offence` TRUE TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(3) the person commits an offence` TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
-- 5(4): has a known restricted interest or an associated right; enters into a void agreement; direction
#ASSERT `sch 1B para 5(4) the person commits an offence` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 5(4) the person commits an offence` TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(4) the person commits an offence` FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 5(4) the person commits an offence` TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 1B para 5(5) the interest is subject to restrictions` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 5(5) the interest is subject to restrictions` FALSE EQUALS NOTHING
-- 6: shares issued in contravention; direction
#ASSERT `sch 1B para 6(a) the company commits an offence` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 6(a) the company commits an offence` FALSE NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 6(a) the company commits an offence` TRUE (JUST TRUE) EQUALS NOTHING
-- 6(b): shares issued in contravention; the officer is in default (s 1121); direction
#ASSERT `sch 1B para 6(b) the officer of the company commits an offence` TRUE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `sch 1B para 6(b) the officer of the company commits an offence` TRUE (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 6(b) the officer of the company commits an offence` TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 6(b) the officer of the company commits an offence` FALSE (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 1B para 6(b) the officer of the company commits an offence` TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- 7(1): a fine on indictment and, in England and Wales, on summary conviction; in Scotland or Northern Ireland a fine not exceeding the statutory maximum
#ASSERT `sch 1B para 7(1) the penalty for an offence under paragraph 5 or 6` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `sch 1B para 7(1) the penalty for an offence under paragraph 5 or 6` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `sch 1B para 7(1) the penalty for an offence under paragraph 5 or 6` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `sch 1B para 7(1) the penalty for an offence under paragraph 5 or 6` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `sch 1B para 7(1) the penalty for an offence under paragraph 5 or 6` `on summary conviction` EQUALS NOTHING

