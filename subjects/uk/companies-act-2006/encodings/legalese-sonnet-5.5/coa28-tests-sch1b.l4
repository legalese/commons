#ASSERT `sch 1B para 8(5)(b) sub-paragraph (3) applies to the making of the order` FALSE EQUALS NOTHING

-- ---- paragraphs 9 and 10
#ASSERT `sch 1B para 9(1) the court may order that the relevant interest be sold subject to the court's approval as to the sale` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 9(1) the court may order that the relevant interest be sold subject to the court's approval as to the sale` FALSE EQUALS NOTHING
