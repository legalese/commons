#ASSERT `sch 1B para 10(2) the person may apply to the court for the whole or part of the proceeds to be paid to the person` FALSE EQUALS NOTHING
-- 900 paid in with 90 interest: the sole beneficiary has 990; a beneficiary with 30 of a total value of 120 (one quarter) has 247.5
#ASSERT `sch 1B para 10(3) the amount the court must order to be paid to the applicant` 900 90 FALSE 30 120 EQUALS 990
#ASSERT `sch 1B para 10(3) the amount the court must order to be paid to the applicant` 900 90 TRUE 30 120 EQUALS 247.5
#ASSERT `sch 1B para 10(4) the applicant is entitled to payment of those costs out of the proceeds before any person receives any part of the proceeds under paragraph 10` TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 10(4) the applicant is entitled to payment of those costs out of the proceeds before any person receives any part of the proceeds under paragraph 10` FALSE EQUALS NOTHING

-- ---- paragraph 11: the company must withdraw the notice if (a), (b) or (c)
#ASSERT `sch 1B para 11 the company must by notice withdraw the restrictions notice` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 11 the company must by notice withdraw the restrictions notice` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 11 the company must by notice withdraw the restrictions notice` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1B para 11 the company must by notice withdraw the restrictions notice` FALSE FALSE FALSE EQUALS JUST FALSE
-- The same duty as a regulative rule. The stable binary prints a #TRACE result but a DEONTIC value cannot be compared in an
-- #ASSERT; the outcomes below were read from the trace output (recorded in NOTES.md, finding on #TRACE).
-- no event: the duty stands, no deadline; the company withdraws: fulfilled
#TRACE `sch 1B para 11 the company's duty to withdraw the restrictions notice` AT 0 WITH
#TRACE `sch 1B para 11 the company's duty to withdraw the restrictions notice` AT 0 WITH
    PARTY Company DOES `sch 1B para 11 the company withdraws the restrictions notice by notice` AT 5

-- ---- paragraph 12
#ASSERT `sch 1B para 12(3) the procedure for regulations under paragraph 12` EQUALS `s 1289 negative resolution procedure`

-- ---- paragraphs 13, 14, 14A, 14B: the offences
-- 13(1): the notice is addressed to the person; the person fails to comply; the person has a reasonable excuse
#ASSERT `sch 1B para 13(1) the person commits an offence by failing to comply with the notice` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 13(1) the person commits an offence by failing to comply with the notice` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1B para 13(1) the person commits an offence by failing to comply with the notice` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 1B para 13(1) the person commits an offence by failing to comply with the notice` FALSE TRUE FALSE EQUALS JUST FALSE
-- 13(2): the person is a legal entity; the entity commits the offence; the officer is in default (s 1121)
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 1B para 13(2) the officer of the entity commits an offence` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
-- 13(3) penalties: two years or a fine (or both) on indictment; on summary conviction the general limit (here 6 months) in England and Wales, 12 months in Scotland, 6 months in Northern Ireland
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on conviction on indictment` 6 EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on summary conviction in England and Wales` 6 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 6, Months), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on summary conviction in England and Wales` 12 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on summary conviction in Scotland` 6 EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on summary conviction in Northern Ireland` 6 EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `sch 1B para 13(3) the penalty for an offence under paragraph 13` `on summary conviction` 6 EQUALS NOTHING
