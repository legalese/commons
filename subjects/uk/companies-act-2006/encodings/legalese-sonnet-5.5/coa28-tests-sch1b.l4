#ASSERT `sch 1B para 14A(1) the person commits the basic offence of making a false statement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1B para 14A(1) the person commits the basic offence of making a false statement` TRUE TRUE EQUALS JUST FALSE
