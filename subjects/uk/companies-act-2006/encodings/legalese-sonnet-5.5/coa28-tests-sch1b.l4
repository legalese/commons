#ASSERT `sch 1B para 14(2) the officer of the entity commits an offence` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 1B para 14(2) the officer of the entity commits an offence` TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `sch 1B para 14(3) the penalty for an offence under paragraph 14` `on conviction on indictment` 6 EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `sch 1B para 14(3) the penalty for an offence under paragraph 14` `on summary conviction in Scotland` 6 EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `sch 1B para 14(3) the penalty for an offence under paragraph 14` `on summary conviction in Northern Ireland` 6 EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `sch 1B para 14(3) the penalty for an offence under paragraph 14` `on summary conviction in England and Wales` 6 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 6, Months), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `sch 1B para 14(3) the penalty for an offence under paragraph 14` `on summary conviction` 6 EQUALS NOTHING
