IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa20-part26`
IMPORT `coa20-part26a`

-- coa20-tests-part26a.l4: tests for coa20-part26a.l4 (ss 901A-901L). Expected values are written from the text of each section.
-- The twin sections 901D, 901E, 901H, 901J and 901K carry the twin's tests, renamed (work/gen_tests26a.py); the passages where the
-- twins differ (901D(8), 901K(2), 901F(1), 901G) have tests of their own, written from their own text.
-- T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Tests -- s 901A Application of this Part`
#ASSERT `s 901A(1) the provisions of Part 26A apply` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(1) the provisions of Part 26A apply` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 901A(1) the provisions of Part 26A apply` TRUE FALSE EQUALS JUST FALSE
-- s 901A(2) condition A: has encountered, or is likely to encounter, financial difficulties that are affecting, or will or may affect, its ability to carry on business as a going concern
#ASSERT `s 901A(2) condition A is met` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(2) condition A is met` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(2) condition A is met` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 901A(2) condition A is met` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 901A(3) condition B: (a) proposed with creditors or members, and (b) the purpose is to deal with the financial difficulties
#ASSERT `s 901A(3) condition B is met` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(3) condition B is met` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(3) condition B is met` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 901A(3) condition B is met` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 901A(4) the reorganisation of the share capital is an arrangement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 901A(4) the reorganisation of the share capital is an arrangement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901A(4) the reorganisation of the share capital is an arrangement` FALSE FALSE EQUALS NOTHING
#ASSERT `s 901A(4) the body is a company for the purposes of Part 26A` `s 901A(4) in section 901J` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 901A(4) the body is a company for the purposes of Part 26A` `s 901A(4) in section 901J` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 901A(4) the body is a company for the purposes of Part 26A` `s 901A(4) elsewhere in Part 26A` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901A(4) the body is a company for the purposes of Part 26A` `s 901A(4) elsewhere in Part 26A` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 901A(5) the provisions of Part 26A have effect subject to Part 27` TRUE EQUALS JUST TRUE
#ASSERT `s 901A(5) the provisions of Part 26A have effect subject to Part 27` FALSE EQUALS JUST FALSE

§ `Tests -- s 901B Power to exclude companies providing financial services, etc`
#ASSERT `s 901B(1) Part 26A does not apply because of regulations under section 901B` TRUE EQUALS JUST TRUE
#ASSERT `s 901B(1) Part 26A does not apply because of regulations under section 901B` FALSE EQUALS NOTHING
#ASSERT `s 901B(2) the person is an authorised person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901B(2) the person is an authorised person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 901B(2) the person is an authorised person` NOTHING EQUALS NOTHING
#ASSERT `s 901B(2) the description is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 901B(2) the description is specified` FALSE EQUALS JUST FALSE

§ `Tests -- s 901C Court order for holding of meeting`
#ASSERT `s 901C(1) the court may order a meeting of the creditors, class of creditors, members or class of members` TRUE EQUALS JUST TRUE
#ASSERT `s 901C(1) the court may order a meeting of the creditors, class of creditors, members or class of members` FALSE EQUALS NOTHING
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) a creditor of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) a member of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the liquidator of the company` TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F29)
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the administrator of the company` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the administrator of the company` TRUE FALSE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F29)
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) the administrator of the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 901C(2) the person may apply to the court` `s 896(2) any other person` TRUE TRUE EQUALS NOTHING
-- s 901C(3): every creditor or member whose rights are affected must be permitted to participate
#ASSERT `s 901C(3) the person must be permitted to participate in the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 901C(3) the person must be permitted to participate in the meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 901C(3) the person must be permitted to participate in the meeting` TRUE FALSE EQUALS NOTHING
-- s 901C(4): but not for a class in which the court is satisfied that none has a genuine economic interest
#ASSERT `s 901C(4) subsection (3) does not apply in relation to the class` TRUE EQUALS JUST TRUE
#ASSERT `s 901C(4) subsection (3) does not apply in relation to the class` FALSE EQUALS JUST FALSE
#ASSERT `s 901C(5) the person is the one who is to make the application under subsection (4)` TRUE EQUALS JUST TRUE
#ASSERT `s 901C(5) the person is the one who is to make the application under subsection (4)` FALSE EQUALS JUST FALSE
#ASSERT `s 901C(6) section 323 applies to the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 901C(6) section 323 applies to the meeting` FALSE EQUALS NOTHING
#ASSERT `s 901C(7) section 901C is subject to section 901H` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901C(7) section 901C is subject to section 901H` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 901C(7) section 901C is subject to section 901H` NOTHING EQUALS NOTHING

§ `Tests -- s 901D(8) The penalty (split by country)`
-- (a) on indictment, a fine; (b) summary conviction in England and Wales, a fine; (c) summary conviction in Scotland or Northern Ireland, a fine not exceeding the statutory maximum
#ASSERT `s 901D(8) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 901D(8) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 901D(8) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 901D(8) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, FALSE)
#ASSERT `s 901D(8) the penalty on conviction` `on summary conviction` EQUALS NOTHING

§ `Tests -- s 901F Court sanction for compromise or arrangement`
-- s 901F(1): a number representing 75% in value (at least 75%); no headcount test
#ASSERT `s 901F(1) the court may sanction the compromise or arrangement` FALSE 100 90 EQUALS NOTHING
#ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 100 75 EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 100 74 EQUALS JUST FALSE; the votes fall short of the "if" on which the court may sanction, and an unmet "if" on a power the text gives answers NOTHING, not JUST FALSE (name-test sweep, fork F30)
#ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 100 74 EQUALS NOTHING
#ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 1000 750 EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 1000 749 EQUALS JUST FALSE; the votes fall short of the "if" on which the court may sanction, and an unmet "if" on a power the text gives answers NOTHING, not JUST FALSE (name-test sweep, fork F30)
#ASSERT `s 901F(1) the court may sanction the compromise or arrangement` TRUE 1000 749 EQUALS NOTHING
-- s 901F(2): subject to ss 901G and 901H
#ASSERT `s 901F(2) section 901F(1) is subject to sections 901G and 901H` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 901F(2) section 901F(1) is subject to sections 901G and 901H` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901F(2) section 901F(1) is subject to sections 901G and 901H` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 901F(2) section 901F(1) is subject to sections 901G and 901H` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 901F(3) the person may apply to the court` `s 896(2) the company` FALSE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 901F(3) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE FALSE EQUALS JUST FALSE; a person named only on a condition whose condition is not met is not covered, not barred: an unmet "if" on a power the text gives answers NOTHING (name-test sweep, fork F31)
#ASSERT `s 901F(3) the person may apply to the court` `s 896(2) the liquidator of the company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 901F(3) the person may apply to the court` `s 896(2) the administrator of the company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901F(3) the person may apply to the court` `s 896(2) any other person` FALSE FALSE EQUALS NOTHING
-- s 901F(4): where the company is in administration or being wound up the court may make the three kinds of provision
#ASSERT `s 901F(4) the court may by the order make the provision` FALSE `s 901F(4)(a) provide for the appointment of the administrator or liquidator to cease to have effect` EQUALS NOTHING
#ASSERT `s 901F(4) the court may by the order make the provision` TRUE `s 901F(4)(a) provide for the appointment of the administrator or liquidator to cease to have effect` EQUALS JUST TRUE
#ASSERT `s 901F(4) the court may by the order make the provision` TRUE `s 901F(4)(b) stay or sist all proceedings in the administration or the winding up` EQUALS JUST TRUE
#ASSERT `s 901F(4) the court may by the order make the provision` TRUE `s 901F(4)(c) impose requirements with respect to the conduct of the administration or the winding up which the court thinks appropriate` EQUALS JUST TRUE
#ASSERT `s 901F(4) the court may by the order make the provision` TRUE `s 901F(4) any other provision` EQUALS NOTHING
-- s 901F(5): binding
#ASSERT `s 901F(5) the compromise or arrangement is binding on the person` FALSE `s 899(3) the company` EQUALS NOTHING
#ASSERT `s 901F(5) the compromise or arrangement is binding on the person` TRUE `s 899(3) a creditor of the creditors or class concerned` EQUALS JUST TRUE
#ASSERT `s 901F(5) the compromise or arrangement is binding on the person` TRUE `s 899(3) a contributory of a company in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 901F(5) the compromise or arrangement is binding on the person` TRUE `s 899(3) any other person` EQUALS NOTHING
-- s 901F(6): the bar lifts on publication in the Gazette (overseas company not required to register particulars) or delivery to the registrar (any other)
#ASSERT `s 901F(6) the court's order cannot yet have effect` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 901F(6) the court's order cannot yet have effect` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 901F(6) the court's order cannot yet have effect` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 901F(6) the court's order cannot yet have effect` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 901F(6) the court's order cannot yet have effect` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 901F(6) the court's order cannot yet have effect` FALSE TRUE FALSE EQUALS JUST TRUE

§ `Tests -- s 901G Sanction where one or more classes dissent`
-- s 901G(1): applies if a class has not agreed by at least 75% in value: 100 voting, 75 agreeing is agreement (does not apply); 74 does
#ASSERT `s 901G(1) this section applies` 100 74 EQUALS JUST TRUE
#ASSERT `s 901G(1) this section applies` 100 75 EQUALS JUST FALSE
#ASSERT `s 901G(1) this section applies` 0 0 EQUALS NOTHING
-- s 901G(2)-(5): conditions A and B
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 901G(2) the dissent of the dissenting class does not prevent the court from sanctioning under section 901F` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 901G(3) condition A is met` TRUE EQUALS JUST TRUE
#ASSERT `s 901G(3) condition A is met` FALSE EQUALS JUST FALSE
#ASSERT `s 901G(4) the relevant alternative` (JUST "a winding up") EQUALS JUST "a winding up"
#ASSERT `s 901G(4) the relevant alternative` NOTHING EQUALS NOTHING
#ASSERT `s 901G(5) condition B is met` 100 75 EQUALS JUST TRUE
#ASSERT `s 901G(5) condition B is met` 100 74 EQUALS JUST FALSE
#ASSERT `s 901G(5) condition B is met` 0 0 EQUALS NOTHING

