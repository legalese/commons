IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa12-logic`
IMPORT `coa12-ch6-liability`

-- coa12-tests-ch6.l4: tests for coa12-ch6-liability.l4 (ss 532-538A). Expected values are decided from the text before the run and
-- written beside each assertion. Argument order is the GIVEN order of each function.

-- ---- s 532(1): the provisions the section applies to
#ASSERT `s 532(1) the section applies to the provision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 532(1) the section applies to the provision` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 532(1) the section applies to the provision` FALSE FALSE EQUALS NOTHING
-- ---- s 532(2): void, except as permitted (s 533, ss 534 to 536). JUST TRUE is "void".
#ASSERT `s 532(2) the provision is void` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 532(2) the provision is void` (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 532(2) the provision is void` (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 532(2) the provision is void` (JUST TRUE) NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 532(2) the provision is void` (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 532(2) the provision is void` NOTHING NOTHING NOTHING EQUALS NOTHING
-- ---- s 532(3): wherever the provision is contained, the section applies
#ASSERT `s 532(3) the section applies to the provision wherever it is contained` `s 532(3) in the company's articles` EQUALS JUST TRUE
#ASSERT `s 532(3) the section applies to the provision wherever it is contained` `s 532(3) in a contract with the company` EQUALS JUST TRUE
#ASSERT `s 532(3) the section applies to the provision wherever it is contained` `s 532(3) otherwise` EQUALS JUST TRUE
-- ---- s 532(4): associated companies
#ASSERT `s 532(4) the companies are associated` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 532(4) the companies are associated` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 532(4) the companies are associated` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 532(4) the companies are associated` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 532(4) the companies are associated` NOTHING (JUST TRUE) EQUALS JUST TRUE
-- ---- s 533: section 532 does not prevent an indemnity for the costs of successfully defending proceedings, or on s 1157 relief
#ASSERT `s 533 section 532 does not prevent the indemnity` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 533 section 532 does not prevent the indemnity` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 533 section 532 does not prevent the indemnity` FALSE FALSE EQUALS NOTHING
-- ---- s 534(1): "liability limitation agreement"
#ASSERT `s 534(1) the agreement is a liability limitation agreement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 534(1) the agreement is a liability limitation agreement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 534(1) the agreement is a liability limitation agreement` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 534(1) the agreement is a liability limitation agreement` TRUE TRUE FALSE EQUALS JUST FALSE
-- ---- s 534(2): section 532 does not affect an agreement that complies with s 535 and is authorised (s 536)
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 534(2) section 532 does not affect the validity of the agreement` (JUST FALSE) NOTHING EQUALS NOTHING
-- ---- s 534(3)(a)
#ASSERT `s 534(3)(a) the agreement is effective to the extent provided by section 537` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 534(3)(a) the agreement is effective to the extent provided by section 537` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 534(3)(a) the agreement is effective to the extent provided by section 537` NOTHING EQUALS NOTHING
-- ---- s 534(3)(b): not subject to the Unfair Contract Terms Act 1977 (ss 2(2), 3(2)(a) in England and Wales and Northern Ireland; ss 16(1)(b), 17(1)(a) in Scotland)
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) `England and Wales` `s 534(3)(b)(i) section 2(2)` EQUALS JUST FALSE
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) `Northern Ireland` `s 534(3)(b)(i) section 3(2)(a)` EQUALS JUST FALSE
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) Scotland `s 534(3)(b)(ii) section 16(1)(b)` EQUALS JUST FALSE
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) Scotland `s 534(3)(b)(ii) section 17(1)(a)` EQUALS JUST FALSE
-- a section the paragraph pairs with the other place, or does not name: not covered
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) Scotland `s 534(3)(b)(i) section 2(2)` EQUALS NOTHING
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) `England and Wales` `s 534(3)(b)(ii) section 16(1)(b)` EQUALS NOTHING
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST TRUE) `England and Wales` `s 534(3)(b) another section` EQUALS NOTHING
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` (JUST FALSE) `England and Wales` `s 534(3)(b)(i) section 2(2)` EQUALS NOTHING
#ASSERT `s 534(3)(b) the agreement is subject to the section of the Unfair Contract Terms Act 1977` NOTHING `England and Wales` `s 534(3)(b)(i) section 2(2)` EQUALS NOTHING

-- ---- s 535(1): not more than one financial year; the financial year specified; the regulations (an input)
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 1 TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 2 TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 1 FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 1 TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 1 TRUE NOTHING EQUALS NOTHING
#ASSERT `s 535(1) the agreement complies with section 535 and any regulations under that section` 2 TRUE NOTHING EQUALS JUST FALSE
-- ---- s 535(4): how the agreement is framed; the limit need not be a sum or a formula
#ASSERT `s 535(4) the way the agreement is framed affects whether it complies` TRUE EQUALS JUST FALSE
#ASSERT `s 535(4) the way the agreement is framed affects whether it complies` FALSE EQUALS NOTHING
#ASSERT `s 535(4) the agreement must specify the limit as a sum of money or a formula` TRUE EQUALS JUST FALSE
#ASSERT `s 535(4) the agreement must specify the limit as a sum of money or a formula` FALSE EQUALS NOTHING

-- ---- s 536(2): a private company: three ways. s 536(3): a public company: two ways (in general meeting)
#ASSERT `s 536(2) the agreement between a private company and its auditor has been authorised under this section` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 536(2) the agreement between a private company and its auditor has been authorised under this section` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 536(2) the agreement between a private company and its auditor has been authorised under this section` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 536(2) the agreement between a private company and its auditor has been authorised under this section` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 536(2) the agreement between a private company and its auditor has been authorised under this section` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 536(3) the agreement between a public company and its auditor has been authorised under this section` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 536(3) the agreement between a public company and its auditor has been authorised under this section` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 536(3) the agreement between a public company and its auditor has been authorised under this section` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 536(3) the agreement between a public company and its auditor has been authorised under this section` FALSE TRUE TRUE EQUALS NOTHING
-- (1): authorised and not withdrawn
#ASSERT `s 536(1) the agreement is authorised by the members of the company` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 536(1) the agreement is authorised by the members of the company` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 536(1) the agreement is authorised by the members of the company` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 536(1) the agreement is authorised by the members of the company` NOTHING FALSE EQUALS NOTHING
-- (4): "principal terms"
#ASSERT `s 536(4) the term is one of the principal terms of the agreement` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 536(4) the term is one of the principal terms of the agreement` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 536(4) the term is one of the principal terms of the agreement` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 536(4) the term is one of the principal terms of the agreement` FALSE FALSE FALSE EQUALS JUST FALSE
-- (5): withdrawal by ordinary resolution: before entering into the agreement, or if already entered into, before the financial year begins
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST FALSE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` NOTHING FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 536(5) the authorisation may be withdrawn by the resolution` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 536(5)(b) a term of the agreement prevents the withdrawal` TRUE EQUALS JUST FALSE
#ASSERT `s 536(5)(b) a term of the agreement prevents the withdrawal` FALSE EQUALS NOTHING

-- ---- s 537: fair and reasonable
#ASSERT `s 537(1) the agreement is effective to limit the auditor's liability to the amount agreed` 100 100 EQUALS JUST TRUE
#ASSERT `s 537(1) the agreement is effective to limit the auditor's liability to the amount agreed` 99 100 EQUALS JUST FALSE
#ASSERT `s 537(1) the agreement is effective to limit the auditor's liability to the amount agreed` 150 100 EQUALS JUST TRUE
#ASSERT `s 537(1) regard is had to the matter in determining what is fair and reasonable` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 537(1) regard is had to the matter in determining what is fair and reasonable` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 537(1) regard is had to the matter in determining what is fair and reasonable` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1) regard is had to the matter in determining what is fair and reasonable` FALSE FALSE FALSE EQUALS NOTHING
-- (2): an agreement that limits to less has effect as if it limited to the fair and reasonable amount
#ASSERT `s 537(2) the amount to which the auditor's liability is limited` 60 100 EQUALS 100
#ASSERT `s 537(2) the amount to which the auditor's liability is limited` 100 100 EQUALS 100
#ASSERT `s 537(2) the amount to which the auditor's liability is limited` 150 100 EQUALS 150
-- (3): matters left out of account
#ASSERT `s 537(3) the matter is taken into account in determining what is fair and reasonable` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 537(3) the matter is taken into account in determining what is fair and reasonable` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 537(3) the matter is taken into account in determining what is fair and reasonable` FALSE FALSE EQUALS NOTHING

-- ---- s 538: disclosure by regulations (an input)
#ASSERT `s 538(1) the company must make the disclosure the regulations require` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 538(1) the company must make the disclosure the regulations require` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 538(1) the company must make the disclosure the regulations require` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 538(1) the company must make the disclosure the regulations require` FALSE (JUST TRUE) EQUALS NOTHING

-- ---- s 538A
#ASSERT `s 538A(1) the statement is a corporate governance statement` TRUE EQUALS JUST TRUE
#ASSERT `s 538A(1) the statement is a corporate governance statement` FALSE EQUALS JUST FALSE
#ASSERT `s 538A(3) the corporate governance statement is a separate one` TRUE EQUALS JUST FALSE
#ASSERT `s 538A(3) the corporate governance statement is a separate one` FALSE EQUALS JUST TRUE
