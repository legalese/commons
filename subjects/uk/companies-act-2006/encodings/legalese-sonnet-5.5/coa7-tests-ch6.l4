IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch6`

-- coa7-tests-ch6.l4: tests for coa7-ch6.l4 (Part 13 Chapter 6, ss 355 to 359).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 6 (ss 355 to 359)`

-- s 355(1): the three kinds of record
#ASSERT `s 355(1) the company has kept the record this subsection requires` `s 355(1)(a) copies of all resolutions of members passed otherwise than at general meetings` TRUE EQUALS JUST TRUE
#ASSERT `s 355(1) the company has kept the record this subsection requires` `s 355(1)(b) minutes of all proceedings of general meetings` TRUE EQUALS JUST TRUE
#ASSERT `s 355(1) the company has kept the record this subsection requires` `s 355(1)(c) details provided to the company in accordance with section 357 (decisions of sole member)` TRUE EQUALS JUST TRUE
#ASSERT `s 355(1) the company has kept the record this subsection requires` `s 355(1)(b) minutes of all proceedings of general meetings` FALSE EQUALS JUST FALSE
#ASSERT `s 355(1) the company has kept the record this subsection requires` `s 355(1) another record` TRUE EQUALS NOTHING
-- s 355(2): at least ten years from the date (a resolution of 1 March 2016: the ten years end on 28 February 2026)
#ASSERT `s 355(2) the record was kept for at least ten years` (Date 1 3 2016) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `s 355(2) the record was kept for at least ten years` (Date 1 3 2016) (Date 27 2 2026) EQUALS JUST FALSE
#ASSERT `s 355(3) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 355(3) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 355(3) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 355(3) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 355(4) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 355(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 355(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 355(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 355(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)

-- s 356(1)
#ASSERT `s 356(1) this section applies to the record` TRUE EQUALS JUST TRUE
#ASSERT `s 356(1) this section applies to the record` FALSE EQUALS NOTHING
-- s 356(2)
#ASSERT `s 356(2) the record is evidence (in Scotland, sufficient evidence) of the passing of the resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 356(2) the record is evidence (in Scotland, sufficient evidence) of the passing of the resolution` TRUE FALSE EQUALS NOTHING
#ASSERT `s 356(2) the record is evidence (in Scotland, sufficient evidence) of the passing of the resolution` FALSE TRUE EQUALS NOTHING
-- s 356(3): deemed complied with unless the contrary is proved
#ASSERT `s 356(3) the requirements of this Act with respect to the passing of the resolution are deemed to be complied with` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 356(3) the requirements of this Act with respect to the passing of the resolution are deemed to be complied with` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 356(3) the requirements of this Act with respect to the passing of the resolution are deemed to be complied with` FALSE FALSE EQUALS NOTHING
-- s 356(4)
#ASSERT `s 356(4) the minutes are evidence (in Scotland, sufficient evidence) of the proceedings at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 356(4) the minutes are evidence (in Scotland, sufficient evidence) of the proceedings at the meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 356(4) the minutes are evidence (in Scotland, sufficient evidence) of the proceedings at the meeting` FALSE TRUE EQUALS NOTHING
-- s 356(5): until the contrary is proved, the meeting is deemed duly held, its proceedings duly taken place, its appointments valid
#ASSERT `s 356(5) the fact is deemed` TRUE FALSE `s 356(5)(a) the meeting is deemed duly held and convened` EQUALS JUST TRUE
#ASSERT `s 356(5) the fact is deemed` TRUE FALSE `s 356(5)(b) all proceedings at the meeting are deemed to have duly taken place` EQUALS JUST TRUE
#ASSERT `s 356(5) the fact is deemed` TRUE FALSE `s 356(5)(c) all appointments at the meeting are deemed valid` EQUALS JUST TRUE
#ASSERT `s 356(5) the fact is deemed` TRUE TRUE `s 356(5)(a) the meeting is deemed duly held and convened` EQUALS JUST FALSE
#ASSERT `s 356(5) the fact is deemed` FALSE FALSE `s 356(5)(a) the meeting is deemed duly held and convened` EQUALS NOTHING

-- s 357(1)
#ASSERT `s 357(1) this section applies to the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 357(1) this section applies to the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 357(1) this section applies to the company` FALSE TRUE EQUALS NOTHING
-- s 357(2): the sole member must provide details of a decision, unless taken by written resolution
#ASSERT `s 357(2) the member must provide the company with details of the decision` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 357(2) the member must provide the company with details of the decision` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 357(2) the member must provide the company with details of the decision` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 357(2) the member must provide the company with details of the decision` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 357(2) the member must provide the company with details of the decision` NOTHING TRUE TRUE FALSE EQUALS NOTHING
-- s 357(3): a person who fails to comply commits an offence
#ASSERT `s 357(3) the person commits an offence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 357(3) the person commits an offence` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 357(3) the person commits an offence` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 357(3) the person commits an offence` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 357(4) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 357(4) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 2, 1), NOTHING, FALSE)
#ASSERT `s 357(4) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 2, 1), NOTHING, FALSE)
#ASSERT `s 357(4) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 2, 1), NOTHING, FALSE)
#ASSERT `s 357(4) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 2, 1), NOTHING, FALSE)
#ASSERT `s 357(5) the failure affects the validity of any decision referred to in subsection (2)` TRUE EQUALS JUST FALSE
#ASSERT `s 357(5) the failure affects the validity of any decision referred to in subsection (2)` FALSE EQUALS NOTHING

-- s 358(1): at the registered office, or at a place specified in regulations under s 1136
#ASSERT `s 358(1) the records relating to the previous ten years are kept available for inspection at a place this subsection allows` `s 358(1)(a) the company's registered office` NOTHING EQUALS JUST TRUE
#ASSERT `s 358(1) the records relating to the previous ten years are kept available for inspection at a place this subsection allows` `s 358(1)(b) a place specified in regulations under section 1136` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 358(1) the records relating to the previous ten years are kept available for inspection at a place this subsection allows` `s 358(1)(b) a place specified in regulations under section 1136` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 358(1) the records relating to the previous ten years are kept available for inspection at a place this subsection allows` `s 358(1)(b) a place specified in regulations under section 1136` NOTHING EQUALS NOTHING
#ASSERT `s 358(1) the records relating to the previous ten years are kept available for inspection at a place this subsection allows` `s 358(1) some other place` (JUST TRUE) EQUALS JUST FALSE
-- s 358(2): notice to the registrar of the place and of any change, unless the records have always been at the registered office
#ASSERT `s 358(2) the company must give notice to the registrar of the place and of any change` FALSE EQUALS JUST TRUE
#ASSERT `s 358(2) the company must give notice to the registrar of the place and of any change` TRUE EQUALS JUST FALSE
-- s 358(3), (4)
#ASSERT `s 358(3) the records must be open to the inspection of the person without charge` TRUE EQUALS JUST TRUE
#ASSERT `s 358(3) the records must be open to the inspection of the person without charge` FALSE EQUALS NOTHING
#ASSERT `s 358(4) the member may require a copy of any of the records` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 358(4) the member may require a copy of any of the records` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 358(4) the member may require a copy of any of the records` FALSE TRUE EQUALS NOTHING
-- s 358(5): default for 14 days, or an inspection refused, or a copy not sent: every officer who is in default
#ASSERT `s 358(5) the officer of the company commits an offence` 14 FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 358(5) the officer of the company commits an offence` 13 FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 358(5) the officer of the company commits an offence` 0 TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 358(5) the officer of the company commits an offence` 0 FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 358(5) the officer of the company commits an offence` 14 FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 358(5) the officer of the company commits an offence` 14 FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 358(6) the penalty on conviction` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 358(6) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 358(6) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 358(6) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 358(6) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 3, 1), JUST (`a fine not exceeding a level on the standard scale` OF 3, 0.1), FALSE)
#ASSERT `s 358(7) the court may by order compel an immediate inspection of the records or direct that the copies required be sent` TRUE EQUALS JUST TRUE
#ASSERT `s 358(7) the court may by order compel an immediate inspection of the records or direct that the copies required be sent` FALSE EQUALS JUST FALSE

-- s 359
#ASSERT `s 359 this Chapter applies (with necessary modifications) to the resolutions and meetings` `s 359(a) holders of a class of shares` TRUE EQUALS JUST TRUE
#ASSERT `s 359 this Chapter applies (with necessary modifications) to the resolutions and meetings` `s 359(b) a class of members of a company without a share capital` FALSE EQUALS JUST TRUE
#ASSERT `s 359 this Chapter applies (with necessary modifications) to the resolutions and meetings` `s 359(b) a class of members of a company without a share capital` TRUE EQUALS NOTHING
#ASSERT `s 359 this Chapter applies (with necessary modifications) to the resolutions and meetings` `s 359 another group` FALSE EQUALS NOTHING
