IMPORT prelude
IMPORT daydate
IMPORT `coa8-part14-meanings`

-- Tests of ss 363 to 365 (Part 14: the parties and organisations to which it applies, and the meanings of
-- "political donation" and "political expenditure"). Every expected value was written from the text before the run.

-- s 363(1): applies to a political party "if it is registered under Part 2 of the Political Parties, Elections and Referendums Act 2000"
#ASSERT `s 363(1) this Part applies to the political party` TRUE EQUALS JUST TRUE
#ASSERT `s 363(1) this Part applies to the political party` FALSE EQUALS JUST FALSE

-- s 363(3): applies to an independent election candidate "at any election to public office held in the United Kingdom"; elsewhere the text is silent
#ASSERT `s 363(3) this Part applies to the independent election candidate` TRUE EQUALS JUST TRUE
#ASSERT `s 363(3) this Part applies to the independent election candidate` FALSE EQUALS NOTHING

-- s 363(2)(a): capable of being reasonably regarded as intended to affect public support for a party or candidate to which this Part applies
#ASSERT `s 363(2)(a) the activities are intended to affect public support for a party or candidate to which this Part applies` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 363(2)(a) the activities are intended to affect public support for a party or candidate to which this Part applies` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 363(2)(a) the activities are intended to affect public support for a party or candidate to which this Part applies` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 363(2)(a) the activities are intended to affect public support for a party or candidate to which this Part applies` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 363(2)(a) the activities are intended to affect public support for a party or candidate to which this Part applies` FALSE NOTHING EQUALS JUST FALSE

-- s 363(2)(b): intended to influence voters in a national or regional referendum held under the law of the United Kingdom
#ASSERT `s 363(2)(b) the activities are intended to influence voters in a referendum` TRUE EQUALS JUST TRUE
#ASSERT `s 363(2)(b) the activities are intended to influence voters in a referendum` FALSE EQUALS JUST FALSE

-- s 363(2): an organisation is a political organisation "if it carries on, or proposes to carry on, activities" within (a) or (b)
#ASSERT `s 363(2) the organisation is a political organisation` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 363(2) the organisation is a political organisation` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 363(2) the organisation is a political organisation` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 363(2) the organisation is a political organisation` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 363(2) the organisation is a political organisation` TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 363(2) the organisation is a political organisation` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

-- s 363(4): a later reference is to a party, organisation, candidate or expenditure to which this Part applies
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political party` TRUE) EQUALS JUST TRUE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political party` FALSE) EQUALS JUST FALSE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political organisation` TRUE TRUE (JUST TRUE) FALSE) EQUALS JUST TRUE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political organisation` TRUE FALSE (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political organisation` TRUE FALSE (JUST TRUE) FALSE) EQUALS JUST FALSE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) a political organisation` FALSE TRUE (JUST TRUE) TRUE) EQUALS JUST FALSE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) an independent election candidate` TRUE) EQUALS JUST TRUE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) an independent election candidate` FALSE) EQUALS NOTHING
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) political expenditure` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) political expenditure` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 363(4) the reference is to a party, organisation, candidate or expenditure to which this Part applies` (`s 363(4) political expenditure` NOTHING) EQUALS NOTHING

-- s 364(4): sections 50 and 53 are treated as if the Electoral Administration Act 2006 amendments had not been made: the second answer governs
#ASSERT `s 364(4) the answer under sections 50 and 53 to use for this section` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 364(4) the answer under sections 50 and 53 to use for this section` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 364(4) the answer under sections 50 and 53 to use for this section` (JUST TRUE) NOTHING EQUALS NOTHING

-- s 364(2)(a): "political donation" means anything that constitutes, or would constitute, a donation under ss 50 to 52 of that Act
#ASSERT `s 364(2)(a) the thing is a political donation to the political party or other political organisation` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 364(2)(a) the thing is a political donation to the political party or other political organisation` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 364(2)(a) the thing is a political donation to the political party or other political organisation` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 364(2)(a) the thing is a political donation to the political party or other political organisation` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 364(2)(a) the thing is a political donation to the political party or other political organisation` NOTHING (JUST TRUE) EQUALS JUST TRUE

-- s 364(2)(b) and (3)(b): the value is whatever section 53 of that Act determines; unknown stays unknown
#ASSERT `s 364(2)(b) the value of the donation for this Part` (JUST 4800) EQUALS JUST 4800
#ASSERT `s 364(2)(b) the value of the donation for this Part` NOTHING EQUALS NOTHING
#ASSERT `s 364(3)(b) the value of the donation to the independent election candidate for this Part` (JUST 250) EQUALS JUST 250
#ASSERT `s 364(3)(b) the value of the donation to the independent election candidate for this Part` NOTHING EQUALS NOTHING

-- s 364(3)(a): a donation to an independent election candidate
#ASSERT `s 364(3)(a) the thing is a political donation to the independent election candidate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 364(3)(a) the thing is a political donation to the independent election candidate` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 364(3)(a) the thing is a political donation to the independent election candidate` NOTHING EQUALS NOTHING

-- s 365(1)(a): expenditure incurred by the company on advertising or publicity material capable of being regarded as intended to affect public support
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` FALSE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 365(1)(a) the expenditure is on advertising or publicity material intended to affect public support` TRUE TRUE TRUE NOTHING EQUALS NOTHING

-- s 365(1)(b): activities of the company intended (i) to affect public support or (ii) to influence referendum voters
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE TRUE TRUE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` FALSE TRUE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 365(1)(b) the expenditure is on activities intended to affect public support or to influence referendum voters` TRUE FALSE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE

-- s 365(1): either limb
#ASSERT `s 365(1) the expenditure is political expenditure` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 365(1) the expenditure is political expenditure` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 365(1) the expenditure is political expenditure` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 365(1) the expenditure is political expenditure` NOTHING (JUST FALSE) EQUALS NOTHING

-- s 365(2): "a political donation does not count as political expenditure"
#ASSERT `s 365(2) the spending counts as political expenditure` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 365(2) the spending counts as political expenditure` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 365(2) the spending counts as political expenditure` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 365(2) the spending counts as political expenditure` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 365(2) the spending counts as political expenditure` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 365(2) the spending counts as political expenditure` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 365(2) the spending counts as political expenditure` NOTHING NOTHING EQUALS NOTHING
