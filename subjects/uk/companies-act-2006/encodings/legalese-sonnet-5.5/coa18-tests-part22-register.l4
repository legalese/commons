-- 817(2)
#ASSERT `s 817(2) that other person may apply to the company for the removal of the entry from the register` TRUE EQUALS JUST TRUE
-- 817(2): section does not apply
#ASSERT `s 817(2) that other person may apply to the company for the removal of the entry from the register` FALSE EQUALS JUST FALSE
-- 817(3)
#ASSERT `s 817(3) the company shall remove the entry` TRUE EQUALS JUST TRUE
-- 817(3): not satisfied that it is incorrect
#ASSERT `s 817(3) the company shall remove the entry` FALSE EQUALS JUST FALSE
-- 817(4)
#ASSERT `s 817(4) the applicant may apply to the court for an order directing the company to remove the entry` TRUE EQUALS JUST TRUE
