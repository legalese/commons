IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa18-part22-interest`
IMPORT `coa18-part22-register`

-- coa18-tests-part22-register.l4: tests for coa18-part22-register.l4 (Companies Act 2006, ss 808 to 819).
-- Every expected value is written from the text, beside its assertion, before the run; a failing assertion is a finding.
-- Generated by work/gentests.py from work/tests/part22-register.py (the layout only; the values are hand-written).

§§ `the last day of each period of working days (s 827 stepper)`

GIVEN d IS A DATE
GIVETH A BOOLEAN
`s 808 test: a day is a working day unless it is a weekend or 6 January 2026` MEANS
    (NOT (`is weekend` d)) AND (NOT (elem d (LIST (Date 6 1 2026))))

-- 808(2): 3 working days after Thursday 1 January: Friday 2, Monday 5, Wednesday 7 (Tuesday 6 is listed)
#ASSERT `s 808(2) the last day for entering the information in the register` (Date 1 1 2026) `s 808 test: a day is a working day unless it is a weekend or 6 January 2026` EQUALS (Date 7 1 2026)
-- 810(2): 10 working days after Friday 2 January: Monday 19 January
#ASSERT `s 810(2) the last day for making the entry or alteration in the index` (Date 2 1 2026) `s 808 test: a day is a working day unless it is a weekend or 6 January 2026` EQUALS (Date 19 1 2026)

§§ `s 808 the register`

-- 808(1): information received under a section 793 notice
#ASSERT `s 808(1) the company must keep a register of the information received` TRUE EQUALS JUST TRUE
-- 808(1): none received: not mentioned
#ASSERT `s 808(1) the company must keep a register of the information received` FALSE EQUALS NOTHING
-- 808(2): the third working day
#ASSERT `s 808(2) the company entered the information in the register within three days of the receipt` 3 EQUALS JUST TRUE
-- 808(2): the fourth working day
#ASSERT `s 808(2) the company entered the information in the register within three days of the receipt` 4 EQUALS JUST FALSE
-- 808(2)(a),(b): fact and date, and the information
#ASSERT `s 808(2)(a) the entry contains the particulars the company must enter` TRUE TRUE EQUALS JUST TRUE
-- 808(2)(a): the fact and date are missing
#ASSERT `s 808(2)(a) the entry contains the particulars the company must enter` FALSE TRUE EQUALS JUST FALSE
-- 808(2)(b): the information is missing
#ASSERT `s 808(2)(a) the entry contains the particulars the company must enter` TRUE FALSE EQUALS JUST FALSE
-- 808(3): a known present holder; entered against his name
#ASSERT `s 808(3) the information is entered against the name the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
-- 808(3): a known present holder; entered against the interest holder instead
#ASSERT `s 808(3) the information is entered against the name the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- 808(3): no known present holder; entered against the person holding the interest
#ASSERT `s 808(3) the information is entered against the name the subsection requires` FALSE FALSE TRUE EQUALS JUST TRUE
-- 808(3): no known present holder; entered against nobody the subsection names
#ASSERT `s 808(3) the information is entered against the name the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
-- 808(4): chronological
#ASSERT `s 808(4) the register is made up as the subsection requires` TRUE EQUALS JUST TRUE
-- 808(4): not chronological
#ASSERT `s 808(4) the register is made up as the subsection requires` FALSE EQUALS JUST FALSE
-- 808(5)(a)
#ASSERT `s 808(5)(a) the company commits an offence` TRUE EQUALS JUST TRUE
-- 808(5): no default
#ASSERT `s 808(5)(a) the company commits an offence` FALSE EQUALS JUST FALSE
-- 808(5)(b)
#ASSERT `s 808(5)(b) the officer of the company commits an offence` TRUE ((JUST TRUE)) EQUALS JUST TRUE
-- 808(5)(b): not in default
#ASSERT `s 808(5)(b) the officer of the company commits an offence` TRUE ((JUST FALSE)) EQUALS JUST FALSE
-- 808(5)(b): s 1121 unknown
#ASSERT `s 808(5)(b) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
-- 808(5): no default
#ASSERT `s 808(5)(b) the officer of the company commits an offence` FALSE ((JUST TRUE)) EQUALS JUST FALSE
-- 808(6): level 3, daily default fine one-tenth of level 3
#ASSERT `s 808(6) the penalty on summary conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
-- 808(6): England and Wales
#ASSERT `s 808(6) the penalty on summary conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
