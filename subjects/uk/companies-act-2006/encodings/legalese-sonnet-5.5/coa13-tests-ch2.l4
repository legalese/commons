#ASSERT `s 555(4) the statement of capital meets the requirements of subsection (4)` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- s 556(4) and (1): section 556 applies to an unlimited company that allots a class with rights not in all respects uniform;
-- a difference only in dividend rights in the first twelve months is not a difference.
#ASSERT `s 556(4) the difference in rights is disregarded` TRUE EQUALS JUST TRUE
#ASSERT `s 556(4) the difference in rights is disregarded` FALSE EQUALS NOTHING
#ASSERT `s 556(1) section 556 applies to the allotment` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 556(1) section 556 applies to the allotment` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 556(1) section 556 applies to the allotment` FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 556(1) section 556 applies to the allotment` TRUE FALSE NOTHING EQUALS NOTHING

-- s 556(3): the return must contain the prescribed particulars of the rights.
#ASSERT `s 556(3) the return meets the requirement to contain the prescribed particulars of the rights` TRUE EQUALS JUST TRUE
#ASSERT `s 556(3) the return meets the requirement to contain the prescribed particulars of the rights` FALSE EQUALS JUST FALSE

-- s 557(1): default in complying with s 555 or s 556: an offence by every officer in default.
#ASSERT `s 557(1) the officer of the company commits an offence` (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 557(1) the officer of the company commits an offence` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 557(1) the officer of the company commits an offence` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 557(1) the officer of the company commits an offence` (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 557(1) the officer of the company commits an offence` (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 557(1) the officer of the company commits an offence` NOTHING (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 557(1) the officer of the company commits an offence` NOTHING NOTHING (JUST TRUE) EQUALS NOTHING

-- s 557(2): on indictment a fine; on summary conviction a fine not exceeding the statutory maximum and a daily default fine.
-- The text shows two readings of the daily default fine, so the daily fine in the penalty is NOTHING (the text does not choose).
#ASSERT `s 557(2)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 557(2)(b) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 557(2)(b) penalty on summary conviction`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT (count `s 557(2) the penalties for an offence under section 557`) EQUALS 2
-- First reading (one-tenth of the statutory maximum), illustrative maximum 10000: 1000.
#ASSERT `s 557(2)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the statutory maximum` 10000 EQUALS 1000
-- Second reading (one-tenth of the greater of 5000 and the level 4 amount): level 4 at 4000 gives 500; at 8000 gives 800.
#ASSERT `s 557(2)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the greater of £5,000 and level 4` 4000 EQUALS 500
#ASSERT `s 557(2)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the greater of £5,000 and level 4` 8000 EQUALS 800

-- s 557(3): relief for a default in delivering the return within one month.
#ASSERT `s 557(3)(a) the person may apply to the court for relief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 557(3)(a) the person may apply to the court for relief` FALSE TRUE EQUALS NOTHING
#ASSERT `s 557(3)(a) the person may apply to the court for relief` TRUE FALSE EQUALS NOTHING
#ASSERT `s 557(3)(b) the court may make an order extending the time for delivery` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 557(3)(b) the court may make an order extending the time for delivery` FALSE TRUE EQUALS JUST TRUE
