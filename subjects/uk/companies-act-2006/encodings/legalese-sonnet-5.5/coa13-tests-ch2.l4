IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa13-ch2-allotment`

-- coa13-tests-ch2.l4: tests for coa13-ch2-allotment.l4 (ss 549 to 559). Every expected value is written from the text of the
-- section named beside it, before the code was run. A test of a "not covered" case asserts NOTHING. The pounds used for a
-- fine's level are illustrative inputs: the Act does not state them and they are not a statement of what a level is.

§ `Tests for Part 17, Chapter 2`

-- s 549(2): (1) does not apply to allotment under an employees' share scheme, or to a grant of a right to shares so allotted.
#ASSERT `s 549(2) subsection (1) does not apply to the exercise` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 549(2) subsection (1) does not apply to the exercise` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 549(2) subsection (1) does not apply to the exercise` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 549(2) subsection (1) does not apply to the exercise` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 549(2) subsection (1) does not apply to the exercise` NOTHING TRUE FALSE EQUALS NOTHING

-- s 549(3): (1) does not apply to allotment pursuant to a right to subscribe or convert.
#ASSERT `s 549(3) subsection (1) does not apply to the allotment` TRUE EQUALS JUST TRUE
#ASSERT `s 549(3) subsection (1) does not apply to the allotment` FALSE EQUALS NOTHING

-- s 549(3A): (1) does not apply to anything done for a compromise or arrangement sanctioned under Part 26A.
#ASSERT `s 549(3A) subsection (1) does not apply to the thing done` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 549(3A) subsection (1) does not apply to the thing done` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 549(3A) subsection (1) does not apply to the thing done` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 549(3A) subsection (1) does not apply to the thing done` FALSE (JUST TRUE) EQUALS NOTHING

-- s 549(1): directors must not exercise the power except in accordance with s 550 or s 551 (and (2), (3), (3A) disapply).
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST TRUE) (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST FALSE) (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST FALSE) (JUST FALSE) NOTHING (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 549(1) the directors are prohibited from exercising the power` FALSE (JUST FALSE) (JUST FALSE) NOTHING NOTHING NOTHING EQUALS NOTHING

-- s 549(4): a director who knowingly contravenes, or permits or authorises a contravention, commits an offence.
#ASSERT `s 549(4) the director commits an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 549(4) the director commits an offence` FALSE EQUALS NOTHING

-- s 549(5): on indictment a fine; on summary conviction a fine not exceeding the statutory maximum.
#ASSERT `s 549(5)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 549(5)(b) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 549(5)(b) penalty on summary conviction`'s `how convicted` EQUALS `on summary conviction`
#ASSERT (count `s 549(5) the penalties for an offence under section 549`) EQUALS 2

-- s 549(6): nothing in the section affects the validity of an allotment or other transaction.
#ASSERT `s 549(6) section 549 makes the allotment or other transaction invalid` TRUE EQUALS JUST FALSE
#ASSERT `s 549(6) section 549 makes the allotment or other transaction invalid` FALSE EQUALS NOTHING

-- s 550: a private company with one class of shares: directors may allot that class unless the articles prohibit it.
#ASSERT `s 550 the directors may exercise the power under section 550` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 550 the directors may exercise the power under section 550` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 550 the directors may exercise the power under section 550` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 550 the directors may exercise the power under section 550` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 550 the directors may exercise the power under section 550` TRUE TRUE FALSE FALSE EQUALS JUST FALSE

-- s 551(1): directors may exercise the power if authorised by the articles or by resolution.
#ASSERT `s 551(1) the directors may exercise the power under section 551` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 551(1) the directors may exercise the power under section 551` TRUE FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 551(1) the directors may exercise the power under section 551` TRUE FALSE FALSE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 551(1) the directors may exercise the power under section 551` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 551(1) the directors may exercise the power under section 551` FALSE TRUE TRUE EQUALS NOTHING

-- s 551(2): authorisation may be particular or general, unconditional or conditional.
#ASSERT `s 551(2) the authorisation may be given in this way` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 551(2) the authorisation may be given in this way` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 551(2) the authorisation may be given in this way` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 551(2) the authorisation may be given in this way` TRUE FALSE FALSE FALSE EQUALS NOTHING

-- s 551(3)(a): the authorisation must state the maximum amount of shares.
#ASSERT `s 551(3)(a) the authorisation meets the requirement to state the maximum amount of shares` TRUE EQUALS JUST TRUE
#ASSERT `s 551(3)(a) the authorisation meets the requirement to state the maximum amount of shares` FALSE EQUALS JUST FALSE

-- s 551(3)(b): the expiry date must be not more than five years from (i) the date of incorporation, if the authorisation is in the
-- articles at the time of the original incorporation, or (ii) otherwise the date of the resolution. Exactly five years is allowed.
#ASSERT `s 551(3)(b) the authorisation meets the requirement to specify an expiry date within five years` TRUE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 10 3 2031) EQUALS JUST TRUE
#ASSERT `s 551(3)(b) the authorisation meets the requirement to specify an expiry date within five years` TRUE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 11 3 2031) EQUALS JUST FALSE
#ASSERT `s 551(3)(b) the authorisation meets the requirement to specify an expiry date within five years` TRUE TRUE (Date 1 6 2024) (Date 1 1 2020) (Date 1 6 2029) EQUALS JUST TRUE
#ASSERT `s 551(3)(b) the authorisation meets the requirement to specify an expiry date within five years` TRUE TRUE (Date 1 6 2024) (Date 1 1 2020) (Date 2 6 2029) EQUALS JUST FALSE
#ASSERT `s 551(3)(b) the authorisation meets the requirement to specify an expiry date within five years` FALSE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 10 3 2027) EQUALS JUST FALSE

-- s 551(3): both (a) and (b).
#ASSERT `s 551(3) the authorisation meets the requirements of subsection (3)` TRUE TRUE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 10 3 2031) EQUALS JUST TRUE
#ASSERT `s 551(3) the authorisation meets the requirements of subsection (3)` FALSE TRUE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 10 3 2031) EQUALS JUST FALSE
#ASSERT `s 551(3) the authorisation meets the requirements of subsection (3)` TRUE FALSE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 10 3 2031) EQUALS JUST FALSE
#ASSERT `s 551(3) the authorisation meets the requirements of subsection (3)` TRUE TRUE FALSE (Date 1 1 2020) (Date 10 3 2026) (Date 11 3 2031) EQUALS JUST FALSE

-- s 551(4)(a): renewal by resolution for a further period not exceeding five years.
#ASSERT `s 551(4)(a) the authorisation may be renewed or further renewed` TRUE (Date 10 3 2026) (Date 10 3 2031) EQUALS JUST TRUE
#ASSERT `s 551(4)(a) the authorisation may be renewed or further renewed` TRUE (Date 10 3 2026) (Date 11 3 2031) EQUALS JUST FALSE
#ASSERT `s 551(4)(a) the authorisation may be renewed or further renewed` FALSE (Date 10 3 2026) (Date 10 3 2027) EQUALS NOTHING

-- s 551(4)(b): revoked or varied at any time by resolution.
#ASSERT `s 551(4)(b) the authorisation may be revoked or varied` TRUE EQUALS JUST TRUE
#ASSERT `s 551(4)(b) the authorisation may be revoked or varied` FALSE EQUALS NOTHING

-- s 551(5): a renewing resolution must state the amount and specify the date.
#ASSERT `s 551(5)(a) the resolution meets the requirement to state the maximum or remaining amount` TRUE EQUALS JUST TRUE
#ASSERT `s 551(5)(a) the resolution meets the requirement to state the maximum or remaining amount` FALSE EQUALS JUST FALSE
#ASSERT `s 551(5)(b) the resolution meets the requirement to specify the expiry date` TRUE EQUALS JUST TRUE
#ASSERT `s 551(5)(b) the resolution meets the requirement to specify the expiry date` FALSE EQUALS JUST FALSE
#ASSERT `s 551(5) the resolution renewing the authorisation meets the requirements of subsection (5)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551(5) the resolution renewing the authorisation meets the requirements of subsection (5)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 551(5) the resolution renewing the authorisation meets the requirements of subsection (5)` FALSE TRUE EQUALS JUST FALSE

-- s 551(6): for rights to subscribe or convert, the maximum amount is the maximum that may be allotted pursuant to the rights.
#ASSERT `s 551(6) the maximum amount of shares that may be allotted under the authorisation, for the purposes of section 551` FALSE 1000 400 EQUALS 1000
#ASSERT `s 551(6) the maximum amount of shares that may be allotted under the authorisation, for the purposes of section 551` TRUE 1000 400 EQUALS 400

-- s 551(7): after expiry, directors may allot under an earlier offer or agreement the authorisation allowed.
#ASSERT `s 551(7) the directors may allot shares or grant rights after the authorisation has expired` TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 551(7) the directors may allot shares or grant rights after the authorisation has expired` TRUE FALSE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 551(7) the directors may allot shares or grant rights after the authorisation has expired` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 551(7) the directors may allot shares or grant rights after the authorisation has expired` FALSE TRUE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 551(7) the directors may allot shares or grant rights after the authorisation has expired` FALSE TRUE EQUALS NOTHING

-- s 551(8): a resolution under section 551 may be an ordinary resolution.
#ASSERT `s 551(8) the resolution may be an ordinary resolution` TRUE `an ordinary resolution` EQUALS JUST TRUE
#ASSERT `s 551(8) the resolution may be an ordinary resolution` TRUE `a special resolution` EQUALS NOTHING
#ASSERT `s 551(8) the resolution may be an ordinary resolution` FALSE `an ordinary resolution` EQUALS NOTHING

-- s 551(9): Chapter 3 of Part 3 applies to a resolution under the section.
#ASSERT `s 551(9) Chapter 3 of Part 3 applies to the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 551(9) Chapter 3 of Part 3 applies to the resolution` FALSE EQUALS NOTHING

-- s 553(2)(a) and (b): conditions of a permitted commission. Issue price 1000: 10% is 100; the articles authorise 80: the less is 80.
#ASSERT `s 553(2)(a) the condition that the articles authorise the commission is satisfied` TRUE EQUALS JUST TRUE
#ASSERT `s 553(2)(a) the condition that the articles authorise the commission is satisfied` FALSE EQUALS JUST FALSE
#ASSERT `s 553(2)(b) the condition that the commission does not exceed the limit is satisfied` 80 1000 80 EQUALS JUST TRUE
#ASSERT `s 553(2)(b) the condition that the commission does not exceed the limit is satisfied` 81 1000 80 EQUALS JUST FALSE
#ASSERT `s 553(2)(b) the condition that the commission does not exceed the limit is satisfied` 100 1000 150 EQUALS JUST TRUE
#ASSERT `s 553(2)(b) the condition that the commission does not exceed the limit is satisfied` 101 1000 150 EQUALS JUST FALSE

-- s 553(1): a company may pay a commission if the conditions are satisfied.
#ASSERT `s 553(1) the company may pay the commission` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 553(1) the company may pay the commission` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 553(1) the company may pay the commission` TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 553(1) the company may pay the commission` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 553(1) the company may pay the commission` TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 553(1) the company may pay the commission` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 553(1) the company may pay the commission` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING

-- s 553(3): a vendor, promoter or other recipient may apply money or shares in payment of a commission the company could pay.
#ASSERT `s 553(3) the person may apply the money or shares in payment of the commission` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 553(3) the person may apply the money or shares in payment of the commission` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 553(3) the person may apply the money or shares in payment of the commission` FALSE (JUST TRUE) EQUALS NOTHING

-- s 552(1): a company must not apply shares or capital money in payment of a commission, discount or allowance, except as s 553 permits.
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE TRUE FALSE NOTHING EQUALS NOTHING; s 553(1), which is named for a grant, now answers NOTHING for a commission outside its conditions, and s 552(1) reads an exception that answers NOTHING as not shown to apply (fork F-exception), so the prohibition stands: JUST TRUE; the facts are unchanged
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` TRUE FALSE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 552(1) the company is prohibited from applying its shares or capital money in payment` FALSE TRUE FALSE (JUST FALSE) EQUALS NOTHING

-- s 552(2): it is immaterial how the shares or money are applied (flat negative, four ways).
#ASSERT `s 552(2) the manner of application affects whether the prohibition applies` `s 552(2) by being added to the purchase money of property acquired by the company` EQUALS JUST FALSE
#ASSERT `s 552(2) the manner of application affects whether the prohibition applies` `s 552(2) by being added to the contract price of work to be executed for the company` EQUALS JUST FALSE
#ASSERT `s 552(2) the manner of application affects whether the prohibition applies` `s 552(2) by being paid out of the nominal purchase money or contract price` EQUALS JUST FALSE
#ASSERT `s 552(2) the manner of application affects whether the prohibition applies` `s 552(2) in some other way` EQUALS JUST FALSE

-- s 552(3): nothing in the section affects the payment of brokerage that has previously been lawful.
#ASSERT `s 552(3) section 552 affects the payment of the brokerage` TRUE EQUALS JUST FALSE
#ASSERT `s 552(3) section 552 affects the payment of the brokerage` FALSE EQUALS NOTHING

-- s 558: shares are taken to be allotted when a person acquires the unconditional right to be on the register of members.
#ASSERT `s 558 the shares are taken to be allotted` TRUE EQUALS JUST TRUE
#ASSERT `s 558 the shares are taken to be allotted` FALSE EQUALS JUST FALSE
#ASSERT `s 558 the date on which the shares are taken to be allotted` (Date 5 3 2026) EQUALS Date 5 3 2026

-- s 554(2): the duty does not apply if a share warrant has been issued.
#ASSERT `s 554(2) the duty in section 554(1) does not apply` TRUE EQUALS JUST TRUE
#ASSERT `s 554(2) the duty in section 554(1) does not apply` FALSE EQUALS JUST FALSE

-- s 554(1): register within two months after the allotment date. Allotment on 15 January 2026: the last day is 15 March 2026.
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST TRUE) (Date 15 1 2026) FALSE (Date 1 1 2026) FALSE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) TRUE (Date 15 3 2026) TRUE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) TRUE (Date 16 3 2026) TRUE (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) TRUE (Date 1 2 2026) FALSE (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) FALSE (Date 1 1 2026) FALSE (Date 16 3 2026) EQUALS JUST FALSE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) FALSE (Date 1 1 2026) FALSE (Date 15 3 2026) EQUALS NOTHING
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 15 1 2026) FALSE (Date 1 1 2026) FALSE (Date 1 2 2026) EQUALS NOTHING
-- Month-end: an allotment on 31 December 2025 has no 31 February; the last day is taken as 28 February 2026 (fork F-periods).
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 31 12 2025) TRUE (Date 28 2 2026) TRUE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 554(1) the company has complied with the duty to register the allotment` (JUST FALSE) (Date 31 12 2025) TRUE (Date 1 3 2026) TRUE (Date 1 6 2026) EQUALS JUST FALSE

-- s 554(3): if a company fails to comply, the company and every officer in default commit an offence.
#ASSERT `s 554(3)(a) the company commits an offence` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 554(3)(a) the company commits an offence` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 554(3)(a) the company commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 554(3)(b) the officer of the company commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 554(3)(b) the officer of the company commits an offence` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 554(3)(b) the officer of the company commits an offence` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 554(3)(b) the officer of the company commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 554(3)(b) the officer of the company commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING

-- s 554(4): summary conviction: a fine not exceeding level 3; continued contravention: a daily default fine not exceeding one-tenth of level 3.
#ASSERT `s 554(4) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT `s 554(4) penalty on summary conviction`'s `daily default fine for continued contravention` EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)
#ASSERT `s 554(4) penalty on summary conviction`'s `how convicted` EQUALS `on summary conviction`
-- With an illustrative 1000 for level 3: the fine is 1000 and the daily default fine is 100.
#ASSERT `s 554(4) the most the fine can be, in pounds` 1000 EQUALS 1000
#ASSERT `s 554(4) the most the daily default fine can be, in pounds` 1000 EQUALS 100

-- s 555(1): applies to a company limited by shares, and to one limited by guarantee and having a share capital.
`s 555(1) test company limited by shares` MEANS `Company profile` WITH
    `place of registration` IS `England and Wales`
    `liability of the members` IS `liability limited to the amount, if any, unpaid on the shares held`
    `a share capital` IS TRUE
    `certificate of incorporation stating that it is a public company` IS FALSE

`s 555(1) test company limited by guarantee with a share capital` MEANS `Company profile` WITH
    `place of registration` IS `England and Wales`
    `liability of the members` IS `liability limited to the amount the members undertake to contribute on a winding up`
    `a share capital` IS TRUE
    `certificate of incorporation stating that it is a public company` IS FALSE

`s 555(1) test company limited by guarantee without a share capital` MEANS `Company profile` WITH
    `place of registration` IS `Scotland`
    `liability of the members` IS `liability limited to the amount the members undertake to contribute on a winding up`
    `a share capital` IS FALSE
    `certificate of incorporation stating that it is a public company` IS FALSE

`s 555(1) test unlimited company` MEANS `Company profile` WITH
    `place of registration` IS `England and Wales`
    `liability of the members` IS `liability not limited`
    `a share capital` IS TRUE
    `certificate of incorporation stating that it is a public company` IS FALSE

#ASSERT `s 555(1) section 555 applies to the company` `s 555(1) test company limited by shares` EQUALS JUST TRUE
#ASSERT `s 555(1) section 555 applies to the company` `s 555(1) test company limited by guarantee with a share capital` EQUALS JUST TRUE
#ASSERT `s 555(1) section 555 applies to the company` `s 555(1) test company limited by guarantee without a share capital` EQUALS NOTHING
#ASSERT `s 555(1) section 555 applies to the company` `s 555(1) test unlimited company` EQUALS NOTHING

