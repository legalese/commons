#ASSERT `s 555(4) the statement of capital meets the requirements of subsection (4)` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 555(4) the statement of capital meets the requirements of subsection (4)` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 555(4) the statement of capital meets the requirements of subsection (4)` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
