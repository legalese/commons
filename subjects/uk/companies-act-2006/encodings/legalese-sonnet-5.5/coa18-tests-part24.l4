#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE TRUE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, TRUE)) EQUALS JUST TRUE
-- 853D(4)(d)(ii): the second class has no total number of shares
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE TRUE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, TRUE), (`s 853D(4)(d) statement about a class of shares` OF TRUE, FALSE, TRUE)) EQUALS JUST FALSE
-- 853D(4)(a): no total number of shares
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` FALSE TRUE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, TRUE)) EQUALS JUST FALSE
-- 853D(4)(b): no aggregate nominal value
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE FALSE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, TRUE)) EQUALS JUST FALSE
-- 853D(4)(c): no aggregate amount unpaid
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE TRUE FALSE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, TRUE)) EQUALS JUST FALSE
-- 853D(4)(d)(i): no prescribed particulars of the rights
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE TRUE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF FALSE, TRUE, TRUE)) EQUALS JUST FALSE
-- 853D(4)(d)(iii): no aggregate nominal value of the class
#ASSERT `s 853D(4) the statement of capital states what the subsection requires with respect to the company's share capital at the confirmation date` TRUE TRUE TRUE (LIST (`s 853D(4)(d) statement about a class of shares` OF TRUE, TRUE, FALSE)) EQUALS JUST FALSE
