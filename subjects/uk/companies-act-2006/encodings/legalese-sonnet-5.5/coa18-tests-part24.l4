IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa18-part24`

-- coa18-tests-part24.l4: tests for coa18-part24.l4 (Companies Act 2006, Part 24, ss 853A to 859).
-- Every expected value is written from the text, beside its assertion, before the run; a failing assertion is a finding.
-- Generated by work/gentests.py from work/tests/part24.py (the layout only; the values are hand-written).

§§ `s 853A confirmation statements`

-- 853A(1): 28 February 2026 plus 14 days
#ASSERT `s 853A(1) the last day of the period of 14 days after the end of the review period` (Date 28 2 2026) EQUALS (Date 14 3 2026)
-- 853A(1): leap year: 29 February 2024 plus 14 days
#ASSERT `s 853A(1) the last day of the period of 14 days after the end of the review period` (Date 29 2 2024) EQUALS (Date 14 3 2024)
-- 853A(1): across the new year
#ASSERT `s 853A(1) the last day of the period of 14 days after the end of the review period` (Date 31 12 2026) EQUALS (Date 14 1 2027)
-- 853A(5)(a): 12 months beginning 1 March 2024 end on 28 February 2025
#ASSERT `s 853A(5) the last day of the review period beginning on the day` (Date 1 3 2024) EQUALS (Date 28 2 2025)
-- 853A(5): 12 months beginning 1 January 2026 end on 31 December 2026
#ASSERT `s 853A(5) the last day of the review period beginning on the day` (Date 1 1 2026) EQUALS (Date 31 12 2026)
-- 853A(5): the period ends on the leap day before the anniversary (1 March 2024)
#ASSERT `s 853A(5) the last day of the review period beginning on the day` (Date 1 3 2023) EQUALS (Date 29 2 2024)
-- 853A(5): incorporation on 29 February: the anniversary is taken as 1 March (fork register), so the period ends on 28 February 2025
#ASSERT `s 853A(5) the last day of the review period beginning on the day` (Date 29 2 2024) EQUALS (Date 28 2 2025)
-- 853A(5)(b): the next review period begins the day after the end of the previous one and ends a year less a day later
#ASSERT `s 853A(5) the last day of the review period beginning on the day` (Date 1 3 2025) EQUALS (Date 28 2 2026)
-- 853A(6): a confirmation date earlier than the last day: the next review period begins the day after the confirmation date
#ASSERT `s 853A(6) the first day of the next review period` (Date 28 2 2026) (Date 31 12 2025) EQUALS (Date 1 1 2026)
-- 853A(6): a confirmation date on the last day: the next period begins the day after the last day
#ASSERT `s 853A(6) the first day of the next review period` (Date 28 2 2026) (Date 28 2 2026) EQUALS (Date 1 3 2026)
-- 853A(6): a confirmation date one day early: the next period begins on the last day of the old one
#ASSERT `s 853A(6) the first day of the next review period` (Date 28 2 2026) (Date 27 2 2026) EQUALS (Date 28 2 2026)
-- 853A(4): on the last day
#ASSERT `s 853A(4) the confirmation date is no later than the last day of the review period concerned` (Date 28 2 2026) (Date 28 2 2026) EQUALS JUST TRUE
-- 853A(4): the day after the last day
#ASSERT `s 853A(4) the confirmation date is no later than the last day of the review period concerned` (Date 1 3 2026) (Date 28 2 2026) EQUALS JUST FALSE
-- 853A(3)(a): the first statement: the day of incorporation
#ASSERT `s 853A(3) the first day of the confirmation period` TRUE (Date 1 3 2024) NOTHING EQUALS (JUST (Date 1 3 2024))
-- 853A(3)(b): any other: the day after the confirmation date of the last statement
#ASSERT `s 853A(3) the first day of the confirmation period` FALSE (Date 1 3 2024) (JUST (Date 28 2 2025)) EQUALS (JUST (Date 1 3 2025))
-- 853A(3)(b): the last confirmation date is not given
#ASSERT `s 853A(3) the first day of the confirmation period` FALSE (Date 1 3 2024) NOTHING EQUALS NOTHING
-- 853A(3): the confirmation period ends with the date specified in the statement
#ASSERT `s 853A(3) the confirmation date and the last day of the confirmation period` (Date 28 2 2026) EQUALS (Date 28 2 2026)
-- 853A(1): delivered on the fourteenth day after the end of the review period
#ASSERT `s 853A(1) the confirmation statement was delivered before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) (Date 14 3 2026) EQUALS JUST TRUE
-- 853A(1): the fifteenth day
#ASSERT `s 853A(1) the confirmation statement was delivered before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) (Date 15 3 2026) EQUALS JUST FALSE
-- 853A(1): delivered the day after the end of the review period
#ASSERT `s 853A(1) the confirmation statement was delivered before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) (Date 1 3 2026) EQUALS JUST TRUE
-- 853A(1): a leap-year review period end: 29 February + 14 days is 14 March
#ASSERT `s 853A(1) the confirmation statement was delivered before the end of the period of 14 days after the end of the review period` (Date 29 2 2024) (Date 14 3 2024) EQUALS JUST TRUE
-- 853A(1): one day later
#ASSERT `s 853A(1) the confirmation statement was delivered before the end of the period of 14 days after the end of the review period` (Date 29 2 2024) (Date 15 3 2024) EQUALS JUST FALSE
-- 853A(1)(a)
#ASSERT `s 853A(1)(a) the company delivered the information necessary to make the confirmation statement` TRUE EQUALS JUST TRUE
-- 853A(1)(a)
#ASSERT `s 853A(1)(a) the company delivered the information necessary to make the confirmation statement` FALSE EQUALS JUST FALSE
-- 853A(1)(b)(i),(ii): a statement that is not the first
#ASSERT `s 853A(1)(b) the confirmation statement confirms what the paragraph requires` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- 853A(1)(b)(iii): the first statement also confirms the pre-incorporation information
#ASSERT `s 853A(1)(b) the confirmation statement confirms what the paragraph requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- 853A(1)(b)(iii): the first statement without that confirmation
#ASSERT `s 853A(1)(b) the confirmation statement confirms what the paragraph requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 853A(1)(b)(i): does not confirm the relevant-event information
#ASSERT `s 853A(1)(b) the confirmation statement confirms what the paragraph requires` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- 853A(1)(b)(ii): does not confirm the ss 853BA to 853H information
#ASSERT `s 853A(1)(b) the confirmation statement confirms what the paragraph requires` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- 853A(7): "unless the registrar has notified the company otherwise"
#ASSERT `s 853A(7) the company is entitled to assume that information that has been delivered to the registrar has been properly delivered` TRUE EQUALS JUST FALSE
-- 853A(7)
#ASSERT `s 853A(7) the company is entitled to assume that information that has been delivered to the registrar has been properly delivered` FALSE EQUALS JUST TRUE

§§ `s 853B to s 853CB`

-- 853B(c)
#ASSERT `s 853B the duty is a duty to notify a relevant event` `s 853B(c) the duty to give notice of a change as mentioned in section 167G or 167H` FALSE EQUALS JUST TRUE
