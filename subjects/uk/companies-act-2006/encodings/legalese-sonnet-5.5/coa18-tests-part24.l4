§§ `s 853L failure to deliver confirmation statement`

-- 853L(2)(a): the greater of 500 pounds and one-tenth of level 4 (2500 pounds): one-tenth is 250, so 500
#ASSERT `s 853L(2) the daily default fine limit in pounds` (`s 853L(2)(a) the greater of an amount in pounds and a fraction of a level on the standard scale` 500 4 0.1) 2500 EQUALS 500
-- 853L(2)(a): one-tenth of level 4 (10000 pounds) is 1000: the greater
#ASSERT `s 853L(2) the daily default fine limit in pounds` (`s 853L(2)(a) the greater of an amount in pounds and a fraction of a level on the standard scale` 500 4 0.1) 10000 EQUALS 1000
-- 853L(2)(a): one-tenth of level 4 equals 500: equal
#ASSERT `s 853L(2) the daily default fine limit in pounds` (`s 853L(2)(a) the greater of an amount in pounds and a fraction of a level on the standard scale` 500 4 0.1) 5000 EQUALS 500
-- 853L(2)(b): one-tenth of level 5 (5000 pounds)
#ASSERT `s 853L(2) the daily default fine limit in pounds` (`s 853L(2)(b) a fraction of a level on the standard scale` 5 0.1) 5000 EQUALS 500
-- 853L(1): delivered on the fourteenth day: in time
#ASSERT `s 853L(1) the company has failed to deliver a confirmation statement before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) (JUST (Date 14 3 2026)) (Date 1 6 2026) EQUALS JUST FALSE
-- 853L(1): delivered on the fifteenth day: a failure
#ASSERT `s 853L(1) the company has failed to deliver a confirmation statement before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) (JUST (Date 15 3 2026)) (Date 1 6 2026) EQUALS JUST TRUE
-- 853L(1): not yet delivered; the period has not ended
#ASSERT `s 853L(1) the company has failed to deliver a confirmation statement before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) NOTHING (Date 14 3 2026) EQUALS JUST FALSE
-- 853L(1): not delivered and the period has ended
#ASSERT `s 853L(1) the company has failed to deliver a confirmation statement before the end of the period of 14 days after the end of the review period` (Date 28 2 2026) NOTHING (Date 15 3 2026) EQUALS JUST TRUE
-- 853L(1)(a)
#ASSERT `s 853L(1)(a) the company commits an offence` ((JUST TRUE)) EQUALS JUST TRUE
-- 853L(1)(a): no failure
#ASSERT `s 853L(1)(a) the company commits an offence` ((JUST FALSE)) EQUALS JUST FALSE
-- 853L(1)(a): not known
#ASSERT `s 853L(1)(a) the company commits an offence` NOTHING EQUALS NOTHING
-- 853L(1)(b): failure and the officer is in default
#ASSERT `s 853L(1)(b) the officer of the company commits an offence` ((JUST TRUE)) ((JUST TRUE)) EQUALS JUST TRUE
-- 853L(1)(b): failure but the officer is not in default
#ASSERT `s 853L(1)(b) the officer of the company commits an offence` ((JUST TRUE)) ((JUST FALSE)) EQUALS JUST FALSE
-- 853L(1)(b): s 1121 unknown
#ASSERT `s 853L(1)(b) the officer of the company commits an offence` ((JUST TRUE)) NOTHING EQUALS NOTHING
-- 853L(1)(b): no failure
#ASSERT `s 853L(1)(b) the officer of the company commits an offence` ((JUST FALSE)) ((JUST TRUE)) EQUALS JUST FALSE
-- 853L(1)(b): failure not known
#ASSERT `s 853L(1)(b) the officer of the company commits an offence` NOTHING ((JUST TRUE)) EQUALS NOTHING
-- 853L(1): a director
#ASSERT `s 853L(1) the person is treated as a director for the purposes of subsection (1)` TRUE NOTHING EQUALS JUST TRUE
-- 853L(1): "a shadow director is treated as a director"
#ASSERT `s 853L(1) the person is treated as a director for the purposes of subsection (1)` FALSE ((JUST TRUE)) EQUALS JUST TRUE
-- 853L(1): neither a director nor a shadow director (the seam says no)
#ASSERT `s 853L(1) the person is treated as a director for the purposes of subsection (1)` FALSE ((JUST FALSE)) EQUALS JUST FALSE
-- 853L(1): s 251 unknown
#ASSERT `s 853L(1) the person is treated as a director for the purposes of subsection (1)` FALSE NOTHING EQUALS NOTHING
-- 853L(2)(a): a fine; daily default fine not exceeding the greater of 500 pounds and one-tenth of level 4
#ASSERT `s 853L(2) the penalty on summary conviction` `on summary conviction in England and Wales` EQUALS JUST (`s 853L(2) penalty` OF `on summary conviction in England and Wales`, JUST `a fine without a stated limit`, JUST (`s 853L(2)(a) the greater of an amount in pounds and a fraction of a level on the standard scale` 500 4 0.1))
-- 853L(2)(b): level 5; daily default fine one-tenth of level 5 (Scotland)
#ASSERT `s 853L(2) the penalty on summary conviction` `on summary conviction in Scotland` EQUALS JUST (`s 853L(2) penalty` OF `on summary conviction in Scotland`, JUST (`a fine not exceeding a level on the standard scale` 5 1), JUST (`s 853L(2)(b) a fraction of a level on the standard scale` 5 0.1))
-- 853L(2)(b): Northern Ireland
#ASSERT `s 853L(2) the penalty on summary conviction` `on summary conviction in Northern Ireland` EQUALS JUST (`s 853L(2) penalty` OF `on summary conviction in Northern Ireland`, JUST (`a fine not exceeding a level on the standard scale` 5 1), JUST (`s 853L(2)(b) a fraction of a level on the standard scale` 5 0.1))
-- 853L(2): summary conviction without a place: not covered
#ASSERT `s 853L(2) the penalty on summary conviction` `on summary conviction` EQUALS NOTHING
-- 853L(2): conviction on indictment is not mentioned
#ASSERT `s 853L(2) the penalty on summary conviction` `on conviction on indictment` EQUALS NOTHING
-- 853L(3): a qualifying confirmation statement has been delivered: the contravention has ended
#ASSERT `s 853L(3) the contravention continues` TRUE EQUALS JUST FALSE
-- 853L(3): none delivered: it continues
#ASSERT `s 853L(3) the contravention continues` FALSE EQUALS JUST TRUE
-- 853L(5): continued contravention, no offence under (1), in default
#ASSERT `s 853L(5) the officer commits an offence in relation to the continued contravention` TRUE TRUE ((JUST TRUE)) EQUALS JUST TRUE
-- 853L(5): not in default in relation to the continued contravention
#ASSERT `s 853L(5) the officer commits an offence in relation to the continued contravention` TRUE TRUE ((JUST FALSE)) EQUALS JUST FALSE
-- 853L(5): the officer already committed an offence under (1): "did not commit"
#ASSERT `s 853L(5) the officer commits an offence in relation to the continued contravention` TRUE FALSE ((JUST TRUE)) EQUALS JUST FALSE
-- 853L(5): not a continued contravention
#ASSERT `s 853L(5) the officer commits an offence in relation to the continued contravention` FALSE TRUE ((JUST TRUE)) EQUALS JUST FALSE
-- 853L(5): s 1121 unknown
#ASSERT `s 853L(5) the officer commits an offence in relation to the continued contravention` TRUE TRUE NOTHING EQUALS NOTHING
-- 853L(6)(a): the greater of 500 pounds and one-tenth of level 4
#ASSERT `s 853L(6) the fine for each day on which the contravention continues and the person is in default does not exceed` `on summary conviction in England and Wales` EQUALS JUST (`s 853L(2)(a) the greater of an amount in pounds and a fraction of a level on the standard scale` 500 4 0.1)
-- 853L(6)(b): one-tenth of level 5
#ASSERT `s 853L(6) the fine for each day on which the contravention continues and the person is in default does not exceed` `on summary conviction in Scotland` EQUALS JUST (`s 853L(2)(b) a fraction of a level on the standard scale` 5 0.1)
-- 853L(6)(b): Northern Ireland
#ASSERT `s 853L(6) the fine for each day on which the contravention continues and the person is in default does not exceed` `on summary conviction in Northern Ireland` EQUALS JUST (`s 853L(2)(b) a fraction of a level on the standard scale` 5 0.1)
-- 853L(6): not covered without a place
#ASSERT `s 853L(6) the fine for each day on which the contravention continues and the person is in default does not exceed` `on summary conviction` EQUALS NOTHING

