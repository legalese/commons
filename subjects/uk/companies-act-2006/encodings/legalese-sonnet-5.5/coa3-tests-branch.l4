IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa3-part8-members`
IMPORT `coa3-part8-branch`

-- coa3-tests-branch.l4: tests for coa3-part8-branch.l4 (ss 129 to 135).
-- Every expected value is written by hand from the text of the section named beside it, before the code was run.

-- ---- s 129(2)(b): the table has 26 cells (13 rows of two), each a country or territory to which the Chapter applies ----
#ASSERT count `s 129(2)(b) the countries or territories listed` EQUALS 26
-- arguments: (the name) (it is a part of Her Majesty's dominions outside the United Kingdom, the Channel Islands and the Isle of Man)
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Bangladesh" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Malaysia" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Cyprus" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Malta" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Dominica" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Nigeria" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "The Gambia" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Pakistan" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Ghana" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Seychelles" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Guyana" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Sierra Leone" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "The Hong Kong Special Administrative Region of the People's Republic of China" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Singapore" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "India" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "South Africa" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Ireland" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Sri Lanka" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Kenya" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Swaziland" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Kiribati" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Trinidad and Tobago" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Lesotho" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Uganda" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Malawi" FALSE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Zimbabwe" FALSE EQUALS JUST TRUE
-- a country not in the table is not covered unless it is a dominion under (a)
#ASSERT `s 129(2) this Chapter applies to the country or territory` "France" FALSE EQUALS NOTHING
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Isle of Man" FALSE EQUALS NOTHING
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Jamaica" TRUE EQUALS JUST TRUE
#ASSERT `s 129(2) this Chapter applies to the country or territory` "Singapore" TRUE EQUALS JUST TRUE

-- ---- s 129(1): arguments (the company has a share capital) (it transacts business in the country or territory) (the answer of s 129(2)) ----
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE FALSE (JUST TRUE) EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE; the function is named for a grant or a power and the "if" gate of the text failed, so it now answers NOTHING instead of JUST FALSE (fork F19, name-test sweep of 2026-11-12; the other reading is JUST FALSE)
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` FALSE FALSE (JUST TRUE) EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` FALSE FALSE (JUST TRUE) EQUALS JUST FALSE; the function is named for a grant or a power and the "if" gate of the text failed, so it now answers NOTHING instead of JUST FALSE (fork F19, name-test sweep of 2026-11-12; the other reading is JUST FALSE)
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE; the function is named for a grant or a power and the "if" gate of the text failed, so it now answers NOTHING instead of JUST FALSE (fork F19, name-test sweep of 2026-11-12; the other reading is JUST FALSE)
#ASSERT `s 129(1) the company may cause to be kept in the country or territory a branch register of members resident there` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 129(1) the register is an overseas branch register` TRUE EQUALS JUST TRUE
#ASSERT `s 129(1) the register is an overseas branch register` FALSE EQUALS JUST FALSE
-- s 129(5): arguments (a dominion register) (a colonial register in articles) (the date the articles were registered) (the context otherwise requires)
#ASSERT `s 129(5) the reference is to be read as a reference to an overseas branch register kept under s 129` TRUE FALSE (Date 1 1 2000) FALSE EQUALS JUST TRUE
#ASSERT `s 129(5) the reference is to be read as a reference to an overseas branch register kept under s 129` FALSE TRUE (Date 31 10 1929) FALSE EQUALS JUST TRUE
#ASSERT `s 129(5) the reference is to be read as a reference to an overseas branch register kept under s 129` FALSE TRUE (Date 1 11 1929) FALSE EQUALS NOTHING
#ASSERT `s 129(5) the reference is to be read as a reference to an overseas branch register kept under s 129` FALSE FALSE (Date 1 1 1900) FALSE EQUALS NOTHING
#ASSERT `s 129(5) the reference is to be read as a reference to an overseas branch register kept under s 129` TRUE FALSE (Date 1 1 2000) TRUE EQUALS NOTHING

-- ---- s 130 ----
#ASSERT `s 130(1) the company must give notice to the registrar, stating the country or territory in which the register is kept` TRUE EQUALS JUST TRUE
#ASSERT `s 130(1) the company must give notice to the registrar, stating the country or territory in which the register is kept` FALSE EQUALS NOTHING
-- "within 14 days of doing so": a register begun on 1 January 2023, the last day is 15 January 2023
#ASSERT `s 130(1) the last day for giving notice` (Date 1 1 2023) EQUALS Date 15 1 2023
#ASSERT `s 130(1) the last day for giving notice` (Date 25 12 2023) EQUALS Date 8 1 2024
#ASSERT `s 130(1) the company gave notice within 14 days` (Date 1 1 2023) (Date 15 1 2023) EQUALS JUST TRUE
#ASSERT `s 130(1) the company gave notice within 14 days` (Date 1 1 2023) (Date 16 1 2023) EQUALS JUST FALSE
#ASSERT `s 130(1) the company gave notice within 14 days` (Date 1 1 2023) (Date 1 1 2023) EQUALS JUST TRUE
#ASSERT `s 130(1) the company gave notice within 14 days` (Date 1 1 2023) (Date 31 12 2022) EQUALS NOTHING
#TRACE `s 130(1) the company must give notice to the registrar within 14 days (duty)` AT 0 WITH
    PARTY Company DOES `s 130(1) the company gives notice to the registrar that it has begun to keep an overseas branch register` AT 14
#TRACE `s 130(1) the company must give notice to the registrar within 14 days (duty)` AT 0 WITH
    (WAITUNTIL 15)
#ASSERT `s 130(2) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 130(2) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 130(2) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 130(2) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 130(2) the person commits an offence` TRUE `Company secretary` NOTHING EQUALS NOTHING
#ASSERT `s 130(2) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING
#ASSERT `s 130(3) the penalty for an offence under s 130(2)` EQUALS (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)

-- ---- s 131 ----
#ASSERT `s 131(1) the register is regarded as part of the company's register of members` TRUE EQUALS JUST TRUE
#ASSERT `s 131(1) the register is regarded as part of the company's register of members` FALSE EQUALS NOTHING
#ASSERT `s 131(1) the register is the main register` TRUE EQUALS JUST TRUE
#ASSERT `s 131(1) the register is the main register` FALSE EQUALS JUST FALSE
#ASSERT `s 131(4) the company may by its articles make the provision as to the keeping of overseas branch registers` TRUE EQUALS JUST TRUE
#ASSERT `s 131(4) the company may by its articles make the provision as to the keeping of overseas branch registers` FALSE EQUALS NOTHING

-- ---- s 132(1): arguments (the company keeps an overseas branch register) (the register itself is kept available) (a duplicate duly entered up is kept available) (at the place where the main register is kept available) ----
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 132(1) the register or a duplicate is kept available for inspection as s 132(1) requires` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 132(2) the duplicate is treated for all purposes of this Act as part of the main register` TRUE EQUALS JUST TRUE
#ASSERT `s 132(2) the duplicate is treated for all purposes of this Act as part of the main register` FALSE EQUALS NOTHING
#ASSERT `s 132(3) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 132(3) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 132(3) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 132(3) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 132(3) the person commits an offence` TRUE Auditor (JUST TRUE) EQUALS NOTHING
#ASSERT `s 132(4) the penalty for an offence under s 132(3)` EQUALS (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)

-- ---- s 133 ----
#ASSERT `s 133(1) the shares must be distinguished from those registered in the main register` TRUE EQUALS JUST TRUE
#ASSERT `s 133(1) the shares must be distinguished from those registered in the main register` FALSE EQUALS NOTHING
#ASSERT `s 133(2) a transaction with respect to the shares may be registered in any other register` TRUE EQUALS JUST FALSE
#ASSERT `s 133(2) a transaction with respect to the shares may be registered in any other register` FALSE EQUALS NOTHING
#ASSERT `s 133(3)(a) the instrument is regarded as a transfer of property situated outside the United Kingdom` TRUE EQUALS JUST TRUE
#ASSERT `s 133(3)(a) the instrument is regarded as a transfer of property situated outside the United Kingdom` FALSE EQUALS NOTHING
-- s 133(3)(b): arguments (an instrument of transfer of a share registered in an overseas branch register) (executed in a part of the United Kingdom)
#ASSERT `s 133(3)(b) the instrument is exempt from stamp duty` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 133(3)(b) the instrument is exempt from stamp duty` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 133(3)(b) the instrument is exempt from stamp duty` FALSE FALSE EQUALS NOTHING

-- ---- s 134 ----
#ASSERT `s 134(3) this section extends to the country or territory` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 134(3) this section extends to the country or territory` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 134(3) this section extends to the country or territory` NOTHING EQUALS NOTHING
-- s 134(1): arguments (a competent court) (the answer of s 134(3)) (the matter)
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` TRUE (JUST TRUE) `s 134(1)(a) to rectify the register` EQUALS JUST TRUE
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` TRUE (JUST TRUE) `s 134(1)(b) in relation to a request for inspection or a copy of the register` EQUALS JUST TRUE
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` TRUE (JUST TRUE) `s 134(1) another matter` EQUALS NOTHING
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` FALSE (JUST TRUE) `s 134(1)(a) to rectify the register` EQUALS NOTHING
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` TRUE (JUST FALSE) `s 134(1)(a) to rectify the register` EQUALS JUST FALSE
#ASSERT `s 134(1) the court may exercise the same jurisdiction as a court in the United Kingdom` TRUE NOTHING `s 134(1)(a) to rectify the register` EQUALS NOTHING
-- s 134(2): arguments (the offence) (the tribunal has summary criminal jurisdiction there) (the answer of s 134(3))
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2)(a) refusing inspection or failing to provide a copy of the register` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2)(b) making a false, misleading or deceptive statement in a request for inspection or a copy` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2) another offence` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2)(a) refusing inspection or failing to provide a copy of the register` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2)(a) refusing inspection or failing to provide a copy of the register` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 134(2) the offence may be prosecuted summarily before the tribunal` `s 134(2)(a) refusing inspection or failing to provide a copy of the register` TRUE NOTHING EQUALS NOTHING

-- ---- s 135 ----
#ASSERT `s 135(1) the company may discontinue the overseas branch register` TRUE EQUALS JUST TRUE
#ASSERT `s 135(1) the company may discontinue the overseas branch register` FALSE EQUALS NOTHING
-- s 135(2): arguments (the company discontinues an overseas branch register) (where the entries are transferred)
#ASSERT `s 135(2) all the entries in the register must be transferred to the destination` TRUE `s 135(2)(a) to some other overseas branch register kept in the same country or territory` EQUALS JUST TRUE
#ASSERT `s 135(2) all the entries in the register must be transferred to the destination` TRUE `s 135(2)(b) to the main register` EQUALS JUST TRUE
#ASSERT `s 135(2) all the entries in the register must be transferred to the destination` TRUE `s 135(2) somewhere else` EQUALS JUST FALSE
#ASSERT `s 135(2) all the entries in the register must be transferred to the destination` FALSE `s 135(2)(a) to some other overseas branch register kept in the same country or territory` EQUALS JUST FALSE
-- "within 14 days of the discontinuance": discontinued on 15 March 2023, the last day is 29 March 2023
#ASSERT `s 135(3) the last day for giving notice of the discontinuance` (Date 15 3 2023) EQUALS Date 29 3 2023
#ASSERT `s 135(3) the company gave notice within 14 days of the discontinuance` (Date 15 3 2023) (Date 29 3 2023) EQUALS JUST TRUE
#ASSERT `s 135(3) the company gave notice within 14 days of the discontinuance` (Date 15 3 2023) (Date 30 3 2023) EQUALS JUST FALSE
#ASSERT `s 135(3) the company gave notice within 14 days of the discontinuance` (Date 15 3 2023) (Date 15 3 2023) EQUALS JUST TRUE
#ASSERT `s 135(3) the company gave notice within 14 days of the discontinuance` (Date 15 3 2023) (Date 14 3 2023) EQUALS NOTHING
#TRACE `s 135(3) the company must give notice to the registrar within 14 days of the discontinuance (duty)` AT 0 WITH
    PARTY Company DOES `s 135(3) the company gives notice to the registrar of the discontinuance` AT 14
#TRACE `s 135(3) the company must give notice to the registrar within 14 days of the discontinuance (duty)` AT 0 WITH
    (WAITUNTIL 15)
#ASSERT `s 135(4) the person commits an offence` FALSE Company (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 135(4) the person commits an offence` TRUE Company NOTHING EQUALS JUST TRUE
#ASSERT `s 135(4) the person commits an offence` TRUE Director (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 135(4) the person commits an offence` TRUE Director (JUST FALSE) EQUALS NOTHING
#ASSERT `s 135(4) the person commits an offence` TRUE `Company secretary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 135(4) the person commits an offence` TRUE Member (JUST TRUE) EQUALS NOTHING
#ASSERT `s 135(5) the penalty for an offence under s 135(4)` EQUALS (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 3 1), JUST (`a fine not exceeding a level on the standard scale` 3 0.1), FALSE)
