    THEN JUST TRUE
    ELSE JUST FALSE -- FALSE-kind (the text says no in its own words): "The notice must state the name and registered number of the company and the date of issue of the certificate" (a bare "must" not done: fork F5)

DECLARE `s 1064(3) certificate of incorporation` IS ONE OF
    `s 1064(3) the certificate issued on a company's formation`
    `s 1064(3)(a) a certificate issued under section 80 (change of name)`
    `s 1064(3)(b) a certificate issued under section 88 (Welsh companies)`
    `s 1064(3)(c) a certificate issued under any provision of Part 7 (re-registration)`
    `s 1064(3) another certificate`

-- src:14974 | (3) This section applies to a certificate of incorporation issued under—
-- src:14975 | (a) section 80 (change of name),
-- src:14976 | (b) section 88 (Welsh companies), or
