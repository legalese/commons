IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa21-ch4-directors-report`
IMPORT `coa21-part29-fraudulent-trading`

-- coa21-tests-ch4-part29.l4: tests for coa21-ch4-directors-report.l4 (s 992) and coa21-part29-fraudulent-trading.l4 (s 993).
-- Every expected value is written from the text of the section named beside it, before the run, and never copied from the code's output.

§ `Tests for Chapter 4 (s 992)`

-- s 992(6): the amendments apply to directors' reports for financial years beginning on or after 20 May 2006 (boundary).
#ASSERT `s 992(6) the amendments apply to the directors' report` (Date 20 5 2006) EQUALS JUST TRUE
#ASSERT `s 992(6) the amendments apply to the directors' report` (Date 1 1 2007) EQUALS JUST TRUE
#ASSERT `s 992(6) the amendments apply to the directors' report` (Date 19 5 2006) EQUALS NOTHING
-- Schedule 7 paragraph 13(1).
#ASSERT `s 992(2) para 13(1) this Part of Schedule 7 applies to the directors' report` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(1) this Part of Schedule 7 applies to the directors' report` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(1) this Part of Schedule 7 applies to the directors' report` NOTHING EQUALS NOTHING
-- paragraph 13(4), (3).
#ASSERT `s 992(2) para 13(4) the person has an indirect holding of securities` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(4) the person has an indirect holding of securities` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(4) the person has an indirect holding of securities` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(3) the securities are part of the company's capital for sub-paragraph (2)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(3) the securities are part of the company's capital for sub-paragraph (2)(a)` FALSE EQUALS NOTHING
-- paragraph 13(2) and (5): the matters (arguments: Part applies; matter; significant holding; special rights; employees' share scheme; control rights not directly exercisable; prejudicial; no other obligation).
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(a) the structure of the company's capital` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(b) any restrictions on the transfer of securities in the company` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(c) each person with a significant direct or indirect holding of securities in the company` TRUE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(c) each person with a significant direct or indirect holding of securities in the company` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(d) each person who holds securities carrying special rights with regard to control of the company` FALSE TRUE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(d) each person who holds securities carrying special rights with regard to control of the company` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(e) how the control rights of an employees' share scheme are exercisable` FALSE FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(e) how the control rights of an employees' share scheme are exercisable` FALSE FALSE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(e) how the control rights of an employees' share scheme are exercisable` FALSE FALSE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(f) any restrictions on voting rights` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(g) any agreements between holders of securities that may result in restrictions on the transfer of securities or on voting rights` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(h) any rules about the appointment and replacement of directors or the amendment of the articles` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(i) the powers of the company's directors` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(j) any significant agreements that take effect, alter or terminate upon a change of control following a takeover bid` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(j) any significant agreements that take effect, alter or terminate upon a change of control following a takeover bid` FALSE FALSE NOTHING FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(j) any significant agreements that take effect, alter or terminate upon a change of control following a takeover bid` FALSE FALSE NOTHING FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(j) any significant agreements that take effect, alter or terminate upon a change of control following a takeover bid` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST TRUE) `s 992(2) para 13(2)(k) any agreements providing for compensation for loss of office or employment because of a takeover bid` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` (JUST FALSE) `s 992(2) para 13(2)(a) the structure of the company's capital` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(2) the report must contain detailed information on the matter` NOTHING `s 992(2) para 13(2)(a) the structure of the company's capital` FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS NOTHING
-- paragraph 13(6): the definitions.
#ASSERT `s 992(2) para 13(6) the thing is securities` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(6) the thing is securities` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(6) the thing is securities` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(6) the offer is a takeover bid` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(6) the offer is a takeover bid` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(6) the offer is a takeover bid` NOTHING EQUALS NOTHING
#ASSERT `s 992(2) para 13(6) the instrument is the Takeovers Directive` TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(6) the instrument is the Takeovers Directive` FALSE EQUALS JUST FALSE
#ASSERT `s 992(2) para 13(6) the rights are voting rights` TRUE EQUALS JUST TRUE
#ASSERT `s 992(2) para 13(6) the rights are voting rights` FALSE EQUALS JUST FALSE
-- s 992(4): the explanatory material.
#ASSERT `s 992(4) the directors' report contains the explanatory material section 234ZZA(5) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 992(4) the directors' report contains the explanatory material section 234ZZA(5) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 992(4) the directors' report contains the explanatory material section 234ZZA(5) requires` FALSE TRUE EQUALS NOTHING
-- s 992(5): the summary financial statement.
#ASSERT `s 992(5) the company has complied with section 251(2ZB)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 992(5) the company has complied with section 251(2ZB)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 992(5) the company has complied with section 251(2ZB)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 992(5) the company has complied with section 251(2ZB)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 992(5) subsections (2A) to (2E) of section 251 apply to the material` TRUE EQUALS JUST TRUE
#ASSERT `s 992(5) subsections (2A) to (2E) of section 251 apply to the material` FALSE EQUALS NOTHING

§ `Tests for Part 29 (s 993)`

-- s 993(1): fraudulent trading: any business of a company carried on with intent to defraud creditors of the company or of another, or for any fraudulent purpose, and the person knowingly a party.
#ASSERT `s 993(1) the person commits an offence` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 993(1) the person commits an offence` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 993(1) the person commits an offence` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 993(1) the person commits an offence` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 993(1) the person commits an offence` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 993(1) the person commits an offence` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- s 993(2): whether or not the company is wound up.
#ASSERT `s 993(2) subsection (1) applies` `s 993(2) wound up` EQUALS JUST TRUE
#ASSERT `s 993(2) subsection (1) applies` `s 993(2) in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 993(2) subsection (1) applies` `s 993(2) neither wound up nor in the course of being wound up` EQUALS JUST TRUE
-- s 993(3): up to ten years or a fine (or both) on indictment; twelve months, or six months in Scotland or Northern Ireland, or a fine not exceeding the statutory maximum (or both), on summary conviction.
#ASSERT `s 993(3) the penalty` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 10, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 993(3) the penalty` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 993(3) the penalty` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 993(3) the penalty` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 993(3) the penalty` `on summary conviction` EQUALS NOTHING
