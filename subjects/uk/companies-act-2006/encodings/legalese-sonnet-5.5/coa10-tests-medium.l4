IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-medium`

-- coa10-tests-medium.l4: tests for coa10-medium.l4 (ss 465 to 467). Every expected value was written down from the text of
-- the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 465(4): the maximum turnover for a period that is not a year (line 6359) ----
#ASSERT `s 465(4) the maximum figure for turnover for the financial year` 12 EQUALS 54000000
#ASSERT `s 465(4) the maximum figure for turnover for the financial year` 6 EQUALS 27000000
#ASSERT `s 465(4) the maximum figure for turnover for the financial year` 18 EQUALS 81000000

-- ---- s 465(3): the three requirements (lines 6355-6358): "Not more than" is at most ----
#ASSERT `s 465(3) the requirement for turnover is satisfied` 54000000 12
#ASSERT NOT `s 465(3) the requirement for turnover is satisfied` 54000001 12
#ASSERT `s 465(3) the requirement for turnover is satisfied` 27000000 6
#ASSERT NOT `s 465(3) the requirement for turnover is satisfied` 27000001 6
#ASSERT `s 465(3) the requirement for the balance sheet total is satisfied` 27000000
#ASSERT NOT `s 465(3) the requirement for the balance sheet total is satisfied` 27000001
#ASSERT `s 465(3) the requirement for the number of employees is satisfied` 250
#ASSERT NOT `s 465(3) the requirement for the number of employees is satisfied` 251
-- two or more of the three
#ASSERT `s 465(3) the qualifying conditions are met` 54000000 12 27000000 250 EQUALS JUST TRUE
#ASSERT `s 465(3) the qualifying conditions are met` 60000000 12 20000000 200 EQUALS JUST TRUE
#ASSERT `s 465(3) the qualifying conditions are met` 50000000 12 20000000 300 EQUALS JUST TRUE
#ASSERT `s 465(3) the qualifying conditions are met` 50000000 12 30000000 200 EQUALS JUST TRUE
#ASSERT `s 465(3) the qualifying conditions are met` 60000000 12 30000000 200 EQUALS JUST FALSE
#ASSERT `s 465(3) the qualifying conditions are met` 50000000 12 30000000 300 EQUALS JUST FALSE
#ASSERT `s 465(3) the qualifying conditions are met` 60000000 12 30000000 300 EQUALS JUST FALSE
-- a six-month year: the turnover limit halves (27m), the other limits do not
#ASSERT `s 465(3) the qualifying conditions are met` 28000000 6 20000000 200 EQUALS JUST TRUE
#ASSERT `s 465(3) the qualifying conditions are met` 28000000 6 30000000 200 EQUALS JUST FALSE

-- ---- s 465(5), (6): the balance sheet total and the number of employees (lines 6360-6364) ----
#ASSERT `s 465(5) the balance sheet total` (LIST 10000000, 12000000, 5000000) EQUALS 27000000
#ASSERT `s 465(5) the balance sheet total` EMPTY EQUALS 0
#ASSERT `s 465(6) the number of employees` (LIST 100, 100, 100, 100, 100, 100, 200, 200, 200, 200, 200, 200) EQUALS JUST 150
#ASSERT `s 465(6) the number of employees` (LIST 250, 251) EQUALS JUST 250.5
#ASSERT `s 465(6) the number of employees` EMPTY EQUALS NOTHING

-- ---- s 465(1), (2): first and subsequent years (lines 6350-6354) ----
#ASSERT `s 465(1) the company qualifies as medium-sized in relation to its first financial year` TRUE EQUALS JUST TRUE
#ASSERT `s 465(1) the company qualifies as medium-sized in relation to its first financial year` FALSE EQUALS JUST FALSE
-- (a) met this year and the last; (b) met this year and qualified last year; (c) met last year and qualified last year
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 465(2) the company qualifies as medium-sized in relation to a subsequent financial year` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- s 466: parent companies (lines 6366-6387) ----
#ASSERT `s 466(5) the aggregate figure` (LIST 20000000, 15000000, 10000000) EQUALS 45000000
#ASSERT `s 466(6) the figure is a net figure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 466(6) the figure is a net figure` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 466(6) the figure is a net figure` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 466(6) the figure is a gross figure` TRUE EQUALS JUST TRUE
#ASSERT `s 466(6) the figure is a gross figure` FALSE EQUALS JUST FALSE
-- (4): each requirement on the net or the gross figure
#ASSERT `s 466(4) the requirement for aggregate turnover is satisfied` 54000000 99000000
#ASSERT `s 466(4) the requirement for aggregate turnover is satisfied` 54000001 64000000
#ASSERT NOT `s 466(4) the requirement for aggregate turnover is satisfied` 54000001 64000001
#ASSERT `s 466(4) the requirement for the aggregate balance sheet total is satisfied` 27000000 99000000
#ASSERT `s 466(4) the requirement for the aggregate balance sheet total is satisfied` 27000001 32000000
#ASSERT NOT `s 466(4) the requirement for the aggregate balance sheet total is satisfied` 27000001 32000001
#ASSERT `s 466(4) the requirement for the aggregate number of employees is satisfied` 250
#ASSERT NOT `s 466(4) the requirement for the aggregate number of employees is satisfied` 251
-- net turnover too high but gross within £64m; balance sheet total within on the gross figure; employees too many: two requirements
#ASSERT `s 466(4) the qualifying conditions are met by the group` 60000000 64000000 30000000 32000000 300 EQUALS JUST TRUE
-- only the employees requirement
#ASSERT `s 466(4) the qualifying conditions are met by the group` 60000000 70000000 30000000 40000000 250 EQUALS JUST FALSE
#ASSERT `s 466(4) the qualifying conditions are met by the group` 60000000 70000000 30000000 40000000 300 EQUALS JUST FALSE
-- turnover and employees
#ASSERT `s 466(4) the qualifying conditions are met by the group` 54000000 99000000 30000000 40000000 250 EQUALS JUST TRUE
-- (7): the subsidiary undertaking's financial year whose figures are used
#ASSERT `s 466(7) the end of the subsidiary undertaking's financial year whose figures are used` (Date 31 12 2025) (LIST Date 31 12 2025, Date 30 6 2025, Date 31 12 2024) EQUALS JUST (Date 31 12 2025)
#ASSERT `s 466(7) the end of the subsidiary undertaking's financial year whose figures are used` (Date 31 12 2025) (LIST Date 30 6 2025, Date 31 3 2025) EQUALS JUST (Date 30 6 2025)
#ASSERT `s 466(7) the end of the subsidiary undertaking's financial year whose figures are used` (Date 31 12 2025) (LIST Date 31 12 2025, Date 30 6 2026) EQUALS JUST (Date 31 12 2025)
#ASSERT `s 466(7) the end of the subsidiary undertaking's financial year whose figures are used` (Date 31 12 2025) (LIST Date 30 6 2026) EQUALS NOTHING
#ASSERT `s 466(7) the end of the subsidiary undertaking's financial year whose figures are used` (Date 31 12 2025) EMPTY EQUALS NOTHING
#ASSERT `s 466(7) the figures to take for the subsidiary undertaking` TRUE EQUALS `s 466 the latest available figures`
#ASSERT `s 466(7) the figures to take for the subsidiary undertaking` FALSE EQUALS `s 466 the figures included in the subsidiary undertaking's individual accounts for the relevant financial year`
-- (1): "only if"
#ASSERT `s 466(1) the parent company qualifies as a medium-sized company` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 466(1) the parent company qualifies as a medium-sized company` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 466(1) the parent company qualifies as a medium-sized company` NOTHING EQUALS NOTHING
-- (2), (3)
#ASSERT `s 466(2) the group qualifies as medium-sized in relation to the parent company's first financial year` TRUE EQUALS JUST TRUE
#ASSERT `s 466(2) the group qualifies as medium-sized in relation to the parent company's first financial year` FALSE EQUALS JUST FALSE
#ASSERT `s 466(3) the group qualifies as medium-sized in relation to a subsequent financial year` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 466(3) the group qualifies as medium-sized in relation to a subsequent financial year` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 466(3) the group qualifies as medium-sized in relation to a subsequent financial year` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 466(3) the group qualifies as medium-sized in relation to a subsequent financial year` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 466(3) the group qualifies as medium-sized in relation to a subsequent financial year` FALSE FALSE FALSE EQUALS JUST FALSE
-- s 465(7): subject to s 466
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 465(7) the company qualifies as medium-sized, subject to section 466` NOTHING (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- ---- s 467 (lines 6389-6406) ----
#ASSERT `s 467(3) the company is a small company for the purposes of subsection (2)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 467(3) the company is a small company for the purposes of subsection (2)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 467(3) the company is a small company for the purposes of subsection (2)` NOTHING EQUALS NOTHING
-- The fields of `s 467 member of a group`, in order: traded company; body corporate with shares on a UK regulated market; FSMA permission; small company (MAYBE); e-money issuer; authorised insurance/banking/MiFID/UCITS; insurance market activity; Master Trust scheme funder.
`s 467 fixture a traded company` MEANS `s 467 member of a group` OF TRUE, FALSE, FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE
`s 467 fixture a large firm with permission` MEANS `s 467 member of a group` OF FALSE, FALSE, TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE
`s 467 fixture a small firm with permission only` MEANS `s 467 member of a group` OF FALSE, FALSE, TRUE, JUST TRUE, FALSE, FALSE, FALSE, FALSE
`s 467 fixture a small bank` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST TRUE, FALSE, TRUE, FALSE, FALSE
`s 467 fixture a large bank with no permission recorded` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST FALSE, FALSE, TRUE, FALSE, FALSE
`s 467 fixture an ordinary company` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, FALSE, FALSE
`s 467 fixture a permitted firm whose size is not known` MEANS `s 467 member of a group` OF FALSE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE
`s 467 fixture an e-money issuer` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST TRUE, TRUE, FALSE, FALSE, FALSE
`s 467 fixture an insurance market participant` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, FALSE
`s 467 fixture a Master Trust scheme funder` MEANS `s 467 member of a group` OF FALSE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, FALSE, TRUE
`s 467 fixture a body corporate on a UK regulated market` MEANS `s 467 member of a group` OF FALSE, TRUE, FALSE, JUST TRUE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a traded company` EQUALS JUST TRUE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a large firm with permission` EQUALS JUST TRUE
-- (c) says "other than a small company": a small firm with permission only is outside (c) and outside (d)
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a small firm with permission only` EQUALS JUST FALSE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a small bank` EQUALS JUST TRUE
-- (d) is for a small company only
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a large bank with no permission recorded` EQUALS JUST FALSE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture an ordinary company` EQUALS JUST FALSE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a permitted firm whose size is not known` EQUALS NOTHING
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture an e-money issuer` EQUALS JUST TRUE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture an insurance market participant` EQUALS JUST TRUE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a Master Trust scheme funder` EQUALS JUST TRUE
#ASSERT `s 467(2) the member is within one of the paragraphs` `s 467 fixture a body corporate on a UK regulated market` EQUALS JUST TRUE
#ASSERT `s 467(2) the group is ineligible` (LIST `s 467 fixture an ordinary company`, `s 467 fixture a traded company`) EQUALS JUST TRUE
#ASSERT `s 467(2) the group is ineligible` (LIST `s 467 fixture an ordinary company`, `s 467 fixture a small firm with permission only`) EQUALS JUST FALSE
#ASSERT `s 467(2) the group is ineligible` (LIST `s 467 fixture an ordinary company`, `s 467 fixture a permitted firm whose size is not known`) EQUALS NOTHING
#ASSERT `s 467(2) the group is ineligible` (LIST `s 467 fixture a permitted firm whose size is not known`, `s 467 fixture a traded company`) EQUALS JUST TRUE
-- (1): the bar. The arguments: a public company; FSMA permission; insurance market activity; Master Trust scheme funder; e-money issuer; group ineligible.
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` TRUE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` FALSE FALSE FALSE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 467(1) the section bars the company from taking advantage of the medium-sized provisions` TRUE FALSE FALSE FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 467(4) the section prevents the company from taking advantage of section 417(7)` TRUE EQUALS JUST FALSE
#ASSERT `s 467(4) the section prevents the company from taking advantage of section 417(7)` FALSE EQUALS NOTHING
