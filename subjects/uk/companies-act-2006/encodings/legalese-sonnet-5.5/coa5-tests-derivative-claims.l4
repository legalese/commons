IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-derivative-claims`

-- coa5-tests-derivative-claims.l4: tests for ss 260 to 269 (coa5-derivative-claims.l4). Expected values read from the text, not from the code.
-- The three rules that repeat (the prima facie dismissal, the directions, the hearing) are tested section by section with the same expectations, because the text repeats the same words.

§ `Tests: s 260`

#ASSERT `s 260(5)(c) the person is a member for this Chapter` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 260(5)(c) the person is a member for this Chapter` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 260(5)(c) the person is a member for this Chapter` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 260(5)(c) the person is a member for this Chapter` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 260(5)(a) the person is a director for this Chapter` TRUE EQUALS JUST TRUE
#ASSERT `s 260(5)(a) the person is a director for this Chapter` FALSE EQUALS NOTHING
#ASSERT `s 260(5)(b) the shadow director is treated as a director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 260(5)(b) the shadow director is treated as a director` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 260(5)(b) the shadow director is treated as a director` NOTHING EQUALS NOTHING
-- s 260(1): proceedings in England and Wales or Northern Ireland, by a member, on a cause of action vested in the company, seeking relief on its behalf
#ASSERT `s 260(1) the proceedings are a derivative claim` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 260(1) the proceedings are a derivative claim` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 260(1) the proceedings are a derivative claim` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 260(1) the proceedings are a derivative claim` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 260(1) the proceedings are a derivative claim` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 260(1) the proceedings are a derivative claim` TRUE NOTHING TRUE TRUE EQUALS NOTHING
-- s 260(2): only under this Chapter, or under an order in s 994 proceedings
#ASSERT `s 260(2) the derivative claim may be brought` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 260(2) the derivative claim may be brought` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 260(2) the derivative claim may be brought` FALSE FALSE EQUALS JUST FALSE
-- s 260(3): only for a cause of action arising from an actual or proposed act or omission involving negligence, default, breach of duty or breach of trust by a director
#ASSERT `s 260(3) a derivative claim under this Chapter may be brought in respect of the cause of action` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 260(3) a derivative claim under this Chapter may be brought in respect of the cause of action` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 260(3) a derivative claim under this Chapter may be brought in respect of the cause of action` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 260(3) a derivative claim under this Chapter may be brought in respect of the cause of action` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 260(3) the cause of action may be against the defendant` `s 260(3) the director` EQUALS JUST TRUE
#ASSERT `s 260(3) the cause of action may be against the defendant` `s 260(3) another person` EQUALS JUST TRUE
#ASSERT `s 260(3) the cause of action may be against the defendant` `s 260(3) both the director and another person` EQUALS JUST TRUE
#ASSERT `s 260(4) it matters whether the cause of action arose before or after the person became a member of the company` EQUALS JUST FALSE

§ `Tests: ss 261, 262 and 264`

-- s 261(1): a member who brings a derivative claim must apply for permission (leave in Northern Ireland) to continue it
#ASSERT `s 261(1) the member must apply to the court for permission to continue the claim` TRUE EQUALS JUST TRUE
#ASSERT `s 261(1) the member must apply to the court for permission to continue the claim` FALSE EQUALS NOTHING
-- TRACE EXPECT: FULFILLED
#TRACE `s 261(1) the member's duty to apply for permission to continue the claim` AT 0 WITH
    PARTY Member DOES `s 261(1) apply to the court for permission (in Northern Ireland, leave) to continue the derivative claim` AT 9

-- TRACE EXPECT: STANDING
#TRACE `s 261(1) the member's duty to apply for permission to continue the claim` AT 0 WITH
    (WAITUNTIL 90)

-- s 262(1): applies where a company has brought a claim and the cause of action could be pursued as a derivative claim
#ASSERT `s 262(1) this section applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 262(1) this section applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 262(1) this section applies` TRUE FALSE EQUALS JUST FALSE
-- s 262(2): a member may apply on the ground that (a) abuse of process in the manner the company commenced or continued the claim, (b) the company failed to prosecute diligently, and (c) appropriate for the member to continue
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 262(2) the member may apply to the court for permission to continue the claim as a derivative claim` NOTHING TRUE TRUE TRUE EQUALS NOTHING
-- s 264(1): applies where a member (the claimant) has brought, or continued, a derivative claim
#ASSERT `s 264(1) this section applies` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 264(1) this section applies` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 264(1) this section applies` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 264(1) this section applies` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 264(2) another member may apply to the court for permission to continue the claim` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 264(2) another member may apply to the court for permission to continue the claim` (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 264(2) another member may apply to the court for permission to continue the claim` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 264(2) another member may apply to the court for permission to continue the claim` NOTHING TRUE TRUE TRUE EQUALS NOTHING

-- s 261(2): if it appears to the court that the application and the evidence do not disclose a prima facie case, the court must dismiss the application and may make a consequential order
