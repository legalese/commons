IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa12-logic`
IMPORT `coa12-ch3b-rights`

-- coa12-tests-ch3b.l4: tests for coa12-ch3b-rights.l4 (ss 499-509). Expected values are decided from the text and written
-- here by hand before the run (the file is made by a script whose only job is to keep the argument lists aligned; the
-- expected value of every line is typed in the script). Argument order is the GIVEN order of each function.

-- s 499(1)(a): an auditor, the company's books
#ASSERT `s 499(1)(a) the auditor has a right of access at all times to the item` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 499(1)(a) the auditor has a right of access at all times to the item` TRUE FALSE EQUALS NOTHING
#ASSERT `s 499(1)(a) the auditor has a right of access at all times to the item` FALSE TRUE EQUALS NOTHING
