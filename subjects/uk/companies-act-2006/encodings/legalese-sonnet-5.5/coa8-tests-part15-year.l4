IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part15-year`

-- Tests of ss 390 to 392 (financial year, accounting reference periods, alteration of the accounting reference date).
-- Every expected value was written from the text before the run. The date on which Article 5 of the Companies (Northern Ireland)
-- Order 1990 came into operation is an input the sources do not give; the tests use 15 November 1990 as a stand-in input, not as a claim.

-- s 391(1): the accounting reference date in a calendar year
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 a fixed day and month` 31 3) 2026 EQUALS Date 31 3 2026
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 a fixed day and month` 30 6) 2025 EQUALS Date 30 6 2025
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 the last day of a month` 2) 2024 EQUALS Date 29 2 2024
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 the last day of a month` 2) 2023 EQUALS Date 28 2 2023
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 the last day of a month` 4) 2026 EQUALS Date 30 4 2026
#ASSERT `s 391(1) the accounting reference date in the calendar year` (`s 391 the last day of a month` 12) 2026 EQUALS Date 31 12 2026

-- s 391(2): Great Britain, incorporated before 1 April 1996: the notice, or failing it 31 March (before 1 April 1990) or the last day of the anniversary month
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 15 5 1989) (JUST (`s 391 a fixed day and month` 30 9)) EQUALS JUST (`s 391 a fixed day and month` 30 9)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 15 5 1989) NOTHING EQUALS JUST (`s 391 a fixed day and month` 31 3)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 31 3 1990) NOTHING EQUALS JUST (`s 391 a fixed day and month` 31 3)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 1 4 1990) NOTHING EQUALS JUST (`s 391 the last day of a month` 4)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `Scotland` (Date 15 5 1991) NOTHING EQUALS JUST (`s 391 the last day of a month` 5)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 31 3 1996) NOTHING EQUALS JUST (`s 391 the last day of a month` 3)
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `England and Wales` (Date 1 4 1996) NOTHING EQUALS NOTHING
#ASSERT `s 391(2) the accounting reference date of a company incorporated in Great Britain before 1st April 1996` `Northern Ireland` (Date 15 5 1989) NOTHING EQUALS NOTHING

-- s 391(3): Northern Ireland, incorporated before 22 August 1997
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 1 11 1990) NOTHING (Date 15 11 1990) EQUALS JUST (`s 391 a fixed day and month` 31 3)
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 15 11 1990) NOTHING (Date 15 11 1990) EQUALS NOTHING
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 16 11 1990) NOTHING (Date 15 11 1990) EQUALS JUST (`s 391 the last day of a month` 11)
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 1 11 1990) (JUST (`s 391 a fixed day and month` 30 9)) (Date 15 11 1990) EQUALS JUST (`s 391 a fixed day and month` 30 9)
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 21 8 1997) NOTHING (Date 15 11 1990) EQUALS JUST (`s 391 the last day of a month` 8)
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `Northern Ireland` (Date 22 8 1997) NOTHING (Date 15 11 1990) EQUALS NOTHING
#ASSERT `s 391(3) the accounting reference date of a company incorporated in Northern Ireland before 22nd August 1997` `England and Wales` (Date 1 11 1990) NOTHING (Date 15 11 1990) EQUALS NOTHING

-- s 391(4): later companies: the last day of the month of the anniversary of incorporation
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `England and Wales` (Date 1 4 1996) FALSE EQUALS JUST (`s 391 the last day of a month` 4)
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `England and Wales` (Date 31 3 1996) FALSE EQUALS NOTHING
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `Northern Ireland` (Date 22 8 1997) FALSE EQUALS JUST (`s 391 the last day of a month` 8)
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `Northern Ireland` (Date 21 8 1997) FALSE EQUALS NOTHING
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `Scotland` (Date 3 3 2020) TRUE EQUALS JUST (`s 391 the last day of a month` 3)
#ASSERT `s 391(4) the accounting reference date of a company incorporated on or after the dates in subsection (4)` `Northern Ireland` (Date 3 3 1990) TRUE EQUALS JUST (`s 391 the last day of a month` 3)

-- s 391(5): the first period is more than six months and not more than 18 months, and ends with the accounting reference date
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 15 3 2026) (`s 391 the last day of a month` 3) EQUALS Date 31 3 2027
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 15 3 2026) (`s 391 a fixed day and month` 31 12) EQUALS Date 31 12 2026
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 15 3 2026) (`s 391 a fixed day and month` 15 9) EQUALS Date 15 9 2026
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 15 3 2026) (`s 391 a fixed day and month` 14 9) EQUALS Date 14 9 2027
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 15 3 2026) (`s 391 a fixed day and month` 16 9) EQUALS Date 16 9 2026
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 1 9 2025) (`s 391 the last day of a month` 2) EQUALS Date 28 2 2027
#ASSERT `s 391(5) the last day of the first accounting reference period` (Date 1 8 2025) (`s 391 the last day of a month` 2) EQUALS Date 28 2 2026

-- s 391(6): subsequent periods are successive periods of twelve months
#ASSERT `s 391(6) the first day of the next accounting reference period` (Date 31 3 2026) EQUALS Date 1 4 2026
#ASSERT `s 391(6) the first day of the next accounting reference period` (Date 28 2 2023) EQUALS Date 1 3 2023
#ASSERT `s 391(6) the first day of the next accounting reference period` (Date 29 2 2024) EQUALS Date 1 3 2024
#ASSERT `s 391(6) the last day of the next accounting reference period` (Date 31 3 2026) (`s 391 a fixed day and month` 31 3) EQUALS Date 31 3 2027
#ASSERT `s 391(6) the last day of the next accounting reference period` (Date 29 2 2024) (`s 391 the last day of a month` 2) EQUALS Date 28 2 2025
#ASSERT `s 391(6) the last day of the next accounting reference period` (Date 28 2 2023) (`s 391 the last day of a month` 2) EQUALS Date 29 2 2024

-- s 392(1): a new date may have effect from the current or the previous period
#ASSERT `s 392(1) the company may by notice to the registrar specify a new accounting reference date having effect from` `s 392(1)(a) the current accounting reference period and subsequent periods` EQUALS JUST TRUE
#ASSERT `s 392(1) the company may by notice to the registrar specify a new accounting reference date having effect from` `s 392(1)(b) the previous accounting reference period and subsequent periods` EQUALS JUST TRUE
#ASSERT `s 392(1) the company may by notice to the registrar specify a new accounting reference date having effect from` `s 392(1) some other period` EQUALS NOTHING
#ASSERT `s 392(1) the period is the company's previous accounting reference period` TRUE EQUALS JUST TRUE
#ASSERT `s 392(1) the period is the company's previous accounting reference period` FALSE EQUALS JUST FALSE

-- s 392(2): shortened: the first occasion the new date falls after the beginning of the period; extended: the second
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 4 2026) (`s 391 a fixed day and month` 30 6) `s 392(2)(a) the period is to be shortened` EQUALS Date 30 6 2026
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 4 2026) (`s 391 a fixed day and month` 30 6) `s 392(2)(b) the period is to be extended` EQUALS Date 30 6 2027
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 7 2026) (`s 391 a fixed day and month` 30 6) `s 392(2)(a) the period is to be shortened` EQUALS Date 30 6 2027
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 7 2026) (`s 391 a fixed day and month` 30 6) `s 392(2)(b) the period is to be extended` EQUALS Date 30 6 2028
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 30 6 2026) (`s 391 a fixed day and month` 30 6) `s 392(2)(a) the period is to be shortened` EQUALS Date 30 6 2027
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 1 2024) (`s 391 the last day of a month` 2) `s 392(2)(a) the period is to be shortened` EQUALS Date 29 2 2024
#ASSERT `s 392(2) the last day of the shortened or extended period` (Date 1 1 2024) (`s 391 the last day of a month` 2) `s 392(2)(b) the period is to be extended` EQUALS Date 28 2 2025

-- s 392(3): the five-year bar. Columns: extends, date given, end of an earlier extended period, sub/parent of another UK undertaking, coincides, in administration, Secretary of State directs
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 30 3 2030) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2030) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` FALSE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) NOTHING (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2030) (JUST (Date 31 3 2025)) NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) (JUST FALSE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(3) the notice is ineffective because it is given less than five years after an earlier extension` TRUE (Date 31 3 2028) (JUST (Date 31 3 2025)) NOTHING TRUE FALSE TRUE EQUALS JUST FALSE
-- s 392(4)
#ASSERT `s 392(4) a notice may be given in respect of the previous accounting reference period` TRUE EQUALS JUST FALSE
#ASSERT `s 392(4) a notice may be given in respect of the previous accounting reference period` FALSE EQUALS NOTHING
-- s 392(5): 18 months from 1 January 2025 ends on 30 June 2026
#ASSERT `s 392(5) the notice is ineffective because the period as extended would exceed 18 months` (Date 1 1 2025) (Date 30 6 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 392(5) the notice is ineffective because the period as extended would exceed 18 months` (Date 1 1 2025) (Date 1 7 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 392(5) the notice is ineffective because the period as extended would exceed 18 months` (Date 1 1 2025) (Date 31 12 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 392(5) the notice is ineffective because the period as extended would exceed 18 months` (Date 1 1 2025) (Date 31 12 2026) TRUE EQUALS JUST FALSE
-- s 392(6)
#ASSERT `s 392(6) the undertaking is a UK undertaking` TRUE EQUALS JUST TRUE
#ASSERT `s 392(6) the undertaking is a UK undertaking` FALSE EQUALS JUST FALSE

-- s 390(2)(a), (2)(b), (3)(a), (3)(b), (4), (5)
#ASSERT `s 390(2)(a) the first day of the first financial year` (Date 1 4 2026) EQUALS Date 1 4 2026
#ASSERT `s 390(2)(b) the last day of the first financial year` (Date 31 3 2027) NOTHING EQUALS JUST (Date 31 3 2027)
#ASSERT `s 390(2)(b) the last day of the first financial year` (Date 31 3 2027) (JUST (Date 24 3 2027)) EQUALS JUST (Date 24 3 2027)
#ASSERT `s 390(2)(b) the last day of the first financial year` (Date 31 3 2027) (JUST (Date 23 3 2027)) EQUALS NOTHING
#ASSERT `s 390(2)(b) the last day of the first financial year` (Date 31 3 2027) (JUST (Date 7 4 2027)) EQUALS JUST (Date 7 4 2027)
#ASSERT `s 390(2)(b) the last day of the first financial year` (Date 31 3 2027) (JUST (Date 8 4 2027)) EQUALS NOTHING
#ASSERT `s 390(3)(a) the first day of a subsequent financial year` (Date 31 3 2027) EQUALS Date 1 4 2027
#ASSERT `s 390(3)(a) the first day of a subsequent financial year` (Date 28 2 2023) EQUALS Date 1 3 2023
#ASSERT `s 390(3)(b) the last day of a subsequent financial year` (Date 31 3 2028) NOTHING EQUALS JUST (Date 31 3 2028)
#ASSERT `s 390(3)(b) the last day of a subsequent financial year` (Date 31 3 2028) (JUST (Date 7 4 2028)) EQUALS JUST (Date 7 4 2028)
#ASSERT `s 390(3)(b) the last day of a subsequent financial year` (Date 31 3 2028) (JUST (Date 8 4 2028)) EQUALS NOTHING
#ASSERT `s 390(4) the period is the financial year of the undertaking that is not a company` TRUE EQUALS JUST TRUE
#ASSERT `s 390(4) the period is the financial year of the undertaking that is not a company` FALSE EQUALS JUST FALSE
#ASSERT `s 390(5) the directors are required to secure that the financial year of each subsidiary undertaking coincides with the company's own` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 390(5) the directors are required to secure that the financial year of each subsidiary undertaking coincides with the company's own` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 390(5) the directors are required to secure that the financial year of each subsidiary undertaking coincides with the company's own` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 390(5) the directors are required to secure that the financial year of each subsidiary undertaking coincides with the company's own` NOTHING FALSE EQUALS NOTHING
