IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa25-notices-courts`

-- coa25-tests-notices-courts.l4: tests for coa25-notices-courts.l4 (ss 1154 to 1157).
-- Every expected value was decided by reading the section and written down before the run.

-- ---- s 1154(1): the three appointments the subsection lists, the two Northern Ireland ones it does not, and another
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 a judicial factor appointed in relation to a company (in Scotland)` EQUALS JUST TRUE
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 an interim manager appointed in relation to a company under s 76 of the Charities Act 2011` EQUALS JUST TRUE
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 a manager appointed in relation to a company under s 47 of the Companies (Audit, Investigations and Community Enterprise) Act 2004` EQUALS JUST TRUE
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 an interim manager appointed in relation to a company under s 33 of the Charities Act (Northern Ireland) 2008` EQUALS NOTHING
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 a receiver or manager appointed in relation to a company under s 33 of the Charities Act (Northern Ireland) 2008` EQUALS NOTHING
#ASSERT `s 1154(1) notice of the appointment must be given to the registrar` `s 1154 another appointment in relation to a company` EQUALS NOTHING

-- ---- s 1154(2): who gives the notice
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 a judicial factor appointed in relation to a company (in Scotland)` EQUALS JUST `s 1154 the judicial factor`
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 an interim manager appointed in relation to a company under s 76 of the Charities Act 2011` EQUALS JUST `s 1154 the Charity Commission`
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 an interim manager appointed in relation to a company under s 33 of the Charities Act (Northern Ireland) 2008` EQUALS JUST `s 1154 the Charity Commission`
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 a receiver or manager appointed in relation to a company under s 33 of the Charities Act (Northern Ireland) 2008` EQUALS JUST `s 1154 the Charity Commission for Northern Ireland`
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 a manager appointed in relation to a company under s 47 of the Companies (Audit, Investigations and Community Enterprise) Act 2004` EQUALS JUST `s 1154 the Regulator of Community Interest Companies`
#ASSERT `s 1154(2) the person who must give the notice` `s 1154 another appointment in relation to a company` EQUALS NOTHING

-- ---- s 1154(3) and (4)
#ASSERT `s 1154(3) the notice meets the requirement as to the address for service` TRUE EQUALS JUST TRUE
#ASSERT `s 1154(3) the notice meets the requirement as to the address for service` FALSE EQUALS JUST FALSE
#ASSERT `s 1154(3) the person may give the registrar notice of a change in the address for service` TRUE EQUALS JUST TRUE
#ASSERT `s 1154(3) the person may give the registrar notice of a change in the address for service` FALSE EQUALS NOTHING
#ASSERT `s 1154(4) notice of the termination of the appointment must be given to the registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 1154(4) notice of the termination of the appointment must be given to the registrar` FALSE EQUALS JUST FALSE -- no notice of the appointment was given under this section

-- ---- s 1155(1): appointed 1 June 2026, so the 14 days after the appointment end on 15 June 2026
-- (arguments: the date of the appointment; the date notice was given; the date the question is asked)
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 1 6 2026) (JUST (Date 15 6 2026)) (Date 20 6 2026) EQUALS JUST FALSE -- notice on the 14th day after
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 1 6 2026) (JUST (Date 16 6 2026)) (Date 20 6 2026) EQUALS JUST TRUE -- notice on the 15th day after
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 1 6 2026) (JUST (Date 2 6 2026)) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 1 6 2026) NOTHING (Date 15 6 2026) EQUALS NOTHING -- no notice yet, and the 14 days have not run out
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 1 6 2026) NOTHING (Date 16 6 2026) EQUALS JUST TRUE -- no notice, and the 14 days are over
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 20 12 2026) (JUST (Date 3 1 2027)) (Date 4 1 2027) EQUALS JUST FALSE -- the period crosses a year end: 20 December plus 14 is 3 January
#ASSERT `s 1155(1) the judicial factor commits an offence` (Date 20 12 2026) (JUST (Date 4 1 2027)) (Date 4 1 2027) EQUALS JUST TRUE

-- ---- s 1155(2): level 5 and one-tenth of level 5, written out by hand from the text
`s 1155 test penalty level 5 with a tenth` MEANS
    Penalty WITH `how convicted` IS `on summary conviction`
                 `imprisonment not exceeding` IS NOTHING
                 `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1)
                 `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1)
                 `imprisonment and fine together` IS FALSE
#ASSERT `s 1155(2) the penalty for an offence under s 1155` (JUST TRUE) EQUALS JUST `s 1155 test penalty level 5 with a tenth`
#ASSERT `s 1155(2) the penalty for an offence under s 1155` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1155(2) the penalty for an offence under s 1155` NOTHING EQUALS NOTHING

-- ---- s 1156(1)
#ASSERT `s 1156(1) the courts that are "the court" in the part of the United Kingdom` `England and Wales` EQUALS LIST `s 1156 the High Court in England and Wales`, `s 1156 the county court`
#ASSERT `s 1156(1) the courts that are "the court" in the part of the United Kingdom` Scotland EQUALS LIST `s 1156 the Court of Session`, `s 1156 the sheriff court`
#ASSERT `s 1156(1) the courts that are "the court" in the part of the United Kingdom` `Northern Ireland` EQUALS LIST `s 1156 the High Court in Northern Ireland`
-- (arguments: the place; the tribunal; it is otherwise provided)
#ASSERT `s 1156(1) the tribunal is the court` `England and Wales` `s 1156 the county court` FALSE EQUALS JUST TRUE
#ASSERT `s 1156(1) the tribunal is the court` `England and Wales` `s 1156 the High Court in England and Wales` FALSE EQUALS JUST TRUE
#ASSERT `s 1156(1) the tribunal is the court` `England and Wales` `s 1156 the sheriff court` FALSE EQUALS JUST FALSE -- a Scottish court is not "the court" for England and Wales
#ASSERT `s 1156(1) the tribunal is the court` Scotland `s 1156 the sheriff court` FALSE EQUALS JUST TRUE
#ASSERT `s 1156(1) the tribunal is the court` Scotland `s 1156 the Court of Session` FALSE EQUALS JUST TRUE
#ASSERT `s 1156(1) the tribunal is the court` Scotland `s 1156 the county court` FALSE EQUALS JUST FALSE
#ASSERT `s 1156(1) the tribunal is the court` `Northern Ireland` `s 1156 the High Court in Northern Ireland` FALSE EQUALS JUST TRUE
#ASSERT `s 1156(1) the tribunal is the court` `Northern Ireland` `s 1156 the county court` FALSE EQUALS JUST FALSE
#ASSERT `s 1156(1) the tribunal is the court` `Northern Ireland` `s 1156 the Court of Session` FALSE EQUALS JUST FALSE
#ASSERT `s 1156(1) the tribunal is the court` `England and Wales` `s 1156 the county court` TRUE EQUALS NOTHING -- "Except as otherwise provided"
#ASSERT `s 1156(2) the jurisdiction conferred on the court yields to the allocation of jurisdiction` TRUE EQUALS JUST TRUE
#ASSERT `s 1156(2) the jurisdiction conferred on the court yields to the allocation of jurisdiction` FALSE EQUALS NOTHING

-- ---- s 1157(1) (arguments: the defendant; the proceedings are of the kind; liable or may be; honestly and reasonably; ought fairly to be excused)
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 a person employed by a company as auditor (whether or not an officer of the company)` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (b): whether or not an officer
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 another person` TRUE TRUE TRUE TRUE EQUALS NOTHING -- not an officer or an auditor
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` FALSE TRUE TRUE TRUE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not proceedings of that kind; the text gives the court a power "if" its conditions appear, and a grant of power whose "if" gate is unmet answers NOTHING, not "may not" (fork F19)
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE FALSE TRUE TRUE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- it does not appear that he is or may be liable; the text gives the court a power "if" its conditions appear, and a grant of power whose "if" gate is unmet answers NOTHING, not "may not" (fork F19)
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE TRUE FALSE TRUE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- not honestly and reasonably; the text gives the court a power "if" its conditions appear, and a grant of power whose "if" gate is unmet answers NOTHING, not "may not" (fork F19)
#ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE TRUE TRUE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 1157(1) the court may relieve the defendant from liability` `s 1157 an officer of a company` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- he ought not fairly to be excused; the text gives the court a power "if" its conditions appear, and a grant of power whose "if" gate is unmet answers NOTHING, not "may not" (fork F19)

-- ---- s 1157(2) (arguments for (a): the defendant; reason to apprehend a claim)
#ASSERT `s 1157(2)(a) the person may apply to the court for relief` `s 1157 an officer of a company` TRUE EQUALS JUST TRUE
#ASSERT `s 1157(2)(a) the person may apply to the court for relief` `s 1157 a person employed by a company as auditor (whether or not an officer of the company)` TRUE EQUALS JUST TRUE
#ASSERT `s 1157(2)(a) the person may apply to the court for relief` `s 1157 an officer of a company` FALSE EQUALS NOTHING
#ASSERT `s 1157(2)(a) the person may apply to the court for relief` `s 1157 another person` TRUE EQUALS NOTHING
-- (arguments for (b): has applied; the s 1157(1) answer)
#ASSERT `s 1157(2)(b) the court has the same power to relieve the applicant` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1157(2)(b) the court has the same power to relieve the applicant` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1157(2)(b) the court has the same power to relieve the applicant` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1157(2)(b) the court has the same power to relieve the applicant` FALSE (JUST TRUE) EQUALS NOTHING -- no application

-- ---- s 1157(3) (arguments: a case to which (1) applies; tried by a judge with a jury; the judge is satisfied)
#ASSERT `s 1157(3) the judge may withdraw the case from the jury and direct judgment for the defendant` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1157(3) the judge may withdraw the case from the jury and direct judgment for the defendant` TRUE TRUE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `s 1157(3) the judge may withdraw the case from the jury and direct judgment for the defendant` TRUE TRUE FALSE EQUALS JUST FALSE -- not satisfied; the judge "may, if he is satisfied", and a power whose "if" gate is unmet answers NOTHING; the "Where" limbs on the next two lines stay JUST FALSE (fork F27, listed row F30)
#ASSERT `s 1157(3) the judge may withdraw the case from the jury and direct judgment for the defendant` TRUE FALSE TRUE EQUALS JUST FALSE -- no jury
#ASSERT `s 1157(3) the judge may withdraw the case from the jury and direct judgment for the defendant` FALSE TRUE TRUE EQUALS JUST FALSE -- not a case to which (1) applies

-- ---- the regulative rules, run with #TRACE. Expected values, decided from the text:
-- s 1154(1): the judicial factor gives notice: FULFILLED.
#TRACE `s 1154(1) the person specified in subsection (2) must give the registrar notice of the appointment` `s 1154 the judicial factor` AT 0 WITH
    PARTY `s 1154 the judicial factor` DOES `s 1154 give notice of the appointment to the registrar` AT 3

-- s 1155(1): notice on the 14th day (inclusive deadline): FULFILLED.
#TRACE `s 1155(1) the judicial factor must give the registrar notice within 14 days` AT 0 WITH
    PARTY `s 1154 the judicial factor` DOES `s 1154 give notice of the appointment to the registrar` AT 14

-- s 1155(1): notice on the 15th day: BREACH BY the judicial factor (the offence).
#TRACE `s 1155(1) the judicial factor must give the registrar notice within 14 days` AT 0 WITH
    PARTY `s 1154 the judicial factor` DOES `s 1154 give notice of the appointment to the registrar` AT 15

-- s 1155(1): no notice at all and the clock runs to day 15: BREACH BY the judicial factor.
#TRACE `s 1155(1) the judicial factor must give the registrar notice within 14 days` AT 0 WITH
    (WAITUNTIL 15)
