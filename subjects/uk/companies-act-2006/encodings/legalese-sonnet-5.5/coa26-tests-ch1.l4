IMPORT prelude
IMPORT `coa26-support`
IMPORT `coa26-ch1`

-- Tests for coa26-ch1.l4 (ss 1209-1211). Expected values are written by hand from the text.

-- s 1210(1): each limb alone makes the person a statutory auditor; the (c) limb needs the society to be an insurer or an issuer.
-- Argument order: (a) Part 16, (b) Building Societies Act, (c) friendly society, (c)(i) insurer, (c)(ii) issuer, (e), (f), (h).
-- (a) a person appointed as auditor under Part 16 of this Act
#ASSERT `s 1210(1) the person is a statutory auditor` TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (b) a person appointed under s 77 of or Sch 11 to the Building Societies Act 1986
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (c) friendly society auditor, where the society is an insurer
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE TRUE (JUST TRUE) (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (c) friendly society auditor, where the society is an issuer of securities admitted to trading on a UK regulated market
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE TRUE (JUST FALSE) (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (c) friendly society auditor, but the society is neither an insurer nor such an issuer: the limb fails and, no other limb holding, the definition says no
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- (c) friendly society auditor, insurer status not known and issuer status false: not covered
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE TRUE NOTHING (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- the insurer or issuer answers do not matter when the person is not a friendly society auditor
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST TRUE) (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- (e) Lloyd's syndicate and aggregate accounts auditor
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (f) auditor of an insurance undertaking under the Miscellaneous Insurance Undertakings Regulations 2008
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- (h) auditor of a prescribed person under a prescribed enactment
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
-- (h) the order that would prescribe the person is not known: not covered
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE NOTHING EQUALS NOTHING
-- (h) not prescribed: no limb holds, so the definition ("means") says no
#ASSERT `s 1210(1) the person is a statutory auditor` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- a limb that holds decides the answer even when another borrowed answer is not known
#ASSERT `s 1210(1) the person is a statutory auditor` TRUE FALSE FALSE NOTHING NOTHING FALSE FALSE NOTHING EQUALS JUST TRUE

-- "statutory audit" and "statutory audit work": only "construed accordingly", so a non-statutory auditor gives NOTHING, not FALSE
#ASSERT `s 1210(1) the audit is a statutory audit` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(1) the audit is a statutory audit` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1210(1) the audit is a statutory audit` NOTHING EQUALS NOTHING
#ASSERT `s 1210(1) the work is statutory audit work` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(1) the work is statutory audit work` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1210(1) the work is statutory audit work` NOTHING EQUALS NOTHING

-- s 1210(2): the audited person is the person in respect of whom a statutory audit is conducted
#ASSERT `s 1210(2) the person is an audited person` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(2) the person is an audited person` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1210(2) the person is an audited person` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 1210(2) the person is an audited person` FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 1210(3): the borrowed terms pass the borrowed answer through, and "prescribed" needs all three limbs
#ASSERT `s 1210(3) the body is a friendly society` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(3) the body is a friendly society` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1210(3) the body is a friendly society` NOTHING EQUALS NOTHING
#ASSERT `s 1210(3) the person is an insurer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(3) the person is an insurer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1210(3) the person is an insurer` NOTHING EQUALS NOTHING
#ASSERT `s 1210(3) the person is an issuer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1210(3) the person is an issuer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1210(3) the person is an issuer` NOTHING EQUALS NOTHING
#ASSERT `s 1210(3) the matter is prescribed` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1210(3) the matter is prescribed` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1210(3) the matter is prescribed` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1210(3) the matter is prescribed` TRUE TRUE FALSE EQUALS JUST FALSE

-- s 1211: "only if". Neither Chapter makes the person eligible: FALSE. Either does: the overview itself does not say, so NOTHING.
#ASSERT `s 1211 the person is eligible for appointment as a statutory auditor` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1211 the person is eligible for appointment as a statutory auditor` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1211 the person is eligible for appointment as a statutory auditor` (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1211 the person is eligible for appointment as a statutory auditor` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1211 the person is eligible for appointment as a statutory auditor` NOTHING NOTHING EQUALS NOTHING
