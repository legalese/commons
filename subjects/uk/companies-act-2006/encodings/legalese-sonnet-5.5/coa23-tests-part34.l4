IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa23-part34`

-- coa23-tests-part34.l4: tests for coa23-part34.l4 (Part 34, ss 1044 to 1059). Every expected value is written
-- here from the text of the section named beside it, before the module was run; none is copied from the module's output.
-- A failing assertion would be a finding, not an edit to the expected value.


-- s 1044: "an overseas company means a company incorporated outside the United Kingdom": a "means" definition
#ASSERT `s 1044 the company is an overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1044 the company is an overseas company` FALSE EQUALS JUST FALSE

-- s 1046(2): (a) must, for a company other than a Gibraltar company that opens a branch; (b) may, for a Gibraltar company; (c) may in other circumstances
#ASSERT `s 1046(2) the regulations must require the company to register particulars` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1046(2) the regulations must require the company to register particulars` TRUE TRUE EQUALS NOTHING
#ASSERT `s 1046(2) the regulations must require the company to register particulars` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1046(2) the regulations must require the company to register particulars` TRUE FALSE EQUALS NOTHING

-- s 1046(3): "branch" is handed to the Eleventh Company Law Directive (an input); "Gibraltar company" means a company incorporated in Gibraltar; "specified" means specified in the regulations
#ASSERT `s 1046(3) the establishment is a branch` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1046(3) the establishment is a branch` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1046(3) the establishment is a branch` NOTHING EQUALS NOTHING
#ASSERT `s 1046(3) the company is a Gibraltar company` TRUE EQUALS JUST TRUE
#ASSERT `s 1046(3) the company is a Gibraltar company` FALSE EQUALS JUST FALSE
#ASSERT `s 1046(7) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1046(7) the matter is specified` FALSE EQUALS JUST FALSE

-- s 1047(1): the regulations must require an overseas company that is required to register particulars to register its name
#ASSERT `s 1047(1) the regulations must require the company to register its name` TRUE EQUALS JUST TRUE
#ASSERT `s 1047(1) the regulations must require the company to register its name` FALSE EQUALS NOTHING

-- s 1047(2): the name may be (a) the corporate name or (b) an alternative name; a third kind of name is not decided
#ASSERT `s 1047(2) the name may be the registered name of the overseas company` `s 1047(2)(a) the company's corporate name` EQUALS JUST TRUE
#ASSERT `s 1047(2) the name may be the registered name of the overseas company` `s 1047(2)(b) an alternative name specified in accordance with section 1048` EQUALS JUST TRUE
#ASSERT `s 1047(2) the name may be the registered name of the overseas company` `s 1047(2) another name` EQUALS NOTHING

-- s 1047(4): every listed provision of Part 5 applies; another provision of Part 5 is not decided (the list is not closed with only)
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(a) section 53 (prohibited names)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(aa) section 53A (names for criminal purposes)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(b) sections 54 to 56 (sensitive words and expressions)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(bza) section 56A (names suggesting connection with foreign governments etc)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(ba) section 57 (permitted characters etc)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(bb) section 57A (names containing computer code)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(bc) section 57B (restriction on re-registering name following direction)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(bd) section 57C (names that another company has been directed to change)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(c) section 65 (inappropriate use of indications of company type or legal form)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(d) sections 66 to 74 (similarity to other names)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(e) section 75 (provision of misleading information etc)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(f) section 76 (misleading indication of activities)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(g) section 76A (power to direct change of name used for criminal purposes)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(h) section 76B (direction to change name wrongly registered)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(i) section 76C (registrar's power to change name containing computer code)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4)(j) section 76D (registrar's power to change name for failure to comply with direction)` EQUALS JUST TRUE
#ASSERT `s 1047(4) the provision of Part 5 applies to the registration of the name of an overseas company` `s 1047(4) another provision of Part 5` EQUALS NOTHING

-- s 1047(4): which row of the list a section number falls in (sections 54 to 56 and 66 to 74 are one row each; a section outside the list is another provision)
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 53 "" EQUALS `s 1047(4)(a) section 53 (prohibited names)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 53 "A" EQUALS `s 1047(4)(aa) section 53A (names for criminal purposes)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 54 "" EQUALS `s 1047(4)(b) sections 54 to 56 (sensitive words and expressions)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 55 "" EQUALS `s 1047(4)(b) sections 54 to 56 (sensitive words and expressions)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 56 "" EQUALS `s 1047(4)(b) sections 54 to 56 (sensitive words and expressions)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 56 "A" EQUALS `s 1047(4)(bza) section 56A (names suggesting connection with foreign governments etc)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 57 "" EQUALS `s 1047(4)(ba) section 57 (permitted characters etc)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 57 "A" EQUALS `s 1047(4)(bb) section 57A (names containing computer code)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 57 "B" EQUALS `s 1047(4)(bc) section 57B (restriction on re-registering name following direction)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 57 "C" EQUALS `s 1047(4)(bd) section 57C (names that another company has been directed to change)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 65 "" EQUALS `s 1047(4)(c) section 65 (inappropriate use of indications of company type or legal form)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 66 "" EQUALS `s 1047(4)(d) sections 66 to 74 (similarity to other names)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 70 "" EQUALS `s 1047(4)(d) sections 66 to 74 (similarity to other names)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 74 "" EQUALS `s 1047(4)(d) sections 66 to 74 (similarity to other names)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 75 "" EQUALS `s 1047(4)(e) section 75 (provision of misleading information etc)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 76 "" EQUALS `s 1047(4)(f) section 76 (misleading indication of activities)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 76 "A" EQUALS `s 1047(4)(g) section 76A (power to direct change of name used for criminal purposes)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 76 "B" EQUALS `s 1047(4)(h) section 76B (direction to change name wrongly registered)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 76 "C" EQUALS `s 1047(4)(i) section 76C (registrar's power to change name containing computer code)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 76 "D" EQUALS `s 1047(4)(j) section 76D (registrar's power to change name for failure to comply with direction)`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 52 "" EQUALS `s 1047(4) another provision of Part 5`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 53 "B" EQUALS `s 1047(4) another provision of Part 5`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 58 "" EQUALS `s 1047(4) another provision of Part 5`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 64 "" EQUALS `s 1047(4) another provision of Part 5`
#ASSERT `s 1047(4) the row of the list for the section of Part 5` 77 "" EQUALS `s 1047(4) another provision of Part 5`

-- s 1047(6): a reference to a change of name is read as a reference to registration of a different name; the rule says nothing of other references
#ASSERT `s 1047(6) the reference is read as a reference to registration of a different name under section 1048` TRUE EQUALS JUST TRUE
#ASSERT `s 1047(6) the reference is read as a reference to registration of a different name under section 1048` FALSE EQUALS NOTHING

-- s 1048(1): an overseas company required to register particulars may deliver a statement of a name other than its corporate name; outside that grant the text does not decide
#ASSERT `s 1048(1) the company may deliver a statement of an alternative name` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1048(1) the company may deliver a statement of an alternative name` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1048(1) the company may deliver a statement of an alternative name` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1048(1) the company may deliver a statement of an alternative name` TRUE TRUE FALSE EQUALS NOTHING

-- s 1048(2): a company that has registered an alternative name may deliver a statement of a different name in substitution
#ASSERT `s 1048(2) the company may deliver a statement of a different name in substitution` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1048(2) the company may deliver a statement of a different name in substitution` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1048(2) the company may deliver a statement of a different name in substitution` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1048(2) the company may deliver a statement of a different name in substitution` TRUE TRUE FALSE EQUALS NOTHING

-- s 1048(3): the alternative name for the time being registered is treated as the corporate name
#ASSERT `s 1048(3) the name is treated for all purposes of the law applying in the United Kingdom as the company's corporate name` TRUE EQUALS JUST TRUE
#ASSERT `s 1048(3) the name is treated for all purposes of the law applying in the United Kingdom as the company's corporate name` FALSE EQUALS NOTHING

-- s 1048(4): the treatment affects none of the three matters; any other matter is not decided
#ASSERT `s 1048(4) the treatment of the alternative name as the corporate name affects the matter` `s 1048(4)(a) the references in section 1048 or section 1047 to the company's corporate name` EQUALS JUST FALSE
#ASSERT `s 1048(4) the treatment of the alternative name as the corporate name affects the matter` `s 1048(4)(b) a right or obligation of the company` EQUALS JUST FALSE
#ASSERT `s 1048(4) the treatment of the alternative name as the corporate name affects the matter` `s 1048(4)(c) the validity of legal proceedings by or against the company` EQUALS JUST FALSE
#ASSERT `s 1048(4) the treatment of the alternative name as the corporate name affects the matter` `s 1048(4) another matter` EQUALS NOTHING

-- s 1048(5): proceedings that might have been continued or commenced by the corporate name or an earlier registered name may continue by the name now registered
#ASSERT `s 1048(5) the proceedings may be continued or commenced against the company by its name for the time being registered` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1048(5) the proceedings may be continued or commenced against the company by its name for the time being registered` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1048(5) the proceedings may be continued or commenced against the company by its name for the time being registered` TRUE FALSE EQUALS NOTHING

-- s 1048A(4): both terms have the meaning given by sections 86(2) and 88A(2), which are inputs here
#ASSERT `s 1048A(4) the address is an appropriate address` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1048A(4) the address is an appropriate address` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1048A(4) the address is an appropriate address` NOTHING EQUALS NOTHING
#ASSERT `s 1048A(4) the email address is an appropriate email address` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1048A(4) the email address is an appropriate email address` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1048A(4) the email address is an appropriate email address` NOTHING EQUALS NOTHING

-- s 1048B(1): the section applies in relation to an overseas company required to register particulars (a scope limit with no only: otherwise not decided)
#ASSERT `s 1048B(1) this section applies in relation to the overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1048B(1) this section applies in relation to the overseas company` FALSE EQUALS NOTHING

-- s 1050(1): applies to an institution formed outside the UK and Gibraltar, with head office outside, and a UK branch; a failed limb is a scope limit (not decided)
#ASSERT `s 1050(1) this section applies to the credit or financial institution` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1050(1) this section applies to the credit or financial institution` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1050(1) this section applies to the credit or financial institution` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 1050(1) this section applies to the credit or financial institution` TRUE TRUE FALSE EQUALS NOTHING

-- s 1050(2): "branch" means a place of business that is a legally dependent part and conducts directly some of the institution's operations
#ASSERT `s 1050(2) the place of business is a branch of the institution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1050(2) the place of business is a branch of the institution` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1050(2) the place of business is a branch of the institution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1050(2) the place of business is a branch of the institution` FALSE FALSE EQUALS JUST FALSE

-- s 1051(2)(a): the regulations shall in every case require a company that has registered particulars to disclose its registered name; s 1051(4) specified
#ASSERT `s 1051(2)(a) the regulations must require the company to disclose the name registered by it under section 1047` TRUE EQUALS JUST TRUE
#ASSERT `s 1051(2)(a) the regulations must require the company to disclose the name registered by it under section 1047` FALSE EQUALS NOTHING
#ASSERT `s 1051(4) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1051(4) the matter is specified` FALSE EQUALS JUST FALSE

-- s 1052(6): "registered overseas company" and "specified" are "means" definitions
#ASSERT `s 1052(6) the overseas company is a registered overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1052(6) the overseas company is a registered overseas company` FALSE EQUALS JUST FALSE
#ASSERT `s 1052(6) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1052(6) the matter is specified` FALSE EQUALS JUST FALSE

-- s 1053(1): the section applies to overseas companies required to register particulars (scope limit)
#ASSERT `s 1053(1) this section applies to the overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1053(1) this section applies to the overseas company` FALSE EQUALS NOTHING

-- s 1054(3)(a): the regulations must not provide for imprisonment: a flat negative
#ASSERT `s 1054(3)(a) the regulations may provide for imprisonment` EQUALS JUST FALSE

-- s 1054(3)(b) (fork F2): the limits are inputs. Illustrative inputs, not the Act's figures: level 5 = 5000 pounds; level 4 = 2500 pounds so the daily cap is one-tenth of the greater of 5000 and 2500, that is 500; level 4 = 8000 makes the cap 800
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5000 500 5000 2500 EQUALS NOTHING
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5001 500 5000 2500 EQUALS JUST FALSE
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5000 501 5000 2500 EQUALS JUST FALSE
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 0 0 5000 2500 EQUALS NOTHING
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5000 800 5000 8000 EQUALS NOTHING
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5000 801 5000 8000 EQUALS JUST FALSE
#ASSERT `s 1054(3)(b) the regulations may provide for those fines` 5001 801 5000 8000 EQUALS JUST FALSE

-- s 1054(4): "specified" means specified in the regulations
#ASSERT `s 1054(4) the matter is specified` TRUE EQUALS JUST TRUE
#ASSERT `s 1054(4) the matter is specified` FALSE EQUALS JUST FALSE

-- s 1055: where the regulations require particulars of an individual's usual residential address, they must contain corresponding provision; a failed where is a no
#ASSERT `s 1055 the regulations must contain provision corresponding to that made by Chapter 8 of Part 10` TRUE EQUALS JUST TRUE
#ASSERT `s 1055 the regulations must contain provision corresponding to that made by Chapter 8 of Part 10` FALSE EQUALS JUST FALSE

-- s 1056: the regulations must require either particulars of the UK-resident persons authorised to accept service or a statement that there is none
#ASSERT `s 1056 what the regulations under section 1046 must require the overseas company to register` TRUE EQUALS `s 1056(a) particulars identifying every person resident in the United Kingdom authorised to accept service of documents on behalf of the company`
#ASSERT `s 1056 what the regulations under section 1046 must require the overseas company to register` FALSE EQUALS `s 1056(b) a statement that there is no such person`

-- s 1057(1): the section applies to an overseas company required to register or registered in more than one part of the United Kingdom (scope limit)
#ASSERT `s 1057(1) this section applies to the overseas company` TRUE EQUALS JUST TRUE
#ASSERT `s 1057(1) this section applies to the overseas company` FALSE EQUALS NOTHING

-- s 1058(2): the notice goes to the registrar for the part to which the original return was delivered
#ASSERT `s 1058(2) the registrar to whom the regulations must provide for the notice to be given is the registrar for` `England and Wales` EQUALS `England and Wales`
#ASSERT `s 1058(2) the registrar to whom the regulations must provide for the notice to be given is the registrar for` `Scotland` EQUALS `Scotland`
#ASSERT `s 1058(2) the registrar to whom the regulations must provide for the notice to be given is the registrar for` `Northern Ireland` EQUALS `Northern Ireland`

-- s 1059: relocation from one part of the United Kingdom to another counts as closing one branch and opening another; within the same part it does not
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `England and Wales` `England and Wales` EQUALS JUST FALSE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `England and Wales` `Scotland` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `England and Wales` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Scotland` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Scotland` `Scotland` EQUALS JUST FALSE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Scotland` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Northern Ireland` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Northern Ireland` `Scotland` EQUALS JUST TRUE
#ASSERT `s 1059 the relocation counts as the closing of one branch and the opening of another` `Northern Ireland` `Northern Ireland` EQUALS JUST FALSE
