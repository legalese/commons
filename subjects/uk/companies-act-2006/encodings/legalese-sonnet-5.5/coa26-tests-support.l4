IMPORT prelude
IMPORT `coa26-support`

-- Tests of the three-valued helpers. Expected values are the strong Kleene tables, written by hand.

#ASSERT `coa26 support the answer is JUST TRUE` (JUST TRUE)
#ASSERT NOT (`coa26 support the answer is JUST TRUE` (JUST FALSE))
#ASSERT NOT (`coa26 support the answer is JUST TRUE` NOTHING)
#ASSERT `coa26 support the answer is JUST FALSE` (JUST FALSE)
#ASSERT NOT (`coa26 support the answer is JUST FALSE` (JUST TRUE))
#ASSERT NOT (`coa26 support the answer is JUST FALSE` NOTHING)
#ASSERT `coa26 support the answer is NOTHING` NOTHING
#ASSERT NOT (`coa26 support the answer is NOTHING` (JUST TRUE))
#ASSERT NOT (`coa26 support the answer is NOTHING` (JUST FALSE))

#ASSERT `coa26 support a fact as an answer` TRUE EQUALS JUST TRUE
#ASSERT `coa26 support a fact as an answer` FALSE EQUALS JUST FALSE

#ASSERT `coa26 support the opposite answer` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `coa26 support the opposite answer` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `coa26 support the opposite answer` NOTHING EQUALS NOTHING

-- both answers (AND): FALSE decides, TRUE needs both
#ASSERT `coa26 support both answers` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa26 support both answers` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa26 support both answers` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `coa26 support both answers` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `coa26 support both answers` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa26 support both answers` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `coa26 support both answers` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `coa26 support both answers` NOTHING NOTHING EQUALS NOTHING

-- either answer (OR): TRUE decides, FALSE needs both
#ASSERT `coa26 support either answer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa26 support either answer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `coa26 support either answer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa26 support either answer` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `coa26 support either answer` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa26 support either answer` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `coa26 support either answer` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `coa26 support either answer` NOTHING NOTHING EQUALS NOTHING

-- any of the answers / all of the answers (lists)
#ASSERT `coa26 support any of the answers` (LIST JUST FALSE, NOTHING, JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa26 support any of the answers` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa26 support any of the answers` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `coa26 support any of the answers` EMPTY EQUALS JUST FALSE
#ASSERT `coa26 support all of the answers` (LIST JUST TRUE, NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `coa26 support all of the answers` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `coa26 support all of the answers` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `coa26 support all of the answers` EMPTY EQUALS JUST TRUE
