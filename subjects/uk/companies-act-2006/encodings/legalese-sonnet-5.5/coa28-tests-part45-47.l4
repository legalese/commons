IMPORT prelude
IMPORT `coa-core`
IMPORT `coa-definitions`
IMPORT `coa28-part45`
IMPORT `coa28-part47`

-- coa28-tests-part45-47.l4: tests for coa28-part45.l4 and coa28-part47.l4 (ss 1284-1287, 1299). Every expected value was
-- decided by reading the section named beside it, before running; none is copied from the encoding's output.

-- ---- s 1284(1): the Companies Acts "as defined by this Act (see section 2)" extend to Northern Ireland
-- the seam is wired to the keel's answer of s 2(1)
`coa28 test provision in Part 5 of the Companies Act 2006` MEANS `s 2 provision` OF `s 2 the Companies Act 2006`, (`s 2 in a Part` 5), TRUE, TRUE
`coa28 test provision of the Companies Act 1985 no longer in force` MEANS `s 2 provision` OF `s 2 the Companies Act 1985`, (`s 2 in a Part` 1), FALSE, FALSE
`coa28 test provision of another enactment` MEANS `s 2 provision` OF `s 2 another enactment`, `s 2 in a Schedule`, TRUE, FALSE
#ASSERT `s 1284(1) the provision extends to Northern Ireland` (`s 2(1) the provision is one of the Companies Acts` `coa28 test provision in Part 5 of the Companies Act 2006`) EQUALS JUST TRUE
#ASSERT `s 1284(1) the provision extends to Northern Ireland` (`s 2(1) the provision is one of the Companies Acts` `coa28 test provision of the Companies Act 1985 no longer in force`) EQUALS NOTHING
#ASSERT `s 1284(1) the provision extends to Northern Ireland` (`s 2(1) the provision is one of the Companies Acts` `coa28 test provision of another enactment`) EQUALS NOTHING
#ASSERT `s 1284(1) the provision extends to Northern Ireland` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1284(1) the provision extends to Northern Ireland` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1284(1) the provision extends to Northern Ireland` NOTHING EQUALS NOTHING
-- ---- s 1284(2)
#ASSERT `s 1284(2) the instrument ceases to have effect` `s 1284(2) the Companies (Northern Ireland) Order 1986 (S.I. 1986/1032 (N.I. 6))` EQUALS JUST TRUE
#ASSERT `s 1284(2) the instrument ceases to have effect` `s 1284(2) the Companies Consolidation (Consequential Provisions) (Northern Ireland) Order 1986 (S.I. 1986/1035 (N.I. 9))` EQUALS JUST TRUE
#ASSERT `s 1284(2) the instrument ceases to have effect` `s 1284(2) Part 3 of the Companies (Audit, Investigations and Community Enterprise) Order 2005 (S.I. 2005/1967 (N.I. 17))` EQUALS JUST TRUE
#ASSERT `s 1284(2) the instrument ceases to have effect` `s 1284(2) another instrument` EQUALS NOTHING

-- ---- s 1285
-- columns: in force in Great Britain; relates to UK Societas
#ASSERT `s 1285(1) the enactment extends to Northern Ireland` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1285(1) the enactment extends to Northern Ireland` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1285(1) the enactment extends to Northern Ireland` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1285(2) the enactment ceases to have effect` `s 1285(2)(a) the European Public Limited-Liability Company Regulations (Northern Ireland) 2004 (SR 2004/417)` EQUALS JUST TRUE
#ASSERT `s 1285(2) the enactment ceases to have effect` `s 1285(2)(b) the European Public Limited-Liability Company (Fees) Regulations (Northern Ireland) 2004 (SR 2004/418)` EQUALS JUST TRUE
#ASSERT `s 1285(2) the enactment ceases to have effect` `s 1285(2) another enactment` EQUALS NOTHING
#ASSERT `s 1285(3) the entity is a UK Societas` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1285(3) the entity is a UK Societas` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1285(3) the entity is a UK Societas` NOTHING EQUALS NOTHING

-- ---- s 1286
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1)(a) limited liability partnerships` EQUALS JUST TRUE
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1)(b) limited partnerships` EQUALS JUST TRUE
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1)(c) open-ended investment companies` EQUALS JUST TRUE
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1)(d) European Economic Interest Groupings` EQUALS JUST TRUE
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1)(e) UK Economic Interest Groupings` EQUALS JUST TRUE
#ASSERT `s 1286(1) the enactments in force in Great Britain relating to the form extend to Northern Ireland` `s 1286(1) another form of business organisation` EQUALS NOTHING
#ASSERT `s 1286(2) the enactment ceases to have effect` `s 1286(2)(a) the Limited Liability Partnerships Act (Northern Ireland) 2002 (c. 12 (N. I.))` EQUALS JUST TRUE
#ASSERT `s 1286(2) the enactment ceases to have effect` `s 1286(2)(b) the Limited Partnerships Act 1907 (c. 24) as it formerly had effect in Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 1286(2) the enactment ceases to have effect` `s 1286(2)(c) the Open-Ended Investment Companies Act (Northern Ireland) 2002 (c. 13 (N.I.))` EQUALS JUST TRUE
#ASSERT `s 1286(2) the enactment ceases to have effect` `s 1286(2)(d) the European Economic Interest Groupings Regulations (Northern Ireland) 1989 (SR 1989/216)` EQUALS JUST TRUE
#ASSERT `s 1286(2) the enactment ceases to have effect` `s 1286(2) another enactment` EQUALS NOTHING

-- ---- s 1287
#ASSERT `s 1287(1) the provision extends to Northern Ireland` TRUE EQUALS JUST TRUE
#ASSERT `s 1287(1) the provision extends to Northern Ireland` FALSE EQUALS NOTHING
#ASSERT `s 1287(2) the instrument ceases to have effect` `s 1287(2) the Business Names (Northern Ireland) Order 1986 (S.I. 1986/1033 (N.I. 7))` EQUALS JUST TRUE
#ASSERT `s 1287(2) the instrument ceases to have effect` `s 1287(2) another instrument` EQUALS NOTHING

-- ---- s 1299: "Except as otherwise provided (or the context otherwise requires), the provisions of this Act extend to the whole of the United Kingdom"
-- columns: this Act otherwise provides for the provision; the context otherwise requires
#ASSERT `s 1299 the provision extends to the whole of the United Kingdom` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1299 the provision extends to the whole of the United Kingdom` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1299 the provision extends to the whole of the United Kingdom` FALSE TRUE EQUALS JUST FALSE
