IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa21-ch1-panel`

-- coa21-tests-ch1.l4: tests for coa21-ch1-panel.l4 (Part 28, Chapter 1, ss 942 to 963).
-- Every expected value is written from the text of the section named beside it, before the run, and never copied from the code's output.

§ `Tests for Chapter 1`

-- s 942(1): "The body known as the Panel on Takeovers and Mergers (the Panel)": a definition.
#ASSERT `s 942(1) the body is the Panel` TRUE EQUALS JUST TRUE
#ASSERT `s 942(1) the body is the Panel` FALSE EQUALS JUST FALSE

-- s 942(2): the Panel may do what it considers necessary or expedient for the purposes of, or in connection with, its functions.
#ASSERT `s 942(2) the Panel may do the act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 942(2) the Panel may do the act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 942(2) the Panel may do the act` FALSE TRUE EQUALS NOTHING

-- s 943(6): section 1 does not apply for the purposes of section 943 (flat negative); for another provision the subsection is silent.
#ASSERT `s 943(6) section 1 applies for the purposes of the provision` `s 943(6) section 943` EQUALS JUST FALSE
#ASSERT `s 943(6) section 1 applies for the purposes of the provision` `s 943(6) another provision` EQUALS NOTHING

-- s 943(7): "takeover bid" includes a bid within paragraph 20(1) of Schedule 1C.
#ASSERT `s 943(7) the bid is a takeover bid for the purposes of section 943` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 943(7) the bid is a takeover bid for the purposes of section 943` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 943(7) the bid is a takeover bid for the purposes of section 943` NOTHING EQUALS NOTHING

-- s 943(9): a reference to rules is to rules under section 943.
#ASSERT `s 943(9) the reference to rules in the following provisions of Chapter 1 is a reference to the rules` TRUE EQUALS JUST TRUE
#ASSERT `s 943(9) the reference to rules in the following provisions of Chapter 1 is a reference to the rules` FALSE EQUALS JUST FALSE

-- s 944(3): immediately after an instrument containing rules is made, the text must be made available to the public.
#ASSERT `s 944(3) the Panel has made the text available as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 944(3) the Panel has made the text available as the subsection requires` FALSE EQUALS JUST FALSE

-- s 944(4): a person is not taken to have contravened a rule if he shows the text had not been made available.
#ASSERT `s 944(4) the person is protected from being taken to have contravened the rule` TRUE EQUALS JUST TRUE
#ASSERT `s 944(4) the person is protected from being taken to have contravened the rule` FALSE EQUALS JUST FALSE

-- s 944(5): the certified copy is evidence (in Scotland sufficient evidence) when each of the five conditions holds.
#ASSERT `s 944(5) the weight of the certified copy` TRUE TRUE TRUE TRUE TRUE `s 944(5) elsewhere in the United Kingdom` EQUALS `s 944(5) is evidence`
#ASSERT `s 944(5) the weight of the certified copy` TRUE TRUE TRUE TRUE TRUE `s 944(5) Scotland` EQUALS `s 944(5) is sufficient evidence`
#ASSERT `s 944(5) the weight of the certified copy` FALSE TRUE TRUE TRUE TRUE `s 944(5) Scotland` EQUALS `s 944(5) not covered by this subsection`
#ASSERT `s 944(5) the weight of the certified copy` TRUE FALSE TRUE TRUE TRUE `s 944(5) Scotland` EQUALS `s 944(5) not covered by this subsection`
#ASSERT `s 944(5) the weight of the certified copy` TRUE TRUE FALSE TRUE TRUE `s 944(5) Scotland` EQUALS `s 944(5) not covered by this subsection`
#ASSERT `s 944(5) the weight of the certified copy` TRUE TRUE TRUE FALSE TRUE `s 944(5) Scotland` EQUALS `s 944(5) not covered by this subsection`
#ASSERT `s 944(5) the weight of the certified copy` TRUE TRUE TRUE TRUE FALSE `s 944(5) elsewhere in the United Kingdom` EQUALS `s 944(5) not covered by this subsection`

-- s 944(6): a certificate purporting to be signed is treated as properly signed unless the contrary is shown.
#ASSERT `s 944(6) the certificate is treated as properly signed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 944(6) the certificate is treated as properly signed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 944(6) the certificate is treated as properly signed` FALSE FALSE EQUALS NOTHING

-- s 944(7): a person who wishes in legal proceedings to rely on the instrument may require the Panel to endorse a copy.
#ASSERT `s 944(7) the person may require the Panel to endorse a copy of the instrument with a certificate` TRUE EQUALS JUST TRUE
#ASSERT `s 944(7) the person may require the Panel to endorse a copy of the instrument with a certificate` FALSE EQUALS NOTHING

-- s 945(1) and (2): rulings, and their binding effect to the extent the rules specify and subject to review or appeal.
#ASSERT `s 945(1) the Panel may give the ruling` TRUE EQUALS JUST TRUE
#ASSERT `s 945(1) the Panel may give the ruling` FALSE EQUALS NOTHING
#ASSERT `s 945(2) the ruling has binding effect` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 945(2) the ruling has binding effect` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 945(2) the ruling has binding effect` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 945(2) the ruling has binding effect` NOTHING FALSE EQUALS NOTHING

-- s 947(1): the Panel's requirement by notice in writing, specifying what it requires.
#ASSERT `s 947(1) the Panel has required the person to produce the documents or provide the information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 947(1) the Panel has required the person to produce the documents or provide the information` TRUE FALSE EQUALS NOTHING
#ASSERT `s 947(1) the Panel has required the person to produce the documents or provide the information` FALSE TRUE EQUALS NOTHING

-- s 947(2): complied with at the place specified and before the end of the period specified (boundary: the last day itself is in time).
#ASSERT `s 947(2) the requirement has been complied with as the subsection requires` (Date 14 3 2027) (Date 14 3 2027) TRUE EQUALS JUST TRUE
#ASSERT `s 947(2) the requirement has been complied with as the subsection requires` (Date 13 3 2027) (Date 14 3 2027) TRUE EQUALS JUST TRUE
#ASSERT `s 947(2) the requirement has been complied with as the subsection requires` (Date 15 3 2027) (Date 14 3 2027) TRUE EQUALS JUST FALSE
#ASSERT `s 947(2) the requirement has been complied with as the subsection requires` (Date 13 3 2027) (Date 14 3 2027) FALSE EQUALS JUST FALSE

-- s 947(3): the section applies only to what is reasonably required in connection with the Panel's functions.
#ASSERT `s 947(3) the section applies to the document or information` TRUE EQUALS JUST TRUE
#ASSERT `s 947(3) the section applies to the document or information` FALSE EQUALS JUST FALSE

-- s 947(4): the Panel may require authentication or verification in such manner as it may reasonably require.
#ASSERT `s 947(4) the Panel may require authentication or verification in that manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 947(4) the Panel may require authentication or verification in that manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 947(4) the Panel may require authentication or verification in that manner` FALSE TRUE EQUALS NOTHING

-- s 947(6): a person exercising a delegated power must, if required to do so, produce evidence of authority.
#ASSERT `s 947(6) the person must produce evidence of authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 947(6) the person must produce evidence of authority` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 947(6) the person must produce evidence of authority` FALSE TRUE EQUALS NOTHING

-- s 947(7) and (8): lien, and copies or extracts.
#ASSERT `s 947(7) the production affects a lien the person has on the document` TRUE EQUALS JUST FALSE
#ASSERT `s 947(7) the production affects a lien the person has on the document` FALSE EQUALS NOTHING
#ASSERT `s 947(8) the Panel may take copies of or extracts from the document` TRUE EQUALS JUST TRUE
#ASSERT `s 947(8) the Panel may take copies of or extracts from the document` FALSE EQUALS NOTHING

-- s 947(9): production of a document includes a hard copy of information not held in hard copy, and information from which a hard copy can be readily obtained.
#ASSERT `s 947(9) the production of the thing is a production of a document` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 947(9) the production of the thing is a production of a document` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 947(9) the production of the thing is a production of a document` FALSE FALSE EQUALS NOTHING

-- s 947(10): a person is not required to disclose what a claim to legal professional privilege could be maintained over.
#ASSERT `s 947(10) the person is required by section 947 to disclose the document or information` TRUE EQUALS JUST FALSE
#ASSERT `s 947(10) the person is required by section 947 to disclose the document or information` FALSE EQUALS NOTHING

-- The section as a whole: notice in writing, specified, reasonably required, and no privilege.
#ASSERT `s 947 the person must comply with the Panel's requirement` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 947 the person must comply with the Panel's requirement` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 947 the person must comply with the Panel's requirement` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 947 the person must comply with the Panel's requirement` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 947 the person must comply with the Panel's requirement` TRUE FALSE TRUE FALSE EQUALS NOTHING

-- s 947(1)-(2) as a regulative rule: the person must comply within the days the notice allows (10 days here); a DEONTIC cannot be compared in #ASSERT, so the outcome is printed and recorded in NOTES.md.
#TRACE `s 947(1)-(2) the person's duty to comply` 10 AT 0 WITH
    PARTY `s 947 the person required by the notice` DOES `s 947 comply with the Panel's requirement at the place specified` AT 10

#TRACE `s 947(1)-(2) the person's duty to comply` 10 AT 0 WITH
    (WAITUNTIL 11)

-- s 948(1): the section applies to information about private affairs or a business that is provided to the Panel.
#ASSERT `s 948(1) the section applies to the information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 948(1) the section applies to the information` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 948(1) the section applies to the information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 948(1) the section applies to the information` FALSE FALSE TRUE EQUALS NOTHING

-- s 948(2): no such information may be disclosed without consent, during the individual's lifetime or while the business continues.
#ASSERT `s 948(2) the disclosure is prohibited` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 948(2) the disclosure is prohibited` (JUST TRUE) FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 948(2) the disclosure is prohibited` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 948(2) the disclosure is prohibited` (JUST TRUE) FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 948(2) the disclosure is prohibited` (JUST TRUE) TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 948(2) the disclosure is prohibited` NOTHING TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING

-- s 948(3): subsection (2) does not apply to a disclosure within (a) to (d); (b) to (d) are Schedule 2's answers (seams); all four known to fail answers no.
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 948(3) subsection (2) does not apply to the disclosure` FALSE (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING

-- s 948(7): the authorities within the subsection.
#ASSERT `s 948(7) the body is an authority within the subsection` `s 948(7)(a) the Financial Conduct Authority` EQUALS JUST TRUE
#ASSERT `s 948(7) the body is an authority within the subsection` `s 948(7)(aa) the Prudential Regulation Authority` EQUALS JUST TRUE
#ASSERT `s 948(7) the body is an authority within the subsection` `s 948(7)(ab) the Bank of England` EQUALS JUST TRUE
#ASSERT `s 948(7) the body is an authority within the subsection` `s 948(7) another body` EQUALS NOTHING

-- s 948(6): subsection (2) does not apply to (a) an authority's disclosure of what the Panel disclosed to it under (3), (b) anyone's disclosure of what they got from such an authority.
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` NOTHING FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 948(6) subsection (2) does not apply to the disclosure` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE

-- s 948(8) and (9).
#ASSERT `s 948(8) the section prohibits the disclosure` TRUE EQUALS JUST FALSE
#ASSERT `s 948(8) the section prohibits the disclosure` FALSE EQUALS NOTHING
#ASSERT `s 948(9) the section authorises the disclosure` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 948(9) the section authorises the disclosure` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 948(9) the section authorises the disclosure` NOTHING EQUALS NOTHING

-- The section as a whole: an exception under (3) or (6), or the public-source exception under (8), answers no; an exception that cannot be ruled out is not covered; otherwise (2) governs.
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) NOTHING (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 948 the disclosure is prohibited by section 948` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 948 the disclosure is prohibited by section 948` NOTHING (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING

-- s 949(1): guilty of the offence unless he did not know or took all reasonable steps.
#ASSERT `s 949(1) the person is guilty of an offence` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 949(1) the person is guilty of an offence` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 949(1) the person is guilty of an offence` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 949(1) the person is guilty of an offence` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 949(1) the person is guilty of an offence` NOTHING FALSE FALSE EQUALS NOTHING

-- s 949(2): imprisonment not exceeding two years or a fine (or both) on indictment; twelve months or the statutory maximum in England and Wales; six months or the statutory maximum in Scotland or Northern Ireland.
#ASSERT `s 949(2) the penalty` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 949(2) the penalty` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 949(2) the penalty` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 949(2) the penalty` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` 1), NOTHING, TRUE)
#ASSERT `s 949(2) the penalty` `on summary conviction` EQUALS NOTHING

-- s 949(3): every officer in default is also guilty where the body corporate commits the offence.
#ASSERT `s 949(3) the officer also commits the offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 949(3) the officer also commits the offence` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 949(3) the officer also commits the offence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 949(3) the officer also commits the offence` NOTHING (JUST TRUE) EQUALS NOTHING

