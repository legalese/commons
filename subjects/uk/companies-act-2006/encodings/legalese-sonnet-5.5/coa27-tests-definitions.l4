IMPORT prelude
IMPORT `coa-core`
IMPORT `coa27-definitions`

-- coa27-tests-definitions.l4: tests for coa27-definitions.l4 (ss 1260, 1261, 1262).
-- Every expected value was decided by reading the section, and is written beside the assertion.

-- =========================================================================================================
-- s 1260 Meaning of "associate"
-- =========================================================================================================

--   fields in order:                                            spouse  isBC   isLLP  subjDir subjMem emplSubj sameGrp emplGrp emplPart assocPart
`s 1260 test candidate: no relationship`            MEANS `s 1260 candidate` OF FALSE,  FALSE, FALSE, FALSE,  FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: spouse`                     MEANS `s 1260 candidate` OF TRUE,   FALSE, FALSE, FALSE,  FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: company the subject directs` MEANS `s 1260 candidate` OF FALSE,  TRUE,  FALSE, TRUE,   FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: LLP the subject is a member of` MEANS `s 1260 candidate` OF FALSE, TRUE,  TRUE,  FALSE,  TRUE,   FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: LLP the subject is a director of` MEANS `s 1260 candidate` OF FALSE, TRUE, TRUE,  TRUE,   FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: a non-company the subject directs` MEANS `s 1260 candidate` OF FALSE, FALSE, FALSE, TRUE,  FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: employee or partner of subject` MEANS `s 1260 candidate` OF FALSE,  FALSE, FALSE, FALSE,  FALSE,  TRUE,    FALSE,  FALSE,  FALSE,   FALSE
`s 1260 test candidate: company in the same group`  MEANS `s 1260 candidate` OF FALSE,  TRUE,  FALSE, FALSE,  FALSE,  FALSE,   TRUE,   FALSE,  FALSE,   FALSE
`s 1260 test candidate: employee of a group company` MEANS `s 1260 candidate` OF FALSE,  FALSE, FALSE, FALSE,  FALSE,  FALSE,   FALSE,  TRUE,   FALSE,   FALSE
`s 1260 test candidate: employee or partner of the partnership` MEANS `s 1260 candidate` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`s 1260 test candidate: associate of a partner`     MEANS `s 1260 candidate` OF FALSE,  FALSE, FALSE, FALSE,  FALSE,  FALSE,   FALSE,  FALSE,  FALSE,   TRUE

-- s 1260(6): in the case of a body corporate which is a limited liability partnership, "director" is read as "member".
#ASSERT `s 1260(6) the subject counts as a director of the candidate body corporate` `s 1260 test candidate: company the subject directs`
#ASSERT `s 1260(6) the subject counts as a director of the candidate body corporate` `s 1260 test candidate: LLP the subject is a member of`
#ASSERT NOT (`s 1260(6) the subject counts as a director of the candidate body corporate` `s 1260 test candidate: LLP the subject is a director of`)
#ASSERT NOT (`s 1260(6) the subject counts as a director of the candidate body corporate` `s 1260 test candidate: a non-company the subject directs`)

-- s 1260(2) "In relation to an individual, 'associate' means (a) spouse, civil partner or minor child or step-child, (b) any body corporate of which that individual is a director, (c) any employee or partner".
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: spouse` EQUALS JUST TRUE
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: company the subject directs` EQUALS JUST TRUE
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: LLP the subject is a member of` EQUALS JUST TRUE
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: employee or partner of subject` EQUALS JUST TRUE
-- "director" read as "member" for an LLP: a "director" of an LLP who is not a member is not within (b)
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: LLP the subject is a director of` EQUALS JUST FALSE
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: no relationship` EQUALS JUST FALSE
-- being in the same group is a relationship that (2) does not list
#ASSERT `s 1260(2) the candidate is an associate of the individual` `s 1260 test candidate: company in the same group` EQUALS JUST FALSE

-- s 1260(3) body corporate: (a) a body corporate of which that body is a director, (b) a body corporate in the same group, (c) an employee or partner of that body or of any body corporate in the same group.
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: company the subject directs` EQUALS JUST TRUE
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: company in the same group` EQUALS JUST TRUE
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: employee or partner of subject` EQUALS JUST TRUE
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: employee of a group company` EQUALS JUST TRUE
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: no relationship` EQUALS JUST FALSE
-- a spouse is an associate of an individual (subsection (2)) but not of a body corporate
#ASSERT `s 1260(3) the candidate is an associate of the body corporate` `s 1260 test candidate: spouse` EQUALS JUST FALSE

-- s 1260(4) partnership that is a legal person: (a) a body corporate of which the partnership is a director, (b) an employee of or partner in the partnership, (c) an associate of a partner.
#ASSERT `s 1260(4) the candidate is an associate of the partnership that is a legal person` `s 1260 test candidate: company the subject directs` EQUALS JUST TRUE
#ASSERT `s 1260(4) the candidate is an associate of the partnership that is a legal person` `s 1260 test candidate: employee or partner of the partnership` EQUALS JUST TRUE
#ASSERT `s 1260(4) the candidate is an associate of the partnership that is a legal person` `s 1260 test candidate: associate of a partner` EQUALS JUST TRUE
#ASSERT `s 1260(4) the candidate is an associate of the partnership that is a legal person` `s 1260 test candidate: no relationship` EQUALS JUST FALSE
#ASSERT `s 1260(4) the candidate is an associate of the partnership that is a legal person` `s 1260 test candidate: company in the same group` EQUALS JUST FALSE

-- s 1260(5) partnership that is not a legal person: any person who is an associate of any of the partners.
#ASSERT `s 1260(5) the candidate is an associate of the partnership that is not a legal person` `s 1260 test candidate: associate of a partner` EQUALS JUST TRUE
#ASSERT `s 1260(5) the candidate is an associate of the partnership that is not a legal person` `s 1260 test candidate: employee or partner of the partnership` EQUALS JUST FALSE
#ASSERT `s 1260(5) the candidate is an associate of the partnership that is not a legal person` `s 1260 test candidate: no relationship` EQUALS JUST FALSE

-- s 1260(1): the kind of subject picks the subsection
#ASSERT `s 1260(1) the candidate is an associate of the subject` `s 1260 an individual` `s 1260 test candidate: spouse` EQUALS JUST TRUE
#ASSERT `s 1260(1) the candidate is an associate of the subject` `s 1260 a body corporate` `s 1260 test candidate: company in the same group` EQUALS JUST TRUE
#ASSERT `s 1260(1) the candidate is an associate of the subject` `s 1260 a partnership that is a legal person` `s 1260 test candidate: employee or partner of the partnership` EQUALS JUST TRUE
#ASSERT `s 1260(1) the candidate is an associate of the subject` `s 1260 a partnership that is not a legal person` `s 1260 test candidate: associate of a partner` EQUALS JUST TRUE
#ASSERT `s 1260(1) the candidate is an associate of the subject` `s 1260 an individual` `s 1260 test candidate: company in the same group` EQUALS JUST FALSE

-- =========================================================================================================
-- s 1261 Minor definitions
-- =========================================================================================================

-- "address" means (a) in relation to an individual, his usual residential or business address; (b) in relation to a firm, its registered or principal office in the United Kingdom.
#ASSERT `s 1261(1) the meaning of address for` `an individual` EQUALS `s 1261(1)(a) the individual's usual residential or business address`
#ASSERT `s 1261(1) the meaning of address for` `a company registered under the Companies Act 2006` EQUALS `s 1261(1)(b) the firm's registered or principal office in the United Kingdom`
#ASSERT `s 1261(1) the meaning of address for` `a partnership` EQUALS `s 1261(1)(b) the firm's registered or principal office in the United Kingdom`

-- "the Audit Regulation" means Regulation 537/2014.
#ASSERT `s 1261(1) the instrument is the Audit Regulation` TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the instrument is the Audit Regulation` FALSE EQUALS JUST FALSE

-- "audit working papers and investigation reports": (a) documents held by a statutory auditor or third country auditor and related to the conduct of an audit conducted by that auditor, (b) a report of an inspection, (c) a report of an investigation.
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the document is within audit working papers and investigation reports` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- "company" means any company or other body the accounts of which must be audited in accordance with Part 16.
#ASSERT `s 1261(1) the body is a company for this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the body is a company for this Part` FALSE EQUALS JUST FALSE

-- "the competent authority" means the Financial Reporting Council Limited.
#ASSERT `s 1261(1) the body is the competent authority` TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the body is the competent authority` FALSE EQUALS JUST FALSE

-- "the data protection legislation" has the same meaning as in the Data Protection Act 2018: a borrowed answer passes through.
#ASSERT `s 1261(1) the legislation is the data protection legislation` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the legislation is the data protection legislation` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1261(1) the legislation is the data protection legislation` NOTHING EQUALS NOTHING

-- "director", in relation to a body corporate, includes any person occupying the position of a director (by whatever name called) and any person in accordance with whose directions or instructions (not being advice given in a professional capacity) the directors are accustomed to act.
#ASSERT `s 1261(1) the person is a director of the body corporate` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is a director of the body corporate` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is a director of the body corporate` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- advice given in a professional capacity is excluded by "not being"
#ASSERT `s 1261(1) the person is a director of the body corporate` FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1261(1) the person is a director of the body corporate` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- "firm" means any entity, whether or not a legal person, which is not an individual and includes a body corporate, a corporation sole and a partnership or other unincorporated association.
#ASSERT `s 1261(1) the entity is a firm` `an individual` EQUALS JUST FALSE
#ASSERT `s 1261(1) the entity is a firm` `a corporation sole` EQUALS JUST TRUE
#ASSERT `s 1261(1) the entity is a firm` `a partnership` EQUALS JUST TRUE
#ASSERT `s 1261(1) the entity is a firm` `an unincorporated association` EQUALS JUST TRUE
#ASSERT `s 1261(1) the entity is a firm` `a company registered under the Companies Act 2006` EQUALS JUST TRUE
#ASSERT `s 1261(1) the entity is a firm` `a body corporate incorporated outside the United Kingdom` EQUALS JUST TRUE

-- "group": the body corporate, its holding company or subsidiary, and a subsidiary of that holding company.
#ASSERT `s 1261(1) group: either answer holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 1261(1) group: either answer holds` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) group: either answer holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1261(1) group: either answer holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 1261(1) group: either answer holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) group: either answer holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1261(1) group: either answer holds` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- a borrowed answer that is not known leaves the group answer not covered, never FALSE
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1261(1) the other body corporate is in the same group as the body corporate` FALSE (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST TRUE

-- "holding company" and "subsidiary" are read under s 1159 and Schedule 6; "parent undertaking" and "subsidiary undertaking" under s 1162 and Schedule 7.
#ASSERT `s 1261(1) the company is a holding company or subsidiary as sections 1159 and Schedule 6 read` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the company is a holding company or subsidiary as sections 1159 and Schedule 6 read` NOTHING EQUALS NOTHING
#ASSERT `s 1261(1) the undertaking is a parent undertaking or subsidiary undertaking as section 1162 and Schedule 7 read` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1261(1) the undertaking is a parent undertaking or subsidiary undertaking as section 1162 and Schedule 7 read` NOTHING EQUALS NOTHING

-- "officer", in relation to a body corporate, includes a director, a manager, a secretary or, where the affairs of the body are managed by its members, a member.
#ASSERT `s 1261(1) the person is an officer of the body corporate` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is an officer of the body corporate` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is an officer of the body corporate` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is an officer of the body corporate` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- "includes": a list not closed, so a person in none of the four is not covered, not FALSE
#ASSERT `s 1261(1) the person is an officer of the body corporate` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- "regulated market", "transferable securities", "UK regulated market" have the meaning given in Regulation (EU) No. 600/2014 (not among the sources).
#ASSERT `s 1261(1) the market is a regulated market` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the market is a regulated market` NOTHING EQUALS NOTHING
#ASSERT `s 1261(1) the instrument is a transferable security` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1261(1) the instrument is a transferable security` NOTHING EQUALS NOTHING
#ASSERT `s 1261(1) the market is a UK regulated market` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1261(1) the market is a UK regulated market` NOTHING EQUALS NOTHING

-- "third country" means a country or territory other than the United Kingdom.
#ASSERT `s 1261(1) the country or territory is a third country` FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the country or territory is a third country` TRUE EQUALS JUST FALSE

-- "third country auditor" means a person, other than a person eligible for appointment as a statutory auditor, who is eligible to conduct audits of third-country bodies in accordance with that country's law.
#ASSERT `s 1261(1) the person is a third country auditor` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the person is a third country auditor` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1261(1) the person is a third country auditor` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1261(1) the person is a third country auditor` TRUE FALSE EQUALS JUST FALSE

-- "third country competent authority" means a body established in a third country exercising functions related to the regulation or oversight of auditors.
#ASSERT `s 1261(1) the body is a third country competent authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the body is a third country competent authority` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1261(1) the body is a third country competent authority` FALSE TRUE EQUALS JUST FALSE

-- "transfer", in relation to audit working papers and investigation reports, includes physical and electronic transfer and allowing access to such papers.
#ASSERT `s 1261(1) the act is a transfer of audit working papers and investigation reports` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the act is a transfer of audit working papers and investigation reports` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(1) the act is a transfer of audit working papers and investigation reports` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1261(1) the act is a transfer of audit working papers and investigation reports` FALSE FALSE FALSE EQUALS NOTHING

-- s 1261(2) "established in the United Kingdom" if and only if (a) incorporated or formed under UK law, or (b) central management and control exercised in the UK.
#ASSERT `s 1261(2) the body is established in the United Kingdom` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1261(2) the body is established in the United Kingdom` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1261(2) the body is established in the United Kingdom` FALSE FALSE EQUALS JUST FALSE
-- a qualification "obtained in the United Kingdom" is a qualification obtained from such a body
#ASSERT `s 1261(2) the qualification was obtained in the United Kingdom` TRUE EQUALS JUST TRUE
#ASSERT `s 1261(2) the qualification was obtained in the United Kingdom` FALSE EQUALS JUST FALSE

-- =========================================================================================================
-- s 1262 Index of defined expressions: one assertion per row
-- =========================================================================================================

-- one assertion per table row; the expected cell is the right-hand cell of the row at the line named, as printed in the text
