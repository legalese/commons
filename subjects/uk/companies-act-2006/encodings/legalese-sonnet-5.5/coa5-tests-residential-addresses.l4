IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-residential-addresses`

-- coa5-tests-residential-addresses.l4: tests for ss 240 to 246 (coa5-residential-addresses.l4). Expected values read from the text, not from the code.

§ `Tests: s 240`

#ASSERT `s 240(2) the information is protected information` `s 240(1)(a) information as to his usual residential address` TRUE EQUALS JUST TRUE
#ASSERT `s 240(2) the information is protected information` `s 240(1)(b) the information that his service address is his usual residential address` TRUE EQUALS JUST TRUE
#ASSERT `s 240(2) the information is protected information` `s 240(1) other information` TRUE EQUALS JUST FALSE
#ASSERT `s 240(2) the information is protected information` `s 240(1)(a) information as to his usual residential address` FALSE EQUALS JUST FALSE
#ASSERT `s 240(3) the information ceases to be protected information` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 240(3) the information ceases to be protected information` TRUE FALSE EQUALS NOTHING
#ASSERT `s 240(3) the information ceases to be protected information` FALSE TRUE EQUALS NOTHING
#ASSERT `s 240(3) a reference in this Chapter to a director includes the person` TRUE EQUALS JUST TRUE
#ASSERT `s 240(3) a reference in this Chapter to a director includes the person` FALSE EQUALS NOTHING

§ `Tests: s 241`

-- s 241(2): consent: subsection (1) does not prohibit
#ASSERT `s 241(2) subsection (1) prohibits the use or disclosure` TRUE EQUALS JUST FALSE
#ASSERT `s 241(2) subsection (1) prohibits the use or disclosure` FALSE EQUALS NOTHING

-- s 241(1): a company must not use or disclose protected information about its directors, except (a) communicating with the director, (b) particulars for the registrar, (c) s 244
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1)(a) communicating with the director concerned` TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1)(b) complying with a requirement of the Companies Acts as to particulars to be sent to the registrar` TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1)(c) disclosure in accordance with section 244 (disclosure under court order)` TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1) another purpose` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1) another purpose` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 241(1) the company may not use or disclose the protected information` `s 241(1) another purpose` FALSE NOTHING EQUALS NOTHING

-- the prohibition as a rule
-- TRACE EXPECT: BREACHED
#TRACE `s 241(1) the company's duty not to use or disclose protected information` (JUST TRUE) AT 0 WITH
    PARTY Company DOES `s 241(1) use or disclose protected information about a director` AT 4

-- TRACE EXPECT: STANDING
#TRACE `s 241(1) the company's duty not to use or disclose protected information` (JUST TRUE) AT 0 WITH
    (WAITUNTIL 400)

-- TRACE EXPECT: FULFILLED
#TRACE `s 241(1) the company's duty not to use or disclose protected information` (JUST FALSE) AT 0 WITH
    PARTY Company DOES `s 241(1) use or disclose protected information about a director` AT 4

-- s 241(3): if a company uses or discloses in contravention of (1), an offence by (a) the company and (b) every officer in default
#ASSERT `s 241(3)(a) the company commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 241(3)(a) the company commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 241(3)(a) the company commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 241(3)(b) the officer commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 241(3)(b) the officer commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 241(3)(b) the officer commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 241(3)(b) the officer commits an offence` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 241(3)(b) the officer commits an offence` (JUST TRUE) NOTHING EQUALS NOTHING

-- s 241(4): England and Wales a fine (no limit stated); Scotland or Northern Ireland level 5 and a daily default fine of one-tenth of level 5
#ASSERT `s 241(4) the penalty` `on summary conviction in England and Wales` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 241(4) the penalty` `on summary conviction in Scotland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 241(4) the penalty` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 241(4) the penalty` `on summary conviction` EQUALS NOTHING
#ASSERT `s 241(4) the penalty` `on conviction on indictment` EQUALS NOTHING

§ `Tests: s 242`

-- s 242(1): omit where contained in a document delivered in which it is required to be stated and, for a document with more than one part, in a part in which it is required
#ASSERT `s 242(1) the registrar must omit the protected information from the material available for inspection` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 242(1) the registrar must omit the protected information from the material available for inspection` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 242(1) the registrar must omit the protected information from the material available for inspection` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 242(1) the registrar must omit the protected information from the material available for inspection` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 242(2) the registrar is obliged to do it` `s 242(2)(a) to check other documents or other parts of the document to ensure the absence of protected information` EQUALS JUST FALSE
#ASSERT `s 242(2) the registrar is obliged to do it` `s 242(2)(b) to omit from the material available for public inspection anything registered before this Chapter comes into force` EQUALS JUST FALSE
#ASSERT `s 242(2) the registrar is obliged to do it` `s 242(2) something else` EQUALS NOTHING
#ASSERT `s 242(3) the registrar must not make the disclosure` `s 242(3)(a) as permitted by section 243 (permitted disclosure by the registrar)` EQUALS JUST FALSE
#ASSERT `s 242(3) the registrar must not make the disclosure` `s 242(3)(b) in accordance with section 244 (disclosure under court order)` EQUALS JUST FALSE
#ASSERT `s 242(3) the registrar must not make the disclosure` `s 242(3)(c) as permitted by section 1110F (general powers of disclosure by the registrar)` EQUALS JUST FALSE
#ASSERT `s 242(3) the registrar must not make the disclosure` `s 242(3) in some other way` EQUALS JUST TRUE

§ `Tests: s 243`

#ASSERT `s 243(7) the person is a credit reference agency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 243(7) the person is a credit reference agency` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 243(7) the person is a credit reference agency` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 243(2) the registrar may disclose protected information to the person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 243(2) the registrar may disclose protected information to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 243(2) the registrar may disclose protected information to the person` NOTHING EQUALS NOTHING
-- s 243(4): the regulations are outside the sources: NOTHING unless supplied
#ASSERT `s 243(4) the registrar must refrain from disclosing the protected information to a credit reference agency` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 243(4) the registrar must refrain from disclosing the protected information to a credit reference agency` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 243(4) the registrar must refrain from disclosing the protected information to a credit reference agency` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 243(4) the registrar must refrain from disclosing the protected information to a credit reference agency` NOTHING TRUE EQUALS NOTHING

§ `Tests: s 244`

-- s 244(1): evidence that service at a service address is ineffective, or necessary or expedient for enforcement, and the court otherwise satisfied
#ASSERT `s 244(1) the court may make an order for the disclosure of protected information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 244(1) the court may make an order for the disclosure of protected information` FALSE TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 244(1) the court may make an order for the disclosure of protected information` TRUE TRUE FALSE EQUALS JUST FALSE; the function is named for a power or grant given "if" a gate is met, with no "only if", so when the gate fails the answer is NOTHING, not JUST FALSE (name-test sweep; the other reading is a failed "if" read as the text's own no)
#ASSERT `s 244(1) the court may make an order for the disclosure of protected information` TRUE TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 244(1) the court may make an order for the disclosure of protected information` FALSE FALSE TRUE EQUALS JUST FALSE; the function is named for a power or grant given "if" a gate is met, with no "only if", so when the gate fails the answer is NOTHING, not JUST FALSE (name-test sweep; the other reading is a failed "if" read as the text's own no)
#ASSERT `s 244(1) the court may make an order for the disclosure of protected information` FALSE FALSE TRUE EQUALS NOTHING
-- s 244(2): an order against the registrar only if the company does not have the address or has been dissolved
#ASSERT `s 244(2) an order for disclosure by the registrar may be made` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 244(2) an order for disclosure by the registrar may be made` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 244(2) an order for disclosure by the registrar may be made` FALSE FALSE EQUALS JUST FALSE
-- s 244(3): on the application of a liquidator, creditor or member, or any other person appearing to the court to have a sufficient interest
#ASSERT `s 244(3) the order may be made on the application of the person` `s 244(3) a liquidator of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 244(3) the order may be made on the application of the person` `s 244(3) a creditor of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 244(3) the order may be made on the application of the person` `s 244(3) a member of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 244(3) the order may be made on the application of the person` `s 244(3) any other person` TRUE EQUALS JUST TRUE
#ASSERT `s 244(3) the order may be made on the application of the person` `s 244(3) any other person` FALSE EQUALS NOTHING
-- s 244(4): the order must specify the persons and the purposes
#ASSERT `s 244(4) the order meets the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 244(4) the order meets the requirement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 244(4) the order meets the requirement` FALSE TRUE EQUALS JUST FALSE

§ `Tests: ss 245 and 246`

#ASSERT `s 245(1) the registrar may put the director's usual residential address on the public record` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 245(1) the registrar may put the director's usual residential address on the public record` FALSE TRUE EQUALS JUST TRUE
