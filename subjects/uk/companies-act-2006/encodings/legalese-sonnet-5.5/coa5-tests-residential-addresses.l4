#ASSERT `s 246(6) the company is a relevant company` FALSE EQUALS JUST FALSE

-- s 246(4): for the five years beginning with the date of the decision no service address but the usual residential address may be registered (F-246-1: the day before the fifth anniversary is the last day)
#ASSERT `s 246(4) no service address may be registered for the director other than the usual residential address` (Date 10 6 2025) (Date 10 6 2025) FALSE EQUALS JUST TRUE
