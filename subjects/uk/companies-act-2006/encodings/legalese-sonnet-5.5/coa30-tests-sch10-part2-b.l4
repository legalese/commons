IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch10-part1`
IMPORT `coa30-sch10-part2-b`

-- coa30-tests-sch10-part2-b.l4: tests for coa30-sch10-part2-b.l4 (Schedule 10 Part 2, paragraphs 9 to 20A).
-- Expected values are decided from the text of each paragraph. Arguments are positional, in GIVEN order.
-- Requirement functions: every limb that applies is required; a gate that is unmet leaves its limb vacuously met.

§ `Tests: Schedule 10 Part 2, paragraphs 9 to 20A`

-- sch 10 para 9(1): every limb that applies is required ("The body must have adequate rules and practices designed to ensure that")
#ASSERT `sch 10 para 9(1) the body meets the requirement` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 9(1) the body meets the requirement` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 9(1) the body meets the requirement` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 9(1) the body meets the requirement` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 9(1) the body meets the requirement` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 9(1A): the appointment as statutory auditor ended on 1 March 2025; "not less than one year ... commencing on the date" is 1 March 2025 to 28 February 2026.
-- args: audited person is a PIE, the person is an auditor or key audit partner, date ended, date of proposed appointment, standards months
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 28 2 2026) NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 1 3 2025) NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 1 3 2026) NOTHING EQUALS NOTHING
-- a standard set by the competent authority of 18 months extends the bar to 31 August 2026.
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 31 8 2026) (JUST 18) EQUALS JUST TRUE
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 1 9 2026) (JUST 18) EQUALS NOTHING
-- a standard shorter than the Act's minimum cannot shorten it.
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 28 2 2026) (JUST 6) EQUALS JUST TRUE
-- a date before the appointment ended is outside the period.
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 28 2 2025) NOTHING EQUALS NOTHING
-- a public interest entity is governed by paragraph 10C, not 9(1A): "except where".
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 1 4 2025) NOTHING EQUALS JUST FALSE
-- any other person is outside the sub-paragraph.
#ASSERT `sch 10 para 9(1A) the rules of the body must bar the appointment` FALSE FALSE (Date 1 3 2025) (Date 1 4 2025) NOTHING EQUALS NOTHING

#ASSERT `sch 10 para 9(3)(b) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 9(3)(b) the body meets the requirement` FALSE EQUALS JUST FALSE

-- sch 10 para 9(3A): every limb that applies is required ("The rules and practices mentioned in sub-paragraphs (1) and (3) must include provision requiring compliance with standards")
#ASSERT `sch 10 para 9(3A) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 9(3A) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 9(4): every limb that applies is required ("The rules referred to in sub-paragraphs (1A) and (3)(b) must apply to persons who are no longer members of the body as they apply to members")
#ASSERT `sch 10 para 9(4) the body meets the requirement that the rules apply to former members` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 9(4) the body meets the requirement that the rules apply to former members` FALSE EQUALS JUST FALSE
-- 9(4): a fine imposed in the enforcement of the (1A) or (3)(b) rules is a debt due to the body; any other fine is outside the sentence.
#ASSERT `sch 10 para 9(4) the fine is recoverable by the body as a debt due to it from the person obliged to pay it` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 9(4) the fine is recoverable by the body as a debt due to it from the person obliged to pay it` FALSE EQUALS NOTHING
-- 9(5)
#ASSERT `sch 10 para 9(5) the auditor is regarded as an officer of the audited person for the purposes of sub-paragraph (1A)(a) and (b)` TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 9(5) the auditor is regarded as an officer of the audited person for the purposes of sub-paragraph (1A)(a) and (b)` FALSE EQUALS NOTHING

-- sch 10 para 10(1): every limb that applies is required ("The body must have rules and practices as to")
#ASSERT `sch 10 para 10(1) the body meets the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10(1) the body meets the requirement` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 10(1) the body meets the requirement` TRUE FALSE EQUALS JUST FALSE
-- sch 10 para 10(2): every limb that applies is required ("The rules and practices mentioned in sub-paragraph (1) must include provision requiring compliance")
#ASSERT `sch 10 para 10(2) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10(2) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 10A(1): every limb that applies is required ("The body must have rules and practices as to technical standards ensuring that group auditors")
#ASSERT `sch 10 para 10A(1) the body meets the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10A(1) the body meets the requirement` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 10 para 10A(1) the body meets the requirement` TRUE FALSE EQUALS JUST FALSE
-- sch 10 para 10A(2): every limb that applies is required ("The rules and practices mentioned in sub-paragraph (1) must include provision requiring compliance")
#ASSERT `sch 10 para 10A(2) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10A(2) the body meets the requirement` FALSE EQUALS JUST FALSE
-- sch 10 para 10A(3): every limb that applies is required ("The body must have rules and practices ensuring that group auditors retain copies")
#ASSERT `sch 10 para 10A(3) the body meets the requirement` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10A(3) the body meets the requirement` FALSE EQUALS JUST FALSE
-- 10A(7): "group auditor" means a person appointed to conduct an audit of group accounts; "group" is borrowed from section 474 and passes straight through.
#ASSERT `sch 10 para 10A(7) the person is a group auditor` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10A(7) the person is a group auditor` FALSE EQUALS JUST FALSE
#ASSERT `sch 10 para 10A(7) the companies form a group` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 10 para 10A(7) the companies form a group` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 10 para 10A(7) the companies form a group` NOTHING EQUALS NOTHING

-- sch 10 para 10C(4): every limb that applies is required ("The rules referred to in sub-paragraph (3) must apply to persons who are no longer members of the body as they apply to members")
#ASSERT `sch 10 para 10C(4) the body meets the requirement that the rules apply to former members` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10C(4) the body meets the requirement that the rules apply to former members` FALSE EQUALS JUST FALSE
