#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 28 2 2027) NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 1 3 2027) NOTHING EQUALS NOTHING
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 28 2 2026) NOTHING EQUALS JUST TRUE
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 30 6 2027) (JUST 30) EQUALS JUST TRUE
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE TRUE (Date 1 3 2025) (Date 1 9 2027) (JUST 30) EQUALS NOTHING
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` FALSE TRUE (Date 1 3 2025) (Date 1 4 2025) NOTHING EQUALS NOTHING
#ASSERT `sch 10 para 10C(3) the rules of the body must bar the appointment` TRUE FALSE (Date 1 3 2025) (Date 1 4 2025) NOTHING EQUALS NOTHING
-- 10C(4), 10C(5)
#ASSERT `sch 10 para 10C(4) the fine is recoverable by the body as a debt due to it from the person obliged to pay it` TRUE EQUALS JUST TRUE
#ASSERT `sch 10 para 10C(4) the fine is recoverable by the body as a debt due to it from the person obliged to pay it` FALSE EQUALS NOTHING
