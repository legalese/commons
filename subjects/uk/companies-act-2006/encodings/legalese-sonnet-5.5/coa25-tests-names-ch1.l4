-- ---- s 1199(1)
#ASSERT `s 1199(1) the saving has effect in relation to the provision` `s 1199 a section from s 1192 to s 1196` EQUALS JUST TRUE
#ASSERT `s 1199(1) the saving has effect in relation to the provision` `s 1199 s 1197` EQUALS JUST TRUE
#ASSERT `s 1199(1) the saving has effect in relation to the provision` `s 1199 another provision` EQUALS NOTHING
-- ---- s 1199(2) (arguments: carried on the business immediately before the date; continues under the lawful business name)
#ASSERT `s 1199(2) sections 1192 to 1197 do not apply to the business` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1199(2) sections 1192 to 1197 do not apply to the business` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1199(2) sections 1192 to 1197 do not apply to the business` FALSE TRUE EQUALS NOTHING
-- ---- s 1199(3): "the period of twelve months beginning with the date of the transfer": transfer on 15 March 2026, so 15 March 2026 to 14 March 2027
-- (arguments: transferred on or after the date; carries on under the lawful business name; the date of the transfer; the date the business is carried on under that name)
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 15 3 2026) (Date 15 3 2026) EQUALS JUST TRUE -- the first day
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 15 3 2026) (Date 14 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 15 3 2026) (Date 15 3 2027) EQUALS JUST FALSE -- the day after the twelve months end
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 15 3 2026) (Date 14 3 2026) EQUALS JUST FALSE -- before the transfer
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 31 1 2026) (Date 30 1 2027) EQUALS JUST TRUE -- the last day of twelve months from 31 January 2026
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE TRUE (Date 31 1 2026) (Date 31 1 2027) EQUALS JUST FALSE
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` FALSE TRUE (Date 15 3 2026) (Date 15 3 2026) EQUALS NOTHING -- not transferred on or after the date
#ASSERT `s 1199(3) sections 1192 to 1197 do not apply to the business carried on under that name on the date` TRUE FALSE (Date 15 3 2026) (Date 15 3 2026) EQUALS NOTHING -- not the lawful business name
-- ---- s 1199(4) (arguments: when the business was carried on under the name; contravened the 1985 Act or the 1986 Order; contravened this Chapter)
#ASSERT `s 1199(4) the name is a lawful business name` `s 1199 before this Chapter came into force` FALSE TRUE EQUALS JUST TRUE -- only the 1985 Act counts before the Chapter
#ASSERT `s 1199(4) the name is a lawful business name` `s 1199 before this Chapter came into force` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1199(4) the name is a lawful business name` `s 1199 after this Chapter came into force` TRUE FALSE EQUALS JUST TRUE -- only this Chapter counts afterwards
#ASSERT `s 1199(4) the name is a lawful business name` `s 1199 after this Chapter came into force` FALSE TRUE EQUALS JUST FALSE

-- ---- s 1199A(1) (arguments: a written notice naming the name; satisfied: national security; satisfied: serious crime)
#ASSERT `s 1199A(1) the prohibitions of this Chapter do not apply to the business under the name` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1199A(1) the prohibitions of this Chapter do not apply to the business under the name` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1199A(1) the prohibitions of this Chapter do not apply to the business under the name` TRUE FALSE FALSE EQUALS NOTHING -- not satisfied of either
#ASSERT `s 1199A(1) the prohibitions of this Chapter do not apply to the business under the name` FALSE TRUE TRUE EQUALS NOTHING -- no notice
-- ---- s 1199A(2)(a): crime (arguments: constitutes a criminal offence; corresponds to such conduct)
#ASSERT `s 1199A(2)(a) the conduct is crime` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1199A(2)(a) the conduct is crime` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1199A(2)(a) the conduct is crime` FALSE FALSE EQUALS JUST FALSE
-- ---- s 1199A(2)(b): serious crime (arguments: the longest maximum term in years; violence; substantial financial gain; a large number of persons)
#ASSERT `s 1199A(2)(b) the crime is serious` 3 FALSE FALSE FALSE EQUALS JUST TRUE -- "3 years or more": 3 years
#ASSERT `s 1199A(2)(b) the crime is serious` 2 FALSE FALSE FALSE EQUALS JUST FALSE -- 2 years
#ASSERT `s 1199A(2)(b) the crime is serious` 2.5 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1199A(2)(b) the crime is serious` 10 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1199A(2)(b) the crime is serious` 1 TRUE FALSE FALSE EQUALS JUST TRUE -- violence
#ASSERT `s 1199A(2)(b) the crime is serious` 1 FALSE TRUE FALSE EQUALS JUST TRUE -- substantial financial gain
#ASSERT `s 1199A(2)(b) the crime is serious` 1 FALSE FALSE TRUE EQUALS JUST TRUE -- a large number of persons in pursuit of a common purpose

-- ---- regulative rules, run with #TRACE. Expected values, decided from the text:
-- s 1195(2) and (3): the applicant requests the view and then submits the statement and copy: FULFILLED.
#TRACE `s 1195(2) the applicant must request the view of the department or body and submit a statement` AT 0 WITH
    PARTY `s 1195 the applicant for approval` DOES `s 1195 request the specified department or other body, in writing, to indicate whether it has any objections to the proposed name` AT 1
    PARTY `s 1195 the applicant for approval` DOES `s 1195 submit to the Secretary of State a statement that the request has been made and a copy of any response` AT 2

-- s 1195(2): the applicant submits a statement without ever asking the department: the duty to ask is unmet; the trace shows the
-- obligation still standing (the text gives no time limit, so there is no breach until one is declared).
#TRACE `s 1195(2) the applicant must request the view of the department or body and submit a statement` AT 0 WITH
    PARTY `s 1195 the applicant for approval` DOES `s 1195 submit to the Secretary of State a statement that the request has been made and a copy of any response` AT 1
