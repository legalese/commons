#ASSERT `s 1193(2) the body is a local authority` `s 1193 another body` EQUALS JUST FALSE
#ASSERT `s 1193(2) the person or body is a public authority` TRUE EQUALS JUST TRUE
#ASSERT `s 1193(2) the person or body is a public authority` FALSE EQUALS NOTHING -- "includes"
#ASSERT `s 1193(4) the person commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1193(4) the person commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1193(4) the person commits an offence` NOTHING EQUALS NOTHING
#ASSERT `s 1193(5) an officer of the body corporate commits an offence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE -- (arguments: the body commits the offence; the officer is in default)
#ASSERT `s 1193(5) an officer of the body corporate commits an offence` (JUST TRUE) (JUST FALSE) EQUALS NOTHING -- an officer not in default: limited by its own wording
#ASSERT `s 1193(5) an officer of the body corporate commits an offence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 1193(5) an officer of the body corporate commits an offence` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE -- the body committed no offence
#ASSERT `s 1193(5) an officer of the body corporate commits an offence` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 1193(6) the penalty for an offence under s 1193` (JUST TRUE) EQUALS JUST `s 1193 test penalty level 3 with a tenth`
#ASSERT `s 1193(6) the penalty for an offence under s 1193` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 1193(6) the penalty for an offence under s 1193` NOTHING EQUALS NOTHING

