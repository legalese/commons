IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-notification`

-- coa4-tests-notification.l4: tests for coa4-notification.l4 (ss 167G to 167N). Expected values are written from the text
-- of the section named beside each assertion, before the code was run.

-- Fixture: a notice of a person having become a director, field by field in the order of the record:
-- information, consent, is an individual, identity statement, not-disqualified statement, not-ineligible statement,
-- would be disqualified but for the permission of a court, court statement, permission-date statement,
-- would be disqualified but for the authority of a licence, licence-date statement, licence-issuer statement.
GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN, f IS A BOOLEAN
      g IS A BOOLEAN, h IS A BOOLEAN, i IS A BOOLEAN, j IS A BOOLEAN, k IS A BOOLEAN, l IS A BOOLEAN
GIVETH A `s 167G(3) the notice of a person having become a director`
`s 167G(3) fixture notice` MEANS `s 167G(3) the notice of a person having become a director` OF a, b, c, d, e, f, g, h, i, j, k, l

-- s 167G(1) and (5): arguments: a person becomes a director; a person ceases to be a director; became a director on incorporation and is named in the s 12 statement
#ASSERT `s 167G(1) the company is obliged to give notice to the registrar of the change` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 167G(1) the company is obliged to give notice to the registrar of the change` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 167G(1) the company is obliged to give notice to the registrar of the change` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 167G(1) the company is obliged to give notice to the registrar of the change` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 167G(1) the company is obliged to give notice to the registrar of the change` TRUE FALSE TRUE EQUALS JUST FALSE
-- s 167G(2): the notice must specify the date
#ASSERT `s 167G(2) the notice specifies the date as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 167G(2) the notice specifies the date as the subsection requires` FALSE EQUALS JUST FALSE
-- s 167G(3)(a) to (f), each on its own, then the whole. A valid notice for an individual: all statements made, no disqualification case.
#ASSERT `s 167G(3)(a) the notice contains a statement of the required information about the new director` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(a) the notice contains a statement of the required information about the new director` (`s 167G(3) fixture notice` FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(b) the notice contains a statement by the company that the person has consented to act in that capacity` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(b) the notice contains a statement by the company that the person has consented to act in that capacity` (`s 167G(3) fixture notice` TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(c) the notice contains a statement that the individual's identity is verified` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(c) the notice contains a statement that the individual's identity is verified` (`s 167G(3) fixture notice` TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(c) the notice contains a statement that the individual's identity is verified` (`s 167G(3) fixture notice` TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 167G(3)(c) the notice contains a statement that the individual's identity is verified` (`s 167G(3) fixture notice` TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 167G(3)(d) the notice contains a statement that the person is neither disqualified nor otherwise ineligible` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(d) the notice contains a statement that the person is neither disqualified nor otherwise ineligible` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(d) the notice contains a statement that the person is neither disqualified nor otherwise ineligible` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(e) the notice contains a statement of the court and the date of the permission` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 167G(3)(e) the notice contains a statement of the court and the date of the permission` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(e) the notice contains a statement of the court and the date of the permission` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(e) the notice contains a statement of the court and the date of the permission` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(e) the notice contains a statement of the court and the date of the permission` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(f) the notice contains a statement of the date and issuer of the licence` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT `s 167G(3)(f) the notice contains a statement of the date and issuer of the licence` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 167G(3)(f) the notice contains a statement of the date and issuer of the licence` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3)(f) the notice contains a statement of the date and issuer of the licence` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT `s 167G(3) the notice contains what the subsection requires` (`s 167G(3) fixture notice` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- s 167G(4): permission of a court to act means permission of a court under a provision in column 2 of the table
#ASSERT `s 167G(4) the permission is permission of a court to act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 167G(4) the permission is permission of a court to act` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167G(4) the permission is permission of a court to act` FALSE TRUE EQUALS JUST FALSE
-- s 167G(6): within the period of 14 days beginning with the day the person becomes or ceases to be a director
#ASSERT `s 167G(6) the last day of the period of 14 days beginning with the day the person becomes or ceases to be a director` (Date 1 1 2025) EQUALS Date 14 1 2025
#ASSERT `s 167G(6) the last day of the period of 14 days beginning with the day the person becomes or ceases to be a director` (Date 25 1 2025) EQUALS Date 7 2 2025
#ASSERT `s 167G(6) the last day of the period of 14 days beginning with the day the person becomes or ceases to be a director` (Date 25 12 2024) EQUALS Date 7 1 2025
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 1 1 2025) (Date 1 1 2025) EQUALS JUST TRUE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 1 1 2025) (Date 14 1 2025) EQUALS JUST TRUE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 1 1 2025) (Date 15 1 2025) EQUALS JUST FALSE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 1 1 2025) (Date 31 12 2024) EQUALS JUST FALSE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 1 1 2025) (Date 7 1 2025) EQUALS JUST TRUE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 25 12 2024) (Date 7 1 2025) EQUALS JUST TRUE
#ASSERT `s 167G(6) the notice is given within the period of 14 days` (Date 25 12 2024) (Date 8 1 2025) EQUALS JUST FALSE
-- s 167G(1) and (6) as a regulative rule: the clock is 0 on the day the person becomes or ceases to be a director; the 14th day is clock 13.
-- Read the results: notice at 13 FULFILLED; nothing by 14 BREACH.
#TRACE `s 167G(1) the company's duty to give notice to the registrar of the change in directors` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in directors under section 167G" AT 13
#TRACE `s 167G(1) the company's duty to give notice to the registrar of the change in directors` AT 0 WITH
    (WAITUNTIL 14)

-- s 167H
#ASSERT `s 167H(1) the company is obliged to give notice to the registrar of the change in the required information` TRUE EQUALS JUST TRUE
#ASSERT `s 167H(1) the company is obliged to give notice to the registrar of the change in the required information` FALSE EQUALS JUST FALSE
#ASSERT `s 167H(2) the notice specifies the date of the change as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 167H(2) the notice specifies the date of the change as the subsection requires` FALSE EQUALS JUST FALSE
#ASSERT `s 167H(3) the notice is given within the period of 14 days beginning with the day the change occurs` (Date 10 3 2025) (Date 23 3 2025) EQUALS JUST TRUE
#ASSERT `s 167H(3) the notice is given within the period of 14 days beginning with the day the change occurs` (Date 10 3 2025) (Date 24 3 2025) EQUALS JUST FALSE
#ASSERT `s 167H(3) the notice is given within the period of 14 days beginning with the day the change occurs` (Date 10 3 2025) (Date 9 3 2025) EQUALS JUST FALSE
#ASSERT `s 167H(3) the notice is given within the period of 14 days beginning with the day the change occurs` (Date 10 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 167H(4) the notice contains the statement that the residential address is unchanged as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 167H(4) the notice contains the statement that the residential address is unchanged as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167H(4) the notice contains the statement that the residential address is unchanged as the subsection requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 167H(4) the notice contains the statement that the residential address is unchanged as the subsection requires` FALSE FALSE EQUALS NOTHING
#TRACE `s 167H(1) the company's duty to give notice to the registrar of the change in the required information` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the change in the required information under section 167H" AT 13
#TRACE `s 167H(1) the company's duty to give notice to the registrar of the change in the required information` AT 0 WITH
    (WAITUNTIL 14)

-- s 167I
#ASSERT `s 167I(1) the company is obliged to give notice to the registrar that the proposed director did not become a director` TRUE EQUALS JUST TRUE
#ASSERT `s 167I(1) the company is obliged to give notice to the registrar that the proposed director did not become a director` FALSE EQUALS JUST FALSE
#ASSERT `s 167I(2) the company is obliged to give notice to the registrar of the change in the required information about the proposed director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 167I(2) the company is obliged to give notice to the registrar of the change in the required information about the proposed director` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167I(2) the company is obliged to give notice to the registrar of the change in the required information about the proposed director` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 167I(3) the company is required to give notice under subsection (2) in respect of the person` TRUE EQUALS JUST FALSE
#ASSERT `s 167I(3) the company is required to give notice under subsection (2) in respect of the person` FALSE EQUALS NOTHING
#ASSERT `s 167I(4) the notice specifies the date of the change as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 167I(4) the notice specifies the date of the change as the subsection requires` FALSE EQUALS JUST FALSE
#ASSERT `s 167I(5) the notice is given within the period of 14 days beginning with the day the company was incorporated` (Date 2 6 2025) (Date 15 6 2025) EQUALS JUST TRUE
#ASSERT `s 167I(5) the notice is given within the period of 14 days beginning with the day the company was incorporated` (Date 2 6 2025) (Date 16 6 2025) EQUALS JUST FALSE
#ASSERT `s 167I(5) the notice is given within the period of 14 days beginning with the day the company was incorporated` (Date 2 6 2025) (Date 1 6 2025) EQUALS JUST FALSE
#TRACE `s 167I(5) the company's duty to give notice to the registrar of the matters before incorporation` AT 0 WITH
    PARTY Company DOES `Action of a party` OF Company, Registrar, "give notice of the matters under section 167I" AT 13
#TRACE `s 167I(5) the company's duty to give notice to the registrar of the matters before incorporation` AT 0 WITH
    (WAITUNTIL 14)

-- s 167J(1): the five items, and any other
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1)(a) name, date of birth and nationality` EQUALS JUST TRUE
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1)(b) any relevant former names` EQUALS JUST TRUE
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1)(c) a service address` EQUALS JUST TRUE
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1)(d) usual residential address` EQUALS JUST TRUE
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1)(e) the part of the United Kingdom, or the country or state outside it, in which the individual is usually resident` EQUALS JUST TRUE
#ASSERT `s 167J(1) the item is required information about a director who is an individual` `s 167J(1) any other information` EQUALS JUST FALSE
-- s 167J(2): relevant former name. A person born 1 June 1970 attains 16 on 1 June 1986.
-- arguments: the person; the name is a former name; the peer or title case; the day the name was changed or disused; the day in question; the registrar must refrain
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE FALSE (Date 1 6 1986) (Date 1 6 2005) FALSE EQUALS JUST TRUE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE FALSE (Date 31 5 1986) (Date 1 6 2005) FALSE EQUALS JUST FALSE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE FALSE (Date 1 6 1986) (Date 1 6 2006) FALSE EQUALS JUST FALSE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE FALSE (Date 1 6 1986) (Date 31 5 2006) FALSE EQUALS JUST TRUE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) FALSE FALSE (Date 1 6 1986) (Date 1 6 2005) FALSE EQUALS JUST FALSE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE TRUE (Date 1 6 1986) (Date 1 6 2005) FALSE EQUALS JUST FALSE
#ASSERT `s 167J(2) the name is a relevant former name` (Individual WITH `reference for the individual` IS "P", `date of birth` IS Date 1 6 1970) TRUE FALSE (Date 1 6 1986) (Date 1 6 2005) TRUE EQUALS JUST FALSE
#ASSERT `s 167J(3) the name is a former name` TRUE EQUALS JUST TRUE
#ASSERT `s 167J(3) the name is a former name` FALSE EQUALS JUST FALSE
#ASSERT `s 167J(3) the item is the individual's name` TRUE EQUALS JUST TRUE
#ASSERT `s 167J(3) the item is the individual's name` FALSE EQUALS JUST FALSE
#ASSERT `s 167J(4) the requirement to provide the individual's name is satisfied by providing the title` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 167J(4) the requirement to provide the individual's name is satisfied by providing the title` TRUE FALSE EQUALS NOTHING
#ASSERT `s 167J(4) the requirement to provide the individual's name is satisfied by providing the title` FALSE TRUE EQUALS NOTHING
-- s 167K(1): arguments: the item; limited company; UK-registered company; the body is entered in a register
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(a) corporate or firm name` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(a) corporate or firm name` FALSE FALSE TRUE EQUALS JUST TRUE
