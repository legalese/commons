#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(e)(i) the legal form of the body corporate or firm and the law by which it is governed` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(e)(ii) the register in which it is entered (including details of the state) and its registration number in that register` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(e)(ii) the register in which it is entered (including details of the state) and its registration number in that register` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1)(e)(ii) the register in which it is entered (including details of the state) and its registration number in that register` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 167K(1) the item is required information about a body corporate or a firm that is a legal person` `s 167K(1) any other information` TRUE TRUE TRUE EQUALS JUST FALSE
-- s 167L
#ASSERT `s 167L(1)(a) the company commits an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 167L(1)(a) the company commits an offence` FALSE EQUALS JUST FALSE
-- arguments: the company fails without reasonable excuse; officer (s 1173(1)); shadow director (s 251); in default (s 1121)
#ASSERT `s 167L(1)(b) the officer in default commits the offence` FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 167L(1)(b) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 167L(1)(b) the officer in default commits the offence` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 167L(1)(b) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 167L(1)(b) the officer in default commits the offence` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167L(1)(b) the officer in default commits the offence` TRUE NOTHING (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167L(3) the penalty for the offence` `on summary conviction in England and Wales` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 167L(3) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 167L(3) the penalty for the offence` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 167L(3) the penalty for the offence` `on summary conviction` EQUALS NOTHING
#ASSERT `s 167L(3) the penalty for the offence` `on conviction on indictment` EQUALS NOTHING
