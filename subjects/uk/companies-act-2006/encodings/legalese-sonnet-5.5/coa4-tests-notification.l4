#ASSERT `s 167M(6) the consequence follows from contravening subsection (1) or (2)` `s 167M(6) an offence provided for by section 167M` EQUALS JUST TRUE
#ASSERT `s 167M(6) the consequence follows from contravening subsection (1) or (2)` `s 167M(6) the invalidity of the individual's acts as a director` EQUALS JUST FALSE
#ASSERT `s 167M(6) the consequence follows from contravening subsection (1) or (2)` `s 167M(6) any other consequence` EQUALS JUST FALSE
-- s 167N
-- arguments: became a director otherwise than on incorporation; notice not given within the s 167G(6) period; acts as a director; notice has now been given
#ASSERT `s 167N(2) the person contravenes subsection (2) by acting as a director` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 167N(2) the person contravenes subsection (2) by acting as a director` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 167N(2) the person contravenes subsection (2) by acting as a director` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 167N(2) the person contravenes subsection (2) by acting as a director` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167N(2) the person contravenes subsection (2) by acting as a director` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167N(3) the person who contravenes subsection (2) commits an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 167N(3) the person who contravenes subsection (2) commits an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 167N(3) the person who contravenes subsection (2) commits an offence` NOTHING EQUALS NOTHING
-- arguments: the offence is committed by a firm; officer of the firm (s 1173(1)); in default (s 1121)
#ASSERT `s 167N(4) the officer in default commits the offence` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 167N(4) the officer in default commits the offence` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 167N(4) the officer in default commits the offence` TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167N(4) the officer in default commits the offence` TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 167N(4) the officer in default commits the offence` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167N(4) the officer in default commits the offence` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 167N(5) this section gives the person a defence on these facts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 167N(5) this section gives the person a defence on these facts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 167N(5) this section gives the person a defence on these facts` FALSE TRUE EQUALS NOTHING
#ASSERT `s 167N(5) this section gives the person a defence on these facts` FALSE FALSE EQUALS NOTHING
#ASSERT `s 167N(6) the penalty for the offence` `on summary conviction in England and Wales` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in England and Wales`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST `a fine without a stated limit`, `daily default fine for continued contravention` IS NOTHING, `imprisonment and fine together` IS FALSE)
#ASSERT `s 167N(6) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Scotland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 167N(6) the penalty for the offence` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty WITH `how convicted` IS `on summary conviction in Northern Ireland`, `imprisonment not exceeding` IS NOTHING, `fine not exceeding` IS JUST (`a fine not exceeding a level on the standard scale` 5 1), `daily default fine for continued contravention` IS JUST (`a fine not exceeding a level on the standard scale` 5 0.1), `imprisonment and fine together` IS FALSE)
#ASSERT `s 167N(6) the penalty for the offence` `on summary conviction` EQUALS NOTHING
#ASSERT `s 167N(6) the penalty for the offence` `on conviction on indictment` EQUALS NOTHING
#ASSERT `s 167N(7) the consequence follows from contravening subsection (2)` `s 167N(7) the offence provided for by section 167N` EQUALS JUST TRUE
#ASSERT `s 167N(7) the consequence follows from contravening subsection (2)` `s 167N(7) the invalidity of the person's acts as a director` EQUALS JUST FALSE
#ASSERT `s 167N(7) the consequence follows from contravening subsection (2)` `s 167N(7) any other consequence` EQUALS JUST FALSE
