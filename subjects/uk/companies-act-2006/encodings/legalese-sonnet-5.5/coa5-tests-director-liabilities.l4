IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa5-director-liabilities`

-- coa5-tests-director-liabilities.l4: tests for ss 232 to 239 (coa5-director-liabilities.l4). Expected values read from the text, not from the code.

§ `Tests: ss 232 and 233`

-- s 232(1): a provision purporting to exempt a director from liability for negligence, default, breach of duty or breach of trust is void
#ASSERT `s 232(1) the provision is void` TRUE EQUALS JUST TRUE
#ASSERT `s 232(1) the provision is void` FALSE EQUALS NOTHING

-- s 232(2): an indemnity by the company is void except as permitted by ss 233, 234, 235
#ASSERT `s 232(2) the provision is void` TRUE TRUE TRUE NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 232(2) the provision is void` TRUE TRUE TRUE (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 232(2) the provision is void` TRUE TRUE TRUE NOTHING (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 232(2) the provision is void` TRUE TRUE TRUE NOTHING NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 232(2) the provision is void` FALSE TRUE TRUE NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 232(2) the provision is void` TRUE FALSE TRUE NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 232(2) the provision is void` TRUE TRUE FALSE NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 232(2) the provision is void` TRUE TRUE TRUE (JUST FALSE) NOTHING NOTHING EQUALS NOTHING

#ASSERT `s 232(3) this section applies to the provision` `s 232(3) in the company's articles` EQUALS JUST TRUE
#ASSERT `s 232(3) this section applies to the provision` `s 232(3) in a contract with the company` EQUALS JUST TRUE
#ASSERT `s 232(3) this section applies to the provision` `s 232(3) otherwise` EQUALS JUST TRUE
#ASSERT `s 232(4) this section prevents the articles from making the provision` TRUE EQUALS JUST FALSE
#ASSERT `s 232(4) this section prevents the articles from making the provision` FALSE EQUALS NOTHING

#ASSERT `s 233 the insurance is permitted` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 233 the insurance is permitted` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 233 the insurance is permitted` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 233 the insurance is permitted` TRUE TRUE FALSE EQUALS NOTHING

