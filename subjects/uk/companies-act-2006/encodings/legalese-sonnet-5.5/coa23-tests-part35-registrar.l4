-- s 1059A(5): unless the context otherwise requires, the provisions apply to an overseas company as to a company
#ASSERT `s 1059A(5) the provision of this Part applies to the overseas company as it applies to a company as defined in section 1` FALSE EQUALS JUST TRUE
#ASSERT `s 1059A(5) the provision of this Part applies to the overseas company as it applies to a company as defined in section 1` TRUE EQUALS NOTHING

-- s 1060(1): a registrar for each of England and Wales, Scotland and Northern Ireland; (3) and (4): the registrar for the place
#ASSERT `s 1060(1) there is to continue to be a registrar of companies for the place` `England and Wales` EQUALS JUST TRUE
#ASSERT `s 1060(1) there is to continue to be a registrar of companies for the place` `Scotland` EQUALS JUST TRUE
#ASSERT `s 1060(1) there is to continue to be a registrar of companies for the place` `Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 1060(3) the registrar of companies, as the case may require, for the place` `England and Wales` EQUALS `s 1060(1)(a) the registrar of companies for England and Wales`
#ASSERT `s 1060(4) registration in the part of the United Kingdom is registration by` `England and Wales` EQUALS `s 1060(1)(a) the registrar of companies for England and Wales`
#ASSERT `s 1060(3) the registrar of companies, as the case may require, for the place` `Scotland` EQUALS `s 1060(1)(b) the registrar of companies for Scotland`
#ASSERT `s 1060(4) registration in the part of the United Kingdom is registration by` `Scotland` EQUALS `s 1060(1)(b) the registrar of companies for Scotland`
#ASSERT `s 1060(3) the registrar of companies, as the case may require, for the place` `Northern Ireland` EQUALS `s 1060(1)(c) the registrar of companies for Northern Ireland`
#ASSERT `s 1060(4) registration in the part of the United Kingdom is registration by` `Northern Ireland` EQUALS `s 1060(1)(c) the registrar of companies for Northern Ireland`

-- s 1061(1): the registrar must perform functions conferred by an enactment or directed by the Secretary of State; (3): references to the functions are to those two kinds
#ASSERT `s 1061(1) the registrar must perform the function` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1061(1) the registrar must perform the function` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1061(1) the registrar must perform the function` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1061(1) the registrar must perform the function` FALSE FALSE EQUALS NOTHING
#ASSERT `s 1061(3) the function is a function of the registrar for the purposes of the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1061(3) the function is a function of the registrar for the purposes of the Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1061(3) the function is a function of the registrar for the purposes of the Act` FALSE FALSE EQUALS JUST FALSE

-- s 1062: the registrar's official seal
#ASSERT `s 1062 the document bears the registrar's official seal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1062 the document bears the registrar's official seal` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1062 the document bears the registrar's official seal` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1062 the document bears the registrar's official seal` FALSE FALSE EQUALS NOTHING

-- s 1062A(1): the registrar must analyse information in possession as the registrar considers appropriate
#ASSERT `s 1062A(1) the registrar must carry out the analysis` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1062A(1) the registrar must carry out the analysis` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1062A(1) the registrar must carry out the analysis` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1062A(1) the registrar must carry out the analysis` FALSE FALSE EQUALS NOTHING

-- s 1063(2): fees may be charged for the three listed matters; the text says include, so another matter is not decided
#ASSERT `s 1063(2) fees may be charged for the matter` `s 1063(2)(a) the performance of a duty imposed on the registrar or the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 1063(2) fees may be charged for the matter` `s 1063(2)(b) the receipt of documents delivered to the registrar` EQUALS JUST TRUE
#ASSERT `s 1063(2) fees may be charged for the matter` `s 1063(2)(c) the inspection, or provision of copies, of documents kept by the registrar` EQUALS JUST TRUE
#ASSERT `s 1063(2) fees may be charged for the matter` `s 1063(2) another matter` EQUALS NOTHING

-- s 1063(5): the registrar may determine the fee where regulations provide none
#ASSERT `s 1063(5) the registrar may determine from time to time what fees, if any, are chargeable` FALSE EQUALS JUST TRUE
#ASSERT `s 1063(5) the registrar may determine from time to time what fees, if any, are chargeable` TRUE EQUALS NOTHING

-- s 1063(6): fees received by the registrar are to be paid into the Consolidated Fund
#ASSERT `s 1063(6) the fee received by the registrar has been dealt with as the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1063(6) the fee received by the registrar has been dealt with as the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1063(6) the fee received by the registrar has been dealt with as the section requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1063(6) the fee received by the registrar has been dealt with as the section requires` FALSE FALSE EQUALS NOTHING

-- s 1064(1): the registrar must cause notice of the issue of any certificate to be published, in the Gazette or in accordance with section 1116
#ASSERT `s 1064(1) the registrar must cause notice of the issue of the certificate to be published` TRUE EQUALS JUST TRUE
#ASSERT `s 1064(1) the registrar must cause notice of the issue of the certificate to be published` FALSE EQUALS NOTHING
#ASSERT `s 1064(1) the registrar has complied by publishing the notice` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 1064(1) the registrar has complied by publishing the notice` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 1064(1) the registrar has complied by publishing the notice` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1064(1) the registrar has complied by publishing the notice` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1064(1) the registrar has complied by publishing the notice` FALSE NOTHING EQUALS NOTHING

-- s 1064(2): the notice must state the name, the registered number and the date of issue
#ASSERT `s 1064(2) the notice states what it must state` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1064(2) the notice states what it must state` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1064(2) the notice states what it must state` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1064(2) the notice states what it must state` TRUE TRUE FALSE EQUALS JUST FALSE

-- s 1064(3): the section applies to certificates on formation and under section 80, section 88 and Part 7; another certificate is not decided
#ASSERT `s 1064(3) section 1064 applies to the certificate of incorporation` `s 1064(3) the certificate issued on a company's formation` EQUALS JUST TRUE
#ASSERT `s 1064(3) section 1064 applies to the certificate of incorporation` `s 1064(3)(a) a certificate issued under section 80 (change of name)` EQUALS JUST TRUE
#ASSERT `s 1064(3) section 1064 applies to the certificate of incorporation` `s 1064(3)(b) a certificate issued under section 88 (Welsh companies)` EQUALS JUST TRUE
#ASSERT `s 1064(3) section 1064 applies to the certificate of incorporation` `s 1064(3)(c) a certificate issued under any provision of Part 7 (re-registration)` EQUALS JUST TRUE
#ASSERT `s 1064(3) section 1064 applies to the certificate of incorporation` `s 1064(3) another certificate` EQUALS NOTHING

-- s 1065: any person may require a copy of a certificate of incorporation signed by the registrar or authenticated by the registrar's seal
#ASSERT `s 1065 the person may require the registrar to provide a copy of the certificate of incorporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1065 the person may require the registrar to provide a copy of the certificate of incorporation` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1065 the person may require the registrar to provide a copy of the certificate of incorporation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1065 the person may require the registrar to provide a copy of the certificate of incorporation` FALSE FALSE EQUALS NOTHING

-- s 1066(1): the registrar shall allocate to every company a number; whether the body is a company is section 1(1) (an input)
