#ASSERT `s 1066(2) the registered number is in the form the section requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1066(2) the registered number is in the form the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1066(2) the registered number is in the form the section requires` FALSE FALSE EQUALS JUST FALSE

-- s 1066(3): the registrar may change existing numbers on adopting a new form, as appear necessary
