#ASSERT `s 1067A(3) the individual is one of the officers of the corporate officer for the purposes of row 2` (LIST (`s 1067A(3) level of officers` OF FALSE, FALSE), (`s 1067A(3) level of officers` OF TRUE, FALSE)) EQUALS JUST FALSE
#ASSERT `s 1067A(3) the individual is one of the officers of the corporate officer for the purposes of row 2` (LIST (`s 1067A(3) level of officers` OF FALSE, FALSE), (`s 1067A(3) level of officers` OF FALSE, FALSE), (`s 1067A(3) level of officers` OF TRUE, TRUE)) EQUALS JUST TRUE
#ASSERT `s 1067A(3) the individual is one of the officers of the corporate officer for the purposes of row 2` (LIST (`s 1067A(3) level of officers` OF TRUE, FALSE), (`s 1067A(3) level of officers` OF TRUE, TRUE)) EQUALS JUST FALSE
#ASSERT `s 1067A(3) the individual is one of the officers of the corporate officer for the purposes of row 2` (LIST (`s 1067A(3) level of officers` OF FALSE, FALSE)) EQUALS NOTHING
#ASSERT `s 1067A(3) the individual is one of the officers of the corporate officer for the purposes of row 2` EMPTY EQUALS NOTHING

-- s 1067A(8): "corporate officer" means an officer that is not an individual
#ASSERT `s 1067A(8) the officer is a corporate officer` FALSE EQUALS JUST TRUE
#ASSERT `s 1067A(8) the officer is a corporate officer` TRUE EQUALS JUST FALSE

-- s 1067B(1): an individual who is a disqualified person may not deliver documents; the section bars no other individual
#ASSERT `s 1067B(1) the individual is barred from delivering documents to the registrar on their own behalf or on behalf of another` TRUE EQUALS JUST TRUE
#ASSERT `s 1067B(1) the individual is barred from delivering documents to the registrar on their own behalf or on behalf of another` FALSE EQUALS NOTHING

-- s 1067B(2): an individual may not deliver a document on behalf of a disqualified person unless an authorised corporate service provider or an officer or employee of one
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` FALSE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 1067B(2) the individual is barred from delivering the document to the registrar on behalf of the disqualified person` TRUE NOTHING TRUE EQUALS JUST FALSE

-- s 1067B(3) to (5): the document must be accompanied by the first statement and by one of the three second statements
#ASSERT `s 1067B(3) the document is accompanied by the two statements` TRUE `s 1067B(5)(a) a statement that the individual is delivering the document on their own behalf` EQUALS JUST TRUE
#ASSERT `s 1067B(3) the document is accompanied by the two statements` TRUE `s 1067B(5)(b) a statement that the individual is delivering the document on behalf of another person who is not a disqualified person` EQUALS JUST TRUE
#ASSERT `s 1067B(3) the document is accompanied by the two statements` TRUE `s 1067B(5)(c) a statement that the individual is delivering the document on behalf of a disqualified person` EQUALS JUST TRUE
#ASSERT `s 1067B(3) the document is accompanied by the two statements` TRUE `s 1067B(5) no second statement` EQUALS JUST FALSE
#ASSERT `s 1067B(3) the document is accompanied by the two statements` FALSE `s 1067B(5)(a) a statement that the individual is delivering the document on their own behalf` EQUALS JUST FALSE
#ASSERT `s 1067B(3) the document is accompanied by the two statements` FALSE `s 1067B(5) no second statement` EQUALS JUST FALSE

-- s 1067B(6): "disqualified person" is a person disqualified under the directors disqualification legislation (section 159A(2), an input)
#ASSERT `s 1067B(6) the person is a disqualified person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1067B(6) the person is a disqualified person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 1067B(6) the person is a disqualified person` NOTHING EQUALS NOTHING

-- s 1068: the registrar may impose requirements on each listed head; another requirement is not decided (examples, not a closed list)
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(2)(a) that the contents of the document be in a standard form` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(2)(b) requirements for the purpose of enabling the document to be scanned or copied` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(3)(a) that the document be authenticated by a particular person or a person of a particular description` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(3)(b) the means of authentication` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(3)(c) that the document contain or be accompanied by the name or registered number (or both) of the company (or other body) to which it relates` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(4)(a) the physical form of the document` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(4)(b) the means to be used for delivering the document` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(4)(c) the address to which the document is to be sent` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068(4)(d) the hardware and software to be used, and technical specifications, for a document delivered by electronic means` EQUALS JUST TRUE
#ASSERT `s 1068 the registrar may impose the requirement` `s 1068 another requirement` EQUALS NOTHING

-- s 1068(4A): requirements under (4)(b) to (d) must be imposed by registrar's rules; the other heads are not decided
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(4)(b) the means to be used for delivering the document` EQUALS JUST TRUE
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(4)(c) the address to which the document is to be sent` EQUALS JUST TRUE
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(4)(d) the hardware and software to be used, and technical specifications, for a document delivered by electronic means` EQUALS JUST TRUE
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(2)(a) that the contents of the document be in a standard form` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(2)(b) requirements for the purpose of enabling the document to be scanned or copied` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(3)(a) that the document be authenticated by a particular person or a person of a particular description` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(3)(b) the means of authentication` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(3)(c) that the document contain or be accompanied by the name or registered number (or both) of the company (or other body) to which it relates` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068(4)(a) the physical form of the document` EQUALS NOTHING
#ASSERT `s 1068(4A) the requirement must be imposed by means of registrar's rules` `s 1068 another requirement` EQUALS NOTHING

-- s 1068(7): requirements must not be inconsistent with those imposed by an enactment
#ASSERT `s 1068(7) the registrar may impose the requirement consistently with the enactments` TRUE EQUALS JUST FALSE
#ASSERT `s 1068(7) the registrar may impose the requirement consistently with the enactments` FALSE EQUALS NOTHING

-- s 1068A(2): provision under subsection (1)(a) may not require a document to be delivered earlier than otherwise required
#ASSERT `s 1068A(2) the registrar's rules may make the provision` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 1068A(2) the registrar's rules may make the provision` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1068A(2) the registrar's rules may make the provision` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1068A(2) the registrar's rules may make the provision` FALSE FALSE EQUALS NOTHING

-- s 1070(1) and (2): the registrar may agree with a company that documents will be delivered by electronic means; the agreement may relate to all or any description of documents
#ASSERT `s 1070(1) the registrar may make the agreement for delivery by electronic means` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1070(1) the registrar may make the agreement for delivery by electronic means` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1070(1) the registrar may make the agreement for delivery by electronic means` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1070(2) the agreement may relate to the documents` TRUE EQUALS JUST TRUE
#ASSERT `s 1070(2) the agreement may relate to the documents` FALSE EQUALS NOTHING

-- s 1070(3): documents covered by an agreement in force must be delivered in accordance with it
#ASSERT `s 1070(3) the document is delivered as the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1070(3) the document is delivered as the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1070(3) the document is delivered as the section requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 1070(3) the document is delivered as the section requires` FALSE FALSE EQUALS NOTHING

-- s 1071(1): a document is not delivered until it is received (the bar is lifted once received); the day of receipt is an input
#ASSERT `s 1071(1) the document cannot yet count as delivered to the registrar` FALSE EQUALS JUST TRUE
#ASSERT `s 1071(1) the document cannot yet count as delivered to the registrar` TRUE EQUALS JUST FALSE
#ASSERT `s 1071 the day the registrar received the document` TRUE (Date 3 4 2025) EQUALS (JUST (Date 3 4 2025))
#ASSERT `s 1071 the day the registrar received the document` FALSE (Date 3 4 2025) EQUALS NOTHING

-- Regulative rules. A #TRACE cannot be asserted on this binary: the outcome expected is written on the -- EXPECT line above each, and work/check-traces.py compares it with the binary's output. RESIDUAL means the obligation is still standing (no deadline is stated in the text, so none is invented).
-- EXPECT: FULFILLED
#TRACE `s 1062A(1) the registrar's duty to analyse information` AT 0 WITH
    PARTY Registrar DOES `Action of a party` OF Registrar, Registrar, "analyse information within the registrar's possession for the purposes of preventing or detecting crime" AT 3
-- EXPECT: RESIDUAL
#TRACE `s 1062A(1) the registrar's duty to analyse information` AT 0 WITH
    (WAITUNTIL 30)
-- EXPECT: FULFILLED
