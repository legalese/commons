-- s 562(4): the offer must state a period; it shall not be withdrawn before the end of the period (last day 31 March 2026).
#ASSERT `s 562(4) the offer meets the requirement to state a period` TRUE EQUALS JUST TRUE
#ASSERT `s 562(4) the offer meets the requirement to state a period` FALSE EQUALS JUST FALSE
#ASSERT `s 562(4) the offer may be withdrawn` (Date 31 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 562(4) the offer may be withdrawn` (Date 31 3 2026) (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 562(4) the offer may be withdrawn` (Date 31 3 2026) (Date 1 4 2026) EQUALS NOTHING
-- s 562(5): at least 14 days beginning with the date the offer is sent, supplied or published (1 March 2026: the 14th day is 14 March).
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(a) in hard copy form` (Date 1 3 2026) (Date 14 3 2026) EQUALS JUST TRUE
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(a) in hard copy form` (Date 1 3 2026) (Date 13 3 2026) EQUALS JUST FALSE
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(b) in electronic form` (Date 1 3 2026) (Date 14 3 2026) EQUALS JUST TRUE
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(b) in electronic form` (Date 1 3 2026) (Date 13 3 2026) EQUALS JUST FALSE
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(c) by publication in the Gazette` (Date 1 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 562(5) the period meets the requirement of at least 14 days` `s 562(5)(c) by publication in the Gazette` (Date 1 3 2026) (Date 13 3 2026) EQUALS JUST FALSE

-- s 563(2): the company, and every officer who knowingly authorised or permitted the contravention, are liable to compensate.
#ASSERT `s 563(2) the company is liable to compensate the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 563(2) the company is liable to compensate the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 563(2) the company is liable to compensate the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 563(2) the officer is liable, jointly and severally with the company, to compensate the person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 563(2) the officer is liable, jointly and severally with the company, to compensate the person` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 563(2) the officer is liable, jointly and severally with the company, to compensate the person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 563(2) the officer is liable, jointly and severally with the company, to compensate the person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 563(2) the amount for which the company and the officers are jointly and severally liable` 250 EQUALS 250
-- s 563(3): no proceedings after two years from the delivery of the return (10 March 2026: 10 March 2028), or from the grant of securities other than shares.
#ASSERT `s 563(3) proceedings to recover the loss may be commenced` FALSE (Date 10 3 2026) (Date 1 6 2026) (Date 10 3 2028) EQUALS NOTHING
#ASSERT `s 563(3) proceedings to recover the loss may be commenced` FALSE (Date 10 3 2026) (Date 1 6 2026) (Date 11 3 2028) EQUALS JUST FALSE
#ASSERT `s 563(3) proceedings to recover the loss may be commenced` TRUE (Date 10 3 2026) (Date 1 6 2026) (Date 20 3 2028) EQUALS NOTHING
#ASSERT `s 563(3) proceedings to recover the loss may be commenced` TRUE (Date 10 3 2026) (Date 1 6 2026) (Date 1 6 2028) EQUALS NOTHING
#ASSERT `s 563(3) proceedings to recover the loss may be commenced` TRUE (Date 10 3 2026) (Date 1 6 2026) (Date 2 6 2028) EQUALS JUST FALSE

