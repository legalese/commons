#ASSERT `s 566 section 561 does not apply to the allotment under an employees' share scheme` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 566 section 561 does not apply to the allotment under an employees' share scheme` (JUST TRUE) FALSE EQUALS NOTHING
