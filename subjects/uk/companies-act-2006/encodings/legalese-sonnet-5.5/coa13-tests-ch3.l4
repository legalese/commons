#ASSERT `s 572(2) the person commits an offence` TRUE TRUE FALSE EQUALS NOTHING
-- s 572(3): on indictment imprisonment not exceeding two years or a fine (or both); on summary conviction twelve months (England and Wales) or six months (Scotland, Northern Ireland) or a fine not exceeding the statutory maximum (or both).
#ASSERT `s 572(3)(a) penalty on conviction on indictment`'s `imprisonment not exceeding` EQUALS JUST (Period WITH `number of units` IS 2, unit IS Years)
#ASSERT `s 572(3)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 572(3)(a) penalty on conviction on indictment`'s `imprisonment and fine together` EQUALS TRUE
#ASSERT `s 572(3)(b)(i) penalty on summary conviction in England and Wales`'s `imprisonment not exceeding` EQUALS JUST (Period WITH `number of units` IS 12, unit IS Months)
#ASSERT `s 572(3)(b)(i) penalty on summary conviction in England and Wales`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 572(3)(b)(i) penalty on summary conviction in England and Wales`'s `how convicted` EQUALS `on summary conviction in England and Wales`
#ASSERT `s 572(3)(b)(ii) penalty on summary conviction in Scotland`'s `imprisonment not exceeding` EQUALS JUST (Period WITH `number of units` IS 6, unit IS Months)
#ASSERT `s 572(3)(b)(ii) penalty on summary conviction in Scotland`'s `how convicted` EQUALS `on summary conviction in Scotland`
#ASSERT `s 572(3)(b)(ii) penalty on summary conviction in Northern Ireland`'s `imprisonment not exceeding` EQUALS JUST (Period WITH `number of units` IS 6, unit IS Months)
#ASSERT `s 572(3)(b)(ii) penalty on summary conviction in Northern Ireland`'s `how convicted` EQUALS `on summary conviction in Northern Ireland`
#ASSERT (count `s 572(3) the penalties for an offence under section 572`) EQUALS 4

