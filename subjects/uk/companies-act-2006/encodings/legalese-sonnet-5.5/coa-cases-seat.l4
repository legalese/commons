#ASSERT `Under section 60(1), is my private company exempt from using limited` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 60(1), is my private company exempt from using limited` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- a public company
#ASSERT `Under section 60(2), may the registrar refuse to register my private limited company by a name without limited` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 60(2), may the registrar refuse to register my private limited company by a name without limited` TRUE TRUE TRUE EQUALS JUST FALSE -- a statement of exemption was delivered
#ASSERT `Under section 60(2), may the registrar refuse to register my private limited company by a name without limited` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 63(1), may my exempt company amend its articles as proposed` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 63(1), may my exempt company amend its articles as proposed` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 63(2), could I commit an offence if my company amends its articles contrary to section 63(1)` TRUE Company FALSE EQUALS JUST TRUE -- the company
#ASSERT `Under section 63(2), could I commit an offence if my company amends its articles contrary to section 63(1)` TRUE Director TRUE EQUALS JUST TRUE -- a director in default
#ASSERT `Under section 63(2), could I commit an offence if my company amends its articles contrary to section 63(1)` TRUE Director FALSE EQUALS NOTHING -- a director not in default
#ASSERT `Under section 63(2), could I commit an offence if my company amends its articles contrary to section 63(1)` TRUE `Shadow director` TRUE EQUALS JUST TRUE -- a shadow director is treated as an officer
#ASSERT `Under section 63(2), could I commit an offence if my company amends its articles contrary to section 63(1)` FALSE Company FALSE EQUALS JUST FALSE -- section 63(1) was not contravened
#ASSERT `Under section 63(3), what is the penalty if my company is convicted of the offence`  EQUALS "On summary conviction: a fine not exceeding 1 of level 5 on the standard scale; for continued contravention, a daily default fine: not covered by the text" -- fork 1: two wordings of the daily default fine
#ASSERT `Under section 63(3), what is the penalty if my company is convicted of the offence` EQUALS "On summary conviction: a fine not exceeding 1 of level 5 on the standard scale; for continued contravention, a daily default fine: not covered by the text"
#ASSERT `Under section 63(3), what is the daily default fine in pounds on the first wording` 50000 EQUALS 5000 -- one-tenth of a hypothetical level 5 of 50,000
#ASSERT `Under section 63(3), what is the daily default fine in pounds on the second wording` 2500 EQUALS 500 -- one-tenth of the greater of 5,000 and a hypothetical level 4 of 2,500
#ASSERT `Under section 64(1), may the Secretary of State direct my company to change its name` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 64(1), may the Secretary of State direct my company to change its name` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING -- not a company within section 61 or 62 -- RECONCILED 2026-11-12: was #ASSERT `Under section 64(1), may the Secretary of State direct my company to change its name` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 10)
#ASSERT `Under section 64(1), may the Secretary of State direct my company to change its name` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- RECONCILED 2026-11-12: was #ASSERT `Under section 64(1), may the Secretary of State direct my company to change its name` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE; the function is named for a power, the "if it appears" gate failed, and the text limits the grant in its own words without saying no, so NOTHING, not JUST FALSE (fork 10)
