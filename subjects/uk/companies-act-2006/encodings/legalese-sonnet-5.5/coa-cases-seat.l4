-- exactly 500 million is not "more than"
#ASSERT (`Under section 414CA(2A), is my company a high turnover company for the financial year?` FALSE 500000000 0 1) EQUALS JUST FALSE
-- a parent company whose group had 400 million
#ASSERT (`Under section 414CA(2A), is my company a high turnover company for the financial year?` TRUE 0 400000000 1) EQUALS JUST FALSE
-- the average of the monthly totals
#ASSERT (`Under section 414CA(5), what is my company's number of employees for the financial year?` (LIST 10, 20, 30)) EQUALS JUST 20
-- no months
#ASSERT (`Under section 414CA(5), what is my company's number of employees for the financial year?` EMPTY) EQUALS NOTHING
-- Section 414CA(1B): the routes in and the ways out. Arguments: traded, bank, insurer, market activity, AIM, parent, own turnover, group turnover, year proportion,
-- small regime, medium-sized, employees by month, group employees, subsidiary, included in group report, then the three requirements of subsection (8).
-- a banking company with 600 employees: route (1), no exclusion
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE TRUE FALSE FALSE FALSE FALSE 100000000 0 1 FALSE FALSE (LIST 600, 600, 600) 0 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- a banking company with 400 employees: excluded by subsection (4)
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE TRUE FALSE FALSE FALSE FALSE 100000000 0 1 FALSE FALSE (LIST 400, 400, 400) 0 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- subject to the small companies regime: excluded by subsection (3)
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE TRUE FALSE FALSE FALSE FALSE 100000000 0 1 TRUE FALSE (LIST 600, 600, 600) 0 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- a subsidiary included in a qualifying group strategic report: excluded by subsection (7)
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE TRUE FALSE FALSE FALSE FALSE 100000000 0 1 FALSE FALSE (LIST 600, 600, 600) 0 TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- no route in
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE FALSE FALSE FALSE FALSE FALSE 100000000 0 1 FALSE FALSE (LIST 600, 600, 600) 0 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- a high turnover company with 600 employees: route (1A)
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE FALSE FALSE FALSE FALSE FALSE 600000000 0 1 FALSE FALSE (LIST 600, 600, 600) 0 FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- no monthly figures, so the number of employees is not decided
#ASSERT (`Under section 414CA(1B), does the requirement to include a non-financial and sustainability information statement apply to my company?` FALSE TRUE FALSE FALSE FALSE FALSE 100000000 0 1 FALSE FALSE EMPTY 0 FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
