-- ---- Directors' report -------------------------------------------------------------------------------------------------------------
-- a micro-entity is excused
#ASSERT (`Under section 415(1A), is my company excused from preparing a directors' report because it qualifies as a micro-entity?` TRUE) EQUALS JUST TRUE
-- not a micro-entity
#ASSERT (`Under section 415(1A), is my company excused from preparing a directors' report because it qualifies as a micro-entity?` FALSE) EQUALS JUST FALSE
-- a directors' report was prepared
#ASSERT (`Under section 415(1), have the directors prepared the directors' report for the financial year?` TRUE) EQUALS JUST TRUE
-- none was prepared
