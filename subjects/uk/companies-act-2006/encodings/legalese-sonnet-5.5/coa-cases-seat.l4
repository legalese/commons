-- ---- Laying the accounts before a public company's general meeting -------------------------------------------------------------------------
-- a public company whose directors laid the copies
#ASSERT (`Under section 437(1), have the directors of my public company laid the annual accounts and reports before the company in general meeting?` TRUE TRUE) EQUALS JUST TRUE
-- a public company whose directors did not
#ASSERT (`Under section 437(1), have the directors of my public company laid the annual accounts and reports before the company in general meeting?` TRUE FALSE) EQUALS JUST FALSE
-- not a public company
#ASSERT (`Under section 437(1), have the directors of my public company laid the annual accounts and reports before the company in general meeting?` FALSE TRUE) EQUALS NOTHING
-- laid on the last day
#ASSERT (`Under section 437(2), did the directors lay the copies before the end of the period for filing?` (Date 30 6 2028) (Date 30 6 2028)) EQUALS JUST TRUE
-- laid the day after
#ASSERT (`Under section 437(2), did the directors lay the copies before the end of the period for filing?` (Date 1 7 2028) (Date 30 6 2028)) EQUALS JUST FALSE
-- a general meeting at which the accounts and reports are laid
#ASSERT (`Under section 437(3), is this meeting an accounts meeting of my public company?` TRUE TRUE) EQUALS JUST TRUE
-- not such a meeting
#ASSERT (`Under section 437(3), is this meeting an accounts meeting of my public company?` TRUE FALSE) EQUALS JUST FALSE
-- not a public company
#ASSERT (`Under section 437(3), is this meeting an accounts meeting of my public company?` FALSE TRUE) EQUALS NOTHING
-- not laid in time; a director immediately before the end of the period
#ASSERT (`Under section 438(1), do I commit an offence as a director because the accounts and reports were not laid in time?` TRUE TRUE) EQUALS JUST TRUE
-- not a director then
#ASSERT (`Under section 438(1), do I commit an offence as a director because the accounts and reports were not laid in time?` TRUE FALSE) EQUALS NOTHING
-- laid in time
#ASSERT (`Under section 438(1), do I commit an offence as a director because the accounts and reports were not laid in time?` FALSE TRUE) EQUALS JUST FALSE
-- charged, and proves all reasonable steps
#ASSERT (`Under section 438(2), does the Act give me a defence on these facts?` TRUE TRUE) EQUALS JUST TRUE
-- charged, but cannot prove them: this section gives no defence on these facts
#ASSERT (`Under section 438(2), does the Act give me a defence on these facts?` TRUE FALSE) EQUALS JUST FALSE
-- not charged
#ASSERT (`Under section 438(2), does the Act give me a defence on these facts?` FALSE TRUE) EQUALS NOTHING
-- "It is not a defence to prove that the documents ... were not in fact prepared"
#ASSERT (`Under section 438(3), is it a defence that the documents were not in fact prepared as the Part requires?` TRUE) EQUALS JUST FALSE
-- the subsection says nothing of other proofs
#ASSERT (`Under section 438(3), is it a defence that the documents were not in fact prepared as the Part requires?` FALSE) EQUALS NOTHING
-- a fine not exceeding level 5 (taken as 5,000 pounds)
#ASSERT (`Under section 438(4), what is the most I can be fined on summary conviction for that offence, in pounds?` 5000) EQUALS JUST 5000
-- one-tenth of level 5
#ASSERT (`Under section 438(4), what is the most the daily default fine for continued contravention can be, in pounds, on a version of the text?` "first" 2500 5000) EQUALS JUST 500
-- one-tenth of the greater of 5,000 pounds and level 4 (2,500): 5,000
#ASSERT (`Under section 438(4), what is the most the daily default fine for continued contravention can be, in pounds, on a version of the text?` "second" 2500 5000) EQUALS JUST 500
-- one-tenth of level 4 when level 4 is the greater
#ASSERT (`Under section 438(4), what is the most the daily default fine for continued contravention can be, in pounds, on a version of the text?` "second" 10000 20000) EQUALS JUST 1000
-- not one of the two versions
#ASSERT (`Under section 438(4), what is the most the daily default fine for continued contravention can be, in pounds, on a version of the text?` "third" 1 1) EQUALS NOTHING

