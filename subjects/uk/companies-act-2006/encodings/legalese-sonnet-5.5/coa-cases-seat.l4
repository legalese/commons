#ASSERT `Under section 42(4), is a charity company's affirmation of a transaction with a director effective` `England and Wales` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 43(1), may our contract be made this way` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 43(1), may our contract be made this way` TRUE FALSE FALSE EQUALS NOTHING
