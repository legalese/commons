#ASSERT (`Under section 422(1), has the directors' remuneration report been approved and signed as the section requires?` TRUE TRUE FALSE) EQUALS JUST TRUE
-- unsigned
#ASSERT (`Under section 422(1), has the directors' remuneration report been approved and signed as the section requires?` TRUE FALSE FALSE) EQUALS JUST FALSE
-- a director who knew and took no reasonable steps
#ASSERT (`Under section 422(2), do I commit an offence as a director because a directors' remuneration report that does not comply was approved?` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- the approved report complies
