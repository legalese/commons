-- ---- Circulating the annual accounts and reports ----------------------------------------------------------------------------------------
-- a member
#ASSERT (`Under section 423(1), must my company send me a copy of its annual accounts and reports for the financial year?` TRUE FALSE FALSE) EQUALS JUST TRUE
-- a debenture holder
#ASSERT (`Under section 423(1), must my company send me a copy of its annual accounts and reports for the financial year?` FALSE TRUE FALSE) EQUALS JUST TRUE
-- none of the three: the text does not say the company need not send a copy
#ASSERT (`Under section 423(1), must my company send me a copy of its annual accounts and reports for the financial year?` FALSE FALSE FALSE) EQUALS NOTHING
-- no address notified: no current address, so copies need not be sent
#ASSERT (`Under section 423(2), does my company not need to send me a copy because it has no current address for me?` FALSE TRUE) EQUALS JUST TRUE
-- a current address: the subsection is silent
#ASSERT (`Under section 423(2), does my company not need to send me a copy because it has no current address for me?` TRUE TRUE) EQUALS NOTHING
-- an address notified and no reason to believe the documents will not reach me
#ASSERT (`Under section 423(3), does my company have a current address for me?` TRUE TRUE) EQUALS JUST TRUE
-- the company has reason to believe they will not reach me
#ASSERT (`Under section 423(3), does my company have a current address for me?` TRUE FALSE) EQUALS JUST FALSE
-- no share capital and not entitled to notices of general meetings
#ASSERT (`Under section 423(4), does my company, which has no share capital, not need to send me a copy because I am not entitled to notices of general meetings?` TRUE FALSE) EQUALS JUST TRUE
-- entitled to notices of general meetings
#ASSERT (`Under section 423(4), does my company, which has no share capital, not need to send me a copy because I am not entitled to notices of general meetings?` TRUE TRUE) EQUALS NOTHING
-- Seat question about time: arguments are public company, the day copies were sent, the end of the filing period, delivered to the registrar, the day delivered, the meeting date, all members agreed.
-- a private company sending out on the last day of the filing period
#ASSERT (`Under section 424, did my company send out the copies of the accounts and reports within the time allowed?` FALSE (Date 30 9 2027) (Date 30 9 2027) FALSE (Date 1 1 2027) (Date 22 12 2027) FALSE) EQUALS JUST TRUE
-- a private company a day late
#ASSERT (`Under section 424, did my company send out the copies of the accounts and reports within the time allowed?` FALSE (Date 1 10 2027) (Date 30 9 2027) FALSE (Date 1 1 2027) (Date 22 12 2027) FALSE) EQUALS JUST FALSE
-- a public company sending out exactly 21 days before the meeting
#ASSERT (`Under section 424, did my company send out the copies of the accounts and reports within the time allowed?` TRUE (Date 1 12 2027) (Date 30 9 2027) FALSE (Date 1 1 2027) (Date 22 12 2027) FALSE) EQUALS JUST TRUE
-- a public company sending out 20 days before the meeting, no agreement
#ASSERT (`Under section 424, did my company send out the copies of the accounts and reports within the time allowed?` TRUE (Date 2 12 2027) (Date 30 9 2027) FALSE (Date 1 1 2027) (Date 22 12 2027) FALSE) EQUALS JUST FALSE
-- a public company that sent late, all members agreed
#ASSERT (`Under section 424, did my company send out the copies of the accounts and reports within the time allowed?` TRUE (Date 2 12 2027) (Date 30 9 2027) FALSE (Date 1 1 2027) (Date 22 12 2027) TRUE) EQUALS JUST TRUE
-- 21 days before the accounts meeting
#ASSERT (`Under section 424(3), by what day must my public company send out the copies of the accounts and reports?` (Date 22 12 2027)) EQUALS Date 1 12 2027
