#ASSERT `Under section 41(3), how much must I account to the company for, in pounds` TRUE FALSE FALSE TRUE 500 EQUALS JUST 0
-- I am a director and a party within (2)(b): liable to indemnify the company for its loss
#ASSERT `Under section 41(3), how much must I indemnify the company for, in pounds` TRUE FALSE TRUE FALSE 300 EQUALS JUST 300
#ASSERT `Under section 41(4), has the transaction ceased to be voidable` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 41(4), has the transaction ceased to be voidable` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
