#ASSERT `Under section 61(3), does my company meet the first condition for the exemption` FALSE EQUALS JUST FALSE
#ASSERT `Under section 61(4), does my company meet the second condition for the exemption` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 61(4), does my company meet the second condition for the exemption` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
