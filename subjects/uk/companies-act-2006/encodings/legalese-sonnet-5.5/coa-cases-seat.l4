#ASSERT `Under section 113(9), is the company a traded company` FALSE TRUE EQUALS JUST TRUE
-- Nia: shares are not traded on any market
#ASSERT `Under section 113(9), is the company a traded company` FALSE FALSE EQUALS JUST FALSE
