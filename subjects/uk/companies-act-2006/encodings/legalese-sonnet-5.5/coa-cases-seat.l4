#ASSERT `Under section 58, does my public company's name end as the section requires` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- a Welsh ending, but not a Welsh company
#ASSERT `Under section 58, does my public company's name end as the section requires` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING -- a private company: section 58 does not apply
#ASSERT `Under section 59(1), must my private company's name end with limited or ltd.` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 59(1), must my private company's name end with limited or ltd.` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- exempt under section 60
#ASSERT `Under section 59(1), must my private company's name end with limited or ltd.` TRUE FALSE FALSE FALSE EQUALS NOTHING -- a public company
#ASSERT `Under section 59, does my private company's name end as the section requires` TRUE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
