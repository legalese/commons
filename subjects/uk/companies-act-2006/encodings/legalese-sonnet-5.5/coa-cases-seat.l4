#ASSERT `Under section 364, is this payment or gift a political donation` FALSE FALSE FALSE EQUALS JUST FALSE
-- A company pays for advertising that supports a registered party, or for activities meant to influence a referendum.
#ASSERT `Under section 365, is this spending political expenditure` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 365, is this spending political expenditure` TRUE FALSE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 365, is this spending political expenditure` TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 365, is this spending political expenditure` FALSE TRUE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

