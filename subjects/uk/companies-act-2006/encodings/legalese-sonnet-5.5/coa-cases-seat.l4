-- took all reasonable steps
#ASSERT (`Under section 415(4), do I commit an offence as a director because no directors' report was prepared?` TRUE TRUE FALSE) EQUALS NOTHING
-- a report was prepared
#ASSERT (`Under section 415(4), do I commit an offence as a director because no directors' report was prepared?` FALSE TRUE TRUE) EQUALS JUST FALSE
-- a fine not exceeding the statutory maximum
#ASSERT (`Under section 415(5), what is the most I can be fined on summary conviction for that offence, in pounds?` 5000) EQUALS JUST 5000
-- entitled to the small companies regime
