#ASSERT `Under section 113(3)(a)(ii), must the register show the class of my shares` TRUE FALSE EQUALS JUST FALSE
-- Ivo: share capital
#ASSERT `Under section 113(3)(b), must the register show the amount paid on my shares` TRUE EQUALS JUST TRUE
