-- ====================================================================================================
-- cases-seat questions from part coa2 (merged by the lead on 2026-11-12; unchanged text follows)
-- ====================================================================================================
-- coa2-cases-seat.l4: cases for the seat layer coa2-seat.l4, from the position of an individual who is, or is about to
-- become, a director, company secretary or member of a company, or who deals with one.  Every expected value is written
-- from the text of the section the question names, before running.  JUST TRUE = the Act says yes; JUST FALSE = the Act
-- says no in its own words; NOTHING = the Act does not decide on the stated facts.
-- Amounts in pounds are hypothetical inputs: the Act does not state what a level on the standard scale is.

-- ---- Chapter 1: names that cannot be registered ----
#ASSERT `Under section 53, may my company be registered by this name` TRUE FALSE EQUALS JUST FALSE -- a director proposes a name the Secretary of State thinks offensive or unlawful in use
#ASSERT `Under section 53, may my company be registered by this name` FALSE FALSE EQUALS NOTHING -- no such opinion: s 53 says nothing
#ASSERT `Under section 53A, may my company be registered by this name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 53A, may my company be registered by this name` FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 54(2), is this body a local authority` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- a council under the Local Government Act 1972
#ASSERT `Under section 54(2), is this body a local authority` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 54(2), is this person or body a public authority` TRUE EQUALS JUST TRUE
#ASSERT `Under section 54(2), is this person or body a public authority` FALSE EQUALS NOTHING -- "includes": the list is not closed
#ASSERT `Under section 54(1), do we need the approval of the Secretary of State for a name suggesting a connection with government` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- a name suggesting a link with Her Majesty's Government
#ASSERT `Under section 54(1), do we need the approval of the Secretary of State for a name suggesting a connection with government` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- a local authority
#ASSERT `Under section 54(1), do we need the approval of the Secretary of State for a name suggesting a connection with government` FALSE TRUE FALSE FALSE EQUALS NOTHING -- no impression of a connection
#ASSERT `Under section 55, do we need the approval of the Secretary of State for a name including a sensitive word` TRUE EQUALS JUST TRUE
#ASSERT `Under section 55, do we need the approval of the Secretary of State for a name including a sensitive word` FALSE EQUALS NOTHING
#ASSERT `Under section 56(2), must I ask a government department for its view on the name` TRUE EQUALS JUST TRUE
#ASSERT `Under section 56(2), must I ask a government department for its view on the name` FALSE EQUALS JUST FALSE
#ASSERT `Under section 56(3)(a), must the application to register include a statement that a request was made` TRUE EQUALS JUST TRUE
#ASSERT `Under section 56(3)(a), must the application to register include a statement that a request was made` FALSE EQUALS JUST FALSE
#ASSERT `Under section 56(3)(b), must the application to register be accompanied by a copy of the response` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 56(3)(b), must the application to register be accompanied by a copy of the response` TRUE FALSE EQUALS JUST FALSE -- no response received: nothing to attach
#ASSERT `Under section 56(4)(a), must the notice of a change of name be accompanied by a statement by a director or secretary` TRUE EQUALS JUST TRUE
#ASSERT `Under section 56(4)(a), must the notice of a change of name be accompanied by a statement by a director or secretary` FALSE EQUALS JUST FALSE
#ASSERT `Under section 56(4)(b), must the notice of a change of name be accompanied by a copy of the response` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 56(4)(b), must the notice of a change of name be accompanied by a copy of the response` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 56A, may my company be registered by this name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 56A, may my company be registered by this name` FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 57(3), may my company be registered by a name with a character the regulations do not permit` TRUE EQUALS JUST FALSE
#ASSERT `Under section 57(3), may my company be registered by a name with a character the regulations do not permit` FALSE EQUALS NOTHING
#ASSERT `Under section 57A, may my company be registered by a name that includes computer code` TRUE EQUALS JUST FALSE
#ASSERT `Under section 57A, may my company be registered by a name that includes computer code` FALSE EQUALS NOTHING
#ASSERT `Under section 57B(1), may my company be registered again by its original name or a similar one` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- a company directed to change its name asks to go back to the original
#ASSERT `Under section 57B(1), may my company be registered again by its original name or a similar one` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- the Secretary of State approved the name
#ASSERT `Under section 57B(1), may my company be registered again by its original name or a similar one` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING -- its name was never changed on a direction
#ASSERT `Under section 57B(1), may my company be registered again by its original name or a similar one` FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- a name determined under section 76D counts
#ASSERT `Under section 57C(4), do I have a relevant relationship with this company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 57C(4), do I have a relevant relationship with this company` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 57C(1), may another company be registered by a name that a company was directed to change` TRUE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- limb (a): an existing company and a person with a relevant relationship to both
#ASSERT `Under section 57C(1), may another company be registered by a name that a company was directed to change` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- limb (b): an application and a person who will have one on incorporation
#ASSERT `Under section 57C(1), may another company be registered by a name that a company was directed to change` TRUE FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- approved by the Secretary of State
#ASSERT `Under section 57C(1), may another company be registered by a name that a company was directed to change` TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- not that name or a similar one
-- ---- Chapter 2: "public limited company", "limited" and the exemption ----
#ASSERT `Under section 58(1), must my public company's name end with public limited company or p.l.c.` TRUE TRUE FALSE EQUALS JUST TRUE
