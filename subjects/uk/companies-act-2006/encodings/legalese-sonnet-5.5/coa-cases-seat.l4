#ASSERT `Under section 59, does my private company's name end as the section requires` TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- exempt, so the requirement does not apply
#ASSERT `Under section 61(1), does the old exemption for companies limited by shares apply to my company` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
