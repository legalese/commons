#ASSERT `Under section 1213(2), must I resign and give written notice because I have become ineligible` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 1213(2), must I resign and give written notice because I have become ineligible` FALSE TRUE EQUALS JUST FALSE
