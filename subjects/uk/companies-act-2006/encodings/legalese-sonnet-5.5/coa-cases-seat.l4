-- not a director at that time
#ASSERT (`Under section 420(2), do I commit an offence as a director because no directors' remuneration report was prepared?` TRUE FALSE TRUE) EQUALS NOTHING
-- the report was prepared
#ASSERT (`Under section 420(2), do I commit an offence as a director because no directors' remuneration report was prepared?` FALSE TRUE TRUE) EQUALS JUST FALSE
-- a fine not exceeding the statutory maximum
#ASSERT (`Under section 420(3), what is the most I can be fined on summary conviction for that offence, in pounds?` 5000) EQUALS JUST 5000
-- Asked on 10 November 2026: the five-year window opens on 10 November 2021 (fork F19).
-- a director now
#ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` TRUE TRUE (Date 1 1 2026) (Date 10 11 2026) TRUE) EQUALS JUST TRUE
-- last a director within the preceding five years
#ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` FALSE TRUE (Date 11 11 2021) (Date 10 11 2026) TRUE) EQUALS JUST TRUE
-- last a director just over five years ago
#ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` FALSE TRUE (Date 9 11 2021) (Date 10 11 2026) TRUE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` FALSE TRUE (Date 9 11 2021) (Date 10 11 2026) TRUE) EQUALS NOTHING; last a director just over five years ago: outside the preceding five years, a period the text fixes in its own words (fork F35; the other reading is NOTHING)
-- never a director
#ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` FALSE FALSE (Date 1 1 2020) (Date 10 11 2026) TRUE) EQUALS JUST FALSE -- RECONCILED 2026-11-12: was #ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` FALSE FALSE (Date 1 1 2020) (Date 10 11 2026) TRUE) EQUALS NOTHING; never a director: not a director now and not at any time in the preceding five years (fork F35; the other reading is NOTHING)
-- not a matter the regulations need
#ASSERT (`Under section 421(3), must I give notice to my company of matters relating to myself for the purposes of the remuneration regulations?` TRUE TRUE (Date 1 1 2026) (Date 10 11 2026) FALSE) EQUALS NOTHING
-- under the duty and in default
#ASSERT (`Under section 421(4), do I commit an offence because I made default in giving notice to my company?` TRUE TRUE (Date 1 1 2026) (Date 10 11 2026) TRUE TRUE) EQUALS JUST TRUE
-- under the duty but not in default
#ASSERT (`Under section 421(4), do I commit an offence because I made default in giving notice to my company?` TRUE TRUE (Date 1 1 2026) (Date 10 11 2026) TRUE FALSE) EQUALS NOTHING
-- no duty under subsection (3) any more
#ASSERT (`Under section 421(4), do I commit an offence because I made default in giving notice to my company?` FALSE TRUE (Date 9 11 2021) (Date 10 11 2026) TRUE TRUE) EQUALS NOTHING
-- a fine not exceeding level 3 on the standard scale
#ASSERT (`Under section 421(4), what is the most I can be fined on summary conviction for that offence, in pounds?` 1000) EQUALS JUST 1000
