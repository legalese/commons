-- neither
#ASSERT (`Under section 415A(1), is my company entitled to small companies exemption in relation to the directors' report?` FALSE FALSE) EQUALS JUST FALSE
-- "Except in the case of a company entitled to the small companies exemption"
#ASSERT (`Under section 416(3), must the directors' report of my company state the amount recommended by way of dividend?` TRUE) EQUALS JUST FALSE
-- the report must state the dividend
#ASSERT (`Under section 416(3), must the directors' report of my company state the amount recommended by way of dividend?` FALSE) EQUALS JUST TRUE
-- an audited company
#ASSERT (`Under section 418(1), does the section on the statement as to disclosure to auditors apply to my company?` FALSE FALSE) EQUALS JUST TRUE
-- exempt from audit and takes advantage: "unless"
#ASSERT (`Under section 418(1), does the section on the statement as to disclosure to auditors apply to my company?` TRUE TRUE) EQUALS JUST FALSE
-- both statements are in the report
#ASSERT (`Under section 418(2), does the directors' report contain the statement as to disclosure to the auditor that the section requires?` TRUE TRUE) EQUALS JUST TRUE
-- the second statement is missing
#ASSERT (`Under section 418(2), does the directors' report contain the statement as to disclosure to the auditor that the section requires?` TRUE FALSE) EQUALS JUST FALSE
-- enquiries and other steps taken
#ASSERT (`Under section 418(4), am I regarded as having taken all the steps that I ought to have taken as a director to make myself aware of relevant audit information?` TRUE TRUE) EQUALS JUST TRUE
-- no other steps: the "if" fails
#ASSERT (`Under section 418(4), am I regarded as having taken all the steps that I ought to have taken as a director to make myself aware of relevant audit information?` TRUE FALSE) EQUALS JUST FALSE
-- a director who knew the statement was false and did not prevent approval
#ASSERT (`Under section 418(5), do I commit an offence as a director because the statement as to disclosure to the auditor in the directors' report was false?` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- the statement was true
#ASSERT (`Under section 418(5), do I commit an offence as a director because the statement as to disclosure to the auditor in the directors' report was false?` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- neither knew nor reckless
#ASSERT (`Under section 418(5), do I commit an offence as a director because the statement as to disclosure to the auditor in the directors' report was false?` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- two years
#ASSERT (`Under section 418(6), what is the longest term of imprisonment I can be sentenced to for that offence, in months?` "on indictment") EQUALS JUST 24
-- twelve months
#ASSERT (`Under section 418(6), what is the longest term of imprisonment I can be sentenced to for that offence, in months?` "summary conviction in England and Wales") EQUALS JUST 12
-- six months
#ASSERT (`Under section 418(6), what is the longest term of imprisonment I can be sentenced to for that offence, in months?` "summary conviction in Scotland") EQUALS JUST 6
-- six months
#ASSERT (`Under section 418(6), what is the longest term of imprisonment I can be sentenced to for that offence, in months?` "summary conviction in Northern Ireland") EQUALS JUST 6
-- not one of the four ways of being convicted
#ASSERT (`Under section 418(6), what is the longest term of imprisonment I can be sentenced to for that offence, in months?` "a fine") EQUALS NOTHING
-- approved, signed by a director
#ASSERT (`Under section 419(1), has the directors' report been approved and signed as the section requires?` TRUE TRUE FALSE) EQUALS JUST TRUE
-- not approved by the board
#ASSERT (`Under section 419(1), has the directors' report been approved and signed as the section requires?` FALSE TRUE FALSE) EQUALS JUST FALSE
-- the small companies exemption was taken advantage of
#ASSERT (`Under section 419(2), must the directors' report state, above the signature, that advantage is taken of the small companies exemption?` TRUE) EQUALS JUST TRUE
-- the "If" fails
#ASSERT (`Under section 419(2), must the directors' report state, above the signature, that advantage is taken of the small companies exemption?` FALSE) EQUALS JUST FALSE
-- a director who knew and took no reasonable steps
#ASSERT (`Under section 419(3), do I commit an offence as a director because a directors' report that does not comply was approved?` TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- the approved report complies
#ASSERT (`Under section 419(3), do I commit an offence as a director because a directors' report that does not comply was approved?` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- a fine not exceeding the statutory maximum
#ASSERT (`Under section 419(4), what is the most I can be fined on summary conviction for that offence, in pounds?` 5000) EQUALS JUST 5000
-- a separate statement approved and signed by a director
#ASSERT (`Under section 419A, has the separate corporate governance statement been approved and signed as the section requires?` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- not a separate corporate governance statement
