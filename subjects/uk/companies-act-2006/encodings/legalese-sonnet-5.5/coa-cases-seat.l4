-- the report contains all three kinds: nothing to state
#ASSERT (`Under section 414C(7), which kinds of information must the strategic report of my quoted company say that it does not contain?` TRUE TRUE TRUE TRUE) EQUALS JUST EMPTY
-- not a quoted company: the sentence is not addressed to it
#ASSERT (`Under section 414C(7), which kinds of information must the strategic report of my quoted company say that it does not contain?` FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- a quoted company must describe its strategy
#ASSERT (`Under section 414C(8), must the strategic report of my quoted company include this item?` TRUE "strategy") EQUALS JUST TRUE
-- and break down its senior managers by sex
#ASSERT (`Under section 414C(8), must the strategic report of my quoted company include this item?` TRUE "senior managers by sex") EQUALS JUST TRUE
-- not a quoted company
#ASSERT (`Under section 414C(8), must the strategic report of my quoted company include this item?` FALSE "strategy") EQUALS NOTHING
-- not an item of subsection (8)
#ASSERT (`Under section 414C(8), must the strategic report of my quoted company include this item?` TRUE "dividends") EQUALS NOTHING
-- a senior manager who is not a director
#ASSERT (`Under section 414C(8)(c)(ii), is this person counted among my company's senior managers in the breakdown by sex?` TRUE FALSE) EQUALS JUST TRUE
-- "(other than persons falling within sub-paragraph (i))"
#ASSERT (`Under section 414C(8)(c)(ii), is this person counted among my company's senior managers in the breakdown by sex?` TRUE TRUE) EQUALS JUST FALSE
-- not a senior manager
#ASSERT (`Under section 414C(8)(c)(ii), is this person counted among my company's senior managers in the breakdown by sex?` FALSE FALSE) EQUALS NOTHING
-- responsibility for planning, directing or controlling and an employee
#ASSERT (`Under section 414C(9), is this person a senior manager of my company?` TRUE TRUE) EQUALS JUST TRUE
-- not an employee
#ASSERT (`Under section 414C(9), is this person a senior manager of my company?` TRUE FALSE) EQUALS JUST FALSE
-- "Nothing in this section requires the disclosure"
