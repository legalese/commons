#ASSERT `Under section 113(4), must the register show stock instead of shares` TRUE TRUE EQUALS JUST TRUE
-- Jo: converted but never told the registrar
#ASSERT `Under section 113(4), must the register show stock instead of shares` TRUE FALSE EQUALS JUST FALSE
-- Kit and Lee hold shares jointly
#ASSERT `Under section 113(5), must the register name each of us as joint holders` TRUE EQUALS JUST TRUE
-- Kit holds alone
#ASSERT `Under section 113(5), must the register name each of us as joint holders` FALSE EQUALS JUST FALSE
