-- a parent company that prepares group accounts
#ASSERT (`Under section 415(2), must my company's directors' report be a consolidated report?` TRUE TRUE) EQUALS JUST TRUE
-- no group accounts: "For a financial year in which" fails
#ASSERT (`Under section 415(2), must my company's directors' report be a consolidated report?` TRUE FALSE) EQUALS JUST FALSE
-- a director at the end of the filing period who took no reasonable steps
