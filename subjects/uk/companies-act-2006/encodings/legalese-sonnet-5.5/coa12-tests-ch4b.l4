IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa12-logic`
IMPORT `coa12-ch4b-resignation`

-- coa12-tests-ch4b.l4: tests for coa12-ch4b-resignation.l4 (ss 516-526). Expected values are decided from the text and typed in the
-- script that makes this file; the script only keeps the argument lists aligned. Argument order is the GIVEN order of each function.
-- Dates: Mon 2 March 2026 is not used; the dates are chosen for easy day counts (1 March plus 14 is 15 March; plus 27 is 28 March).

-- s 516(1)
#ASSERT `s 516(1) the auditor may resign his office by sending a notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 516(1) the auditor may resign his office by sending a notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 516(1) the auditor may resign his office by sending a notice` FALSE TRUE EQUALS NOTHING
-- s 516(2): a public interest company, no s 519 statement with the notice
#ASSERT `s 516(2) the notice of resignation is not effective` (JUST TRUE) FALSE EQUALS JUST TRUE
-- the statement accompanies the notice: "unless" met
#ASSERT `s 516(2) the notice of resignation is not effective` (JUST TRUE) TRUE EQUALS JUST FALSE
-- not a public interest company: the bar is not engaged
#ASSERT `s 516(2) the notice of resignation is not effective` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 516(2) the notice of resignation is not effective` NOTHING FALSE EQUALS NOTHING
-- s 516(3): a later date specified in the notice
#ASSERT `s 516(3) the day on which the auditor's term of office ends` TRUE (Date 1 3 2026) (JUST (Date 15 3 2026)) EQUALS (JUST (Date 15 3 2026))
-- no later date: the day the notice is received
#ASSERT `s 516(3) the day on which the auditor's term of office ends` TRUE (Date 1 3 2026) NOTHING EQUALS (JUST (Date 1 3 2026))
-- an earlier date is not "a later date": the day of receipt
#ASSERT `s 516(3) the day on which the auditor's term of office ends` TRUE (Date 10 3 2026) (JUST (Date 1 3 2026)) EQUALS (JUST (Date 10 3 2026))
#ASSERT `s 516(3) the day on which the auditor's term of office ends` TRUE (Date 10 3 2026) (JUST (Date 10 3 2026)) EQUALS (JUST (Date 10 3 2026))
-- a notice that is not effective
#ASSERT `s 516(3) the day on which the auditor's term of office ends` FALSE (Date 1 3 2026) (JUST (Date 15 3 2026)) EQUALS NOTHING
-- s 518(1): a non-public interest company whose statement has no s 519(3B) statement
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
-- "except where": a non-public interest company and the s 519(3B) statement
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
-- a public interest company: the exception is for a non-public interest company
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
-- no s 519 statement with the notice
#ASSERT `s 518(1) the section applies to the resigning auditor` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 518(1) the section applies to the resigning auditor` TRUE NOTHING FALSE EQUALS JUST TRUE
-- s 518(2)
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 518(2) the auditor may send with the notice an authenticated requisition calling on the directors to convene a general meeting` (JUST TRUE) NOTHING TRUE TRUE EQUALS NOTHING
-- s 518(3)
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 518(3) the auditor may request the company to circulate a statement of reasons to its members` NOTHING TRUE TRUE TRUE EQUALS NOTHING
-- s 518(4)
#ASSERT `s 518(4) the company must state the fact of the statement in its notice of the meeting and send a copy to every member to whom the notice is sent` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
-- too late: "unless"
#ASSERT `s 518(4) the company must state the fact of the statement in its notice of the meeting and send a copy to every member to whom the notice is sent` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 518(4) the company must state the fact of the statement in its notice of the meeting and send a copy to every member to whom the notice is sent` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 518(4) the company must state the fact of the statement in its notice of the meeting and send a copy to every member to whom the notice is sent` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 518(4) the company must state the fact of the statement in its notice of the meeting and send a copy to every member to whom the notice is sent` NOTHING TRUE FALSE EQUALS NOTHING
-- s 518(5)
#ASSERT `s 518(5) the directors must convene the meeting` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 518(5) the directors must convene the meeting` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 518(5) the directors must convene the meeting` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 518(5) the directors must convene the meeting` NOTHING TRUE EQUALS NOTHING
-- s 518(5): notice on day 21; meeting 28 days after the notice
#ASSERT `s 518(5) the directors convened the meeting within the periods the subsection allows` (Date 1 3 2026) (JUST (Date 22 3 2026)) (Date 19 4 2026) EQUALS JUST TRUE
-- notice on day 22: too late
#ASSERT `s 518(5) the directors convened the meeting within the periods the subsection allows` (Date 1 3 2026) (JUST (Date 23 3 2026)) (Date 19 4 2026) EQUALS JUST FALSE
-- meeting 29 days after the notice
#ASSERT `s 518(5) the directors convened the meeting within the periods the subsection allows` (Date 1 3 2026) (JUST (Date 22 3 2026)) (Date 20 4 2026) EQUALS JUST FALSE
-- no notice convening a meeting
#ASSERT `s 518(5) the directors convened the meeting within the periods the subsection allows` (Date 1 3 2026) NOTHING (Date 19 4 2026) EQUALS JUST FALSE
-- notice the day the requisition is received; meeting 28 days after it
#ASSERT `s 518(5) the directors convened the meeting within the periods the subsection allows` (Date 1 3 2026) (JUST (Date 1 3 2026)) (Date 29 3 2026) EQUALS JUST TRUE
-- s 518(6)
#ASSERT `s 518(6) the director commits an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(6) the director commits an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 518(6) the director commits an offence` FALSE TRUE EQUALS JUST FALSE
-- s 518(7): on indictment a fine; on summary conviction a fine up to the statutory maximum
#ASSERT `s 518(7) the penalty for an offence under this section` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 518(7) the penalty for an offence under this section` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 518(7) the penalty for an offence under this section` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 518(7) the penalty for an offence under this section` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 518(7) the penalty for an offence under this section` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
-- s 518(8)
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE; the function is named for a grant or a power and its plain "if" gate fails, so it now answers NOTHING, not JUST FALSE (name-test sweep of 2026-11-12, fork F16); the text does not say the grant is refused
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE; the function is named for a grant or a power and its plain "if" gate fails, so it now answers NOTHING, not JUST FALSE (name-test sweep of 2026-11-12, fork F16); the text does not say the grant is refused
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST TRUE) FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 518(8) the auditor may require that the statement be read out at the meeting` NOTHING TRUE TRUE FALSE EQUALS NOTHING
-- s 518(9)
#ASSERT `s 518(9) copies of the statement need not be sent out and the statement need not be read out at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(9) copies of the statement need not be sent out and the statement need not be read out at the meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 518(9) copies of the statement need not be sent out and the statement need not be read out at the meeting` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 518(9) the court may order the company's costs on the application to be paid in whole or in part by the auditor` TRUE EQUALS JUST TRUE
#ASSERT `s 518(9) the court may order the company's costs on the application to be paid in whole or in part by the auditor` FALSE EQUALS NOTHING
-- s 518(10)
#ASSERT `s 518(10) the resigned auditor has the rights conferred by section 502(2) in relation to the meeting` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(10) the resigned auditor has the rights conferred by section 502(2) in relation to the meeting` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 518(10) the resigned auditor has the rights conferred by section 502(2) in relation to the meeting` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 518(10) the resigned auditor has the rights conferred by section 502(2) in relation to the meeting` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 518(10) the resigned auditor has the rights conferred by section 502(2) in relation to the meeting` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 518(10) the resigned auditor is entitled to be heard on the part of the business` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 518(10) the resigned auditor is entitled to be heard on the part of the business` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 518(10) the resigned auditor is entitled to be heard on the part of the business` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 518(10) the resigned auditor is entitled to be heard on the part of the business` (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- s 519A(2): the borrowed answer passes through
#ASSERT `s 519A(2) the person is an issuer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 519A(2) the person is an issuer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 519A(2) the person is an issuer` NOTHING EQUALS NOTHING
-- s 519A(1)(a): an issuer with securities admitted to a UK regulated market
#ASSERT `s 519A(1) the company is a public interest company` (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- an issuer whose securities are not admitted
#ASSERT `s 519A(1) the company is a public interest company` (JUST TRUE) FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- s 519A(1)(b): a credit institution that is a CRR firm
#ASSERT `s 519A(1) the company is a public interest company` (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- a credit institution that is not a CRR firm
#ASSERT `s 519A(1) the company is a public interest company` (JUST FALSE) TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- s 519A(1)(c): a person who would be an insurance undertaking
#ASSERT `s 519A(1) the company is a public interest company` (JUST FALSE) TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 519A(1) the company is a public interest company` (JUST FALSE) TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 519A(1) the company is a public interest company` NOTHING TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519A(1) the company is a public interest company` NOTHING TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 519A(1) the company is a public interest company` (JUST FALSE) TRUE NOTHING (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- s 519A: the heading's "non-public interest company" read as the opposite (fork F10)
#ASSERT `s 519A(1) the company is a non-public interest company` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 519A(1) the company is a non-public interest company` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 519A(1) the company is a non-public interest company` NOTHING EQUALS NOTHING
-- s 519A(3)(a): A is no longer to carry out statutory audit work
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- s 519A(3)(b): exempt from audit and a s 475(2) statement intended
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE
-- exempt but no statement intended
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- whether the company is exempt is not known
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING
-- s 519A(3)(c) with the s 519A(4) condition
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
-- s 519A(4): (3)(c) is "only an exempt reason if" the group auditor audits every UK subsidiary
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- A is not being replaced by the group auditor
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- the parent undertaking does not prepare group accounts
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE) EQUALS JUST FALSE
-- s 519A(3)(d): being wound up
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
-- s 519A(3)(d): a petition presented and not finally dealt with
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE
-- (3)(c) fails the (4) condition but (3)(d) holds
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 519A(3) the reason for ceasing to hold office is an exempt reason` (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE
-- s 519(2B)(a)
#ASSERT `s 519(2B)(a) every one of the reasons in the list is an exempt reason` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS JUST TRUE
#ASSERT `s 519(2B)(a) every one of the reasons in the list is an exempt reason` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE), (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS JUST FALSE
#ASSERT `s 519(2B)(a) every one of the reasons in the list is an exempt reason` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE), (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS JUST TRUE
-- one reason whose exemption is not known
#ASSERT `s 519(2B)(a) every one of the reasons in the list is an exempt reason` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE), (`s 519A(3) reason for ceasing to hold office` OF FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS NOTHING
-- s 519(2B)
#ASSERT `s 519(2B) the second condition is satisfied` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) FALSE EQUALS JUST TRUE
-- a matter A thinks needs to be brought to attention
#ASSERT `s 519(2B) the second condition is satisfied` (LIST (`s 519A(3) reason for ceasing to hold office` OF TRUE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) TRUE EQUALS JUST FALSE
#ASSERT `s 519(2B) the second condition is satisfied` (LIST (`s 519A(3) reason for ceasing to hold office` OF FALSE, JUST FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) FALSE EQUALS JUST FALSE
-- no reason stated: not covered
#ASSERT `s 519(2B) the second condition is satisfied` EMPTY FALSE EQUALS NOTHING
#ASSERT `s 519(2B) the second condition is satisfied` (LIST (`s 519A(3) reason for ceasing to hold office` OF FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) FALSE EQUALS NOTHING
#ASSERT `s 519(2B) the second condition is satisfied` (LIST (`s 519A(3) reason for ceasing to hold office` OF FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) TRUE EQUALS JUST FALSE
-- s 519(2A)(a): a private company, at the end of a period for appointing auditors
#ASSERT `s 519(2A) the first condition is satisfied` TRUE (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 519(2A) the first condition is satisfied` TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE
-- s 519(2A)(b): a public company, at the end of an accounts meeting
#ASSERT `s 519(2A) the first condition is satisfied` FALSE (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE
-- a public company: the private company limb does not help
#ASSERT `s 519(2A) the first condition is satisfied` FALSE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 519(2A) the first condition is satisfied` TRUE NOTHING FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519(2A) the first condition is satisfied` TRUE (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE
-- s 519(1)
#ASSERT `s 519(1) the auditor of a public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 519(1) the auditor of a public interest company must send the company a statement of the reasons` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 519(1) the auditor of a public interest company must send the company a statement of the reasons` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 519(1) the auditor of a public interest company must send the company a statement of the reasons` NOTHING TRUE EQUALS NOTHING
-- s 519(2)
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- the first condition: "unless"
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- the second condition
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST FALSE) TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` NOTHING TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 519(2) the auditor of a non-public interest company must send the company a statement of the reasons` (JUST TRUE) TRUE NOTHING (JUST TRUE) EQUALS JUST FALSE
-- s 519(3)
#ASSERT `s 519(3) the statement includes what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 519(3) the statement includes what the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 519(3) the statement includes what the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 519(3) the statement includes what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- s 519(3A): no such matters
#ASSERT `s 519(3A) the statement includes the details the subsection requires` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 519(3A) the statement includes the details the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 519(3A) the statement includes the details the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 519(3A) the statement includes the details the subsection requires` FALSE TRUE EQUALS JUST TRUE
-- s 519(3B)
#ASSERT `s 519(3B) the statement includes the statement the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 519(3B) the statement includes the statement the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- not a statement required by subsection (2)
#ASSERT `s 519(3B) the statement includes the statement the subsection requires` FALSE TRUE FALSE EQUALS JUST TRUE
-- A does not consider that nothing need be brought to attention
#ASSERT `s 519(3B) the statement includes the statement the subsection requires` TRUE FALSE FALSE EQUALS JUST TRUE
-- s 519(4)(a)
#ASSERT `s 519(4)(a) the statement was sent in time on a resignation` TRUE EQUALS JUST TRUE
#ASSERT `s 519(4)(a) the statement was sent in time on a resignation` FALSE EQUALS JUST FALSE
-- s 519(4)(b): 14 days before 31 March is 17 March
#ASSERT `s 519(4)(b) the statement was sent in time on a failure to seek re-appointment` (Date 17 3 2026) (Date 31 3 2026) EQUALS JUST TRUE
-- 13 days before: too late
#ASSERT `s 519(4)(b) the statement was sent in time on a failure to seek re-appointment` (Date 18 3 2026) (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 519(4)(b) the statement was sent in time on a failure to seek re-appointment` (Date 1 3 2026) (Date 31 3 2026) EQUALS JUST TRUE
-- s 519(4)(c): the 14 days beginning with 1 March end on 14 March
#ASSERT `s 519(4)(c) the statement was sent in time in any other case` (Date 1 3 2026) (Date 14 3 2026) EQUALS JUST TRUE
#ASSERT `s 519(4)(c) the statement was sent in time in any other case` (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST FALSE
-- before he ceased: "not later than"
#ASSERT `s 519(4)(c) the statement was sent in time in any other case` (Date 1 3 2026) (Date 20 2 2026) EQUALS JUST TRUE
-- s 519(5)
#ASSERT `s 519(5) the person ceasing to hold office as auditor commits an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 519(5) the person ceasing to hold office as auditor commits an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 519(5) the person ceasing to hold office as auditor commits an offence` FALSE TRUE EQUALS JUST FALSE
