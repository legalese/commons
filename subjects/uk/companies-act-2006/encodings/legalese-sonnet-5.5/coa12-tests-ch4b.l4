#ASSERT `s 519(6) the person charged has a defence under this subsection` TRUE EQUALS JUST TRUE
#ASSERT `s 519(6) the person charged has a defence under this subsection` FALSE EQUALS JUST FALSE
-- s 519(7): on indictment a fine; on summary conviction a fine up to the statutory maximum
#ASSERT `s 519(7) the penalty for an offence under this section` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 519(7) the penalty for an offence under this section` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 519(7) the penalty for an offence under this section` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 519(7) the penalty for an offence under this section` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
