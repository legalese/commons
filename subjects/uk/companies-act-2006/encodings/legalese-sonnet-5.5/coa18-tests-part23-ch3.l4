§§ `s 841 realised losses and revaluation`

-- 841(3): a diminution on a revaluation of all the fixed assets
#ASSERT `s 841(3) the provision is a revaluation provision` TRUE TRUE FALSE EQUALS JUST TRUE
-- 841(3): a diminution on a revaluation of all fixed assets other than goodwill
#ASSERT `s 841(3) the provision is a revaluation provision` TRUE FALSE TRUE EQUALS JUST TRUE
-- 841(3): "means": a diminution not appearing on such a revaluation
#ASSERT `s 841(3) the provision is a revaluation provision` TRUE FALSE FALSE EQUALS JUST FALSE
-- 841(3): not a provision in respect of a diminution in value
#ASSERT `s 841(3) the provision is a revaluation provision` FALSE TRUE TRUE EQUALS JUST FALSE
-- 841(2)(a): a specified provision that is not a revaluation provision
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(a) Companies Act accounts` ((JUST TRUE)) ((JUST FALSE)) EQUALS JUST TRUE
-- 841(2)(a): "except revaluation provisions"
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(a) Companies Act accounts` ((JUST TRUE)) ((JUST TRUE)) EQUALS JUST FALSE
-- 841(2)(a): not a specified kind: "The following are treated" does not close the list
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(a) Companies Act accounts` ((JUST FALSE)) ((JUST FALSE)) EQUALS NOTHING
-- 841(2)(a): s 396 unknown
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(a) Companies Act accounts` NOTHING ((JUST FALSE)) EQUALS NOTHING
-- 841(2)(b): IAS accounts, provisions of any kind
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(b) IAS accounts` NOTHING ((JUST FALSE)) EQUALS JUST TRUE
-- 841(2)(b): "except revaluation provisions"
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(b) IAS accounts` NOTHING ((JUST TRUE)) EQUALS JUST FALSE
-- 841(2)(b): whether it is a revaluation provision is not known
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3)(b) IAS accounts` NOTHING NOTHING EQUALS NOTHING
-- 841(2): accounts of another kind: not mentioned
#ASSERT `s 841(2) the provision is treated as a realised loss` `s 831(3) accounts of another kind` NOTHING ((JUST FALSE)) EQUALS NOTHING
-- 841(4): satisfied and all three statements in the note
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- 841(4)(a): the directors are not satisfied
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- 841(4)(b)(i): the note does not say the directors considered the value
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- 841(4)(b)(ii): the note does not say they are satisfied
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- 841(4)(b)(iii): the note does not say amounts are stated on that basis
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 841(4): no consideration by the directors
#ASSERT `s 841(4) the consideration by the directors of the value of a fixed asset is treated as a revaluation` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- 841(5): the sum written off (150) exceeds what would have been written off (100) by 50
#ASSERT `s 841(5) the amount treated as a realised profit made over that period` TRUE TRUE 150 100 EQUALS JUST 50
-- 841(5): no excess: no amount
#ASSERT `s 841(5) the amount treated as a realised profit made over that period` TRUE TRUE 100 100 EQUALS JUST 0
-- 841(5): the sum is less: no amount
#ASSERT `s 841(5) the amount treated as a realised profit made over that period` TRUE TRUE 80 100 EQUALS JUST 0
-- 841(5)(a): no unrealised profit shown: not covered
#ASSERT `s 841(5) the amount treated as a realised profit made over that period` FALSE TRUE 150 100 EQUALS NOTHING
-- 841(5)(b): nothing written off or retained: not covered
#ASSERT `s 841(5) the amount treated as a realised profit made over that period` TRUE FALSE 150 100 EQUALS NOTHING
-- 842(a): no record of the original cost
#ASSERT `s 842 the cost of the asset taken for the purposes of determining profit or loss` TRUE FALSE 750 EQUALS JUST 750
-- 842(b): a record cannot be obtained without unreasonable expense or delay
#ASSERT `s 842 the cost of the asset taken for the purposes of determining profit or loss` FALSE TRUE 750 EQUALS JUST 750
-- 842: a record is available: not covered
#ASSERT `s 842 the cost of the asset taken for the purposes of determining profit or loss` FALSE FALSE 750 EQUALS NOTHING

