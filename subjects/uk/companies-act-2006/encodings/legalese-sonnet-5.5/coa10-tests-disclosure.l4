IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa10-types`
IMPORT `coa10-disclosure`

-- coa10-tests-disclosure.l4: tests for coa10-disclosure.l4 (ss 458 to 461). Every expected value was written down from the
-- text of the section (line numbers in ukpga-2006-46.txt) before the module was run; none is copied from its output.

-- ---- s 458(1), (2): disclosure by the Commissioners (lines 6221-6225) ----
-- The arguments: to a person authorised under s 457; for the purpose (a) or (b); personal data; would contravene the data protection legislation.
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- not to be disclosed in contravention of the data protection legislation, even to an authorised person
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- not covered: another recipient or another purpose, with no personal data in contravention
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 458(1) the Commissioners may disclose the information to the authorised person` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 458(2) a statutory or other restriction bars the disclosure under this section` TRUE EQUALS JUST FALSE
#ASSERT `s 458(2) a statutory or other restriction bars the disclosure under this section` FALSE EQUALS NOTHING

-- ---- s 458(3): use and further disclosure (lines 6226-6233) ----
#ASSERT `s 458(3)(a) the section bars the use of the information` `s 458 use in or in connection with taking steps to discover whether there are grounds for an application to the court under section 456` EQUALS JUST FALSE
#ASSERT `s 458(3)(a) the section bars the use of the information` `s 458 use in or in connection with deciding whether or not to make such an application` EQUALS JUST FALSE
#ASSERT `s 458(3)(a) the section bars the use of the information` `s 458 use in or in connection with proceedings on such an application` EQUALS JUST FALSE
#ASSERT `s 458(3)(a) the section bars the use of the information` `s 458 any other use` EQUALS JUST TRUE
#ASSERT `s 458(3)(b) the section bars the further disclosure of the information` `s 458 disclosure to the person to whom the information relates` EQUALS JUST FALSE
#ASSERT `s 458(3)(b) the section bars the further disclosure of the information` `s 458 disclosure in or in connection with proceedings on any such application to the court` EQUALS JUST FALSE
#ASSERT `s 458(3)(b) the section bars the further disclosure of the information` `s 458 any other disclosure` EQUALS JUST TRUE

-- ---- s 458(4): the offence and its two defences (lines 6234-6236) ----
#ASSERT `s 458(4) the person commits an offence` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 458(4) the person commits an offence` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 458(4) the person commits an offence` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 458(4) the person commits an offence` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 458(4) the person commits an offence` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 458(4) the person commits an offence` NOTHING TRUE FALSE EQUALS JUST FALSE

-- ---- s 458(5): the penalties (lines 6237-6241) ----
-- on indictment: imprisonment not exceeding two years or a fine (or both)
#ASSERT `s 458(5) the penalty for the offence` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, (JUST (Period OF 2, Years)), (JUST `a fine without a stated limit`), NOTHING, TRUE)
-- on summary conviction in England and Wales: twelve months, a fine not exceeding the statutory maximum (or both)
#ASSERT `s 458(5) the penalty for the offence` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, (JUST (Period OF 12, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
-- in Scotland or Northern Ireland: six months, a fine not exceeding the statutory maximum (or both)
#ASSERT `s 458(5) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
#ASSERT `s 458(5) the penalty for the offence` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
-- a summary conviction with no place named: not covered
#ASSERT `s 458(5) the penalty for the offence` `on summary conviction` EQUALS NOTHING

-- ---- s 458(6): officers (lines 6242-6244) ----
#ASSERT `s 458(6) the person is treated as an officer of the body` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 458(6) the person is treated as an officer of the body` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 458(6) the person is treated as an officer of the body` FALSE FALSE EQUALS NOTHING
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 458(6) the officer of the body corporate also commits the offence` TRUE (JUST TRUE) NOTHING EQUALS NOTHING

-- ---- s 459 (lines 6246-6259) ----
#ASSERT `s 459(1) section 459 applies` TRUE EQUALS JUST TRUE
#ASSERT `s 459(1) section 459 applies` FALSE EQUALS JUST FALSE
#ASSERT `s 459(3) the person is one whom the authorised person may require` `s 459 the company` EQUALS JUST TRUE
#ASSERT `s 459(3) the person is one whom the authorised person may require` `s 459 an officer, employee or auditor of the company` EQUALS JUST TRUE
#ASSERT `s 459(3) the person is one whom the authorised person may require` `s 459 a person who fell within the previous paragraph at a time to which the document or information required relates` EQUALS JUST TRUE
#ASSERT `s 459(3) the person is one whom the authorised person may require` `s 459 any other person` EQUALS NOTHING
#ASSERT `s 459(2) the authorised person may require the person to produce the document or provide the information or explanation` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 459(2) the authorised person may require the person to produce the document or provide the information or explanation` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 459(2) the authorised person may require the person to produce the document or provide the information or explanation` (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 459(2) the authorised person may require the person to produce the document or provide the information or explanation` (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 459(2) the authorised person may require the person to produce the document or provide the information or explanation` NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 459(4) the authorised person may apply to the court` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 459(4) the authorised person may apply to the court` FALSE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F25)
#ASSERT `s 459(4) the authorised person may apply to the court` FALSE EQUALS NOTHING
#ASSERT `s 459(5) the court may order the person to take such steps as it directs` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `#ASSERT `s 459(5) the court may order the person to take such steps as it directs` FALSE EQUALS JUST FALSE`; name-test sweep: the function is named for a grant ("may") and answered JUST FALSE because an "If" gate failed; the text does not close the gate with "only if", so a failed gate is NOTHING (fork F26)
#ASSERT `s 459(5) the court may order the person to take such steps as it directs` FALSE EQUALS NOTHING
-- (6): not to be used in evidence against the maker in criminal proceedings
#ASSERT `s 459(6) the statement may be used in evidence against the person who made it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 459(6) the statement may be used in evidence against the person who made it` TRUE FALSE EQUALS NOTHING
#ASSERT `s 459(6) the statement may be used in evidence against the person who made it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 459(7) the section compels the person to disclose the document or information` TRUE EQUALS JUST FALSE
#ASSERT `s 459(7) the section compels the person to disclose the document or information` FALSE EQUALS NOTHING
#ASSERT `s 459(8) the thing is a document for the purposes of section 459` TRUE EQUALS JUST TRUE
#ASSERT `s 459(8) the thing is a document for the purposes of section 459` FALSE EQUALS NOTHING

-- ---- s 460 (lines 6261-6276) ----
#ASSERT `s 460(1) the information is within section 460` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 460(1) the information is within section 460` TRUE FALSE EQUALS NOTHING
#ASSERT `s 460(1) the information is within section 460` FALSE TRUE EQUALS NOTHING
-- The arguments: within s 460(1); the individual alive or the business continuing; consent given; permitted by s 461; available to the public from another source.
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) TRUE FALSE (JUST FALSE) FALSE EQUALS JUST TRUE
-- consent given: the bar is limited by its own wording
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) TRUE TRUE (JUST FALSE) FALSE EQUALS NOTHING
-- (3)(a): permitted by section 461: the prohibition does not apply
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
-- (3)(b): available to the public from another source
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) TRUE FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
-- the individual has died and the business has ceased: the bar's own period has run out
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) FALSE FALSE (JUST FALSE) FALSE EQUALS NOTHING
-- not within subsection (1)
#ASSERT `s 460(2) the section bars the disclosure of the information` NOTHING TRUE FALSE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 460(2) the section bars the disclosure of the information` (JUST TRUE) TRUE FALSE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 460(4) the person commits an offence` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 460(4) the person commits an offence` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 460(4) the person commits an offence` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 460(4) the person commits an offence` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 460(5) the penalty for the offence` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, (JUST (Period OF 2, Years)), (JUST `a fine without a stated limit`), NOTHING, TRUE)
#ASSERT `s 460(5) the penalty for the offence` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, (JUST (Period OF 6, Months)), (JUST (`a fine not exceeding the statutory maximum` 1)), NOTHING, TRUE)
#ASSERT `s 460(5) the penalty for the offence` `on summary conviction` EQUALS NOTHING
#ASSERT `s 460(6) the person is treated as an officer of the body` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 460(6) the person is treated as an officer of the body` FALSE FALSE EQUALS NOTHING
#ASSERT `s 460(6) the officer of the body corporate also commits the offence` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 460(6) the officer of the body corporate also commits the offence` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

-- ---- s 461 (lines 6278-6315) ----
#ASSERT `s 461(2) the prohibition in section 460 does not apply to the disclosure` TRUE EQUALS JUST TRUE
#ASSERT `s 461(2) the prohibition in section 460 does not apply to the disclosure` FALSE EQUALS NOTHING
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Department of Enterprise, Trade and Investment for Northern Ireland` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Treasury` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Bank of England` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Financial Conduct Authority` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Prudential Regulation Authority` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 the Commissioners for Her Majesty's Revenue and Customs` EQUALS JUST TRUE
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 any other recipient` EQUALS NOTHING
#ASSERT `s 461(3) the prohibition in section 460 does not apply to disclosure to the recipient` `s 461 a body exercising functions of a public nature under legislation in a country or territory outside the United Kingdom` EQUALS NOTHING
#ASSERT `s 461(4) the prohibition in section 460 does not apply to disclosure for the purpose` `s 461 in pursuance of any assimilated obligation` EQUALS JUST TRUE
#ASSERT `s 461(4) the prohibition in section 460 does not apply to disclosure for the purpose` `s 461 enabling or assisting the Bank of England to exercise its functions` EQUALS JUST TRUE
#ASSERT `s 461(4) the prohibition in section 460 does not apply to disclosure for the purpose` `s 461 disciplinary proceedings relating to the performance by an accountant or auditor of his professional duties` EQUALS JUST TRUE
#ASSERT `s 461(4) the prohibition in section 460 does not apply to disclosure for the purpose` `s 461 any other purpose` EQUALS NOTHING
#ASSERT `s 461(5) the prohibition in section 460 does not apply to disclosure to the overseas body` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 461(5) the prohibition in section 460 does not apply to disclosure to the overseas body` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 461(5) the prohibition in section 460 does not apply to disclosure to the overseas body` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 461(5) the prohibition in section 460 does not apply to disclosure to the overseas body` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 461(6) the authorised person has had regard to the considerations the section names` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 461(6) the authorised person has had regard to the considerations the section names` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 461(6) the authorised person has had regard to the considerations the section names` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 461(7) the section authorises the disclosure` TRUE EQUALS JUST FALSE
#ASSERT `s 461(7) the section authorises the disclosure` FALSE EQUALS NOTHING
-- (1): the exceptions together.
#ASSERT `s 461(1) the disclosure is permitted by section 461` (JUST TRUE) NOTHING NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 461(1) the disclosure is permitted by section 461` NOTHING (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 461(1) the disclosure is permitted by section 461` NOTHING NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 461(1) the disclosure is permitted by section 461` NOTHING NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 461(1) the disclosure is permitted by section 461` NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 461(1) the disclosure is permitted by section 461` (JUST TRUE) NOTHING NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE
