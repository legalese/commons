IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa7-ch1`
IMPORT `coa7-ch2`

-- coa7-tests-ch2.l4: tests for coa7-ch2.l4 (Part 13 Chapter 2, ss 288 to 300).
-- Every expected value is written from the text of the section named beside it, never from the encoding's output.

§ `Tests for Chapter 2 (ss 288 to 300)`

-- s 288(1): "written resolution" means a resolution of a private company proposed and passed in accordance with this Chapter
#ASSERT `s 288(1) the resolution is a written resolution` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 288(1) the resolution is a written resolution` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 288(1) the resolution is a written resolution` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 288(1) the resolution is a written resolution` FALSE TRUE FALSE EQUALS JUST FALSE
-- s 288(2): a resolution under s 168 or s 510 may not be passed as a written resolution; the list does not say "only"
#ASSERT `s 288(2) the resolution may not be passed as a written resolution` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 288(2) the resolution may not be passed as a written resolution` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 288(2) the resolution may not be passed as a written resolution` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 288(2) the resolution may not be passed as a written resolution` NOTHING NOTHING EQUALS NOTHING
-- s 288(3): the directors or the members may propose
#ASSERT `s 288(3) the resolution may be proposed as a written resolution by the proposer` `s 288(3)(a) the directors of a private company` EQUALS JUST TRUE
#ASSERT `s 288(3) the resolution may be proposed as a written resolution by the proposer` `s 288(3)(b) the members of a private company` EQUALS JUST TRUE
#ASSERT `s 288(3) the resolution may be proposed as a written resolution by the proposer` `s 288(3) another person` EQUALS NOTHING
-- s 288(4): earlier enactments' references to a resolution in general meeting or of a class meeting include a private company's written resolution
#ASSERT `s 288(4) the reference includes a written resolution of the members` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 288(4) the reference includes a written resolution of the members` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 288(4) the reference includes a written resolution of the members` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 288(4) the reference includes a written resolution of the members` TRUE TRUE TRUE EQUALS NOTHING
-- s 288(5): effect as if passed in general meeting, or by a class meeting
#ASSERT `s 288(5) the written resolution has effect as if passed` TRUE FALSE EQUALS JUST `s 288(5)(a) by the company in general meeting`
#ASSERT `s 288(5) the written resolution has effect as if passed` TRUE TRUE EQUALS JUST `s 288(5)(b) by a meeting of a class of members of the company`
#ASSERT `s 288(5) the written resolution has effect as if passed` FALSE FALSE EQUALS NOTHING
#ASSERT `s 288(5) the reference is construed to include a written resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 288(5) the reference is construed to include a written resolution` FALSE TRUE EQUALS NOTHING

-- s 289(1): the eligible members are those who would have been entitled to vote on the circulation date
#ASSERT `s 289(1) the member is an eligible member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 289(1) the member is an eligible member` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 289(1) the member is an eligible member` FALSE TRUE EQUALS NOTHING
-- s 289(2): if entitlement changes during the day, those entitled when the first copy is sent
#ASSERT `s 289(2) the person is an eligible member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 289(2) the person is an eligible member` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 289(2) the person is an eligible member` FALSE TRUE EQUALS JUST FALSE
-- s 290: the date copies are sent or submitted, or the first of the days if on different days
#ASSERT `s 290 the circulation date` (LIST Date 5 3 2026, Date 3 3 2026, Date 9 3 2026) EQUALS JUST (Date 3 3 2026)
#ASSERT `s 290 the circulation date` (LIST Date 5 3 2026) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 290 the circulation date` EMPTY EQUALS NOTHING

-- s 291(1)
#ASSERT `s 291(1) this section applies to the resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 291(1) this section applies to the resolution` FALSE EQUALS NOTHING
-- s 291(2): a copy to every eligible member (4 eligible)
#ASSERT `s 291(2) the company has sent or submitted a copy of the resolution to every eligible member` TRUE 4 4 EQUALS JUST TRUE
#ASSERT `s 291(2) the company has sent or submitted a copy of the resolution to every eligible member` TRUE 4 3 EQUALS JUST FALSE
#ASSERT `s 291(2) the company has sent or submitted a copy of the resolution to every eligible member` FALSE 4 4 EQUALS NOTHING
-- s 291(3): the manner
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3)(a) sending copies at the same time to all eligible members in hard copy form, in electronic form or by means of a website` FALSE EQUALS JUST TRUE
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3)(b) submitting the same copy (or different copies) to each eligible member in turn` TRUE EQUALS JUST TRUE
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3)(b) submitting the same copy (or different copies) to each eligible member in turn` FALSE EQUALS JUST FALSE
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3) sending copies to some members under (a) and submitting copies to the others under (b)` TRUE EQUALS JUST TRUE
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3) sending copies to some members under (a) and submitting copies to the others under (b)` FALSE EQUALS JUST FALSE
#ASSERT `s 291(3) the manner of circulation is one this section requires` `s 291(3) some other manner` TRUE EQUALS JUST FALSE
-- s 291(4): the statement must tell the member how to signify agreement and the date by which the resolution must be passed
#ASSERT `s 291(4) the copy is accompanied by the statement this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 291(4) the copy is accompanied by the statement this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 291(4) the copy is accompanied by the statement this subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 291(5) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 291(5) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 291(5) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 291(5) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 291(6) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 291(6) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 291(6) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 291(6) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 291(6) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 291(7) the failure affects the validity of the resolution` TRUE EQUALS JUST FALSE
#ASSERT `s 291(7) the failure affects the validity of the resolution` FALSE EQUALS NOTHING

-- s 292(2): may properly be moved unless ineffective, defamatory, or frivolous or vexatious
#ASSERT `s 292(2) the resolution may properly be moved as a written resolution` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 292(2) the resolution may properly be moved as a written resolution` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 292(2) the resolution may properly be moved as a written resolution` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 292(2) the resolution may properly be moved as a written resolution` FALSE FALSE TRUE EQUALS JUST FALSE
-- s 292(1): the members of a private company may require circulation of a resolution that may properly be moved and is proposed to be moved as a written resolution
#ASSERT `s 292(1) the members may require the company to circulate the resolution` FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 292(1) the members may require the company to circulate the resolution` TRUE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 292(1) the members may require the company to circulate the resolution` FALSE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 292(1) the members may require the company to circulate the resolution` FALSE (JUST FALSE) TRUE EQUALS NOTHING
-- s 292(3): a statement of not more than 1,000 words
#ASSERT `s 292(3) the members may require the company to circulate a statement of this length with the resolution` 1000 EQUALS JUST TRUE
#ASSERT `s 292(3) the members may require the company to circulate a statement of this length with the resolution` 1001 EQUALS NOTHING
-- s 292(5): the requisite percentage is 5% or a lower percentage specified in the articles
#ASSERT `s 292(5) the requisite percentage` NOTHING EQUALS JUST 0.05
#ASSERT `s 292(5) the requisite percentage` (JUST 0.03) EQUALS JUST 0.03
#ASSERT `s 292(5) the requisite percentage` (JUST 0.05) EQUALS JUST 0.05
#ASSERT `s 292(5) the requisite percentage` (JUST 0.1) EQUALS NOTHING
-- s 292(4): requests from members representing not less than the requisite percentage
#ASSERT `s 292(4) the company is required to circulate the resolution and any accompanying statement` 0.05 0.05 EQUALS JUST TRUE
#ASSERT `s 292(4) the company is required to circulate the resolution and any accompanying statement` 0.049 0.05 EQUALS JUST FALSE
#ASSERT `s 292(4) the company is required to circulate the resolution and any accompanying statement` 0.03 0.03 EQUALS JUST TRUE
-- s 292(6): the request
#ASSERT `s 292(6) the request meets the requirements of this subsection` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 292(6) the request meets the requirements of this subsection` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 292(6) the request meets the requirements of this subsection` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 292(6) the request meets the requirements of this subsection` FALSE TRUE TRUE EQUALS NOTHING

-- s 293(1): required under s 292, bound under s 294(2), and (for the statement) not relieved under s 295(1)
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` (JUST TRUE) (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` (JUST FALSE) (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 293(1) the company must send or submit the copies to every eligible member` NOTHING (JUST TRUE) (JUST FALSE) TRUE EQUALS NOTHING
-- s 293(2): the manner, as in s 291(3)
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2)(a) sending copies at the same time to all eligible members in hard copy form, in electronic form or by means of a website` FALSE EQUALS JUST TRUE
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2)(b) submitting the same copy (or different copies) to each eligible member in turn` TRUE EQUALS JUST TRUE
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2)(b) submitting the same copy (or different copies) to each eligible member in turn` FALSE EQUALS JUST FALSE
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2) sending copies to some members under (a) and submitting copies to the others under (b)` TRUE EQUALS JUST TRUE
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2) sending copies to some members under (a) and submitting copies to the others under (b)` FALSE EQUALS JUST FALSE
#ASSERT `s 293(2) the manner of circulation is one this section requires` `s 293(2) some other manner` TRUE EQUALS JUST FALSE
-- s 293(3): not more than 21 days after becoming subject to the requirement (1 March + 21 days is 22 March)
#ASSERT `s 293(3) the copies were sent or submitted in time` (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST TRUE
#ASSERT `s 293(3) the copies were sent or submitted in time` (Date 1 3 2026) (Date 23 3 2026) EQUALS JUST FALSE
-- s 293(4): the guidance
#ASSERT `s 293(4) the copy is accompanied by the guidance this subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 293(4) the copy is accompanied by the guidance this subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 293(4) the copy is accompanied by the guidance this subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 293(5) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 293(5) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 293(5) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 293(5) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 293(6) the penalty on conviction` `on conviction on indictment` EQUALS JUST (Penalty OF `on conviction on indictment`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
#ASSERT `s 293(6) the penalty on conviction` `on summary conviction` EQUALS JUST (Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 293(6) the penalty on conviction` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 293(6) the penalty on conviction` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 293(6) the penalty on conviction` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, FALSE)
#ASSERT `s 293(7) the failure affects the validity of the resolution` TRUE EQUALS JUST FALSE
#ASSERT `s 293(7) the failure affects the validity of the resolution` FALSE EQUALS NOTHING

-- s 294(1): the members who requested pay unless the company resolves otherwise
#ASSERT `s 294(1) the expenses of complying with section 293 must be paid by the members who requested the circulation` FALSE EQUALS JUST TRUE
#ASSERT `s 294(1) the expenses of complying with section 293 must be paid by the members who requested the circulation` TRUE EQUALS JUST FALSE
-- s 294(2): not bound unless previously resolved or a sufficient sum is deposited or tendered
#ASSERT `s 294(2) the company is bound to comply with section 293` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 294(2) the company is bound to comply with section 293` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 294(2) the company is bound to comply with section 293` FALSE FALSE EQUALS JUST FALSE

-- s 295(1): the court is satisfied, on an application, that the rights are being abused
#ASSERT `s 295(1) the company is not required to circulate the members' statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 295(1) the company is not required to circulate the members' statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 295(1) the company is not required to circulate the members' statement` FALSE TRUE EQUALS JUST FALSE
-- s 295(2)
#ASSERT `s 295(2) the court may order the members who requested the circulation to pay the company's costs` TRUE EQUALS JUST TRUE
#ASSERT `s 295(2) the court may order the members who requested the circulation to pay the company's costs` FALSE EQUALS NOTHING

-- s 296(1)
#ASSERT `s 296(1) the member has signified agreement to the proposed written resolution` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 296(1) the member has signified agreement to the proposed written resolution` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 296(1) the member has signified agreement to the proposed written resolution` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 296(1) the member has signified agreement to the proposed written resolution` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 296(1) the member has signified agreement to the proposed written resolution` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- s 296(2)
#ASSERT `s 296(2) the document is sent in a form this subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 296(2) the document is sent in a form this subsection requires` FALSE EQUALS JUST FALSE
-- s 296(3): once signified, may not be revoked
#ASSERT `s 296(3) the member's agreement may be revoked` TRUE EQUALS JUST FALSE
#ASSERT `s 296(3) the member's agreement may be revoked` FALSE EQUALS NOTHING
-- s 296(4): passed when the required majority (simple, or 75%) of eligible members have signified agreement
#ASSERT `s 296(4) the written resolution is passed` `an ordinary resolution` (`s 282 vote count` OF 51, 0, 100) EQUALS JUST TRUE
#ASSERT `s 296(4) the written resolution is passed` `an ordinary resolution` (`s 282 vote count` OF 50, 0, 100) EQUALS JUST FALSE
#ASSERT `s 296(4) the written resolution is passed` `a special resolution` (`s 282 vote count` OF 75, 0, 100) EQUALS JUST TRUE
#ASSERT `s 296(4) the written resolution is passed` `a special resolution` (`s 282 vote count` OF 74, 0, 100) EQUALS JUST FALSE

-- s 297(1): 28 days beginning with the circulation date (1 March) end on 28 March; or the period the articles specify
#ASSERT `s 297(1) the last day of the period for agreeing to the written resolution` (Date 1 3 2026) NOTHING EQUALS Date 28 3 2026
#ASSERT `s 297(1) the last day of the period for agreeing to the written resolution` (Date 1 3 2026) (JUST (Date 10 3 2026)) EQUALS Date 10 3 2026
#ASSERT `s 297(1) the proposed written resolution lapses` (Date 28 3 2026) (JUST (Date 28 3 2026)) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 297(1) the proposed written resolution lapses` (Date 28 3 2026) (JUST (Date 29 3 2026)) (Date 30 3 2026) EQUALS JUST TRUE
#ASSERT `s 297(1) the proposed written resolution lapses` (Date 28 3 2026) NOTHING (Date 29 3 2026) EQUALS JUST TRUE
#ASSERT `s 297(1) the proposed written resolution lapses` (Date 28 3 2026) NOTHING (Date 28 3 2026) EQUALS JUST FALSE
-- s 297(2): agreement signified after the expiry is ineffective
#ASSERT `s 297(2) the member's agreement is ineffective` (Date 29 3 2026) (Date 28 3 2026) EQUALS JUST TRUE
#ASSERT `s 297(2) the member's agreement is ineffective` (Date 28 3 2026) (Date 28 3 2026) EQUALS JUST FALSE

-- s 298(1)
#ASSERT `s 298(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 298(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 298(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 298(1) the company is deemed to have agreed that the document or information may be sent by electronic means to the address` TRUE TRUE FALSE EQUALS NOTHING
-- s 298(2)
#ASSERT `s 298(2) the address or number is an electronic address` TRUE EQUALS JUST TRUE
#ASSERT `s 298(2) the address or number is an electronic address` FALSE EQUALS JUST FALSE

-- s 299(1)
#ASSERT `s 299(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 299(1) this section applies` FALSE EQUALS JUST FALSE
-- s 299(2): not validly sent unless available on the website throughout the period
#ASSERT `s 299(2) the resolution or statement is not validly sent for the purposes of this Chapter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 299(2) the resolution or statement is not validly sent for the purposes of this Chapter` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 299(2) the resolution or statement is not validly sent for the purposes of this Chapter` FALSE FALSE EQUALS NOTHING

-- s 300: a private company's articles are void in so far as they prevent a resolution required by an enactment being passed as a written resolution
#ASSERT `s 300 the provision of the articles is void` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 300 the provision of the articles is void` FALSE FALSE EQUALS NOTHING
#ASSERT `s 300 the provision of the articles is void` TRUE TRUE EQUALS NOTHING
