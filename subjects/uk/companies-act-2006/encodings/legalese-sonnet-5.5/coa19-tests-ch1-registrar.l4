IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa19-nouns`
IMPORT `coa19-ch1-registrar`

-- coa19-tests-ch1-registrar.l4: tests for coa19-ch1-registrar.l4 (ss 869 to 877).
-- Every expected value is written from the text of the section named in the comment above it, not from the code's output.

§ `Tests: ss 869 to 877`

§§ `s 869 Register of charges to be kept by registrar`
#ASSERT `s 869(1) the registrar must keep the charge in the register of charges` TRUE EQUALS JUST TRUE
#ASSERT `s 869(1) the registrar must keep the charge in the register of charges` FALSE EQUALS NOTHING
#ASSERT `s 869(2) the registrar must enter the required particulars specified in section 863(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 869(2) the registrar must enter the required particulars specified in section 863(2)` FALSE EQUALS JUST FALSE
#ASSERT `s 869(3) the registrar must enter the date on which the charge became effective` TRUE EQUALS JUST TRUE
#ASSERT `s 869(3) the registrar must enter the date on which the charge became effective` FALSE EQUALS JUST FALSE
-- (4) any other charge: (a) the date of creation (if created by a company) and the date of acquisition (if existing on property acquired), (b), (c), (d)
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE FALSE `s 869(4)(a) the date of its creation` EQUALS JUST TRUE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE FALSE FALSE `s 869(4)(a) the date of its creation` EQUALS JUST FALSE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE FALSE TRUE `s 869(4)(a) the date of the acquisition` EQUALS JUST TRUE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE FALSE `s 869(4)(a) the date of the acquisition` EQUALS JUST FALSE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE TRUE `s 869(4)(b) the amount secured by the charge` EQUALS JUST TRUE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE TRUE `s 869(4)(c) short particulars of the property charged` EQUALS JUST TRUE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE TRUE `s 869(4)(d) the persons entitled to the charge` EQUALS JUST TRUE
#ASSERT `s 869(4) the registrar must enter the particular in the register` TRUE TRUE TRUE `s 869(4) any other particular` EQUALS NOTHING
#ASSERT `s 869(4) the registrar must enter the particular in the register` FALSE TRUE TRUE `s 869(4)(b) the amount secured by the charge` EQUALS JUST FALSE
#ASSERT `s 869(5) the registrar must give a certificate of the registration of the charge, stating the amount secured by the charge` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 869(5) the registrar must give a certificate of the registration of the charge, stating the amount secured by the charge` FALSE EQUALS JUST FALSE; s 869(5): the duty is laid on a charge registered in pursuance of this Chapter; the text says nothing of another charge, so NOTHING
#ASSERT `s 869(5) the registrar must give a certificate of the registration of the charge, stating the amount secured by the charge` FALSE EQUALS NOTHING
#ASSERT `s 869(6)(a) the certificate is signed or authenticated as the paragraph requires` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 869(6)(a) the certificate is signed or authenticated as the paragraph requires` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 869(6)(a) the certificate is signed or authenticated as the paragraph requires` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 869(6)(a) the certificate is signed or authenticated as the paragraph requires` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 869(6)(b) the certificate is conclusive evidence that the requirements of Chapter 1 as to registration have been satisfied` TRUE EQUALS JUST TRUE
#ASSERT `s 869(6)(b) the certificate is conclusive evidence that the requirements of Chapter 1 as to registration have been satisfied` FALSE EQUALS NOTHING
#ASSERT `s 869(7) the register is open to inspection by any person` TRUE EQUALS JUST TRUE
#ASSERT `s 869(7) the register is open to inspection by any person` FALSE EQUALS NOTHING

§§ `s 870 The period allowed for registration`
-- (1) 21 days beginning with the day after the charge is created; for a charge created outside the UK, after the day the instrument could have been received in the UK
#ASSERT `s 870(1) the last day of the period allowed for registration of a charge created by a company` FALSE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 22 3 2025
#ASSERT `s 870(1) the last day of the period allowed for registration of a charge created by a company` TRUE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 31 3 2025
#ASSERT `s 870(1) the last day of the period allowed for registration of a charge created by a company` FALSE (Date 10 12 2025) (Date 1 1 2026) EQUALS Date 31 12 2025
-- (2) the acquisition completed; the property and the charge outside the UK
#ASSERT `s 870(2) the last day of the period allowed for registration of a charge to which property acquired by a company is subject` FALSE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 22 3 2025
#ASSERT `s 870(2) the last day of the period allowed for registration of a charge to which property acquired by a company is subject` TRUE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 31 3 2025
-- (3) a series of debentures: the deed executed, or if no deed the first debenture executed
#ASSERT `s 870(3) the last day of the period allowed for registration of particulars of a series of debentures` TRUE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 22 3 2025
#ASSERT `s 870(3) the last day of the period allowed for registration of particulars of a series of debentures` FALSE (Date 1 3 2025) (Date 10 3 2025) EQUALS Date 31 3 2025

§§ `s 871 Registration of enforcement of security`
#ASSERT `s 871(1) the person must give notice of the fact to the registrar within 7 days` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 871(1) the person must give notice of the fact to the registrar within 7 days` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 871(1) the person must give notice of the fact to the registrar within 7 days` FALSE FALSE EQUALS JUST FALSE
-- within 7 days of the order: order on 1 March 2025, last day 8 March 2025
#ASSERT `s 871(1) the person gave the registrar notice within 7 days` (Date 1 3 2025) (JUST (Date 8 3 2025)) (Date 20 3 2025) EQUALS JUST TRUE
#ASSERT `s 871(1) the person gave the registrar notice within 7 days` (Date 1 3 2025) (JUST (Date 9 3 2025)) (Date 20 3 2025) EQUALS JUST FALSE
#ASSERT `s 871(1) the person gave the registrar notice within 7 days` (Date 1 3 2025) NOTHING (Date 8 3 2025) EQUALS NOTHING
#ASSERT `s 871(1) the person gave the registrar notice within 7 days` (Date 1 3 2025) NOTHING (Date 9 3 2025) EQUALS JUST FALSE
#ASSERT `s 871(2) the person must, on so ceasing, give the registrar notice to that effect` TRUE EQUALS JUST TRUE
#ASSERT `s 871(2) the person must, on so ceasing, give the registrar notice to that effect` FALSE EQUALS JUST FALSE
#ASSERT `s 871(3) the registrar must enter the fact in the register of charges` TRUE EQUALS JUST TRUE
#ASSERT `s 871(3) the registrar must enter the fact in the register of charges` FALSE EQUALS NOTHING
-- (4) default in complying with the requirements of the section
#ASSERT `s 871(4) the person commits an offence` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 871(4) the person commits an offence` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 871(4) the person commits an offence` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 871(4) the person commits an offence` (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 871(4) the person commits an offence` NOTHING NOTHING TRUE EQUALS NOTHING
#ASSERT (`s 871(5) the penalty for the offence`'s `fine not exceeding`) EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 1)
#ASSERT (`s 871(5) the penalty for the offence`'s `daily default fine for continued contravention`) EQUALS JUST (`a fine not exceeding a level on the standard scale` 3 0.1)

§§ `s 872 Entries of satisfaction and release`
#ASSERT `s 872(1) subsection (2) applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 872(1) subsection (2) applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 872(1) subsection (2) applies` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 872(2) the registrar may enter a memorandum of satisfaction or of release on the register` (JUST TRUE) EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 872(2) the registrar may enter a memorandum of satisfaction or of release on the register` (JUST FALSE) EQUALS JUST FALSE; s 872(2): the power is given on the gate quoted and the text does not say the person has none otherwise, so NOTHING (name-test sweep: a grant is not turned into a bar)
#ASSERT `s 872(2) the registrar may enter a memorandum of satisfaction or of release on the register` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 872(2) the registrar may enter a memorandum of satisfaction or of release on the register` NOTHING EQUALS NOTHING
#ASSERT `s 872(3) the registrar must send the company a copy of the memorandum` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 872(3) the registrar must send the company a copy of the memorandum` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 872(3) the registrar must send the company a copy of the memorandum` FALSE TRUE EQUALS JUST FALSE

§§ `s 873 Rectification of register of charges`
#ASSERT `s 873(1) subsection (2) applies` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 873(1) subsection (2) applies` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 873(1) subsection (2) applies` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 873(1) subsection (2) applies` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 873(2) the court may make the order` (JUST TRUE) TRUE `s 873(2) an order that the period allowed for registration shall be extended` EQUALS JUST TRUE
#ASSERT `s 873(2) the court may make the order` (JUST TRUE) TRUE `s 873(2) an order that the omission or mis-statement shall be rectified` EQUALS JUST TRUE
#ASSERT `s 873(2) the court may make the order` (JUST TRUE) TRUE `s 873(2) any other order` EQUALS NOTHING
#ASSERT `s 873(2) the court may make the order` (JUST TRUE) FALSE `s 873(2) an order that the period allowed for registration shall be extended` EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 873(2) the court may make the order` (JUST FALSE) TRUE `s 873(2) an order that the period allowed for registration shall be extended` EQUALS JUST FALSE; s 873(2): the power is given on the gate quoted and the text does not say the person has none otherwise, so NOTHING (name-test sweep: a grant is not turned into a bar)
#ASSERT `s 873(2) the court may make the order` (JUST FALSE) TRUE `s 873(2) an order that the period allowed for registration shall be extended` EQUALS NOTHING
#ASSERT `s 873(2) the court may make the order` NOTHING TRUE `s 873(2) an order that the period allowed for registration shall be extended` EQUALS NOTHING
#ASSERT `s 873(2) the last day of the period allowed for registration as extended` (Date 22 3 2025) NOTHING EQUALS Date 22 3 2025
#ASSERT `s 873(2) the last day of the period allowed for registration as extended` (Date 22 3 2025) (JUST (Date 30 6 2025)) EQUALS Date 30 6 2025

§§ `s 874 Consequence of failure to register charges created by a company`
-- (1) void against a liquidator, an administrator and a creditor unless section 860 is complied with
#ASSERT `s 874(1) the charge is void against the party` TRUE FALSE `s 874(1)(a) a liquidator of the company` EQUALS JUST TRUE
#ASSERT `s 874(1) the charge is void against the party` TRUE FALSE `s 874(1)(b) an administrator of the company` EQUALS JUST TRUE
#ASSERT `s 874(1) the charge is void against the party` TRUE FALSE `s 874(1)(c) a creditor of the company` EQUALS JUST TRUE
#ASSERT `s 874(1) the charge is void against the party` TRUE FALSE `s 874(1) any other person` EQUALS NOTHING
#ASSERT `s 874(1) the charge is void against the party` TRUE TRUE `s 874(1)(c) a creditor of the company` EQUALS JUST FALSE
#ASSERT `s 874(1) the charge is void against the party` FALSE FALSE `s 874(1)(c) a creditor of the company` EQUALS JUST FALSE
-- (2) subject to the provisions of this Chapter
#ASSERT `s 874(2) the charge is void against the party, subject to the provisions of Chapter 1` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 874(2) the charge is void against the party, subject to the provisions of Chapter 1` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 874(2) the charge is void against the party, subject to the provisions of Chapter 1` (JUST FALSE) FALSE EQUALS JUST FALSE
-- (3) without prejudice to the contract; the money immediately becomes payable
#ASSERT `s 874(3) subsection (1) prejudices the contract or obligation for repayment of the money secured by the charge` TRUE EQUALS JUST FALSE
#ASSERT `s 874(3) subsection (1) prejudices the contract or obligation for repayment of the money secured by the charge` FALSE EQUALS NOTHING
#ASSERT `s 874(3) the money secured by the charge immediately becomes payable` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 874(3) the money secured by the charge immediately becomes payable` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 874(3) the money secured by the charge immediately becomes payable` NOTHING EQUALS NOTHING

§§ `s 875 Companies to keep copies of instruments creating charges`
#ASSERT `s 875(1) the company must keep a copy of the instrument available for inspection` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 875(1) the company must keep a copy of the instrument available for inspection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 875(1) the company must keep a copy of the instrument available for inspection` FALSE FALSE EQUALS NOTHING
#ASSERT `s 875(2) a copy of one of the debentures is sufficient` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 875(2) a copy of one of the debentures is sufficient` TRUE FALSE EQUALS NOTHING
#ASSERT `s 875(2) a copy of one of the debentures is sufficient` FALSE TRUE EQUALS JUST FALSE

§§ `s 876 Company's register of charges`
#ASSERT `s 876(1) the company must enter the charge in its register of charges` TRUE `s 876(1)(a) a charge specifically affecting property of the company` EQUALS JUST TRUE
#ASSERT `s 876(1) the company must enter the charge in its register of charges` TRUE `s 876(1)(b) a floating charge on the whole or part of the company's property or undertaking` EQUALS JUST TRUE
#ASSERT `s 876(1) the company must enter the charge in its register of charges` TRUE `s 876(1) any other charge` EQUALS NOTHING
