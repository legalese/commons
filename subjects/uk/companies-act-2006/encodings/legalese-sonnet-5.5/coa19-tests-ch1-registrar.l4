#ASSERT `s 876(2) the entry must give the item` `s 876(2) the names of the persons entitled to it` TRUE EQUALS JUST FALSE
#ASSERT `s 876(2) the entry must give the item` `s 876(2) any other item` FALSE EQUALS NOTHING
-- (3) an officer who knowingly and wilfully authorises or permits the omission of an entry
#ASSERT `s 876(3) the officer commits an offence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 876(3) the officer commits an offence` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 876(3) the officer commits an offence` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 876(3) the officer commits an offence` NOTHING TRUE EQUALS NOTHING
#ASSERT (count (`s 876(4) the penalties for the offence`)) EQUALS 2

