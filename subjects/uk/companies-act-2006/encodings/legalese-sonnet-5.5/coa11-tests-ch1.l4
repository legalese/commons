IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa11-part16-ch1`

-- coa11-tests-ch1.l4: tests for coa11-part16-ch1.l4 (ss 475 to 484).
-- Every expected value below is written by hand from the text of the section named beside it, before the run; none was
-- copied from the encoding's own output.  Argument order is the order of the function's GIVEN.

§ `Tests: Part 16 Chapter 1`

§§ `s 475(1): must the accounts be audited`

-- "must be audited ... unless the company is exempt under 477, 479A or 480 or exempt from Part 16 under 482"
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE  -- no exemption: must be audited
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- exempt under 477
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- exempt under 479A
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- exempt under 480
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE  -- exempt under 482
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (NOTHING) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING  -- not covered: an exemption answer is unknown
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (JUST FALSE) (JUST FALSE) (JUST FALSE) (NOTHING) EQUALS NOTHING  -- not covered
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (NOTHING) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- exempt under 479A whatever 477 says
#ASSERT `s 475(1) the company's annual accounts for the financial year must be audited in accordance with Part 16` (NOTHING) (NOTHING) (NOTHING) (NOTHING) EQUALS NOTHING  -- nothing known

§§ `s 475(2): the directors' statement (both printed versions)`

-- first printed version: "unless its balance sheet contains a statement by the directors to that effect"
#ASSERT `s 475(2) (first printed version) the company is barred from the exemption for want of the directors' statement` TRUE EQUALS JUST FALSE  -- statement there: not barred
#ASSERT `s 475(2) (first printed version) the company is barred from the exemption for want of the directors' statement` FALSE EQUALS JUST TRUE  -- no statement: barred
-- second printed version: statement (a) identifying the exemption and (b) confirming that the company qualifies
#ASSERT `s 475(2) (second printed version) the company is barred from the exemption for want of the directors' statement` TRUE TRUE EQUALS JUST FALSE  -- both limbs: not barred
#ASSERT `s 475(2) (second printed version) the company is barred from the exemption for want of the directors' statement` TRUE FALSE EQUALS JUST TRUE  -- limb (b) missing: barred
#ASSERT `s 475(2) (second printed version) the company is barred from the exemption for want of the directors' statement` FALSE TRUE EQUALS JUST TRUE  -- limb (a) missing: barred
#ASSERT `s 475(2) (second printed version) the company is barred from the exemption for want of the directors' statement` FALSE FALSE EQUALS JUST TRUE  -- neither: barred

§§ `s 475(3): the statements about the members' right and the directors' responsibilities`

#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the small companies exemption (section 477)` TRUE TRUE EQUALS JUST FALSE  -- both statements, 477: not barred
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the small companies exemption (section 477)` FALSE TRUE EQUALS JUST TRUE  -- (a) missing
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the small companies exemption (section 477)` TRUE FALSE EQUALS JUST TRUE  -- (b) missing
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the subsidiary companies exemption (section 479A)` TRUE TRUE EQUALS JUST FALSE  -- 479A is mentioned in (1)(a)
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the subsidiary companies exemption (section 479A)` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the dormant companies exemption (section 480)` TRUE TRUE EQUALS JUST FALSE  -- 480 is mentioned in (1)(a)
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the dormant companies exemption (section 480)` TRUE FALSE EQUALS JUST TRUE
-- not covered: section 482 is mentioned in (1)(b), not in (1)(a), so subsection (3) says nothing of it
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the public sector audit exemption (section 482)` TRUE TRUE EQUALS NOTHING
#ASSERT `s 475(3) the company is barred from the exemption for want of the directors' statements` `s 475 the public sector audit exemption (section 482)` FALSE FALSE EQUALS NOTHING

§§ `s 475(4): where the statement must appear`

#ASSERT `s 475(4) the statement appears on the balance sheet above the signature required by section 414` TRUE EQUALS JUST TRUE
#ASSERT `s 475(4) the statement appears on the balance sheet above the signature required by section 414` FALSE EQUALS JUST FALSE  -- "must appear ... above the signature"

§§ `s 475(2) to (4): the exemption in force once the restrictions are taken together`

#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (LIST (JUST FALSE), (JUST FALSE)) (JUST TRUE) EQUALS JUST TRUE  -- own conditions hold, no bar, statement placed
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (LIST (JUST FALSE), (JUST TRUE)) (JUST TRUE) EQUALS JUST FALSE  -- a bar applies
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (LIST (JUST FALSE), (JUST FALSE)) (JUST FALSE) EQUALS JUST FALSE  -- statement misplaced
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST FALSE) (LIST (JUST FALSE), (JUST FALSE)) (JUST TRUE) EQUALS JUST FALSE  -- own conditions fail
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (LIST (JUST FALSE), NOTHING) (JUST TRUE) EQUALS NOTHING  -- a bar is not known
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` NOTHING (LIST (JUST FALSE), (JUST FALSE)) (JUST TRUE) EQUALS NOTHING  -- own conditions not known
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (LIST (JUST FALSE), (JUST FALSE)) NOTHING EQUALS NOTHING  -- placement not known
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST FALSE) (LIST (JUST FALSE), NOTHING) (JUST TRUE) EQUALS JUST FALSE  -- a known "no" beats an unknown bar
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` NOTHING (LIST (JUST TRUE), NOTHING) (JUST TRUE) EQUALS JUST FALSE  -- a bar that applies beats an unknown condition
#ASSERT `s 475(2) to (4) the exemption is in force once the restrictions on it are taken together` (JUST TRUE) (EMPTY) (JUST TRUE) EQUALS JUST TRUE  -- no bars to check (the s 482 case)

§§ `s 476: the members' right to require an audit`

-- s 476(2)(a): "not less in total than 10%" of the nominal value of the issued share capital, or of any class of it
#ASSERT `s 476(2) the notice is given by enough members` TRUE 0.1 0 0 EQUALS JUST TRUE  -- exactly 10% of the capital
#ASSERT `s 476(2) the notice is given by enough members` TRUE 0.09 0.1 0 EQUALS JUST TRUE  -- 10% of one class
#ASSERT `s 476(2) the notice is given by enough members` TRUE 0.09 0.09 0 EQUALS JUST FALSE  -- just under 10% on both measures
#ASSERT `s 476(2) the notice is given by enough members` TRUE 0.1 0.1 1 EQUALS JUST TRUE
-- s 476(2)(b): no share capital: "not less than 10% in number of the members"
#ASSERT `s 476(2) the notice is given by enough members` FALSE 0 0 0.1 EQUALS JUST TRUE  -- exactly 10% in number
#ASSERT `s 476(2) the notice is given by enough members` FALSE 0 0 0.09 EQUALS JUST FALSE
#ASSERT `s 476(2) the notice is given by enough members` FALSE 0.5 0.5 0.05 EQUALS JUST FALSE  -- the capital measures are irrelevant to a company with no share capital
-- s 476(3): "not later than one month before the end of that year"
#ASSERT `s 476(3) the last day on which the notice may be given` (Date 31 12 2024) EQUALS Date 30 11 2024
#ASSERT `s 476(3) the last day on which the notice may be given` (Date 31 3 2025) EQUALS Date 28 2 2025  -- capped at the end of a shorter month (fork F6)
#ASSERT `s 476(3) the last day on which the notice may be given` (Date 31 3 2024) EQUALS Date 29 2 2024  -- leap year
#ASSERT `s 476(3) the last day on which the notice may be given` (Date 30 6 2025) EQUALS Date 30 5 2025
#ASSERT `s 476(3) the last day on which the notice may be given` (Date 31 1 2025) EQUALS Date 31 12 2024  -- across the new year
-- the financial year 1 January 2024 to 31 December 2024
#ASSERT `s 476(3) the notice is given in time` (Date 1 1 2024) (Date 31 12 2024) (Date 31 12 2023) EQUALS JUST FALSE  -- "may not be given before the financial year"
#ASSERT `s 476(3) the notice is given in time` (Date 1 1 2024) (Date 31 12 2024) (Date 1 1 2024) EQUALS JUST TRUE  -- first day of the year
#ASSERT `s 476(3) the notice is given in time` (Date 1 1 2024) (Date 31 12 2024) (Date 30 11 2024) EQUALS JUST TRUE  -- last day for the notice
#ASSERT `s 476(3) the notice is given in time` (Date 1 1 2024) (Date 31 12 2024) (Date 1 12 2024) EQUALS JUST FALSE  -- one day too late
#ASSERT `s 476(3) the notice is given in time` (Date 1 1 2024) (Date 31 12 2024) (Date 31 12 2024) EQUALS JUST FALSE  -- the last day of the year
-- s 476(1): the right
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE  -- not enough members
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- out of time
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING  -- not a company that would otherwise be entitled: the grant does not reach it
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 476(1) the members may by notice require the company to obtain an audit of its accounts for the financial year` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING

§§ `s 477: small companies`

#ASSERT `s 477(1) the company is exempt from audit under section 477` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 477(1) the company is exempt from audit under section 477` (JUST FALSE) EQUALS JUST FALSE  -- this section gives no exemption on these facts
#ASSERT `s 477(1) the company is exempt from audit under section 477` NOTHING EQUALS NOTHING  -- section 382 not known
