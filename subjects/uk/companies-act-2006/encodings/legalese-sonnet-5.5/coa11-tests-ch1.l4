#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- barred by s 478
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- barred by s 479
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- no s 475(2) statement
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- no s 475(3) statements
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- statement misplaced (s 475(4))
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE  -- members required an audit (s 476)
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- not a small company
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING  -- section 382 not known
#ASSERT `s 477(5) the company is entitled to the exemption conferred by section 477` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING  -- group position not known

