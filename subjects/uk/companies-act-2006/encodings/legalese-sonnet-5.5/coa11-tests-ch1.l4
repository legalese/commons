#ASSERT `s 478 the company is barred from the small companies exemption` TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (a) a public company
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(i) authorised insurance company
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(i) banking company
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(i) e-money issuer
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(i) MiFID investment firm
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(i) UCITS management company
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b)(ii) insurance market activity
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE  -- (b)(iii) Master Trust scheme funder
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE TRUE FALSE EQUALS JUST TRUE  -- (c) special register body
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE  -- (c) employers' association
#ASSERT `s 478 the company is barred from the small companies exemption` FALSE FALSE FALSE NOTHING (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS NOTHING  -- not covered: a borrowed term is not known
#ASSERT `s 478 the company is barred from the small companies exemption` TRUE FALSE FALSE NOTHING NOTHING NOTHING FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- a listed kind that holds beats an unknown one

§§ `s 479: group companies`

#ASSERT `s 479(4)(a) the company is a group company` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE  -- a parent company
#ASSERT `s 479(4)(a) the company is a group company` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE  -- a subsidiary undertaking
#ASSERT `s 479(4)(a) the company is a group company` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- "means a company that is a parent company or a subsidiary undertaking"
#ASSERT `s 479(4)(a) the company is a group company` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 479(4)(a) the company is a group company` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 479(4)(a) the company is a group company` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 479(4) the two undertakings are associated` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE  -- one is a subsidiary undertaking of the other
#ASSERT `s 479(4) the two undertakings are associated` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE  -- both are subsidiary undertakings of a third
#ASSERT `s 479(4) the two undertakings are associated` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 479(4) the two undertakings are associated` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 479(4)(b) the undertaking belongs to the group of the group company` TRUE (JUST FALSE) EQUALS JUST TRUE  -- the company itself
#ASSERT `s 479(4)(b) the undertaking belongs to the group of the group company` FALSE (JUST TRUE) EQUALS JUST TRUE  -- an associated undertaking
#ASSERT `s 479(4)(b) the undertaking belongs to the group of the group company` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 479(4)(b) the undertaking belongs to the group of the group company` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 479(6) the body is treated as a company for the purposes of section 479(5)` TRUE EQUALS JUST TRUE
#ASSERT `s 479(6) the body is treated as a company for the purposes of section 479(5)` FALSE EQUALS NOTHING  -- a body outside the group: not covered
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- not dormant throughout: the if is not met
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE  -- not a subsidiary undertaking throughout
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` (JUST FALSE) NOTHING EQUALS JUST FALSE  -- one limb fails, whatever the other is
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` (JUST TRUE) NOTHING EQUALS NOTHING  -- dormancy not known
#ASSERT `s 479(3) subsection (3) applies: the company is not excluded by subsection (1)` NOTHING NOTHING EQUALS NOTHING
-- s 479(1): arguments: group company, small group (s 383), ineligible group (s 384(2),(3)), subsection (3) applies
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- not a group company: the bar does not reach it
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE  -- unless (a): small group and not ineligible
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE  -- (b) subsection (3) applies
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE  -- group is not small
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE  -- ineligible group
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING  -- section 383 not known
-- (expectation corrected on re-reading the text, see NOTES finding 10: the "unless" of (a) is met, so the bar is lifted whether or not the company is shown to be a group company)
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING  -- group status not known and (a) not met
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING  -- whether (3) applies is not known
#ASSERT `s 479(1) the company is barred from the small companies exemption as a group company` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST FALSE  -- (a) is met, so the bar is lifted whatever (3) says

§§ `s 479A: subsidiary companies`

#ASSERT `s 479A(1) the company is within the subsidiary companies audit exemption` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 479A(1) the company is within the subsidiary companies audit exemption` TRUE FALSE EQUALS JUST FALSE  -- parent not established in the UK: this section gives no exemption
#ASSERT `s 479A(1) the company is within the subsidiary companies audit exemption` FALSE TRUE EQUALS JUST FALSE  -- not itself a subsidiary undertaking
-- s 479A(2)(e): five documents, each on or before the date the directors file the accounts (filed 30 September 2025)
#ASSERT `s 479A(2)(e) one document was delivered on or before the date the directors file the accounts` (JUST (Date 30 9 2025)) (JUST (Date 30 9 2025)) EQUALS JUST TRUE  -- the same day
#ASSERT `s 479A(2)(e) one document was delivered on or before the date the directors file the accounts` (JUST (Date 30 9 2025)) (JUST (Date 1 9 2025)) EQUALS JUST TRUE
#ASSERT `s 479A(2)(e) one document was delivered on or before the date the directors file the accounts` (JUST (Date 30 9 2025)) (JUST (Date 1 10 2025)) EQUALS JUST FALSE  -- a day late
#ASSERT `s 479A(2)(e) one document was delivered on or before the date the directors file the accounts` (JUST (Date 30 9 2025)) NOTHING EQUALS JUST FALSE  -- never delivered
#ASSERT `s 479A(2)(e) one document was delivered on or before the date the directors file the accounts` NOTHING (JUST (Date 1 9 2025)) EQUALS NOTHING  -- accounts not yet filed
`coa11 test deliveries on time` MEANS `s 479A(2)(e) documents delivered to the registrar` OF (JUST (Date 30 9 2025)), (JUST (Date 1 9 2025)), (JUST (Date 30 9 2025)), (JUST (Date 15 9 2025)), (JUST (Date 20 9 2025)), (JUST (Date 30 9 2025))
`coa11 test deliveries one late` MEANS `s 479A(2)(e) documents delivered to the registrar` OF (JUST (Date 30 9 2025)), (JUST (Date 1 9 2025)), (JUST (Date 30 9 2025)), (JUST (Date 15 9 2025)), (JUST (Date 1 10 2025)), (JUST (Date 30 9 2025))
`coa11 test deliveries one missing` MEANS `s 479A(2)(e) documents delivered to the registrar` OF (JUST (Date 30 9 2025)), (JUST (Date 1 9 2025)), NOTHING, (JUST (Date 15 9 2025)), (JUST (Date 20 9 2025)), (JUST (Date 30 9 2025))
`coa11 test deliveries not yet filed` MEANS `s 479A(2)(e) documents delivered to the registrar` OF NOTHING, (JUST (Date 1 9 2025)), (JUST (Date 1 9 2025)), (JUST (Date 1 9 2025)), (JUST (Date 1 9 2025)), (JUST (Date 1 9 2025))
#ASSERT `s 479A(2)(e) the five documents were delivered on or before the date the directors file the accounts` `coa11 test deliveries on time` EQUALS JUST TRUE
#ASSERT `s 479A(2)(e) the five documents were delivered on or before the date the directors file the accounts` `coa11 test deliveries one late` EQUALS JUST FALSE
#ASSERT `s 479A(2)(e) the five documents were delivered on or before the date the directors file the accounts` `coa11 test deliveries one missing` EQUALS JUST FALSE
#ASSERT `s 479A(2)(e) the five documents were delivered on or before the date the directors file the accounts` `coa11 test deliveries not yet filed` EQUALS NOTHING  -- not covered
-- s 479A(2): arguments: members agree, guarantee given, included in consolidated accounts, parent is a company, Part 15, legal requirements, UK-adopted IAS, disclosure in notes, (e)
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST TRUE  -- parent a company, Part 15
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE  -- parent a company, UK-adopted IAS
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST TRUE  -- parent not a company, its own legal requirements
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE  -- parent not a company, UK-adopted IAS
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE FALSE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE  -- a parent that is a company must follow Part 15 or the IAS, not "the legal requirements"
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE FALSE TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE  -- a parent that is not a company need not satisfy Part 15
#ASSERT `s 479A(2) the conditions of the exemption are complied with` FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE  -- (a) not all members agree
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE  -- (b) no guarantee
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE  -- (c) not included in the consolidated accounts
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE  -- (d) no disclosure in the notes
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE  -- (e) a document late or missing
#ASSERT `s 479A(2) the conditions of the exemption are complied with` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS NOTHING  -- (e) not yet decidable
#ASSERT `s 479A(2) the conditions of the exemption are complied with` FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE  -- a known failure beats an undecided (e)
-- s 479A(3): arguments: (1), (2), 479B bar, 475(2) bar, 475(3) bar, 475(4), notice
#ASSERT `s 479A(3) the company is entitled to the exemption conferred by section 479A` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 479A(3) the company is entitled to the exemption conferred by section 479A` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE  -- not within (1)
