§§ `s 479C: parent undertaking declaration of guarantee`

#ASSERT `s 479C(1) a guarantee is given by the parent undertaking` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 479C(1) a guarantee is given by the parent undertaking` TRUE FALSE EQUALS JUST FALSE  -- the statement does not say the parent guarantees the subsidiary
#ASSERT `s 479C(1) a guarantee is given by the parent undertaking` FALSE TRUE EQUALS JUST FALSE  -- not delivered to the registrar
-- s 479C(2): arguments: authenticated, parent has a registered number, names the parent, gives the parent's number, names and numbers the subsidiary, date, financial year
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 479C(2) the statement meets the requirements` TRUE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE  -- "(if any)": a parent with no registered number need not give one
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE  -- a parent with a registered number must give it
#ASSERT `s 479C(2) the statement meets the requirements` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE  -- not authenticated
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE  -- (a) the parent's name missing
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE  -- (d) the subsidiary missing
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE  -- (e) the date missing
#ASSERT `s 479C(2) the statement meets the requirements` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE  -- (f) the financial year missing
-- s 479C(3): the effect
#ASSERT `s 479C(3)(a) the parent undertaking guarantees the liability` TRUE TRUE FALSE EQUALS JUST TRUE  -- outstanding at the end of the year, not yet satisfied
#ASSERT `s 479C(3)(a) the parent undertaking guarantees the liability` TRUE TRUE TRUE EQUALS JUST FALSE  -- "until they are satisfied in full"
#ASSERT `s 479C(3)(a) the parent undertaking guarantees the liability` TRUE FALSE FALSE EQUALS NOTHING  -- a liability not outstanding at the end of the year: not covered
#ASSERT `s 479C(3)(a) the parent undertaking guarantees the liability` FALSE TRUE FALSE EQUALS NOTHING  -- no guarantee given: not covered
#ASSERT `s 479C(3)(b) the person may enforce the guarantee against the parent undertaking` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 479C(3)(b) the person may enforce the guarantee against the parent undertaking` TRUE FALSE EQUALS NOTHING  -- not a person to whom the subsidiary is liable: not covered
#ASSERT `s 479C(3)(b) the person may enforce the guarantee against the parent undertaking` FALSE TRUE EQUALS NOTHING

