IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa8-part14-remedies`

-- Tests of ss 369 to 373 (liability of directors for an unauthorised donation or expenditure; the shareholder action).
-- Every expected value was written from the text before the run.

-- s 369(1): applies where a company has made a donation or incurred expenditure without the authorisation required
#ASSERT `s 369(1) section 369 applies` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 369(1) section 369 applies` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 369(1) section 369 applies` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 369(1) section 369 applies` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 369(1) section 369 applies` FALSE NOTHING EQUALS JUST FALSE

-- s 369(4): the same three limbs as s 366(4)
#ASSERT `s 369(4) the other company is a relevant holding company` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 369(4) the other company is a relevant holding company` (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 369(4) the other company is a relevant holding company` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE

-- s 369(3): (a) the company's own directors at the time; (b) where the company was a subsidiary of a relevant holding company and its directors failed to take all reasonable steps, the directors of that company
#ASSERT `s 369(3) the person is one of the directors in default` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 369(3) the person is one of the directors in default` (JUST FALSE) (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 369(3) the person is one of the directors in default` (JUST FALSE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 369(3) the person is one of the directors in default` (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 369(3) the person is one of the directors in default` (JUST FALSE) (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 369(3) the person is one of the directors in default` NOTHING (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 369(3) the person is one of the directors in default` NOTHING (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 369(3) the person is one of the directors in default` (JUST FALSE) NOTHING (JUST TRUE) TRUE EQUALS NOTHING

-- s 369(2): a director in default of an unauthorised donation is jointly and severally liable
#ASSERT `s 369(2) the person is jointly and severally liable to make good and to compensate the company` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 369(2) the person is jointly and severally liable to make good and to compensate the company` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 369(2) the person is jointly and severally liable to make good and to compensate the company` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 369(2) the person is jointly and severally liable to make good and to compensate the company` NOTHING (JUST TRUE) EQUALS NOTHING

-- s 369(6): only the unauthorised part; s 369(2)(a) and (b); s 369(5)
#ASSERT `s 369(6) the amount of the donation or expenditure to which this section applies` 10000 4000 EQUALS 6000
#ASSERT `s 369(6) the amount of the donation or expenditure to which this section applies` 10000 10000 EQUALS 0
#ASSERT `s 369(6) the amount of the donation or expenditure to which this section applies` 10000 12000 EQUALS 0
#ASSERT `s 369(2)(a) the amount of the unauthorised donation or expenditure still to be made good to the company` 6000 1500 EQUALS 4500
#ASSERT `s 369(2)(a) the amount of the unauthorised donation or expenditure still to be made good to the company` 6000 6000 EQUALS 0
#ASSERT `s 369(2)(a) the amount of the unauthorised donation or expenditure still to be made good to the company` 6000 7000 EQUALS 0
#ASSERT `s 369(2)(b) the amount to compensate the company for loss or damage` 700 EQUALS 700
#ASSERT `s 369(2)(b) the amount to compensate the company for loss or damage` 0 EQUALS 0
#ASSERT `s 369(5) the amount on which interest runs` 6000 2000 EQUALS 4000
#ASSERT `s 369(5) the amount on which interest runs` 6000 6000 EQUALS 0
#ASSERT `s 369(5)(a) the date from which interest runs` (Date 1 3 2026) (JUST (Date 1 1 2026)) EQUALS Date 1 3 2026
#ASSERT `s 369(5)(a) the date from which interest runs` (Date 1 3 2026) NOTHING EQUALS Date 1 3 2026
#ASSERT `s 369(5)(b) the rate of interest` (JUST 0.05) EQUALS JUST 0.05
#ASSERT `s 369(5)(b) the rate of interest` NOTHING EQUALS NOTHING

-- s 370(3): an authorised group is (a) 5% of the nominal value of issued share capital, (b) if not limited by shares, 5% of the members, (c) 50 members
#ASSERT `s 370(3) the members are an authorised group` 50 1000 TRUE 3 100 EQUALS JUST TRUE
#ASSERT `s 370(3) the members are an authorised group` 49 1000 TRUE 3 100 EQUALS JUST FALSE
#ASSERT `s 370(3) the members are an authorised group` 0 0 FALSE 5 100 EQUALS JUST TRUE
#ASSERT `s 370(3) the members are an authorised group` 0 0 FALSE 4 100 EQUALS JUST FALSE
#ASSERT `s 370(3) the members are an authorised group` 0 0 TRUE 5 100 EQUALS JUST FALSE
#ASSERT `s 370(3) the members are an authorised group` 0 1000 TRUE 50 10000 EQUALS JUST TRUE
#ASSERT `s 370(3) the members are an authorised group` 0 1000 TRUE 49 10000 EQUALS JUST FALSE
#ASSERT `s 370(3) the members are an authorised group` 10 0 FALSE 1 0 EQUALS JUST FALSE

-- s 370(1)(a), (1)(b), (2), (4), (5)
#ASSERT `s 370(1)(a) the liability is enforceable in the name of the company by the group` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 370(1)(a) the liability is enforceable in the name of the company by the group` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 370(1)(a) the liability is enforceable in the name of the company by the group` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 370(1)(a) the liability is enforceable in the name of the company by the group` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 370(1)(b) the liability is enforceable in the name of the subsidiary by the group` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 370(1)(b) the liability is enforceable in the name of the subsidiary by the group` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 370(1)(b) the liability is enforceable in the name of the subsidiary by the group` TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 370(1)(b) the liability is enforceable in the name of the subsidiary by the group` TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 370(1)(b) the liability is enforceable in the name of the subsidiary by the group` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 370(2) the company may itself bring proceedings to enforce the liability` TRUE EQUALS JUST TRUE
#ASSERT `s 370(2) the company may itself bring proceedings to enforce the liability` FALSE EQUALS NOTHING
#ASSERT `s 370(4) the group may bring proceedings under section 370` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 370(4) the group may bring proceedings under section 370` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 370(4) the group may bring proceedings under section 370` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 370(4) the group may bring proceedings under section 370` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 370(5) the member's right to bring or continue proceedings under Part 11 is unaffected` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 370(5) the member's right to bring or continue proceedings under Part 11 is unaffected` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 370(5) the member's right to bring or continue proceedings under Part 11 is unaffected` NOTHING EQUALS NOTHING

-- s 371(1): written notice with its three statements, and not less than 28 days between the notice (1 Jan 2026) and the proceedings
#ASSERT `s 371(1) the notice requirements are met` TRUE TRUE TRUE TRUE (Date 1 1 2026) (Date 29 1 2026) EQUALS JUST TRUE
#ASSERT `s 371(1) the notice requirements are met` TRUE TRUE TRUE TRUE (Date 1 1 2026) (Date 28 1 2026) EQUALS JUST FALSE
#ASSERT `s 371(1) the notice requirements are met` FALSE TRUE TRUE TRUE (Date 1 1 2026) (Date 29 1 2026) EQUALS JUST FALSE
#ASSERT `s 371(1) the notice requirements are met` TRUE FALSE TRUE TRUE (Date 1 1 2026) (Date 29 1 2026) EQUALS JUST FALSE
#ASSERT `s 371(1) the notice requirements are met` TRUE TRUE FALSE TRUE (Date 1 1 2026) (Date 29 1 2026) EQUALS JUST FALSE
#ASSERT `s 371(1) the notice requirements are met` TRUE TRUE TRUE FALSE (Date 1 1 2026) (Date 29 1 2026) EQUALS JUST FALSE

-- s 371(2): a director may apply within the period of 28 days beginning with the date of the notice (1 March 2026: last day 28 March)
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE TRUE (Date 1 3 2026) (Date 28 3 2026) `s 371(2)(a) the unauthorised amount has been made good to the company` EQUALS JUST TRUE
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) `s 371(2)(b) proceedings to enforce the liability have been brought, and are being pursued with due diligence, by the company` EQUALS JUST TRUE
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE TRUE (Date 1 3 2026) (Date 29 3 2026) `s 371(2)(c) the members proposing to bring proceedings do not constitute an authorised group` EQUALS JUST FALSE
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE TRUE (Date 1 3 2026) (Date 28 2 2026) `s 371(2)(a) the unauthorised amount has been made good to the company` EQUALS JUST FALSE
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` FALSE TRUE (Date 1 3 2026) (Date 10 3 2026) `s 371(2)(a) the unauthorised amount has been made good to the company` EQUALS NOTHING
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE TRUE (Date 1 3 2026) (Date 10 3 2026) `s 371(2) some other ground` EQUALS NOTHING
#ASSERT `s 371(2) the director may apply to the court for an order that the proposed proceedings shall not be brought` TRUE FALSE (Date 1 3 2026) (Date 10 3 2026) `s 371(2)(a) the unauthorised amount has been made good to the company` EQUALS JUST FALSE

-- s 371(3), (4), (5)
#ASSERT `s 371(3) the court may make the alternative directions` TRUE EQUALS JUST TRUE
#ASSERT `s 371(3) the court may make the alternative directions` FALSE EQUALS JUST FALSE
#ASSERT `s 371(4) the members owe the company the same duties as the directors would owe` TRUE EQUALS JUST TRUE
#ASSERT `s 371(4) the members owe the company the same duties as the directors would owe` FALSE EQUALS NOTHING
#ASSERT `s 371(4) the company may bring proceedings to enforce those duties` TRUE EQUALS JUST TRUE
#ASSERT `s 371(4) the company may bring proceedings to enforce those duties` FALSE EQUALS JUST FALSE
#ASSERT `s 371(5) the group may discontinue or settle the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 371(5) the group may discontinue or settle the proceedings` FALSE EQUALS JUST FALSE

-- s 372: costs
#ASSERT `s 372(1) section 372 applies to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 372(1) section 372 applies to the proceedings` FALSE EQUALS NOTHING
#ASSERT `s 372(2) the group may apply for an order that the company indemnify the group in respect of costs` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 372(2) the group may apply for an order that the company indemnify the group in respect of costs` NOTHING EQUALS NOTHING
#ASSERT `s 372(2) the group may apply for an order that the company indemnify the group in respect of costs` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 372(3) the group is entitled to be paid costs out of the assets of the company` FALSE EQUALS JUST FALSE
#ASSERT `s 372(3) the group is entitled to be paid costs out of the assets of the company` TRUE EQUALS NOTHING
#ASSERT `s 372(4)(a) the costs shall be paid to the group` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 372(4)(a) the costs shall be paid to the group` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 372(4)(a) the costs shall be paid to the group` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 372(4)(b) the costs shall be paid by the group` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 372(4)(b) the costs shall be paid by the group` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 372(4)(b) the costs shall be paid by the group` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 372(5) the word to read for costs` TRUE EQUALS JUST "expenses"
#ASSERT `s 372(5) the word to read for costs` FALSE EQUALS NOTHING
#ASSERT `s 372(5) the word to read for defendant` TRUE EQUALS JUST "defender"
#ASSERT `s 372(5) the word to read for defendant` FALSE EQUALS NOTHING

-- s 373: information
#ASSERT `s 373(1) the group is entitled to require the company to provide the information` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 373(1) the group is entitled to require the company to provide the information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(1) the group is entitled to require the company to provide the information` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 373(1) the group is entitled to require the company to provide the information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 373(2) the court may order the company and specified officers or employees to provide the information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(2) the court may order the company and specified officers or employees to provide the information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 373(2) the court may order the company and specified officers or employees to provide the information` FALSE TRUE EQUALS JUST FALSE
