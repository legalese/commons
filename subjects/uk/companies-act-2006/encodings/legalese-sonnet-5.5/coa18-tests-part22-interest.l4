IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa18-part22-interest`

-- coa18-tests-part22-interest.l4: tests for coa18-part22-interest.l4 (Companies Act 2006, ss 820 to 828).
-- Every expected value is written from the text, beside its assertion, before the run; a failing assertion is a finding.
-- Generated by work/gentests.py from work/tests/part22-interest.py (the layout only; the values are hand-written).

§§ `s 820 interest in shares: general`

-- 820(1)
#ASSERT `s 820(1) this section applies to determine whether the person has an interest in the shares` TRUE EQUALS JUST TRUE
-- 820(1): the section is for the purposes of this Part only
#ASSERT `s 820(1) this section applies to determine whether the person has an interest in the shares` FALSE EQUALS JUST FALSE
-- 820(2)(a): an interest of any kind whatsoever
#ASSERT `s 820(2)(a) the person has an interest in the shares` TRUE EQUALS JUST TRUE
-- 820(2)(a): "includes" does not close the meaning
#ASSERT `s 820(2)(a) the person has an interest in the shares` FALSE EQUALS NOTHING
-- 820(2)(b)
#ASSERT `s 820(2)(b) the restraint or restriction is disregarded` TRUE EQUALS JUST TRUE
-- 820(2)(b): nothing to disregard
#ASSERT `s 820(2)(b) the restraint or restriction is disregarded` FALSE EQUALS NOTHING
-- 820(3): a beneficiary of a trust holding an interest in shares
#ASSERT `s 820(3) the person is treated as having an interest in the shares` TRUE TRUE EQUALS JUST TRUE
-- 820(3): not a beneficiary
#ASSERT `s 820(3) the person is treated as having an interest in the shares` TRUE FALSE EQUALS JUST FALSE
-- 820(3): no interest held on trust ("Where")
#ASSERT `s 820(3) the person is treated as having an interest in the shares` FALSE TRUE EQUALS JUST FALSE
-- 820(4)(a): a contract to acquire, even as registered holder
#ASSERT `s 820(4) the person is treated as having an interest in the shares` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- 820(4)(b)(i): not the registered holder, entitled to exercise a right
#ASSERT `s 820(4) the person is treated as having an interest in the shares` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- 820(4)(b)(ii): not the registered holder, entitled to control the exercise of a right
#ASSERT `s 820(4) the person is treated as having an interest in the shares` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- 820(4)(b): "not being the registered holder": the registered holder is outside (b)
#ASSERT `s 820(4) the person is treated as having an interest in the shares` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- 820(4): neither limb
#ASSERT `s 820(4) the person is treated as having an interest in the shares` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 820(5)(a): a right whose exercise would make him so entitled
#ASSERT `s 820(5) the person is entitled to exercise or control the exercise of a right conferred by the holding of shares` TRUE FALSE EQUALS JUST TRUE
-- 820(5)(b): an obligation whose fulfilment would make him so entitled
#ASSERT `s 820(5) the person is entitled to exercise or control the exercise of a right conferred by the holding of shares` FALSE TRUE EQUALS JUST TRUE
-- 820(5): neither
#ASSERT `s 820(5) the person is entitled to exercise or control the exercise of a right conferred by the holding of shares` FALSE FALSE EQUALS JUST FALSE
-- 820(6)(a): a right to call for delivery
#ASSERT `s 820(6) the person is treated as having an interest in shares` TRUE FALSE FALSE EQUALS JUST TRUE
-- 820(6)(b): a right to acquire an interest
#ASSERT `s 820(6) the person is treated as having an interest in shares` FALSE TRUE FALSE EQUALS JUST TRUE
-- 820(6)(b): an obligation to take an interest
#ASSERT `s 820(6) the person is treated as having an interest in shares` FALSE FALSE TRUE EQUALS JUST TRUE
-- 820(6): none
#ASSERT `s 820(6) the person is treated as having an interest in shares` FALSE FALSE FALSE EQUALS JUST FALSE
-- 820(6) last sentence: conditional
#ASSERT `s 820(6) it is immaterial whether the right or obligation is conditional or absolute` TRUE EQUALS JUST TRUE
-- 820(6) last sentence: absolute
#ASSERT `s 820(6) it is immaterial whether the right or obligation is conditional or absolute` FALSE EQUALS JUST TRUE
-- 820(7)
#ASSERT `s 820(7) the persons are treated as each having that interest` TRUE EQUALS JUST TRUE
-- 820(7): no joint interest: not mentioned
#ASSERT `s 820(7) the persons are treated as each having that interest` FALSE EQUALS NOTHING
-- 820(8)
#ASSERT `s 820(8) it is immaterial that the shares are unidentifiable` TRUE EQUALS JUST TRUE
-- 820(8): identifiable shares: not mentioned
#ASSERT `s 820(8) it is immaterial that the shares are unidentifiable` FALSE EQUALS NOTHING

§§ `s 821 to s 823 right to subscribe, family and corporate interests`

-- 821(1)
#ASSERT `s 821(1) section 793 applies in relation to the person as it applies to a person who is or was interested in shares` TRUE EQUALS JUST TRUE
-- 821(1): no such right: not mentioned
#ASSERT `s 821(1) section 793 applies in relation to the person as it applies to a person who is or was interested in shares` FALSE EQUALS NOTHING
-- 821(2)
#ASSERT `s 821(2) references in section 793 to an interest in shares are read as including the right to subscribe` TRUE EQUALS JUST TRUE
-- 821(2): not mentioned
#ASSERT `s 821(2) references in section 793 to an interest in shares are read as including the right to subscribe` FALSE EQUALS NOTHING
-- 822(1)(a): spouse or civil partner
#ASSERT `s 822(1) the person is taken to be interested in the shares` TRUE FALSE EQUALS JUST TRUE
-- 822(1)(b): infant child or step-child
#ASSERT `s 822(1) the person is taken to be interested in the shares` FALSE TRUE EQUALS JUST TRUE
-- 822(1): another relative: not mentioned
#ASSERT `s 822(1) the person is taken to be interested in the shares` FALSE FALSE EQUALS NOTHING
-- 822(2): in relation to Scotland, under 18
#ASSERT `s 822(2) the person is an infant` `Scotland` 17 EQUALS JUST TRUE
-- 822(2): in relation to Scotland, 18 is not under 18
#ASSERT `s 822(2) the person is an infant` `Scotland` 18 EQUALS JUST FALSE
-- 822(2): the meaning elsewhere is not given in this Part
#ASSERT `s 822(2) the person is an infant` `England and Wales` 17 EQUALS NOTHING
-- 823(1)(a): the body is accustomed to act on his directions
#ASSERT `s 823(1) the person is taken to be interested in the shares` TRUE TRUE 0.1 EQUALS JUST TRUE
-- 823(1)(b): exactly one-third of the voting power
#ASSERT `s 823(1) the person is taken to be interested in the shares` TRUE FALSE (1 DIVIDED BY 3) EQUALS JUST TRUE
-- 823(1): below one-third and not accustomed to act
#ASSERT `s 823(1) the person is taken to be interested in the shares` TRUE FALSE 0.33 EQUALS JUST FALSE
-- 823(1): the body corporate is not interested in the shares
#ASSERT `s 823(1) the person is taken to be interested in the shares` FALSE FALSE 0.5 EQUALS JUST FALSE
-- 823(2): another body is entitled and he holds one-third of that body
#ASSERT `s 823(2) the person is treated as entitled to exercise or control the exercise of the voting power` TRUE (1 DIVIDED BY 3) EQUALS JUST TRUE
-- 823(2)(b): below one-third
#ASSERT `s 823(2) the person is treated as entitled to exercise or control the exercise of the voting power` TRUE 0.3 EQUALS JUST FALSE
-- 823(2)(a): no other body entitled
#ASSERT `s 823(2) the person is treated as entitled to exercise or control the exercise of the voting power` FALSE 0.5 EQUALS JUST FALSE
-- 823(3)(a): a right
#ASSERT `s 823(3) the person is treated as entitled to exercise or control the exercise of the voting power` TRUE FALSE EQUALS JUST TRUE
-- 823(3)(b): an obligation
#ASSERT `s 823(3) the person is treated as entitled to exercise or control the exercise of the voting power` FALSE TRUE EQUALS JUST TRUE
-- 823(3): neither
#ASSERT `s 823(3) the person is treated as entitled to exercise or control the exercise of the voting power` FALSE FALSE EQUALS JUST FALSE

§§ `s 824 agreements to acquire interests`

-- 824(1)
