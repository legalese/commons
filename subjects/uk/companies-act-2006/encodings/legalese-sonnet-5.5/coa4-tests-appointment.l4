IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-appointment`

-- coa4-tests-appointment.l4: tests for coa4-appointment.l4 (ss 157 to 161). Expected values are written from the text
-- of the section named beside each assertion, before the code was run.

-- Fixtures: a person born on 15 March 2000 attains the age of 16 years on 15 March 2016.
GIVEN d IS A DATE
GIVETH A Individual
`s 157 fixture person born on` MEANS Individual WITH `reference for the individual` IS "P", `date of birth` IS d

-- s 157(1): "A person may not be appointed a director of a company unless he has attained the age of 16 years."
-- arguments: the person; the day the appointment takes effect; whether regulations under s 158 allow it
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) FALSE EQUALS JUST TRUE
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 15 3 2016) FALSE EQUALS JUST FALSE
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 16 3 2016) FALSE EQUALS JUST FALSE
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) TRUE EQUALS NOTHING
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 15 3 2016) TRUE EQUALS JUST FALSE
-- a person aged 40 and a person who is a few weeks old
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 1 1 1980)) (Date 1 1 2020) FALSE EQUALS JUST FALSE
#ASSERT `s 157(1) section 157(1) bars the appointment of the person as a director` (`s 157 fixture person born on` (Date 1 12 2019)) (Date 1 1 2020) FALSE EQUALS JUST TRUE

-- s 157(2): "This does not affect the validity of an appointment that is not to take effect until the person appointed attains that age."
-- arguments: the person; the day the appointment is made; the day it takes effect
#ASSERT `s 157(2) section 157 does not affect the validity of the appointment made before the person attains the age of 16 years` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 1 3 2016) (Date 15 3 2016) EQUALS JUST TRUE
#ASSERT `s 157(2) section 157 does not affect the validity of the appointment made before the person attains the age of 16 years` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 1 3 2016) (Date 14 3 2016) EQUALS NOTHING
#ASSERT `s 157(2) section 157 does not affect the validity of the appointment made before the person attains the age of 16 years` (`s 157 fixture person born on` (Date 15 3 2000)) (Date 15 3 2016) (Date 20 3 2016) EQUALS NOTHING

-- s 157(3): "is not effective also to make him a director of the company until he attains the age of 16 years."
-- arguments: office held by a corporation sole or by virtue of another office; the person appointed to that other office; the day in question
#ASSERT `s 157(3) the appointment to the other office cannot yet make the person a director of the company` TRUE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) EQUALS JUST TRUE
#ASSERT `s 157(3) the appointment to the other office cannot yet make the person a director of the company` TRUE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 15 3 2016) EQUALS JUST FALSE
#ASSERT `s 157(3) the appointment to the other office cannot yet make the person a director of the company` FALSE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) EQUALS JUST FALSE

-- s 157(4): an appointment made in contravention is void.
#ASSERT `s 157(4) the appointment made is void` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 157(4) the appointment made is void` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 157(4) the appointment made is void` NOTHING EQUALS NOTHING

-- s 157(5): liability unaffected for a person who purports to act, or acts as a shadow director.
#ASSERT `s 157(5) section 157 leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 157(5) section 157 leaves the person's liability unaffected` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 157(5) section 157 leaves the person's liability unaffected` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 157(5) section 157 leaves the person's liability unaffected` FALSE FALSE TRUE EQUALS NOTHING

-- s 158(3): a person appointed by virtue of the regulations ceases to hold office when the circumstances or conditions
-- cease and the person has not since attained 16 years.
-- arguments: appointed by virtue of regulations; circumstances or conditions have ceased; the person; the day in question
#ASSERT `s 158(3) the person has ceased to hold office by virtue of that appointment` TRUE TRUE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) EQUALS JUST TRUE
#ASSERT `s 158(3) the person has ceased to hold office by virtue of that appointment` TRUE TRUE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 15 3 2016) EQUALS JUST FALSE
#ASSERT `s 158(3) the person has ceased to hold office by virtue of that appointment` FALSE TRUE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) EQUALS JUST FALSE
#ASSERT `s 158(3) the person has ceased to hold office by virtue of that appointment` TRUE FALSE (`s 157 fixture person born on` (Date 15 3 2000)) (Date 14 3 2016) EQUALS JUST FALSE

-- s 158(3A): liability unaffected for a person who has ceased and then purports to act or acts as shadow director.
#ASSERT `s 158(3A) section 158(3) leaves the person's liability unaffected` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 158(3A) section 158(3) leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 158(3A) section 158(3) leaves the person's liability unaffected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 158(3A) section 158(3) leaves the person's liability unaffected` FALSE TRUE TRUE EQUALS NOTHING

-- s 159A(2), the table, row by row, as the text prints it (typed from the table, not from the code).
#ASSERT `s 159A(2) the Part of the table in which the row appears` `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act` EQUALS `s 159A(2) Part 1`
#ASSERT `s 159A(2) the Part of the table in which the row appears` `s 159A(2) Part 1 row 6: disqualified as mentioned in section 1184` EQUALS `s 159A(2) Part 1`
#ASSERT `s 159A(2) the Part of the table in which the row appears` `s 159A(2) Part 2 row 1: a disqualification order or undertaking under the 2002 Order` EQUALS `s 159A(2) Part 2`
#ASSERT `s 159A(2) the Part of the table in which the row appears` `s 159A(2) Part 2 row 6: disqualified as mentioned in section 1184` EQUALS `s 159A(2) Part 2`
#ASSERT `s 159A(2) the circumstance in column 1 of the row` `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act` EQUALS "P is subject to a disqualification order or undertaking under the Company Directors Disqualification Act 1986."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act` EQUALS "Section 1(1), 1A(1) or 9B(4) of the 1986 Act."
#ASSERT `s 159A(2) the circumstance in column 1 of the row` `s 159A(2) Part 1 row 2: the circumstances in section 11 of the 1986 Act (bankruptcy etc)` EQUALS "Any of the circumstances mentioned in section 11 of the Company Directors Disqualification Act 1986 (bankruptcy etc) apply to P."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 2: the circumstances in section 11 of the 1986 Act (bankruptcy etc)` EQUALS "Section 11 of the 1986 Act."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 3: director disqualification sanctions (section 11A of the 1986 Act)` EQUALS "Section 15(3A) of the Sanctions and Anti-Money Laundering Act 2018 (exceptions and licences)."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 4: section 12 of the 1986 Act (revocation of administration order against an individual)` EQUALS "Section 12 of the 1986 Act."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 5: an order or undertaking mentioned in section 12A or 12B of the 1986 Act` EQUALS "Section 12A or 12B of the 1986 Act."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 1 row 6: disqualified as mentioned in section 1184` EQUALS "Section 1184(5)."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 1: a disqualification order or undertaking under the 2002 Order` EQUALS "Article 3(1), 4(1) or 13B(4) of the 2002 Order."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 2: the circumstances in Article 15 of the 2002 Order (bankruptcy etc)` EQUALS "Article 15 of the 2002 Order."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 3: director disqualification sanctions (Article 15A of the 2002 Order)` EQUALS "Section 15(3A) of the Sanctions and Anti-Money Laundering Act 2018 (exceptions and licences)."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 4: Article 16 of the 2002 Order (revocation of administration order against an individual)` EQUALS "Article 16 of the 2002 Order."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 5: an order or undertaking mentioned in Article 17 of the 2002 Order` EQUALS "Article 17 of the 2002 Order."
#ASSERT `s 159A(2) the provision in column 2 of the row` `s 159A(2) Part 2 row 6: disqualified as mentioned in section 1184` EQUALS "Section 1184(5)."

-- s 159A(2)(a) and (b): Part 1 for England and Wales and for Scotland, Part 2 for Northern Ireland.
#ASSERT `s 159A(2) the Part of the table that applies for the place` `England and Wales` EQUALS `s 159A(2) Part 1`
#ASSERT `s 159A(2) the Part of the table that applies for the place` Scotland EQUALS `s 159A(2) Part 1`
#ASSERT `s 159A(2) the Part of the table that applies for the place` `Northern Ireland` EQUALS `s 159A(2) Part 2`

-- s 159A(2): the person is disqualified if a row of the Part that applies holds and no exception for column 2 applies.
-- facts are built row by row: (the row, P is in the circumstance, an exception applies)
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act`, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act`, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act`, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` Scotland (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 2: the circumstances in section 11 of the 1986 Act (bankruptcy etc)`, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 2 row 1: a disqualification order or undertaking under the 2002 Order`, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `Northern Ireland` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 2 row 3: director disqualification sanctions (Article 15A of the 2002 Order)`, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `Northern Ireland` (LIST `s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act`, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (LIST (`s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 1: a disqualification order or undertaking under the 1986 Act`, TRUE, TRUE), (`s 159A(2) fact about a row` OF `s 159A(2) Part 1 row 6: disqualified as mentioned in section 1184`, TRUE, FALSE)) EQUALS JUST TRUE
#ASSERT `s 159A(2) the person is disqualified under the directors disqualification legislation` `England and Wales` (EMPTY) EQUALS JUST FALSE

-- s 159A(1): "may not be appointed a director of a company if the person is disqualified": the bar.
#ASSERT `s 159A(1) section 159A(1) bars the appointment of the person as a director` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 159A(1) section 159A(1) bars the appointment of the person as a director` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 159A(1) section 159A(1) bars the appointment of the person as a director` NOTHING EQUALS NOTHING

-- s 159A(3), (4)
#ASSERT `s 159A(3) the appointment made is void` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 159A(3) the appointment made is void` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 159A(3) the appointment made is void` NOTHING EQUALS NOTHING
#ASSERT `s 159A(4) section 159A leaves the person's liability unaffected` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 159A(4) section 159A leaves the person's liability unaffected` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 159A(4) section 159A leaves the person's liability unaffected` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 159A(4) section 159A leaves the person's liability unaffected` FALSE FALSE TRUE EQUALS NOTHING

-- s 160(3): approving or nominating is treated as a motion for appointment.
#ASSERT `s 160(3) the motion is treated as a motion for the person's appointment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 160(3) the motion is treated as a motion for the person's appointment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 160(3) the motion is treated as a motion for the person's appointment` FALSE FALSE EQUALS NOTHING

-- s 160(1) and (4): the bar on a single motion for two or more directors of a public company.
-- arguments: public company; motion is for two or more persons by a single resolution; resolution amends the articles; a resolution that the motion be made was first agreed without a vote against
#ASSERT `s 160(1) section 160(1) bars the motion being made` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 160(1) section 160(1) bars the motion being made` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 160(1) section 160(1) bars the motion being made` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 160(1) section 160(1) bars the motion being made` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 160(1) section 160(1) bars the motion being made` TRUE FALSE FALSE FALSE EQUALS NOTHING

-- s 160(2): void; and no automatic reappointment.
#ASSERT `s 160(2) the resolution moved is void` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 160(2) the resolution moved is void` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 160(2) the resolution moved is void` NOTHING EQUALS NOTHING
#ASSERT `s 160(2) a provision for the automatic reappointment of retiring directors in default of another appointment applies` TRUE EQUALS JUST FALSE
#ASSERT `s 160(2) a provision for the automatic reappointment of retiring directors in default of another appointment applies` FALSE EQUALS NOTHING

-- s 161(1), (2): the acts of a person acting as a director are valid despite the defects listed.
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(1)(a) a defect in the person's appointment` EQUALS JUST TRUE
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(1)(b) the person was disqualified from holding office` EQUALS JUST TRUE
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(1)(c) the person had ceased to hold office` EQUALS JUST TRUE
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(1)(d) the person was not entitled to vote on the matter in question` EQUALS JUST TRUE
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(2) the resolution for the person's appointment is void under section 160` EQUALS JUST TRUE
#ASSERT `s 161(1) the acts of the person acting as a director are valid` TRUE `s 161(1) another defect` EQUALS NOTHING
#ASSERT `s 161(1) the acts of the person acting as a director are valid` FALSE `s 161(1)(a) a defect in the person's appointment` EQUALS NOTHING
