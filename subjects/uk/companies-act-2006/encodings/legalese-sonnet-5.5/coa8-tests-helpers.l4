IMPORT prelude
IMPORT `coa8-helpers`

-- Tests of the three-valued helpers. Expected values are the Kleene truth tables, written by hand.

-- either answer (or): TRUE beats everything; FALSE only with FALSE; otherwise NOTHING
#ASSERT `s 362 helper either answer` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362 helper either answer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 362 helper either answer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362 helper either answer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper either answer` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362 helper either answer` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 362 helper either answer` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 362 helper either answer` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 362 helper either answer` NOTHING NOTHING EQUALS NOTHING

-- both answers (and): FALSE beats everything; TRUE only with TRUE; otherwise NOTHING
#ASSERT `s 362 helper both answers` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362 helper both answers` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper both answers` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 362 helper both answers` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper both answers` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper both answers` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 362 helper both answers` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 362 helper both answers` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 362 helper both answers` NOTHING NOTHING EQUALS NOTHING

-- the opposite answer (not)
#ASSERT `s 362 helper the opposite answer` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 362 helper the opposite answer` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 362 helper the opposite answer` NOTHING EQUALS NOTHING

-- every answer (and over a list; the empty list is JUST TRUE) and some answer (or over a list; the empty list is JUST FALSE)
#ASSERT `s 362 helper every answer` EMPTY EQUALS JUST TRUE
#ASSERT `s 362 helper every answer` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362 helper every answer` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 362 helper every answer` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper some answer` EMPTY EQUALS JUST FALSE
#ASSERT `s 362 helper some answer` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362 helper some answer` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `s 362 helper some answer` (LIST NOTHING, JUST TRUE) EQUALS JUST TRUE
