#ASSERT `s 152(3) the member must inform the company of the ways in which he is exercising the rights and to what extent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 152(3) the member must inform the company of the ways in which he is exercising the rights and to what extent` TRUE FALSE EQUALS NOTHING
#ASSERT `s 152(3) the member must inform the company of the ways in which he is exercising the rights and to what extent` FALSE TRUE EQUALS NOTHING
