#ASSERT `s 149(3) the company has done one of the two things s 149(3) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 149(3) the company has done one of the two things s 149(3) requires` FALSE FALSE EQUALS JUST FALSE

-- ---- s 150 ----
#ASSERT `s 150(1) this section has effect as regards the rights` TRUE EQUALS JUST TRUE
#ASSERT `s 150(1) this section has effect as regards the rights` FALSE EQUALS NOTHING
-- arguments: (a nomination under s 146) (the person enforcing is the member)
#ASSERT `s 150(2) the nominated person's enjoyment of the rights is enforceable against the company by the member as if they were rights conferred by the company's articles` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 150(2) the nominated person's enjoyment of the rights is enforceable against the company by the member as if they were rights conferred by the company's articles` TRUE FALSE EQUALS NOTHING
#ASSERT `s 150(2) the nominated person's enjoyment of the rights is enforceable against the company by the member as if they were rights conferred by the company's articles` FALSE TRUE EQUALS NOTHING
