#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 250, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 24999, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
#ASSERT `s 153(2) the company is required to act under the section on the request` (`s 153(2) request` OF 100, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, 10000, TRUE) EQUALS JUST FALSE
