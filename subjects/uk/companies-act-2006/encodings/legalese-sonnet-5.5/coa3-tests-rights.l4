IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa3-part9-rights`

-- coa3-tests-rights.l4: tests for coa3-part9-rights.l4 (ss 145 to 153).
-- Every expected value is written by hand from the text of the section named beside it, before the code was run.

-- ---- s 145(1): "This section applies where provision is made by a company's articles enabling a member to nominate another person" ----
#ASSERT `s 145(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 145(1) this section applies` FALSE EQUALS JUST FALSE
-- s 145(2): arguments (the answer of s 145(1)) (the answer of s 2(1)) (the kind of act) (necessary to give effect)
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST TRUE) (JUST TRUE) `s 145(2) an act required to be done by or in relation to the member` TRUE EQUALS JUST TRUE
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST TRUE) (JUST TRUE) `s 145(2) an act that may be done by or in relation to the member` TRUE EQUALS JUST TRUE
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST TRUE) (JUST TRUE) `s 145(2) an act required to be done by or in relation to the member` FALSE EQUALS NOTHING
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST TRUE) (JUST FALSE) `s 145(2) an act required to be done by or in relation to the member` TRUE EQUALS NOTHING
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST TRUE) NOTHING `s 145(2) an act required to be done by or in relation to the member` TRUE EQUALS NOTHING
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` (JUST FALSE) (JUST TRUE) `s 145(2) an act required to be done by or in relation to the member` TRUE EQUALS JUST FALSE
#ASSERT `s 145(2) the act is done, or may be done, by or in relation to the nominated person instead of the member` NOTHING (JUST TRUE) `s 145(2) an act required to be done by or in relation to the member` TRUE EQUALS NOTHING
-- s 145(3): the twelve listed rights (a) to (h), including (ea), (ga), (gb) and (gc)
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(a) the right to be sent a proposed written resolution (ss 291 and 293)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(b) the right to require circulation of a written resolution (s 292)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(c) the right to require directors to call a general meeting (s 303)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(d) the right to notice of general meetings (s 310)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(e) the right to require circulation of a statement (s 314)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(ea) the right to ask a question at a meeting of a traded company (s 319A)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(f) the right to appoint a proxy to act at a meeting (s 324)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(g) the right to require circulation of a resolution for the AGM of a public company (s 338)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(ga) the traded companies' members' power to include matters in the business dealt with at the AGM (s 338A)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(gb) the confirmation of receipt of electronic voting of a traded company (s 360AA)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(gc) the right of a traded company's member to confirmation of a vote after a general meeting (s 360BA)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3)(h) the right to be sent a copy of the annual accounts and reports (s 423)` EQUALS JUST TRUE
#ASSERT `s 145(3) section 145 applies in particular to the right` `s 145(3) another right` EQUALS NOTHING
#ASSERT `s 145(4)(a) the person can enforce a right against the company by virtue of s 145 or the provision in the articles` TRUE EQUALS JUST FALSE
#ASSERT `s 145(4)(a) the person can enforce a right against the company by virtue of s 145 or the provision in the articles` FALSE EQUALS NOTHING
#ASSERT `s 145(4)(b) s 145 or the provision in the articles affects the requirements for an effective transfer or other disposition of a member's interest` TRUE EQUALS JUST FALSE
#ASSERT `s 145(4)(b) s 145 or the provision in the articles affects the requirements for an effective transfer or other disposition of a member's interest` FALSE EQUALS NOTHING

-- ---- s 146(1): arguments (admitted to a UK regulated market) (admitted to an EU regulated market) ----
#ASSERT `s 146(1) this section applies to the company` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 146(1) this section applies to the company` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 146(1) this section applies to the company` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 146(1) this section applies to the company` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 146(1) this section applies to the company` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 146(1) this section applies to the company` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 146(1) this section applies to the company` NOTHING NOTHING EQUALS NOTHING
-- s 146(2): arguments (the answer of s 146(1)) (the person is a member) (holds shares on behalf of the other person)
#ASSERT `s 146(2) the member may nominate the other person to enjoy information rights` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 146(2) the member may nominate the other person to enjoy information rights` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 146(2) the member may nominate the other person to enjoy information rights` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 146(2) the member may nominate the other person to enjoy information rights` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 146(2) the member may nominate the other person to enjoy information rights` NOTHING TRUE TRUE EQUALS NOTHING
-- s 146(3)
#ASSERT `s 146(3) the right is one of the "information rights"` `s 146(3)(a) the right to receive a copy of all communications that the company sends to its members generally or to any class of its members that includes the person making the nomination` EQUALS JUST TRUE
#ASSERT `s 146(3) the right is one of the "information rights"` `s 146(3)(b)(i) the right conferred by section 431 or 432 (right to require copies of accounts and reports)` EQUALS JUST TRUE
#ASSERT `s 146(3) the right is one of the "information rights"` `s 146(3)(b)(ii) the right conferred by section 1145 (right to require hard copy version of document or information provided in another form)` EQUALS JUST TRUE
#ASSERT `s 146(3) the right is one of the "information rights"` `s 146(3) another right` EQUALS JUST FALSE
-- arguments: (sent to its members generally) (sent to a class that includes the person making the nomination)
#ASSERT `s 146(3)(a) the person has the right to receive a copy of the communication` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 146(3)(a) the person has the right to receive a copy of the communication` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 146(3)(a) the person has the right to receive a copy of the communication` FALSE FALSE EQUALS NOTHING
#ASSERT `s 146(4) the document is within the communications that the company sends to its members generally` TRUE EQUALS JUST TRUE
#ASSERT `s 146(4) the document is within the communications that the company sends to its members generally` FALSE EQUALS NOTHING
#ASSERT `s 146(5) the company need not act on the nomination` TRUE EQUALS JUST TRUE
#ASSERT `s 146(5) the company need not act on the nomination` FALSE EQUALS NOTHING

-- ---- s 147 ----
#ASSERT `s 147(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 147(1) this section applies` FALSE EQUALS NOTHING
#ASSERT `s 147(2) the person to be nominated must request the person making the nomination to notify the company of that fact and provide an address` TRUE EQUALS JUST TRUE
#ASSERT `s 147(2) the person to be nominated must request the person making the nomination to notify the company of that fact and provide an address` FALSE EQUALS JUST FALSE
-- arguments: (the date of the request and the address) (the date the nomination is made): "This must be done before the nomination is made"
#ASSERT `s 147(2) the request was made and the address provided before the nomination was made` (Date 1 3 2023) (Date 2 3 2023) EQUALS JUST TRUE
#ASSERT `s 147(2) the request was made and the address provided before the nomination was made` (Date 2 3 2023) (Date 2 3 2023) EQUALS JUST FALSE
#ASSERT `s 147(2) the request was made and the address provided before the nomination was made` (Date 3 3 2023) (Date 2 3 2023) EQUALS JUST FALSE
-- s 147(3): arguments (having received such a request) (notifies the company) (provides the address)
#ASSERT `s 147(3) the right of the nominated person is to receive hard copy communications` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 147(3) the right of the nominated person is to receive hard copy communications` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 147(3) the right of the nominated person is to receive hard copy communications` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 147(3) the right of the nominated person is to receive hard copy communications` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 147(4) the right under s 147(3) is unaffected by Parts 3 and 4 of Schedule 5` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 147(4) the right under s 147(3) is unaffected by Parts 3 and 4 of Schedule 5` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 147(4) the right under s 147(3) is unaffected by Parts 3 and 4 of Schedule 5` NOTHING EQUALS NOTHING
-- s 147(5): arguments (no such notification is given) (no address is provided)
#ASSERT `s 147(5) the nominated person is taken to have agreed that documents or information may be sent or supplied to him by means of a website` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 147(5) the nominated person is taken to have agreed that documents or information may be sent or supplied to him by means of a website` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 147(5) the nominated person is taken to have agreed that documents or information may be sent or supplied to him by means of a website` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 147(5) the nominated person is taken to have agreed that documents or information may be sent or supplied to him by means of a website` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 147(6)(a) the agreement may be revoked by the nominated person` TRUE EQUALS JUST TRUE
#ASSERT `s 147(6)(a) the agreement may be revoked by the nominated person` FALSE EQUALS NOTHING
#ASSERT `s 147(6)(b) the agreement affects the right under s 1145 to require a hard copy version of a document or information provided in any other form` TRUE EQUALS JUST FALSE
#ASSERT `s 147(6)(b) the agreement affects the right under s 1145 to require a hard copy version of a document or information provided in any other form` FALSE EQUALS NOTHING

-- ---- s 148 ----
#ASSERT `s 148(1) the provisions of s 148 have effect in relation to the nomination` TRUE EQUALS JUST TRUE
#ASSERT `s 148(1) the provisions of s 148 have effect in relation to the nomination` FALSE EQUALS NOTHING
#ASSERT `s 148(2) the nomination may be terminated at the request` `s 148(2) the member` EQUALS JUST TRUE
#ASSERT `s 148(2) the nomination may be terminated at the request` `s 148(2) the nominated person` EQUALS JUST TRUE
#ASSERT `s 148(2) the nomination may be terminated at the request` `s 148(2) someone else` EQUALS NOTHING
#ASSERT `s 148(3) the nomination ceases to have effect on the event` `s 148(3)(a) the death of an individual` EQUALS JUST TRUE
#ASSERT `s 148(3) the nomination ceases to have effect on the event` `s 148(3)(a) the bankruptcy of an individual` EQUALS JUST TRUE
#ASSERT `s 148(3) the nomination ceases to have effect on the event` `s 148(3)(b) the dissolution of a body corporate` EQUALS JUST TRUE
#ASSERT `s 148(3) the nomination ceases to have effect on the event` (`s 148(3)(b) the making of an order for the winding up of a body corporate` FALSE) EQUALS JUST TRUE
#ASSERT `s 148(3) the nomination ceases to have effect on the event` (`s 148(3)(b) the making of an order for the winding up of a body corporate` TRUE) EQUALS JUST FALSE
#ASSERT `s 148(3) the nomination ceases to have effect on the event` `s 148(3) another event` EQUALS NOTHING
#ASSERT `s 148(4)(a) the proceeding is bankruptcy for the purposes of s 148(3)` `s 148(4)(a)(i) the sequestration of a person's estate` EQUALS JUST TRUE
#ASSERT `s 148(4)(a) the proceeding is bankruptcy for the purposes of s 148(3)` `s 148(4)(a)(ii) a person's estate being the subject of a protected trust deed (within the meaning of the Bankruptcy (Scotland) Act 2016)` EQUALS JUST TRUE
#ASSERT `s 148(4)(a) the proceeding is bankruptcy for the purposes of s 148(3)` `s 148(4)(a) another proceeding` EQUALS NOTHING
#ASSERT `s 148(4)(b) the order or proceeding is the making of an order for winding up for the purposes of s 148(3)` `s 148(4)(b)(i) an order for winding up under the Insolvency Act 1986 or the Insolvency (Northern Ireland) Order 1989` EQUALS JUST TRUE
#ASSERT `s 148(4)(b) the order or proceeding is the making of an order for winding up for the purposes of s 148(3)` `s 148(4)(b)(ii) a corresponding proceeding under the law of a country or territory outside the United Kingdom` EQUALS JUST TRUE
#ASSERT `s 148(4)(b) the order or proceeding is the making of an order for winding up for the purposes of s 148(3)` `s 148(4)(b) another order or proceeding` EQUALS JUST FALSE
-- s 148(5): "at any time when there are more nominated persons than the member has shares": arguments (nominated persons) (shares)
#ASSERT `s 148(5) the effect of the nominations made by the member is suspended` 3 2 EQUALS JUST TRUE
#ASSERT `s 148(5) the effect of the nominations made by the member is suspended` 2 2 EQUALS JUST FALSE
#ASSERT `s 148(5) the effect of the nominations made by the member is suspended` 1 2 EQUALS JUST FALSE
#ASSERT `s 148(5) the effect of the nominations made by the member is suspended` 1 0 EQUALS JUST TRUE
-- s 148(6): arguments (different classes with different information rights) (nominated persons) (shares conferring the particular right)
#ASSERT `s 148(6) the effect of the nominations made by the member is suspended to the extent that they confer that right` TRUE 3 2 EQUALS JUST TRUE
#ASSERT `s 148(6) the effect of the nominations made by the member is suspended to the extent that they confer that right` TRUE 2 2 EQUALS JUST FALSE
#ASSERT `s 148(6) the effect of the nominations made by the member is suspended to the extent that they confer that right` FALSE 3 2 EQUALS JUST FALSE
-- s 148(7): "the period of 28 days beginning with the date on which the company's enquiry was sent": sent 1 January 2023, the 28th day is 28 January 2023
#ASSERT `s 148(7) the last day of the period of 28 days beginning with the date on which the enquiry was sent` (Date 1 1 2023) EQUALS Date 28 1 2023
#ASSERT `s 148(7) the last day of the period of 28 days beginning with the date on which the enquiry was sent` (Date 15 2 2023) EQUALS Date 14 3 2023
-- arguments: (the company enquires) (the date the enquiry was sent) (the date a response was received, if any) (the day the question is asked)
#ASSERT `s 148(7) the nomination has ceased to have effect` FALSE (Date 1 1 2023) NOTHING (Date 1 3 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) NOTHING (Date 29 1 2023) EQUALS JUST TRUE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) NOTHING (Date 28 1 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) NOTHING (Date 27 1 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) (JUST (Date 28 1 2023)) (Date 29 1 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) (JUST (Date 1 1 2023)) (Date 30 1 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the nomination has ceased to have effect` TRUE (Date 1 1 2023) (JUST (Date 29 1 2023)) (Date 30 1 2023) EQUALS JUST TRUE
-- the second sentence: arguments (the date of the earlier enquiry, if any) (the date of the proposed enquiry)
#ASSERT `s 148(7) the company may make the enquiry of the person` (JUST (Date 1 3 2023)) (Date 28 2 2024) EQUALS JUST FALSE
#ASSERT `s 148(7) the company may make the enquiry of the person` (JUST (Date 1 3 2023)) (Date 1 3 2024) EQUALS NOTHING
#ASSERT `s 148(7) the company may make the enquiry of the person` (JUST (Date 1 3 2023)) (Date 1 6 2023) EQUALS JUST FALSE
#ASSERT `s 148(7) the company may make the enquiry of the person` NOTHING (Date 1 6 2023) EQUALS NOTHING
#ASSERT `s 148(8) the company is required to act on the nomination` TRUE EQUALS JUST FALSE
#ASSERT `s 148(8) the company is required to act on the nomination` FALSE EQUALS NOTHING
#ASSERT `s 148(8) the company may continue to act on the nomination, to such extent or for such period as it thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `s 148(8) the company may continue to act on the nomination, to such extent or for such period as it thinks fit` FALSE EQUALS NOTHING

-- ---- s 149 ----
