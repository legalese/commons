-- ---- s 152 ----
#ASSERT `s 152(1) the member may exercise some only of the rights, or exercise them in different ways` TRUE EQUALS JUST TRUE
#ASSERT `s 152(1) the member may exercise some only of the rights, or exercise them in different ways` FALSE EQUALS JUST FALSE
-- s 152(2): arguments (holds shares on behalf of more than one person) (exercises such rights) (does not exercise all his rights)
#ASSERT `s 152(2) the member must inform the company to what extent he is exercising the rights` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 152(2) the member must inform the company to what extent he is exercising the rights` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 152(2) the member must inform the company to what extent he is exercising the rights` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 152(2) the member must inform the company to what extent he is exercising the rights` FALSE TRUE TRUE EQUALS NOTHING
