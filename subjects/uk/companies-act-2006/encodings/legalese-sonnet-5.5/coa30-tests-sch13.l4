IMPORT prelude
IMPORT daydate
IMPORT `coa30-sch13`

-- coa30-tests-sch13.l4: tests for coa30-sch13.l4 (Schedule 13). Expected values are decided from the text of each paragraph.

§ `Tests: Schedule 13`

-- sch 13 para 10(1): every limb that applies is required ("The body must, at least once in each calendar year for which the delegation order is in force, make a report to the Secretary of State on")
#ASSERT `sch 13 para 10(1) the body has complied for the calendar year` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(1) the body has complied for the calendar year` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(1) the body has complied for the calendar year` TRUE FALSE EQUALS JUST FALSE
-- 1(1): paragraphs 2 to 12 for an established body; paragraphs 2 and 6 to 11 for an existing body; paragraph 13 for an existing unincorporated association
-- args: paragraph number, established by the order, existing body, existing unincorporated association
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 2 TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 12 TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 13 TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 1 TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 2 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 3 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 5 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 6 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 11 FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 12 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 13 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(1) the paragraph has effect in relation to the body` 13 FALSE TRUE TRUE EQUALS JUST TRUE
-- 1(2), 1(3), 2
#ASSERT `sch 13 para 1(2) paragraph 2 or 6 applies to the existing body in relation to the thing or function` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(2) paragraph 2 or 6 applies to the existing body in relation to the thing or function` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(2) paragraph 2 or 6 applies to the existing body in relation to the thing or function` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 1(3) the power is a power to make provision by an order under section 1252` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 1(3) the power is a power to make provision by an order under section 1252` FALSE EQUALS NOTHING
#ASSERT `sch 13 para 2 the person is regarded as acting on behalf of the Crown or as a Crown servant` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 2 the person is regarded as acting on behalf of the Crown or as a Crown servant` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 2 the person is regarded as acting on behalf of the Crown or as a Crown servant` FALSE FALSE EQUALS NOTHING
-- 4(1): the Secretary of State determined 1000; paying 1000 meets it, 999 does not
#ASSERT `sch 13 para 4(1) the body has paid what it must pay by way of remuneration and allowances` TRUE (JUST 1000) 1000 EQUALS JUST TRUE
#ASSERT `sch 13 para 4(1) the body has paid what it must pay by way of remuneration and allowances` TRUE (JUST 1000) 999 EQUALS JUST FALSE
#ASSERT `sch 13 para 4(1) the body has paid what it must pay by way of remuneration and allowances` TRUE NOTHING 0 EQUALS NOTHING
#ASSERT `sch 13 para 4(1) the body has paid what it must pay by way of remuneration and allowances` FALSE (JUST 1000) 0 EQUALS NOTHING
-- 4(2), 4(3)
#ASSERT `sch 13 para 4(2) the body has paid or made provision for the pension, allowance or gratuity` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 4(2) the body has paid or made provision for the pension, allowance or gratuity` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 4(2) the body has paid or made provision for the pension, allowance or gratuity` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 13 para 4(3) the body has paid the compensation it must pay` TRUE TRUE (JUST 500) 500 EQUALS JUST TRUE
#ASSERT `sch 13 para 4(3) the body has paid the compensation it must pay` TRUE TRUE (JUST 500) 499 EQUALS JUST FALSE
#ASSERT `sch 13 para 4(3) the body has paid the compensation it must pay` TRUE TRUE NOTHING 0 EQUALS NOTHING
#ASSERT `sch 13 para 4(3) the body has paid the compensation it must pay` FALSE TRUE (JUST 500) 0 EQUALS NOTHING
#ASSERT `sch 13 para 4(3) the body has paid the compensation it must pay` TRUE FALSE (JUST 500) 0 EQUALS NOTHING
-- 6
#ASSERT `sch 13 para 6(1) the body may retain the fees` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(1) the body may retain the fees` FALSE EQUALS NOTHING
#ASSERT `sch 13 para 6(2) the fees are applied as required` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(2) the fees are applied as required` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(2) the fees are applied as required` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 6(3) the expense is one of the expenses of the body` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(3) the expense is one of the expenses of the body` FALSE EQUALS NOTHING
#ASSERT `sch 13 para 6(4) the fees prescribed are as required` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(4) the fees prescribed are as required` FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 6(5) the exercise of the power to prescribe fees has the approval required` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(5) the exercise of the power to prescribe fees has the approval required` FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 6(6) the Secretary of State may by order vary or revoke regulations prescribing fees` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 6(6) the Secretary of State may by order vary or revoke regulations prescribing fees` FALSE EQUALS JUST FALSE
-- 7(1)-(2), 7(4)
#ASSERT `sch 13 para 7(1)-(2) the regulations or order of the body are made as required` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 7(1)-(2) the regulations or order of the body are made as required` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 7(1)-(2) the regulations or order of the body are made as required` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 7(1)-(2) the regulations or order of the body are made as required` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 7(4) the regulations or order are subject to negative resolution procedure or affirmative resolution procedure` TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 7(4) the regulations or order are subject to negative resolution procedure or affirmative resolution procedure` FALSE EQUALS NOTHING
-- 8(1), 8(2): the defence
#ASSERT `sch 13 para 8(1) the instrument has been printed and made available as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 8(1) the instrument has been printed and made available as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 8(1) the instrument has been printed and made available as required` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 8(2) this paragraph gives a defence to the alleged contravention` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 8(2) this paragraph gives a defence to the alleged contravention` FALSE EQUALS JUST FALSE
-- 9(1), 9(2), 9(3)
#ASSERT `sch 13 para 9(1) the printed copy is evidence of the facts stated in the certificate` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 9(1) the printed copy is evidence of the facts stated in the certificate` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 13 para 9(1) the printed copy is evidence of the facts stated in the certificate` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 13 para 9(1) the printed copy is evidence of the facts stated in the certificate` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 13 para 9(2) the certificate is deemed to have been duly signed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 9(2) the certificate is deemed to have been duly signed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 9(2) the certificate is deemed to have been duly signed` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 13 para 9(3) the person may require the body to cause a copy of the instrument to be endorsed with a certificate` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 9(3) the person may require the body to cause a copy of the instrument to be endorsed with a certificate` FALSE EQUALS NOTHING
-- 10(2) to 10(8)
#ASSERT `sch 13 para 10(2) the delegation order may modify sub-paragraph (1) for the calendar year` TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(2) the delegation order may modify sub-paragraph (1) for the calendar year` FALSE EQUALS NOTHING
#ASSERT `sch 13 para 10(3) the Secretary of State has laid the report before Parliament as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(3) the Secretary of State has laid the report before Parliament as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(3) the Secretary of State has laid the report before Parliament as required` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 5 TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 6 TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 7 TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 7 FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 8 FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(4) the sub-paragraph applies to the body` 5 FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(5) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(5) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(5) the Secretary of State may give directions about the accounts and the audit of the accounts` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(6) the person may be appointed as auditor of the body` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(6) the person may be appointed as auditor of the body` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(6) the person may be appointed as auditor of the body` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(6) the person may be appointed as auditor of the body` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 13 para 10(7) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `sch 13 para 10(7) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `sch 13 para 10(7) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `sch 13 para 10(7) the Secretary of State may give directions about the accounts and the audit of the accounts` TRUE NOTHING TRUE EQUALS NOTHING
