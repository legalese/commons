IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa4-approval-service-property`

-- coa4-tests-approval-service-property.l4: tests for coa4-approval-service-property.l4 (ss 188 to 196). Expected values are written
-- from the text of the section named beside each assertion, before the code was run.

-- s 188(3): the end of a period beginning on 1 January 2020
#ASSERT `s 188(3) the day on which a period beginning on the start day ends` (Date 1 1 2020) (Period OF 2, Years) EQUALS JUST (Date 1 1 2022)
#ASSERT `s 188(3) the day on which a period beginning on the start day ends` (Date 1 1 2020) (Period OF 6, Months) EQUALS JUST (Date 1 7 2020)
#ASSERT `s 188(3) the day on which a period beginning on the start day ends` (Date 1 1 2020) (Period OF 2, Weeks) EQUALS JUST (Date 15 1 2020)
#ASSERT `s 188(3) the day on which a period beginning on the start day ends` (Date 1 1 2020) (Period OF 10, Days) EQUALS JUST (Date 11 1 2020)
#ASSERT `s 188(3) the day on which a period beginning on the start day ends` (Date 1 1 2020) (Period OF 5, `Working days`) EQUALS NOTHING
-- s 188(3): the guaranteed term: (a) the fixed period, (b) the notice period, or both added
#ASSERT `s 188(3) the day on which the guaranteed term of the director's employment ends` (Date 1 1 2020) (JUST (Period OF 3, Years)) NOTHING EQUALS JUST (Date 1 1 2023)
#ASSERT `s 188(3) the day on which the guaranteed term of the director's employment ends` (Date 1 1 2020) NOTHING (JUST (Period OF 6, Months)) EQUALS JUST (Date 1 7 2020)
#ASSERT `s 188(3) the day on which the guaranteed term of the director's employment ends` (Date 1 1 2020) (JUST (Period OF 1, Years)) (JUST (Period OF 6, Months)) EQUALS JUST (Date 1 7 2021)
#ASSERT `s 188(3) the day on which the guaranteed term of the director's employment ends` (Date 1 1 2020) NOTHING NOTHING EQUALS JUST (Date 1 1 2020)
#ASSERT `s 188(3) the day on which the guaranteed term of the director's employment ends` (Date 1 1 2020) (JUST (Period OF 3, `Working days`)) NOTHING EQUALS NOTHING
-- s 188(1): arguments: the employment is with the company or the group; the first day; the day the longest guaranteed term ends. "longer than two years": exactly two years is not longer
#ASSERT `s 188(1) section 188 applies to the provision` TRUE (Date 1 1 2020) (Date 1 1 2022) EQUALS NOTHING
#ASSERT `s 188(1) section 188 applies to the provision` TRUE (Date 1 1 2020) (Date 2 1 2022) EQUALS JUST TRUE
#ASSERT `s 188(1) section 188 applies to the provision` TRUE (Date 1 1 2020) (Date 1 1 2023) EQUALS JUST TRUE
#ASSERT `s 188(1) section 188 applies to the provision` FALSE (Date 1 1 2020) (Date 1 1 2023) EQUALS NOTHING
-- s 188(4): arguments: the day the further contract is entered into; the day the original term ends (1 January 2023); in pursuance of a right of the other party
#ASSERT `s 188(4) the unexpired period of the original guaranteed term is added to the guaranteed term of the new contract` (Date 30 6 2022) (Date 1 1 2023) FALSE EQUALS JUST TRUE
#ASSERT `s 188(4) the unexpired period of the original guaranteed term is added to the guaranteed term of the new contract` (Date 1 7 2022) (Date 1 1 2023) FALSE EQUALS JUST FALSE
#ASSERT `s 188(4) the unexpired period of the original guaranteed term is added to the guaranteed term of the new contract` (Date 2 7 2022) (Date 1 1 2023) FALSE EQUALS JUST FALSE
#ASSERT `s 188(4) the unexpired period of the original guaranteed term is added to the guaranteed term of the new contract` (Date 30 6 2022) (Date 1 1 2023) TRUE EQUALS JUST FALSE
#ASSERT `s 188(4) the day on which the guaranteed term of the new contract is treated as ending` (Date 30 6 2022) (Date 1 1 2023) (Date 1 1 2026) EQUALS Date 5 7 2026
-- s 188(6): arguments: a UK-registered company; a wholly-owned subsidiary of another body corporate
#ASSERT `s 188(6) approval is required on the part of the members of the body corporate` TRUE FALSE EQUALS NOTHING
#ASSERT `s 188(6) approval is required on the part of the members of the body corporate` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(6) approval is required on the part of the members of the body corporate` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(6) approval is required on the part of the members of the body corporate` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 188(7) the employment is employment for the purposes of section 188` TRUE EQUALS JUST TRUE
#ASSERT `s 188(7) the employment is employment for the purposes of section 188` FALSE EQUALS JUST FALSE
-- s 188(2): arguments: the answer under s 188(1); the company agrees; approved by the members of the company; s 188(6) answer for the company; director of a holding company; approved by the holding company; s 188(6) answer for the holding company
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE FALSE NOTHING FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE TRUE NOTHING FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) FALSE FALSE NOTHING FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE FALSE (JUST FALSE) FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE TRUE NOTHING TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE TRUE NOTHING TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST TRUE) TRUE TRUE NOTHING TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` (JUST FALSE) TRUE FALSE NOTHING FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 188(2) section 188(2) bars the company from agreeing to the provision` NOTHING TRUE FALSE NOTHING FALSE FALSE NOTHING EQUALS NOTHING
-- s 188(5): arguments: the way the resolution is passed; the memorandum has the required contents; sent to every eligible member; the first day available at the registered office; the day of the meeting; available at the meeting
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `as a written resolution` TRUE TRUE (Date 1 3 2025) (Date 15 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `as a written resolution` TRUE FALSE (Date 1 3 2025) (Date 15 3 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `at a meeting on a show of hands` TRUE FALSE (Date 1 3 2025) (Date 15 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `at a meeting on a poll` TRUE FALSE (Date 1 3 2025) (Date 15 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `at a meeting on a show of hands` TRUE FALSE (Date 2 3 2025) (Date 15 3 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `at a meeting on a show of hands` TRUE FALSE (Date 1 3 2025) (Date 15 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `s 188(5) the memorandum has been made available to members as the subsection requires` `at a meeting on a show of hands` FALSE FALSE (Date 1 3 2025) (Date 15 3 2025) TRUE EQUALS JUST FALSE
-- s 189: arguments: the company agrees to the provision; the answer under s 188(2)
#ASSERT `s 189(a) the provision is void to the extent of the contravention` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 189(a) the provision is void to the extent of the contravention` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 189(a) the provision is void to the extent of the contravention` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 189(a) the provision is void to the extent of the contravention` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 189(b) the contract is deemed to contain a term entitling the company to terminate it at any time by the giving of reasonable notice` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 189(b) the contract is deemed to contain a term entitling the company to terminate it at any time by the giving of reasonable notice` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 189(b) the contract is deemed to contain a term entitling the company to terminate it at any time by the giving of reasonable notice` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 189(b) the contract is deemed to contain a term entitling the company to terminate it at any time by the giving of reasonable notice` TRUE NOTHING EQUALS NOTHING
-- s 191(4): the most recent statutory accounts: the one whose time for sending out to members is most recent
#ASSERT `s 191(4) the most recent statutory accounts` (LIST (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100), (`s 191(4) statutory accounts` OF (Date 1 6 2021), 200)) EQUALS JUST (`s 191(4) statutory accounts` OF (Date 1 6 2021), 200)
#ASSERT `s 191(4) the most recent statutory accounts` (LIST (`s 191(4) statutory accounts` OF (Date 1 6 2021), 200), (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100)) EQUALS JUST (`s 191(4) statutory accounts` OF (Date 1 6 2021), 200)
#ASSERT `s 191(4) the most recent statutory accounts` (LIST (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100)) EQUALS JUST (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100)
#ASSERT `s 191(4) the most recent statutory accounts` EMPTY EQUALS NOTHING
-- s 191(3): asset value: net assets by the most recent accounts, or if none the called-up share capital
#ASSERT `s 191(3) the company's asset value` (LIST (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100), (`s 191(4) statutory accounts` OF (Date 1 6 2021), 200)) 50 EQUALS 200
#ASSERT `s 191(3) the company's asset value` EMPTY 50 EQUALS 50
#ASSERT `s 191(3) the company's asset value` (LIST (`s 191(4) statutory accounts` OF (Date 1 6 2020), 100)) 50 EQUALS 100
-- s 191(2): substantial: exceeds 10% of the asset value AND more than 5,000, or exceeds 100,000. arguments: value of the asset; asset value
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 10001 100000 EQUALS JUST TRUE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 10000 100000 EQUALS JUST FALSE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 5000 10000 EQUALS JUST FALSE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 5001 10000 EQUALS JUST TRUE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 100000 1000000 EQUALS JUST FALSE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 100001 10000000 EQUALS JUST TRUE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 100000 10000000 EQUALS JUST FALSE
#ASSERT `s 191(2) the asset is a substantial asset in relation to the company` 4000 1000 EQUALS JUST FALSE
#ASSERT `s 191(5) the determination is as at the time the arrangement is entered into` (Date 1 5 2025) (Date 1 5 2025) EQUALS JUST TRUE
#ASSERT `s 191(5) the determination is as at the time the arrangement is entered into` (Date 2 5 2025) (Date 1 5 2025) EQUALS JUST FALSE
