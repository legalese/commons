#ASSERT `s 597(2) the copy was delivered at the same time as the return of allotment` (JUST TRUE) (Date 6 3 2026) (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 597(2) the copy was delivered at the same time as the return of allotment` (JUST TRUE) (Date 4 3 2026) (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 597(2) the copy was delivered at the same time as the return of allotment` (JUST FALSE) (Date 5 3 2026) (Date 5 3 2026) EQUALS JUST FALSE
#ASSERT `s 597(2) the copy was delivered at the same time as the return of allotment` NOTHING (Date 5 3 2026) (Date 5 3 2026) EQUALS NOTHING
-- s 597(3): default in complying with (1) or (2): an offence by every officer in default.
#ASSERT `s 597(3) the officer of the company commits an offence` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 597(3) the officer of the company commits an offence` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 597(3) the officer of the company commits an offence` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 597(3) the officer of the company commits an offence` (JUST FALSE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 597(3) the officer of the company commits an offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 597(3) the officer of the company commits an offence` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- s 597(4): penalties; the text shows two readings of the daily default fine and does not choose.
#ASSERT `s 597(4)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 597(4)(b) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 597(4)(b) penalty on summary conviction`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT (count `s 597(4) the penalties for an offence under section 597`) EQUALS 2
#ASSERT `s 597(4)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the statutory maximum` 10000 EQUALS 1000
#ASSERT `s 597(4)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the greater of £5,000 and level 4` 4000 EQUALS 500
#ASSERT `s 597(4)(b) the most the daily default fine can be, in pounds, on the reading one-tenth of the greater of £5,000 and level 4` 8000 EQUALS 800
-- s 597(5) and (6): relief.
#ASSERT `s 597(5) the person may apply to the court for relief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 597(5) the person may apply to the court for relief` FALSE TRUE EQUALS NOTHING
#ASSERT `s 597(5) the person may apply to the court for relief` TRUE FALSE EQUALS NOTHING
#ASSERT `s 597(6) the court may make an order extending the time for delivery` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 597(6) the court may make an order extending the time for delivery` FALSE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 597(6) the court may make an order extending the time for delivery` FALSE FALSE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 597(6) the court may make an order extending the time for delivery` FALSE FALSE EQUALS NOTHING

-- s 598(2): the initial period is two years beginning with the date of the s 761 certificate (1 June 2026: the last day is 31 May 2028).
#ASSERT `s 598(2) the last day of the company's initial period` (Date 1 6 2026) EQUALS Date 31 5 2028
