IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa13-ch6-valuation`

-- coa13-tests-ch6.l4: tests for coa13-ch6-valuation.l4 (ss 593 to 609). Every expected value is written from the text of the section
-- named beside it, before the code was run. A test of a "not covered" case asserts NOTHING. The pounds used for a fine's level are
-- illustrative inputs: the Act does not state them.

§ `Tests for Part 17, Chapter 6`

-- s 593(2): reserves or profit and loss applied in paying up shares allotted to members do not count as consideration: (1) does not apply.
#ASSERT `s 593(2) subsection (1) applies to the allotment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 593(2) subsection (1) applies to the allotment` TRUE FALSE EQUALS NOTHING
#ASSERT `s 593(2) subsection (1) applies to the allotment` FALSE TRUE EQUALS NOTHING
-- s 593(1): no allotment otherwise than for cash unless valued, the report made in the six months before (report 1 January 2026: allotment by 1 July 2026), a copy sent.
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING TRUE (Date 1 1 2026) (Date 1 7 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING TRUE (Date 1 1 2026) (Date 2 7 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING TRUE (Date 2 7 2026) (Date 1 7 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING TRUE (Date 1 7 2026) (Date 1 7 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING FALSE (Date 1 1 2026) (Date 1 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING NOTHING TRUE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE (JUST FALSE) NOTHING NOTHING FALSE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING (JUST TRUE) NOTHING FALSE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE TRUE NOTHING NOTHING (JUST TRUE) FALSE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 593(1) the allotment of the shares is prohibited` FALSE TRUE NOTHING NOTHING NOTHING FALSE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS NOTHING
#ASSERT `s 593(1) the allotment of the shares is prohibited` TRUE FALSE NOTHING NOTHING NOTHING FALSE (Date 1 1 2026) (Date 1 3 2026) FALSE EQUALS NOTHING
-- s 593(3): the allottee is liable if the report was not received, or another contravention was known; the amount: nominal 100 and premium 50.
#ASSERT `s 593(3) the allottee is liable to pay the company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 593(3) the allottee is liable to pay the company` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 593(3) the allottee is liable to pay the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 593(3) the allottee is liable to pay the company` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 593(3) the amount the allottee is liable to pay the company` 100 50 1 EQUALS 150
#ASSERT `s 593(3) the amount the allottee is liable to pay the company` 100 50 0.5 EQUALS 75

-- s 594(5): shares disregarded in deciding whether the arrangement is open to all holders of company B.
#ASSERT `s 594(5) the shares are disregarded` TRUE NOTHING NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 594(5) the shares are disregarded` FALSE (JUST TRUE) NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 594(5) the shares are disregarded` FALSE NOTHING (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 594(5) the shares are disregarded` FALSE NOTHING NOTHING (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 594(5) the shares are disregarded` FALSE NOTHING NOTHING NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 594(5) the shares are disregarded` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
-- s 594(2): an arrangement for the allotment of shares in company A against the transfer or cancellation of shares in company B.
#ASSERT `s 594(2) the arrangement is of the kind to which section 594 applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 594(2) the arrangement is of the kind to which section 594 applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 594(2) the arrangement is of the kind to which section 594 applies` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 594(2) the arrangement is of the kind to which section 594 applies` FALSE TRUE FALSE EQUALS NOTHING
-- s 594(3): it is immaterial whether the arrangement provides for the issue to company A of shares in company B.
#ASSERT `s 594(3) it matters to section 594 whether the arrangement provides for the issue to company A of shares in company B` TRUE EQUALS JUST FALSE
#ASSERT `s 594(3) it matters to section 594 whether the arrangement provides for the issue to company A of shares in company B` FALSE EQUALS JUST FALSE
-- s 594(4): the section applies only if it is open to all the holders of the shares in company B to take part.
#ASSERT `s 594(4) the arrangement is one to which section 594 applies` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 594(4) the arrangement is one to which section 594 applies` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 594(4) the arrangement is one to which section 594 applies` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 594(4) the arrangement is one to which section 594 applies` NOTHING TRUE EQUALS NOTHING
-- s 594(1): section 593 does not apply to the allotment in connection with an arrangement to which the section applies.
#ASSERT `s 594(1) section 593 does not apply to the allotment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 594(1) section 593 does not apply to the allotment` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 594(1) section 593 does not apply to the allotment` NOTHING EQUALS NOTHING
-- s 594(6): "arrangement" means any agreement, scheme or arrangement (including one sanctioned under Part 26, 26A or s 110 of the Insolvency Act 1986); "company" includes any body corporate except in reference to company A.
#ASSERT `s 594(6)(a) the thing is an arrangement` TRUE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 594(6)(a) the thing is an arrangement` FALSE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 594(6)(a) the thing is an arrangement` FALSE NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 594(6)(a) the thing is an arrangement` FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 594(6)(a) the thing is an arrangement` FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 594(6)(a) the thing is an arrangement` FALSE (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 594(6)(b) the body is a company for the purposes of section 594` TRUE TRUE EQUALS NOTHING
#ASSERT `s 594(6)(b) the body is a company for the purposes of section 594` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 594(6)(b) the body is a company for the purposes of section 594` FALSE FALSE EQUALS NOTHING

-- s 595(1): section 593 does not apply to an allotment as part of a Part 27 scheme if the expert's report required by s 909 (merger) or s 924 (division) is drawn up.
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) TRUE (JUST TRUE) FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) FALSE NOTHING TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) TRUE (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) FALSE NOTHING TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) TRUE NOTHING FALSE NOTHING EQUALS NOTHING
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST TRUE) FALSE NOTHING FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 595(1) section 593 does not apply to the allotment` (JUST FALSE) TRUE (JUST TRUE) FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 595(1) section 593 does not apply to the allotment` NOTHING TRUE (JUST TRUE) FALSE NOTHING EQUALS NOTHING

-- s 596(1): ss 1150 to 1153 apply to the valuation and report required by s 593.
#ASSERT `s 596(1) sections 1150 to 1153 apply to the valuation and report` TRUE EQUALS JUST TRUE
#ASSERT `s 596(1) sections 1150 to 1153 apply to the valuation and report` FALSE EQUALS NOTHING
-- s 596(2): what the valuer's report must state: (a) nominal value, (b) premium, (c) description of the consideration and any part he valued himself, (d) the extent paid up by the consideration and in cash.
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` FALSE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 596(2) the valuer's report meets the requirements as to what it must state` TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- s 596(3): the valuer's note: (a) only where someone else made the valuation, (b), (c), (d).
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 596(3) the valuer's report contains or is accompanied by the note required` FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- s 596(4): where part of the consideration is for payment up and part for something else, the proportion attributable to payment up is valued.
#ASSERT `s 596(4) the value of the consideration to be valued for the purposes of section 593 and section 596` TRUE 1000 0.4 EQUALS 400
#ASSERT `s 596(4) the value of the consideration to be valued for the purposes of section 593 and section 596` FALSE 1000 0.4 EQUALS 1000
-- s 596(5): in such a case the valuer must do other valuations and report them.
#ASSERT `s 596(5) the valuer and his report meet the requirements of subsection (5)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 596(5) the valuer and his report meet the requirements of subsection (5)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 596(5) the valuer and his report meet the requirements of subsection (5)` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 596(5) the valuer and his report meet the requirements of subsection (5)` FALSE TRUE TRUE EQUALS NOTHING

-- s 597(1) and (2): deliver a copy of the report to the registrar, at the same time as the return of allotment.
#ASSERT `s 597(1) the company has delivered the copy of the report to the registrar` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 597(1) the company has delivered the copy of the report to the registrar` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 597(1) the company has delivered the copy of the report to the registrar` NOTHING EQUALS NOTHING
