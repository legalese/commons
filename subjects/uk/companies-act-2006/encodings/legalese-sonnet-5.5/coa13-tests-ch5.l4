IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa13-ch5-payment`

-- coa13-tests-ch5.l4: tests for coa13-ch5-payment.l4 (ss 580 to 592). Every expected value is written from the text of the section
-- named beside it, before the code was run. A test of a "not covered" case asserts NOTHING.

§ `Tests for Part 17, Chapter 5`

-- s 580(1): shares must not be allotted at a discount (nominal value 100; consideration worth 99 is at a discount).
#ASSERT `s 580(1) the allotment of the shares is prohibited because it is at a discount` 100 99 EQUALS JUST TRUE
#ASSERT `s 580(1) the allotment of the shares is prohibited because it is at a discount` 100 100 EQUALS NOTHING
#ASSERT `s 580(1) the allotment of the shares is prohibited because it is at a discount` 100 150 EQUALS NOTHING
-- s 580(2): the allottee is liable to pay the amount of the discount.
#ASSERT `s 580(2) the allottee is liable to pay the company the amount of the discount` TRUE EQUALS JUST TRUE
#ASSERT `s 580(2) the allottee is liable to pay the company the amount of the discount` FALSE EQUALS JUST FALSE
#ASSERT `s 580(2) the amount of the discount` 100 99 EQUALS 1
#ASSERT `s 580(2) the amount of the discount` 100 100 EQUALS 0
#ASSERT `s 580(2) the amount of the discount` 100 150 EQUALS 0

-- s 581: a company authorised by its articles may (a), (b), (c).
#ASSERT `s 581(a) the company may make the arrangements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 581(a) the company may make the arrangements` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 581(a) the company may make the arrangements` FALSE TRUE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 581(a) the company may make the arrangements` FALSE TRUE EQUALS NOTHING
#ASSERT `s 581(b) the company may accept the amount remaining unpaid` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 581(b) the company may accept the amount remaining unpaid` TRUE FALSE EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `s 581(b) the company may accept the amount remaining unpaid` FALSE TRUE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 581(b) the company may accept the amount remaining unpaid` FALSE TRUE EQUALS NOTHING
#ASSERT `s 581(c) the company may pay a dividend in proportion to the amount paid up on each share` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 581(c) the company may pay a dividend in proportion to the amount paid up on each share` TRUE FALSE EQUALS JUST FALSE
-- RECONCILED 2026-11-12: was #ASSERT `s 581(c) the company may pay a dividend in proportion to the amount paid up on each share` FALSE TRUE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 581(c) the company may pay a dividend in proportion to the amount paid up on each share` FALSE TRUE EQUALS NOTHING

-- s 582: shares and premium may be paid up in money or money's worth; the section does not prevent bonus shares or paying up unpaid amounts.
#ASSERT `s 582(1) the shares and any premium may be paid up in this way` TRUE EQUALS JUST TRUE
#ASSERT `s 582(1) the shares and any premium may be paid up in this way` FALSE EQUALS NOTHING
#ASSERT `s 582(2) section 582 prevents the company from doing this` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 582(2) section 582 prevents the company from doing this` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 582(2) section 582 prevents the company from doing this` FALSE FALSE EQUALS NOTHING
#ASSERT `s 582(3) section 582 has effect subject to the additional rules for public companies` TRUE EQUALS JUST TRUE
#ASSERT `s 582(3) section 582 has effect subject to the additional rules for public companies` FALSE EQUALS NOTHING

-- s 583(3): "cash consideration" means (a) cash, (b) a good-faith cheque, (c) release of a liquidated liability, (d) an undertaking to pay cash later,
-- (e) payment by another means giving a present or future entitlement to cash (including means specified by an order under (4)).
#ASSERT `s 583(3) the consideration is a cash consideration` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 583(3) the consideration is a cash consideration` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 583(2): a share is deemed paid up in cash, or allotted for cash, if the consideration is a cash consideration.
#ASSERT `s 583(2) the share is deemed paid up in cash, or allotted for cash` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 583(2) the share is deemed paid up in cash, or allotted for cash` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 583(2) the share is deemed paid up in cash, or allotted for cash` NOTHING EQUALS NOTHING
-- s 583(5): cash paid, or promised, to a person other than the company counts as consideration other than cash, except for Chapter 3.
#ASSERT `s 583(5) the payment or undertaking counts as consideration other than cash` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 583(5) the payment or undertaking counts as consideration other than cash` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 583(5) the payment or undertaking counts as consideration other than cash` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 583(5) the payment or undertaking counts as consideration other than cash` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 583(5) the payment or undertaking counts as consideration other than cash` FALSE TRUE TRUE EQUALS JUST FALSE
-- s 583(6): "cash" includes foreign currency.
#ASSERT `s 583(6) the money is cash for the purpose of determining whether a share is allotted for cash or paid up in cash` TRUE EQUALS JUST TRUE
#ASSERT `s 583(6) the money is cash for the purpose of determining whether a share is allotted for cash or paid up in cash` FALSE EQUALS NOTHING

-- s 584: shares taken by a subscriber to the memorandum of a public company must be paid up in cash.
#ASSERT `s 584 the shares and any premium meet the requirement to be paid up in cash` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 584 the shares and any premium meet the requirement to be paid up in cash` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 584 the shares and any premium meet the requirement to be paid up in cash` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 584 the shares and any premium meet the requirement to be paid up in cash` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 584 the shares and any premium meet the requirement to be paid up in cash` TRUE FALSE (JUST TRUE) EQUALS NOTHING

-- s 585: a public company must not accept an undertaking to do work or perform services in payment up of its shares.
#ASSERT `s 585(1) the public company is prohibited from accepting the undertaking` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 585(1) the public company is prohibited from accepting the undertaking` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 585(1) the public company is prohibited from accepting the undertaking` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 585(1) the public company is prohibited from accepting the undertaking` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 585(2) the holder of the shares is liable to pay the company` TRUE EQUALS JUST TRUE
#ASSERT `s 585(2) the holder of the shares is liable to pay the company` FALSE EQUALS JUST FALSE
-- Nominal value 100 and premium 50: 150 if the undertaking is the whole payment, 75 if it is treated as paying half.
#ASSERT `s 585(2)(a) the amount the holder is liable to pay the company` 100 50 1 EQUALS 150
#ASSERT `s 585(2)(a) the amount the holder is liable to pay the company` 100 50 0.5 EQUALS 75
#ASSERT `s 585(3) the person is within the reference to the holder of shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 585(3) the person is within the reference to the holder of shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 585(3) the person is within the reference to the holder of shares` FALSE FALSE EQUALS NOTHING

-- s 586: a public company must not allot a share except as paid up at least as to one-quarter of its nominal value and the whole of any premium.
-- Nominal value 100: one-quarter is 25.
#ASSERT `s 586(2) subsection (1) does not apply to the share` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 586(2) subsection (1) does not apply to the share` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 586(2) subsection (1) does not apply to the share` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 586(2) subsection (1) does not apply to the share` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 25 10 10 NOTHING EQUALS JUST FALSE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 24 10 10 NOTHING EQUALS JUST TRUE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 25 10 9 NOTHING EQUALS JUST TRUE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 25 0 0 NOTHING EQUALS JUST FALSE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 100 0 0 NOTHING EQUALS JUST FALSE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 0 0 0 (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 586(1) the allotment of the share is prohibited` TRUE 100 0 0 0 (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 586(1) the allotment of the share is prohibited` FALSE 100 0 0 0 NOTHING EQUALS NOTHING
-- s 586(3): the share is treated as if one-quarter of its nominal value and the whole premium had been received: 25 + 10 = 35.
#ASSERT `s 586(3)(a) the amount treated as having been received for the share` 100 10 EQUALS 35
-- The allottee pays that minimum less the value of consideration actually applied: 35 - 5 = 30.
#ASSERT `s 586(3)(b) the amount the allottee is liable to pay the company` 100 10 5 EQUALS 30
#ASSERT `s 586(3)(b) the amount the allottee is liable to pay the company` 100 10 0 EQUALS 35
-- s 586(4): bonus shares are exempt unless the allottee knew or ought to have known.
#ASSERT `s 586(4) subsection (3) does not apply to the allotment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 586(4) subsection (3) does not apply to the allotment` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 586(4) subsection (3) does not apply to the allotment` FALSE FALSE EQUALS NOTHING
#ASSERT `s 586(3) the allottee is liable to pay the company` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 586(3) the allottee is liable to pay the company` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 586(3) the allottee is liable to pay the company` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 586(3) the allottee is liable to pay the company` FALSE NOTHING EQUALS JUST FALSE

-- s 587(1): a public company must not allot shares otherwise than for cash if an undertaking is to be, or may be, performed more than five years after the allotment (1 January 2026: 1 January 2031).
#ASSERT `s 587(1) the allotment of the shares is prohibited` TRUE TRUE (Date 1 1 2026) (Date 1 1 2031) EQUALS JUST FALSE
#ASSERT `s 587(1) the allotment of the shares is prohibited` TRUE TRUE (Date 1 1 2026) (Date 2 1 2031) EQUALS JUST TRUE
#ASSERT `s 587(1) the allotment of the shares is prohibited` FALSE TRUE (Date 1 1 2026) (Date 2 1 2031) EQUALS NOTHING
#ASSERT `s 587(1) the allotment of the shares is prohibited` TRUE FALSE (Date 1 1 2026) (Date 2 1 2031) EQUALS NOTHING
-- s 587(2): liability of the allottee.
#ASSERT `s 587(2) the allottee is liable to pay the company` TRUE EQUALS JUST TRUE
#ASSERT `s 587(2) the allottee is liable to pay the company` FALSE EQUALS JUST FALSE
#ASSERT `s 587(2) the amount the allottee is liable to pay the company` 100 50 1 EQUALS 150
#ASSERT `s 587(2) the amount the allottee is liable to pay the company` 100 50 0.4 EQUALS 60
-- s 587(3): a variation that would have made the contract contravene subsection (1) is void.
#ASSERT `s 587(3) the variation is void` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 587(3) the variation is void` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 587(3) the variation is void` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 587(3) the variation is void` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 587(3) the variation is void` FALSE TRUE FALSE EQUALS NOTHING
-- s 587(4): an undertaking within five years not performed within the period allowed: the allottee is liable at the end of that period.
#ASSERT `s 587(4) the allottee is liable to pay the company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 587(4) the allottee is liable to pay the company` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 587(4) the allottee is liable to pay the company` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 587(4) the allottee is liable to pay the company` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 587(4) the date on which the allottee is liable to pay the company` (Date 1 6 2028) EQUALS Date 1 6 2028
#ASSERT `s 587(4) the amount the allottee is liable to pay the company` 100 50 1 EQUALS 150
#ASSERT `s 587(4) the amount the allottee is liable to pay the company` 100 50 0.2 EQUALS 30
-- s 587(5): a contract for the allotment includes an ancillary contract relating to payment.
#ASSERT `s 587(5) the contract is treated as a contract for the allotment of shares` TRUE EQUALS JUST TRUE
#ASSERT `s 587(5) the contract is treated as a contract for the allotment of shares` FALSE EQUALS NOTHING

-- s 588(2): a person otherwise liable is exempted if (a) a purchaser for value without actual notice, or (b) he derived title from a person not liable.
#ASSERT `s 588(2) the person is exempted from the liability` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 588(2) the person is exempted from the liability` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 588(2) the person is exempted from the liability` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 588(2) the person is exempted from the liability` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 588(2) the person is exempted from the liability` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 588(2) the person is exempted from the liability` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 588(1): a person who becomes a holder is also liable, subject to (2).
#ASSERT `s 588(1) the person who becomes a holder is also liable to pay the amount` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 588(1) the person who becomes a holder is also liable to pay the amount` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 588(1) the person who becomes a holder is also liable to pay the amount` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 588(1) the person who becomes a holder is also liable to pay the amount` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 588(1) the person who becomes a holder is also liable to pay the amount` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 588(3) the person is within the reference to a holder of shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 588(3) the person is within the reference to a holder of shares` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 588(3) the person is within the reference to a holder of shares` FALSE FALSE EQUALS NOTHING
#ASSERT `s 588(4) section 588 applies to the failure as it applies to a contravention` TRUE EQUALS JUST TRUE
#ASSERT `s 588(4) section 588 applies to the failure as it applies to a contravention` FALSE EQUALS NOTHING

-- s 589: power of the court to grant relief.
#ASSERT `s 589(1) section 589 applies to the liability` TRUE EQUALS JUST TRUE
#ASSERT `s 589(1) section 589 applies to the liability` FALSE EQUALS NOTHING
#ASSERT `s 589(2) the person may apply to the court to be exempted from the liability in whole or in part` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 589(2) the person may apply to the court to be exempted from the liability in whole or in part` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 589(2) the person may apply to the court to be exempted from the liability in whole or in part` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 589(2) the person may apply to the court to be exempted from the liability in whole or in part` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 589(2) the person may apply to the court to be exempted from the liability in whole or in part` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 589(3) the court may exempt the applicant from a liability within subsection (2)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 589(3) the court may exempt the applicant from a liability within subsection (2)(a)` FALSE EQUALS JUST FALSE
#ASSERT `s 589(4) the court may exempt the applicant from a liability within subsection (2)(b)` TRUE EQUALS JUST TRUE
#ASSERT `s 589(4) the court may exempt the applicant from a liability within subsection (2)(b)` FALSE EQUALS JUST FALSE
-- s 589(5)(a): the company should receive money or money's worth at least equal to the nominal value and premium (100 + 50), or the part treated as paid up.
#ASSERT `s 589(5)(a) the principle that the company should receive at least the aggregate is satisfied` 100 50 1 150 EQUALS JUST TRUE
#ASSERT `s 589(5)(a) the principle that the company should receive at least the aggregate is satisfied` 100 50 1 149 EQUALS JUST FALSE
#ASSERT `s 589(5)(a) the principle that the company should receive at least the aggregate is satisfied` 100 50 0.5 75 EQUALS JUST TRUE
#ASSERT `s 589(5)(a) the principle that the company should receive at least the aggregate is satisfied` 100 50 0.5 74 EQUALS JUST FALSE
#ASSERT `s 589(5)(b) it is for the company to decide which remedy it should remain entitled to pursue` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 589(5)(b) it is for the company to decide which remedy it should remain entitled to pursue` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 589(5)(b) it is for the company to decide which remedy it should remain entitled to pursue` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 589(6) the court may exempt the contributor in whole or in part, or order a larger contribution` TRUE TRUE TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `s 589(6) the court may exempt the contributor in whole or in part, or order a larger contribution` TRUE TRUE FALSE EQUALS JUST FALSE; the function is named for a grant or power ("may", "entitled"), so a failed "if" or "where" answers NOTHING, not JUST FALSE (fork F-grant-gate, name test of 2026-11-12); the facts are unchanged
#ASSERT `s 589(6) the court may exempt the contributor in whole or in part, or order a larger contribution` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 589(6) the court may exempt the contributor in whole or in part, or order a larger contribution` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 589(6) the court may exempt the contributor in whole or in part, or order a larger contribution` TRUE FALSE TRUE EQUALS NOTHING

-- s 590: offences: the company and every officer in default; penalties.
#ASSERT `s 590(1)(a) the company commits an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 590(1)(a) the company commits an offence` FALSE EQUALS JUST FALSE
#ASSERT `s 590(1)(b) the officer of the company commits an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 590(1)(b) the officer of the company commits an offence` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 590(1)(b) the officer of the company commits an offence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 590(1)(b) the officer of the company commits an offence` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 590(2)(a) penalty on conviction on indictment`'s `fine not exceeding` EQUALS JUST `a fine without a stated limit`
#ASSERT `s 590(2)(b) penalty on summary conviction`'s `fine not exceeding` EQUALS JUST (`a fine not exceeding the statutory maximum` 1)
#ASSERT `s 590(2)(b) penalty on summary conviction`'s `daily default fine for continued contravention` EQUALS NOTHING
#ASSERT (count `s 590(2) the penalties for an offence under section 590`) EQUALS 2

-- s 591: an undertaking enforceable by the company apart from the Chapter stays enforceable despite a contravention; without prejudice to s 589.
#ASSERT `s 591(1) the undertaking is enforceable by the company despite a contravention of Chapter 5 or Chapter 6` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 591(1) the undertaking is enforceable by the company despite a contravention of Chapter 5 or Chapter 6` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 591(1) the undertaking is enforceable by the company despite a contravention of Chapter 5 or Chapter 6` FALSE TRUE EQUALS NOTHING
#ASSERT `s 591(2) section 591(1) prejudices the court's power under section 589` TRUE EQUALS JUST FALSE
#ASSERT `s 591(2) section 591(1) prejudices the court's power under section 589` FALSE EQUALS NOTHING

-- s 592: the appropriate rate of interest is 5% per annum or such other rate as an order specifies.
#ASSERT `s 592(1) the appropriate rate of interest, as a fraction per annum` NOTHING EQUALS 0.05
#ASSERT `s 592(1) the appropriate rate of interest, as a fraction per annum` (JUST 0.07) EQUALS 0.07
