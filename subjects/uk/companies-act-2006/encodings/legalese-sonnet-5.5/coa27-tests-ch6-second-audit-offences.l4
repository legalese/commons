IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa27-definitions`
IMPORT `coa27-ch4-register`
IMPORT `coa27-ch6-second-audit-offences`

-- coa27-tests-ch6-second-audit-offences.l4: tests for coa27-ch6-second-audit-offences.l4 (ss 1248 to 1250, 1255 to 1257).
-- Expected values are decided from the text and written beside each assertion. Amounts are illustrative INPUTS (the pounds a
-- level on the standard scale stands for are not in the Act); they are chosen so that the two extents of s 1248(8)(b) agree
-- or differ as the assertion says.

-- =========================================================================================================
-- s 1248
-- =========================================================================================================

-- fields: is an Auditor General, eligible as a statutory auditor, eligible as statutory auditor of the company, prohibited by s 1214(1) (a MAYBE BOOLEAN seam answer)
`s 1248 test person: eligible, not prohibited`        MEANS `s 1248(3) person` OF FALSE, TRUE,  FALSE, JUST FALSE
`s 1248 test person: not eligible`                    MEANS `s 1248(3) person` OF FALSE, FALSE, FALSE, JUST FALSE
`s 1248 test person: eligible but prohibited`         MEANS `s 1248(3) person` OF FALSE, TRUE,  FALSE, JUST TRUE
`s 1248 test person: Auditor General eligible for the company` MEANS `s 1248(3) person` OF TRUE, FALSE, TRUE,  JUST FALSE
`s 1248 test person: Auditor General eligible generally but not for the company` MEANS `s 1248(3) person` OF TRUE, TRUE, FALSE, JUST FALSE
`s 1248 test person: Auditor General eligible for the company but prohibited` MEANS `s 1248(3) person` OF TRUE, FALSE, TRUE, JUST TRUE

`s 1248 test person: eligible, independence not answered` MEANS `s 1248(3) person` OF FALSE, TRUE, FALSE, NOTHING

-- (3) "appropriate" if he (a) is eligible ... (or, if an Auditor General, eligible for appointment as statutory auditor of the company) and (b) is not prohibited by s 1214(1)
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: eligible, not prohibited` EQUALS JUST TRUE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: not eligible` EQUALS JUST FALSE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: eligible but prohibited` EQUALS JUST FALSE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: Auditor General eligible for the company` EQUALS JUST TRUE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: Auditor General eligible generally but not for the company` EQUALS JUST FALSE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: Auditor General eligible for the company but prohibited` EQUALS JUST FALSE
-- the independence answer belongs to another part; if it is not known the answer is not covered, never FALSE
#ASSERT `s 1248(3) the person is appropriate` `s 1248 test person: eligible, independence not answered` EQUALS NOTHING
-- a person who is not eligible is not appropriate whatever the independence answer is
#ASSERT `s 1248(3) the person is appropriate` (`s 1248(3) person` OF FALSE, FALSE, FALSE, NOTHING) EQUALS JUST FALSE

-- (1) "applies where" the appointed person was not appropriate for any part of the audit period; (2) the direction
#ASSERT `s 1248(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 1248(1) this section applies` FALSE EQUALS JUST FALSE
#ASSERT `s 1248(2) the Secretary of State may direct the company to retain an appropriate person` TRUE EQUALS JUST TRUE
#ASSERT `s 1248(2) the Secretary of State may direct the company to retain an appropriate person` FALSE EQUALS JUST FALSE
-- (4) a copy of a direction under (2) goes to the registrar
#ASSERT `s 1248(4) the Secretary of State must send a copy of the direction to the registrar of companies` TRUE EQUALS JUST TRUE
#ASSERT `s 1248(4) the Secretary of State must send a copy of the direction to the registrar of companies` FALSE EQUALS NOTHING

-- (5)(a) "the period of 21 days beginning with the date on which it is given": given 1 March 2027, day one is 1 March, day 21 is 21 March
#ASSERT `s 1248(5)(a) the last day of the period of 21 days beginning with the date the direction is given` (Date 1 3 2027) EQUALS Date 21 3 2027
-- across a month end in a leap year: given 15 February 2028 (29 days), day 21 is 6 March 2028
#ASSERT `s 1248(5)(a) the last day of the period of 21 days beginning with the date the direction is given` (Date 15 2 2028) EQUALS Date 6 3 2028
-- complied on day 21 (21 March): in time. Complied on day 22 (22 March): failed.
#ASSERT NOT (`s 1248(5)(a) the company fails to comply with the direction within the period of 21 days` (Date 1 3 2027) (JUST (Date 21 3 2027)) (Date 30 3 2027))
#ASSERT `s 1248(5)(a) the company fails to comply with the direction within the period of 21 days` (Date 1 3 2027) (JUST (Date 22 3 2027)) (Date 30 3 2027)
-- not complied: as at day 21 the period has not yet been missed; as at day 22 it has
#ASSERT NOT (`s 1248(5)(a) the company fails to comply with the direction within the period of 21 days` (Date 1 3 2027) NOTHING (Date 21 3 2027))
#ASSERT `s 1248(5)(a) the company fails to comply with the direction within the period of 21 days` (Date 1 3 2027) NOTHING (Date 22 3 2027)
-- (5)(b) a previous conviction and the failure continues after it
#ASSERT `s 1248(5)(b) the failure continues after a previous conviction` TRUE TRUE
#ASSERT NOT (`s 1248(5)(b) the failure continues after a previous conviction` TRUE FALSE)
#ASSERT NOT (`s 1248(5)(b) the failure continues after a previous conviction` FALSE TRUE)
-- (5) guilty if (a) or (b)
#ASSERT `s 1248(5) the company is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1248(5) the company is guilty of an offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1248(5) the company is guilty of an offence` FALSE FALSE EQUALS JUST FALSE

-- (6)(a) copy of the report to the registrar; (6)(b) if the report states a second audit is needed, take the steps
#ASSERT `s 1248(6)(a) the company must send a copy of the report to the registrar of companies` TRUE EQUALS JUST TRUE
#ASSERT `s 1248(6)(a) the company must send a copy of the report to the registrar of companies` FALSE EQUALS NOTHING
#ASSERT `s 1248(6)(b) the company must take the steps necessary for the carrying out of the second audit` TRUE EQUALS JUST TRUE
#ASSERT `s 1248(6)(b) the company must take the steps necessary for the carrying out of the second audit` FALSE EQUALS JUST FALSE

-- (7)(a) received 10 June 2027: day 21 is 30 June. Sent 30 June: in time. Sent 1 July: failed.
#ASSERT NOT (`s 1248(7)(a) the company fails to send a copy of the report to the registrar within the period of 21 days` (Date 10 6 2027) (JUST (Date 30 6 2027)) (Date 15 7 2027))
#ASSERT `s 1248(7)(a) the company fails to send a copy of the report to the registrar within the period of 21 days` (Date 10 6 2027) (JUST (Date 1 7 2027)) (Date 15 7 2027)
#ASSERT NOT (`s 1248(7)(a) the company fails to send a copy of the report to the registrar within the period of 21 days` (Date 10 6 2027) NOTHING (Date 30 6 2027))
#ASSERT `s 1248(7)(a) the company fails to send a copy of the report to the registrar within the period of 21 days` (Date 10 6 2027) NOTHING (Date 1 7 2027)
-- (7)(b) in a case within (6)(b), fails to take the steps immediately it receives the report
#ASSERT `s 1248(7)(b) the company fails to take the steps immediately it receives the report` TRUE FALSE
#ASSERT NOT (`s 1248(7)(b) the company fails to take the steps immediately it receives the report` TRUE TRUE)
#ASSERT NOT (`s 1248(7)(b) the company fails to take the steps immediately it receives the report` FALSE FALSE)
-- (7)(c)
#ASSERT `s 1248(7)(c) the failure continues after a previous conviction` TRUE TRUE
#ASSERT NOT (`s 1248(7)(c) the failure continues after a previous conviction` TRUE FALSE)
#ASSERT NOT (`s 1248(7)(c) the failure continues after a previous conviction` FALSE TRUE)
#ASSERT `s 1248(7) the company is guilty of an offence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 1248(7) the company is guilty of an offence` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1248(7) the company is guilty of an offence` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1248(7) the company is guilty of an offence` FALSE FALSE FALSE EQUALS JUST FALSE

-- (8)(a): a fine not exceeding level 5 on the standard scale, on summary conviction
#ASSERT `s 1248(8) the penalty on the first extent of the text for` `s 1248(5)(a) failure to comply with the direction within 21 days` EQUALS Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, FALSE
#ASSERT `s 1248(8) the penalty on the first extent of the text for` `s 1248(7)(a) failure to send the copy of the report within 21 days` EQUALS Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, FALSE
#ASSERT `s 1248(8) the penalty on the first extent of the text for` `s 1248(7)(b) failure to take the steps immediately` EQUALS Penalty OF `on summary conviction`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, FALSE
-- (8)(b), first extent: one-tenth of level 5 for each day on which the failure continues
#ASSERT `s 1248(8) the penalty on the first extent of the text for` `s 1248(5)(b) continued failure to comply after a previous conviction` EQUALS Penalty OF `on summary conviction`, NOTHING, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 5, 0.1), FALSE
#ASSERT `s 1248(8) the penalty on the first extent of the text for` `s 1248(7)(c) continued failure to send the copy or take the steps after a previous conviction` EQUALS Penalty OF `on summary conviction`, NOTHING, NOTHING, JUST (`a fine not exceeding a level on the standard scale` OF 5, 0.1), FALSE
-- amounts: ILLUSTRATIVE inputs. level 4 = 2,500 and level 5 = 5,000: first extent 5,000/10 = 500; second extent greater of 5,000 and 2,500 = 5,000, /10 = 500
#ASSERT `s 1248(8)(b) the daily fine on the first extent in pounds` 5000 EQUALS 500
#ASSERT `s 1248(8)(b) the daily fine on the second extent in pounds` 2500 EQUALS 500
#ASSERT `s 1248(8)(b) the maximum daily fine in pounds` 2500 5000 EQUALS JUST 500
-- level 4 = 8,000 (greater than 5,000): the second extent is 800, the first (level 5 = 5,000) is 500: the extents differ, the text does not say which governs
#ASSERT `s 1248(8)(b) the daily fine on the second extent in pounds` 8000 EQUALS 800
#ASSERT `s 1248(8)(b) the maximum daily fine in pounds` 8000 5000 EQUALS NOTHING
-- level 5 = 10,000, level 4 = 2,500: first extent 1,000, second 500: differ
#ASSERT `s 1248(8)(b) the maximum daily fine in pounds` 2500 10000 EQUALS NOTHING
-- the fine for each case
#ASSERT `s 1248(8) the maximum fine in pounds for` `s 1248(5)(a) failure to comply with the direction within 21 days` 2500 5000 EQUALS JUST 5000
#ASSERT `s 1248(8) the maximum fine in pounds for` `s 1248(7)(a) failure to send the copy of the report within 21 days` 2500 5000 EQUALS JUST 5000
#ASSERT `s 1248(8) the maximum fine in pounds for` `s 1248(7)(b) failure to take the steps immediately` 2500 5000 EQUALS JUST 5000
#ASSERT `s 1248(8) the maximum fine in pounds for` `s 1248(5)(b) continued failure to comply after a previous conviction` 2500 5000 EQUALS JUST 500
#ASSERT `s 1248(8) the maximum fine in pounds for` `s 1248(7)(c) continued failure to send the copy or take the steps after a previous conviction` 8000 5000 EQUALS NOTHING
#ASSERT `s 1248(8) the fine is for each day on which the failure continues` `s 1248(5)(b) continued failure to comply after a previous conviction`
#ASSERT `s 1248(8) the fine is for each day on which the failure continues` `s 1248(7)(c) continued failure to send the copy or take the steps after a previous conviction`
#ASSERT NOT (`s 1248(8) the fine is for each day on which the failure continues` `s 1248(5)(a) failure to comply with the direction within 21 days`)
-- (9) the registrar of companies has the meaning given by s 1060
#ASSERT `s 1248(9) the person is the registrar of companies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1248(9) the person is the registrar of companies` NOTHING EQUALS NOTHING

-- the two 21-day duties as regulative rules. Time 0 is the first of the 21 days; the duty is met at time 20 and breached when the clock passes 20.
-- (the stable binary cannot assert on a deontic value; the twin functions above carry the counted assertions)
#TRACE `s 1248(5)(a) the company must comply with the direction` AT 0 WITH
    PARTY Company DOES `s 1248 comply with the direction under subsection (2)` AT 20

#TRACE `s 1248(5)(a) the company must comply with the direction` AT 0 WITH
    PARTY Company DOES `s 1248 comply with the direction under subsection (2)` AT 21

#TRACE `s 1248(7)(a) the company must send a copy of the report to the registrar` AT 0 WITH
    PARTY Company DOES `s 1248 send a copy of the report to the registrar of companies` AT 20

#TRACE `s 1248(7)(a) the company must send a copy of the report to the registrar` AT 0 WITH
    PARTY Company DOES `s 1248 send a copy of the report to the registrar of companies` AT 21

-- =========================================================================================================
-- s 1249
-- =========================================================================================================

-- (1) accepts or continues knowing he is not appropriate: the company may recover its costs
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: not eligible` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: eligible but prohibited` TRUE TRUE EQUALS JUST TRUE
-- an appropriate person cannot "know he is not an appropriate person": no right to recover
-- RECONCILED 2026-11-12: was #ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: eligible, not prohibited` TRUE TRUE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q2)
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: eligible, not prohibited` TRUE TRUE EQUALS NOTHING
-- he did not know
-- RECONCILED 2026-11-12: was #ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: not eligible` TRUE FALSE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q2)
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: not eligible` TRUE FALSE EQUALS NOTHING
-- he did not accept or continue
-- RECONCILED 2026-11-12: was #ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: not eligible` FALSE TRUE EQUALS JUST FALSE; the function is named for a power ("may ..."), so a failed "if" gate answers NOTHING, since JUST FALSE would read as "may not" (name-test sweep of 2026-11-12, fork F-Q2)
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: not eligible` FALSE TRUE EQUALS NOTHING
-- whether he is appropriate turns on s 1214(1), a seam answer: not known, not covered
#ASSERT `s 1249(1) the company may recover from the person the costs it incurred in complying with section 1248` `s 1248 test person: eligible, independence not answered` TRUE TRUE EQUALS NOTHING
-- the amount: any costs incurred (illustrative 12,000)
#ASSERT `s 1249(1) the amount the company may recover from the person` TRUE 12000 EQUALS JUST 12000
-- no right to recover: no amount is stated (not 0)
#ASSERT `s 1249(1) the amount the company may recover from the person` FALSE 12000 EQUALS NOTHING
#ASSERT `s 1249(1) the amount the company may recover from the person` TRUE 0 EQUALS JUST 0
-- (2) in so far as practicable
#ASSERT `s 1249(2) the provision applies also in relation to the second audit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1249(2) the provision applies also in relation to the second audit` TRUE FALSE EQUALS NOTHING
#ASSERT `s 1249(2) the provision applies also in relation to the second audit` FALSE TRUE EQUALS NOTHING
-- (3) injunction or, in Scotland, order under section 45 of the Court of Session Act 1988
#ASSERT `s 1249(3) the direction is enforceable by` TRUE TRUE FALSE EQUALS JUST `s 1239(8) an injunction`
#ASSERT `s 1249(3) the direction is enforceable by` TRUE TRUE TRUE EQUALS JUST `s 1239(8) an order under section 45 of the Court of Session Act 1988`
#ASSERT `s 1249(3) the direction is enforceable by` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1249(3) the direction is enforceable by` FALSE TRUE FALSE EQUALS NOTHING

-- =========================================================================================================
-- s 1250
-- =========================================================================================================

-- (1) guilty if (a) for an application under this Part or (b) in purported compliance, and he knowingly or recklessly furnishes information misleading, false or deceptive in a material particular
#ASSERT `s 1250(1) the person is guilty of an offence` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(1) the person is guilty of an offence` FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(1) the person is guilty of an offence` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1250(1) the person is guilty of an offence` FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1250(1) the person is guilty of an offence` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- (2), (3), (4): it is an offence for a person whose name does not appear on the register to describe himself so, or to hold himself out so
#ASSERT `s 1250(2) the person commits an offence by describing himself as a registered auditor` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1250(2) the person commits an offence by describing himself as a registered auditor` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(2) the person commits an offence by describing himself as a registered auditor` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 1250(2) the person commits an offence by describing himself as a registered auditor` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 1250(3) the person commits an offence by describing himself as a registered third country auditor` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1250(3) the person commits an offence by describing himself as a registered third country auditor` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(3) the person commits an offence by describing himself as a registered third country auditor` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 1250(4) the body commits an offence by describing itself as a recognised body` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 1250(4) the body commits an offence by describing itself as a recognised body` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(4) the body commits an offence by describing itself as a recognised body` FALSE TRUE TRUE EQUALS NOTHING

-- (5) penalty for an offence under (1): on indictment two years or a fine (or both); on summary conviction in England and Wales, the general limit in a magistrates' court (an input, here 12 months) or the statutory maximum (or both); in Scotland or Northern Ireland six months or the statutory maximum (or both)
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on conviction on indictment` (Date 1 6 2026) 12 EQUALS JUST (Penalty OF `on conviction on indictment`, JUST (Period OF 2, Years), JUST `a fine without a stated limit`, NOTHING, TRUE)
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction in England and Wales` (Date 1 6 2026) 12 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, TRUE)
-- committed before 2 May 2022: "six months" in place of the general limit (the leftover instruction at src:17692; fork F-A). 1 May 2022 is before, 2 May 2022 is not.
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction in England and Wales` (Date 1 5 2022) 12 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, TRUE)
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction in England and Wales` (Date 2 5 2022) 12 EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 12, Months), JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, TRUE)
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction in Scotland` (Date 1 6 2026) 12 EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, TRUE)
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction in Northern Ireland` (Date 1 6 2026) 12 EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding the statutory maximum` OF 1), NOTHING, TRUE)
-- a bare "on summary conviction" does not say which of paragraphs (b)(i) and (b)(ii) applies
#ASSERT `s 1250(5) the penalty for an offence under subsection (1)` `on summary conviction` (Date 1 6 2026) 12 EQUALS NOTHING

-- (6) penalty for (2), (3), (4): England and Wales 51 weeks or level 5 (or both); Scotland or Northern Ireland six months or level 5 (or both); before the commencement of s 281(5) CJA 2003 six months in place of 51 weeks
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on summary conviction in England and Wales` FALSE EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 51, Weeks), JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, TRUE)
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on summary conviction in England and Wales` TRUE EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, JUST (Period OF 6, Months), JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, TRUE)
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on summary conviction in Scotland` FALSE EQUALS JUST (Penalty OF `on summary conviction in Scotland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, TRUE)
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on summary conviction in Northern Ireland` FALSE EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, JUST (Period OF 6, Months), JUST (`a fine not exceeding a level on the standard scale` OF 5, 1), NOTHING, TRUE)
-- the paragraphs give no penalty on indictment for these offences
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on conviction on indictment` FALSE EQUALS NOTHING
#ASSERT `s 1250(6) the penalty for an offence under subsection (2), (3) or (4)` `on summary conviction` FALSE EQUALS NOTHING
-- (7) where the contravention involves a public display, the maximum fine is level 5 multiplied by the number of days the display has continued (illustrative level 5 = 5,000; 3 days)
#ASSERT `s 1250(7) the maximum fine that may be imposed` TRUE 5000 3 EQUALS JUST 15000
#ASSERT `s 1250(7) the maximum fine that may be imposed` TRUE 5000 1 EQUALS JUST 5000
#ASSERT `s 1250(7) the maximum fine that may be imposed` FALSE 5000 3 EQUALS NOTHING
-- (8) defence: all reasonable precautions and all due diligence
#ASSERT `s 1250(8) the section gives the person a defence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1250(8) the section gives the person a defence` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1250(8) the section gives the person a defence` TRUE FALSE TRUE EQUALS JUST FALSE
-- charged under subsection (1): this defence is not for him
#ASSERT `s 1250(8) the section gives the person a defence` FALSE TRUE TRUE EQUALS NOTHING

-- =========================================================================================================
-- s 1255
-- =========================================================================================================

-- (1) fields: committed by a body corporate, consent or connivance proved, neglect proved, purports to act as officer, officer under s 1261(1)
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE TRUE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE FALSE TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
-- "or a person purporting to act in any such capacity"
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- not an officer and not purporting to act as one
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- s 1261(1) "officer" includes: a person it does not name is not covered, never FALSE
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE TRUE FALSE FALSE NOTHING EQUALS NOTHING
-- neither consent nor neglect proved: the "Where" fails
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
-- not an offence committed by a body corporate
#ASSERT `s 1255(1) the officer is guilty of the offence as well as the body corporate` FALSE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- (2) partnership and partner
#ASSERT `s 1255(2) the partner is guilty of the offence as well as the partnership` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1255(2) the partner is guilty of the offence as well as the partnership` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1255(2) the partner is guilty of the offence as well as the partnership` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1255(2) the partner is guilty of the offence as well as the partnership` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 1255(2) the partner is guilty of the offence as well as the partnership` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- (3) unincorporated association (other than a partnership)
#ASSERT `s 1255(3) the officer or member is guilty of the offence as well as the association` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 1255(3) the officer or member is guilty of the offence as well as the association` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 1255(3) the officer or member is guilty of the offence as well as the association` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 1255(3) the officer or member is guilty of the offence as well as the association` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 1255(3) the officer or member is guilty of the offence as well as the association` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

-- =========================================================================================================
-- s 1256
-- =========================================================================================================

-- "the period of twelve months beginning with the date": 1 January 2025 ends on 31 December 2025
#ASSERT `s 1256(1) the last day of the period of twelve months beginning with` (Date 1 1 2025) EQUALS Date 31 12 2025
#ASSERT `s 1256(1) the last day of the period of twelve months beginning with` (Date 15 1 2025) EQUALS Date 14 1 2026
#ASSERT `s 1256(1) the last day of the period of twelve months beginning with` (Date 31 1 2025) EQUALS Date 30 1 2026
#ASSERT `s 1256(1) the last day of the period of twelve months beginning with` (Date 1 3 2024) EQUALS Date 28 2 2025
-- a start on 29 February: the corresponding date does not exist; the period ends on 28 February (fork F-C)
#ASSERT `s 1256(1) the last day of the period of twelve months beginning with` (Date 29 2 2024) EQUALS Date 28 2 2025
-- (1) England and Wales: evidence came to knowledge on 10 March 2025, so the last day is 9 March 2026
#ASSERT `s 1256(1) the information may be tried in England and Wales` (Date 9 3 2026) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 1256(1) the information may be tried in England and Wales` (Date 10 3 2026) (Date 10 3 2025) EQUALS JUST FALSE
