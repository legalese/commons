IMPORT prelude
IMPORT daydate
IMPORT `coa-core`
IMPORT `coa6-notification-of-changes`
IMPORT `coa6-offence-of-failure-to-notify`

-- coa6-tests-offence.l4: tests of coa6-offence-of-failure-to-notify.l4 (s 279M), including its wiring to the answers of ss 279G,
-- 279H and 279I. Every expected value was decided by reading s 279M (lines 3706-3713 of ukpga-2006-46.txt) before the encoding was
-- run, and is written beside its assertion. The pounds for "level 5" are an ILLUSTRATION: the Act does not say what a level stands for.

§ `Tests: s 279M`

-- ---- s 279M(1): "fails ... to comply with section 279G, 279H or 279I" -----------------------------------------------------------
-- arguments: failed 279G?, failed 279H?, failed 279I?
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- one has failed, another is not yet decided: still a failure
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- none has failed, one is not yet decided: not decided
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` NOTHING NOTHING NOTHING EQUALS NOTHING

-- The wiring: a company that gave a complete notice of a new secretary one day late (s 279G(5)), and had nothing to do under ss 279H
-- and 279I, has failed to comply with s 279G and so with s 279M(1).
`s 279M test failed to comply with section 279G` MEANS
    `s 279G the company has failed to comply with section 279G` `s 279G(1)(a) a person becomes the secretary or one of the joint secretaries of the company` FALSE FALSE (Date 1 3 2024) (JUST (`s 279G notice given` OF (Date 15 3 2024), TRUE, TRUE, TRUE)) (Date 20 3 2024)

#ASSERT `s 279M test failed to comply with section 279G` EQUALS JUST TRUE
#ASSERT `s 279M(1) the company has failed to comply with section 279G, 279H or 279I` `s 279M test failed to comply with section 279G` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE

-- ---- s 279M(1)(a): the company -----------------------------------------------------------------------------------------------------------
-- arguments: failed to comply?, the company had a reasonable excuse?
#ASSERT `s 279M(1)(a) the company commits an offence` (JUST TRUE) FALSE EQUALS JUST TRUE
-- "without reasonable excuse": a reasonable excuse takes the case out of the offence's own wording (not covered, never FALSE)
#ASSERT `s 279M(1)(a) the company commits an offence` (JUST TRUE) TRUE EQUALS NOTHING
-- no failure: the "if" is not met
#ASSERT `s 279M(1)(a) the company commits an offence` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 279M(1)(a) the company commits an offence` NOTHING FALSE EQUALS NOTHING

-- ---- s 279M(2): the shadow director -------------------------------------------------------------------------------------------------------
#ASSERT `s 279M(2) a shadow director is treated as an officer of the company` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 279M(2) a shadow director is treated as an officer of the company` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 279M(2) a shadow director is treated as an officer of the company` NOTHING EQUALS NOTHING

-- ---- s 279M(1)(b): every officer in default ---------------------------------------------------------------------------------------------------
-- arguments: failed to comply?, reasonable excuse?, officer (s 1173(1))?, shadow director (s 251)?, in default (s 1121)?
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
-- a shadow director is treated as an officer even where s 1173(1) leaves the position open
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE NOTHING (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- an officer who is not in default is outside "every officer of the company who is in default"
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING
-- a person who is neither an officer nor a shadow director is not named by the text
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) FALSE NOTHING NOTHING (JUST TRUE) EQUALS NOTHING
-- the company had a reasonable excuse
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
-- no failure to comply
#ASSERT `s 279M(1)(b) the officer commits an offence` (JUST FALSE) FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 279M(1)(b) the officer commits an offence` NOTHING FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- ---- s 279M(3): the penalty --------------------------------------------------------------------------------------------------------------------
-- (a) England and Wales: "to a fine" (no limit stated, no daily default fine stated, no imprisonment)
#ASSERT `s 279M(3) the penalty on a person guilty of an offence under section 279M` `on summary conviction in England and Wales` EQUALS JUST (Penalty OF `on summary conviction in England and Wales`, NOTHING, JUST `a fine without a stated limit`, NOTHING, FALSE)
-- (b) Scotland or Northern Ireland: level 5, and a daily default fine of one-tenth of level 5
#ASSERT `s 279M(3) the penalty on a person guilty of an offence under section 279M` `on summary conviction in Scotland` EQUALS JUST (Penalty OF `on summary conviction in Scotland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 5 1), JUST (`a fine not exceeding a level on the standard scale` 5 0.1), FALSE)
#ASSERT `s 279M(3) the penalty on a person guilty of an offence under section 279M` `on summary conviction in Northern Ireland` EQUALS JUST (Penalty OF `on summary conviction in Northern Ireland`, NOTHING, JUST (`a fine not exceeding a level on the standard scale` 5 1), JUST (`a fine not exceeding a level on the standard scale` 5 0.1), FALSE)
-- a summary conviction in no stated place, or a conviction on indictment: not covered
#ASSERT `s 279M(3) the penalty on a person guilty of an offence under section 279M` `on summary conviction` EQUALS NOTHING
#ASSERT `s 279M(3) the penalty on a person guilty of an offence under section 279M` `on conviction on indictment` EQUALS NOTHING
-- in pounds (illustrative: level 5 stands for 100,000 pounds)
#ASSERT `s 279M(3) the most the person may be fined, in pounds` `on summary conviction in Scotland` 100000 EQUALS JUST 100000
#ASSERT `s 279M(3) the most the person may be fined, in pounds` `on summary conviction in Northern Ireland` 100000 EQUALS JUST 100000
#ASSERT `s 279M(3) the most the person may be fined, in pounds` `on summary conviction in England and Wales` 100000 EQUALS NOTHING
#ASSERT `s 279M(3) the most the person may be fined, in pounds` `on summary conviction` 100000 EQUALS NOTHING
#ASSERT `s 279M(3) the most the person may be fined, in pounds` `on conviction on indictment` 100000 EQUALS NOTHING
#ASSERT `s 279M(3) the most the daily default fine may be, in pounds` `on summary conviction in Scotland` 100000 EQUALS JUST 10000
#ASSERT `s 279M(3) the most the daily default fine may be, in pounds` `on summary conviction in Northern Ireland` 100000 EQUALS JUST 10000
#ASSERT `s 279M(3) the most the daily default fine may be, in pounds` `on summary conviction in England and Wales` 100000 EQUALS NOTHING
#ASSERT `s 279M(3) the most the daily default fine may be, in pounds` `on summary conviction` 100000 EQUALS NOTHING
#ASSERT `s 279M(3) the most the daily default fine may be, in pounds` `on conviction on indictment` 100000 EQUALS NOTHING
