#ASSERT `s 919(2) the company is one of the companies involved in the division` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 919(2) the company is one of the companies involved in the division` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 919(2) the company is one of the companies involved in the division` FALSE FALSE EQUALS JUST FALSE

