IMPORT prelude
IMPORT daydate
IMPORT `gas-types`
IMPORT `gas-connection`
IMPORT `gas-cutoff`
IMPORT `gas-redress`
IMPORT `gas-goal`

-- Gas Act 1986 (UK) — the encoder's tests. Expected values are worked by
-- hand from the Act.

§ `Tests`

§§ `Goal 1 — connection`

-- Fields: area, within 23 m, own pipe, already connected, notice, day named,
-- reasonable, therms a year, prevented, danger, pipe unfit, new main needed,
-- contract, security not given.
near MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
ownpipe MEANS `Connection request` OF TRUE, FALSE, TRUE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
neither MEANS `Connection request` OF TRUE, FALSE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
outside MEANS `Connection request` OF FALSE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
nonotice MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, NOTHING, NOTHING, TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
daybefore MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 28 2 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
tooSoon MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 2 3 2026), FALSE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
big MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 80000, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
atcap MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 75000, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
prevented MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
unfitOwn MEANS `Connection request` OF TRUE, FALSE, TRUE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
unfitNear MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
mainNoContract MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 3000, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
mainContract MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 3000, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE
mainSmall MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 2500, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
nosecurity MEANS `Connection request` OF TRUE, TRUE, FALSE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
ownNoSecurity MEANS `Connection request` OF TRUE, FALSE, TRUE, FALSE, JUST (Date 1 3 2026), JUST (Date 1 4 2026), TRUE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
existing MEANS `Connection request` OF FALSE, FALSE, FALSE, TRUE, NOTHING, NOTHING, FALSE, 500, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
existingBig MEANS `Connection request` OF FALSE, FALSE, FALSE, TRUE, NOTHING, NOTHING, FALSE, 80000, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

#ASSERT `must the transporter connect` near EQUALS `must connect`
#ASSERT `the connection charge for` near EQUALS `the cost of supplying and laying the pipe`
#ASSERT NOT (`my pipe vests in the transporter on connection for` near)
#ASSERT `interest is payable on a security deposit for` near
#ASSERT `must the transporter connect` ownpipe EQUALS `must connect`
#ASSERT `the connection charge for` ownpipe EQUALS `the cost of making the connection`
#ASSERT `my pipe vests in the transporter on connection for` ownpipe
#ASSERT `must the transporter connect` neither EQUALS `the duty does not cover my premises`
#ASSERT `must the transporter connect` outside EQUALS `the duty does not cover my premises`
#ASSERT `must the transporter connect` nonotice EQUALS `no valid notice yet`
#ASSERT `must the transporter connect` daybefore EQUALS `no valid notice yet`
#ASSERT `must the transporter connect` tooSoon EQUALS `no valid notice yet`
-- s 10(8): "likely to exceed 75,000 therms"; exactly 75,000 does not.
#ASSERT `must the transporter connect` big EQUALS `need not: over 75,000 therms`
#ASSERT `must the transporter connect` atcap EQUALS `may refuse to lay the pipe until security is given`
#ASSERT `must the transporter connect` prevented EQUALS `need not: circumstances under s 10(9)`
#ASSERT `must the transporter connect` unfitOwn EQUALS `need not: circumstances under s 10(9)`
-- s 10(9)(c) is only for premises within s 10(1)(b).
#ASSERT `must the transporter connect` unfitNear EQUALS `must connect`
#ASSERT `must the transporter connect` mainNoContract EQUALS `may refuse until a written contract is made`
#ASSERT `must the transporter connect` mainContract EQUALS `must connect`
-- s 10(10)(c): "exceeding 2,500 therms a year".
#ASSERT `must the transporter connect` mainSmall EQUALS `must connect`
#ASSERT `must the transporter connect` nosecurity EQUALS `may refuse to lay the pipe until security is given`
-- s 11 applies only where the transporter lays the pipe under s 10(2)(a).
#ASSERT `must the transporter connect` ownNoSecurity EQUALS `must connect`
#ASSERT NOT (`interest is payable on a security deposit for` ownpipe)
-- s 10(3): an existing connection is maintained, whatever s 10(1) says.
#ASSERT `must the transporter connect` existing EQUALS `must maintain the connection`
#ASSERT `must the transporter connect` existingBig EQUALS `need not: over 75,000 therms`
#ASSERT `the connection charge for` existing EQUALS `no charge under s 10`
#ASSERT NOT (`my pipe vests in the transporter on connection for` existing)

§§ `Goal 2 — cutting off for debt`

GIVEN dm IS A DATE, pd IS A MAYBE DATE
GIVETH A MAYBE `Payment demand`
`a demand on` dm `paid` pd MEANS JUST (`Payment demand` OF dm, pd, FALSE)

GIVEN rq IS A DATE, gv IS A MAYBE DATE
GIVETH A MAYBE `Deposit request`
`a deposit request on` rq `met` gv MEANS JUST (`Deposit request` OF rq, gv, FALSE)

ok MEANS `Entry facts` OF 24, TRUE, TRUE, TRUE
short MEANS `Entry facts` OF 23, TRUE, TRUE, TRUE
nodoc MEANS `Entry facts` OF 48, TRUE, FALSE, TRUE

stillIn MEANS `Restoration facts` OF FALSE, FALSE, FALSE, FALSE
madeGood MEANS `Restoration facts` OF FALSE, TRUE, TRUE, TRUE
goodNotPaid MEANS `Restoration facts` OF FALSE, TRUE, FALSE, FALSE
leftPremises MEANS `Restoration facts` OF TRUE, FALSE, FALSE, FALSE

-- Demand 1 March 2026: payment by 29 March is in time; the power arises on
-- 30 March. Notice 30 March: the earliest day to act is 6 April.
unpaid MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, JUST ok, JUST stillIn
early MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 5 4 2026, JUST ok, NOTHING
noticeTooSoon MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, TRUE, FALSE, JUST (Date 29 3 2026), Date 6 4 2026, NOTHING, NOTHING
noNotice MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, TRUE, FALSE, NOTHING, Date 6 4 2026, NOTHING, NOTHING
paidInTime MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` (JUST (Date 29 3 2026)), NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
paidLate MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` (JUST (Date 3 4 2026)), NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
paidOnTheDay MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` (JUST (Date 6 4 2026)), NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
paidAfter MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` (JUST (Date 7 4 2026)), NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
disputed MEANS `Cut-off case` OF JUST (`Payment demand` OF Date 1 3 2026, NOTHING, TRUE), NOTHING, TRUE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, JUST ok, JUST stillIn
oldSupplier MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, FALSE, FALSE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
assigned MEANS `Cut-off case` OF `a demand on` (Date 1 3 2026) `paid` NOTHING, NOTHING, FALSE, TRUE, JUST (Date 30 3 2026), Date 6 4 2026, NOTHING, NOTHING
-- Deposit requested 1 March 2026: may be met by 8 March; the power arises on
-- 9 March. Notice 9 March: the earliest day to act is 16 March.
deposit MEANS `Cut-off case` OF NOTHING, `a deposit request on` (Date 1 3 2026) `met` NOTHING, TRUE, FALSE, JUST (Date 9 3 2026), Date 16 3 2026, NOTHING, NOTHING
depositInTime MEANS `Cut-off case` OF NOTHING, `a deposit request on` (Date 1 3 2026) `met` (JUST (Date 8 3 2026)), TRUE, FALSE, JUST (Date 9 3 2026), Date 16 3 2026, NOTHING, NOTHING
depositLate MEANS `Cut-off case` OF NOTHING, `a deposit request on` (Date 1 3 2026) `met` (JUST (Date 10 3 2026)), TRUE, FALSE, JUST (Date 9 3 2026), Date 16 3 2026, NOTHING, NOTHING
-- Demand 1 February 2026: the power arises on 2 March. Deposit 1 March:
-- 9 March. Notice 5 March is after the first: 12 March.
both MEANS `Cut-off case` OF `a demand on` (Date 1 2 2026) `paid` NOTHING, `a deposit request on` (Date 1 3 2026) `met` NOTHING, TRUE, FALSE, JUST (Date 5 3 2026), Date 12 3 2026, NOTHING, NOTHING
-- Leap year: demand 1 February 2028 + 29 = 1 March 2028.
leap MEANS `Cut-off case` OF `a demand on` (Date 1 2 2028) `paid` NOTHING, NOTHING, TRUE, FALSE, JUST (Date 1 3 2028), Date 8 3 2028, NOTHING, NOTHING
leapEarly MEANS `Cut-off case` OF `a demand on` (Date 1 2 2028) `paid` NOTHING, NOTHING, TRUE, FALSE, JUST (Date 29 2 2028), Date 8 3 2028, NOTHING, NOTHING

#ASSERT `the earliest day my supply can be cut off for` unpaid EQUALS JUST (Date 6 4 2026)
#ASSERT `my supply may be cut off on the day for` unpaid
#ASSERT `the earliest day my supply can be cut off for` early EQUALS JUST (Date 6 4 2026)
#ASSERT NOT (`my supply may be cut off on the day for` early)
#ASSERT `the earliest day my supply can be cut off for` noticeTooSoon EQUALS NOTHING
#ASSERT NOT (`my supply may be cut off on the day for` noticeTooSoon)
#ASSERT `the earliest day my supply can be cut off for` noNotice EQUALS NOTHING
#ASSERT `the earliest day my supply can be cut off for` paidInTime EQUALS NOTHING
-- Changed after the independent pass (D3): a late payment does not end the
-- power (F3).
#ASSERT `the earliest day my supply can be cut off for` paidLate EQUALS JUST (Date 6 4 2026)
#ASSERT `the earliest day my supply can be cut off for` paidOnTheDay EQUALS JUST (Date 6 4 2026)
#ASSERT `the earliest day my supply can be cut off for` paidAfter EQUALS JUST (Date 6 4 2026)
#ASSERT `the earliest day my supply can be cut off for` disputed EQUALS NOTHING
#ASSERT `the earliest day my supply can be cut off for` oldSupplier EQUALS NOTHING
#ASSERT `the earliest day my supply can be cut off for` assigned EQUALS JUST (Date 6 4 2026)
#ASSERT `the earliest day my supply can be cut off for` deposit EQUALS JUST (Date 16 3 2026)
#ASSERT `the earliest day my supply can be cut off for` depositInTime EQUALS NOTHING
#ASSERT `the earliest day my supply can be cut off for` depositLate EQUALS JUST (Date 16 3 2026)
#ASSERT `the earliest day my supply can be cut off for` both EQUALS JUST (Date 12 3 2026)
#ASSERT `the earliest day my supply can be cut off for` leap EQUALS JUST (Date 8 3 2028)
#ASSERT `the earliest day my supply can be cut off for` leapEarly EQUALS NOTHING

-- Entry (paras 24, 28).
#ASSERT `the officer may enter to cut off for` unpaid `with` ok
#ASSERT NOT (`the officer may enter to cut off for` unpaid `with` short)
#ASSERT NOT (`the officer may enter to cut off for` unpaid `with` nodoc)
#ASSERT NOT (`the officer may enter to cut off for` disputed `with` ok)

-- Restoration (paras 11, 19).
#ASSERT `the supplier may refuse to restore for` unpaid `with` stillIn
#ASSERT NOT (`the supplier may refuse to restore for` unpaid `with` madeGood)
#ASSERT `the supplier may refuse to restore for` unpaid `with` goodNotPaid
#ASSERT NOT (`the supplier may refuse to restore for` unpaid `with` leftPremises)
#ASSERT NOT (`the supplier may refuse to restore for` disputed `with` stillIn)
#ASSERT `restoring the supply myself is an offence for` stillIn
#ASSERT NOT (`restoring the supply myself is an offence for` madeGood)

§§ `Goal 3 — redress and resale`

-- Fields: contravention, loss, after Sch 14, Competition Act, prior order,
-- s 30I notice, s 38 notice, order made on.
GIVEN cd IS A DATE, po IS A MAYBE `Prior order`, n30I IS A MAYBE DATE, n38 IS A MAYBE DATE, od IS A DATE
GIVETH A `Contravention facts`
`a contravention on` cd `prior` po `30I` n30I `38` n38 `order on` od MEANS
    `Contravention facts` OF cd, TRUE, TRUE, FALSE, po, n30I, n38, od

-- Contravention 15 June 2020: the five years end on 15 June 2025.
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `30I` NOTHING `38` NOTHING `order on` (Date 15 6 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `30I` NOTHING `38` NOTHING `order on` (Date 16 6 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `30I` (JUST (Date 10 6 2025)) `38` NOTHING `order on` (Date 1 1 2026))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `30I` NOTHING `38` (JUST (Date 15 6 2025)) `order on` (Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `30I` NOTHING `38` (JUST (Date 16 6 2025)) `order on` (Date 1 1 2026)))
-- 29 February 2020: the five years end on 28 February 2025.
#ASSERT `the end of the five years for` (`a contravention on` (Date 29 2 2020) `prior` NOTHING `30I` NOTHING `38` NOTHING `order on` (Date 1 1 2025)) EQUALS Date 28 2 2025
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 29 2 2020) `prior` NOTHING `30I` NOTHING `38` NOTHING `order on` (Date 1 3 2025)))
-- s 30G(1)(b), 30N(2), (4).
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, FALSE, TRUE, FALSE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, TRUE, FALSE, FALSE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, TRUE, TRUE, TRUE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
-- s 30K(3): a final order made 31 January 2025: 3 months from it is
-- 30 April 2025 (no 31 April).
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `30I` (JUST (Date 30 4 2025)) `38` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `30I` (JUST (Date 1 5 2025)) `38` NOTHING `order on` (Date 1 9 2025)))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `30I` NOTHING `38` NOTHING `order on` (Date 1 9 2025)))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `30I` (JUST (Date 15 1 2025)) `38` NOTHING `order on` (Date 1 9 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a confirmed provisional order` (Date 10 3 2025))) `30I` (JUST (Date 10 6 2025)) `38` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a confirmed provisional order` (Date 10 3 2025))) `30I` (JUST (Date 11 6 2025)) `38` NOTHING `order on` (Date 1 9 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`an unconfirmed provisional order` (Date 1 1 2025))) `30I` (JUST (Date 1 7 2025)) `38` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`an unconfirmed provisional order` (Date 1 1 2025))) `30I` (JUST (Date 2 7 2025)) `38` NOTHING `order on` (Date 1 9 2025)))

-- Fields: served, compliance date, appeal made, appeal determined, paid,
-- turnover, penalty. Served 1 March 2026.
GIVEN due IS A DATE, ap IS A MAYBE DATE, dc IS A MAYBE DATE, pd IS A MAYBE DATE
GIVETH A `Redress order facts`
`an order due` due `appeal` ap `decided` dc `paid` pd MEANS
    `Redress order facts` OF Date 1 3 2026, due, ap, dc, pd, 1000000, 30000

#ASSERT `the compliance date is lawful for` (`an order due` (Date 8 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING)
#ASSERT NOT (`the compliance date is lawful for` (`an order due` (Date 7 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING))
#ASSERT `the supplier's last day to appeal for` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS Date 12 4 2026
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` (JUST (Date 31 3 2026))) EQUALS NOTHING
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` (JUST (Date 2 4 2026))) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 10 4 2026)) `decided` NOTHING `paid` NOTHING) EQUALS NOTHING
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 10 4 2026)) `decided` (JUST (Date 1 6 2026)) `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 13 4 2026)) `decided` NOTHING `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
-- s 30O: 10% of 1,000,000 less a 30,000 penalty.
#ASSERT `the most compensation for the contravention under` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS 70000
#ASSERT `the most compensation for the contravention under` (`Redress order facts` OF Date 1 3 2026, Date 31 3 2026, NOTHING, NOTHING, NOTHING, 1000000, 150000) EQUALS 0
#ASSERT `the most compensation for the contravention under` (`Redress order facts` OF Date 1 3 2026, Date 31 3 2026, NOTHING, NOTHING, NOTHING, 1000000, 0) EQUALS 100000

-- s 37. Fields: price paid, maximum, reduced maximum, interest, motor vehicle.
#ASSERT `what I can recover on resale under` (`Resale facts` OF 120, 100, NOTHING, 5, FALSE) EQUALS JUST 25
#ASSERT `what I can recover on resale under` (`Resale facts` OF 90, 100, NOTHING, 5, FALSE) EQUALS JUST 0
#ASSERT `what I can recover on resale under` (`Resale facts` OF 100, 100, NOTHING, 5, FALSE) EQUALS JUST 0
#ASSERT `what I can recover on resale under` (`Resale facts` OF 90, 100, JUST 80, 2, FALSE) EQUALS JUST 12
#ASSERT `what I can recover on resale under` (`Resale facts` OF 120, 100, NOTHING, 5, TRUE) EQUALS NOTHING

§§ `The top-level goal`

empty MEANS `Gas consumer case` OF NOTHING, NOTHING, NOTHING, NOTHING, NOTHING
full MEANS `Gas consumer case` OF JUST ownpipe, JUST unpaid, NOTHING, JUST (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING), JUST (`Resale facts` OF 120, 100, NOTHING, 5, FALSE)

#ASSERT (`the gas consumer position for` empty)'s `connection` EQUALS NOTHING
#ASSERT (`the gas consumer position for` empty)'s `earliest day the supply can be cut off` EQUALS NOTHING
#ASSERT (`the gas consumer position for` empty)'s `redress order can be made` EQUALS NOTHING
#ASSERT (`the gas consumer position for` empty)'s `recoverable on resale` EQUALS NOTHING
#ASSERT (`the gas consumer position for` full)'s `connection` EQUALS JUST `must connect`
#ASSERT (`the gas consumer position for` full)'s `connection charge` EQUALS JUST `the cost of making the connection`
#ASSERT (`the gas consumer position for` full)'s `my pipe vests in the transporter` EQUALS JUST TRUE
#ASSERT (`the gas consumer position for` full)'s `earliest day the supply can be cut off` EQUALS JUST (Date 6 4 2026)
#ASSERT (`the gas consumer position for` full)'s `supply may be cut off on the day` EQUALS JUST TRUE
#ASSERT (`the gas consumer position for` full)'s `officer may enter to cut off` EQUALS JUST TRUE
#ASSERT (`the gas consumer position for` full)'s `supplier may refuse to restore` EQUALS JUST TRUE
#ASSERT (`the gas consumer position for` full)'s `restoring it myself is an offence` EQUALS JUST TRUE
#ASSERT (`the gas consumer position for` full)'s `redress order can be made` EQUALS NOTHING
#ASSERT (`the gas consumer position for` full)'s `supplier's last day to appeal` EQUALS JUST (Date 12 4 2026)
#ASSERT (`the gas consumer position for` full)'s `interest on compensation runs from` EQUALS JUST (Date 1 4 2026)
#ASSERT (`the gas consumer position for` full)'s `most compensation for the contravention` EQUALS JUST 70000
#ASSERT (`the gas consumer position for` full)'s `recoverable on resale` EQUALS JUST 25
