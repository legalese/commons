IMPORT prelude
IMPORT daydate

-- Gas Act 1986 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1986-44.txt (point in time
-- 13 November 2025). Seat: the gas consumer.

§ `Nouns`

§§ `Connection (ss 10-11)`

DECLARE `Connection request` HAS
    -- s 10(1): in an authorised area of the transporter.
    `in an authorised area of the transporter`          IS A BOOLEAN
    -- s 10(1)(a): within 23 metres from a relevant main (s 10(12)).
    `within 23 metres of a relevant main`               IS A BOOLEAN
    -- s 10(1)(b): could be connected to a relevant main by a pipe the owner
    -- or occupier has laid, or proposes to lay.
    `connectable by my own pipe`                        IS A BOOLEAN
    -- s 10(3): the premises are connected already, and the connection is
    -- still required.
    `already connected`                                 IS A BOOLEAN
    -- s 10(4): the notice served on the transporter; NOTHING if none.
    `notice served on`                                  IS A MAYBE DATE
    `connection day named`                              IS A MAYBE DATE
    -- s 10(4)(b): a finding that the day named is not earlier than a
    -- reasonable time after the notice.
    `the day named allows a reasonable time`            IS A BOOLEAN
    -- s 10(8), (10)(c): the expected supply, in therms a year.
    `expected therms a year`                            IS A NUMBER
    -- s 10(9)(a)
    `the transporter is prevented by circumstances outside its control` IS A BOOLEAN
    -- s 10(9)(b): danger to the public, and the transporter took all
    -- reasonable steps.
    `danger to the public despite reasonable steps`     IS A BOOLEAN
    -- s 10(9)(c)
    `my pipe is not fit for the purpose`                IS A BOOLEAN
    -- s 10(10)(b), (d)
    `a new or increased supply needing a new or enlarged main or works` IS A BOOLEAN
    -- s 10(10)(c): the transporter reasonably expects more than 2,500
    -- therms a year (a finding, taken from the expected supply).
    -- s 10(10): a written contract for the payments the transporter requires.
    `written contract for the transporter's payments`   IS A BOOLEAN
    -- s 11(1)(a)-(b): the transporter has required security, and it has
    -- not been given or has become invalid or insufficient.
    `security required and not given`                   IS A BOOLEAN

DECLARE `Connection outcome` IS ONE OF
    `the duty does not cover my premises`
    `no valid notice yet`
    `need not: over 75,000 therms`
    `need not: circumstances under s 10(9)`
    `may refuse until a written contract is made`
    `may refuse to lay the pipe until security is given`
    `must connect`
    `must maintain the connection`

DECLARE `Connection charge` IS ONE OF
    `the cost of supplying and laying the pipe`
    `the cost of making the connection`
    `no charge under s 10`

§§ `Cutting off for debt, and entry (Schedule 2B)`

-- Sch 2B para 7(1): a written demand for payments for gas supplied to the
-- premises (or under a green deal plan).
DECLARE `Payment demand` HAS
    `demand made on`                                    IS A DATE
    `paid on`                                           IS A MAYBE DATE
    `genuinely in dispute`                              IS A BOOLEAN

-- Sch 2B para 7(2): a written request for a deposit as reasonable security.
DECLARE `Deposit request` HAS
    `request made on`                                   IS A DATE
    -- the day the consumer gave the deposit or agreed to a prepayment meter
    `deposit given or prepayment agreed on`             IS A MAYBE DATE
    `genuinely in dispute`                              IS A BOOLEAN

DECLARE `Entry facts` HAS
    -- para 24(2)
    `hours of notice given`                             IS A NUMBER
    `at a reasonable time`                              IS A BOOLEAN
    `authority document produced`                       IS A BOOLEAN
    -- para 28(1)(a)
    `reasonable steps taken that the officer is fit and proper` IS A BOOLEAN

DECLARE `Restoration facts` HAS
    -- para 19(2)
    `no longer the owner or occupier`                   IS A BOOLEAN
    `default made good`                                 IS A BOOLEAN
    `reasonable expenses paid`                          IS A BOOLEAN
    -- para 11(3)(b)
    `the supplier's consent to restore`                 IS A BOOLEAN

DECLARE `Cut-off case` HAS
    `the demand`                                        IS A MAYBE `Payment demand`
    `the deposit request`                               IS A MAYBE `Deposit request`
    -- para 7(3): the supplier is a relevant supplier (supplying gas to the
    -- premises now).
    `the supplier is my current supplier`               IS A BOOLEAN
    -- para 7(4): the debt was assigned to my current supplier.
    `the debt was assigned to my current supplier`      IS A BOOLEAN
    `notice of intention given on`                      IS A MAYBE DATE
    `cut off or meter fitted on`                        IS A DATE
    `the entry`                                         IS A MAYBE `Entry facts`
    `the restoration`                                   IS A MAYBE `Restoration facts`

§§ `Redress and resale (ss 30G-30O, 37)`

-- s 30K(1), (3): a final or provisional order under s 28 for the
-- contravention.
DECLARE `Prior order` IS ONE OF
    `a final order`                                     HAS `final order made on` IS A DATE
    `a confirmed provisional order`                     HAS `provisional order confirmed on` IS A DATE
    `an unconfirmed provisional order`                  HAS `provisional order made on` IS A DATE

DECLARE `Contravention facts` HAS
    `contravention on`                                  IS A DATE
    -- s 30G(1)(b): I suffered loss or damage, or was caused inconvenience,
    -- as a result.
    `I suffered loss, damage or inconvenience`          IS A BOOLEAN
    -- s 30N(4): the contravention was after Schedule 14 to the Energy Act
    -- 2013 came into force.
    `after Schedule 14 to the Energy Act 2013 came into force` IS A BOOLEAN
    -- s 30N(2): a finding by the Authority.
    `the Authority is satisfied the Competition Act 1998 is most appropriate` IS A BOOLEAN
    `the prior order`                                   IS A MAYBE `Prior order`
    `section 30I notice served on`                      IS A MAYBE DATE
    `section 38 notice served on`                       IS A MAYBE DATE
    `redress order made on`                             IS A DATE

DECLARE `Redress order facts` HAS
    `copy served on the supplier on`                    IS A DATE
    `compliance date`                                   IS A DATE
    `appeal made on`                                    IS A MAYBE DATE
    `appeal determined on`                              IS A MAYBE DATE
    `compensation paid on`                              IS A MAYBE DATE
    -- s 30O: the supplier's turnover, and any penalty imposed under s 30A
    -- for the same contravention.
    `turnover`                                          IS A NUMBER
    `penalty imposed`                                   IS A NUMBER

-- s 37: gas supplied by an authorised supplier and resold to me.
DECLARE `Resale facts` HAS
    `price paid`                                        IS A NUMBER
    `maximum price`                                     IS A NUMBER
    -- s 37(2)(b): the maximum the direction substitutes where the reseller
    -- did not give the information required; NOTHING otherwise.
    `maximum price without the information`             IS A MAYBE NUMBER
    -- s 37(4)(b): interest the direction provides for; 0 if none.
    `interest under the direction`                      IS A NUMBER
    -- s 37(5)
    `for a gas-fuelled motor vehicle`                   IS A BOOLEAN
