IMPORT prelude
IMPORT daydate
IMPORT `pip-nouns`
IMPORT `pip-sch2-forces`

-- Tests of Schedule 2. Expected values were worked out by hand from the text before the file was run.

§ `Tests of Schedule 2, paragraph 2`

-- (insured under the 1965 Act, Class 1, Class 2, Class 3)
#ASSERT `Sch 2 para 2: paragraph 1(a) does not include the person` TRUE FALSE FALSE FALSE
#ASSERT `Sch 2 para 2: paragraph 1(a) does not include the person` FALSE TRUE FALSE FALSE
#ASSERT `Sch 2 para 2: paragraph 1(a) does not include the person` FALSE FALSE TRUE FALSE
#ASSERT `Sch 2 para 2: paragraph 1(a) does not include the person` FALSE FALSE FALSE TRUE
#ASSERT NOT (`Sch 2 para 2: paragraph 1(a) does not include the person` FALSE FALSE FALSE FALSE)

§ `Tests of Schedule 2, paragraph 1`

-- (a): naval, locally entered at a base abroad, and not excepted by paragraph 2.
#ASSERT `Sch 2 para 1(a): the person is not a member of Her Majesty's forces as a locally entered naval person` TRUE TRUE FALSE
#ASSERT NOT (`Sch 2 para 1(a): the person is not a member of Her Majesty's forces as a locally entered naval person` TRUE TRUE TRUE)
#ASSERT NOT (`Sch 2 para 1(a): the person is not a member of Her Majesty's forces as a locally entered naval person` TRUE FALSE FALSE)
#ASSERT NOT (`Sch 2 para 1(a): the person is not a member of Her Majesty's forces as a locally entered naval person` FALSE TRUE FALSE)
-- (b): military, entered or recruited abroad, depot of the unit abroad: all three.
#ASSERT `Sch 2 para 1(b): the person is not a member of Her Majesty's forces as a military person recruited abroad` TRUE TRUE TRUE
#ASSERT NOT (`Sch 2 para 1(b): the person is not a member of Her Majesty's forces as a military person recruited abroad` FALSE TRUE TRUE)
#ASSERT NOT (`Sch 2 para 1(b): the person is not a member of Her Majesty's forces as a military person recruited abroad` TRUE FALSE TRUE)
#ASSERT NOT (`Sch 2 para 1(b): the person is not a member of Her Majesty's forces as a military person recruited abroad` TRUE TRUE FALSE)
-- (c): air force, entered or recruited abroad, liable to serve only abroad: all three.
#ASSERT `Sch 2 para 1(c): the person is not a member of Her Majesty's forces as an air force person recruited abroad` TRUE TRUE TRUE
#ASSERT NOT (`Sch 2 para 1(c): the person is not a member of Her Majesty's forces as an air force person recruited abroad` FALSE TRUE TRUE)
#ASSERT NOT (`Sch 2 para 1(c): the person is not a member of Her Majesty's forces as an air force person recruited abroad` TRUE FALSE TRUE)
#ASSERT NOT (`Sch 2 para 1(c): the person is not a member of Her Majesty's forces as an air force person recruited abroad` TRUE TRUE FALSE)
-- Paragraph 1 as a whole: any one sub-paragraph.
#ASSERT `Sch 2 para 1: the person is specified in Schedule 2` TRUE FALSE FALSE
#ASSERT `Sch 2 para 1: the person is specified in Schedule 2` FALSE TRUE FALSE
#ASSERT `Sch 2 para 1: the person is specified in Schedule 2` FALSE FALSE TRUE
#ASSERT NOT (`Sch 2 para 1: the person is specified in Schedule 2` FALSE FALSE FALSE)
