IMPORT prelude
IMPORT daydate
IMPORT `pip-nouns`
IMPORT `pip-dates`
IMPORT `pip-part1-general`
IMPORT `pip-part4-residence`
IMPORT `pip-part4-special-cases`

-- Tests of Part 4, regulations 22 to 23A, and of regulation 16 with the regulations that modify it.
-- Expected values were worked out by hand from the text before the file was run.

§ `Tests of regulation 22`

#ASSERT `reg 22: regulation 16(b) does not apply on the day` TRUE TRUE TRUE
#ASSERT NOT (`reg 22: regulation 16(b) does not apply on the day` FALSE TRUE TRUE)
#ASSERT NOT (`reg 22: regulation 16(b) does not apply on the day` TRUE FALSE TRUE)
#ASSERT NOT (`reg 22: regulation 16(b) does not apply on the day` TRUE TRUE FALSE)

§ `Tests of regulation 23`

#ASSERT `the day 31st December 2020` EQUALS YearMonthDay 2020 12 31
-- reg 23(a): an EEA state (the Republic of Ireland is one) or Switzerland.
#ASSERT `reg 23(a): C is habitually resident in an EEA state or Switzerland` `the Republic of Ireland`
#ASSERT `reg 23(a): C is habitually resident in an EEA state or Switzerland` `an EEA state other than the Republic of Ireland`
#ASSERT `reg 23(a): C is habitually resident in an EEA state or Switzerland` `Switzerland`
#ASSERT NOT (`reg 23(a): C is habitually resident in an EEA state or Switzerland` `the United Kingdom`)
#ASSERT NOT (`reg 23(a): C is habitually resident in an EEA state or Switzerland` `the Isle of Man`)
#ASSERT NOT (`reg 23(a): C is habitually resident in an EEA state or Switzerland` `the Channel Islands`)
#ASSERT NOT (`reg 23(a): C is habitually resident in an EEA state or Switzerland` `some other place`)

-- reg 23(b)(ii): habitually resident in the United Kingdom after 31 December 2020: only a day after it counts.
#ASSERT NOT (`reg 23(b)(ii): C has been habitually resident in the United Kingdom after 31 December 2020` NOTHING)
#ASSERT NOT (`reg 23(b)(ii): C has been habitually resident in the United Kingdom after 31 December 2020` (JUST (YearMonthDay 2020 12 31)))
#ASSERT `reg 23(b)(ii): C has been habitually resident in the United Kingdom after 31 December 2020` (JUST (YearMonthDay 2021 1 1))
-- continuous receipt on and from 31 December 2020: begun on or before it.
#ASSERT NOT (`reg 23(b)(ii): C has been continuously in receipt on and from 31 December 2020` NOTHING)
#ASSERT `reg 23(b)(ii): C has been continuously in receipt on and from 31 December 2020` (JUST (YearMonthDay 2020 12 31))
#ASSERT `reg 23(b)(ii): C has been continuously in receipt on and from 31 December 2020` (JUST (YearMonthDay 2015 5 1))
#ASSERT NOT (`reg 23(b)(ii): C has been continuously in receipt on and from 31 December 2020` (JUST (YearMonthDay 2021 1 1)))
-- the second limb: (applied on 31 December 2020, latest day habitually resident in the United Kingdom, first day of continuous receipt)
#ASSERT `reg 23(b)(ii): the second limb is met` TRUE NOTHING (JUST (YearMonthDay 2019 5 1))
#ASSERT `reg 23(b)(ii): the second limb is met` TRUE (JUST (YearMonthDay 2020 12 31)) (JUST (YearMonthDay 2019 5 1))
#ASSERT NOT (`reg 23(b)(ii): the second limb is met` FALSE NOTHING (JUST (YearMonthDay 2019 5 1)))
#ASSERT NOT (`reg 23(b)(ii): the second limb is met` TRUE (JUST (YearMonthDay 2021 1 1)) (JUST (YearMonthDay 2019 5 1)))
#ASSERT NOT (`reg 23(b)(ii): the second limb is met` TRUE NOTHING (JUST (YearMonthDay 2021 1 1)))
#ASSERT NOT (`reg 23(b)(ii): the second limb is met` TRUE NOTHING NOTHING)
-- reg 23(b): the regulation applies to C, or the second limb.
#ASSERT `reg 23(b): a relevant EU Regulation applies to C, or applied to C on 31 December 2020 and C has been in continuous receipt` TRUE FALSE NOTHING NOTHING
#ASSERT `reg 23(b): a relevant EU Regulation applies to C, or applied to C on 31 December 2020 and C has been in continuous receipt` FALSE TRUE NOTHING (JUST (YearMonthDay 2019 5 1))
#ASSERT NOT (`reg 23(b): a relevant EU Regulation applies to C, or applied to C on 31 December 2020 and C has been in continuous receipt` FALSE TRUE (JUST (YearMonthDay 2022 2 2)) (JUST (YearMonthDay 2019 5 1)))
#ASSERT NOT (`reg 23(b): a relevant EU Regulation applies to C, or applied to C on 31 December 2020 and C has been in continuous receipt` FALSE FALSE NOTHING (JUST (YearMonthDay 2019 5 1)))
-- reg 23: all three of (a), (b), (c).
#ASSERT `reg 23: regulation 16(a) to (c) do not apply to the daily living component on the day` TRUE TRUE TRUE
#ASSERT NOT (`reg 23: regulation 16(a) to (c) do not apply to the daily living component on the day` FALSE TRUE TRUE)
#ASSERT NOT (`reg 23: regulation 16(a) to (c) do not apply to the daily living component on the day` TRUE FALSE TRUE)
#ASSERT NOT (`reg 23: regulation 16(a) to (c) do not apply to the daily living component on the day` TRUE TRUE FALSE)

§ `Tests of regulation 23ZA`

#ASSERT `reg 23ZA(1): regulation 16(c) is treated as not satisfied on the day` TRUE TRUE
#ASSERT NOT (`reg 23ZA(1): regulation 16(c) is treated as not satisfied on the day` TRUE FALSE)
#ASSERT NOT (`reg 23ZA(1): regulation 16(c) is treated as not satisfied on the day` FALSE TRUE)
#ASSERT `reg 23ZA(2): regulation 16(c) is treated as not satisfied on the day` TRUE TRUE
#ASSERT NOT (`reg 23ZA(2): regulation 16(c) is treated as not satisfied on the day` TRUE FALSE)
#ASSERT NOT (`reg 23ZA(2): regulation 16(c) is treated as not satisfied on the day` FALSE TRUE)
#ASSERT `reg 23ZA: regulation 16(c) is treated as not satisfied on the day by paragraph (1) or (2)` TRUE FALSE
#ASSERT `reg 23ZA: regulation 16(c) is treated as not satisfied on the day by paragraph (1) or (2)` FALSE TRUE
#ASSERT NOT (`reg 23ZA: regulation 16(c) is treated as not satisfied on the day by paragraph (1) or (2)` FALSE FALSE)

§ `Tests of regulation 23ZB`

#ASSERT `the day 6th November 2025` EQUALS YearMonthDay 2025 11 6
-- reg 23ZB(1): on or after 6 November 2025.
#ASSERT `reg 23ZB(1): this regulation applies` (YearMonthDay 2025 11 6)
#ASSERT NOT (`reg 23ZB(1): this regulation applies` (YearMonthDay 2025 11 5))
#ASSERT `reg 23ZB(1): this regulation applies` (YearMonthDay 2026 1 1)
-- reg 23ZB(4): 13 weeks beginning 1 December 2025 end on 1 March 2026 (1 Dec + 90 days: 30 to 31 Dec, 61 to 31 Jan, 89 to 28 Feb, 90 to 1 Mar).
#ASSERT `reg 23ZB(4): the first day of the run-on period` (YearMonthDay 2025 12 1) EQUALS YearMonthDay 2025 12 1
#ASSERT `reg 23ZB(4): the last day of the run-on period` (YearMonthDay 2025 12 1) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 23ZB(4): the day is in the run-on period` (YearMonthDay 2025 12 1) `on` (YearMonthDay 2025 12 1)
#ASSERT `reg 23ZB(4): the day is in the run-on period` (YearMonthDay 2025 12 1) `on` (YearMonthDay 2026 3 1)
#ASSERT NOT (`reg 23ZB(4): the day is in the run-on period` (YearMonthDay 2025 12 1) `on` (YearMonthDay 2026 3 2))
#ASSERT NOT (`reg 23ZB(4): the day is in the run-on period` (YearMonthDay 2025 12 1) `on` (YearMonthDay 2025 11 30))
-- reg 23ZB(2): (date C becomes permanently resident in Scotland, entitled the day before, the day)
#ASSERT `reg 23ZB(2): C is treated as present in England and Wales on the day` (YearMonthDay 2025 12 1) `with` TRUE `on` (YearMonthDay 2025 12 15)
#ASSERT `reg 23ZB(2): C is treated as present in England and Wales on the day` (YearMonthDay 2025 12 1) `with` TRUE `on` (YearMonthDay 2026 3 1)
#ASSERT NOT (`reg 23ZB(2): C is treated as present in England and Wales on the day` (YearMonthDay 2025 12 1) `with` TRUE `on` (YearMonthDay 2026 3 2))
#ASSERT NOT (`reg 23ZB(2): C is treated as present in England and Wales on the day` (YearMonthDay 2025 12 1) `with` FALSE `on` (YearMonthDay 2025 12 15))
#ASSERT NOT (`reg 23ZB(2): C is treated as present in England and Wales on the day` (YearMonthDay 2025 11 5) `with` TRUE `on` (YearMonthDay 2025 11 20))
-- reg 23ZB(3): (date, fixed term award, last day of the fixed term): extended only if due to expire before the end of the run-on period.
#ASSERT `reg 23ZB(3): the last day of the fixed term period after any extension` (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 23ZB(3): the last day of the fixed term period after any extension` (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 23ZB(3): the last day of the fixed term period after any extension` (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 3 2) EQUALS YearMonthDay 2026 3 2
#ASSERT `reg 23ZB(3): the last day of the fixed term period after any extension` (YearMonthDay 2025 12 1) FALSE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 2 28
#ASSERT `reg 23ZB(3): the last day of the fixed term period after any extension` (YearMonthDay 2025 11 5) TRUE (YearMonthDay 2026 1 31) EQUALS YearMonthDay 2026 1 31

§ `Tests of regulation 23ZC`

-- reg 23ZC(3): the claim has not been decided, withdrawn or otherwise ceased before the residence change date.
#ASSERT `reg 23ZC(3): C has an ongoing claim on the residence change date` FALSE FALSE FALSE
#ASSERT NOT (`reg 23ZC(3): C has an ongoing claim on the residence change date` TRUE FALSE FALSE)
#ASSERT NOT (`reg 23ZC(3): C has an ongoing claim on the residence change date` FALSE TRUE FALSE)
#ASSERT NOT (`reg 23ZC(3): C has an ongoing claim on the residence change date` FALSE FALSE TRUE)
-- reg 23ZC(2)(c) and (4): (the day, present in England and Wales, treated otherwise as present in England and Wales, treated as present in Great Britain)
-- Before 6 November 2025: present in England and Wales, or treated for regulation 16(a) as present in Great Britain.
#ASSERT `reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 5) TRUE FALSE FALSE
#ASSERT `reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 5) FALSE FALSE TRUE
#ASSERT NOT (`reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 5) FALSE TRUE FALSE)
-- On or after 6 November 2025: present in England and Wales, or treated otherwise as present in England and Wales.
#ASSERT `reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 6) TRUE FALSE FALSE
#ASSERT `reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 6) FALSE TRUE FALSE
#ASSERT NOT (`reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 6) FALSE FALSE TRUE)
#ASSERT NOT (`reg 23ZC(2)(c) and (4): C is present or treated as present on the day` (YearMonthDay 2025 11 6) FALSE FALSE FALSE)
-- reg 23ZC(2): (ongoing claim, date resident in Scotland, (c)(i), (c)(ii))
#ASSERT `reg 23ZC(2): C satisfies the conditions` TRUE (YearMonthDay 2025 12 1) TRUE TRUE
#ASSERT NOT (`reg 23ZC(2): C satisfies the conditions` FALSE (YearMonthDay 2025 12 1) TRUE TRUE)
#ASSERT NOT (`reg 23ZC(2): C satisfies the conditions` TRUE (YearMonthDay 2025 11 5) TRUE TRUE)
#ASSERT `reg 23ZC(2): C satisfies the conditions` TRUE (YearMonthDay 2025 11 6) TRUE TRUE
#ASSERT NOT (`reg 23ZC(2): C satisfies the conditions` TRUE (YearMonthDay 2025 12 1) FALSE TRUE)
#ASSERT NOT (`reg 23ZC(2): C satisfies the conditions` TRUE (YearMonthDay 2025 12 1) TRUE FALSE)
-- reg 23ZC(5) and (1): the duty to decide, unless C withdraws.
#ASSERT `reg 23ZC(1) and (5): the Secretary of State must decide C's claim under section 8 of the 1998 Act` TRUE FALSE
#ASSERT NOT (`reg 23ZC(1) and (5): the Secretary of State must decide C's claim under section 8 of the 1998 Act` TRUE TRUE)
#ASSERT NOT (`reg 23ZC(1) and (5): the Secretary of State must decide C's claim under section 8 of the 1998 Act` FALSE FALSE)
-- reg 23ZC(6)
#ASSERT `reg 23ZC(6): regulation 16(a) is read with "Great Britain" in place of "England and Wales" for the decision` TRUE
#ASSERT NOT (`reg 23ZC(6): regulation 16(a) is read with "Great Britain" in place of "England and Wales" for the decision` FALSE)
-- reg 23ZC(7)(a): (must decide, decides C is entitled, date resident in Scotland, the day)
#ASSERT `reg 23ZC(7)(a): C is treated as present in England and Wales on the day` TRUE TRUE (YearMonthDay 2025 12 1) (YearMonthDay 2026 3 1)
#ASSERT NOT (`reg 23ZC(7)(a): C is treated as present in England and Wales on the day` TRUE TRUE (YearMonthDay 2025 12 1) (YearMonthDay 2026 3 2))
#ASSERT NOT (`reg 23ZC(7)(a): C is treated as present in England and Wales on the day` TRUE FALSE (YearMonthDay 2025 12 1) (YearMonthDay 2026 1 1))
#ASSERT NOT (`reg 23ZC(7)(a): C is treated as present in England and Wales on the day` FALSE TRUE (YearMonthDay 2025 12 1) (YearMonthDay 2026 1 1))
-- reg 23ZC(7)(b): (must decide, decides C is entitled, date resident in Scotland, fixed term award, last day of the fixed term)
#ASSERT `reg 23ZC(7)(b): the last day of the fixed term period after any extension` TRUE TRUE (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 23ZC(7)(b): the last day of the fixed term period after any extension` TRUE TRUE (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 3 1
#ASSERT `reg 23ZC(7)(b): the last day of the fixed term period after any extension` TRUE FALSE (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 2 28
#ASSERT `reg 23ZC(7)(b): the last day of the fixed term period after any extension` TRUE TRUE (YearMonthDay 2025 12 1) FALSE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 2 28
#ASSERT `reg 23ZC(7)(b): the last day of the fixed term period after any extension` FALSE TRUE (YearMonthDay 2025 12 1) TRUE (YearMonthDay 2026 2 28) EQUALS YearMonthDay 2026 2 28

