#ASSERT NOT (`reg 30(4): the institution is a hospice` TRUE FALSE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`reg 30(4): the institution is a hospice` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 30(4): the institution is a hospice` TRUE FALSE FALSE FALSE FALSE TRUE)

