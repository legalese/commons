#ASSERT `reg 30(3): regulation 28 or 29 does not apply because C is terminally ill in a hospice` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT (`reg 30(3): regulation 28 or 29 does not apply because C is terminally ill in a hospice` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 30(3): regulation 28 or 29 does not apply because C is terminally ill in a hospice` FALSE TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 30(3): regulation 28 or 29 does not apply because C is terminally ill in a hospice` TRUE FALSE TRUE FALSE FALSE)
#ASSERT `reg 30(3): the Secretary of State has been informed in one of the three ways` TRUE FALSE FALSE
#ASSERT `reg 30(3): the Secretary of State has been informed in one of the three ways` FALSE TRUE FALSE
#ASSERT `reg 30(3): the Secretary of State has been informed in one of the three ways` FALSE FALSE TRUE
#ASSERT NOT (`reg 30(3): the Secretary of State has been informed in one of the three ways` FALSE FALSE FALSE)

-- reg 30(5): the total cost met from private means.
#ASSERT `reg 30(5): regulation 28(1) does not apply because the total cost is met from private means` TRUE FALSE FALSE
#ASSERT `reg 30(5): regulation 28(1) does not apply because the total cost is met from private means` FALSE TRUE FALSE
#ASSERT `reg 30(5): regulation 28(1) does not apply because the total cost is met from private means` FALSE FALSE TRUE
