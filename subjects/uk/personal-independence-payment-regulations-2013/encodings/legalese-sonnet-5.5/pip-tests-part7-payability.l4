-- Tests of regulations 28 to 31. Expected values were worked out by hand from the text before the file was run.

§ `Tests of regulation 28(2): the specified enactments`

#ASSERT `reg 28(2): this enactment is a specified enactment` `Part 3 of the National Assistance Act 1948`
#ASSERT `reg 28(2): this enactment is a specified enactment` `sections 59 and 59A of the Social Work (Scotland) Act 1968`
#ASSERT `reg 28(2): this enactment is a specified enactment` `the Mental Health Act 1983`
#ASSERT `reg 28(2): this enactment is a specified enactment` `the Community Care and Health (Scotland) Act 2002`
#ASSERT `reg 28(2): this enactment is a specified enactment` `the Mental Health (Care and Treatment) (Scotland) Act 2003`
#ASSERT `reg 28(2): this enactment is a specified enactment` `section 57 of the Health and Social Care Act 2001`
#ASSERT `reg 28(2): this enactment is a specified enactment` `Part 1 of the Care Act 2014`
#ASSERT `reg 28(2): this enactment is a specified enactment` `Part 4 of the Social Services and Well-being (Wales) Act 2014`
#ASSERT `reg 28(2): this enactment is a specified enactment` `any other enactment relating to persons under a disability or to young persons or to education or training`
-- The seven excepted from (f), and everything else.
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 485 of the Education Act 1996`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 14 of the Education Act 2002`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 49 or section 73 of the Education (Scotland) Act 1980`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 65 of the Further and Higher Education Act 1992`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 4 or section 11 of the Further and Higher Education (Scotland) Act 2005`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 22 of the Teaching and Higher Education Act 1998`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `section 39 or section 40 of the Higher Education and Research Act 2017`)
#ASSERT NOT (`reg 28(2): this enactment is a specified enactment` `an enactment of some other kind`)
-- The care home condition: services provided, costs borne out of public or local funds under a specified enactment.
#ASSERT `reg 28(2): C meets the condition in section 85(2) of the Act` TRUE TRUE `Part 3 of the National Assistance Act 1948`
#ASSERT NOT (`reg 28(2): C meets the condition in section 85(2) of the Act` FALSE TRUE `Part 3 of the National Assistance Act 1948`)
#ASSERT NOT (`reg 28(2): C meets the condition in section 85(2) of the Act` TRUE FALSE `Part 3 of the National Assistance Act 1948`)
#ASSERT NOT (`reg 28(2): C meets the condition in section 85(2) of the Act` TRUE TRUE `section 485 of the Education Act 1996`)

§ `Tests of regulation 28(3) and (4)`

-- (a): under 18 and (i) or (ii)
#ASSERT `reg 28(3)(a): C is a person under 18 to whom the children in need provisions apply` TRUE TRUE FALSE
#ASSERT `reg 28(3)(a): C is a person under 18 to whom the children in need provisions apply` TRUE FALSE TRUE
#ASSERT NOT (`reg 28(3)(a): C is a person under 18 to whom the children in need provisions apply` FALSE TRUE TRUE)
#ASSERT NOT (`reg 28(3)(a): C is a person under 18 to whom the children in need provisions apply` TRUE FALSE FALSE)
-- (a) or (aa), limited by (4) to a placement in a private dwelling.
#ASSERT `reg 28(3)(a), (aa) and (4): the local authority placement exception applies` TRUE FALSE TRUE
#ASSERT `reg 28(3)(a), (aa) and (4): the local authority placement exception applies` FALSE TRUE TRUE
#ASSERT NOT (`reg 28(3)(a), (aa) and (4): the local authority placement exception applies` TRUE FALSE FALSE)
#ASSERT NOT (`reg 28(3)(a), (aa) and (4): the local authority placement exception applies` FALSE TRUE FALSE)
#ASSERT NOT (`reg 28(3)(a), (aa) and (4): the local authority placement exception applies` FALSE FALSE TRUE)
-- (b): accommodated outside the United Kingdom at a local authority's cost; not limited by (4).
#ASSERT `reg 28(3)(b): C is accommodated outside the United Kingdom at a local authority's cost` TRUE TRUE
#ASSERT NOT (`reg 28(3)(b): C is accommodated outside the United Kingdom at a local authority's cost` TRUE FALSE)
#ASSERT NOT (`reg 28(3)(b): C is accommodated outside the United Kingdom at a local authority's cost` FALSE TRUE)
#ASSERT `reg 28(3): paragraph (1) does not apply to C` TRUE FALSE
#ASSERT `reg 28(3): paragraph (1) does not apply to C` FALSE TRUE
#ASSERT NOT (`reg 28(3): paragraph (1) does not apply to C` FALSE FALSE)

§ `Tests of regulation 30`

-- reg 30(1): the first 28 days of the continuous period. (days of residence, in the run beginning when entitlement commenced)
#ASSERT `reg 30(1) and (2): payment goes on because the day is among the first 28 days` (JUST 1) FALSE
#ASSERT `reg 30(1) and (2): payment goes on because the day is among the first 28 days` (JUST 28) FALSE
#ASSERT NOT (`reg 30(1) and (2): payment goes on because the day is among the first 28 days` (JUST 29) FALSE)
#ASSERT NOT (`reg 30(1) and (2): payment goes on because the day is among the first 28 days` NOTHING FALSE)
-- reg 30(2): C in the care home on the day entitlement commenced: no first 28 days for the run of consecutive days.
#ASSERT NOT (`reg 30(1) and (2): payment goes on because the day is among the first 28 days` (JUST 1) TRUE)
#ASSERT NOT (`reg 30(1) and (2): payment goes on because the day is among the first 28 days` (JUST 28) TRUE)

