#ASSERT NOT (`reg 19(3): the person is an aircraft worker` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 19(3): the person is an aircraft worker` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`reg 19(3): the person is an aircraft worker` TRUE TRUE TRUE TRUE)
