#ASSERT `reg 19(3) "aircraft worker": the other-capacity limb is met` TRUE TRUE TRUE
#ASSERT NOT (`reg 19(3) "aircraft worker": the other-capacity limb is met` FALSE TRUE TRUE)
#ASSERT NOT (`reg 19(3) "aircraft worker": the other-capacity limb is met` TRUE FALSE TRUE)
#ASSERT NOT (`reg 19(3) "aircraft worker": the other-capacity limb is met` TRUE TRUE FALSE)
#ASSERT `reg 19(3) "aircraft worker": the crew limb or the other-capacity limb` TRUE FALSE
#ASSERT `reg 19(3) "aircraft worker": the crew limb or the other-capacity limb` FALSE TRUE
#ASSERT NOT (`reg 19(3) "aircraft worker": the crew limb or the other-capacity limb` FALSE FALSE)

-- reg 19(3) "mariner"
#ASSERT `reg 19(3): the person is a mariner` TRUE TRUE FALSE FALSE
#ASSERT `reg 19(3): the person is a mariner` TRUE FALSE TRUE FALSE
#ASSERT NOT (`reg 19(3): the person is a mariner` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 19(3): the person is a mariner` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`reg 19(3): the person is a mariner` TRUE TRUE TRUE TRUE)
