#ASSERT NOT (`reg 19(3) "mariner": the other-capacity limb is met` TRUE TRUE FALSE)
#ASSERT `reg 19(3) "mariner": the crew limb or the other-capacity limb` TRUE FALSE
#ASSERT `reg 19(3) "mariner": the crew limb or the other-capacity limb` FALSE TRUE
#ASSERT NOT (`reg 19(3) "mariner": the crew limb or the other-capacity limb` FALSE FALSE)

-- The relationships regs 19(1)(c) and 20(b) list: twelve, and no others.
