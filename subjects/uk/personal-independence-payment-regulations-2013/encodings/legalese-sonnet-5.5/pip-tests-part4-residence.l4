IMPORT prelude
IMPORT daydate
IMPORT `pip-nouns`
IMPORT `pip-dates`
IMPORT `pip-sch2-forces`
IMPORT `pip-part4-residence`

-- Tests of Part 4, regulations 16 to 21. Expected values were worked out by hand from the text
-- before the file was run.

§ `Tests of regulation 16`

-- reg 16(a): (present in England and Wales, present in Great Britain, read with "Great Britain", treated as present)
#ASSERT `reg 16(a): C is present in England and Wales on the day` TRUE TRUE FALSE FALSE
#ASSERT NOT (`reg 16(a): C is present in England and Wales on the day` FALSE FALSE FALSE FALSE)
-- In Scotland: present in Great Britain but not in England and Wales: fails 16(a) as written, passes under reg 23ZC(6).
#ASSERT NOT (`reg 16(a): C is present in England and Wales on the day` FALSE TRUE FALSE FALSE)
#ASSERT `reg 16(a): C is present in England and Wales on the day` FALSE TRUE TRUE FALSE
-- Treated as present.
#ASSERT `reg 16(a): C is present in England and Wales on the day` FALSE FALSE FALSE TRUE
#ASSERT `reg 16(a): C is present in England and Wales on the day` FALSE FALSE TRUE TRUE

-- reg 16(b): 104 of 156 weeks; (weeks present, weeks treated as present).
#ASSERT `reg 16(b): the weeks of presence in Great Britain required` EQUALS 104
#ASSERT `reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 104 0
#ASSERT NOT (`reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 103 0)
#ASSERT `reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 156 0
#ASSERT `reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 91 13
#ASSERT NOT (`reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 90 13)
#ASSERT `reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 100 4
#ASSERT NOT (`reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 100 3)
#ASSERT NOT (`reg 16(b): C has been present in Great Britain for not less than 104 weeks out of the 156 weeks` 0 0)

-- reg 16(c): the four places.
#ASSERT `reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `the United Kingdom`
#ASSERT `reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `the Republic of Ireland`
#ASSERT `reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `the Isle of Man`
#ASSERT `reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `the Channel Islands`
#ASSERT NOT (`reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `an EEA state other than the Republic of Ireland`)
#ASSERT NOT (`reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `Switzerland`)
#ASSERT NOT (`reg 16(c): C is habitually resident in the United Kingdom, the Republic of Ireland, the Isle of Man or the Channel Islands` `some other place`)

-- reg 16(d): (i) or (ii).
#ASSERT `reg 16(d): C is a person who is not excluded by immigration control` TRUE FALSE
#ASSERT `reg 16(d): C is a person who is not excluded by immigration control` FALSE TRUE
#ASSERT `reg 16(d): C is a person who is not excluded by immigration control` TRUE TRUE
#ASSERT NOT (`reg 16(d): C is a person who is not excluded by immigration control` FALSE FALSE)

§ `Tests of regulation 16A`

#ASSERT `reg 16A: the relevant area for the limb` `regulation 16(a)` EQUALS `England and Wales`
#ASSERT `reg 16A: the relevant area for the limb` `regulation 16(b)` EQUALS `Great Britain`

§ `Tests of regulations 17 to 18D`

-- The twelve fields, in order: temporary (unlikely to exceed 52 weeks); solely for medical treatment; treatment outside Great
-- Britain; during the temporary absence; qualified person; Government gave public information; Government arranged evacuation;
-- the Secretary of State is satisfied; the Scottish Ministers are satisfied; C did not enter when advised to leave;
-- regulation 19(1) applies; the weeks of the absence that fall within the 156 weeks.
`an ordinary holiday of 20 weeks` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 20
`an ordinary holiday of 10 weeks` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 10
`a long stay of 20 weeks, not temporary` MEANS `an absence from Great Britain` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 20
`treatment abroad for 40 weeks` MEANS `an absence from Great Britain` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`treatment abroad for 40 weeks, not temporary` MEANS `an absence from Great Britain` OF FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`treatment abroad but not solely` MEANS `an absence from Great Britain` OF TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`treatment but not outside Great Britain` MEANS `an absence from Great Britain` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`treatment but not during the absence` MEANS `an absence from Great Britain` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`treatment but not by a qualified person` MEANS `an absence from Great Britain` OF TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, 40
`evacuated, Secretary of State satisfied` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, TRUE, FALSE, 30
`advised to leave, Secretary of State satisfied` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, 30
`evacuated, Scottish Ministers satisfied` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE, 30
`evacuated, but nobody satisfied` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, 30
`evacuated, but C entered after the advice` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE, 30
`no Government advice or evacuation, Secretary of State satisfied` MEANS `an absence from Great Britain` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, 30
`serving abroad for 100 weeks` MEANS `an absence from Great Britain` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, 100

-- reg 17(2)
#ASSERT `reg 17(2): C is temporarily absent` `an ordinary holiday of 20 weeks`
#ASSERT NOT (`reg 17(2): C is temporarily absent` `a long stay of 20 weeks, not temporary`)

-- reg 17(1): 13 weeks if temporarily absent.
#ASSERT `reg 17(1): the first weeks of the absence for which C is treated as present` `an ordinary holiday of 20 weeks` EQUALS 13
#ASSERT `reg 17(1): the first weeks of the absence for which C is treated as present` `a long stay of 20 weeks, not temporary` EQUALS 0

-- reg 18(1): 26 weeks if temporarily absent and all four medical limbs; none otherwise.
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment abroad for 40 weeks` EQUALS 26
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment abroad for 40 weeks, not temporary` EQUALS 0
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment abroad but not solely` EQUALS 0
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment but not outside Great Britain` EQUALS 0
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment but not during the absence` EQUALS 0
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `treatment but not by a qualified person` EQUALS 0
#ASSERT `reg 18(1): the first weeks of the absence for which C is treated as present` `an ordinary holiday of 20 weeks` EQUALS 0

-- reg 18A(1): 26 weeks if temporarily absent, Government advice or evacuation, the Secretary of State satisfied, C did not enter after the advice.
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `evacuated, Secretary of State satisfied` EQUALS 26
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `advised to leave, Secretary of State satisfied` EQUALS 26
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `evacuated, Scottish Ministers satisfied` EQUALS 0
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `evacuated, but nobody satisfied` EQUALS 0
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `evacuated, but C entered after the advice` EQUALS 0
#ASSERT `reg 18A(1): the first weeks of the absence for which C is treated as present` `no Government advice or evacuation, Secretary of State satisfied` EQUALS 0

-- reg 18C(1): the same with the Scottish Ministers.
#ASSERT `reg 18C(1): the first weeks of the absence for which C is treated as present` `evacuated, Scottish Ministers satisfied` EQUALS 26
#ASSERT `reg 18C(1): the first weeks of the absence for which C is treated as present` `evacuated, Secretary of State satisfied` EQUALS 0
#ASSERT `reg 18C(1): the first weeks of the absence for which C is treated as present` `evacuated, but nobody satisfied` EQUALS 0
#ASSERT `reg 18C(1): the first weeks of the absence for which C is treated as present` `evacuated, but C entered after the advice` EQUALS 0

-- reg 18A(1)(a)
#ASSERT `reg 18A(1)(a): C was present in the country or territory immediately before the Government's advice or evacuation` `advised to leave, Secretary of State satisfied`
#ASSERT NOT (`reg 18A(1)(a): C was present in the country or territory immediately before the Government's advice or evacuation` `an ordinary holiday of 20 weeks`)

-- larger / smaller
#ASSERT `regs 17 to 18D: the larger of two numbers` 3 5 EQUALS 5
#ASSERT `regs 17 to 18D: the larger of two numbers` 5 3 EQUALS 5
#ASSERT `regs 17 to 18D: the larger of two numbers` 4 4 EQUALS 4
#ASSERT `regs 17 to 18D: the smaller of two numbers` 3 5 EQUALS 3
#ASSERT `regs 17 to 18D: the smaller of two numbers` 5 3 EQUALS 3

-- reg 18B and 18D: the longest of the periods, not more than 26 weeks.
#ASSERT `reg 18B: the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18A(1)` `an ordinary holiday of 20 weeks` EQUALS 13
#ASSERT `reg 18B: the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18A(1)` `treatment abroad for 40 weeks` EQUALS 26
#ASSERT `reg 18B: the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18A(1)` `evacuated, Secretary of State satisfied` EQUALS 26
#ASSERT `reg 18B: the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18A(1)` `a long stay of 20 weeks, not temporary` EQUALS 0
#ASSERT `reg 18B: the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18A(1)` `evacuated, Scottish Ministers satisfied` EQUALS 13
#ASSERT `reg 18D(1): the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18C(1)` `evacuated, Scottish Ministers satisfied` EQUALS 26
#ASSERT `reg 18D(1): the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18C(1)` `evacuated, Secretary of State satisfied` EQUALS 13
#ASSERT `reg 18D(1): the total weeks of the absence for which C is treated as present under regulations 17(1), 18(1) and 18C(1)` `treatment abroad for 40 weeks` EQUALS 26
#ASSERT `regs 17 to 18D: the first weeks of the absence for which C is treated as present` `evacuated, Scottish Ministers satisfied` EQUALS 26
#ASSERT `regs 17 to 18D: the first weeks of the absence for which C is treated as present` `evacuated, Secretary of State satisfied` EQUALS 26
#ASSERT `regs 17 to 18D: the first weeks of the absence for which C is treated as present` `an ordinary holiday of 20 weeks` EQUALS 13
#ASSERT `regs 17 to 18D: the first weeks of the absence for which C is treated as present` `a long stay of 20 weeks, not temporary` EQUALS 0

§ `Tests of regulation 19`

-- reg 19(2): a member of the regular or reserve forces, not specified in Schedule 2, over the age of 16, not absent on desertion.
-- Born 10 June 2000: 16 on 10 June 2016; over 16 from 11 June 2016.
#ASSERT `reg 19(2): the person is a member of Her Majesty's forces on the day` TRUE FALSE (YMD 2000 6 10) (YMD 2016 6 11) FALSE
#ASSERT NOT (`reg 19(2): the person is a member of Her Majesty's forces on the day` TRUE FALSE (YMD 2000 6 10) (YMD 2016 6 10) FALSE)
#ASSERT `reg 19(2): the person is a member of Her Majesty's forces on the day` TRUE FALSE (YMD 2000 6 10) (YMD 2030 1 1) FALSE
#ASSERT NOT (`reg 19(2): the person is a member of Her Majesty's forces on the day` FALSE FALSE (YMD 2000 6 10) (YMD 2030 1 1) FALSE)
#ASSERT NOT (`reg 19(2): the person is a member of Her Majesty's forces on the day` TRUE TRUE (YMD 2000 6 10) (YMD 2030 1 1) FALSE)
#ASSERT NOT (`reg 19(2): the person is a member of Her Majesty's forces on the day` TRUE FALSE (YMD 2000 6 10) (YMD 2030 1 1) TRUE)

