IMPORT prelude
IMPORT `pip-nouns`
IMPORT `pip-dates`
IMPORT `pip-part1-general`

-- Tests of Part 1 (regulations 1 and 2). Every expected value is written from the text,
-- beside the assertion, before it was run.

§ `Tests of regulation 1`

-- Title block: "Made 25th February 2013".
#ASSERT `the date these Regulations were made` EQUALS YearMonthDay 2013 2 25
#ASSERT NOT (`the date these Regulations were made` EQUALS YearMonthDay 2013 2 24)

-- reg 1(2): in force in a case from the day Part 4 of the Act comes into force in that case.
-- The day Part 4 comes into force is an input: take 1 April 2013 for the sake of the tests.
-- On the day itself: in force. The day before: not.
#ASSERT `reg 1(2): these Regulations are in force in the case on` (YearMonthDay 2013 4 1) `, Part 4 of the Act coming into force in the case on` (YearMonthDay 2013 4 1)
#ASSERT NOT (`reg 1(2): these Regulations are in force in the case on` (YearMonthDay 2013 3 31) `, Part 4 of the Act coming into force in the case on` (YearMonthDay 2013 4 1))
#ASSERT `reg 1(2): these Regulations are in force in the case on` (YearMonthDay 2014 1 1) `, Part 4 of the Act coming into force in the case on` (YearMonthDay 2013 4 1)

-- reg 1(1): the short title.
#ASSERT `the short title of these Regulations` EQUALS "Social Security (Personal Independence Payment) Regulations 2013"

§ `Tests of regulation 2`

-- "aid or appliance": a device that improves, provides or replaces C's impaired function; and a prosthesis.
-- Each limb alone is enough (reg 2, lines 19 and 20); none of them is not.
#ASSERT `reg 2: a device is an aid or appliance` WITH `the device improves C's impaired physical or mental function` IS TRUE, `the device provides C's impaired physical or mental function` IS FALSE, `the device replaces C's impaired physical or mental function` IS FALSE, `the device is a prosthesis` IS FALSE
#ASSERT `reg 2: a device is an aid or appliance` WITH `the device improves C's impaired physical or mental function` IS FALSE, `the device provides C's impaired physical or mental function` IS TRUE, `the device replaces C's impaired physical or mental function` IS FALSE, `the device is a prosthesis` IS FALSE
#ASSERT `reg 2: a device is an aid or appliance` WITH `the device improves C's impaired physical or mental function` IS FALSE, `the device provides C's impaired physical or mental function` IS FALSE, `the device replaces C's impaired physical or mental function` IS TRUE, `the device is a prosthesis` IS FALSE
-- (b) "includes a prosthesis": a prosthesis is an aid or appliance even if it does none of the three.
#ASSERT `reg 2: a device is an aid or appliance` WITH `the device improves C's impaired physical or mental function` IS FALSE, `the device provides C's impaired physical or mental function` IS FALSE, `the device replaces C's impaired physical or mental function` IS FALSE, `the device is a prosthesis` IS TRUE
#ASSERT NOT (`reg 2: a device is an aid or appliance` WITH `the device improves C's impaired physical or mental function` IS FALSE, `the device provides C's impaired physical or mental function` IS FALSE, `the device replaces C's impaired physical or mental function` IS FALSE, `the device is a prosthesis` IS FALSE)

-- "C": a person who has made a claim for, or is entitled to, personal independence payment.
#ASSERT `reg 2: a person is C` WITH `the person has made a claim for personal independence payment` IS TRUE, `the person is entitled to personal independence payment` IS FALSE
#ASSERT `reg 2: a person is C` WITH `the person has made a claim for personal independence payment` IS FALSE, `the person is entitled to personal independence payment` IS TRUE
#ASSERT NOT (`reg 2: a person is C` WITH `the person has made a claim for personal independence payment` IS FALSE, `the person is entitled to personal independence payment` IS FALSE)

-- "component": the daily living component or the mobility component.
#ASSERT `reg 2: this is a component of personal independence payment` `the daily living component`
#ASSERT `reg 2: this is a component of personal independence payment` `the mobility component`

-- "medical treatment": medical, surgical or rehabilitative treatment, including a course, diet or regimen.
#ASSERT `reg 2: an intervention is medical treatment` `surgical treatment`
#ASSERT `reg 2: an intervention is medical treatment` `rehabilitative treatment`
#ASSERT `reg 2: an intervention is medical treatment` `a course or diet or other regimen`
#ASSERT `reg 2: an intervention is medical treatment` `medical treatment in the ordinary sense`
#ASSERT NOT (`reg 2: an intervention is medical treatment` `some other intervention`)

-- "previous award": an award of either or both components to which C has ceased to be entitled.
#ASSERT `reg 2: an award is a previous award` WITH `the award is of either or both components` IS TRUE, `C has ceased to be entitled to the award` IS TRUE
#ASSERT NOT (`reg 2: an award is a previous award` WITH `the award is of either or both components` IS TRUE, `C has ceased to be entitled to the award` IS FALSE)

-- "the residence change date": the date of the move, notified or not.
#ASSERT `reg 2: the residence change date` (YearMonthDay 2025 11 10) EQUALS YearMonthDay 2025 11 10

-- "revised" and "superseded".
#ASSERT `reg 2: a decision on an award is revised` `revision under section 9 of the 1998 Act`
#ASSERT NOT (`reg 2: a decision on an award is revised` `supersession under section 10 of the 1998 Act`)
#ASSERT `reg 2: a decision on an award is superseded` `supersession under section 10 of the 1998 Act`
#ASSERT NOT (`reg 2: a decision on an award is superseded` `a change that is neither a revision nor a supersession`)

-- The four named benefits.
#ASSERT `reg 2: this benefit is adult disability payment` `adult disability payment`
#ASSERT NOT (`reg 2: this benefit is adult disability payment` `child disability payment`)
#ASSERT `reg 2: this benefit is child disability payment` `child disability payment`
#ASSERT `reg 2: this benefit is disability living allowance` `disability living allowance`
#ASSERT NOT (`reg 2: this benefit is disability living allowance` `Scottish adult disability living allowance`)
#ASSERT `reg 2: this benefit is Scottish adult disability living allowance` `Scottish adult disability living allowance`
