IMPORT prelude
IMPORT `pip-nouns`
IMPORT `pip-sch1-definitions`

-- Tests of Schedule 1, Part 1 (paragraph 1, the definitions). Every expected value was written
-- from the text (lines 497 to 564) before the file was run. Arguments are positional, in the
-- order of the GIVEN of the rule; the comment above each group names them.

§ `Tests of Schedule 1, Part 1`

-- Sch 1 para 1: C does the activity aided: (aid or appliance, supervision, prompting, assistance)
#ASSERT `Sch 1 para 1: C does the activity aided` TRUE FALSE FALSE FALSE
#ASSERT `Sch 1 para 1: C does the activity aided` FALSE TRUE FALSE FALSE
#ASSERT `Sch 1 para 1: C does the activity aided` FALSE FALSE TRUE FALSE
#ASSERT `Sch 1 para 1: C does the activity aided` FALSE FALSE FALSE TRUE
#ASSERT NOT (`Sch 1 para 1: C does the activity aided` FALSE FALSE FALSE FALSE)

-- Sch 1 para 1: C does the activity unaided: (aid or appliance, supervision, prompting, assistance)
#ASSERT `Sch 1 para 1: C does the activity unaided` FALSE FALSE FALSE FALSE
#ASSERT NOT (`Sch 1 para 1: C does the activity unaided` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`Sch 1 para 1: C does the activity unaided` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`Sch 1 para 1: C does the activity unaided` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`Sch 1 para 1: C does the activity unaided` FALSE FALSE FALSE TRUE)

