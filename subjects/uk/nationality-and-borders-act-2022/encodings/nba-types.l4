IMPORT prelude
IMPORT daydate

-- Nationality and Borders Act 2022 (UK) — THE NOUNS: findings about an
-- asylum seeker, their journey and claim, and notices served. No rules here.
-- Source: ../registers/source-bundle/ukpga-2022-36.txt (point in time
-- 20 March 2026).

§ `Nouns`

-- s 31(1): actors of persecution.
DECLARE `Actor of persecution` IS ONE OF
    `the State`
    `a party or organisation controlling the State or a substantial part of it`
    `a non-State actor`

-- Article 1(A)(2) reasons (s 33).
DECLARE `Convention reason` IS ONE OF
    `race`
    `religion`
    `nationality`
    `political opinion`
    `membership of a particular social group`
    `no Convention reason`

DECLARE `Asylum facts` HAS
    -- s 30(5)
    `claim made on`                                     IS A DATE
    `section 30 in force from`                          IS A DATE
    `reason`                                            IS A `Convention reason`
    -- s 33(3)-(4), for a particular social group.
    `members share an innate, unchangeable or fundamental characteristic` IS A BOOLEAN
    `the group is perceived as different by the surrounding society` IS A BOOLEAN
    -- s 32(2), found on the balance of probabilities.
    `has (or is attributed) the characteristic`         IS A BOOLEAN
    `in fact fears persecution because of it`           IS A BOOLEAN
    -- s 32(4)(a), on a reasonable likelihood.
    `reasonable likelihood of persecution on return`    IS A BOOLEAN
    -- s 31(2)
    `sufficiently serious to be persecution`            IS A BOOLEAN
    `the actor`                                         IS AN `Actor of persecution`
    -- s 31(1)(c)
    `State and controlling parties unable or unwilling to protect` IS A BOOLEAN
    -- s 34(2)
    `a protector operates an effective legal system against it` IS A BOOLEAN
    `the asylum seeker can access that protection`      IS A BOOLEAN
    -- s 35(1)
    `no well-founded fear in another part of the country` IS A BOOLEAN
    `can reasonably be expected to relocate there`      IS A BOOLEAN

-- s 37: the journey and the claim.
DECLARE `Article 31 facts` HAS
    `stopped in another country on the way`             IS A BOOLEAN
    `could not reasonably have sought protection there` IS A BOOLEAN
    `became a refugee while outside the United Kingdom` IS A BOOLEAN
    `claimed as soon as reasonably practicable after arrival` IS A BOOLEAN
    `presence in the UK was lawful when they became a refugee` IS A BOOLEAN
    `claimed before their presence became unlawful`     IS A BOOLEAN
    `claimed as soon as reasonably practicable after becoming aware of the need` IS A BOOLEAN
    `the penalty relates to an attempt to leave the UK` IS A BOOLEAN

DECLARE `Notice kind` IS ONE OF
    -- s 20
    `a priority removal notice`
    -- s 18
    `an evidence notice`

DECLARE `Notice facts` HAS
    `kind`                                              IS A `Notice kind`
    -- s 20(3)(b): the PRN cut-off date, or the date specified in an evidence
    -- notice (s 26(4)(b)).
    `cut-off date`                                      IS A DATE
    -- When the material was provided; NOTHING if not provided.
    `material provided on`                              IS A MAYBE DATE
    -- s 20(4): already provided before the notice.
    `previously provided`                               IS A BOOLEAN
    -- s 21(1)(b), (3)
    `appeal rights exhausted on`                        IS A MAYBE DATE
    -- ss 22(4), 26(2)
    `good reasons for lateness`                         IS A BOOLEAN
    -- s 22(3): a protection or human rights claim, or a reasonable or
    -- conclusive grounds decision, is being made.
    `a relevant decision is being made`                 IS A BOOLEAN
