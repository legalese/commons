IMPORT prelude
IMPORT daydate
IMPORT `nba-types`
IMPORT `nba-refugee`
IMPORT `nba-article-31`
IMPORT `nba-notices`
IMPORT `nba-goal`

-- Independent tests: Nationality and Borders Act 2022, Part 2.
-- Expected values fixed in independent-expectations.md before the encoding
-- was read. A failing assertion is a finding; expected values are not edited
-- to match the code.

§ `Independent tests`

-- ---------------------------------------------------------------- helpers

GIVEN pClaim IS A DATE
      pForce IS A DATE
      pRsn IS A `Convention reason`
      pC1 IS A BOOLEAN
      pC2 IS A BOOLEAN
      pHas IS A BOOLEAN
      pFears IS A BOOLEAN
      pLikely IS A BOOLEAN
      pSerious IS A BOOLEAN
      pActor IS AN `Actor of persecution`
      pUnable IS A BOOLEAN
      pLegal IS A BOOLEAN
      pAccess IS A BOOLEAN
      pSafe IS A BOOLEAN
      pReloc IS A BOOLEAN
GIVETH AN `Asylum facts`
mkAF pClaim pForce pRsn pC1 pC2 pHas pFears pLikely pSerious pActor pUnable pLegal pAccess pSafe pReloc MEANS
    `Asylum facts` OF pClaim, pForce, pRsn, pC1, pC2, pHas, pFears, pLikely, pSerious, pActor, pUnable, pLegal, pAccess, pSafe, pReloc

inForce MEANS Date 28 6 2022
claimOK MEANS Date 1 7 2022

-- Baseline B with a chosen reason.
GIVEN pRsn IS A `Convention reason`
GIVETH AN `Asylum facts`
withReason pRsn MEANS
    mkAF claimOK inForce pRsn FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE

baseB MEANS withReason `political opinion`

GIVEN x IS AN `Asylum facts`
GIVETH A BOOLEAN
isRefugee x MEANS `the refugee determination for` x EQUALS `a refugee`

-- ---------------------------------------------------------------- Goal 1

-- R01 baseline
#ASSERT isRefugee baseB
-- R02 claim on the in-force day: s 30(5) "on or after"
#ASSERT isRefugee (mkAF (Date 28 6 2022) inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE)
-- R03 claim the day before: ss 31-35 do not apply
#ASSERT `the refugee determination for` (mkAF (Date 27 6 2022) inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE) EQUALS `ss 30-35 do not apply: claim made before s 30 came into force`
#ASSERT NOT (isRefugee (mkAF (Date 27 6 2022) inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R04-R06 each Convention reason
#ASSERT isRefugee (withReason `race`)
#ASSERT isRefugee (withReason `religion`)
#ASSERT isRefugee (withReason `nationality`)
-- R07 PSG, both conditions
#ASSERT isRefugee (mkAF claimOK inForce `membership of a particular social group` TRUE TRUE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE)
-- R08 PSG, first condition only
#ASSERT NOT (isRefugee (mkAF claimOK inForce `membership of a particular social group` TRUE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R09 PSG, second condition only
#ASSERT NOT (isRefugee (mkAF claimOK inForce `membership of a particular social group` FALSE TRUE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R09b PSG, neither condition
#ASSERT NOT (isRefugee (mkAF claimOK inForce `membership of a particular social group` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R12 no Convention reason
#ASSERT NOT (isRefugee (withReason `no Convention reason`))
#ASSERT `the refugee determination for` (withReason `no Convention reason`) EQUALS `not a refugee: no Convention reason`
-- R13/R14: characteristic held or attributed is one finding (has-or-attributed); not held nor attributed:
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE FALSE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R15 no actual fear
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE FALSE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R16 stage one fails; stage two facts favourable: stage two not reached
#ASSERT `the refugee determination for` (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE FALSE TRUE TRUE `the State` FALSE FALSE FALSE FALSE FALSE) EQUALS `not a refugee: stage one not met`
-- R17 no reasonable likelihood
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE FALSE TRUE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R17b harm not sufficiently serious (s 31(2))
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE FALSE `the State` FALSE FALSE FALSE FALSE FALSE))
-- R18 controlling party as actor
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `a party or organisation controlling the State or a substantial part of it` FALSE FALSE FALSE FALSE FALSE)
-- R19 non-State actor, State unable/unwilling
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `a non-State actor` TRUE FALSE FALSE FALSE FALSE)
-- R20 non-State actor, State able and willing
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `a non-State actor` FALSE FALSE FALSE FALSE FALSE))
-- R18b State as actor: unable/unwilling flag irrelevant
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` TRUE FALSE FALSE FALSE FALSE)
-- R21 protection, both limbs
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE TRUE TRUE FALSE FALSE))
#ASSERT `the refugee determination for` (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE TRUE TRUE FALSE FALSE) EQUALS `not a refugee: protection is available`
-- R22 effective system but no access
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE TRUE FALSE FALSE FALSE)
-- R23 access but no effective system
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE TRUE FALSE FALSE)
-- R24 internal relocation, both limbs
#ASSERT NOT (isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE TRUE TRUE))
#ASSERT `the refugee determination for` (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE TRUE TRUE) EQUALS `not a refugee: internal relocation`
-- R25 safe part, not reasonable
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE TRUE FALSE)
-- R26 no safe part, travel would be reasonable
#ASSERT isRefugee (mkAF claimOK inForce `political opinion` FALSE FALSE TRUE TRUE TRUE TRUE `the State` FALSE FALSE FALSE FALSE TRUE)
-- R03b pre-commencement claim that would fail anyway still reports non-application
#ASSERT `the refugee determination for` (mkAF (Date 1 1 2022) inForce `no Convention reason` FALSE FALSE FALSE FALSE FALSE FALSE `the State` FALSE TRUE TRUE TRUE TRUE) EQUALS `ss 30-35 do not apply: claim made before s 30 came into force`

-- ---------------------------------------------------------------- Goal 2

GIVEN pStop IS A BOOLEAN
      pCouldNot IS A BOOLEAN
      pOutside IS A BOOLEAN
      pAsap IS A BOOLEAN
      pLawful IS A BOOLEAN
      pBefore IS A BOOLEAN
      pAware IS A BOOLEAN
      pLeave IS A BOOLEAN
GIVETH AN `Article 31 facts`
mkJ pStop pCouldNot pOutside pAsap pLawful pBefore pAware pLeave MEANS
    `Article 31 facts` OF pStop, pCouldNot, pOutside, pAsap, pLawful, pBefore, pAware, pLeave

GIVEN j IS AN `Article 31 facts`
GIVETH A BOOLEAN
imm j MEANS `the s 37 conditions for Article 31(1) immunity are met by` j

GIVEN j IS AN `Article 31 facts`
GIVETH A BOOLEAN
direct j MEANS `the refugee came directly under` j

GIVEN j IS AN `Article 31 facts`
GIVETH A BOOLEAN
prompt j MEANS `the refugee presented themselves without delay under` j

baseA MEANS mkJ FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE

-- A01
#ASSERT direct baseA
#ASSERT prompt baseA
#ASSERT imm baseA
-- A02 stopped, could have sought protection
#ASSERT NOT (direct (mkJ TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE))
#ASSERT NOT (imm (mkJ TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE))
-- A03 stopped, could not reasonably have sought protection
#ASSERT direct (mkJ TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT imm (mkJ TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
-- A04 outside, not asap after arrival
#ASSERT NOT (prompt (mkJ FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE))
#ASSERT NOT (imm (mkJ FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE))
-- A05 in UK, lawful, claimed before unlawful
#ASSERT prompt (mkJ FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE)
#ASSERT imm (mkJ FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE)
-- A06 in UK, lawful, claimed after unlawful (aware-asap irrelevant)
#ASSERT NOT (prompt (mkJ FALSE FALSE FALSE TRUE TRUE FALSE TRUE FALSE))
-- A07 in UK, unlawful, asap after awareness
#ASSERT prompt (mkJ FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT imm (mkJ FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
-- A08 in UK, unlawful, delayed (claimed-before-unlawful irrelevant)
#ASSERT NOT (prompt (mkJ FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE))
-- A09 situation decides: in UK lawful, claimed while lawful, though not asap after arrival
#ASSERT prompt (mkJ FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE)
-- A09b outside UK: in-UK facts cannot rescue a late claim
#ASSERT NOT (prompt (mkJ FALSE FALSE TRUE FALSE TRUE TRUE TRUE FALSE))
-- A10 penalty relates to an attempt to leave
#ASSERT NOT (imm (mkJ FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE))
-- A10b directness and promptness unaffected by s 37(4)
#ASSERT direct (mkJ FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE)
#ASSERT prompt (mkJ FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE)
-- A11 stop + leaving
#ASSERT NOT (imm (mkJ TRUE FALSE TRUE TRUE FALSE FALSE FALSE TRUE))

-- ---------------------------------------------------------------- Goal 3

GIVEN pKind IS A `Notice kind`
      pCut IS A DATE
      pProv IS A MAYBE DATE
      pPrev IS A BOOLEAN
      pExh IS A MAYBE DATE
      pGood IS A BOOLEAN
      pRel IS A BOOLEAN
GIVETH A `Notice facts`
mkN pKind pCut pProv pPrev pExh pGood pRel MEANS
    `Notice facts` OF pKind, pCut, pProv, pPrev, pExh, pGood, pRel

cut MEANS Date 15 3 2024

-- PRN, provided on d, not previously provided, no exhaustion, given good reasons / relevant decision
GIVEN d IS A DATE
      pGood IS A BOOLEAN
      pRel IS A BOOLEAN
GIVETH A `Notice facts`
prn d pGood pRel MEANS mkN `a priority removal notice` cut (JUST d) FALSE NOTHING pGood pRel

GIVEN d IS A DATE
      pGood IS A BOOLEAN
      pRel IS A BOOLEAN
GIVETH A `Notice facts`
evn d pGood pRel MEANS mkN `an evidence notice` cut (JUST d) FALSE NOTHING pGood pRel

GIVEN n IS A `Notice facts`
GIVETH A BOOLEAN
late n MEANS `the material was provided late under` n

GIVEN c0 IS A DATE
      e IS A MAYBE DATE
GIVETH A MAYBE DATE
lastDay c0 e MEANS `the last day the priority removal notice is in force for` (mkN `a priority removal notice` c0 NOTHING FALSE e FALSE FALSE)

GIVEN n IS A `Notice facts`
GIVETH A BOOLEAN
cred n MEANS `lateness must be taken as damaging credibility under` n

GIVEN n IS A `Notice facts`
GIVETH A BOOLEAN
minw n MEANS `minimal weight applies to the evidence under` n

-- N01-N03 lateness
#ASSERT NOT (late (prn (Date 14 3 2024) FALSE TRUE))
#ASSERT late (prn (Date 15 3 2024) FALSE TRUE)
#ASSERT late (prn (Date 16 3 2024) FALSE TRUE)
-- N04 previously provided (s 20(4))
#ASSERT NOT (late (mkN `a priority removal notice` cut (JUST (Date 16 3 2024)) TRUE NOTHING FALSE TRUE))
-- not provided at all
#ASSERT NOT (late (mkN `a priority removal notice` cut NOTHING FALSE NOTHING FALSE TRUE))
-- N05-N14 s 21(1)
#ASSERT lastDay (Date 15 3 2024) NOTHING EQUALS JUST (Date 14 3 2025)
#ASSERT lastDay (Date 15 3 2024) (JUST (Date 10 6 2024)) EQUALS JUST (Date 9 6 2025)
#ASSERT lastDay (Date 15 3 2024) (JUST (Date 1 1 2024)) EQUALS JUST (Date 14 3 2025)
#ASSERT lastDay (Date 29 2 2024) NOTHING EQUALS JUST (Date 28 2 2025)
#ASSERT lastDay (Date 1 3 2023) NOTHING EQUALS JUST (Date 29 2 2024)
#ASSERT lastDay (Date 1 1 2024) NOTHING EQUALS JUST (Date 31 12 2024)
#ASSERT lastDay (Date 31 3 2023) NOTHING EQUALS JUST (Date 30 3 2024)
#ASSERT lastDay (Date 1 1 2023) (JUST (Date 29 2 2024)) EQUALS JUST (Date 28 2 2025)
#ASSERT lastDay (Date 1 3 2024) NOTHING EQUALS JUST (Date 28 2 2025)
#ASSERT lastDay (Date 15 3 2024) (JUST (Date 15 3 2024)) EQUALS JUST (Date 14 3 2025)
#ASSERT lastDay (Date 28 2 2023) NOTHING EQUALS JUST (Date 27 2 2024)
#ASSERT lastDay (Date 31 12 2024) NOTHING EQUALS JUST (Date 30 12 2025)
-- N15-N20 s 22
#ASSERT cred (prn (Date 20 3 2024) FALSE TRUE)
#ASSERT NOT (cred (prn (Date 20 3 2024) TRUE TRUE))
#ASSERT NOT (cred (prn (Date 14 3 2024) FALSE TRUE))
#ASSERT NOT (cred (prn (Date 20 3 2024) FALSE FALSE))
#ASSERT cred (prn (Date 15 3 2024) FALSE TRUE)
-- s 22 is about priority removal notices only: evidence notice lateness does not engage it
#ASSERT NOT (cred (evn (Date 20 3 2024) FALSE TRUE))
-- N21-N24, N27 s 26
#ASSERT minw (evn (Date 15 3 2024) FALSE TRUE)
#ASSERT NOT (minw (evn (Date 14 3 2024) FALSE TRUE))
#ASSERT NOT (minw (evn (Date 20 3 2024) TRUE TRUE))
#ASSERT minw (prn (Date 20 3 2024) FALSE TRUE)
#ASSERT minw (prn (Date 15 3 2024) FALSE TRUE)
-- N26 s 26(1)(b): evidence not falling to be considered for determining a claim or appeal
-- (closest available input: no relevant decision being made)
#ASSERT NOT (minw (evn (Date 20 3 2024) FALSE FALSE))

-- ---------------------------------------------------------------- top-level goal

caseFull MEANS `Asylum case` OF baseB, (JUST baseA), (JUST (prn (Date 20 3 2024) FALSE TRUE))
posFull MEANS `the asylum position for` caseFull
#ASSERT posFull's `refugee determination` EQUALS `a refugee`
#ASSERT posFull's `s 37 conditions met` EQUALS JUST TRUE
#ASSERT posFull's `material provided late` EQUALS JUST TRUE
#ASSERT posFull's `last day the priority removal notice is in force` EQUALS JUST (Date 14 3 2025)
#ASSERT posFull's `credibility damaged by lateness` EQUALS JUST TRUE
#ASSERT posFull's `minimal weight to late evidence` EQUALS JUST TRUE

caseBare MEANS `Asylum case` OF (withReason `no Convention reason`), NOTHING, NOTHING
posBare MEANS `the asylum position for` caseBare
#ASSERT posBare's `refugee determination` EQUALS `not a refugee: no Convention reason`
#ASSERT posBare's `s 37 conditions met` EQUALS NOTHING
#ASSERT posBare's `last day the priority removal notice is in force` EQUALS NOTHING
#ASSERT posBare's `credibility damaged by lateness` EQUALS NOTHING

-- evidence notice: no s 21 in-force date
caseEv MEANS `Asylum case` OF baseB, NOTHING, (JUST (evn (Date 20 3 2024) FALSE TRUE))
posEv MEANS `the asylum position for` caseEv
#ASSERT posEv's `last day the priority removal notice is in force` EQUALS NOTHING
#ASSERT posEv's `minimal weight to late evidence` EQUALS JUST TRUE
#ASSERT posEv's `credibility damaged by lateness` EQUALS JUST FALSE
