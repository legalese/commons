IMPORT prelude
IMPORT daydate

-- Consumer Rights Act 2015 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2015-15.txt (point in time
-- 6 April 2026).

§ `Nouns`

-- s 22(3), (24(11)): the events after which the periods start.
DECLARE `Goods supply` HAS
    `ownership or possession transferred on`            IS A DATE
    `delivered on`                                      IS A DATE
    -- s 22(3)(c): where the contract requires installation or other action,
    -- the day the trader notified the consumer it was done; NOTHING if none
    -- is required.
    `installation notified on`                          IS A MAYBE DATE
    -- s 22(4): the end of a shorter period for goods that can reasonably be
    -- expected to perish; NOTHING if not perishable.
    `perishes by`                                       IS A MAYBE DATE

-- s 22(6)-(8): a request for repair or replacement.
DECLARE `Repair or replacement` HAS
    `requested or agreed on`                            IS A DATE
    `goods received back on`                            IS A DATE
    `still do not conform`                              IS A BOOLEAN

-- s 24(5): the situation that opens the tier-two remedies.
DECLARE `Tier two facts` HAS
    `after one repair or replacement the goods still do not conform` IS A BOOLEAN
    `neither repair nor replacement can be required`    IS A BOOLEAN
    `the trader failed to repair or replace within a reasonable time` IS A BOOLEAN
    -- s 24(10)(a)-(b)
    `a motor vehicle or specified goods`                IS A BOOLEAN
    `price paid`                                        IS A NUMBER
    -- s 24(8): the deduction for use the trader claims.
    `deduction for use claimed`                         IS A NUMBER
    `final right exercised on`                          IS A DATE
    -- s 20(15)
    `trader agreed to refund on`                        IS A DATE

-- s 19(14)-(15)
DECLARE `Fault facts` HAS
    `fault appeared on`                                 IS A DATE
    `established to conform on delivery`                IS A BOOLEAN
    `presumption incompatible with the goods or the fault` IS A BOOLEAN

DECLARE `Service facts` HAS
    -- s 54(2): the service did not conform to the contract.
    `does not conform`                                  IS A BOOLEAN
    -- s 55(3)
    `completing performance in conformity is impossible` IS A BOOLEAN
    -- s 55(2)(a), 56(3)(b)
    `repeat performance required but not given within a reasonable time` IS A BOOLEAN
    `trader agreed to refund on`                        IS A MAYBE DATE
