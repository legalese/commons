IMPORT prelude
IMPORT daydate
IMPORT `cra-types`
IMPORT `cra-goods`
IMPORT `cra-services`
IMPORT `cra-goal`

-- Consumer Rights Act 2015 (UK) — the encoder's tests. Expected values are
-- worked by hand from the Act.

§ `Tests`

-- Transferred 1 March 2026, delivered 3 March 2026: the last event is
-- 3 March; the 30 days run 4 March to 2 April.
plain MEANS `Goods supply` OF Date 1 3 2026, Date 3 3 2026, NOTHING, NOTHING
installed MEANS `Goods supply` OF Date 1 3 2026, Date 3 3 2026, JUST (Date 5 3 2026), NOTHING
perishable MEANS `Goods supply` OF Date 1 3 2026, Date 3 3 2026, NOTHING, JUST (Date 10 3 2026)

GIVEN requested IS A DATE, received IS A DATE, bad IS A BOOLEAN
GIVETH A MAYBE `Repair or replacement`
`a repair requested` requested `, received` received `, still bad` bad MEANS
    JUST (`Repair or replacement` OF requested, received, bad)

§§ `Goal 1 — the short-term right to reject`

#ASSERT `the last day for the short-term right to reject for` plain `with` NOTHING EQUALS Date 2 4 2026
#ASSERT `the last day for the short-term right to reject for` installed `with` NOTHING EQUALS Date 4 4 2026
#ASSERT `the last day for the short-term right to reject for` perishable `with` NOTHING EQUALS Date 10 3 2026
-- s 22(6): waiting period 10-19 March (10 days): 12 April.
#ASSERT `the last day for the short-term right to reject for` plain `with` (`a repair requested` (Date 10 3 2026) `, received` (Date 19 3 2026) `, still bad` FALSE) EQUALS Date 12 4 2026
-- s 22(7): still not conforming — later of 26 March and 12 April.
#ASSERT `the last day for the short-term right to reject for` plain `with` (`a repair requested` (Date 10 3 2026) `, received` (Date 19 3 2026) `, still bad` TRUE) EQUALS Date 12 4 2026
-- Waiting period 1-20 April (20 days): extended to 22 April; received 20
-- April + 7 = 27 April is later.
#ASSERT `the last day for the short-term right to reject for` plain `with` (`a repair requested` (Date 1 4 2026) `, received` (Date 20 4 2026) `, still bad` TRUE) EQUALS Date 27 4 2026
#ASSERT `the last day for the short-term right to reject for` plain `with` (`a repair requested` (Date 1 4 2026) `, received` (Date 20 4 2026) `, still bad` FALSE) EQUALS Date 22 4 2026
-- A request after the limit has passed changes nothing.
#ASSERT `the last day for the short-term right to reject for` plain `with` (`a repair requested` (Date 5 4 2026) `, received` (Date 10 4 2026) `, still bad` TRUE) EQUALS Date 2 4 2026

§§ `Goal 2 — the presumption and the final right to reject`

-- Six months beginning 3 March 2026 end 2 September 2026.
#ASSERT `the goods are presumed not to have conformed on delivery for` plain `with` (`Fault facts` OF Date 2 9 2026, FALSE, FALSE)
#ASSERT NOT (`the goods are presumed not to have conformed on delivery for` plain `with` (`Fault facts` OF Date 3 9 2026, FALSE, FALSE))
#ASSERT NOT (`the goods are presumed not to have conformed on delivery for` plain `with` (`Fault facts` OF Date 1 6 2026, TRUE, FALSE))
#ASSERT NOT (`the goods are presumed not to have conformed on delivery for` plain `with` (`Fault facts` OF Date 1 6 2026, FALSE, TRUE))
-- Delivered 31 August 2026: six months end 28 February 2027.
#ASSERT `the goods are presumed not to have conformed on delivery for` (`Goods supply` OF Date 31 8 2026, Date 31 8 2026, NOTHING, NOTHING) `with` (`Fault facts` OF Date 28 2 2027, FALSE, FALSE)
#ASSERT NOT (`the goods are presumed not to have conformed on delivery for` (`Goods supply` OF Date 31 8 2026, Date 31 8 2026, NOTHING, NOTHING) `with` (`Fault facts` OF Date 1 3 2027, FALSE, FALSE))

-- Fields: after one repair, neither possible, trader late, motor vehicle,
-- price, deduction, exercised, agreed.
GIVEN exercised IS A DATE, motor IS A BOOLEAN
GIVETH A `Tier two facts`
`rejected finally on` exercised `, motor vehicle` motor MEANS
    `Tier two facts` OF TRUE, FALSE, FALSE, motor, 500, 100, exercised, Date 20 3 2026

#ASSERT `the tier-two remedies are available under` (`rejected finally on` (Date 1 6 2026) `, motor vehicle` FALSE)
#ASSERT NOT (`the tier-two remedies are available under` (`Tier two facts` OF FALSE, FALSE, FALSE, FALSE, 500, 100, Date 1 6 2026, Date 20 3 2026))
#ASSERT `the tier-two remedies are available under` (`Tier two facts` OF FALSE, TRUE, FALSE, FALSE, 500, 100, Date 1 6 2026, Date 20 3 2026)
#ASSERT `the tier-two remedies are available under` (`Tier two facts` OF FALSE, FALSE, TRUE, FALSE, 500, 100, Date 1 6 2026, Date 20 3 2026)
-- The first 6 months begin 4 March 2026 and end 3 September 2026.
#ASSERT `the refund on final rejection for` plain `with` (`rejected finally on` (Date 3 9 2026) `, motor vehicle` FALSE) EQUALS 500
#ASSERT `the refund on final rejection for` plain `with` (`rejected finally on` (Date 4 9 2026) `, motor vehicle` FALSE) EQUALS 400
#ASSERT `the refund on final rejection for` plain `with` (`rejected finally on` (Date 3 9 2026) `, motor vehicle` TRUE) EQUALS 400
#ASSERT `the refund on final rejection for` plain `with` (`Tier two facts` OF FALSE, FALSE, FALSE, FALSE, 500, 100, Date 1 6 2026, Date 20 3 2026) EQUALS 0
-- s 20(15): agreed 20 March 2026, refund by 2 April 2026.
#ASSERT `the last day for a refund agreed on` (Date 20 3 2026) EQUALS Date 2 4 2026
#ASSERT `the last day for a refund agreed on` (Date 20 12 2026) EQUALS Date 2 1 2027

§§ `Goal 3 — services`

#ASSERT `repeat performance can be required for` (`Service facts` OF TRUE, FALSE, FALSE, NOTHING)
#ASSERT NOT (`repeat performance can be required for` (`Service facts` OF TRUE, TRUE, FALSE, NOTHING))
#ASSERT NOT (`repeat performance can be required for` (`Service facts` OF FALSE, FALSE, FALSE, NOTHING))
#ASSERT NOT (`a price reduction is available for` (`Service facts` OF TRUE, FALSE, FALSE, NOTHING))
#ASSERT `a price reduction is available for` (`Service facts` OF TRUE, TRUE, FALSE, NOTHING)
#ASSERT `a price reduction is available for` (`Service facts` OF TRUE, FALSE, TRUE, NOTHING)

§§ `The top-level goal`

pos MEANS `the consumer position for` (`Consumer case` OF JUST plain, `a repair requested` (Date 10 3 2026) `, received` (Date 19 3 2026) `, still bad` TRUE, JUST (`Fault facts` OF Date 1 6 2026, FALSE, FALSE), JUST (`rejected finally on` (Date 1 6 2026) `, motor vehicle` FALSE), JUST (`Service facts` OF TRUE, TRUE, FALSE, JUST (Date 1 7 2026)))
#ASSERT pos's `last day for the short-term right to reject` EQUALS JUST (Date 12 4 2026)
#ASSERT pos's `presumed not to conform on delivery` EQUALS JUST TRUE
#ASSERT pos's `tier-two remedies available` EQUALS JUST TRUE
#ASSERT pos's `refund on final rejection` EQUALS JUST 500
#ASSERT pos's `last day for the goods refund` EQUALS JUST (Date 2 4 2026)
#ASSERT pos's `repeat performance can be required` EQUALS JUST FALSE
#ASSERT pos's `service price reduction available` EQUALS JUST TRUE
#ASSERT pos's `last day for the service refund` EQUALS JUST (Date 14 7 2026)
