IMPORT prelude
IMPORT daydate

-- Customs and Excise Management Act 1979 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1979-2.txt (point in time
-- 29 April 2026).

§ `Nouns`

-- Sch 3 para 1(2): who was present when the thing was seized.
DECLARE `Seizure facts` HAS
    `seized on`                                         IS A DATE
    -- para 1(2)(a)-(d)
    `seized in the presence of the offender, owner, possessor, master or driver` IS A BOOLEAN
    -- para 1(1): the Commissioners know of an owner.
    `an owner is known to the Commissioners`            IS A BOOLEAN
    -- para 2: the date notice of seizure was served; NOTHING if none.
    `notice of seizure served on`                       IS A MAYBE DATE
    -- para 3: the date a notice of claim was given; NOTHING if none.
    `notice of claim given on`                          IS A MAYBE DATE
    -- para 4: the claim specified the name and address (and a UK solicitor
    -- for a claimant abroad).
    `the claim met paragraph 4`                         IS A BOOLEAN

-- s 170 and Schedule 1: the kind of goods.
DECLARE `Kind of goods` IS ONE OF
    `ordinary goods`
    `a Class A drug`
    `a Class B drug or temporary class drug`
    `a Class C drug`
    -- s 170(4A): a weapon or ammunition of a kind in s 5(1)(a), etc., of the
    -- Firearms Act 1968 (or the NI equivalent).
    `a prohibited weapon within s 170(4A)`
    -- s 170(4B): the Import of Seal Skins Regulations 1996 prohibition.
    `seal skins`

DECLARE `Evasion facts` HAS
    `kind of goods`                                     IS A `Kind of goods`
    `value of the goods`                                IS A NUMBER
    -- s 170(1)-(2): the conduct and the mental elements.
    `knowingly acquired or dealt with the goods`        IS A BOOLEAN
    `with intent to defraud of duty or evade a prohibition` IS A BOOLEAN
    `knowingly concerned in a fraudulent evasion or attempt` IS A BOOLEAN
    -- s 170(5): a corresponding offence with its own penalty applies instead.
    `a corresponding offence with its own penalty applies` IS A BOOLEAN
    -- s 170(3)(a), Sch 1: the fixed sum on summary conviction (printed as
    -- "the prescribed sum £20,000").
    `the summary fixed sum`                             IS A NUMBER

DECLARE `Offence timing` HAS
    `committed on`                                      IS A DATE
    `indictable`                                        IS A BOOLEAN
    -- s 146A(3): when sufficient evidence came to the prosecuting authority's
    -- knowledge.
    `sufficient evidence known on`                      IS A DATE
