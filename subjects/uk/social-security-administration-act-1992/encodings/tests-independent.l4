IMPORT prelude
IMPORT daydate
IMPORT `ssaa-types`
IMPORT `ssaa-rules`
IMPORT `ssaa-goal`

-- Independent tests: SSAA 1992 ss 71, 111A, 112, 115A.
-- Expected values fixed in independent-expectations.md before reading the
-- encoding. Scenario numbers refer to that file.

§ `Helpers`

GIVEN mrep IS A BOOLEAN
      csq  IS A BOOLEAN
      rev  IS A BOOLEAN
      amt  IS A NUMBER
GIVETH AN `Overpayment facts`
mkO mrep csq rev amt MEANS `Overpayment facts` OF mrep, csq, rev, amt

GIVEN o IS AN `Overpayment facts`
GIVETH A NUMBER
rec o MEANS `the amount recoverable under s 71 for` o

GIVEN cnd IS A `Conduct`
      elm IS A BOOLEAN
      dis IS A BOOLEAN
      sco IS A BOOLEAN
GIVETH AN `Offence facts`
mkF cnd elm dis sco MEANS `Offence facts` OF cnd, elm, dis, sco

GIVEN f IS AN `Offence facts`
GIVETH A `Benefit offence`
off f MEANS `the benefit offence for` f

GIVEN f IS AN `Offence facts`
GIVETH A MAYBE `Maximum sentence`
maxs f MEANS `the maximum sentence for` (`the benefit offence for` f)

GIVEN mde IS A BOOLEAN
      att IS A BOOLEAN
      grd IS A BOOLEAN
      rcv IS A BOOLEAN
      amt IS A NUMBER
      agd IS A MAYBE DATE
GIVETH A `Penalty facts`
mkP mde att grd rcv amt agd MEANS `Penalty facts` OF mde, att, grd, rcv, amt, agd

-- an ordinary (1) case with the given overpayment
GIVEN amt IS A NUMBER
GIVETH A NUMBER
pen amt MEANS `the administrative penalty for` (mkP TRUE TRUE TRUE TRUE amt NOTHING)

GIVEN p IS A `Penalty facts`
GIVETH A BOOLEAN
mayGive p MEANS `a penalty notice may be given for` p

GIVEN dd IS A NUMBER
      mm IS A NUMBER
      yy IS A NUMBER
GIVETH A MAYBE DATE
lastW dd mm yy MEANS `the last day to withdraw agreement for` (mkP TRUE TRUE TRUE TRUE 1000 (JUST (Date dd mm yy)))

§ `s 71 recoverable overpayments`

-- 1. misrepresentation, in consequence, revised, £1,200
#ASSERT rec (mkO TRUE TRUE TRUE 1200) EQUALS 1200
-- 2. innocent failure to disclose, superseded, £850.50
#ASSERT rec (mkO TRUE TRUE TRUE 850.50) EQUALS 850.50
-- 3. reversed on appeal, £300
#ASSERT rec (mkO TRUE TRUE TRUE 300) EQUALS 300
-- 4. decision not revised, superseded or reversed: s 71(5A)
#ASSERT rec (mkO TRUE TRUE FALSE 1200) EQUALS 0
-- 5. not in consequence
#ASSERT rec (mkO TRUE FALSE TRUE 1200) EQUALS 0
-- 6/7. no misrepresentation or failure to disclose of a material fact
#ASSERT rec (mkO FALSE TRUE TRUE 1200) EQUALS 0
-- 9. £5,000
#ASSERT rec (mkO TRUE TRUE TRUE 5000) EQUALS 5000
-- odd pennies are recovered in full, not rounded
#ASSERT rec (mkO TRUE TRUE TRUE 123.45) EQUALS 123.45
-- nothing satisfied
#ASSERT rec (mkO FALSE FALSE FALSE 99) EQUALS 0

§ `ss 111A and 112 offences`

-- 10. E&W, dishonest, knowingly false statement
#ASSERT off (mkF `made a false statement or provided false information` TRUE TRUE FALSE) EQUALS `an offence under s 111A (dishonesty)`
-- 11. E&W, knowingly false statement, not dishonest
#ASSERT off (mkF `made a false statement or provided false information` TRUE FALSE FALSE) EQUALS `an offence under s 112`
-- 12. Scotland, knowingly, not dishonest: s 111A(4)
#ASSERT off (mkF `made a false statement or provided false information` TRUE FALSE TRUE) EQUALS `an offence under s 111A (dishonesty)`
-- 13. Scotland, dishonest but not knowing
#ASSERT off (mkF `made a false statement or provided false information` FALSE TRUE TRUE) EQUALS `no offence`
-- 14. statement not false / elements not met, E&W, not dishonest
#ASSERT off (mkF `made a false statement or provided false information` FALSE FALSE FALSE) EQUALS `no offence`
-- 15. dishonest failure to notify, E&W
#ASSERT off (mkF `failed to notify a change of circumstances` TRUE TRUE FALSE) EQUALS `an offence under s 111A (dishonesty)`
-- 16-18. excluded change / not known / prompt notice: elements not met
#ASSERT off (mkF `failed to notify a change of circumstances` FALSE TRUE FALSE) EQUALS `no offence`
-- 19. failure to notify, knows, not dishonest, E&W
#ASSERT off (mkF `failed to notify a change of circumstances` TRUE FALSE FALSE) EQUALS `an offence under s 112`
-- 20. Scotland, failure to notify, knowingly
#ASSERT off (mkF `failed to notify a change of circumstances` TRUE FALSE TRUE) EQUALS `an offence under s 111A (dishonesty)`
-- 21. (1B) causes or allows another to fail to notify, dishonestly
#ASSERT off (mkF `caused or allowed another to fail to notify` TRUE TRUE FALSE) EQUALS `an offence under s 111A (dishonesty)`
-- (1B) under s 112, not dishonest
#ASSERT off (mkF `caused or allowed another to fail to notify` TRUE FALSE FALSE) EQUALS `an offence under s 112`
-- (1B) elements not met in Scotland
#ASSERT off (mkF `caused or allowed another to fail to notify` FALSE FALSE TRUE) EQUALS `no offence`

-- 22-23. s 111A(3): six months summary, seven years on indictment
#ASSERT maxs (mkF `made a false statement or provided false information` TRUE TRUE FALSE) EQUALS JUST (`Maximum sentence` OF 6, JUST 7)
#ASSERT maxs (mkF `failed to notify a change of circumstances` TRUE FALSE TRUE) EQUALS JUST (`Maximum sentence` OF 6, JUST 7)
-- 24. s 112(2): three months, summary only
#ASSERT maxs (mkF `made a false statement or provided false information` TRUE FALSE FALSE) EQUALS JUST (`Maximum sentence` OF 3, NOTHING)
-- 25. no offence, no sentence
#ASSERT maxs (mkF `failed to notify a change of circumstances` FALSE TRUE FALSE) EQUALS NOTHING

§ `s 115A notice`

-- 26. recoverable, attributable, grounds
#ASSERT mayGive (mkP TRUE TRUE TRUE TRUE 1000 NOTHING)
-- 27. not attributable
#ASSERT NOT (mayGive (mkP TRUE FALSE TRUE TRUE 1000 NOTHING))
-- 28. no grounds
#ASSERT NOT (mayGive (mkP TRUE TRUE FALSE TRUE 1000 NOTHING))
-- 29. not recoverable
#ASSERT NOT (mayGive (mkP TRUE TRUE TRUE FALSE 1000 NOTHING))
-- 30. (1A): no overpayment, grounds, would have been recoverable
#ASSERT mayGive (mkP FALSE TRUE TRUE TRUE 0 NOTHING)
#ASSERT `the administrative penalty for` (mkP FALSE TRUE TRUE TRUE 0 NOTHING) EQUALS 350
-- (1A) does not turn on attributability flag (b) is hypothetical
#ASSERT `the administrative penalty for` (mkP FALSE FALSE TRUE TRUE 0 NOTHING) EQUALS 350
-- 31. (1A), would not have been recoverable
#ASSERT NOT (mayGive (mkP FALSE TRUE TRUE FALSE 0 NOTHING))
-- 32. (1A), no grounds
#ASSERT NOT (mayGive (mkP FALSE TRUE FALSE TRUE 0 NOTHING))

§ `s 115A(3) amount`

-- 33
#ASSERT pen 1000 EQUALS 500
-- 34. at the minimum
#ASSERT pen 700 EQUALS 350
-- 35. 349.995 -> 349.99 -> minimum
#ASSERT pen 699.99 EQUALS 350
-- 36
#ASSERT pen 600 EQUALS 350
-- 37
#ASSERT pen 701 EQUALS 350.50
-- just over the minimum by an odd penny: 350.005 -> 350.00
#ASSERT pen 700.01 EQUALS 350
-- 700.03 -> 350.015 -> 350.01
#ASSERT pen 700.03 EQUALS 350.01
-- 38. at the maximum
#ASSERT pen 10000 EQUALS 5000
-- 39. 4999.995 -> 4999.99
#ASSERT pen 9999.99 EQUALS 4999.99
-- 40
#ASSERT pen 10000.02 EQUALS 5000
-- 41
#ASSERT pen 20000 EQUALS 5000
-- 42. 617.285 -> 617.28
#ASSERT pen 1234.57 EQUALS 617.28
-- 43. 400.005 -> 400.00
#ASSERT pen 800.01 EQUALS 400
-- 44. 1000.015 -> 1000.01
#ASSERT pen 2000.03 EQUALS 1000.01
-- even penny: 2000.04 -> 1000.02
#ASSERT pen 2000.04 EQUALS 1000.02
-- 0.01 overpayment -> minimum
#ASSERT pen 0.01 EQUALS 350

§ `s 115A(5) withdrawal window`

-- 45
#ASSERT lastW 1 1 2026 EQUALS JUST (Date 14 1 2026)
-- 46. across a month end
#ASSERT lastW 20 1 2026 EQUALS JUST (Date 2 2 2026)
-- 47. leap year
#ASSERT lastW 18 2 2024 EQUALS JUST (Date 2 3 2024)
-- 48. non-leap year
#ASSERT lastW 18 2 2026 EQUALS JUST (Date 3 3 2026)
-- 49. ends on the leap day
#ASSERT lastW 16 2 2024 EQUALS JUST (Date 29 2 2024)
-- 50. across a year end
#ASSERT lastW 25 12 2026 EQUALS JUST (Date 7 1 2027)
-- 51
#ASSERT lastW 31 3 2026 EQUALS JUST (Date 13 4 2026)
-- 2100 is not a leap year
#ASSERT lastW 16 2 2100 EQUALS JUST (Date 1 3 2100)
-- no agreement: no last day
#ASSERT `the last day to withdraw agreement for` (mkP TRUE TRUE TRUE TRUE 1000 NOTHING) EQUALS NOTHING

§ `Top-level goal`

GIVEN c IS AN `Overpayment case`
GIVETH AN `Overpayment position`
posOf c MEANS `the overpayment position for` c

caseA MEANS
    `Overpayment case` OF
        JUST (mkO TRUE TRUE TRUE 2000.03),
        JUST (mkF `failed to notify a change of circumstances` TRUE TRUE FALSE),
        JUST (mkP TRUE TRUE TRUE TRUE 2000.03 (JUST (Date 25 2 2028)))

posA MEANS posOf caseA

#ASSERT posA's `amount recoverable` EQUALS JUST 2000.03
#ASSERT posA's `offence` EQUALS JUST `an offence under s 111A (dishonesty)`
#ASSERT posA's `maximum sentence` EQUALS JUST (`Maximum sentence` OF 6, JUST 7)
#ASSERT posA's `administrative penalty` EQUALS JUST 1000.01
-- 25 Feb 2028 + 13, 2028 a leap year: 9 March 2028
#ASSERT posA's `last day to withdraw agreement` EQUALS JUST (Date 9 3 2028)

caseB MEANS `Overpayment case` OF NOTHING, NOTHING, NOTHING
posB MEANS posOf caseB
#ASSERT posB's `amount recoverable` EQUALS NOTHING
#ASSERT posB's `offence` EQUALS NOTHING
#ASSERT posB's `administrative penalty` EQUALS NOTHING
