IMPORT prelude
IMPORT daydate

-- Social Security Administration Act 1992 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1992-5.txt (point in time
-- 8 July 2026).

§ `Nouns`

DECLARE `Overpayment facts` HAS
    -- s 71(1)
    `misrepresented or failed to disclose a material fact` IS A BOOLEAN
    `payment made in consequence`                       IS A BOOLEAN
    -- s 71(5A)
    `awarding decision revised, superseded or reversed` IS A BOOLEAN
    `amount overpaid`                                   IS A NUMBER

DECLARE `Conduct` IS ONE OF
    `made a false statement or provided false information`
    `failed to notify a change of circumstances`
    `caused or allowed another to fail to notify`

DECLARE `Offence facts` HAS
    `conduct`                                           IS A `Conduct`
    -- For a false statement: the person knew it was false. For a failure to
    -- notify: the change was not excluded, the person knew it affected
    -- entitlement, and notice was not prompt.
    `the knowledge and other elements are met`          IS A BOOLEAN
    `dishonestly`                                       IS A BOOLEAN
    `in Scotland`                                       IS A BOOLEAN

DECLARE `Penalty facts` HAS
    -- s 115A(1)(a)-(b), (1A)(a)
    `an overpayment was made`                           IS A BOOLEAN
    `attributable to the person's act or omission`      IS A BOOLEAN
    `grounds for proceedings for an offence`            IS A BOOLEAN
    `the overpayment would be recoverable`              IS A BOOLEAN
    `amount overpaid`                                   IS A NUMBER
    `agreed to pay on`                                  IS A MAYBE DATE
