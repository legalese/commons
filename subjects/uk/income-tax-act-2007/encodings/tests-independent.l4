IMPORT prelude
IMPORT daydate
IMPORT `ita-types`
IMPORT `ita-rules`
IMPORT `ita-goal`

-- Independent tests, written from BRIEF.md and the source text before the
-- encoding was read. Expected values come from independent-expectations.md
-- and are never changed to fit the code. Rates 20/40/45 and the same
-- savings rates.

§ `Independent tests`

`the rates` MEANS `Rates for the year` OF 20, 40, 45, 20, 40, 45

GIVEN wages IS A NUMBER, sav IS A NUMBER, divs IS A NUMBER, gift IS A NUMBER, pens IS A NUMBER, mrole IS A `Marriage allowance role`
GIVETH A `Taxpayer`
`person` MEANS `Taxpayer` OF `the rates`, wages, sav, divs, gift, pens, mrole

GIVEN wages IS A NUMBER, sav IS A NUMBER, divs IS A NUMBER
GIVETH A `Taxpayer`
`earner` MEANS `person` OF wages, sav, divs, 0, 0, `no election`

GIVEN wages IS A NUMBER, sav IS A NUMBER, divs IS A NUMBER
GIVETH A `Taxpayer`
`gainer` MEANS `person` OF wages, sav, divs, 0, 0, `my spouse or civil partner elected to transfer to me`

GIVEN wages IS A NUMBER, sav IS A NUMBER, divs IS A NUMBER
GIVETH A `Taxpayer`
`giver` MEANS `person` OF wages, sav, divs, 0, 0, `I elected to transfer my allowance`

GIVEN t IS A `Taxpayer`
GIVETH A NUMBER
`tax of` t MEANS `my income tax liability` t

GIVEN t IS A `Taxpayer`
GIVETH A NUMBER
`PA of` t MEANS `my personal allowance` t

GIVEN t IS A `Taxpayer`
GIVETH A NUMBER
`SA of` t MEANS `my savings allowance` t

GIVEN t IS A `Taxpayer`
GIVETH A NUMBER
`MA of` t MEANS `my marriage allowance reduction` t

-- Goal 1: personal allowance (s 35, 58, 55B(6))
#ASSERT `PA of` (`earner` OF 50000, 0, 0) EQUALS 12570
#ASSERT `PA of` (`earner` OF 100000, 0, 0) EQUALS 12570
#ASSERT `PA of` (`earner` OF 100001, 0, 0) EQUALS 12570
#ASSERT `PA of` (`earner` OF 100003, 0, 0) EQUALS 12569
#ASSERT `PA of` (`earner` OF 110000, 0, 0) EQUALS 7570
#ASSERT `PA of` (`earner` OF 125139, 0, 0) EQUALS 1
#ASSERT `PA of` (`earner` OF 125140, 0, 0) EQUALS 0
#ASSERT `PA of` (`earner` OF 150000, 0, 0) EQUALS 0
-- P9 Gift Aid net 4,000 grossed to 5,000
#ASSERT `my adjusted net income` (`person` OF 105000, 0, 0, 4000, 0, `no election`) EQUALS 100000
#ASSERT `PA of` (`person` OF 105000, 0, 0, 4000, 0, `no election`) EQUALS 12570
-- P10 pension gross 10,000
#ASSERT `PA of` (`person` OF 120000, 0, 0, 0, 10000, `no election`) EQUALS 7570
-- P11 Gift Aid and pension together
#ASSERT `my adjusted net income` (`person` OF 112000, 0, 0, 2000, 4000, `no election`) EQUALS 105500
#ASSERT `PA of` (`person` OF 112000, 0, 0, 2000, 4000, `no election`) EQUALS 9820
-- P12 relinquishing party
#ASSERT `PA of` (`giver` OF 10000, 0, 0) EQUALS 11310

