IMPORT prelude
IMPORT daydate

-- Income Tax Act 2007 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2007-3.txt (point in time
-- 16 September 2026). Seat: the individual taxpayer (UK resident, not a
-- Scottish or Welsh taxpayer, no property income).

§ `Nouns`

-- ss 6(2), 7A: the rates determined by Parliament for the tax year, as
-- percentages.
DECLARE `Rates for the year` HAS
    `basic rate`                                        IS A NUMBER
    `higher rate`                                       IS A NUMBER
    `additional rate`                                   IS A NUMBER
    `savings basic rate`                                IS A NUMBER
    `savings higher rate`                               IS A NUMBER
    `savings additional rate`                           IS A NUMBER

-- ss 55B-55C
DECLARE `Marriage allowance role` IS ONE OF
    `no election`
    `I elected to transfer my allowance`
    `my spouse or civil partner elected to transfer to me`

DECLARE `Taxpayer` HAS
    `rates`                                             IS A `Rates for the year`
    -- s 23 Step 2: the components of net income
    `non-savings income`                                IS A NUMBER
    `savings income`                                    IS A NUMBER
    `dividend income`                                   IS A NUMBER
    -- s 58 Step 2, s 415: Gift Aid donations as paid (net)
    `Gift Aid paid`                                     IS A NUMBER
    -- s 58 Step 3, s 10(6)(b): gross pension contributions under relief at
    -- source
    `gross pension contributions`                       IS A NUMBER
    `marriage allowance`                                IS A `Marriage allowance role`
