IMPORT prelude
IMPORT daydate
IMPORT `ita-types`
IMPORT `ita-rules`
IMPORT `ita-goal`

-- Income Tax Act 2007 (UK) — the encoder's tests. Expected values are worked
-- by hand from the Act, with rates of 20%, 40% and 45% (and the same savings
-- rates) as inputs.

§ `Tests`

rates MEANS `Rates for the year` OF 20, 40, 45, 20, 40, 45

-- Fields: rates, non-savings, savings, dividends, Gift Aid paid, gross
-- pension contributions, marriage allowance.
GIVEN ns IS A NUMBER, sv IS A NUMBER, dv IS A NUMBER
GIVETH A `Taxpayer`
`a taxpayer with` ns `,` sv `,` dv MEANS `Taxpayer` OF rates, ns, sv, dv, 0, 0, `no election`

§§ `Goal 1 — personal allowance`

#ASSERT `my personal allowance` (`a taxpayer with` 50000 `,` 0 `,` 0) EQUALS 12570
#ASSERT `my personal allowance` (`a taxpayer with` 110000 `,` 0 `,` 0) EQUALS 7570
#ASSERT `my personal allowance` (`a taxpayer with` 130000 `,` 0 `,` 0) EQUALS 0
#ASSERT `my personal allowance` (`a taxpayer with` 125140 `,` 0 `,` 0) EQUALS 0
-- s 35(3): £12,569.50 rounds up to £12,570; £12,568.50 to £12,569.
#ASSERT `my personal allowance` (`a taxpayer with` 100001 `,` 0 `,` 0) EQUALS 12570
#ASSERT `my personal allowance` (`a taxpayer with` 100003 `,` 0 `,` 0) EQUALS 12569
-- s 58: £8,000 of Gift Aid grosses up to £10,000.
#ASSERT `my adjusted net income` (`Taxpayer` OF rates, 110000, 0, 0, 8000, 0, `no election`) EQUALS 100000
#ASSERT `my personal allowance` (`Taxpayer` OF rates, 110000, 0, 0, 8000, 0, `no election`) EQUALS 12570
#ASSERT `the transferable amount` EQUALS 1260
#ASSERT `my personal allowance` (`Taxpayer` OF rates, 10000, 0, 0, 0, 0, `I elected to transfer my allowance`) EQUALS 11310

§§ `Goal 2 — income tax liability`

#ASSERT `my income tax liability` (`a taxpayer with` 50000 `,` 0 `,` 0) EQUALS 7486
#ASSERT `my income tax liability` (`a taxpayer with` 60000 `,` 0 `,` 0) EQUALS 11432
#ASSERT `my income tax liability` (`a taxpayer with` 110000 `,` 0 `,` 0) EQUALS 33432
#ASSERT `my income tax liability` (`a taxpayer with` 130000 `,` 0 `,` 0) EQUALS 44703
-- Savings: the starting rate and the savings allowance.
#ASSERT `my income tax liability` (`a taxpayer with` 10000 `,` 8000 `,` 0) EQUALS 0
#ASSERT `my savings at the starting rate` (`a taxpayer with` 10000 `,` 8000 `,` 0) EQUALS 5000
#ASSERT `my income tax liability` (`a taxpayer with` 15000 `,` 3000 `,` 0) EQUALS 486
#ASSERT `my savings at the starting rate` (`a taxpayer with` 15000 `,` 3000 `,` 0) EQUALS 2570
#ASSERT `my income tax liability` (`a taxpayer with` 45000 `,` 2000 `,` 0) EQUALS 6686
#ASSERT `my savings allowance` (`a taxpayer with` 45000 `,` 2000 `,` 0) EQUALS 1000
#ASSERT `my income tax liability` (`a taxpayer with` 60000 `,` 2000 `,` 0) EQUALS 12032
#ASSERT `my savings allowance` (`a taxpayer with` 60000 `,` 2000 `,` 0) EQUALS 500
#ASSERT `my savings allowance` (`a taxpayer with` 130000 `,` 1000 `,` 0) EQUALS 0
#ASSERT `my income tax liability` (`a taxpayer with` 130000 `,` 1000 `,` 0) EQUALS 45153
-- Dividends: the first £500 at nil, then 10.75% and 35.75%.
#ASSERT `my income tax liability` (`a taxpayer with` 40000 `,` 0 `,` 5000) EQUALS 5969.75
#ASSERT `my income tax liability` (`a taxpayer with` 48000 `,` 0 `,` 5000) EQUALS 8252.25
-- Gift Aid and pension contributions extend the basic rate band.
#ASSERT `my income tax liability` (`Taxpayer` OF rates, 60000, 0, 0, 8000, 0, `no election`) EQUALS 9486
#ASSERT `my income tax liability` (`Taxpayer` OF rates, 110000, 0, 0, 8000, 0, `no election`) EQUALS 29432
#ASSERT `my income tax liability` (`Taxpayer` OF rates, 60000, 0, 0, 0, 10000, `no election`) EQUALS 9486

§§ `Goal 3 — marriage allowance`

#ASSERT `I may elect to transfer my allowance` (`a taxpayer with` 10000 `,` 0 `,` 0)
#ASSERT NOT (`I may elect to transfer my allowance` (`a taxpayer with` 50000 `,` 0 `,` 0))
#ASSERT `I may elect to transfer my allowance` (`a taxpayer with` 40000 `,` 0 `,` 0)
#ASSERT `my marriage allowance reduction` (`Taxpayer` OF rates, 30000, 0, 0, 0, 0, `my spouse or civil partner elected to transfer to me`) EQUALS 252
#ASSERT `my income tax liability` (`Taxpayer` OF rates, 30000, 0, 0, 0, 0, `my spouse or civil partner elected to transfer to me`) EQUALS 3234
#ASSERT `my marriage allowance reduction` (`Taxpayer` OF rates, 60000, 0, 0, 0, 0, `my spouse or civil partner elected to transfer to me`) EQUALS 0
#ASSERT `my income tax liability` (`Taxpayer` OF rates, 12800, 0, 0, 0, 0, `my spouse or civil partner elected to transfer to me`) EQUALS 0
#ASSERT `my marriage allowance reduction` (`a taxpayer with` 30000 `,` 0 `,` 0) EQUALS 0

§§ `The top-level goal`

#ASSERT (`the taxpayer position for` (`a taxpayer with` 60000 `,` 2000 `,` 0))'s `adjusted net income` EQUALS 62000
#ASSERT (`the taxpayer position for` (`a taxpayer with` 60000 `,` 2000 `,` 0))'s `personal allowance` EQUALS 12570
#ASSERT (`the taxpayer position for` (`a taxpayer with` 60000 `,` 2000 `,` 0))'s `savings allowance` EQUALS 500
#ASSERT (`the taxpayer position for` (`a taxpayer with` 60000 `,` 2000 `,` 0))'s `income tax liability` EQUALS 12032
#ASSERT NOT ((`the taxpayer position for` (`a taxpayer with` 60000 `,` 2000 `,` 0))'s `I may elect to transfer my allowance`)
