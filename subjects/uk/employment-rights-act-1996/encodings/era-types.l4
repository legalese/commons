IMPORT prelude
IMPORT daydate

-- Employment Rights Act 1996 (UK) — THE NOUNS.
--
-- Facts a witness, a payslip or a tribunal's finding supplies. No rules here.
-- Source: ../registers/source-bundle/ukpga-1996-18.txt (revised text, point in
-- time 29 July 2026).

§ `Nouns`

-- s 211(1)(a): continuous employment "begins with the day on which the
-- employee starts work"; any s 211(3) postponement is already applied.
DECLARE `Employee` HAS
    `date of birth`                                     IS A DATE
    `continuous employment began on`                   IS A DATE
    -- A week's pay under Chapter II of Part XIV, before the s 227(1) cap.
    `a week's pay`                                      IS A NUMBER

-- ss 95(1), 136(1): how the contract ended.
DECLARE `How the contract ended` IS ONE OF
    `terminated by the employer`
    `terminated by the employee, entitled to do so without notice by the employer's conduct`
    `terminated by the employee otherwise`
    `a limited-term contract ended by the limiting event without renewal`

DECLARE `Termination` HAS
    `how it ended`                                      IS A `How the contract ended`
    -- The day notice to terminate was given; NOTHING when there was none.
    `notice given on`                                   IS A MAYBE DATE
    -- ss 97(1), 145(2): the day the notice expired, or the termination took
    -- effect.
    `ended on`                                          IS A DATE
    -- s 97(4)(b): the employee's material date fell during a period of notice
    -- given by the employer.
    `during the employer's notice`                      IS A BOOLEAN

-- s 207B(2): Day A, the day ACAS was contacted; Day B, the day the
-- certificate was received (or treated as received).
DECLARE `Early conciliation` HAS
    `Day A`                                             IS A DATE
    `Day B`                                             IS A DATE

-- The reason for the dismissal, as the tribunal finds it, so far as the basic
-- award turns on it (ss 120, 121).
DECLARE `Reason for dismissal` IS ONE OF
    `an ordinary reason`
    -- s 120(1): a reason in s 100(1)(a)-(b), 101A(d), 102(1) or 103.
    `a reason listed in s 120(1)`
    -- s 120(1C): regarded as unfairly dismissed by s 104F (blacklists).
    `a blacklist reason under s 104F`
    -- s 121: redundant, but not regarded as dismissed (s 138) or not entitled
    -- to a redundancy payment (s 141).
    `redundancy, within s 121`

DECLARE `Unfair dismissal facts` HAS
    -- s 108(2): dismissed because of a requirement or recommendation in
    -- s 64(2) (medical suspension).
    `dismissed for a s 64(2) requirement`               IS A BOOLEAN
    -- s 108(3)-(5): a reason for which no qualifying period is needed.
    `a reason needing no qualifying period`             IS A BOOLEAN
    `complaint presented on`                            IS A MAYBE DATE
    `early conciliation`                                IS A MAYBE `Early conciliation`
    -- s 111(2)(b): the tribunal is satisfied a timely complaint was not
    -- reasonably practicable and it came within a further reasonable period.
    `late complaint allowed`                            IS A BOOLEAN
    -- s 98 and the rest of Part X: the tribunal's finding.
    `found unfair`                                      IS A BOOLEAN
    `reason`                                            IS A `Reason for dismissal`
    -- s 122(1)-(3A): reductions the tribunal finds just and equitable.
    `just and equitable reductions`                     IS A NUMBER
    -- s 122(4): a redundancy payment awarded, or a payment made on the
    -- ground of redundancy, for the same dismissal.
    `redundancy payments for the same dismissal`        IS A NUMBER

DECLARE `Redundancy facts` HAS
    -- s 139(1); NOTHING when not proved either way (s 163(2)).
    `dismissed by reason of redundancy`                 IS A MAYBE BOOLEAN
    -- s 140(1): summary dismissal for conduct.
    `dismissed for conduct within s 140(1)`             IS A BOOLEAN
    -- s 141(2)-(4): unreasonably refused an offer of suitable renewal or
    -- re-engagement (or ended a trial period unreasonably).
    `unreasonably refused suitable employment`          IS A BOOLEAN
    -- Other exclusions (ss 157, 159-161), found as facts.
    `excluded otherwise`                                IS A BOOLEAN
    -- s 164(1)-(2): the steps, with their dates.
    `agreed and paid on`                                IS A MAYBE DATE
    `written claim given on`                            IS A MAYBE DATE
    `referred to a tribunal on`                         IS A MAYBE DATE
    `unfair dismissal complaint presented on`           IS A MAYBE DATE
    `early conciliation`                                IS A MAYBE `Early conciliation`
    `tribunal finds a late claim just and equitable`    IS A BOOLEAN
