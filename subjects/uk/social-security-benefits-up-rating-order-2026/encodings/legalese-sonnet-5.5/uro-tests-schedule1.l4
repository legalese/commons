IMPORT prelude
IMPORT daydate
IMPORT `uro-nouns`
IMPORT `uro-schedule1-contributions-act-rates`

-- Tests of uro-schedule1-contributions-act-rates (Schedule 1 to the Order). Every expected value is read by hand from
-- the cell of the table named in the comment (uksi-2026-148.txt, the line cited). None is copied from the
-- encoding's own output.

§ `Part I (src:463-466)`

#ASSERT `Sch 1 Part I: the weekly rate` `short-term incapacity benefit, lower rate` EQUALS 110.70
#ASSERT `Sch 1 Part I: the weekly rate` `short-term incapacity benefit, higher rate` EQUALS 130.90
#ASSERT `Sch 1 Part I: the weekly rate` `long-term incapacity benefit` EQUALS 146.60
#ASSERT `Sch 1 Part I: the weekly rate` `Category B retirement pension where section 48A(4) or 48AA(4) applies` EQUALS 110.75

§ `Part III (src:469-479)`

#ASSERT `Sch 1 Part III: the weekly rate` `attendance allowance, higher rate` EQUALS 114.60
#ASSERT `Sch 1 Part III: the weekly rate` `attendance allowance, lower rate` EQUALS 76.70
#ASSERT `Sch 1 Part III: the weekly rate` `severe disablement allowance` EQUALS 103.85
#ASSERT `Sch 1 Part III: the weekly rate` `age related addition, higher rate` EQUALS 15.50
#ASSERT `Sch 1 Part III: the weekly rate` `age related addition, middle rate` EQUALS 8.60
#ASSERT `Sch 1 Part III: the weekly rate` `age related addition, lower rate` EQUALS 8.60
#ASSERT `Sch 1 Part III: the weekly rate` `carer's allowance` EQUALS 86.45
#ASSERT `Sch 1 Part III: the weekly rate` `Category D retirement pension` EQUALS 110.75
-- item 8 prints 0.25 although art 3(2)(a) excepts age addition from the increase: the Schedule states the figure
#ASSERT `Sch 1 Part III: the weekly rate` `age addition (to a pension of any category, and otherwise under section 79)` EQUALS 0.25

§ `Part IV (src:483-487)`

#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with short-term incapacity benefit` `under pensionable age` EQUALS JUST 66.35
#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with short-term incapacity benefit` `over pensionable age` EQUALS JUST 82.00
-- exactly at pensionable age: neither "under" nor "over" on the words used
#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with short-term incapacity benefit` `at pensionable age` EQUALS NOTHING
#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with long-term incapacity benefit` `under pensionable age` EQUALS JUST 85.15
#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with long-term incapacity benefit` `over pensionable age` EQUALS JUST 85.15
#ASSERT `Sch 1 Part IV: the increase for an adult dependant` `increase for an adult dependant with severe disablement allowance` `under pensionable age` EQUALS JUST 51.05

§ `Part V item 1 -- the degrees of disablement (src:495-503)`

#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 100 EQUALS JUST 233.90
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 90 EQUALS JUST 210.51
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 80 EQUALS JUST 187.12
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 70 EQUALS JUST 163.73
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 60 EQUALS JUST 140.34
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 50 EQUALS JUST 116.95
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 40 EQUALS JUST 93.56
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 30 EQUALS JUST 70.17
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 20 EQUALS JUST 46.78
-- a degree the table does not print: not covered
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 10 EQUALS NOTHING
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 55 EQUALS NOTHING
#ASSERT `Sch 1 Part V item 1: the weekly rate of disablement pension for the degree of disablement` 101 EQUALS NOTHING

§ `Part V items 2 to 5 (src:504-508)`

#ASSERT `Sch 1 Part V item 2(a): the maximum increase of the weekly rate of disablement pension where constant attendance is needed, except in cases of exceptionally severe disablement` EQUALS 93.60
#ASSERT `Sch 1 Part V item 2(b): the maximum increase of the weekly rate of disablement pension where constant attendance is needed, in any case` EQUALS 187.20
-- where (a) applies the lower binds; where the disablement is exceptionally severe only (b) applies
#ASSERT `Sch 1 Part V item 2: the maximum increase of the weekly rate of disablement pension where constant attendance is needed` FALSE EQUALS 93.60
#ASSERT `Sch 1 Part V item 2: the maximum increase of the weekly rate of disablement pension where constant attendance is needed` TRUE EQUALS 187.20
#ASSERT `Sch 1 Part V item 3: the increase of the weekly rate of disablement pension for exceptionally severe disablement` EQUALS 93.60
#ASSERT `Sch 1 Part V item 4: the maximum of the aggregate of weekly benefit payable for successive accidents` EQUALS 233.90
#ASSERT `Sch 1 Part V item 5: the unemployability supplement under paragraph 2 of Schedule 7` EQUALS 144.65

§ `Part V item 6 -- the increase of the unemployability supplement (src:509-513)`

-- Arguments: age on the qualifying date; the qualifying date fell before 5th July 1948; had attained pensionable age
-- before 6th April 1979.
-- (a) under 35, or the qualifying date before 5th July 1948: 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 34 FALSE FALSE EQUALS 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 34 FALSE TRUE EQUALS 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 70 TRUE FALSE EQUALS 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 70 TRUE TRUE EQUALS 30.00
-- (b) under 40, not (a), and not pensionable age before 6th April 1979: 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 35 FALSE FALSE EQUALS 30.00
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 39 FALSE FALSE EQUALS 30.00
-- 39 and past pensionable age before 6th April 1979 is not (b); it falls to (c), under 45: 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 39 FALSE TRUE EQUALS 19.20
-- (c) under 45, not (a) or (b): 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 40 FALSE FALSE EQUALS 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 44 FALSE FALSE EQUALS 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 44 FALSE TRUE EQUALS 19.20
-- (d) under 50, not (a), (b) or (c), and not pensionable age before 6th April 1979: 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 45 FALSE FALSE EQUALS 19.20
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 49 FALSE FALSE EQUALS 19.20
-- (e) any other case: 9.60
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 45 FALSE TRUE EQUALS 9.60
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 49 FALSE TRUE EQUALS 9.60
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 50 FALSE FALSE EQUALS 9.60
#ASSERT `Sch 1 Part V item 6: the increase of the weekly rate of unemployability supplement` 65 FALSE TRUE EQUALS 9.60

§ `Part V items 7 to 12 (src:514-520)`

#ASSERT `Sch 1 Part V item 7: the increase under paragraph 4 of Schedule 7 of the weekly rate of disablement pension` EQUALS 11.35
#ASSERT `Sch 1 Part V item 8: the increase under paragraph 6 of Schedule 7 of the weekly rate of disablement pension` EQUALS 86.45
#ASSERT `Sch 1 Part V item 9: the maximum disablement gratuity under paragraph 9 of Schedule 7` EQUALS 15520.00
#ASSERT `Sch 1 Part V item 10(b): the widow's pension at the higher permanent rate` EQUALS 184.90
-- item 10(c): 30 per cent of the first sum specified in section 44(4), which is an input
#ASSERT `Sch 1 Part V item 10(c): the widow's pension at the lower permanent rate` 100 EQUALS 30
#ASSERT `Sch 1 Part V item 10(c): the widow's pension at the lower permanent rate` 184.90 EQUALS 55.47
#ASSERT `Sch 1 Part V item 10(c): the widow's pension at the lower permanent rate` 140.65 EQUALS 42.195
#ASSERT `Sch 1 Part V item 11: the widower's pension` EQUALS 184.90
#ASSERT `Sch 1 Part V item 12: the allowance in respect of each child or qualifying young person under paragraph 18 of Schedule 7` EQUALS 11.35

-- the single-figure dispatcher gives the same figures
#ASSERT `Sch 1 Part V: the single figure` `the increase of the weekly rate of disablement pension for exceptionally severe disablement` EQUALS 93.60
#ASSERT `Sch 1 Part V: the single figure` `the maximum of the aggregate of weekly benefit payable for successive accidents` EQUALS 233.90
#ASSERT `Sch 1 Part V: the single figure` `the unemployability supplement` EQUALS 144.65
#ASSERT `Sch 1 Part V: the single figure` `the increase of the weekly rate of disablement pension under paragraph 4 of Schedule 7` EQUALS 11.35
#ASSERT `Sch 1 Part V: the single figure` `the increase of the weekly rate of disablement pension under paragraph 6 of Schedule 7` EQUALS 86.45
#ASSERT `Sch 1 Part V: the single figure` `the maximum disablement gratuity` EQUALS 15520.00
#ASSERT `Sch 1 Part V: the single figure` `the widow's pension at the higher permanent rate` EQUALS 184.90
#ASSERT `Sch 1 Part V: the single figure` `the widower's pension` EQUALS 184.90
#ASSERT `Sch 1 Part V: the single figure` `the allowance in respect of each child or qualifying young person` EQUALS 11.35
