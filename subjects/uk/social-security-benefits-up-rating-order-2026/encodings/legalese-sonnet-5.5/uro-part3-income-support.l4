    WHEN `sub-paragraph (2)(b)(ii)` THEN `art 20(6)(d)(ii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(b)(ii)`
    WHEN `sub-paragraph (2)(b)(iii)` THEN `art 20(6)(d)(iii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(b)(iii)`
    WHEN `sub-paragraph (2)(c)(i)` THEN `art 20(6)(e)(i): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(c)(i)`
    WHEN `sub-paragraph (2)(c)(ii)` THEN `art 20(6)(e)(ii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(c)(ii)`
    WHEN `sub-paragraph (2)(c)(iii)` THEN `art 20(6)(e)(iii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(c)(iii)`
    WHEN `sub-paragraph (2)(d)(i)` THEN `art 20(6)(f)(i): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(d)(i)`
    WHEN `sub-paragraph (2)(d)(ii)` THEN `art 20(6)(f)(ii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(d)(ii)`
    WHEN `sub-paragraph (2)(d)(iii)` THEN `art 20(6)(f)(iii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(d)(iii)`
    WHEN `sub-paragraph (2)(e)(i)` THEN `art 20(6)(g)(i): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(e)(i)`
    WHEN `sub-paragraph (2)(e)(ii)` THEN `art 20(6)(g)(ii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(e)(ii)`
    WHEN `sub-paragraph (2)(e)(iii)` THEN `art 20(6)(g)(iii): paragraph 18 of Schedule 3 to the Income Support Regulations, sub-paragraph (2)(e)(iii)`


