    WHEN `sub-paragraph (2)(b)(ii)` THEN `art 30(7)(d)(ii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(b)(ii)`
    WHEN `sub-paragraph (2)(b)(iii)` THEN `art 30(7)(d)(iii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(b)(iii)`
    WHEN `sub-paragraph (2)(c)(i)` THEN `art 30(7)(e)(i): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(c)(i)`
    WHEN `sub-paragraph (2)(c)(ii)` THEN `art 30(7)(e)(ii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(c)(ii)`
    WHEN `sub-paragraph (2)(c)(iii)` THEN `art 30(7)(e)(iii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(c)(iii)`
    WHEN `sub-paragraph (2)(d)(i)` THEN `art 30(7)(f)(i): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(d)(i)`
    WHEN `sub-paragraph (2)(d)(ii)` THEN `art 30(7)(f)(ii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(d)(ii)`
    WHEN `sub-paragraph (2)(d)(iii)` THEN `art 30(7)(f)(iii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(d)(iii)`
    WHEN `sub-paragraph (2)(e)(i)` THEN `art 30(7)(g)(i): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(e)(i)`
    WHEN `sub-paragraph (2)(e)(ii)` THEN `art 30(7)(g)(ii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(e)(ii)`
    WHEN `sub-paragraph (2)(e)(iii)` THEN `art 30(7)(g)(iii): paragraph 19 of Schedule 6 to the ESA Regulations 2008, sub-paragraph (2)(e)(iii)`


