-- src:359 | (c) in paragraph (5)(a) for “£82.90” substitute “£86.05”;
@ref art 29(2)(c) (src:359)
`art 29(2)(c): regulation 6(5)(a) of the State Pension Credit Regulations, the amount of the guarantee credit` MEANS `a sum and its replacement` OF 82.90, 86.05

-- src:360 | (d) in paragraph (5)(b) for “£165.80” substitute “£172.10”; and
@ref art 29(2)(d) (src:360)
`art 29(2)(d): regulation 6(5)(b) of the State Pension Credit Regulations, the amount of the guarantee credit` MEANS `a sum and its replacement` OF 165.80, 172.10

-- src:361 | (e) in paragraph (8) for “£46.40” substitute “£48.15”.
@ref art 29(2)(e) (src:361)
`art 29(2)(e): regulation 6(8) of the State Pension Credit Regulations, the amount of the guarantee credit` MEANS `a sum and its replacement` OF 46.40, 48.15

@ref art 29(2) (src:356-361)
DECLARE `a sum in regulation 6 of the State Pension Credit Regulations` IS ONE OF
    `State Pension Credit regulation 6(1)(a)`
    `State Pension Credit regulation 6(1)(b)`
    `State Pension Credit regulation 6(5)(a)`
    `State Pension Credit regulation 6(5)(b)`
    `State Pension Credit regulation 6(8)`

@ref art 29(2) (src:356-361)
GIVEN `which one` IS A `a sum in regulation 6 of the State Pension Credit Regulations`
GIVETH A `a sum and its replacement`
`art 29(2): the replaced and the replacing sum` `which one` MEANS
    CONSIDER `which one`
    WHEN `State Pension Credit regulation 6(1)(a)` THEN `art 29(2)(a): regulation 6(1)(a) of the State Pension Credit Regulations, the amount of the guarantee credit`
    WHEN `State Pension Credit regulation 6(1)(b)` THEN `art 29(2)(b): regulation 6(1)(b) of the State Pension Credit Regulations, the amount of the guarantee credit`
    WHEN `State Pension Credit regulation 6(5)(a)` THEN `art 29(2)(c): regulation 6(5)(a) of the State Pension Credit Regulations, the amount of the guarantee credit`
    WHEN `State Pension Credit regulation 6(5)(b)` THEN `art 29(2)(d): regulation 6(5)(b) of the State Pension Credit Regulations, the amount of the guarantee credit`
    WHEN `State Pension Credit regulation 6(8)` THEN `art 29(2)(e): regulation 6(8) of the State Pension Credit Regulations, the amount of the guarantee credit`


