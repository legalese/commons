    WHEN `sub-paragraph (2)(a)` THEN `art 24(3)(c): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(a)`
    WHEN `sub-paragraph (2)(b)(i)` THEN `art 24(3)(d)(i): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(b)(i)`
    WHEN `sub-paragraph (2)(b)(ii)` THEN `art 24(3)(d)(ii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(b)(ii)`
    WHEN `sub-paragraph (2)(b)(iii)` THEN `art 24(3)(d)(iii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(b)(iii)`
    WHEN `sub-paragraph (2)(c)(i)` THEN `art 24(3)(e)(i): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(c)(i)`
    WHEN `sub-paragraph (2)(c)(ii)` THEN `art 24(3)(e)(ii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(c)(ii)`
    WHEN `sub-paragraph (2)(c)(iii)` THEN `art 24(3)(e)(iii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(c)(iii)`
    WHEN `sub-paragraph (2)(d)(i)` THEN `art 24(3)(f)(i): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(d)(i)`
    WHEN `sub-paragraph (2)(d)(ii)` THEN `art 24(3)(f)(ii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(d)(ii)`
    WHEN `sub-paragraph (2)(d)(iii)` THEN `art 24(3)(f)(iii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(d)(iii)`
    WHEN `sub-paragraph (2)(e)(i)` THEN `art 24(3)(g)(i): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(e)(i)`
    WHEN `sub-paragraph (2)(e)(ii)` THEN `art 24(3)(g)(ii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(e)(ii)`
    WHEN `sub-paragraph (2)(e)(iii)` THEN `art 24(3)(g)(iii): regulation 55 of the Housing Benefit (SPC) Regulations, sub-paragraph (2)(e)(iii)`


