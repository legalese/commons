#ASSERT `art 4(4)(a): the shared additional pension after the increase of 3.8 per cent` 200 EQUALS 207.6
#ASSERT `art 4(4)(b): the paragraph 2 of Schedule 5A increase after the increase of 3.8 per cent` 1000 EQUALS 1038

§ `Article 5 -- guaranteed minimum increases (src:84-86)`

-- (a) 3.8 per cent where attributable to earnings factors for 1987-88 and earlier; (b) 0.8 per cent for 1988-89 to
-- 1996-97 inclusive. The tax year is given by its first calendar year.
#ASSERT `art 5(a): the guaranteed minimum increase after the increase of 3.8 per cent` 1987 100 EQUALS JUST 103.8
#ASSERT `art 5(a): the guaranteed minimum increase after the increase of 3.8 per cent` 1975 100 EQUALS JUST 103.8
#ASSERT `art 5(a): the guaranteed minimum increase after the increase of 3.8 per cent` 1988 100 EQUALS NOTHING
#ASSERT `art 5(b): the guaranteed minimum increase after the increase of 0.8 per cent` 1988 100 EQUALS JUST 100.8
#ASSERT `art 5(b): the guaranteed minimum increase after the increase of 0.8 per cent` 1996 100 EQUALS JUST 100.8
#ASSERT `art 5(b): the guaranteed minimum increase after the increase of 0.8 per cent` 1987 100 EQUALS NOTHING
#ASSERT `art 5(b): the guaranteed minimum increase after the increase of 0.8 per cent` 1997 100 EQUALS NOTHING
#ASSERT `art 5: the guaranteed minimum increase after the increase` 1987 100 EQUALS JUST 103.8
#ASSERT `art 5: the guaranteed minimum increase after the increase` 1988 100 EQUALS JUST 100.8
#ASSERT `art 5: the guaranteed minimum increase after the increase` 1996 200 EQUALS JUST 201.6
-- 1997-98 and later: the Order says nothing
#ASSERT `art 5: the guaranteed minimum increase after the increase` 1997 100 EQUALS NOTHING

