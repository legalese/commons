IMPORT prelude
IMPORT daydate
IMPORT `uro-nouns`
IMPORT `uro-part1-intro`

-- Tests of uro-part1-intro: the title block, article 1 (extent, commencement, effect) and article 2.
-- Every expected value below is read by hand from the text (uksi-2026-148.txt); the line cited beside a group is
-- the line it comes from. None is copied from the encoding's own output.

§ `Title block (src:4)`

-- "Made 2nd March 2026"
#ASSERT `title block: the date on which the Order was made` EQUALS YMD 2026 3 2

§ `Article 1(3) -- the fixed dates (src:24, 28 to 31, 40)`

#ASSERT `art 1(3)(a): the date on which articles 1, 2 and 7 come into force` EQUALS YMD 2026 4 1
#ASSERT `art 1(3)(c): the date on which articles 4, 6, 10, 11, 12, 13, 14, 15, 18 and 19 come into force` EQUALS YMD 2026 4 6
-- (d): "at 00.01 on 6th April 2026": the date, and one minute after midnight
#ASSERT `art 1(3)(d): the date on which articles 5 and 8 come into force` EQUALS YMD 2026 4 6
#ASSERT `art 1(3)(d): the minutes after midnight at which articles 5 and 8 come into force` EQUALS 1
#ASSERT `art 1(3)(f): the date on which articles 16 and 17 come into force` EQUALS YMD 2026 4 9
#ASSERT `art 1(3)(o): the date on which article 34 comes into force` EQUALS YMD 2026 5 5

§ `Article 1(3)(b) and (e) -- one fact decides the date (src:25-27, 30)`

-- (b)(i) an increase to which art 7(9)(b) applies: 1st April 2026; (ii) all other purposes: 6th April 2026
#ASSERT `art 1(3)(b): the date on which article 3 comes into force` TRUE EQUALS YMD 2026 4 1
#ASSERT `art 1(3)(b): the date on which article 3 comes into force` FALSE EQUALS YMD 2026 4 6
-- (e): 5th April 2026, except for determining the rate of maternity allowance under s 35A(1): 6th April 2026
#ASSERT `art 1(3)(e): the date on which article 9 comes into force` FALSE EQUALS YMD 2026 4 5
#ASSERT `art 1(3)(e): the date on which article 9 comes into force` TRUE EQUALS YMD 2026 4 6

§ `Article 1(3)(h) -- rent (src:33)`

#ASSERT `art 1(3)(h): the date on which articles 23 and 24 come into force` TRUE EQUALS YMD 2026 4 6
#ASSERT `art 1(3)(h): the date on which articles 23 and 24 come into force` FALSE EQUALS YMD 2026 4 1

§ `Article 1(3)(g), (i) to (n) -- first day of the first benefit week or assessment period (src:32, 34 to 39)`

-- The boundary is 6th April 2026: the 5th cannot be the first day of a week that commences on or after the 6th.
#ASSERT `art 1(3)(g): the date on which articles 20, 21 and 22 come into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(g): the date on which articles 20, 21 and 22 come into force for the beneficiary` (YMD 2026 4 6) EQUALS JUST (YMD 2026 4 6)
#ASSERT `art 1(3)(g): the date on which articles 20, 21 and 22 come into force for the beneficiary` (YMD 2026 4 12) EQUALS JUST (YMD 2026 4 12)
#ASSERT `art 1(3)(i): the date on which articles 25, 26 and 27 come into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(i): the date on which articles 25, 26 and 27 come into force for the beneficiary` (YMD 2026 4 6) EQUALS JUST (YMD 2026 4 6)
#ASSERT `art 1(3)(j): the date on which article 28 comes into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(j): the date on which article 28 comes into force for the beneficiary` (YMD 2026 4 7) EQUALS JUST (YMD 2026 4 7)
#ASSERT `art 1(3)(k): the date on which article 29 comes into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(k): the date on which article 29 comes into force for the beneficiary` (YMD 2026 4 8) EQUALS JUST (YMD 2026 4 8)
#ASSERT `art 1(3)(l): the date on which article 30 comes into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(l): the date on which article 30 comes into force for the beneficiary` (YMD 2026 4 9) EQUALS JUST (YMD 2026 4 9)
#ASSERT `art 1(3)(m): the date on which article 31 comes into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(m): the date on which article 31 comes into force for the beneficiary` (YMD 2026 4 10) EQUALS JUST (YMD 2026 4 10)
#ASSERT `art 1(3)(n): the date on which articles 32 and 33 come into force for the beneficiary` (YMD 2026 4 5) EQUALS NOTHING
#ASSERT `art 1(3)(n): the date on which articles 32 and 33 come into force for the beneficiary` (YMD 2026 4 11) EQUALS JUST (YMD 2026 4 11)

§ `Article 1(4) -- universal credit and unearned income (src:41)`

-- Arguments: the article, a universal credit award is in force, the purpose is unearned income under that award,
-- the first day of the first assessment period on or after 6th April 2026.
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 3 TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 31 TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 9 TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
-- no award in force
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 3 FALSE TRUE (YMD 2026 4 20) EQUALS NOTHING
-- an award, but not for the purpose of unearned income
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 3 TRUE FALSE (YMD 2026 4 20) EQUALS NOTHING
-- articles not in the list in (4): 10, 14, 32
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 10 TRUE TRUE (YMD 2026 4 20) EQUALS NOTHING
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 14 TRUE TRUE (YMD 2026 4 20) EQUALS NOTHING
#ASSERT `art 1(4): the date on which the article comes into force for the beneficiary's unearned income under a universal credit award` 32 TRUE TRUE (YMD 2026 4 20) EQUALS NOTHING

§ `Article 1(3) and (4) together -- the date for each article, 1 to 34 (src:23 to 41)`

-- The plain case: no art 7(9)(b) increase, not the maternity allowance purpose, rent payable weekly, the first benefit
-- week begins 13th April 2026, no universal credit award, the first assessment period begins 20th April 2026.
GIVEN n IS A NUMBER
GIVETH A MAYBE DATE
`the plain case: the date for article` n MEANS
    `art 1(3) and (4): the date on which the article comes into force for the beneficiary` n FALSE FALSE TRUE (YMD 2026 4 13) FALSE FALSE (YMD 2026 4 20)

-- (a) articles 1, 2, 7
#ASSERT `the plain case: the date for article` 1 EQUALS JUST (YMD 2026 4 1)
#ASSERT `the plain case: the date for article` 2 EQUALS JUST (YMD 2026 4 1)
#ASSERT `the plain case: the date for article` 7 EQUALS JUST (YMD 2026 4 1)
-- (b) article 3
#ASSERT `the plain case: the date for article` 3 EQUALS JUST (YMD 2026 4 6)
-- (c) articles 4, 6, 10, 11, 12, 13, 14, 15, 18, 19
#ASSERT `the plain case: the date for article` 4 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 6 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 10 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 11 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 12 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 13 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 14 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 15 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 18 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 19 EQUALS JUST (YMD 2026 4 6)
-- (d) articles 5 and 8
#ASSERT `the plain case: the date for article` 5 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 8 EQUALS JUST (YMD 2026 4 6)
-- (e) article 9
#ASSERT `the plain case: the date for article` 9 EQUALS JUST (YMD 2026 4 5)
-- (f) articles 16 and 17
#ASSERT `the plain case: the date for article` 16 EQUALS JUST (YMD 2026 4 9)
#ASSERT `the plain case: the date for article` 17 EQUALS JUST (YMD 2026 4 9)
-- (g) articles 20, 21, 22: the beneficiary's first benefit week
#ASSERT `the plain case: the date for article` 20 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 21 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 22 EQUALS JUST (YMD 2026 4 13)
-- (h) articles 23 and 24: rent payable weekly
#ASSERT `the plain case: the date for article` 23 EQUALS JUST (YMD 2026 4 6)
#ASSERT `the plain case: the date for article` 24 EQUALS JUST (YMD 2026 4 6)
-- (i) articles 25, 26, 27; (j) 28; (k) 29; (l) 30; (m) 31
#ASSERT `the plain case: the date for article` 25 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 26 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 27 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 28 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 29 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 30 EQUALS JUST (YMD 2026 4 13)
#ASSERT `the plain case: the date for article` 31 EQUALS JUST (YMD 2026 4 13)
-- (n) articles 32 and 33: the first assessment period
#ASSERT `the plain case: the date for article` 32 EQUALS JUST (YMD 2026 4 20)
#ASSERT `the plain case: the date for article` 33 EQUALS JUST (YMD 2026 4 20)
-- (o) article 34
#ASSERT `the plain case: the date for article` 34 EQUALS JUST (YMD 2026 5 5)
-- there is no article 0 and no article 35: the text gives no date
#ASSERT `the plain case: the date for article` 0 EQUALS NOTHING
#ASSERT `the plain case: the date for article` 35 EQUALS NOTHING

-- the other branches, through the whole function
-- art 7(9)(b) increase: article 3 comes into force on 1st April 2026
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 3 TRUE FALSE TRUE (YMD 2026 4 13) FALSE FALSE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 1)
-- maternity allowance rate under s 35A(1): article 9 comes into force on 6th April 2026
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 9 FALSE TRUE TRUE (YMD 2026 4 13) FALSE FALSE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 6)
-- rent not payable weekly: articles 23 and 24 come into force on 1st April 2026
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 23 FALSE FALSE FALSE (YMD 2026 4 13) FALSE FALSE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 1)
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 24 FALSE FALSE FALSE (YMD 2026 4 13) FALSE FALSE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 1)
-- a benefit week that begins before 6th April 2026 is not the first week "on or after 6th April 2026"
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 20 FALSE FALSE TRUE (YMD 2026 4 5) FALSE FALSE (YMD 2026 4 20) EQUALS NOTHING
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 29 FALSE FALSE TRUE (YMD 2026 4 5) FALSE FALSE (YMD 2026 4 20) EQUALS NOTHING
-- a universal credit award in force, for unearned income: art 1(4) puts article 3, 4, 9, 28 and 31 on the assessment-period date
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 3 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 4 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 9 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 28 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 31 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 20)
-- the same award but another purpose: (4) does not apply and (3) governs
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 4 FALSE FALSE TRUE (YMD 2026 4 13) TRUE FALSE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 6)
-- article 10 is not in (4): even with a universal credit award and unearned income, (3)(c) governs
#ASSERT `art 1(3) and (4): the date on which the article comes into force for the beneficiary` 10 FALSE FALSE TRUE (YMD 2026 4 13) TRUE TRUE (YMD 2026 4 20) EQUALS JUST (YMD 2026 4 6)

