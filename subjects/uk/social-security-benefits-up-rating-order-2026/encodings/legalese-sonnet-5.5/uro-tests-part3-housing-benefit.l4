§ `Schedule 4 (1) -- single claimant (src:582-585)`

-- Arguments: the claimant is entitled to main phase ESA; the claimant's age.
#ASSERT `Sch 4 (1): the personal allowance of a single claimant` TRUE 40 EQUALS 95.55
-- (a) governs ahead of (c): entitled to main phase ESA although under 25
#ASSERT `Sch 4 (1): the personal allowance of a single claimant` TRUE 20 EQUALS 95.55
-- (b): not less than 25; both sides of the boundary
#ASSERT `Sch 4 (1): the personal allowance of a single claimant` FALSE 25 EQUALS 95.55
#ASSERT `Sch 4 (1): the personal allowance of a single claimant` FALSE 24 EQUALS 75.65
-- (c): less than 25
#ASSERT `Sch 4 (1): the personal allowance of a single claimant` FALSE 18 EQUALS 75.65

§ `Schedule 4 (2) -- lone parent (src:586-589)`

#ASSERT `Sch 4 (2): the personal allowance of a lone parent` TRUE 17 EQUALS 95.55
#ASSERT `Sch 4 (2): the personal allowance of a lone parent` FALSE 18 EQUALS 95.55
#ASSERT `Sch 4 (2): the personal allowance of a lone parent` FALSE 17 EQUALS 75.65

§ `Schedule 4 (3) -- couple (src:590-593)`

-- Arguments: the claimant is entitled to main phase ESA; the claimant's age; the partner's age.
#ASSERT `Sch 4 (3): the personal allowance of a couple` TRUE 17 17 EQUALS 150.15
#ASSERT `Sch 4 (3): the personal allowance of a couple` FALSE 18 17 EQUALS 150.15
#ASSERT `Sch 4 (3): the personal allowance of a couple` FALSE 17 18 EQUALS 150.15
#ASSERT `Sch 4 (3): the personal allowance of a couple` FALSE 17 17 EQUALS 114.35
#ASSERT `Sch 4 (3): the personal allowance of a couple` FALSE 50 50 EQUALS 150.15

§ `Schedule 5 -- premiums (src:597-613)`

#ASSERT `Sch 5 (5): the disability premium` `Housing Benefit paragraph 12(a) condition` EQUALS 44.85
#ASSERT `Sch 5 (5): the disability premium` `Housing Benefit paragraph 12(b) condition` EQUALS 64.00
#ASSERT `Sch 5 (6): the severe disability premium` `Housing Benefit paragraph 14(2)(a) condition` FALSE EQUALS 86.05
#ASSERT `Sch 5 (6): the severe disability premium` `Housing Benefit paragraph 14(2)(b) condition` TRUE EQUALS 86.05
#ASSERT `Sch 5 (6): the severe disability premium` `Housing Benefit paragraph 14(2)(b) condition` FALSE EQUALS 172.10
#ASSERT `Sch 5 (7): the disabled child premium` 1 EQUALS 84.46
#ASSERT `Sch 5 (7): the disabled child premium` 2 EQUALS 168.92
#ASSERT `Sch 5 (8): the carer premium` 1 EQUALS 48.15
#ASSERT `Sch 5 (8): the carer premium` 2 EQUALS 96.30
#ASSERT `Sch 5 (9)(a): the enhanced disability premium for children and young persons` 2 EQUALS 67.98
#ASSERT `Sch 5 (9)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` TRUE TRUE EQUALS JUST 22.00
#ASSERT `Sch 5 (9)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` FALSE TRUE EQUALS NOTHING
#ASSERT `Sch 5 (9)(c): the enhanced disability premium for a member of a couple or polygamous marriage` TRUE TRUE EQUALS JUST 31.40
#ASSERT `Sch 5 (9)(c): the enhanced disability premium for a member of a couple or polygamous marriage` TRUE FALSE EQUALS NOTHING

§ `Schedule 6 -- personal allowances under the Housing Benefit (SPC) Regulations (src:617-628)`

-- (1): arguments are "has attained pensionable age" and the date. Before 1st April 2021: 256.00; on or after: 238.00.
#ASSERT `Sch 6 (1): the personal allowance of a single claimant or lone parent` TRUE (YearMonthDay 2021 3 31) EQUALS JUST 256.00
#ASSERT `Sch 6 (1): the personal allowance of a single claimant or lone parent` TRUE (YearMonthDay 2021 4 1) EQUALS JUST 238.00
#ASSERT `Sch 6 (1): the personal allowance of a single claimant or lone parent` TRUE (YearMonthDay 2010 6 15) EQUALS JUST 256.00
#ASSERT `Sch 6 (1): the personal allowance of a single claimant or lone parent` TRUE (YearMonthDay 2025 11 2) EQUALS JUST 238.00
-- a claimant who has not attained pensionable age is in neither printed row (the printed rows are (b) and (c) only)
#ASSERT `Sch 6 (1): the personal allowance of a single claimant or lone parent` FALSE (YearMonthDay 2030 1 1) EQUALS NOTHING
-- (2): claimant attained?, claimant's date, partner attained?, partner's date.
-- (b): one member or both attained before 1st April 2021
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2021 3 31) TRUE (YearMonthDay 2021 3 31) EQUALS JUST 383.35
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2021 3 31) TRUE (YearMonthDay 2023 5 5) EQUALS JUST 383.35
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2023 5 5) TRUE (YearMonthDay 2021 3 31) EQUALS JUST 383.35
-- (c): both on or after 1st April 2021
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2021 4 1) TRUE (YearMonthDay 2023 5 5) EQUALS JUST 363.25
-- one member before 1st April 2021 and the other not yet at pensionable age is still (b)
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2021 3 31) FALSE (YearMonthDay 2035 1 1) EQUALS JUST 383.35
-- one member on or after 1st April 2021 and the other not yet at pensionable age: neither (b) nor (c)
#ASSERT `Sch 6 (2): the personal allowance of a couple` TRUE (YearMonthDay 2021 4 1) FALSE (YearMonthDay 2035 1 1) EQUALS NOTHING
-- (4) and (5): arguments are who, one or more attained before 1st April 2021, all attained on or after it.
#ASSERT `Sch 6 (4) and (5): the personal allowance in a polygamous marriage` `the claimant and the other party to the polygamous marriage` TRUE FALSE EQUALS JUST 383.35
#ASSERT `Sch 6 (4) and (5): the personal allowance in a polygamous marriage` `an additional spouse who is a member of the same household as the claimant` TRUE FALSE EQUALS JUST 127.35
#ASSERT `Sch 6 (4) and (5): the personal allowance in a polygamous marriage` `the claimant and the other party to the polygamous marriage` FALSE TRUE EQUALS JUST 363.25
#ASSERT `Sch 6 (4) and (5): the personal allowance in a polygamous marriage` `an additional spouse who is a member of the same household as the claimant` FALSE TRUE EQUALS JUST 125.25
-- neither description fits the marriage (some members have not attained pensionable age): not covered
#ASSERT `Sch 6 (4) and (5): the personal allowance in a polygamous marriage` `an additional spouse who is a member of the same household as the claimant` FALSE FALSE EQUALS NOTHING

