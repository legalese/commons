    WHEN `sub-paragraph (2)(b)(i)` THEN `art 26(7)(d)(i): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(b)(i)`
    WHEN `sub-paragraph (2)(b)(ii)` THEN `art 26(7)(d)(ii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(b)(ii)`
    WHEN `sub-paragraph (2)(b)(iii)` THEN `art 26(7)(d)(iii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(b)(iii)`
    WHEN `sub-paragraph (2)(c)(i)` THEN `art 26(7)(e)(i): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(c)(i)`
    WHEN `sub-paragraph (2)(c)(ii)` THEN `art 26(7)(e)(ii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(c)(ii)`
    WHEN `sub-paragraph (2)(c)(iii)` THEN `art 26(7)(e)(iii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(c)(iii)`
    WHEN `sub-paragraph (2)(d)(i)` THEN `art 26(7)(f)(i): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(d)(i)`
    WHEN `sub-paragraph (2)(d)(ii)` THEN `art 26(7)(f)(ii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(d)(ii)`
    WHEN `sub-paragraph (2)(d)(iii)` THEN `art 26(7)(f)(iii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(d)(iii)`
    WHEN `sub-paragraph (2)(e)(i)` THEN `art 26(7)(g)(i): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(e)(i)`
    WHEN `sub-paragraph (2)(e)(ii)` THEN `art 26(7)(g)(ii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(e)(ii)`
    WHEN `sub-paragraph (2)(e)(iii)` THEN `art 26(7)(g)(iii): paragraph 17 of Schedule 2 to the JSA Regulations 1996, sub-paragraph (2)(e)(iii)`


