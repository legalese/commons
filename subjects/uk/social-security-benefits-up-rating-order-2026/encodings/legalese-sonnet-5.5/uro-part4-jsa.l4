@ref Sch 8 (3) (src:658-692)
GIVEN `the claimant` IS A `a member of a couple claiming jobseeker's allowance`
      `the claimant's partner` IS A `a member of a couple claiming jobseeker's allowance`
      `the claimant and the partner are married or civil partners` IS A BOOLEAN
GIVETH A MAYBE NUMBER
`Sch 8 (3): the personal allowance of a couple` `the claimant` `the claimant's partner` `the claimant and the partner are married or civil partners` MEANS
    BRANCH
        IF `head (a)` THEN JUST 114.35
        IF `head (b)` THEN JUST 75.65
        IF `head (c)` THEN JUST 75.65
        IF `head (d)` THEN JUST 75.65
        IF `head (e)` THEN JUST 150.15
        IF `head (f)` THEN JUST 150.15
        IF `head (g)` THEN JUST 75.65
        IF `head (h)` THEN JUST 95.55
        OTHERWISE NOTHING
    WHERE
        `both members are aged less than 18` MEANS `the claimant`'s `the member's age` LESS THAN 18 AND `the claimant's partner`'s `the member's age` LESS THAN 18
        `head (a)` MEANS
                `both members are aged less than 18`
            AND (   `the claimant`'s `the member is treated as responsible for a child`
                 OR `the claimant's partner`'s `the member is treated as responsible for a child`   -- (i)
                 OR (    `the claimant`'s `regulation 59, 60 or 61 would apply to the member if they were not a member of a couple`
                     AND `the claimant's partner`'s `regulation 59, 60 or 61 would apply to the member if they were not a member of a couple`)   -- (ii)
                 OR (    `the claimant`'s `regulation 59, 60 or 61 would apply to the member if they were not a member of a couple`
                     AND `Sch 8 (3)(a)(iii), (vii): the member satisfies the requirements for entitlement to income support or an income-related employment and support allowance` `the claimant's partner`)   -- (iii)
                 OR (    `the claimant and the partner are married or civil partners`
                     AND (   (`the claimant`'s `regulation 59, 60 or 61 applies to the member` AND `the claimant's partner`'s `the member is registered in accordance with regulation 62`)
                          OR (`the claimant's partner`'s `regulation 59, 60 or 61 applies to the member` AND `the claimant`'s `the member is registered in accordance with regulation 62`)))   -- (iv)
                 OR (    `the claimant and the partner are married or civil partners`
                     AND `the claimant`'s `regulation 59, 60 or 61 applies to the member`
                     AND `the claimant's partner`'s `regulation 59, 60 or 61 applies to the member`)   -- (iva)
                 OR (    `the claimant`'s `a direction under section 16 is in force in respect of the member`
                     AND `the claimant's partner`'s `a direction under section 16 is in force in respect of the member`)   -- (v)
                 OR (    (`the claimant`'s `a direction under section 16 is in force in respect of the member` AND `the claimant's partner`'s `regulation 59, 60 or 61 applies to the member`)
                      OR (`the claimant's partner`'s `a direction under section 16 is in force in respect of the member` AND `the claimant`'s `regulation 59, 60 or 61 applies to the member`))   -- (vi)
                 OR (    (`the claimant`'s `a direction under section 16 is in force in respect of the member` AND `Sch 8 (3)(a)(iii), (vii): the member satisfies the requirements for entitlement to income support or an income-related employment and support allowance` `the claimant's partner`)
                      OR (`the claimant's partner`'s `a direction under section 16 is in force in respect of the member` AND `Sch 8 (3)(a)(iii), (vii): the member satisfies the requirements for entitlement to income support or an income-related employment and support allowance` `the claimant`)))   -- (vii)
        `head (b)` MEANS
                `both members are aged less than 18`
            AND (NOT `head (a)`)
            AND (   (    `the claimant`'s `the member falls within paragraph (2) of regulation 57`
                     AND (`the claimant`'s `regulation 59, 60 or 61 applies to the member` OR `the claimant`'s `a direction under section 16 is in force in respect of the member`))
                 OR (    `the claimant's partner`'s `the member falls within paragraph (2) of regulation 57`
                     AND (`the claimant's partner`'s `regulation 59, 60 or 61 applies to the member` OR `the claimant's partner`'s `a direction under section 16 is in force in respect of the member`)))
        `head (c)` MEANS
                `both members are aged less than 18`
            AND (NOT `head (a)`)
            AND (NOT `head (b)`)
            AND (   `the claimant`'s `regulation 59, 60 or 61 applies to the member`
                 OR `the claimant`'s `a direction under section 16 is in force in respect of the member`
                 OR `the claimant's partner`'s `regulation 59, 60 or 61 applies to the member`
                 OR `the claimant's partner`'s `a direction under section 16 is in force in respect of the member`)
        `head (d)` MEANS
                `both members are aged less than 18`
            AND (NOT `head (a)`)
            AND (NOT `head (b)`)
            AND (NOT `head (c)`)
            AND (   `the claimant`'s `the member satisfies the requirements of paragraph 13(1)(a)`
                 OR `the claimant's partner`'s `the member satisfies the requirements of paragraph 13(1)(a)`)
        `head (e)` MEANS
                (`the claimant`'s `the member's age` AT LEAST 18 AND `the claimant's partner`'s `the member's age` AT LEAST 18)   -- (i)
            OR  (    `the claimant`'s `the member's age` AT LEAST 18
                 AND `the claimant's partner`'s `the member's age` LESS THAN 18
                 AND `the claimant's partner`'s `the member is treated as responsible for a child`)   -- (ii)
            OR  (    `the claimant's partner`'s `the member's age` AT LEAST 18
                 AND `the claimant`'s `the member's age` LESS THAN 18
                 AND `the claimant`'s `the member is treated as responsible for a child`)
        `head (f)` MEANS
                (NOT `head (e)`)
            AND (   (`the claimant`'s `the member's age` AT LEAST 18 AND `Sch 8 (3)(f): the member is a person under 18 who is described in (f)(i) to (iv)` `the claimant's partner`)
                 OR (`the claimant's partner`'s `the member's age` AT LEAST 18 AND `Sch 8 (3)(f): the member is a person under 18 who is described in (f)(i) to (iv)` `the claimant`))
        `head (g)` MEANS
                (    `the claimant`'s `the member's age` AT LEAST 18
                 AND `the claimant`'s `the member's age` LESS THAN 25
                 AND `Sch 8 (3)(g), (h): the member is a person under 18 who is described in (i) to (iii)` `the claimant's partner`)
            OR  (    `the claimant's partner`'s `the member's age` AT LEAST 18
                 AND `the claimant's partner`'s `the member's age` LESS THAN 25
                 AND `Sch 8 (3)(g), (h): the member is a person under 18 who is described in (i) to (iii)` `the claimant`)
        `head (h)` MEANS
                (    `the claimant`'s `the member's age` AT LEAST 25
                 AND `Sch 8 (3)(g), (h): the member is a person under 18 who is described in (i) to (iii)` `the claimant's partner`)
            OR  (    `the claimant's partner`'s `the member's age` AT LEAST 25
                 AND `Sch 8 (3)(g), (h): the member is a person under 18 who is described in (i) to (iii)` `the claimant`)

