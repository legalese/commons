IMPORT prelude
IMPORT daydate
IMPORT `uro-nouns`
IMPORT `uro-part4-jsa`

-- Tests of uro-part4-jsa (arts 25 to 28, Schedules 8 to 10 to the Order). Every expected figure is read by hand from the
-- line of the text cited beside it (uksi-2026-148.txt). The art 26(7) non-dependant deductions are tested in
-- uro-tests-non-dependant-deductions.l4.

GIVEN old IS A NUMBER
      new IS A NUMBER
GIVETH A `a sum and its replacement`
`the pair of sums in the jsa tests` old new MEANS `a sum and its replacement` OF old, new

-- Members of a couple for the Schedule 8 (3) tests. Each helper below builds a member of the given age with exactly the
-- fact named true and every other fact false. (The record's fields run: age; reg 59/60/61 applies; would apply if not a
-- couple; registered under reg 62; falls within reg 57(2); s 16 direction; satisfies income support requirements; would
-- satisfy them if not a couple; satisfies income-related ESA requirements; satisfies para 13(1)(a); treated as
-- responsible for a child. The helpers were written by a throwaway script so that the positions cannot slip.)

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a plain member aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member under reg 59-61 aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member who would be under reg 59-61 but for the couple, aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member registered under reg 62 aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member within reg 57(2) aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member under a s 16 direction aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member meeting income support requirements aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member who would meet income support requirements but for the couple, aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member meeting income-related ESA requirements aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member meeting para 13(1)(a) aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member responsible for a child aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE

GIVEN age IS A NUMBER
GIVETH A `a member of a couple claiming jobseeker's allowance`
`a member within reg 57(2) and under reg 59-61 aged` age MEANS `a member of a couple claiming jobseeker's allowance` OF age, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

§ `Article 25 -- contribution-based jobseeker's allowance (src:311-312)`

#ASSERT `art 25: the replaced and the replacing sum` `JSA 1996 regulation 79(1)(a)` EQUALS `the pair of sums in the jsa tests` 72.90 75.65
#ASSERT `art 25: the replaced and the replacing sum` `JSA 1996 regulation 79(1)(c)` EQUALS `the pair of sums in the jsa tests` 92.05 95.55

§ `Article 26 (src:318, 321, 323-324)`

#ASSERT `art 26(2): regulations 83(b), 84(1)(c) and 85(1) and paragraphs 15A(2)(a) and 16(2)(a) of Part III of Schedule 1 to the JSA Regulations 1996, the sum specified in each case` EQUALS `the pair of sums in the jsa tests` 3000 3000
#ASSERT `art 26(3)(b): paragraph 2(1) of Part 1 of Schedule 1 to the JSA Regulations 1996, sub-paragraphs (a) and (b) of column (2) of the table` EQUALS `the pair of sums in the jsa tests` 84.66 87.88
#ASSERT `art 26(4): the replaced and the replacing sum` `JSA 1996 family premium paragraph 4(1)(a)` EQUALS `the pair of sums in the jsa tests` 19.48 20.22
#ASSERT `art 26(4): the replaced and the replacing sum` `JSA 1996 family premium paragraph 4(1)(b)` EQUALS `the pair of sums in the jsa tests` 19.48 20.22

§ `Articles 27 and 28 (src:348, 351-352)`

#ASSERT `art 27: regulation 172 of the JSA Regulations 1996, the prescribed sum (trade disputes)` EQUALS `the pair of sums in the jsa tests` 51.00 53.00
#ASSERT `art 28: the replaced and the replacing sum` `JSA 2013 regulation 49(1)(a)` EQUALS `the pair of sums in the jsa tests` 72.90 75.65
#ASSERT `art 28: the replaced and the replacing sum` `JSA 2013 regulation 49(1)(b)` EQUALS `the pair of sums in the jsa tests` 92.05 95.55

§ `Schedule 8 (1) -- single claimant (src:643-650)`

-- Arguments: age; falls within paragraph (2) of regulation 57; regulation 59, 60 or 61 applies; s 16 direction; paragraph 13(1)(a).
-- (a): under 18, neither (b) nor (c)
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 17 FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (b): under 18, within reg 57(2), and (i) reg 59-61 applies or (ii) a s 16 direction
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 17 TRUE TRUE FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 17 TRUE FALSE TRUE FALSE EQUALS JUST 75.65
-- (c): under 18 and paragraph 13(1)(a)
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 17 FALSE FALSE FALSE TRUE EQUALS JUST 75.65
-- (d): 18 to 24, both ends
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 18 FALSE FALSE FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 24 FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (e): 25 or over
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 25 FALSE FALSE FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 8 (1): the personal allowance of a single claimant` 25 TRUE TRUE TRUE TRUE EQUALS JUST 95.55

§ `Schedule 8 (2) -- lone parent (src:651-657)`

#ASSERT `Sch 8 (2): the personal allowance of a lone parent` 17 FALSE FALSE FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (2): the personal allowance of a lone parent` 17 TRUE TRUE FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (2): the personal allowance of a lone parent` 17 FALSE FALSE FALSE TRUE EQUALS JUST 75.65
-- (d): not less than 18
#ASSERT `Sch 8 (2): the personal allowance of a lone parent` 18 FALSE FALSE FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 8 (2): the personal allowance of a lone parent` 40 FALSE FALSE FALSE FALSE EQUALS JUST 95.55

§ `Schedule 8 (3) -- couple (src:658-692)`

-- Arguments: the claimant; the partner; they are married or civil partners.
-- (a)(i): both under 18, at least one treated as responsible for a child
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member responsible for a child aged` 17) (`a plain member aged` 17) FALSE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 17) (`a member responsible for a child aged` 17) FALSE EQUALS JUST 114.35
-- (a)(ii): each would have been under reg 59-61 were they not a couple
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member who would be under reg 59-61 but for the couple, aged` 17) (`a member who would be under reg 59-61 but for the couple, aged` 17) FALSE EQUALS JUST 114.35
-- only the claimant would: not (a)(ii), and nothing else reaches the couple
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member who would be under reg 59-61 but for the couple, aged` 17) (`a plain member aged` 17) FALSE EQUALS NOTHING
-- (a)(iii): the claimant would have been, and the partner satisfies the income support or ESA requirements
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member who would be under reg 59-61 but for the couple, aged` 17) (`a member meeting income support requirements aged` 17) FALSE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member who would be under reg 59-61 but for the couple, aged` 17) (`a member meeting income-related ESA requirements aged` 17) FALSE EQUALS JUST 114.35
-- the roles reversed (the partner would have been, the claimant satisfies) is not (a)(iii) as printed
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member meeting income support requirements aged` 17) (`a member who would be under reg 59-61 but for the couple, aged` 17) FALSE EQUALS NOTHING
-- (a)(iv): married or civil partners, one under reg 59-61 and the other registered under reg 62; either way round
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a member registered under reg 62 aged` 17) TRUE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member registered under reg 62 aged` 17) (`a member under reg 59-61 aged` 17) TRUE EQUALS JUST 114.35
-- not married: (a)(iv) fails, and head (c) (one member under reg 59-61) gives 75.65
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a member registered under reg 62 aged` 17) FALSE EQUALS JUST 75.65
-- (a)(iva): married or civil partners, each under reg 59-61
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a member under reg 59-61 aged` 17) TRUE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a member under reg 59-61 aged` 17) FALSE EQUALS JUST 75.65
-- (a)(v): a s 16 direction for each member
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under a s 16 direction aged` 17) (`a member under a s 16 direction aged` 17) FALSE EQUALS JUST 114.35
-- (a)(vi): a direction for one and the other under reg 59-61
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under a s 16 direction aged` 17) (`a member under reg 59-61 aged` 17) FALSE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a member under a s 16 direction aged` 17) FALSE EQUALS JUST 114.35
-- (a)(vii): a direction for one and the other satisfies the income support or ESA requirements
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under a s 16 direction aged` 17) (`a member meeting income support requirements aged` 17) FALSE EQUALS JUST 114.35
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member meeting income-related ESA requirements aged` 17) (`a member under a s 16 direction aged` 17) FALSE EQUALS JUST 114.35
-- (b): both under 18, (a) does not apply, one member within reg 57(2) and under reg 59-61 or a direction
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member within reg 57(2) and under reg 59-61 aged` 17) (`a plain member aged` 16) FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 16) (`a member within reg 57(2) and under reg 59-61 aged` 17) FALSE EQUALS JUST 75.65
-- (c): both under 18, one member under reg 59-61 or a direction
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a plain member aged` 17) FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 17) (`a member under a s 16 direction aged` 17) FALSE EQUALS JUST 75.65
-- (d): both under 18, one member satisfies paragraph 13(1)(a)
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member meeting para 13(1)(a) aged` 17) (`a plain member aged` 17) FALSE EQUALS JUST 75.65
-- both under 18 and no head reaches them
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 17) (`a plain member aged` 17) FALSE EQUALS NOTHING
-- (e)(i): both aged not less than 18
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 18) (`a plain member aged` 18) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 18) (`a plain member aged` 65) FALSE EQUALS JUST 150.15
-- (e)(ii): one 18 or over, the other under 18 and treated as responsible for a child; either way round
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member responsible for a child aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member responsible for a child aged` 17) (`a plain member aged` 20) FALSE EQUALS JUST 150.15
-- (f): (e) does not apply, one member 18 or over and the other under 18 within (i), (ii), (iii) or (iv)
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member under reg 59-61 aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member under a s 16 direction aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member meeting income support requirements aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member who would meet income support requirements but for the couple, aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 20) (`a member meeting income-related ESA requirements aged` 17) FALSE EQUALS JUST 150.15
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a member under reg 59-61 aged` 17) (`a plain member aged` 60) FALSE EQUALS JUST 150.15
-- (g): one member 18 to 24, the other under 18 and within none of them
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 18) (`a plain member aged` 17) FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 24) (`a plain member aged` 17) FALSE EQUALS JUST 75.65
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 16) (`a plain member aged` 24) FALSE EQUALS JUST 75.65
-- (h): one member 25 or over, the other under 18 and within none of them
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 25) (`a plain member aged` 17) FALSE EQUALS JUST 95.55
#ASSERT `Sch 8 (3): the personal allowance of a couple` (`a plain member aged` 17) (`a plain member aged` 70) FALSE EQUALS JUST 95.55

§ `Schedule 9 -- premiums (src:696-720)`

#ASSERT `Sch 9 (2): the pensioner premium for persons who have attained the qualifying age for state pension credit` `JSA paragraph 10(a) condition` EQUALS 142.45
#ASSERT `Sch 9 (2): the pensioner premium for persons who have attained the qualifying age for state pension credit` `JSA paragraph 10(b) condition` EQUALS 213.10
#ASSERT `Sch 9 (2): the pensioner premium for persons who have attained the qualifying age for state pension credit` `JSA paragraph 10(c) condition` EQUALS 213.10
#ASSERT `Sch 9 (3): the pensioner premium for claimants whose partner has attained the age of 75` TRUE EQUALS JUST 213.10
#ASSERT `Sch 9 (3): the pensioner premium for claimants whose partner has attained the age of 75` FALSE EQUALS NOTHING
#ASSERT `Sch 9 (4): the higher pensioner premium` `JSA paragraph 12(1)(a) condition` EQUALS 142.45
#ASSERT `Sch 9 (4): the higher pensioner premium` `JSA paragraph 12(1)(b) or (c) condition` EQUALS 213.10
#ASSERT `Sch 9 (5): the disability premium` `JSA paragraph 13(1)(a) condition` EQUALS 44.85
#ASSERT `Sch 9 (5): the disability premium` `JSA paragraph 13(1)(b) or (c) condition` EQUALS 64.00
#ASSERT `Sch 9 (6): the severe disability premium` `JSA paragraph 15(1) condition` FALSE EQUALS 86.05
#ASSERT `Sch 9 (6): the severe disability premium` `JSA paragraph 15(2) condition` TRUE EQUALS 86.05
#ASSERT `Sch 9 (6): the severe disability premium` `JSA paragraph 15(2) condition` FALSE EQUALS 172.10
#ASSERT `Sch 9 (7): the disabled child premium` 2 EQUALS 168.92
#ASSERT `Sch 9 (8): the carer premium` 2 EQUALS 96.30
#ASSERT `Sch 9 (9)(a): the enhanced disability premium for children and young persons` 1 EQUALS 33.99
#ASSERT `Sch 9 (9)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` TRUE TRUE EQUALS JUST 22.00
#ASSERT `Sch 9 (9)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` TRUE FALSE EQUALS NOTHING
#ASSERT `Sch 9 (9)(c): the enhanced disability premium for a member of a couple or polygamous marriage` TRUE TRUE EQUALS JUST 31.40
#ASSERT `Sch 9 (9)(c): the enhanced disability premium for a member of a couple or polygamous marriage` FALSE TRUE EQUALS NOTHING

§ `Schedule 10 -- premiums for joint-claim couples (src:724-731)`

#ASSERT `Sch 10 (1): the pensioner premium for a joint-claim couple` TRUE EQUALS JUST 213.10
#ASSERT `Sch 10 (1): the pensioner premium for a joint-claim couple` FALSE EQUALS NOTHING
#ASSERT `Sch 10 (2): the higher pensioner premium for a joint-claim couple` TRUE EQUALS JUST 213.10
#ASSERT `Sch 10 (2): the higher pensioner premium for a joint-claim couple` FALSE EQUALS NOTHING
#ASSERT `Sch 10 (3): the disability premium for a joint-claim couple` TRUE EQUALS JUST 64.00
#ASSERT `Sch 10 (3): the disability premium for a joint-claim couple` FALSE EQUALS NOTHING
-- (4): the condition in paragraph 20I(1); then (i) 86.05 or (ii) 172.10
#ASSERT `Sch 10 (4): the severe disability premium for a joint-claim couple` TRUE TRUE EQUALS JUST 86.05
#ASSERT `Sch 10 (4): the severe disability premium for a joint-claim couple` TRUE FALSE EQUALS JUST 172.10
#ASSERT `Sch 10 (4): the severe disability premium for a joint-claim couple` FALSE TRUE EQUALS NOTHING
#ASSERT `Sch 10 (4): the severe disability premium for a joint-claim couple` FALSE FALSE EQUALS NOTHING
#ASSERT `Sch 10 (5): the carer premium for a joint-claim couple` 2 EQUALS 96.30
#ASSERT `Sch 10 (6): the enhanced disability premium for a joint-claim couple` TRUE EQUALS JUST 31.40
#ASSERT `Sch 10 (6): the enhanced disability premium for a joint-claim couple` FALSE EQUALS NOTHING
