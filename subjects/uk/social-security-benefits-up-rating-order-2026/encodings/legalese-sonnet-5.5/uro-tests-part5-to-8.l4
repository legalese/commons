§ `Schedule 13 -- Universal Credit elements (src:768-777)`

-- the child element: the first child 351.88, the second and each subsequent 303.94
#ASSERT `Sch 13: the child element for the child or qualifying young person` 1 EQUALS JUST 351.88
#ASSERT `Sch 13: the child element for the child or qualifying young person` 2 EQUALS JUST 303.94
#ASSERT `Sch 13: the child element for the child or qualifying young person` 5 EQUALS JUST 303.94
#ASSERT `Sch 13: the child element for the child or qualifying young person` 0 EQUALS NOTHING
#ASSERT `Sch 13: the child element for the child or qualifying young person` 1.5 EQUALS NOTHING
#ASSERT `Sch 13: the additional amount for a disabled child or qualifying young person` `the lower rate of the additional amount for a disabled child or qualifying young person` EQUALS 164.79
#ASSERT `Sch 13: the additional amount for a disabled child or qualifying young person` `the higher rate of the additional amount for a disabled child or qualifying young person` EQUALS 514.71
#ASSERT `Sch 13: the carer element` EQUALS 209.34
-- the childcare costs element: maximum for one child 1,071.09; for two or more children 1,836.16
#ASSERT `Sch 13: the maximum amount of the childcare costs element` 1 EQUALS JUST 1071.09
#ASSERT `Sch 13: the maximum amount of the childcare costs element` 2 EQUALS JUST 1836.16
#ASSERT `Sch 13: the maximum amount of the childcare costs element` 4 EQUALS JUST 1836.16
#ASSERT `Sch 13: the maximum amount of the childcare costs element` 0 EQUALS NOTHING

§ `Article 34 -- revocation of the 2025 Order (src:456-457, and art 1(3)(o) at line 40)`

-- article 34 comes into force on 5th May 2026
#ASSERT NOT (`art 34: the Social Security Benefits Up-rating Order 2025 has been revoked on the date` (YearMonthDay 2026 5 4))
#ASSERT `art 34: the Social Security Benefits Up-rating Order 2025 has been revoked on the date` (YearMonthDay 2026 5 5)
#ASSERT `art 34: the Social Security Benefits Up-rating Order 2025 has been revoked on the date` (YearMonthDay 2026 12 31)
#ASSERT NOT (`art 34: the Social Security Benefits Up-rating Order 2025 has been revoked on the date` (YearMonthDay 2026 4 6))
