IMPORT prelude
IMPORT daydate
IMPORT `uro-nouns`
IMPORT `uro-part3-income-support`

-- Tests of uro-part3-income-support (arts 20 to 22, Schedules 2 and 3 to the Order). Every expected figure is read by
-- hand from the line of the text cited beside it (uksi-2026-148.txt). The art 20(6) non-dependant deductions are tested in
-- uro-tests-non-dependant-deductions.l4.

GIVEN old IS A NUMBER
      new IS A NUMBER
GIVETH A `a sum and its replacement`
`the pair of sums in the income support tests` old new MEANS `a sum and its replacement` OF old, new

§ `Article 20(2) -- the sum of 3,000 that remains unchanged (src:184-187)`

#ASSERT `art 20(2): regulations 17(1)(b), 18(1)(c) and 21(1) and paragraphs 13A(2)(a) and 14(2)(a) of Part III of Schedule 2 to the Income Support Regulations, the sum specified in each case` EQUALS `the pair of sums in the income support tests` 3000 3000

§ `Article 20(3)(b) -- paragraph 2(1) of Part I of Schedule 2 (src:190)`

#ASSERT `art 20(3)(b): paragraph 2(1) of Part I of Schedule 2 to the Income Support Regulations, sub-paragraphs (a) and (b) of column (2) of the table` EQUALS `the pair of sums in the income support tests` 84.66 87.88

§ `Article 20(4) -- family premium (src:192-193)`

#ASSERT `art 20(4): the replaced and the replacing sum` `Income Support family premium paragraph 3(1)(a)` EQUALS `the pair of sums in the income support tests` 19.48 20.22
#ASSERT `art 20(4): the replaced and the replacing sum` `Income Support family premium paragraph 3(1)(b)` EQUALS `the pair of sums in the income support tests` 19.48 20.22

§ `Article 21 -- special transitional additions increase by 3.8 per cent (src:216)`

#ASSERT `art 21: the special transitional addition after the increase of 3.8 per cent` 100 EQUALS 103.8
#ASSERT `art 21: the special transitional addition after the increase of 3.8 per cent` 0 EQUALS 0
#ASSERT `art 21: the special transitional addition after the increase of 3.8 per cent` 20.50 EQUALS 21.279

§ `Article 22 -- the relevant sum in section 126(7) (src:218)`

#ASSERT `art 22: section 126(7) of the Contributions and Benefits Act, the relevant sum (trade disputes)` EQUALS `the pair of sums in the income support tests` 51.00 53.00

§ `Schedule 2 (1) -- single claimant (src:524-529)`

-- Arguments: the claimant's age; falls within a circumstance in paragraph 1A; satisfies the condition in paragraph 11(1)(a).
-- (a): under 18, and neither (b) nor (c) applies
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 17 FALSE FALSE EQUALS JUST 75.65
-- (b): under 18 and within paragraph 1A
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 17 TRUE FALSE EQUALS JUST 75.65
-- (c): under 18 and satisfying paragraph 11(1)(a)
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 17 FALSE TRUE EQUALS JUST 75.65
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 16 TRUE TRUE EQUALS JUST 75.65
-- (d): not less than 18 but less than 25: both ends of the band
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 18 FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 24 FALSE FALSE EQUALS JUST 75.65
-- (e): not less than 25
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 25 FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 60 FALSE FALSE EQUALS JUST 95.55
-- the conditions in (b) and (c) do not matter once the claimant is 18 or over
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 25 TRUE TRUE EQUALS JUST 95.55
#ASSERT `Sch 2 (1): the personal allowance of a single claimant` 18 TRUE TRUE EQUALS JUST 75.65

§ `Schedule 2 (2) -- lone parent (src:530-534)`

#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 17 FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 17 TRUE FALSE EQUALS JUST 75.65
#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 17 FALSE TRUE EQUALS JUST 75.65
-- (d): not less than 18
#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 18 FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 24 FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 2 (2): the personal allowance of a lone parent` 25 FALSE FALSE EQUALS JUST 95.55

§ `Schedule 2 (3) -- couple (src:535-555)`

-- Arguments, in order: the claimant's age; the partner's age; at least one is treated as responsible for a child;
-- the claimant qualifies under reg 4ZA or income-related ESA (or would if not a couple); the partner likewise;
-- the claimant satisfies s 3(1)(f)(iii); the partner likewise; a s 16 direction is in force for the claimant; for the
-- partner; one member falls within a circumstance in paragraph 1A.
-- (a)(i): both under 18, one treated as responsible for a child
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 114.35
-- (a)(ii): both under 18, each would have qualified were they not a couple
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 114.35
-- only one would have qualified: not (a)(ii); falls to (c)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (a)(iii): the partner satisfies section 3(1)(f)(iii)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST 114.35
-- the claimant alone satisfying it is not (a)(iii)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (a)(iv): a section 16 direction in force for the partner
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST 114.35
-- a direction for the claimant alone is not (a)(iv)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST 75.65
-- (b): both under 18, (a) does not apply, one member within paragraph 1A
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 17 FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST 75.65
-- (c): both under 18, neither (a) nor (b)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 16 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (d): both aged not less than 18; the boundary is 18
#ASSERT `Sch 2 (3): the personal allowance of a couple` 18 18 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 150.15
#ASSERT `Sch 2 (3): the personal allowance of a couple` 40 63 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 150.15
-- (e): one member 18 or over, the other under 18 and within (i), (ii) or (iii)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 30 17 FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 150.15
#ASSERT `Sch 2 (3): the personal allowance of a couple` 30 17 FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST 150.15
#ASSERT `Sch 2 (3): the personal allowance of a couple` 30 17 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST 150.15
-- (e) the other way round: the claimant is the one under 18
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 30 FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 150.15
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 30 FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST 150.15
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 30 FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST 150.15
-- (f): the claimant 18 to 24, the partner under 18 and within none of (e)(i) to (iii) (and (f)(i) to (iii) all met)
#ASSERT `Sch 2 (3): the personal allowance of a couple` 18 17 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 75.65
#ASSERT `Sch 2 (3): the personal allowance of a couple` 24 17 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 75.65
-- (g): the claimant 25 or over, the partner under 18 and within none of them
#ASSERT `Sch 2 (3): the personal allowance of a couple` 25 17 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 95.55
#ASSERT `Sch 2 (3): the personal allowance of a couple` 70 17 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 95.55
-- a claimant under 18 whose partner is 18 or over and who is within none of (e)(i) to (iii): no head reaches the couple
#ASSERT `Sch 2 (3): the personal allowance of a couple` 17 30 FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Schedule 3 -- weekly amounts of premiums (src:559-578)`

-- items 2, 2A and 3: 213.10 for persons to whom the paragraph applies
#ASSERT `Sch 3 (2): the pensioner premium for persons to whom paragraph 9 applies` TRUE EQUALS JUST 213.10
#ASSERT `Sch 3 (2): the pensioner premium for persons to whom paragraph 9 applies` FALSE EQUALS NOTHING
#ASSERT `Sch 3 (2A): the pensioner premium for persons to whom paragraph 9A applies` TRUE EQUALS JUST 213.10
#ASSERT `Sch 3 (2A): the pensioner premium for persons to whom paragraph 9A applies` FALSE EQUALS NOTHING
#ASSERT `Sch 3 (3): the higher pensioner premium for persons to whom paragraph 10 applies` TRUE EQUALS JUST 213.10
#ASSERT `Sch 3 (3): the higher pensioner premium for persons to whom paragraph 10 applies` FALSE EQUALS NOTHING
-- item 4: disability premium
#ASSERT `Sch 3 (4): the disability premium` `the claimant satisfies the condition in paragraph 11(1)(a)` EQUALS 44.85
#ASSERT `Sch 3 (4): the disability premium` `the claimant satisfies the condition in paragraph 11(1)(b)` EQUALS 64.00
-- item 5: severe disability premium
#ASSERT `Sch 3 (5): the severe disability premium` `the claimant satisfies the condition in paragraph 13(2)(a)` FALSE EQUALS 86.05
#ASSERT `Sch 3 (5): the severe disability premium` `the claimant satisfies the condition in paragraph 13(2)(a)` TRUE EQUALS 86.05
#ASSERT `Sch 3 (5): the severe disability premium` `the claimant satisfies the condition in paragraph 13(2)(b)` TRUE EQUALS 86.05
#ASSERT `Sch 3 (5): the severe disability premium` `the claimant satisfies the condition in paragraph 13(2)(b)` FALSE EQUALS 172.10
-- item 6: disabled child premium, for each child or young person
#ASSERT `Sch 3 (6): the disabled child premium` 0 EQUALS 0
#ASSERT `Sch 3 (6): the disabled child premium` 1 EQUALS 84.46
#ASSERT `Sch 3 (6): the disabled child premium` 2 EQUALS 168.92
-- item 7: carer premium, for each person
#ASSERT `Sch 3 (7): the carer premium` 1 EQUALS 48.15
#ASSERT `Sch 3 (7): the carer premium` 2 EQUALS 96.30
-- item 8: enhanced disability premium
#ASSERT `Sch 3 (8)(a): the enhanced disability premium for children and young persons` 1 EQUALS 33.99
#ASSERT `Sch 3 (8)(a): the enhanced disability premium for children and young persons` 3 EQUALS 101.97
#ASSERT `Sch 3 (8)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` TRUE TRUE EQUALS JUST 22.00
#ASSERT `Sch 3 (8)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` TRUE FALSE EQUALS NOTHING
#ASSERT `Sch 3 (8)(b): the enhanced disability premium for a person who is neither a child or young person nor in a couple` FALSE TRUE EQUALS NOTHING
#ASSERT `Sch 3 (8)(c): the enhanced disability premium for a member of a couple or polygamous marriage` TRUE TRUE EQUALS JUST 31.40
#ASSERT `Sch 3 (8)(c): the enhanced disability premium for a member of a couple or polygamous marriage` TRUE FALSE EQUALS NOTHING
#ASSERT `Sch 3 (8)(c): the enhanced disability premium for a member of a couple or polygamous marriage` FALSE TRUE EQUALS NOTHING
