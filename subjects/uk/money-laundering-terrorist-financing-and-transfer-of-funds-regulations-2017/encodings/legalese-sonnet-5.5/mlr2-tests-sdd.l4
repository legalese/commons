#ASSERT `reg 38(4) the relevant person is not prevented from applying simplified customer due diligence measures in relation to electronic money` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 38(4) the relevant person is not prevented from applying simplified customer due diligence measures in relation to electronic money` (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 38(4) the relevant person is not prevented from applying simplified customer due diligence measures in relation to electronic money` (JUST TRUE) FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 38(4) the relevant person is not prevented from applying simplified customer due diligence measures in relation to electronic money` (JUST FALSE) TRUE (JUST TRUE) EQUALS NOTHING
-- (4A): arguments: the kind of institution; acquirer for an anonymous prepaid card issued in a third country; the card is subject to equivalent requirements; it satisfies them
#ASSERT `reg 38(4A) the institution may accept payment using the anonymous prepaid card` `credit institution` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 38(4A) the institution may accept payment using the anonymous prepaid card` `financial institution` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 38(4A) the institution may accept payment using the anonymous prepaid card` `credit institution` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 38(4A) the institution may accept payment using the anonymous prepaid card` `credit institution` TRUE TRUE FALSE EQUALS JUST FALSE
