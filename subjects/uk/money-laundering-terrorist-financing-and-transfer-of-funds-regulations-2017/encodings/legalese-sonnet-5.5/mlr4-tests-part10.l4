IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr4-part10`


-- TESTS for mlr4-part10 (regulations 93 to 100).  Every expected value was decided by reading the
-- provision (the words are quoted beside the assertion), not by running the code.  Days are
-- counted after an anchor date that is itself day 0 (fork F-PERIOD): "within 30 days from" ends
-- on day 30; "a period of 30 days beginning with" ends on day 29.

§ `Tests -- Part 10`

§§ `Regulation 93`

-- 93(1).  Arguments: made by the FCA; 25(2) direction; 59(1) refusal; 60 suspension or cancellation; 74C(1); 76; 77; 78(2).
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (a) a direction
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (b) a refusal to register
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (c) a suspension or cancellation
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (ca) a direction under 74C(1)
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (d) a penalty or censuring statement
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (e) a measure under regulation 77
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- (f) a prohibition
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- a decision of some other kind
#ASSERT `reg 93(1) a person may appeal to the Upper Tribunal` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not a decision of the FCA
#ASSERT `reg 93(2) Part 9 of FSMA applies to the appeal with the modifications in paragraph (3)` TRUE EQUALS JUST TRUE
#ASSERT `reg 93(2) Part 9 of FSMA applies to the appeal with the modifications in paragraph (3)` FALSE EQUALS NOTHING
#ASSERT `reg 93(3)(a) the paragraph inserted after paragraph (o) of section 133(7A) of FSMA` EQUALS "(p) a decision to take action under any of regulations 76 to 78 of the Money Laundering, Terrorist Financing and Transfer of Funds (Information on the Payer) Regulations 2017."
-- 93(3)(b), section 133A(1).  Arguments: a decision notice under 81(6); the referral period has not ended; referred; finally disposed of.
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice may be taken` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- during the referral period
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice may be taken` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- referred, not finally disposed of
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice may be taken` TRUE FALSE TRUE TRUE EQUALS NOTHING -- finally disposed of: the section is silent
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice may be taken` TRUE FALSE FALSE FALSE EQUALS NOTHING -- period ended, no reference
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice may be taken` FALSE TRUE FALSE FALSE EQUALS NOTHING -- not a notice under regulation 81(6)
-- 93(3)(b), section 133A(1), asked as a bar (ruled 2026-11-05 (d)).  Arguments as above.
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice is barred` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- during the referral period: barred
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice is barred` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- referred, not finally disposed of: barred
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice is barred` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- finally disposed of: the bar has ended
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice is barred` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- period ended, no reference: the bar has ended
#ASSERT `reg 93(3)(b) section 133A(1) the action specified in the decision notice is barred` FALSE TRUE FALSE FALSE EQUALS NOTHING -- not a notice under regulation 81(6)
#ASSERT `reg 93(3)(b) section 133A(2) the Tribunal may make recommendations as to the FCA's regulating provisions or procedures` TRUE EQUALS JUST TRUE
#ASSERT `reg 93(3)(b) section 133A(2) the Tribunal may make recommendations as to the FCA's regulating provisions or procedures` FALSE EQUALS NOTHING

§§ `Regulation 94`

#ASSERT `reg 94(1) the Commissioners offered P a review` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 94(1) the Commissioners offered P a review` TRUE TRUE FALSE EQUALS JUST FALSE -- no offer made
#ASSERT `reg 94(1) the Commissioners offered P a review` TRUE FALSE FALSE EQUALS NOTHING -- no appeal lies under this Chapter
#ASSERT `reg 94(1) the Commissioners offered P a review` FALSE TRUE FALSE EQUALS NOTHING -- the decision has not been notified
#ASSERT `reg 94(1) the duty to offer P a review arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 94(1) the duty to offer P a review arises` TRUE FALSE EQUALS JUST FALSE -- no appeal lies under this Chapter: "if an appeal lies" (marginal reading (a))
#ASSERT `reg 94(1) the duty to offer P a review arises` FALSE TRUE EQUALS JUST FALSE -- the decision has not been notified
#ASSERT `reg 94(2) the offer of a review was made by notice at the same time as the decision` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 94(2) the offer of a review was made by notice at the same time as the decision` TRUE TRUE FALSE EQUALS JUST FALSE -- not at the same time
#ASSERT `reg 94(2) the offer of a review was made by notice at the same time as the decision` TRUE FALSE TRUE EQUALS JUST FALSE -- not by notice
#ASSERT `reg 94(2) the offer of a review was made by notice at the same time as the decision` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 94 applies to the notification` TRUE EQUALS JUST FALSE -- "does not apply to the notification of the conclusions of a review"
#ASSERT `reg 94 applies to the notification` FALSE EQUALS NOTHING

§§ `Regulation 95`

-- 95(1).  Arguments: offered; P notifies acceptance; days after the date of the notice of the offer; the Commissioners reviewed.
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE TRUE 30 TRUE EQUALS JUST TRUE -- day 30 is within "30 days from the date"
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE TRUE 30 FALSE EQUALS JUST FALSE -- accepted in time and not reviewed
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE TRUE 29 FALSE EQUALS JUST FALSE
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE TRUE 0 TRUE EQUALS JUST TRUE
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE TRUE 31 FALSE EQUALS NOTHING -- day 31 is outside: regulation 97 may reach it
#ASSERT `reg 95(1) the Commissioners reviewed the decision` TRUE FALSE 10 FALSE EQUALS NOTHING -- no acceptance
#ASSERT `reg 95(1) the Commissioners reviewed the decision` FALSE TRUE 10 FALSE EQUALS NOTHING -- no offer
#ASSERT `reg 95(1) the duty to review the decision arises` TRUE TRUE 30 EQUALS JUST TRUE -- day 30 is within "30 days from the date"
#ASSERT `reg 95(1) the duty to review the decision arises` TRUE TRUE 0 EQUALS JUST TRUE
#ASSERT `reg 95(1) the duty to review the decision arises` TRUE TRUE 31 EQUALS JUST FALSE -- day 31 is outside "within 30 days from the date of the notice of the offer": regulation 97 may reach it (ruled 2026-11-05 (a))
#ASSERT `reg 95(1) the duty to review the decision arises` TRUE FALSE 10 EQUALS JUST FALSE -- no acceptance: "if" (marginal reading (a))
#ASSERT `reg 95(1) the duty to review the decision arises` FALSE TRUE 10 EQUALS JUST FALSE -- no offer made
#ASSERT `reg 95(2) P may notify acceptance of the offer` TRUE EQUALS JUST FALSE
#ASSERT `reg 95(2) P may notify acceptance of the offer` FALSE EQUALS NOTHING
#ASSERT `reg 95(2) the prohibition on P` (JUST TRUE) EQUALS FULFILLED -- nothing is prohibited
#ASSERT `reg 95(2) the prohibition on P` NOTHING EQUALS FULFILLED
#TRACE `reg 95(2) the prohibition on P` (JUST FALSE) AT 0 WITH
    PARTY `reg 95(2) P` DOES `reg 95(2) P notifies acceptance of the offer` AT 5
#TRACE `reg 95(2) the prohibition on P` (JUST FALSE) AT 0 WITH
    WAITUNTIL 10
#ASSERT `reg 95(3) the Commissioners may review the decision` TRUE EQUALS JUST FALSE
#ASSERT `reg 95(3) the Commissioners may review the decision` FALSE EQUALS NOTHING
#ASSERT `reg 95(3) the prohibition on the Commissioners` (JUST TRUE) EQUALS FULFILLED
#ASSERT `reg 95(3) the prohibition on the Commissioners` NOTHING EQUALS FULFILLED
#TRACE `reg 95(3) the prohibition on the Commissioners` (JUST FALSE) AT 0 WITH
    PARTY `reg 95(3) the Commissioners` DOES `reg 95(3) the Commissioners review the decision` AT 5
#TRACE `reg 95(3) the prohibition on the Commissioners` (JUST FALSE) AT 0 WITH
    WAITUNTIL 10

§§ `Regulation 96`

#ASSERT `reg 96(4) the relevant period ends on day` NOTHING EQUALS 30 -- no notice given: the 30 days in regulation 95(1)(b)
#ASSERT `reg 96(4) the relevant period ends on day` (JUST 20) EQUALS 50 -- extended to the end of 30 days from day 20
#ASSERT `reg 96(4) the relevant period ends on day` (JUST 50) EQUALS 80 -- extended again
#ASSERT `reg 96(1) the Commissioners may notify P that the relevant period is extended` TRUE 30 30 EQUALS JUST TRUE -- the last day of the relevant period
#ASSERT `reg 96(1) the Commissioners may notify P that the relevant period is extended` TRUE 31 30 EQUALS JUST FALSE -- after the relevant period: "may within the relevant period" (ruled 2026-11-05 (a); was NOTHING)
#ASSERT `reg 96(1) the Commissioners may notify P that the relevant period is extended` TRUE 0 30 EQUALS JUST TRUE
#ASSERT `reg 96(1) the Commissioners may notify P that the relevant period is extended` FALSE 5 30 EQUALS JUST FALSE -- no review offered: a failed "if" (marginal reading (a); was NOTHING)
#ASSERT `reg 96(2) the relevant period is extended to the end of day` TRUE 20 EQUALS JUST 50
#ASSERT `reg 96(2) the relevant period is extended to the end of day` TRUE 0 EQUALS JUST 30
#ASSERT `reg 96(2) the relevant period is extended to the end of day` FALSE 20 EQUALS NOTHING -- no notice given
#ASSERT `reg 96(3) a further notice may be given` 1 EQUALS JUST TRUE
#ASSERT `reg 96(3) a further notice may be given` 5 EQUALS JUST TRUE
#ASSERT `reg 96(3) a further notice may be given` 0 EQUALS NOTHING -- the first notice is given under paragraph (1) itself

§§ `Regulation 97`

#ASSERT `reg 97(1) this regulation applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 97(1) this regulation applies` TRUE FALSE EQUALS JUST FALSE -- P accepted in time
#ASSERT `reg 97(1) this regulation applies` FALSE TRUE EQUALS JUST FALSE -- no offer
-- 97(2).  Arguments: paragraph (1) applies; request in writing after the time; reasonable excuse; no unreasonable delay; reviewed.
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- satisfied on all three and not reviewed
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS NOTHING -- not satisfied of a reasonable excuse
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS NOTHING -- not satisfied that the request was prompt
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS NOTHING -- no request in writing
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` (JUST FALSE) TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 97(2) the Commissioners reviewed the decision out of time` NOTHING TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 97(2) the duty to review the decision out of time arises` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE -- satisfied on all three
#ASSERT `reg 97(2) the duty to review the decision out of time arises` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE -- not satisfied of a reasonable excuse: a failed "if" (marginal reading (a))
#ASSERT `reg 97(2) the duty to review the decision out of time arises` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE -- not satisfied that the request was prompt
#ASSERT `reg 97(2) the duty to review the decision out of time arises` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE -- the late request was oral, not in writing
#ASSERT `reg 97(2) the duty to review the decision out of time arises` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE -- regulation 97(1) does not apply
#ASSERT `reg 97(2) the duty to review the decision out of time arises` NOTHING TRUE TRUE TRUE EQUALS NOTHING -- regulation 97(1) not answered
#ASSERT `reg 97(2) the duty to review the decision out of time arises` NOTHING FALSE TRUE TRUE EQUALS JUST FALSE -- a definite no wins over an answer that is not in

§§ `Regulation 98`

#ASSERT `reg 98(1) this regulation applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 98(1) this regulation applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 98(1) this regulation applies` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 98(2) the nature and extent of the review are for the Commissioners to judge` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 98(2) the nature and extent of the review are for the Commissioners to judge` (JUST FALSE) EQUALS JUST FALSE -- "This regulation applies if" and it does not (marginal reading (a); was NOTHING)
#ASSERT `reg 98(2) the nature and extent of the review are for the Commissioners to judge` NOTHING EQUALS NOTHING
#ASSERT `reg 98(3) the Commissioners had regard to the steps taken before the review` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 98(3) the Commissioners had regard to the steps taken before the review` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 98(3) the Commissioners had regard to the steps taken before the review` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 98(3) the Commissioners had regard to the steps taken before the review` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `reg 98(3) the duty to have regard to the steps taken before the review arises` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 98(3) the duty to have regard to the steps taken before the review arises` (JUST FALSE) EQUALS JUST FALSE -- "This regulation applies if" and it does not (marginal reading (a))
#ASSERT `reg 98(3) the duty to have regard to the steps taken before the review arises` NOTHING EQUALS NOTHING -- regulation 98(1) has not been answered
#ASSERT `reg 98(4) the review took account of the representations` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 98(4) the review took account of the representations` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 98(4) the review took account of the representations` (JUST TRUE) FALSE FALSE EQUALS NOTHING -- representations not made at such a stage
#ASSERT `reg 98(4) the review took account of the representations` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `reg 98(4) the duty to take account of the representations arises` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 98(4) the duty to take account of the representations arises` (JUST TRUE) FALSE EQUALS JUST FALSE -- representations not made at such a stage: "any representations made by the person at a stage which gives ..." (marginal reading (a))
#ASSERT `reg 98(4) the duty to take account of the representations arises` (JUST FALSE) TRUE EQUALS JUST FALSE -- "This regulation applies if" and it does not (marginal reading (a))
#ASSERT `reg 98(4) the duty to take account of the representations arises` NOTHING TRUE EQUALS NOTHING -- regulation 98(1) has not been answered
#ASSERT `reg 98(5) the review may conclude that the decision is` (JUST TRUE) `reg 98(5)(a) upheld` EQUALS JUST TRUE
#ASSERT `reg 98(5) the review may conclude that the decision is` (JUST TRUE) `reg 98(5)(b) varied` EQUALS JUST TRUE
#ASSERT `reg 98(5) the review may conclude that the decision is` (JUST TRUE) `reg 98(5)(c) cancelled` EQUALS JUST TRUE
#ASSERT `reg 98(5) the review may conclude that the decision is` (JUST TRUE) `reg 98(5) some other conclusion` EQUALS NOTHING
#ASSERT `reg 98(5) the review may conclude that the decision is` (JUST FALSE) `reg 98(5)(a) upheld` EQUALS JUST FALSE -- "This regulation applies if" and it does not (marginal reading (a); was NOTHING)
#ASSERT `reg 98(7) the relevant date is day` TRUE FALSE 10 20 EQUALS JUST 10 -- a case within regulation 95: the day the acceptance was received
#ASSERT `reg 98(7) the relevant date is day` FALSE TRUE 10 20 EQUALS JUST 20 -- a case within regulation 97: the day the Commissioners decided
#ASSERT `reg 98(7) the relevant date is day` FALSE FALSE 10 20 EQUALS NOTHING
-- 98(6).  Arguments: paragraph (1) applies; notice given; days after the relevant date (day 0); given within an agreed other period.
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST TRUE) TRUE 44 FALSE EQUALS JUST TRUE -- "45 days beginning with the relevant date" ends on day 44
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST TRUE) TRUE 45 FALSE EQUALS JUST FALSE -- day 45 is the 46th day
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST TRUE) TRUE 45 TRUE EQUALS JUST TRUE -- within an agreed longer period
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST TRUE) TRUE 0 FALSE EQUALS JUST TRUE
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST TRUE) FALSE 10 FALSE EQUALS JUST FALSE -- no notice given
#ASSERT `reg 98(6) the Commissioners gave P notice of the conclusions and reasoning in time` (JUST FALSE) TRUE 10 FALSE EQUALS NOTHING
#ASSERT `reg 98(6) the duty to give P notice of the conclusions and reasoning arises` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 98(6) the duty to give P notice of the conclusions and reasoning arises` (JUST FALSE) EQUALS JUST FALSE -- "This regulation applies if" and it does not (marginal reading (a))
#ASSERT `reg 98(6) the duty to give P notice of the conclusions and reasoning arises` NOTHING EQUALS NOTHING -- regulation 98(1) has not been answered
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- not in time: treated as upheld
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE -- in time: "do not give notice of the conclusions within the time period" (ruled 2026-11-05 (a); was NOTHING)
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE -- not a review under regulation 95 or 97: "Where the Commissioners are required to undertake a review" (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE -- neither condition holds
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` NOTHING (JUST FALSE) EQUALS NOTHING -- whether regulation 98 applies is not shown
#ASSERT `reg 98(8) the review is treated as having concluded that the decision is upheld` NOTHING (JUST TRUE) EQUALS JUST FALSE -- notice was in time: a definite no wins over an answer that is not in
#ASSERT `reg 98(9) the Commissioners notified P of the conclusion treated as reached` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 98(9) the Commissioners notified P of the conclusion treated as reached` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 98(9) the Commissioners notified P of the conclusion treated as reached` NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 98(9) the duty to notify P of the conclusion treated as reached arises` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 98(9) the duty to notify P of the conclusion treated as reached arises` (JUST FALSE) EQUALS JUST FALSE -- paragraph (8) does not apply: "If paragraph (8) applies" (marginal reading (a))
#ASSERT `reg 98(9) the duty to notify P of the conclusion treated as reached arises` NOTHING EQUALS NOTHING -- paragraph (8) has not been answered

§§ `Regulation 99`

-- 99(1).  Arguments: the subject of a Commissioners' decision; 25(2) direction; 58 not fit and proper; 59(1); 60; 76; 78(2).
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- (b) not a fit and proper person
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (c)
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (d)
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (e)
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- (f)
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- a decision of another kind
#ASSERT `reg 99(1) a person may appeal to the tribunal in accordance with regulation 100` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- not the subject of a Commissioners' decision
#ASSERT `reg 99(2) Part 5 of the Value Added Tax Act 1994 applies to the appeal` TRUE EQUALS JUST TRUE
#ASSERT `reg 99(2) Part 5 of the Value Added Tax Act 1994 applies to the appeal` FALSE EQUALS NOTHING
#ASSERT `reg 99(3) the section is omitted` `reg 99(3) sections 83A to 84` EQUALS JUST TRUE
#ASSERT `reg 99(3) the section is omitted` `reg 99(3) section 85A` EQUALS JUST TRUE
#ASSERT `reg 99(3) the section is omitted` `reg 99(3) section 85B` EQUALS JUST TRUE
#ASSERT `reg 99(3) the section is omitted` `reg 99(3) some other section` EQUALS NOTHING
#ASSERT `reg 99(4) the tribunal has the power to` TRUE `reg 99(4)(a) quash or vary any decision of the Commissioners` EQUALS JUST TRUE
#ASSERT `reg 99(4) the tribunal has the power to` TRUE `reg 99(4)(b) substitute the tribunal's own decision for any decision quashed on appeal` EQUALS JUST TRUE
#ASSERT `reg 99(4) the tribunal has the power to` TRUE `reg 99(4) some other power` EQUALS NOTHING
#ASSERT `reg 99(4) the tribunal has the power to` FALSE `reg 99(4)(a) quash or vary any decision of the Commissioners` EQUALS NOTHING
#ASSERT `reg 99(4)(a) the tribunal may reduce the penalty to the amount` 1000 0 EQUALS JUST TRUE -- "(including nil)"
#ASSERT `reg 99(4)(a) the tribunal may reduce the penalty to the amount` 1000 500 EQUALS JUST TRUE
#ASSERT `reg 99(4)(a) the tribunal may reduce the penalty to the amount` 1000 1000 EQUALS JUST TRUE
#ASSERT `reg 99(4)(a) the tribunal may reduce the penalty to the amount` 1000 1001 EQUALS NOTHING -- more than the penalty is not a reduction
#ASSERT `reg 99(4)(a) the tribunal may reduce the penalty to the amount` 1000 (0 - 1) EQUALS NOTHING
#ASSERT `reg 99(5) tribunal is given by` EQUALS "section 82 of the Value Added Tax Act 1994 (meaning of tribunal)"

§§ `Regulation 100`

#ASSERT `reg 100(6) the conclusion date is day` NOTHING EQUALS NOTHING -- no notice of the conclusions yet
#ASSERT `reg 100(6) the conclusion date is day` (JUST 12) EQUALS JUST 12
-- 100(1).  Arguments: days after the date of the notice of the decision (day 0); the relevant period ends on day; a case in (2) to (4) displaces.
#ASSERT `reg 100(1) the appeal was made in time` 29 30 FALSE EQUALS JUST TRUE -- (a) 30 days beginning with the date ends on day 29
#ASSERT `reg 100(1) the appeal was made in time` 30 30 FALSE EQUALS JUST TRUE -- (b) the relevant period (30 days from the date) ends on day 30, which is later
#ASSERT `reg 100(1) the appeal was made in time` 31 30 FALSE EQUALS JUST FALSE -- after both
#ASSERT `reg 100(1) the appeal was made in time` 0 30 FALSE EQUALS JUST TRUE
#ASSERT `reg 100(1) the appeal was made in time` 61 61 FALSE EQUALS JUST TRUE -- a relevant period extended to day 61
#ASSERT `reg 100(1) the appeal was made in time` 62 61 FALSE EQUALS JUST FALSE
#ASSERT `reg 100(1) the appeal was made in time` 5 30 TRUE EQUALS NOTHING -- displaced by paragraph (2), (3) or (4)
-- 100(2).  Arguments: a review required under regulation 95; days after the conclusion date (day 0).
#ASSERT `reg 100(2) the appeal was made in time` TRUE (0 - 1) EQUALS JUST FALSE -- "may not be made until the conclusion date"
#ASSERT `reg 100(2) the appeal was made in time` TRUE 0 EQUALS JUST TRUE
#ASSERT `reg 100(2) the appeal was made in time` TRUE 29 EQUALS JUST TRUE -- "30 days beginning with the conclusion date"
#ASSERT `reg 100(2) the appeal was made in time` TRUE 30 EQUALS JUST FALSE
#ASSERT `reg 100(2) the appeal was made in time` FALSE 5 EQUALS NOTHING
-- 100(3).  Arguments: review requested under regulation 97; notified whether a review will be undertaken; notified that it will; days after the conclusion date; permission given.
#ASSERT `reg 100(3) the appeal was made in time` FALSE TRUE TRUE 5 FALSE EQUALS NOTHING
#ASSERT `reg 100(3) the appeal was made in time` TRUE FALSE FALSE 0 FALSE EQUALS JUST FALSE -- (a)(i) no notification yet
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE TRUE (0 - 1) FALSE EQUALS JUST FALSE -- (a)(ii) before the conclusion date
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE TRUE 0 FALSE EQUALS JUST TRUE
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE TRUE 29 FALSE EQUALS JUST TRUE
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE TRUE 30 FALSE EQUALS JUST FALSE -- (b) after 30 days beginning with the conclusion date
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE FALSE 0 TRUE EQUALS JUST TRUE -- (c) told no review: with permission
#ASSERT `reg 100(3) the appeal was made in time` TRUE TRUE FALSE 0 FALSE EQUALS JUST FALSE -- (c) "only if the tribunal gives permission"
-- 100(4).  Arguments: regulation 98(8) applies; the day of the appeal; the day the 98(6) period ended; the conclusion date.
#ASSERT `reg 100(4) the appeal may be made` TRUE 10 10 10 EQUALS JUST TRUE -- from the end of the period
#ASSERT `reg 100(4) the appeal may be made` TRUE 9 10 10 EQUALS JUST FALSE -- before the end of the regulation 98(6) period (ruled 2026-11-05 (a); was NOTHING)
#ASSERT `reg 100(4) the appeal may be made` TRUE 40 10 10 EQUALS JUST TRUE -- the date 30 days after the conclusion date
#ASSERT `reg 100(4) the appeal may be made` TRUE 41 10 10 EQUALS JUST FALSE -- after the date 30 days after the conclusion date (ruled 2026-11-05 (a); was NOTHING)
#ASSERT `reg 100(4) the appeal may be made` FALSE 20 10 10 EQUALS JUST FALSE -- regulation 98(8) does not apply: "In a case where regulation 98(8) applies" (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 100(5) the appeal may be made after the end of the period` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 100(5) the appeal may be made after the end of the period` TRUE FALSE EQUALS JUST FALSE -- no permission: a failed "if" (marginal reading (a); was NOTHING)
#ASSERT `reg 100(5) the appeal may be made after the end of the period` FALSE TRUE EQUALS JUST FALSE -- the appeal is not after the end of the period (marginal reading (a); was NOTHING)

