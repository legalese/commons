#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `auction platform` EQUALS NOTHING

§ `reg 26(3): applied before 26th June 2018 (src:725)`
#ASSERT `reg 26(3) the date before which the application must have been made` EQUALS Date 26 6 2018
-- arguments: the date of the application; the application has not yet been determined
#ASSERT `reg 26(3) the person does not breach the prohibition in paragraph (1)` (Date 25 6 2018) TRUE EQUALS JUST TRUE
#ASSERT `reg 26(3) the person does not breach the prohibition in paragraph (1)` (Date 26 6 2018) TRUE EQUALS JUST FALSE
#ASSERT `reg 26(3) the person does not breach the prohibition in paragraph (1)` (Date 25 6 2018) FALSE EQUALS JUST FALSE

§ `reg 26(3A): became a relevant firm on 10th January 2020 (src:726-729)`
#ASSERT `reg 26(3A)(a) the date on which the person must have become a relevant firm or relevant sole practitioner` EQUALS Date 10 1 2020
#ASSERT `reg 26(3A)(b) the date before which the application must have been made` EQUALS Date 10 1 2021
-- arguments: the date it became a relevant firm; by virtue of the 2019 amendment; the date of the application; not yet determined
#ASSERT `reg 26(3A) the person does not breach the prohibition in paragraph (1)` (Date 10 1 2020) TRUE (Date 9 1 2021) TRUE EQUALS JUST TRUE
#ASSERT `reg 26(3A) the person does not breach the prohibition in paragraph (1)` (Date 10 1 2020) TRUE (Date 10 1 2021) TRUE EQUALS JUST FALSE
#ASSERT `reg 26(3A) the person does not breach the prohibition in paragraph (1)` (Date 11 1 2020) TRUE (Date 9 1 2021) TRUE EQUALS JUST FALSE
#ASSERT `reg 26(3A) the person does not breach the prohibition in paragraph (1)` (Date 10 1 2020) FALSE (Date 9 1 2021) TRUE EQUALS JUST FALSE
#ASSERT `reg 26(3A) the person does not breach the prohibition in paragraph (1)` (Date 10 1 2020) TRUE (Date 9 1 2021) FALSE EQUALS JUST FALSE

§ `reg 26(1): the prohibition (src:718)`
-- arguments: holds the position; (2) answer; approved; (3) answer; (3A) answer
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` TRUE (JUST TRUE) TRUE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` TRUE (JUST TRUE) FALSE NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` TRUE (JUST TRUE) FALSE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` TRUE (JUST TRUE) FALSE NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` FALSE (JUST TRUE) FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `reg 26(1) the person may be the beneficial owner, officer or manager of the relevant firm, or the relevant sole practitioner` TRUE NOTHING FALSE NOTHING NOTHING EQUALS NOTHING

§ `reg 26(4) and (5): appointment and acting (src:730-735)`
-- arguments: approved and the approval has not ceased to be valid; applied and not yet determined
#ASSERT `reg 26(4) the person may be appointed, or continue to act, as an officer or manager of the relevant firm` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 26(4) the person may be appointed, or continue to act, as an officer or manager of the relevant firm` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(4) the person may be appointed, or continue to act, as an officer or manager of the relevant firm` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 26(4) the relevant firm has taken reasonable care as paragraph (4) requires` TRUE EQUALS JUST TRUE
#ASSERT `reg 26(4) the relevant firm has taken reasonable care as paragraph (4) requires` FALSE EQUALS JUST FALSE
#ASSERT `reg 26(5) the relevant sole practitioner may act, or continue to act, as a sole practitioner` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 26(5) the relevant sole practitioner may act, or continue to act, as a sole practitioner` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(5) the relevant sole practitioner may act, or continue to act, as a sole practitioner` FALSE FALSE EQUALS JUST FALSE

§ `reg 26(6) and (8): applications and grants (src:736, 742-744)`
#ASSERT `reg 26(6) the application may be made` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 26(6) the application may be made` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(6) the application may be made` FALSE FALSE EQUALS NOTHING
-- arguments: the applicant has been convicted of an offence; the answer for paragraph (14)
#ASSERT `reg 26(8)(a) the supervisory authority must grant the application` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `reg 26(8)(a) the supervisory authority must grant the application` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 26(8)(a) the supervisory authority must grant the application` TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 26(8)(a) the supervisory authority must grant the application` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 26(8)(b) the supervisory authority may grant the application so as to give approval only for a limited period` TRUE EQUALS JUST TRUE
#ASSERT `reg 26(8)(b) the supervisory authority may grant the application so as to give approval only for a limited period` FALSE EQUALS NOTHING

§ `reg 26(9): when an approval is not valid (src:745-747)`
-- arguments: the answer for paragraph (14); convicted when the approval was given; subsequently convicted
#ASSERT `reg 26(9) the approval given under paragraph (8) is valid` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 26(9) the approval given under paragraph (8) is valid` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 26(9) the approval given under paragraph (8) is valid` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `reg 26(9) the approval given under paragraph (8) is valid` NOTHING TRUE TRUE EQUALS NOTHING

§ `reg 26(10): 30 days after the conviction (src:748-750)`
#ASSERT `reg 26(10) the period of 30 days` EQUALS 30
-- convicted on 1 March 2025: the last day is 31 March 2025
#ASSERT `reg 26(10)(a) P informed the supervisory authority within 30 days of the conviction` (JUST TRUE) (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE
#ASSERT `reg 26(10)(a) P informed the supervisory authority within 30 days of the conviction` (JUST TRUE) (Date 1 3 2025) (Date 1 4 2025) EQUALS JUST FALSE
#ASSERT `reg 26(10)(a) P informed the supervisory authority within 30 days of the conviction` (JUST TRUE) (Date 1 3 2025) (Date 28 2 2025) EQUALS JUST FALSE
#ASSERT `reg 26(10)(a) P informed the supervisory authority within 30 days of the conviction` (JUST FALSE) (Date 1 3 2025) (Date 28 2 2025) EQUALS JUST TRUE
#ASSERT `reg 26(10)(a) P informed the supervisory authority within 30 days of the conviction` NOTHING (Date 1 3 2025) (Date 31 3 2025) EQUALS NOTHING
#ASSERT `reg 26(10)(b) the relevant firm informed its supervisory authority within 30 days of becoming aware of the conviction` (JUST TRUE) (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE
#ASSERT `reg 26(10)(b) the relevant firm informed its supervisory authority within 30 days of becoming aware of the conviction` (JUST TRUE) (Date 1 3 2025) (Date 1 4 2025) EQUALS JUST FALSE
#ASSERT `reg 26(10)(b) the relevant firm informed its supervisory authority within 30 days of becoming aware of the conviction` (JUST FALSE) (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE

§ `reg 26(11), (12), (13): the court, the offence and the penalty (src:751-760)`
-- arguments: the answer for paragraph (14); the supervisory authority has applied to the court
#ASSERT `reg 26(11) the court may order the sale of the beneficial owner's interest in the firm` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 26(11) the court may order the sale of the beneficial owner's interest in the firm` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 26(11) the court may order the sale of the beneficial owner's interest in the firm` NOTHING TRUE EQUALS NOTHING
-- arguments: the answer for paragraph (1); acts as a manager or officer or as a relevant sole practitioner; is knowingly a beneficial owner
#ASSERT `reg 26(12) the person is guilty of a criminal offence` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 26(12) the person is guilty of a criminal offence` (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(12) the person is guilty of a criminal offence` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `reg 26(12) the person is guilty of a criminal offence` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `reg 26(13) the longest term of imprisonment in months` `reg 26(13)(a)(i) summary conviction in England and Wales` EQUALS JUST 3
#ASSERT `reg 26(13) the longest term of imprisonment in months` `reg 26(13)(a)(ii) summary conviction in Scotland or Northern Ireland` EQUALS JUST 3
#ASSERT `reg 26(13) the longest term of imprisonment in months` `reg 26(13)(b) conviction on indictment` EQUALS JUST 24
#ASSERT `reg 26(13) the longest term of imprisonment in months` `reg 26(13) conviction elsewhere` EQUALS NOTHING
#ASSERT `reg 26(13) the fine is limited to the statutory maximum` `reg 26(13)(a)(i) summary conviction in England and Wales` EQUALS NOTHING
#ASSERT `reg 26(13) the fine is limited to the statutory maximum` `reg 26(13)(a)(ii) summary conviction in Scotland or Northern Ireland` EQUALS JUST TRUE
#ASSERT `reg 26(13) the fine is limited to the statutory maximum` `reg 26(13)(b) conviction on indictment` EQUALS NOTHING
#ASSERT `reg 26(13) the fine is limited to the statutory maximum` `reg 26(13) conviction elsewhere` EQUALS NOTHING

§ `reg 26(7): the seam answer S-11 (src:737-741)`
-- arguments: made in the manner directed; sufficient information on convictions; such other information as may reasonably be required
#ASSERT `reg 26(7) the application for approval meets the requirements of regulation 26(7)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(7) the application for approval meets the requirements of regulation 26(7)` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 26(7) the application for approval meets the requirements of regulation 26(7)` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 26(7) the application for approval meets the requirements of regulation 26(7)` TRUE TRUE FALSE EQUALS JUST FALSE
