#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `auditor` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `insolvency practitioner` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `external accountant` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `tax adviser` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `independent legal professional` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `estate agent` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `letting agent` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `high value dealer` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `art market participant` EQUALS JUST TRUE
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `credit institution` EQUALS NOTHING
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `financial institution` EQUALS NOTHING
#ASSERT `reg 26(2) the kind of firm or sole practitioner is within this paragraph` `trust or company service provider` EQUALS NOTHING
