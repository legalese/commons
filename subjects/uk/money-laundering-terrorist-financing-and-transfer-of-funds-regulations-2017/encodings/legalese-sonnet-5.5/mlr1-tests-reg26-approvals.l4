IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg26-approvals`

-- TESTS for regulation 26.  Expected values are written from the text (the line named in each heading).  Inputs are positional, in the
-- order of the function's GIVEN.  Dates in the tests are counted by hand: the day of the event is not counted for "within 30 days of".

§ `The duty checklists of regulation 26`
-- reg 26(7)
#ASSERT `reg 26(7) the application is made as paragraph (7) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 26(7) the application is made as paragraph (7) requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 26(7) the application is made as paragraph (7) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 26(7) the application is made as paragraph (7) requires` TRUE TRUE FALSE EQUALS JUST FALSE

§ `reg 26(14): relevant offences, seam S-5 (src:761)`
#ASSERT `reg 26(14) the offence is a relevant offence for the purposes of this regulation` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 26(14) the offence is a relevant offence for the purposes of this regulation` (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 26(14) the offence is a relevant offence for the purposes of this regulation` NOTHING EQUALS NOTHING

