IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg30-32-timing`

-- TESTS for regulations 30 to 32.  Expected values are written from the text (the line named in each heading).  Inputs are positional, in the order of the
-- function's GIVEN.  For the "must" functions each input is, in turn, a seam or paragraph answer ("gate"), a condition of the case ("where"), an "if" or an
-- "unless" exception; the helper generating these tests tries all true, then each input failing in turn.

§ `reg 30(1) to (1A), (8): when the regulation applies (src:908-909, 922)`
#ASSERT `reg 30(8) the customer is an insolvent bank customer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 30(8) the customer is an insolvent bank customer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 30(8) the customer is an insolvent bank customer` NOTHING EQUALS NOTHING
-- (1A) arguments: the kinds; the answer of paragraph (8); regulation 30ZA applies to the credit institution in relation to the customer
#ASSERT `reg 30(1A) this regulation does not apply to the credit institution in relation to the insolvent bank customer` (LIST `credit institution`) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 30(1A) this regulation does not apply to the credit institution in relation to the insolvent bank customer` (LIST `estate agent`) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `reg 30(1A) this regulation does not apply to the credit institution in relation to the insolvent bank customer` (LIST `credit institution`) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `reg 30(1A) this regulation does not apply to the credit institution in relation to the insolvent bank customer` (LIST `credit institution`) NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 30(1A) this regulation does not apply to the credit institution in relation to the insolvent bank customer` (LIST `credit institution`) (JUST TRUE) FALSE EQUALS JUST FALSE
-- (1) arguments: the answers of regulations 27, 28(1) and 29(1); the answer of paragraph (1A)
#ASSERT `reg 30(1) this regulation applies` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `reg 30(1) this regulation applies` NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `reg 30(1) this regulation applies` NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `reg 30(1) this regulation applies` (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `reg 30(1) this regulation applies` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 30(1) this regulation applies` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE

