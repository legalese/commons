IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr2-helpers`
IMPORT `mlr2-trusts`

-- TESTS for mlr2-trusts.l4 (regulations 42 to 44).  Every expected value is written by hand from the text beside the
-- assertion; none is copied from the encoding's own output.  Each line is one #ASSERT.
-- The commencement date of regulation 42(2)(b)(iii)(aaa) is not in the rendering.  The tests use 1 June 2022 as a
-- TEST VALUE ONLY; it is not the date on which that sub-paragraph came into force.

§ `Regulation 42(2)(a) and (3) -- UK body corporate; resident in the United Kingdom`

-- (a) arguments: incorporated under UK law; an eligible Scottish partnership
#ASSERT `reg 42(2)(a) the body is a UK body corporate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 42(2)(a) the body is a UK body corporate` FALSE TRUE EQUALS JUST TRUE
-- neither: "is a body corporate which is incorporated under the law of the United Kingdom ... and includes an eligible Scottish partnership" -- a Jersey company is not a UK body corporate
#ASSERT `reg 42(2)(a) the body is a UK body corporate` FALSE FALSE EQUALS JUST FALSE
-- (3) arguments: the kind; the answer for a UK body corporate; the individual is resident for the purposes of the taxes
#ASSERT `reg 42(3) the trustee or settlor is resident in the United Kingdom` `reg 42(3)(a) a body corporate` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 42(3) the trustee or settlor is resident in the United Kingdom` `reg 42(3)(a) a body corporate` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 42(3) the trustee or settlor is resident in the United Kingdom` `reg 42(3)(a) a body corporate` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 42(3) the trustee or settlor is resident in the United Kingdom` `reg 42(3)(b) an individual` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `reg 42(3) the trustee or settlor is resident in the United Kingdom` `reg 42(3)(b) an individual` (JUST TRUE) FALSE EQUALS JUST FALSE

§ `Regulation 42(2)(c) to (f), (2A), (4) to (6)`

-- the facts for (d), in the order of the record: a trustee resident; settlor resident at set-up; settlor domiciled at set-up; settlor resident when adding funds; settlor domiciled when adding funds
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
GIVETH A `reg 42(2)(d) the facts`
`reg 42(2)(d) test facts` MEANS `reg 42(2)(d) the facts` WITH
    `at least one trustee is resident in the United Kingdom` IS a
    `the settlor was resident in the United Kingdom when the trust was set up` IS b
    `the settlor was domiciled in the United Kingdom when the trust was set up` IS c
    `the settlor was resident in the United Kingdom when the settlor added funds to the trust` IS d
    `the settlor was domiciled in the United Kingdom when the settlor added funds to the trust` IS e

-- a trust set up on 5 April 2025 (before 6 April 2025): "resident and domiciled" is read (regulation 42(2A))
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE TRUE TRUE FALSE FALSE) (Date 5 4 2025) EQUALS JUST TRUE
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE TRUE FALSE FALSE FALSE) (Date 5 4 2025) EQUALS JUST FALSE
-- a trust set up on 6 April 2025: residence alone is enough
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE TRUE FALSE FALSE FALSE) (Date 6 4 2025) EQUALS JUST TRUE
-- (bb) funds added: resident and domiciled when adding, trust set up before 6 April 2025
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE FALSE FALSE TRUE TRUE) (Date 1 1 2020) EQUALS JUST TRUE
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE FALSE FALSE TRUE FALSE) (Date 1 1 2020) EQUALS JUST FALSE
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE FALSE FALSE TRUE FALSE) (Date 1 1 2026) EQUALS JUST TRUE
-- no trustee resident in the United Kingdom: (d)(i) fails
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` FALSE TRUE TRUE TRUE TRUE) (Date 1 1 2020) EQUALS JUST FALSE
-- neither time: (d)(ii) fails
#ASSERT `reg 42(2)(d) sub-paragraph (d) applies` (`reg 42(2)(d) test facts` TRUE FALSE FALSE FALSE FALSE) (Date 1 1 2026) EQUALS JUST FALSE
-- (c) arguments: all the trustees are resident; the (d) answer
#ASSERT `reg 42(2)(c) the trust is a UK trust` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 42(2)(c) the trust is a UK trust` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 42(2)(c) the trust is a UK trust` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 42(2)(c) the trust is a UK trust` FALSE NOTHING EQUALS NOTHING
#ASSERT `reg 42(2)(e) the trust is a non-UK trust` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 42(2)(e) the trust is a non-UK trust` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 42(2)(e) the trust is a non-UK trust` NOTHING EQUALS NOTHING
-- (4) arguments: established in a country other than the United Kingdom; equivalent national legislation applies
#ASSERT `reg 42(4) the trust is an EEA registered trust` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 42(4) the trust is an EEA registered trust` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 42(4) the trust is an EEA registered trust` FALSE TRUE EQUALS JUST FALSE
-- (5) arguments: a trustee becomes registered; the registration; the term of the lease in years
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(a)(i) registered in the register of title kept under the Land Registration Act 2002 as the proprietor of a freehold estate in land` 0 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(a)(ii) registered in the register of title kept under the Land Registration Act 2002 as the proprietor of a leasehold estate in land granted for a term of more than 7 years` 8 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(a)(ii) registered in the register of title kept under the Land Registration Act 2002 as the proprietor of a leasehold estate in land granted for a term of more than 7 years` 7 EQUALS JUST FALSE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(b) registered in the Land Register of Scotland as the proprietor` 0 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(b) registered in the Land Register of Scotland as the tenant under a lease` 1 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(c)(i) registered in the register kept under the Land Registration Act (Northern Ireland) 1970 as the owner of a freehold estate in land` 0 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(c)(ii) registered in the register kept under the Land Registration Act (Northern Ireland) 1970 as the owner of a leasehold estate in land granted for a term of more than 21 years` 22 EQUALS JUST TRUE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` TRUE `reg 42(5)(c)(ii) registered in the register kept under the Land Registration Act (Northern Ireland) 1970 as the owner of a leasehold estate in land granted for a term of more than 21 years` 21 EQUALS JUST FALSE
#ASSERT `reg 42(5) the trustees acquire an interest in land in the United Kingdom` FALSE `reg 42(5)(a)(i) registered in the register of title kept under the Land Registration Act 2002 as the proprietor of a freehold estate in land` 0 EQUALS JUST FALSE
-- (6)(a) arguments: paragraph 2; paragraph 3; paragraph 4; paragraph 5
#ASSERT `reg 42(6)(a) the trustees have a controlling interest in a third country entity` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 42(6)(a) the trustees have a controlling interest in a third country entity` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 42(6)(a) the trustees have a controlling interest in a third country entity` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 42(6)(a) the trustees have a controlling interest in a third country entity` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 42(6)(a) the trustees have a controlling interest in a third country entity` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (6)(b) arguments: governed by foreign law and a legal person under it; subject to equivalent legislation
#ASSERT `reg 42(6)(b) the entity is a third country entity` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 42(6)(b) the entity is a third country entity` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 42(6)(b) the entity is a third country entity` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 42(2)(f) the meaning of collective investment scheme is given by` EQUALS "regulation 12H of the International Tax Compliance Regulations 2015"

§ `Regulation 42(2)(b) -- a relevant trust`

-- sub-paragraph (iii)(aaa): arguments: the record; the commencement date (a TEST VALUE, 1 June 2022).  Record order: express; income in the UK; assets in the UK; liable to the taxes; acquires land now (MAYBE); the date acquired (MAYBE); the last day held (MAYBE); business relationship with a relevant person (MAYBE); a trustee resident
GIVEN express IS A BOOLEAN
      income IS A BOOLEAN
      assets IS A BOOLEAN
      liable IS A BOOLEAN
      land IS A MAYBE BOOLEAN
      acquired IS A MAYBE DATE
      held IS A MAYBE DATE
      relationship IS A MAYBE BOOLEAN
      resident IS A BOOLEAN
GIVETH A `reg 42(2)(b) the trust`
`reg 42(2)(b) test trust` MEANS `reg 42(2)(b) the trust` WITH
    `the trust is an express trust` IS express
    `the trust receives income from a source in the United Kingdom` IS income
    `the trust has assets in the United Kingdom` IS assets
    `the trust is liable to pay one or more of the taxes referred to in regulation 45(14) on that income or those assets` IS liable
    `the trustees acquire an interest in land in the United Kingdom` IS land
    `the date on which the trustees acquired an interest in land in the United Kingdom` IS acquired
    `the last day on which the trustees held that interest` IS held
    `the trustees enter into a business relationship with a relevant person` IS relationship
    `at least one of the trustees is resident in the United Kingdom` IS resident

#ASSERT `reg 42(2)(b)(iii)(aaa) the trustees acquired an interest in land before 6 October 2020 and continued to hold it up to the commencement date` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE NOTHING (JUST (Date 5 10 2020)) NOTHING NOTHING FALSE) (Date 1 6 2022) EQUALS JUST TRUE
#ASSERT `reg 42(2)(b)(iii)(aaa) the trustees acquired an interest in land before 6 October 2020 and continued to hold it up to the commencement date` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE NOTHING (JUST (Date 6 10 2020)) NOTHING NOTHING FALSE) (Date 1 6 2022) EQUALS JUST FALSE
#ASSERT `reg 42(2)(b)(iii)(aaa) the trustees acquired an interest in land before 6 October 2020 and continued to hold it up to the commencement date` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE NOTHING (JUST (Date 5 10 2020)) (JUST (Date 1 6 2022)) NOTHING FALSE) (Date 1 6 2022) EQUALS JUST TRUE
#ASSERT `reg 42(2)(b)(iii)(aaa) the trustees acquired an interest in land before 6 October 2020 and continued to hold it up to the commencement date` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE NOTHING (JUST (Date 5 10 2020)) (JUST (Date 31 5 2022)) NOTHING FALSE) (Date 1 6 2022) EQUALS JUST FALSE
#ASSERT `reg 42(2)(b)(iii)(aaa) the trustees acquired an interest in land before 6 October 2020 and continued to hold it up to the commencement date` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE NOTHING NOTHING NOTHING NOTHING FALSE) (Date 1 6 2022) EQUALS JUST FALSE

-- the definition: arguments: the record; the (c) answer; the Schedule 3A answer (S-18); an EEA registered trust; the commencement date (TEST VALUE)
-- (i) a UK trust which is an express trust
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
-- a UK trust that is not an express trust, and nothing else: no
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` FALSE FALSE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST FALSE
-- (ii) a non-UK express trust with income from a UK source, liable to the taxes
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE TRUE FALSE TRUE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
-- (ii) with assets in the UK
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE TRUE TRUE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
-- (ii) income but not liable to any of the taxes: not (ii); not (iii) either
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE TRUE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST FALSE
-- (iii)(aa) a non-UK express trust, not listed in Schedule 3A, whose trustees acquire an interest in land
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST TRUE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
-- listed in Schedule 3A: not (iii)
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST TRUE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST FALSE
-- the Schedule 3A answer has not been given: not answered
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST TRUE) NOTHING NOTHING (JUST FALSE) FALSE) (JUST FALSE) NOTHING (JUST FALSE) (Date 1 6 2022) EQUALS NOTHING
-- (iii)(aaa) acquired on 5 October 2020 and still held
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST FALSE) (JUST (Date 5 10 2020)) NOTHING (JUST FALSE) FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
-- (iii)(bb) a business relationship, a trustee resident in the United Kingdom, not an EEA registered trust
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST TRUE) TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST TRUE
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST TRUE) TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (Date 1 6 2022) EQUALS JUST FALSE
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE FALSE FALSE FALSE (JUST FALSE) NOTHING NOTHING (JUST TRUE) FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS JUST FALSE
-- whether the trust is a UK trust has not been answered: nothing unless a limb that does not need it holds
#ASSERT `reg 42(2)(b) the trust is a relevant trust` (`reg 42(2)(b) test trust` TRUE TRUE FALSE TRUE (JUST FALSE) NOTHING NOTHING (JUST FALSE) FALSE) NOTHING (JUST FALSE) (JUST FALSE) (Date 1 6 2022) EQUALS NOTHING
-- (1)
#ASSERT `reg 42(1) this Part applies to the person` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `reg 42(1) this Part applies to the person` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 42(1) this Part applies to the person` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 42(1) this Part applies to the person` NOTHING NOTHING EQUALS NOTHING

§ `Regulation 43 -- Corporate bodies: obligations`

#ASSERT `reg 43(9) the transaction is a relevant transaction` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 43(9) the transaction is a relevant transaction` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 43(9) the transaction is a relevant transaction` NOTHING EQUALS NOTHING

-- generated tests for the entries of reg 43(1) (expected wording read from the raw text by line number)
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(i) its name, registered number, registered office and principal place` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(i) its name, registered number, registered office and principal place` EQUALS JUST "its name, registered number, registered office and principal place of business"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(ii) its board of directors, or if there is no board, the members` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(ii) its board of directors, or if there is no board, the members` EQUALS JUST "its board of directors, or if there is no board, the members of the equivalent management body"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(iii) the senior persons responsible for its operations` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(iii) the senior persons responsible for its operations` EQUALS JUST "the senior persons responsible for its operations"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(iv) the law to which it is subject` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(iv) the law to which it is subject` EQUALS JUST "the law to which it is subject"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(v) its legal owners` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(v) its legal owners` EQUALS JUST "its legal owners"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(a)(vi) its beneficial owners` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(a)(vi) its beneficial owners` EQUALS JUST "its beneficial owners"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1)(b) its articles of association or other governing documents` EQUALS JUST TRUE
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1)(b) its articles of association or other governing documents` EQUALS JUST "its articles of association or other governing documents"
#ASSERT `reg 43(1) the item must be provided to the relevant person` `reg 43(1) another item` EQUALS NOTHING
#ASSERT `reg 43(1) the wording of the entry` `reg 43(1) another item` EQUALS NOTHING

-- (1) arguments: relevant person (S-8); a UK body corporate; listed on a regulated market; enters into a transaction; the relevant transaction answer (S-1); forms a business relationship; the business relationship answer (S-K1); the item
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1)(a)(i) its name, registered number, registered office and principal place` TRUE EQUALS JUST TRUE
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE FALSE (JUST FALSE) TRUE (JUST TRUE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS JUST TRUE
-- listed on a regulated market: the duty is of a body "which is not listed"
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS NOTHING
-- a transaction that is not a relevant transaction, and no business relationship formed
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST FALSE) FALSE (JUST FALSE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS JUST FALSE
-- the other party is not a relevant person
-- (the next three: the "when" clause is not met, so no; "when" counts as "where", ruling of 2026-11-05)
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST FALSE) (JUST TRUE) FALSE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS JUST FALSE
-- not a UK body corporate
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST FALSE) FALSE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS JUST FALSE
-- an answer the duty depends on has not been given
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE TRUE NOTHING FALSE (JUST FALSE) `reg 43(1)(b) its articles of association or other governing documents` TRUE EQUALS NOTHING
-- no request from the relevant person: "on request from the relevant person" is not met; the paragraph says nothing of what is provided without one (fork F43-3)
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1)(a)(i) its name, registered number, registered office and principal place` FALSE EQUALS NOTHING
-- an item the list does not name
#ASSERT `reg 43(1) the body corporate must on request provide the item to the relevant person` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST TRUE) FALSE (JUST FALSE) `reg 43(1) another item` TRUE EQUALS NOTHING
-- (2)
#ASSERT `reg 43(2) the person is within the references to the legal owners and beneficial owners of the UK body corporate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 43(2) the person is within the references to the legal owners and beneficial owners of the UK body corporate` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 43(2) the person is within the references to the legal owners and beneficial owners of the UK body corporate` FALSE FALSE EQUALS NOTHING
-- (3): no person qualifies as a beneficial owner of the UK body corporate or of an owning body corporate
#ASSERT `reg 43(3) paragraph (1)(a)(vi) does not apply` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 43(3) paragraph (1)(a)(vi) does not apply` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 43(3) paragraph (1)(a)(vi) does not apply` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 43(3) paragraph (1)(a)(vi) does not apply` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 43(3) paragraph (1)(a)(vi) does not apply` (JUST FALSE) NOTHING EQUALS NOTHING
-- (4) arguments: a UK body corporate; business relationship (S-K1); a change
#ASSERT `reg 43(4) the UK body corporate must notify the relevant person of the change and the date on which it occurred` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 43(4) the UK body corporate must notify the relevant person of the change and the date on which it occurred` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 43(4) the UK body corporate must notify the relevant person of the change and the date on which it occurred` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 43(4) the UK body corporate must notify the relevant person of the change and the date on which it occurred` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `reg 43(4) the UK body corporate must notify the relevant person of the change and the date on which it occurred` NOTHING (JUST TRUE) TRUE EQUALS NOTHING
-- the last day: aware on 1 March 2021, fourteen days from that date, the 15th (fork F43-1)
#ASSERT `reg 43(4) the last day for the notification` (Date 1 3 2021) EQUALS Date 15 3 2021
#ASSERT `reg 43(4) the last day for the notification` (Date 20 12 2020) EQUALS Date 3 1 2021
-- arguments: the date notified (MAYBE); the date aware; the date asked
#ASSERT `reg 43(4) the notification was given within fourteen days` (JUST (Date 15 3 2021)) (Date 1 3 2021) (Date 20 3 2021) EQUALS JUST TRUE
#ASSERT `reg 43(4) the notification was given within fourteen days` (JUST (Date 16 3 2021)) (Date 1 3 2021) (Date 20 3 2021) EQUALS JUST FALSE
#ASSERT `reg 43(4) the notification was given within fourteen days` NOTHING (Date 1 3 2021) (Date 15 3 2021) EQUALS NOTHING
#ASSERT `reg 43(4) the notification was given within fourteen days` NOTHING (Date 1 3 2021) (Date 16 3 2021) EQUALS JUST FALSE
-- (5) arguments: a UK body corporate; the request is made by a law enforcement authority
#ASSERT `reg 43(5) the UK body corporate must provide all or part of the information to the law enforcement authority on request` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 43(5) the UK body corporate must provide all or part of the information to the law enforcement authority on request` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 43(5) the UK body corporate must provide all or part of the information to the law enforcement authority on request` (JUST TRUE) NOTHING EQUALS NOTHING
-- (6) arguments: the date provided; the last day of the period specified; the date asked
#ASSERT `reg 43(6) the information was provided before the end of the period specified by the law enforcement authority` (JUST (Date 10 5 2021)) (Date 10 5 2021) (Date 20 5 2021) EQUALS JUST TRUE
#ASSERT `reg 43(6) the information was provided before the end of the period specified by the law enforcement authority` (JUST (Date 11 5 2021)) (Date 10 5 2021) (Date 20 5 2021) EQUALS JUST FALSE
#ASSERT `reg 43(6) the information was provided before the end of the period specified by the law enforcement authority` NOTHING (Date 10 5 2021) (Date 10 5 2021) EQUALS NOTHING
#ASSERT `reg 43(6) the information was provided before the end of the period specified by the law enforcement authority` NOTHING (Date 10 5 2021) (Date 11 5 2021) EQUALS JUST FALSE
-- (7), (8)
#ASSERT `reg 43(7) the provision of information is not to be taken to breach a restriction on disclosure` TRUE EQUALS JUST TRUE
#ASSERT `reg 43(7) the provision of information is not to be taken to breach a restriction on disclosure` FALSE EQUALS NOTHING
#ASSERT `reg 43(8) no civil liability arises in respect of the disclosure on the part of the UK body corporate` TRUE EQUALS JUST TRUE
#ASSERT `reg 43(8) no civil liability arises in respect of the disclosure on the part of the UK body corporate` FALSE EQUALS JUST FALSE

§ `Regulation 44 -- Trustee obligations`

-- generated tests for the entries of reg 44(10) (expected wording read from the raw text by line number)
#ASSERT `reg 44(10) the body is a law enforcement authority` `reg 44(10)(a) the Commissioners` EQUALS JUST TRUE
#ASSERT `reg 44(10) the wording of the entry` `reg 44(10)(a) the Commissioners` EQUALS JUST "the Commissioners"
#ASSERT `reg 44(10) the body is a law enforcement authority` `reg 44(10)(b) the FCA` EQUALS JUST TRUE
#ASSERT `reg 44(10) the wording of the entry` `reg 44(10)(b) the FCA` EQUALS JUST "the FCA"
#ASSERT `reg 44(10) the body is a law enforcement authority` `reg 44(10)(c) the NCA` EQUALS JUST TRUE
#ASSERT `reg 44(10) the wording of the entry` `reg 44(10)(c) the NCA` EQUALS JUST "the NCA"
#ASSERT `reg 44(10) the body is a law enforcement authority` `reg 44(10)(d) police forces maintained under section 2 of the Police Act 1996` EQUALS JUST TRUE
