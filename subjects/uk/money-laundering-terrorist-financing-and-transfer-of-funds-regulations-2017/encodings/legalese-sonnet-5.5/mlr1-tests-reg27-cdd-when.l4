IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg10-14a-kinds`
IMPORT `mlr1-reg27-cdd-when`

-- TESTS for regulation 27.  Expected values are written from the text (the line named in each heading).  Inputs are positional, in the
-- order of the function's GIVEN.  A transaction is `Transaction OF value, paid in cash, part of a business relationship, transfer of funds`.

§ `reg 27(1)(a): establishes a business relationship (src:765-769)`
-- arguments: the answer of regulation 4 (seam S-K1); the relevant person establishes that relationship
#ASSERT `reg 27(1)(a) the relevant person establishes a business relationship` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 27(1)(a) the relevant person establishes a business relationship` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 27(1)(a) the relevant person establishes a business relationship` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 27(1)(a) the relevant person establishes a business relationship` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 27(1)(a) the relevant person establishes a business relationship` NOTHING FALSE EQUALS JUST FALSE

§ `reg 27(1)(b) to (d): transfer of funds over 800 pounds, suspicion, doubt (src:767-769)`
#ASSERT `the transfer threshold of 800 pounds sterling` EQUALS 800
#ASSERT `reg 27(1)(b) the relevant person carries out an occasional transaction that is a transfer of funds exceeding 800 pounds` (Transaction OF 801, FALSE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `reg 27(1)(b) the relevant person carries out an occasional transaction that is a transfer of funds exceeding 800 pounds` (Transaction OF 800, FALSE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `reg 27(1)(b) the relevant person carries out an occasional transaction that is a transfer of funds exceeding 800 pounds` (Transaction OF 5000, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `reg 27(1)(b) the relevant person carries out an occasional transaction that is a transfer of funds exceeding 800 pounds` (Transaction OF 5000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(1)(c) the relevant person suspects money laundering or terrorist financing` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(1)(c) the relevant person suspects money laundering or terrorist financing` FALSE EQUALS JUST FALSE
#ASSERT `reg 27(1)(d) the relevant person doubts the veracity or adequacy of documents or information previously obtained` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(1)(d) the relevant person doubts the veracity or adequacy of documents or information previously obtained` FALSE EQUALS JUST FALSE

§ `reg 27(2): occasional transactions of 12000 pounds or more (src:770)`
#ASSERT `reg 27(2) the amount of 12000 pounds sterling` EQUALS 12000
-- arguments: the kinds of the relevant person; the transaction
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `estate agent`) (Transaction OF 12000, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `credit institution`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `estate agent`) (Transaction OF 11999, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `estate agent`) (Transaction OF 20000, FALSE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `letting agent`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `high value dealer`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `art market participant`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `cryptoasset exchange provider`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `custodian wallet provider`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `casino`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(2) the relevant person carries out an occasional transaction of 12000 pounds or more` (LIST `estate agent`, `high value dealer`) (Transaction OF 20000, FALSE, FALSE, FALSE) EQUALS JUST FALSE

§ `reg 27(3) and (4): high value dealers and cash (src:771-774)`
#ASSERT `reg 27(3) the cash amount of 10000 pounds sterling` EQUALS 10000
-- (4) arguments: paid in cash; paid to a person other than the other party for its benefit; paid into a bank account for its benefit
#ASSERT `reg 27(4) the transaction is a transaction in cash for the purposes of paragraph (3)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 27(4) the transaction is a transaction in cash for the purposes of paragraph (3)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 27(4) the transaction is a transaction in cash for the purposes of paragraph (3)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 27(4) the transaction is a transaction in cash for the purposes of paragraph (3)` FALSE FALSE FALSE EQUALS JUST FALSE
-- (3) arguments: the kinds; the transaction; the answer for paragraph (4)
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `high value dealer`) (Transaction OF 10000, TRUE, FALSE, FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `high value dealer`) (Transaction OF 9999, TRUE, FALSE, FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `estate agent`) (Transaction OF 10000, TRUE, FALSE, FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `high value dealer`) (Transaction OF 10000, TRUE, TRUE, FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `high value dealer`) (Transaction OF 10000, FALSE, FALSE, FALSE) NOTHING EQUALS NOTHING
-- a transaction with no cash at all is not "in cash" (reg 3(1): cash is notes, coins or travellers' cheques), so paragraph (3) answers FALSE
#ASSERT `reg 27(3) the high value dealer carries out an occasional transaction in cash of 10000 pounds or more` (LIST `high value dealer`) (Transaction OF 10000, FALSE, FALSE, FALSE) (JUST FALSE) EQUALS JUST FALSE

§ `reg 27(5) to (7): casinos (src:775-782)`
#ASSERT `reg 27(5) the amount of 2000 pounds sterling` EQUALS 2000
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(a) the wagering of a stake` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(a)(i) the purchase from, or exchange with, the casino of tokens for use in gambling at the casino` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(a)(ii) payment for use of gaming machines` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(a)(iii) the deposit of funds required to take part in remote gambling` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(b) the collection of winnings` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6)(b) the withdrawal of funds deposited to take part in remote gambling or winnings arising from the staking of such funds` EQUALS JUST TRUE
#ASSERT `reg 27(6) the transaction is within this paragraph` `reg 27(6) another transaction` EQUALS JUST FALSE
-- (7) arguments: the amount; the uncollected winnings re-used in the transaction
#ASSERT `reg 27(7) the amount of the transaction for the purposes of paragraph (5)` 2500 500 EQUALS 2000
#ASSERT `reg 27(7) the amount of the transaction for the purposes of paragraph (5)` 2000 0 EQUALS 2000
#ASSERT `reg 27(7) the amount of the transaction for the purposes of paragraph (5)` 2500 501 EQUALS 1999
-- (5) arguments: the kinds; the answer for paragraph (6); the amount counted under paragraph (7)
#ASSERT `reg 27(5) the casino carries out a transaction within paragraph (6) of 2000 pounds or more` (LIST `casino`) (JUST TRUE) 2000 EQUALS JUST TRUE
#ASSERT `reg 27(5) the casino carries out a transaction within paragraph (6) of 2000 pounds or more` (LIST `casino`) (JUST TRUE) 1999 EQUALS JUST FALSE
#ASSERT `reg 27(5) the casino carries out a transaction within paragraph (6) of 2000 pounds or more` (LIST `casino`) (JUST FALSE) 5000 EQUALS JUST FALSE
#ASSERT `reg 27(5) the casino carries out a transaction within paragraph (6) of 2000 pounds or more` (LIST `casino`) NOTHING 5000 EQUALS NOTHING
#ASSERT `reg 27(5) the casino carries out a transaction within paragraph (6) of 2000 pounds or more` (LIST `high value dealer`) (JUST TRUE) 5000 EQUALS JUST FALSE

§ `reg 27(7A) and (7B): letting agents (src:783-786)`
-- arguments: the kinds; the transaction; consists of concluding a letting agreement; the term in months; the highest monthly rent
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, FALSE, FALSE) TRUE 1 10000 EQUALS JUST TRUE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, FALSE, FALSE) TRUE 12 25000 EQUALS JUST TRUE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, FALSE, FALSE) TRUE 0 10000 EQUALS JUST FALSE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, FALSE, FALSE) TRUE 12 9999 EQUALS JUST FALSE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, FALSE, FALSE) FALSE 12 10000 EQUALS JUST FALSE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `estate agent`) (Transaction OF 0, FALSE, FALSE, FALSE) TRUE 12 10000 EQUALS JUST FALSE
#ASSERT `reg 27(7A) the letting agent concludes an agreement for the letting of land for a month or more at a monthly rent of 10000 pounds or more` (LIST `letting agent`) (Transaction OF 0, FALSE, TRUE, FALSE) TRUE 12 10000 EQUALS JUST FALSE
#ASSERT `reg 27(7B) the letting agent must apply customer due diligence measures in relation to the party` `reg 27(7B) the person by whom the land is being let` EQUALS JUST TRUE
#ASSERT `reg 27(7B) the letting agent must apply customer due diligence measures in relation to the party` `reg 27(7B) the person who is renting the land` EQUALS JUST TRUE
#ASSERT `reg 27(7B) the letting agent must apply customer due diligence measures in relation to the party` `reg 27(7B) another person` EQUALS NOTHING

§ `reg 27(7C): art market participants (src:787-789)`
-- (a) arguments: the kinds; the transaction; the transaction is a trade in a work of art
#ASSERT `reg 27(7C)(a) the art market participant carries out or acts in respect of an occasional transaction in a work of art of 10000 pounds or more` (LIST `art market participant`) (Transaction OF 10000, FALSE, FALSE, FALSE) TRUE EQUALS JUST TRUE
#ASSERT `reg 27(7C)(a) the art market participant carries out or acts in respect of an occasional transaction in a work of art of 10000 pounds or more` (LIST `art market participant`) (Transaction OF 9999, FALSE, FALSE, FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 27(7C)(a) the art market participant carries out or acts in respect of an occasional transaction in a work of art of 10000 pounds or more` (LIST `art market participant`) (Transaction OF 20000, FALSE, FALSE, FALSE) FALSE EQUALS JUST FALSE
#ASSERT `reg 27(7C)(a) the art market participant carries out or acts in respect of an occasional transaction in a work of art of 10000 pounds or more` (LIST `estate agent`) (Transaction OF 20000, FALSE, FALSE, FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 27(7C)(a) the art market participant carries out or acts in respect of an occasional transaction in a work of art of 10000 pounds or more` (LIST `art market participant`) (Transaction OF 20000, FALSE, TRUE, FALSE) TRUE EQUALS JUST FALSE
-- (b) arguments: the kinds; the operator of a freeport; the value stored
#ASSERT `reg 27(7C)(b) the art market participant is the operator of a freeport storing works of art of 10000 pounds or more` (LIST `art market participant`) TRUE 10000 EQUALS JUST TRUE
#ASSERT `reg 27(7C)(b) the art market participant is the operator of a freeport storing works of art of 10000 pounds or more` (LIST `art market participant`) TRUE 9999 EQUALS JUST FALSE
#ASSERT `reg 27(7C)(b) the art market participant is the operator of a freeport storing works of art of 10000 pounds or more` (LIST `art market participant`) FALSE 20000 EQUALS JUST FALSE
#ASSERT `reg 27(7C)(b) the art market participant is the operator of a freeport storing works of art of 10000 pounds or more` (LIST `estate agent`) TRUE 20000 EQUALS JUST FALSE

§ `reg 27(7D) and (7E): cryptoasset businesses (src:790-791)`
-- (7D) arguments: the kinds; operates a machine; the transaction is carried out using that machine
#ASSERT `reg 27(7D) the cryptoasset exchange provider carries out a transaction using its machine` (LIST `cryptoasset exchange provider`) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 27(7D) the cryptoasset exchange provider carries out a transaction using its machine` (LIST `cryptoasset exchange provider`) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 27(7D) the cryptoasset exchange provider carries out a transaction using its machine` (LIST `cryptoasset exchange provider`) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 27(7D) the cryptoasset exchange provider carries out a transaction using its machine` (LIST `casino`) TRUE TRUE EQUALS JUST FALSE
-- (7E) arguments: the kinds; the cryptoasset transfer
#ASSERT `reg 27(7E) the cryptoasset exchange provider or custodian wallet provider carries out a cryptoasset transfer of 800 pounds or more` (LIST `cryptoasset exchange provider`) (`Cryptoasset transfer` OF `an inter-cryptoasset business transfer`, 800) EQUALS JUST TRUE
#ASSERT `reg 27(7E) the cryptoasset exchange provider or custodian wallet provider carries out a cryptoasset transfer of 800 pounds or more` (LIST `custodian wallet provider`) (`Cryptoasset transfer` OF `an unhosted wallet transfer`, 5000) EQUALS JUST TRUE
#ASSERT `reg 27(7E) the cryptoasset exchange provider or custodian wallet provider carries out a cryptoasset transfer of 800 pounds or more` (LIST `cryptoasset exchange provider`) (`Cryptoasset transfer` OF `an inter-cryptoasset business transfer`, 799) EQUALS JUST FALSE
#ASSERT `reg 27(7E) the cryptoasset exchange provider or custodian wallet provider carries out a cryptoasset transfer of 800 pounds or more` (LIST `casino`) (`Cryptoasset transfer` OF `an unhosted wallet transfer`, 5000) EQUALS JUST FALSE

§ `reg 27(8): existing customers (src:792-798)`
#ASSERT `reg 27(8)(za) the relevant person has a legal duty to contact an existing customer to review beneficial ownership information` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(8)(za) the relevant person has a legal duty to contact an existing customer to review beneficial ownership information` FALSE EQUALS JUST FALSE
#ASSERT `reg 27(8)(zb) the relevant person has to contact an existing customer to fulfil a duty under the International Tax Compliance Regulations 2015` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(8)(zb) the relevant person has to contact an existing customer to fulfil a duty under the International Tax Compliance Regulations 2015` FALSE EQUALS JUST FALSE
#ASSERT `reg 27(8)(a) it is an appropriate time to apply customer due diligence measures to existing customers` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(8)(a) it is an appropriate time to apply customer due diligence measures to existing customers` FALSE EQUALS JUST FALSE
#ASSERT `reg 27(8)(b) the relevant person becomes aware that the circumstances of an existing customer have changed` TRUE EQUALS JUST TRUE
#ASSERT `reg 27(8)(b) the relevant person becomes aware that the circumstances of an existing customer have changed` FALSE EQUALS JUST FALSE

§ `reg 27(9): factors for existing customers (src:799-803)`
#ASSERT `reg 27(9) the relevant person has taken into account what paragraph (9) requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 27(9) the relevant person has taken into account what paragraph (9) requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 27(9) the relevant person has taken into account what paragraph (9) requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 27(9) the relevant person has taken into account what paragraph (9) requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 27(9) the relevant person has taken into account what paragraph (9) requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `reg 27(10): pointers to regulation 64B (src:804)`
#ASSERT `reg 27(10) the thing is a cryptoasset` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 27(10) the thing is a cryptoasset` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(10) the thing is a cryptoasset` NOTHING EQUALS NOTHING
#ASSERT `reg 27(10) the transfer is a cryptoasset transfer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 27(10) the transfer is a cryptoasset transfer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 27(10) the transfer is a cryptoasset transfer` NOTHING EQUALS NOTHING

§ `reg 27: the relevant person is required to apply customer due diligence measures, seam S-1 (src:764)`
#ASSERT `reg 27 the relevant person is required to apply customer due diligence measures` (LIST JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 27 the relevant person is required to apply customer due diligence measures` (LIST JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 27 the relevant person is required to apply customer due diligence measures` (LIST JUST FALSE, JUST FALSE, JUST FALSE, NOTHING, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS NOTHING
#ASSERT `reg 27 the relevant person is required to apply customer due diligence measures` (LIST NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, JUST TRUE, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING) EQUALS JUST TRUE
