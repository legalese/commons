IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr3-cryptoasset-transfers`

-- TESTS for mlr3-cryptoasset-transfers.l4 (regs 64A to 64H).  Every expected value is written
-- here from the text of the regulation named beside it, before the code was run.  A #TRACE is not
-- an assertion, so each carries its outcome in an `-- EXPECT` comment that tracecheck.py reads.
-- The working-day tests use Easter 2026: Thursday 2 April; Good Friday 3 April; Easter Monday
-- 6 April (a bank holiday in England and Wales and in Northern Ireland).

§ `Tests -- regs 64A to 64H`

`reg 64A test the Good Fridays in the tests`   MEANS LIST (Date 3 4 2026)
`reg 64A test the bank holidays in the tests`  MEANS LIST (Date 6 4 2026)

§§ `reg 64A`

#ASSERT `reg 64A(2) this Part applies in respect of the transfer` TRUE EQUALS JUST FALSE
#ASSERT `reg 64A(2) this Part applies in respect of the transfer` FALSE EQUALS NOTHING
#ASSERT `reg 64A(3) this Part applies to the cryptoasset transfer` TRUE EQUALS JUST FALSE
#ASSERT `reg 64A(3) this Part applies to the cryptoasset transfer` FALSE EQUALS NOTHING
#ASSERT `reg 64A(3) paragraph (3) excludes the cryptoasset transfer from this Part` TRUE EQUALS JUST TRUE
#ASSERT `reg 64A(3) paragraph (3) excludes the cryptoasset transfer from this Part` FALSE EQUALS JUST FALSE
#ASSERT `reg 64A(1) this Part applies in respect of the cryptoasset transfer` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `reg 64A(1) this Part applies in respect of the cryptoasset transfer` (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `reg 64A(1) this Part applies in respect of the cryptoasset transfer` (JUST TRUE) NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 64A(1) this Part applies in respect of the cryptoasset transfer` (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
#ASSERT `reg 64A(1) this Part applies in respect of the cryptoasset transfer` NOTHING NOTHING NOTHING EQUALS NOTHING

