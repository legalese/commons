    IF `the FCA published information in accordance with paragraphs (2) to (8)`
    THEN JUST TRUE
    ELSE JUST FALSE -- FALSE-kind (the text says no in its own words): "Where the FCA publishes information in accordance with paragraphs (2) to (8)" [ruled 2026-11-05 (b) where]
@ref reg 84(10) (src:2620)
