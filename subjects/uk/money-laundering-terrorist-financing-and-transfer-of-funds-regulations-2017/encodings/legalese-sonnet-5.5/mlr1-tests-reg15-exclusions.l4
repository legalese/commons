IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg15-exclusions`

-- TESTS for regulation 15.  Every expected value is written from the text of the regulation (the line named in the
-- comment), not from what the module computes.  Inputs are positional, in the order of the function's GIVEN.

§ `reg 15(3)(a): turnover (src:391)`
#ASSERT `reg 15(3)(a) the turnover limit of 100000 pounds sterling` EQUALS 100000
#ASSERT `reg 15(3)(a) the turnover in respect of the financial activity is within the limit` 100000 EQUALS JUST TRUE
#ASSERT `reg 15(3)(a) the turnover in respect of the financial activity is within the limit` 99999 EQUALS JUST TRUE
#ASSERT `reg 15(3)(a) the turnover in respect of the financial activity is within the limit` 0 EQUALS JUST TRUE
#ASSERT `reg 15(3)(a) the turnover in respect of the financial activity is within the limit` 100001 EQUALS JUST FALSE

§ `reg 15(3)(b): one transaction exceeding 1000 pounds with any customer (src:392)`
#ASSERT `reg 15(3)(b) the transaction size of 1000 pounds sterling` EQUALS 1000
#ASSERT `reg 15(3)(b) the financial activity is limited in relation to any customer to no more than one transaction exceeding 1000 pounds sterling` 0 EQUALS JUST TRUE
#ASSERT `reg 15(3)(b) the financial activity is limited in relation to any customer to no more than one transaction exceeding 1000 pounds sterling` 1 EQUALS JUST TRUE
#ASSERT `reg 15(3)(b) the financial activity is limited in relation to any customer to no more than one transaction exceeding 1000 pounds sterling` 2 EQUALS JUST FALSE

§ `reg 15(3)(c): not more than 5% of total turnover (src:393)`
#ASSERT `reg 15(3)(c) the share of 5 per cent` EQUALS 5
-- arguments: turnover from the financial activity; the person's total annual turnover
#ASSERT `reg 15(3)(c) the financial activity does not exceed 5 per cent of the person's total annual turnover` 5000 100000 EQUALS JUST TRUE
#ASSERT `reg 15(3)(c) the financial activity does not exceed 5 per cent of the person's total annual turnover` 4999 100000 EQUALS JUST TRUE
#ASSERT `reg 15(3)(c) the financial activity does not exceed 5 per cent of the person's total annual turnover` 5001 100000 EQUALS JUST FALSE
#ASSERT `reg 15(3)(c) the financial activity does not exceed 5 per cent of the person's total annual turnover` 0 100000 EQUALS JUST TRUE

§ `reg 15(3)(d) and (e): ancillary; not remittance (src:394-395)`
#ASSERT `reg 15(3)(d) the financial activity is ancillary and directly related to the person's main activity` TRUE EQUALS JUST TRUE
#ASSERT `reg 15(3)(d) the financial activity is ancillary and directly related to the person's main activity` FALSE EQUALS JUST FALSE
#ASSERT `reg 15(3)(e) the financial activity is not the transmission or remittance of money` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(3)(e) the financial activity is not the transmission or remittance of money` TRUE EQUALS JUST FALSE

§ `reg 15(3)(f): main activity (src:396)`
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `credit institution` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `financial institution` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `auditor` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `insolvency practitioner` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `external accountant` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `tax adviser` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `independent legal professional` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `trust or company service provider` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `estate agent` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `letting agent` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `casino` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `art market participant` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `cryptoasset exchange provider` EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `custodian wallet provider` EQUALS JUST TRUE
-- (g) is high value dealers, which lies between the two ranges
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `high value dealer` EQUALS JUST FALSE
#ASSERT `reg 15(3)(f) the kind of main activity falls within regulation 8(2)(a) to (f) or (h) to (k)` `auction platform` EQUALS NOTHING
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` (LIST `high value dealer`) EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` EMPTY EQUALS JUST TRUE
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` (LIST `high value dealer`, `casino`) EQUALS JUST FALSE
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` (LIST `estate agent`) EQUALS JUST FALSE
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` (LIST `auction platform`) EQUALS NOTHING
#ASSERT `reg 15(3)(f) the person's main activity is not that of a person falling within regulation 8(2)(a) to (f) or (h) to (k)` (LIST `auction platform`, `casino`) EQUALS JUST FALSE

§ `reg 15(3)(g): only to customers, not offered to the public (src:397)`
-- arguments: provided only to customers of the main activity; offered to the public
#ASSERT `reg 15(3)(g) the financial activity is provided only to customers of the main activity and is not offered to the public` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 15(3)(g) the financial activity is provided only to customers of the main activity and is not offered to the public` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 15(3)(g) the financial activity is provided only to customers of the main activity and is not offered to the public` FALSE FALSE EQUALS JUST FALSE

§ `reg 15(3): all the conditions (src:390-397)`
#ASSERT `reg 15(3) the person engages in financial activity on an occasional or very limited basis` (LIST JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 15(3) the person engages in financial activity on an occasional or very limited basis` (LIST JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 15(3) the person engages in financial activity on an occasional or very limited basis` (LIST JUST TRUE, NOTHING, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE, JUST TRUE) EQUALS NOTHING

§ `reg 15(1)(a) and (b): societies (src:377-383)`
-- arguments: is a registered society; issues withdrawable share capital within the limit; accepts deposits within the limit
#ASSERT `reg 15(1)(a) the Parts do not apply to the registered society` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 15(1)(a) the Parts do not apply to the registered society` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(a) the Parts do not apply to the registered society` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 15(1)(a) the Parts do not apply to the registered society` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 15(1)(b) the Parts do not apply to the society registered in Northern Ireland` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 15(1)(b) the Parts do not apply to the society registered in Northern Ireland` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(b) the Parts do not apply to the society registered in Northern Ireland` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 15(1)(b) the Parts do not apply to the society registered in Northern Ireland` FALSE TRUE TRUE EQUALS JUST FALSE

§ `reg 15(1)(c): persons specified in the Exemption Order (src:384)`
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 1 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 2 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 23 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 24 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 25 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 26 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 38 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 39 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 40 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 49 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 50 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 57 EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 58 EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the paragraph of the Schedule is one of those named` 59 EQUALS JUST FALSE
-- arguments: is specified in a paragraph; that paragraph is one named; carrying out an activity for which it is exempt
#ASSERT `reg 15(1)(c) the Parts do not apply to the person specified in the Exemption Order` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(c) the Parts do not apply to the person specified in the Exemption Order` TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 15(1)(c) the Parts do not apply to the person specified in the Exemption Order` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the Parts do not apply to the person specified in the Exemption Order` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `reg 15(1)(c) the Parts do not apply to the person specified in the Exemption Order` TRUE NOTHING TRUE EQUALS NOTHING

§ `reg 15(1)(d) to (g): local authority, former exempted person, high value dealer, home report (src:385-388)`
-- (d) arguments: is a local authority; carrying on an activity that would be regulated but for article 72G
#ASSERT `reg 15(1)(d) the Parts do not apply to the local authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(d) the Parts do not apply to the local authority` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 15(1)(d) the Parts do not apply to the local authority` FALSE TRUE EQUALS JUST FALSE
-- (e) arguments: was an exempted person immediately before the repeal; exercising the functions specified in section 45
#ASSERT `reg 15(1)(e) the Parts do not apply to the person who was an exempted person under the Financial Services Act 1986` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(e) the Parts do not apply to the person who was an exempted person under the Financial Services Act 1986` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 15(1)(e) the Parts do not apply to the person who was an exempted person under the Financial Services Act 1986` FALSE TRUE EQUALS JUST FALSE
-- (f) arguments: main activity is that of a high value dealer; the answer for paragraph (3)
#ASSERT `reg 15(1)(f) the Parts do not apply to the high value dealer` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 15(1)(f) the Parts do not apply to the high value dealer` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 15(1)(f) the Parts do not apply to the high value dealer` TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 15(1)(f) the Parts do not apply to the high value dealer` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (g)
#ASSERT `reg 15(1)(g) the Parts do not apply to the person preparing a home report` TRUE EQUALS JUST TRUE
#ASSERT `reg 15(1)(g) the Parts do not apply to the person preparing a home report` FALSE EQUALS JUST FALSE

§ `reg 15(1): which Parts (src:377)`
#ASSERT `reg 15(1) the Part is one of those that do not apply` 1 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 3 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 4 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 5 EQUALS NOTHING
#ASSERT `reg 15(1) the Part is one of those that do not apply` 6 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 7 EQUALS NOTHING
#ASSERT `reg 15(1) the Part is one of those that do not apply` 8 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 11 EQUALS JUST TRUE
#ASSERT `reg 15(1) the Part is one of those that do not apply` 12 EQUALS NOTHING

§ `reg 15(2): solely as a result of occasional financial activity (src:389)`
-- arguments: falls within regulation 8 solely as a result of the financial activity; the answer for paragraph (3)
#ASSERT `reg 15(2) the Regulations do not apply to the person who falls within regulation 8 solely as a result of financial activity` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 15(2) the Regulations do not apply to the person who falls within regulation 8 solely as a result of financial activity` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 15(2) the Regulations do not apply to the person who falls within regulation 8 solely as a result of financial activity` TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 15(2) the Regulations do not apply to the person who falls within regulation 8 solely as a result of financial activity` FALSE (JUST TRUE) EQUALS NOTHING

§ `reg 15(4): bodies and the Parts they are outside (src:398-405)`
-- arguments: the body; the Official Solicitor is acting as trustee in his or her official capacity
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(a) the Auditor General for Scotland` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(b) the Auditor General for Wales` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(c) the Bank of England` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(d) the Comptroller and Auditor General` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(e) the Comptroller and Auditor General for Northern Ireland` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(f) the Official Solicitor to the Supreme Court` TRUE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(f) the Official Solicitor to the Supreme Court` FALSE EQUALS NOTHING
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4)(g) the Treasury Solicitor` FALSE EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapters and Parts do not apply to the body` `reg 15(4) another body` TRUE EQUALS JUST FALSE
-- arguments: the Part; the Chapter (0 where the Part has none)
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 2 2 EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 2 3 EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 2 1 EQUALS NOTHING
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 1 0 EQUALS NOTHING
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 3 0 EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 9 0 EQUALS JUST TRUE
#ASSERT `reg 15(4) the Chapter of the Part is one of those that do not apply to the bodies` 10 0 EQUALS NOTHING

§ `reg 15: comes within the exclusions (src:376)`
#ASSERT `reg 15 the person comes within the exclusions` (LIST JUST FALSE, JUST TRUE, NOTHING) EQUALS JUST TRUE
#ASSERT `reg 15 the person comes within the exclusions` (LIST JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 15 the person comes within the exclusions` (LIST JUST FALSE, NOTHING, JUST FALSE) EQUALS NOTHING

§ `reg 15 with reg 8: the exclusion decides relevant-person status (src:236-238, 376)`
-- a bank, carrying on business in the United Kingdom: not excluded, so a relevant person
#ASSERT `reg 8 the person is a relevant person` (LIST `credit institution`) TRUE (`reg 15 the person comes within the exclusions` (LIST JUST FALSE, JUST FALSE, JUST FALSE)) EQUALS JUST TRUE
-- a high value dealer within the occasional-activity limb: excluded, so not a relevant person
#ASSERT `reg 8 the person is a relevant person` (LIST `high value dealer`) TRUE (`reg 15 the person comes within the exclusions` (LIST JUST TRUE, JUST FALSE, JUST FALSE)) EQUALS JUST FALSE
-- a limb that is neither met nor ruled out leaves the answer open
#ASSERT `reg 8 the person is a relevant person` (LIST `high value dealer`) TRUE (`reg 15 the person comes within the exclusions` (LIST NOTHING, JUST FALSE, JUST FALSE)) EQUALS NOTHING
