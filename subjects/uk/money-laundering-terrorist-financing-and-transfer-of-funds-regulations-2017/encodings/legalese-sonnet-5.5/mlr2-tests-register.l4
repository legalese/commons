IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr2-helpers`
IMPORT `mlr2-trusts`
IMPORT `mlr2-register`

-- TESTS for mlr2-register.l4 (regulations 45, 45ZA and 45ZB).  Every expected value is written by hand from the text beside the
-- assertion; none is copied from the encoding's own output.  Each line is one #ASSERT.
-- The "31st January after the tax year" days and the "date on which this paragraph comes into force" days are inputs; the tests use
-- stated TEST VALUES for them (named in the comments) and nothing in the rules depends on those values.

§ `Regulation 45(14) -- taxable relevant trust`

-- generated tests for the entries of reg 45(14) (expected wording read from the raw text by line number)
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(a) income tax` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(a) income tax` EQUALS JUST "income tax"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(b) capital gains tax` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(b) capital gains tax` EQUALS JUST "capital gains tax"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(c) inheritance tax` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(c) inheritance tax` EQUALS JUST "inheritance tax"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(d) stamp duty land tax (within the meaning of section 42 of the Finance` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(d) stamp duty land tax (within the meaning of section 42 of the Finance` EQUALS JUST "stamp duty land tax (within the meaning of section 42 of the Finance Act 2003 )"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(e) land and buildings transaction tax (within the meaning of section 1` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(e) land and buildings transaction tax (within the meaning of section 1` EQUALS JUST "land and buildings transaction tax (within the meaning of section 1 of the Land and Buildings Transaction Tax (Scotland) Act 2013 )"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14)(ea) land transaction tax (within the meaning of section 2 of the Land` EQUALS JUST TRUE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14)(ea) land transaction tax (within the meaning of section 2 of the Land` EQUALS JUST "land transaction tax (within the meaning of section 2 of the Land Transaction Tax and Anti-avoidance of Devolved Taxes (Wales) Act 2017)"
#ASSERT `reg 45(14) the tax is one of the taxes` `reg 45(14) another tax` EQUALS JUST FALSE
#ASSERT `reg 45(14) the wording of the entry` `reg 45(14) another tax` EQUALS NOTHING

-- arguments: the trust is a relevant trust; the taxes the trustees are liable to pay in the year
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` (JUST TRUE) (LIST `reg 45(14)(a) income tax`) EQUALS JUST TRUE
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` (JUST TRUE) (LIST `reg 45(14) another tax`, `reg 45(14)(ea) land transaction tax (within the meaning of section 2 of the Land`) EQUALS JUST TRUE
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` (JUST TRUE) (LIST `reg 45(14) another tax`) EQUALS JUST FALSE
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` (JUST TRUE) EMPTY EQUALS JUST FALSE
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` (JUST FALSE) (LIST `reg 45(14)(a) income tax`) EQUALS JUST FALSE
#ASSERT `reg 45(14) the trust is a taxable relevant trust in the year` NOTHING (LIST `reg 45(14)(a) income tax`) EQUALS NOTHING

§ `Regulation 45(1) to (8) -- the register and the information`

#ASSERT `reg 45(1) the Commissioners must include the person in the register` (JUST TRUE) `reg 45(1)(a) a beneficial owner of a taxable relevant trust` EQUALS JUST TRUE
#ASSERT `reg 45(1) the Commissioners must include the person in the register` (JUST TRUE) `reg 45(1)(b) a potential beneficiary, referred to in regulation 44(5)(b), of a taxable relevant trust` EQUALS JUST TRUE
#ASSERT `reg 45(1) the Commissioners must include the person in the register` (JUST TRUE) `reg 45(1) another person` EQUALS NOTHING
#ASSERT `reg 45(1) the Commissioners must include the person in the register` (JUST FALSE) `reg 45(1)(a) a beneficial owner of a taxable relevant trust` EQUALS NOTHING
#ASSERT `reg 45(1) the Commissioners must include the person in the register` NOTHING `reg 45(1)(a) a beneficial owner of a taxable relevant trust` EQUALS NOTHING

-- (2) arguments: the trust is a taxable relevant trust; the information; the beneficial owners include a class not all determined; the individual is a beneficiary
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(a) the information specified in paragraph (5) in relation to the trust` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(b) the information specified in paragraph (6) in relation to each of the individuals referred to in regulation 44(2)(b) and (5)(b)` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(b) the information specified in paragraph (6) in relation to each of the individuals referred to in regulation 44(2)(b) and (5)(b)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(b) the information specified in paragraph (6) in relation to each of the individuals referred to in regulation 44(2)(b) and (5)(b)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(b) the information specified in paragraph (6) in relation to each of the individuals referred to in regulation 44(2)(b) and (5)(b)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(c) the information specified in paragraph (7) in relation to each of the legal entities referred to in regulation 44(2)(b)` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(d) the information specified in paragraph (8)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST TRUE) `reg 45(2)(d) the information specified in paragraph (8)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(2) the trustees must provide the information` (JUST FALSE) `reg 45(2)(a) the information specified in paragraph (5) in relation to the trust` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 45(2) the trustees must provide the information` NOTHING `reg 45(2)(a) the information specified in paragraph (5) in relation to the trust` FALSE FALSE EQUALS NOTHING

-- generated tests for the entries of reg 45(5) (expected wording read from the raw text by line number)
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(a) the full name of the trust` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(a) the full name of the trust` EQUALS JUST "the full name of the trust"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(b) the date on which the trust was set up` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(b) the date on which the trust was set up` EQUALS JUST "the date on which the trust was set up"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(c) a statement of accounts for the trust, describing the trust assets` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(c) a statement of accounts for the trust, describing the trust assets` EQUALS JUST "a statement of accounts for the trust, describing the trust assets and identifying the value of each category of the trust assets at the date on which the information is first provided to the Commissioners (including the address of any property held by the trust)"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(d) the country where the trust is considered to be resident for tax` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(d) the country where the trust is considered to be resident for tax` EQUALS JUST "the country where the trust is considered to be resident for tax purposes"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(e) the place where the trust is administered` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(e) the place where the trust is administered` EQUALS JUST "the place where the trust is administered"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(f) a contact address for the trustees` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(f) a contact address for the trustees` EQUALS JUST "a contact address for the trustees"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5)(g) the full name of any advisers who are being paid to provide legal` EQUALS JUST TRUE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5)(g) the full name of any advisers who are being paid to provide legal` EQUALS JUST "the full name of any advisers who are being paid to provide legal, financial or tax advice to the trustees in relation to the trust"
#ASSERT `reg 45(5) the item is information specified in paragraph (5)` `reg 45(5) another item` EQUALS JUST FALSE
#ASSERT `reg 45(5) the wording of the entry` `reg 45(5) another item` EQUALS NOTHING

-- generated tests for the entries of reg 45(6) (expected wording read from the raw text by line number)
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(a) the individual's full name` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(a) the individual's full name` EQUALS JUST "the individual's full name"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(b) the individual's national insurance number or unique taxpayer` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(b) the individual's national insurance number or unique taxpayer` EQUALS JUST "the individual's national insurance number or unique taxpayer reference, if any"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(c) if the individual does not have a national insurance number or unique` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(c) if the individual does not have a national insurance number or unique` EQUALS JUST "if the individual does not have a national insurance number or unique taxpayer reference, the individual's usual residential address"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(d) if the address provided under sub-paragraph (c) is not in the United` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(d) if the address provided under sub-paragraph (c) is not in the United` EQUALS JUST "if the address provided under sub-paragraph (c) is not in the United Kingdom— (i) the individual's passport number or identification card number, with the country of issue and the expiry date of the passport or identification card; or (ii) if the individual does not have a passport or identification card, the number, country of issue and expiry date of any equivalent form of identification"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(e) the individual's date of birth` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(e) the individual's date of birth` EQUALS JUST "the individual's date of birth"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6)(f) the nature of the individual's role in relation to the trust` EQUALS JUST TRUE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6)(f) the nature of the individual's role in relation to the trust` EQUALS JUST "the nature of the individual's role in relation to the trust"
#ASSERT `reg 45(6) the item is information specified in paragraph (6)` `reg 45(6) another item` EQUALS JUST FALSE
#ASSERT `reg 45(6) the wording of the entry` `reg 45(6) another item` EQUALS NOTHING

-- generated tests for the entries of reg 45(7) (expected wording read from the raw text by line number)
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(a) the legal entity's corporate or firm name` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(a) the legal entity's corporate or firm name` EQUALS JUST "the legal entity's corporate or firm name"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(b) the legal entity's unique taxpayer reference, if any` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(b) the legal entity's unique taxpayer reference, if any` EQUALS JUST "the legal entity's unique taxpayer reference, if any"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(c) the registered or principal office of the legal entity` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(c) the registered or principal office of the legal entity` EQUALS JUST "the registered or principal office of the legal entity"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(d) the legal form of the legal entity and the law by which it is governed` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(d) the legal form of the legal entity and the law by which it is governed` EQUALS JUST "the legal form of the legal entity and the law by which it is governed"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(e) if applicable, the name of the register of companies in which the legal` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(e) if applicable, the name of the register of companies in which the legal` EQUALS JUST "if applicable, the name of the register of companies in which the legal entity is entered (including details of the country in which it is registered), and its registration number in that register"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7)(f) the nature of the entity's role in relation to the trust` EQUALS JUST TRUE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7)(f) the nature of the entity's role in relation to the trust` EQUALS JUST "the nature of the entity's role in relation to the trust"
#ASSERT `reg 45(7) the item is information specified in paragraph (7)` `reg 45(7) another item` EQUALS JUST FALSE
#ASSERT `reg 45(7) the wording of the entry` `reg 45(7) another item` EQUALS NOTHING

-- (6) arguments: the item; has a national insurance number or unique taxpayer reference; the usual residential address is in the United Kingdom
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(a) the individual's full name` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(b) the individual's national insurance number or unique taxpayer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(b) the individual's national insurance number or unique taxpayer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(c) if the individual does not have a national insurance number or unique` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(c) if the individual does not have a national insurance number or unique` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(d) if the address provided under sub-paragraph (c) is not in the United` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(d) if the address provided under sub-paragraph (c) is not in the United` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(d) if the address provided under sub-paragraph (c) is not in the United` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(e) the individual's date of birth` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6)(f) the nature of the individual's role in relation to the trust` TRUE TRUE EQUALS JUST TRUE
-- an item in none of the heads: the text hands "the information specified in paragraph (6)" to this list, so it is not specified (delegated definitions (a); fork F45-4)
#ASSERT `reg 45(6) the item must be provided for the individual` `reg 45(6) another item` TRUE TRUE EQUALS JUST FALSE
-- (7) arguments: the item; the legal entity has a unique taxpayer reference; it is entered in a register of companies
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(a) the legal entity's corporate or firm name` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(b) the legal entity's unique taxpayer reference, if any` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(b) the legal entity's unique taxpayer reference, if any` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(c) the registered or principal office of the legal entity` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(d) the legal form of the legal entity and the law by which it is governed` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(e) if applicable, the name of the register of companies in which the legal` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(e) if applicable, the name of the register of companies in which the legal` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7)(f) the nature of the entity's role in relation to the trust` FALSE FALSE EQUALS JUST TRUE
-- an item in none of the heads: the text hands "the information specified in paragraph (7)" to this list, so it is not specified (delegated definitions (a); fork F45-4)
#ASSERT `reg 45(7) the item must be provided for the legal entity` `reg 45(7) another item` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(8) the information specified in this paragraph is` EQUALS "a description of the class of persons who are beneficiaries or potential beneficiaries under the trust"

§ `Regulation 45(3), (4), (9) -- when`

-- (3): arguments: the date the trust was set up; the date the trustees became liable to pay UK taxes; the 31st January after the tax year in which they were first liable (a TEST VALUE: 31 January 2022)
-- (a) a trust set up before 6 April 2021: the 31st January input, whatever the liability date
#ASSERT `reg 45(3) the last day for providing the information` (Date 5 4 2021) (Date 1 6 2021) (Date 31 1 2022) EQUALS Date 31 1 2022
#ASSERT `reg 45(3) the last day for providing the information` (Date 1 1 2021) (Date 10 7 2022) (Date 31 1 2023) EQUALS Date 31 1 2023
-- (b) a trust set up on or after 6 April 2021, liable before 4 June 2022: 1 September 2022
#ASSERT `reg 45(3) the last day for providing the information` (Date 6 4 2021) (Date 3 6 2022) (Date 31 1 2022) EQUALS Date 1 9 2022
#ASSERT `reg 45(3) the last day for providing the information` (Date 1 5 2021) (Date 1 5 2021) (Date 31 1 2022) EQUALS Date 1 9 2022
-- (c) any other case: 90 days from liability (4 June 2022 plus 90 days is 2 September 2022)
#ASSERT `reg 45(3) the last day for providing the information` (Date 6 4 2021) (Date 4 6 2022) (Date 31 1 2022) EQUALS Date 2 9 2022
#ASSERT `reg 45(3) the last day for providing the information` (Date 1 12 2022) (Date 1 12 2022) (Date 31 1 2022) EQUALS Date 1 3 2023
-- timeliness: arguments: the date provided; the last day; the date asked
#ASSERT `reg 45(3) the information was provided in time` (JUST (Date 1 9 2022)) (Date 1 9 2022) (Date 5 9 2022) EQUALS JUST TRUE
#ASSERT `reg 45(3) the information was provided in time` (JUST (Date 2 9 2022)) (Date 1 9 2022) (Date 5 9 2022) EQUALS JUST FALSE
#ASSERT `reg 45(3) the information was provided in time` NOTHING (Date 1 9 2022) (Date 1 9 2022) EQUALS NOTHING
#ASSERT `reg 45(3) the information was provided in time` NOTHING (Date 1 9 2022) (Date 2 9 2022) EQUALS JUST FALSE
#ASSERT `reg 45(4) the information required under paragraphs (2) and (9) was provided in the form required` TRUE EQUALS JUST TRUE
#ASSERT `reg 45(4) the information required under paragraphs (2) and (9) was provided in the form required` FALSE EQUALS JUST FALSE
-- (9)(a) arguments: the trust is a taxable relevant trust; a trustee becomes aware of a change; the changed information is the value of the trust assets
#ASSERT `reg 45(9)(a) the trustees must notify the Commissioners of the change and the date on which it occurred` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(9)(a) the trustees must notify the Commissioners of the change and the date on which it occurred` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 45(9)(a) the trustees must notify the Commissioners of the change and the date on which it occurred` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(9)(a) the trustees must notify the Commissioners of the change and the date on which it occurred` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `reg 45(9)(a) the trustees must notify the Commissioners of the change and the date on which it occurred` NOTHING TRUE FALSE EQUALS NOTHING
-- the last day: liable in the year of the change: (i); not liable that year: (ii).  TEST VALUES: 31 January 2024 after the year of the change, 31 January 2026 after the year of liability
#ASSERT `reg 45(9)(a) the last day for notifying the change` TRUE (Date 31 1 2024) (Date 31 1 2026) EQUALS Date 31 1 2024
#ASSERT `reg 45(9)(a) the last day for notifying the change` FALSE (Date 31 1 2024) (Date 31 1 2026) EQUALS Date 31 1 2026
#ASSERT `reg 45(9)(a) the change was notified in time` (JUST (Date 31 1 2024)) (Date 31 1 2024) (Date 1 3 2024) EQUALS JUST TRUE
#ASSERT `reg 45(9)(a) the change was notified in time` (JUST (Date 1 2 2024)) (Date 31 1 2024) (Date 1 3 2024) EQUALS JUST FALSE
#ASSERT `reg 45(9)(a) the change was notified in time` NOTHING (Date 31 1 2024) (Date 31 1 2024) EQUALS NOTHING
#ASSERT `reg 45(9)(a) the change was notified in time` NOTHING (Date 31 1 2024) (Date 1 2 2024) EQUALS JUST FALSE
-- (9)(b)
#ASSERT `reg 45(9)(b) the trustees must confirm to the Commissioners that there is no change` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 45(9)(b) the trustees must confirm to the Commissioners that there is no change` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 45(9)(b) the trustees must confirm to the Commissioners that there is no change` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `reg 45(9)(b) the confirmation was given in time` (JUST (Date 31 1 2026)) (Date 31 1 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `reg 45(9)(b) the confirmation was given in time` (JUST (Date 1 2 2026)) (Date 31 1 2026) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `reg 45(9)(b) the confirmation was given in time` NOTHING (Date 31 1 2026) (Date 1 2 2026) EQUALS JUST FALSE

§ `Regulation 45(10) to (15)`

-- (10): the table of what the register contains
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(a) a taxable relevant trust` `reg 45(10) the information referred to in regulation 44(2)(b) and (5)(b)` EQUALS JUST TRUE
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(a) a taxable relevant trust` `reg 45(10) the information referred to in paragraphs (10E) to (10G)` EQUALS NOTHING
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(a) a taxable relevant trust` `reg 45(10) the information referred to in regulation 45ZA(3) and (4)` EQUALS NOTHING
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(b) a taxable relevant trust of a type mentioned in paragraphs (10A) to (10C)` `reg 45(10) the information referred to in regulation 44(2)(b) and (5)(b)` EQUALS JUST TRUE
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(b) a taxable relevant trust of a type mentioned in paragraphs (10A) to (10C)` `reg 45(10) the information referred to in paragraphs (10E) to (10G)` EQUALS JUST TRUE
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(b) a taxable relevant trust of a type mentioned in paragraphs (10A) to (10C)` `reg 45(10) the information referred to in regulation 45ZA(3) and (4)` EQUALS NOTHING
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(c) a trust of a type mentioned in regulation 45ZA(1)` `reg 45(10) the information referred to in regulation 44(2)(b) and (5)(b)` EQUALS NOTHING
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(c) a trust of a type mentioned in regulation 45ZA(1)` `reg 45(10) the information referred to in paragraphs (10E) to (10G)` EQUALS NOTHING
#ASSERT `reg 45(10) the register must contain the information` `reg 45(10)(c) a trust of a type mentioned in regulation 45ZA(1)` `reg 45(10) the information referred to in regulation 45ZA(3) and (4)` EQUALS JUST TRUE
-- (10A) arguments: a taxable relevant trust; a UK trust; an EEA registered trust; listed in Schedule 3A (S-18)
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- (10A) applies to a described class; a trust outside it is one to which the paragraph does not apply (fork F45-6)
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 45(10A) paragraph (10A) applies to the trustees` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `reg 45(10A) the last day for providing the information` (Date 3 6 2022) EQUALS Date 1 9 2022
#ASSERT `reg 45(10A) the last day for providing the information` (Date 4 6 2022) EQUALS Date 2 9 2022
#ASSERT `reg 45(10A) the last day for providing the information` (Date 1 1 2023) EQUALS Date 1 4 2023
-- (10B) arguments: a taxable relevant trust; a non-UK trust; a trustee resident in the UK; EEA registered; listed in Schedule 3A; enters a business relationship; acquires an interest in land
#ASSERT `reg 45(10B) paragraph (10B) applies to the trustees` (JUST TRUE) (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 45(10B) paragraph (10B) applies to the trustees` (JUST TRUE) (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
-- (10B): "where the trustees ... enter into a business relationship ... or acquire an interest in land" fails (neither), or the described class is not met: it does not apply (ruling of 2026-11-05 (b); fork F45-6)
#ASSERT `reg 45(10B) paragraph (10B) applies to the trustees` (JUST TRUE) (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 45(10B) paragraph (10B) applies to the trustees` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
