§ `sch 3A para 10(2) -- para 10(2) the entity is a segregating entity`

-- the case that satisfies the paragraph
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS TRUE, `the entity is a clearing member of a recognised central counterparty` IS FALSE, `the entity is a participant in a designated system` IS FALSE, `the entity is a designated system` IS FALSE, `the entity is a recognised body` IS FALSE) EQUALS JUST TRUE
-- a clearing member of a recognised central counterparty
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS FALSE, `the entity is a clearing member of a recognised central counterparty` IS TRUE, `the entity is a participant in a designated system` IS FALSE, `the entity is a designated system` IS FALSE, `the entity is a recognised body` IS FALSE) EQUALS JUST TRUE
-- a participant in a designated system
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS FALSE, `the entity is a clearing member of a recognised central counterparty` IS FALSE, `the entity is a participant in a designated system` IS TRUE, `the entity is a designated system` IS FALSE, `the entity is a recognised body` IS FALSE) EQUALS JUST TRUE
-- a designated system
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS FALSE, `the entity is a clearing member of a recognised central counterparty` IS FALSE, `the entity is a participant in a designated system` IS FALSE, `the entity is a designated system` IS TRUE, `the entity is a recognised body` IS FALSE) EQUALS JUST TRUE
-- a recognised body
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS FALSE, `the entity is a clearing member of a recognised central counterparty` IS FALSE, `the entity is a participant in a designated system` IS FALSE, `the entity is a designated system` IS FALSE, `the entity is a recognised body` IS TRUE) EQUALS JUST TRUE
-- 'means': none of the five
#ASSERT (`sch 3A para 10(2) the entity is a segregating entity` WITH `the entity is an authorised person` IS FALSE, `the entity is a clearing member of a recognised central counterparty` IS FALSE, `the entity is a participant in a designated system` IS FALSE, `the entity is a designated system` IS FALSE, `the entity is a recognised body` IS FALSE) EQUALS JUST FALSE

