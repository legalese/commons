IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr3-registration`

-- TESTS for mlr3-registration.l4 (regs 53 to 60B).  Every expected value is written here from the
-- text of the regulation named beside it, before the code was run: JUST TRUE where the provision
-- gives the answer yes, JUST FALSE where its own words say no, NOTHING where it does not answer.
-- The dates are chosen so that each period is tested on its last day and on the day after.  Where
-- the text gives no date (the full commencement day of reg 56B(2)) a stand-in date is used and
-- marked as one.  A #TRACE is not an assertion, so each carries its outcome in an `-- EXPECT`
-- comment that the work directory's tracecheck script reads.

§ `Tests -- regs 53 to 60B`

`reg 53 test FCA` MEANS `the Financial Conduct Authority`
`reg 53 test HMRC` MEANS `the Commissioners for Her Majesty's Revenue and Customs`

§§ `reg 53 and reg 54`

#ASSERT `reg 53 the registering authority for the person` TRUE FALSE FALSE FALSE EQUALS JUST `reg 53 test FCA`
#ASSERT `reg 53 the registering authority for the person` FALSE TRUE FALSE FALSE EQUALS JUST `reg 53 test FCA`
#ASSERT `reg 53 the registering authority for the person` FALSE FALSE TRUE FALSE EQUALS JUST `reg 53 test HMRC`
#ASSERT `reg 53 the registering authority for the person` FALSE FALSE FALSE TRUE EQUALS JUST `reg 53 test HMRC`
#ASSERT `reg 53 the registering authority for the person` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test FCA` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test FCA` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test HMRC` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test HMRC` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test HMRC` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test FCA` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 53 the authority is the registering authority for the person` `reg 53 test FCA` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 53 the authority is the registering authority for the person` `the Treasury` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 53 the undertaking is a telecommunication, digital and IT payment service provider` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 53 the undertaking is a telecommunication, digital and IT payment service provider` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 53 the undertaking is a telecommunication, digital and IT payment service provider` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 53 the undertaking is a telecommunication, digital and IT payment service provider` FALSE TRUE TRUE EQUALS JUST FALSE

-- the fields of `reg 54 registrant`, in order: authorised person; notified under reg 23; cryptoasset exchange provider;
-- custodian wallet provider; authorised cryptoasset firm; specified investment cryptoasset firm; high value dealer;
-- money service business; trust or company service provider; bill payment service provider; telecommunication, digital and IT payment service provider
`reg 53 test an authorised person that has notified the FCA`   MEANS `reg 54 registrant` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test an authorised person that has not notified`       MEANS `reg 54 registrant` OF TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test a person that notified but is not authorised`     MEANS `reg 54 registrant` OF FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test a cryptoasset exchange provider`                  MEANS `reg 54 registrant` OF FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test a custodian wallet provider that is an authorised cryptoasset firm` MEANS `reg 54 registrant` OF FALSE, FALSE, FALSE, TRUE,  TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test an exchange provider that is a specified investment cryptoasset firm` MEANS `reg 54 registrant` OF FALSE, FALSE, TRUE,  FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE, FALSE
`reg 53 test a high value dealer`                              MEANS `reg 54 registrant` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE, FALSE, FALSE
`reg 53 test a bill payment service provider`                  MEANS `reg 54 registrant` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE
`reg 53 test a telecommunication, digital and IT payment service provider` MEANS `reg 54 registrant` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`reg 53 test a money service business that is an authorised person` MEANS `reg 54 registrant` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`reg 53 test a trust or company service provider`              MEANS `reg 54 registrant` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE,  FALSE, FALSE

#ASSERT `reg 54(1) the person is one the FCA must register` `reg 53 test an authorised person that has notified the FCA` EQUALS JUST TRUE
#ASSERT `reg 54(1) the person is one the FCA must register` `reg 53 test an authorised person that has not notified` EQUALS NOTHING
#ASSERT `reg 54(1) the person is one the FCA must register` `reg 53 test a person that notified but is not authorised` EQUALS NOTHING
#ASSERT `reg 54(1A) the person is one the FCA must register (first printing)` `reg 53 test a cryptoasset exchange provider` EQUALS JUST TRUE
#ASSERT `reg 54(1A) the person is one the FCA must register (first printing)` `reg 53 test a custodian wallet provider that is an authorised cryptoasset firm` EQUALS JUST TRUE
#ASSERT `reg 54(1A) the person is one the FCA must register (first printing)` `reg 53 test a high value dealer` EQUALS NOTHING
#ASSERT `reg 54(1A) the person is one the FCA must register (second printing)` `reg 53 test a cryptoasset exchange provider` EQUALS JUST TRUE
#ASSERT `reg 54(1A) the person is one the FCA must register (second printing)` `reg 53 test a custodian wallet provider that is an authorised cryptoasset firm` EQUALS NOTHING
#ASSERT `reg 54(1A) the person is one the FCA must register (second printing)` `reg 53 test an exchange provider that is a specified investment cryptoasset firm` EQUALS NOTHING
#ASSERT `reg 54(1A) the person is one the FCA must register (second printing)` `reg 53 test a high value dealer` EQUALS NOTHING
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a high value dealer` FALSE EQUALS JUST TRUE
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a high value dealer` TRUE EQUALS NOTHING
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a bill payment service provider` FALSE EQUALS JUST TRUE
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a telecommunication, digital and IT payment service provider` FALSE EQUALS JUST TRUE
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a trust or company service provider` FALSE EQUALS JUST TRUE
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test a money service business that is an authorised person` TRUE EQUALS NOTHING
#ASSERT `reg 54(2) the person is one the Commissioners must register` `reg 53 test an authorised person that has not notified` FALSE EQUALS NOTHING
#ASSERT `reg 54(3) the registering authority may keep the register in the form it thinks fit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 54(3) the registering authority may keep the register in the form it thinks fit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 54(3) the registering authority may keep the register in the form it thinks fit` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 54(4) the register maintained by the Commissioners includes the entries the paragraph requires` TRUE EQUALS JUST TRUE
#ASSERT `reg 54(4) the register maintained by the Commissioners includes the entries the paragraph requires` FALSE EQUALS JUST FALSE
#ASSERT `reg 54(5) the registering authority may publish or make available to public inspection all or part of the register` TRUE EQUALS JUST TRUE
#ASSERT `reg 54(5) the registering authority may publish or make available to public inspection all or part of the register` FALSE EQUALS NOTHING

