#ASSERT `reg 60(11) the registering authority may publish information about its decision` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 60(12) the supervisory authority has published the status of the appeal and its outcome without delay` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 60(12) the supervisory authority has published the status of the appeal and its outcome without delay` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 60(12) the supervisory authority has published the status of the appeal and its outcome without delay` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 60 the decision suspends or cancels a registration` TRUE EQUALS TRUE
#ASSERT `reg 60 the decision suspends or cancels a registration` FALSE EQUALS FALSE

-- reg 60A(3)(a) and (b): the two schemes are the ones established under Part 16 and Part 15 of FSMA; any other scheme is not them.
#ASSERT `reg 60A(3)(a) the scheme is the Financial Ombudsman Service` TRUE EQUALS JUST TRUE
#ASSERT `reg 60A(3)(a) the scheme is the Financial Ombudsman Service` FALSE EQUALS JUST FALSE
#ASSERT `reg 60A(3)(b) the scheme is the Financial Services Compensation Scheme` TRUE EQUALS JUST TRUE
#ASSERT `reg 60A(3)(b) the scheme is the Financial Services Compensation Scheme` FALSE EQUALS JUST FALSE

-- reg 60A(1): cryptoasset exchange provider or custodian wallet provider, business relationship (reg 4, seam S-K1), enters a transaction, arises out of its activities, within the Ombudsman's jurisdiction, under the Compensation Scheme
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST TRUE) FALSE TRUE FALSE TRUE EQUALS JUST TRUE
