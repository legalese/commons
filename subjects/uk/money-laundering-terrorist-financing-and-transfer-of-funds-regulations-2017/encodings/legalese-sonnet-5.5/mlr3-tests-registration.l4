#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST FALSE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE NOTHING FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE NOTHING TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 60A(1) paragraph (2) applies` FALSE (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 60A(1) paragraph (2) applies` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 60A(2) the cryptoasset business has informed the customer before establishing the business relationship or entering into the transaction` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 60A(2) the cryptoasset business has informed the customer before establishing the business relationship or entering into the transaction` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 60A(2) the cryptoasset business has informed the customer before establishing the business relationship or entering into the transaction` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 60A(2) the cryptoasset business has informed the customer before establishing the business relationship or entering into the transaction` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 60B Schedule 6B applies to the acquisition or increase in control` TRUE EQUALS JUST TRUE
#ASSERT `reg 60B Schedule 6B applies to the acquisition or increase in control` FALSE EQUALS NOTHING

