IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr-seat`
IMPORT `mlr4-part8`
IMPORT `mlr4-part9`
IMPORT `mlr4-part10`
IMPORT `mlr4-part11`
IMPORT `mlr4-schedules`

-- ============================================================
-- mlr1: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- CASES for the seat layer: for each question, the facts a real person in the seat would state, and the answer the Regulations give.
-- Expected values are written from the text of the regulation named in the question, not read back from the code.
-- A case whose answer is NOTHING is a case outside the encoding: the Regulations do not answer on those facts.

§ `Under regulation 8, am I a relevant person`
-- case: a bank in the United Kingdom
#ASSERT `Under regulation 8, am I a relevant person` `credit institution` TRUE No EQUALS JUST TRUE
-- case: a bank not acting in the United Kingdom
#ASSERT `Under regulation 8, am I a relevant person` `credit institution` FALSE No EQUALS JUST FALSE
-- case: a bank that is not sure it is excluded
#ASSERT `Under regulation 8, am I a relevant person` `credit institution` TRUE `I am not sure` EQUALS NOTHING

§ `Under regulation 8(3), am I a relevant person for the purposes of this particular regulation`
-- case: an auction platform asking about regulation 19, which paragraph (3) lists
#ASSERT `Under regulation 8(3), am I a relevant person for the purposes of this particular regulation` `auction platform` TRUE No 19 "" EQUALS JUST TRUE
-- case: an auction platform asking about regulation 30, which paragraph (3) does not list (a list the text does not close)
#ASSERT `Under regulation 8(3), am I a relevant person for the purposes of this particular regulation` `auction platform` TRUE No 30 "" EQUALS NOTHING
-- case: a bank asking about regulation 19
#ASSERT `Under regulation 8(3), am I a relevant person for the purposes of this particular regulation` `credit institution` TRUE No 19 "" EQUALS JUST TRUE

§ `Under regulation 9, am I regarded as carrying on business in the United Kingdom`
-- case: a company with its registered office in the United Kingdom, managed from there
#ASSERT `Under regulation 9, am I regarded as carrying on business in the United Kingdom` FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

§ `Under regulation 10(1), am I a credit institution`
-- case: a credit institution that accepts deposits from the public
#ASSERT `Under regulation 10(1), am I a credit institution` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- case: neither a credit institution nor a branch of one
#ASSERT `Under regulation 10(1), am I a credit institution` FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- case: a credit institution that does none of the activities the paragraph names: "means ... when" says no
#ASSERT `Under regulation 10(1), am I a credit institution` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Under regulation 10(2)(a), am I a financial institution because I am an undertaking that carries out a listed activity`
-- case: an undertaking that lends
#ASSERT `Under regulation 10(2)(a), am I a financial institution because I am an undertaking that carries out a listed activity` TRUE No `lending` EQUALS JUST TRUE
-- case: an undertaking not sure whether paragraph (3) takes it out
#ASSERT `Under regulation 10(2)(a), am I a financial institution because I am an undertaking that carries out a listed activity` TRUE `I am not sure` `lending` EQUALS NOTHING

§ `Under regulation 10(2)(b), am I a financial institution because I am an insurance undertaking`
-- case: an authorised insurer effecting long-term insurance
#ASSERT `Under regulation 10(2)(b), am I a financial institution because I am an insurance undertaking` TRUE TRUE EQUALS JUST TRUE
-- case: an insurer with no permission under Part 4A
#ASSERT `Under regulation 10(2)(b), am I a financial institution because I am an insurance undertaking` FALSE TRUE EQUALS JUST FALSE

§ `Under regulation 10(2)(c), am I a financial institution because I am an investment firm`
-- case: an investment firm providing investment services
#ASSERT `Under regulation 10(2)(c), am I a financial institution because I am an investment firm` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- case: a person within an exclusion to the definition of investment firm
#ASSERT `Under regulation 10(2)(c), am I a financial institution because I am an investment firm` TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Under regulation 11(a), am I an auditor`
-- case: a statutory auditor carrying out statutory audit work
#ASSERT `Under regulation 11(a), am I an auditor` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- case: not an auditor of either kind
#ASSERT `Under regulation 11(a), am I an auditor` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE

§ `Under regulation 11(b), am I an insolvency practitioner`
-- case: an insolvency practitioner acting as one
#ASSERT `Under regulation 11(b), am I an insolvency practitioner` TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 11(c), am I an external accountant`
-- case: a firm providing accountancy services
#ASSERT `Under regulation 11(c), am I an external accountant` TRUE TRUE TRUE EQUALS JUST TRUE
-- case: a firm not providing accountancy services
#ASSERT `Under regulation 11(c), am I an external accountant` TRUE FALSE TRUE EQUALS JUST FALSE

§ `Under regulation 11(d), am I a tax adviser`
-- case: a firm giving tax advice
#ASSERT `Under regulation 11(d), am I a tax adviser` TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 12(1), am I an independent legal professional`
-- case: a law firm assisting in the buying and selling of real property
#ASSERT `Under regulation 12(1), am I an independent legal professional` TRUE TRUE TRUE `reg 12(1)(a) the buying and selling of real property or business entities` EQUALS JUST TRUE

§ `Under regulation 12(2), am I a trust or company service provider`
-- case: a firm forming companies for others
#ASSERT `Under regulation 12(2), am I a trust or company service provider` TRUE `reg 12(2)(a) forming a firm` FALSE TRUE EQUALS JUST TRUE

§ `Under regulation 13(1), am I an estate agent`
-- case: a firm carrying out estate agency work
#ASSERT `Under regulation 13(1), am I an estate agent` TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 13(3), am I a letting agent`
-- case: a firm carrying out letting agency work
#ASSERT `Under regulation 13(3), am I a letting agent` TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 14(1)(a), am I a high value dealer`
-- case: a dealer receiving 10000 pounds in cash
#ASSERT `Under regulation 14(1)(a), am I a high value dealer` TRUE TRUE 10000 EQUALS JUST TRUE
-- case: a dealer receiving 9999 pounds in cash: below the 10,000 pounds the definition names
#ASSERT `Under regulation 14(1)(a), am I a high value dealer` TRUE TRUE 9999 EQUALS JUST FALSE

§ `Under regulation 14(1)(b), am I a casino`
-- case: the holder of a casino operating licence
#ASSERT `Under regulation 14(1)(b), am I a casino` TRUE EQUALS JUST TRUE

§ `Under regulation 14(1)(d)(i), am I an art market participant because I trade in works of art or act as an intermediary`
-- case: a dealer in art, a 10000 pound sale
#ASSERT `Under regulation 14(1)(d)(i), am I an art market participant because I trade in works of art or act as an intermediary` TRUE TRUE 10000 Yes EQUALS JUST TRUE
-- case: a dealer in art, a 9999 pound sale
#ASSERT `Under regulation 14(1)(d)(i), am I an art market participant because I trade in works of art or act as an intermediary` TRUE TRUE 9999 Yes EQUALS JUST FALSE

§ `Under regulation 14A(1), am I a cryptoasset exchange provider`
-- case: a firm exchanging cryptoassets for money
#ASSERT `Under regulation 14A(1), am I a cryptoasset exchange provider` TRUE `reg 14A(1)(a) exchanging, or arranging or making arrangements with a view to the exchange of, cryptoassets for money or money for cryptoassets` TRUE EQUALS JUST TRUE

§ `Under regulation 14A(2), am I a custodian wallet provider`
-- case: a firm safeguarding private cryptographic keys for customers
#ASSERT `Under regulation 14A(2), am I a custodian wallet provider` TRUE `reg 14A(2)(b) private cryptographic keys on behalf of its customers in order to hold, store and transfer cryptoassets` TRUE EQUALS JUST TRUE

§ `Under regulation 15(3), do I engage in financial activity on an occasional or very limited basis`
-- case: a small side activity meeting every condition
#ASSERT `Under regulation 15(3), do I engage in financial activity on an occasional or very limited basis` 50000 1 1000 100000 TRUE FALSE `high value dealer` TRUE FALSE EQUALS JUST TRUE

§ `Under regulation 18(1), have I taken the steps that the risk assessment requires`
-- case: a business that has identified and assessed its risks
#ASSERT `Under regulation 18(1), have I taken the steps that the risk assessment requires` TRUE TRUE EQUALS JUST TRUE
-- case: a business that has not assessed its risks
#ASSERT `Under regulation 18(1), have I taken the steps that the risk assessment requires` TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 18(4), have I kept the written record of my risk assessment that regulation 18(4) requires`
-- case: a business with an up-to-date written record
#ASSERT `Under regulation 18(4), have I kept the written record of my risk assessment that regulation 18(4) requires` TRUE TRUE FALSE EQUALS JUST TRUE
-- case: a business with no written record, and no notice from its supervisory authority
#ASSERT `Under regulation 18(4), have I kept the written record of my risk assessment that regulation 18(4) requires` FALSE TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 18A(1), have I taken the steps that the proliferation financing risk assessment requires`
-- case: a business that has identified and assessed its proliferation financing risks
#ASSERT `Under regulation 18A(1), have I taken the steps that the proliferation financing risk assessment requires` TRUE TRUE EQUALS JUST TRUE
-- case: a business that has not assessed its proliferation financing risks
#ASSERT `Under regulation 18A(1), have I taken the steps that the proliferation financing risk assessment requires` TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 18A(4), have I kept the written record of my proliferation financing risk assessment that regulation 18A(4) requires`
-- case: an up-to-date written record
#ASSERT `Under regulation 18A(4), have I kept the written record of my proliferation financing risk assessment that regulation 18A(4) requires` TRUE TRUE FALSE EQUALS JUST TRUE
-- case: no written record and no notice from the supervisory authority
#ASSERT `Under regulation 18A(4), have I kept the written record of my proliferation financing risk assessment that regulation 18A(4) requires` FALSE TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 19(1), have I established, kept under review and recorded my policies, controls and procedures`
-- case: a business with policies, review and the three records
#ASSERT `Under regulation 19(1), have I established, kept under review and recorded my policies, controls and procedures` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- case: a business that does not review its policies
#ASSERT `Under regulation 19(1), have I established, kept under review and recorded my policies, controls and procedures` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Under regulation 19A(1), have I established, kept under review and recorded my policies, controls and procedures on proliferation financing`
-- case: policies, review and the three records in place
#ASSERT `Under regulation 19A(1), have I established, kept under review and recorded my policies, controls and procedures on proliferation financing` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- case: policies never reviewed
#ASSERT `Under regulation 19A(1), have I established, kept under review and recorded my policies, controls and procedures on proliferation financing` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Under regulation 20(1), as a parent undertaking, have I applied my group policies, controls and procedures to my subsidiaries and branches`
-- case: a parent undertaking that has done all five things
#ASSERT `Under regulation 20(1), as a parent undertaking, have I applied my group policies, controls and procedures to my subsidiaries and branches` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- case: a parent undertaking that has not extended the policies to its subsidiaries
#ASSERT `Under regulation 20(1), as a parent undertaking, have I applied my group policies, controls and procedures to my subsidiaries and branches` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Under regulation 21(1), have I put in place the compliance officer, screening and independent audit that regulation 21(1) requires`
-- case: a business with officer, screening and audit in place
#ASSERT `Under regulation 21(1), have I put in place the compliance officer, screening and independent audit that regulation 21(1) requires` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- case: a sole individual who employs no-one: paragraph (6) disapplies the duty
#ASSERT `Under regulation 21(1), have I put in place the compliance officer, screening and independent audit that regulation 21(1) requires` FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 21(3), have I appointed a nominated officer`
-- case: a business that has appointed a nominated officer
#ASSERT `Under regulation 21(3), have I appointed a nominated officer` TRUE FALSE EQUALS JUST TRUE

§ `Under regulation 21(4), did I tell my supervisory authority of the nominated officer within 14 days of the appointment`
-- case: told 14 days after the appointment: in time
#ASSERT `Under regulation 21(4), did I tell my supervisory authority of the nominated officer within 14 days of the appointment` (Date 1 3 2025) (Date 15 3 2025) EQUALS JUST TRUE
-- case: told 15 days after the appointment: too late
#ASSERT `Under regulation 21(4), did I tell my supervisory authority of the nominated officer within 14 days of the appointment` (Date 1 3 2025) (Date 16 3 2025) EQUALS JUST FALSE

§ `Under regulation 23(1), did I tell the FCA within 28 days that I had begun to act as a money service business or a trust or company service provider`
-- case: told the FCA on the 28th day
#ASSERT `Under regulation 23(1), did I tell the FCA within 28 days that I had begun to act as a money service business or a trust or company service provider` (Date 1 3 2025) (Date 29 3 2025) EQUALS JUST TRUE
-- case: told the FCA on the 29th day
#ASSERT `Under regulation 23(1), did I tell the FCA within 28 days that I had begun to act as a money service business or a trust or company service provider` (Date 1 3 2025) (Date 30 3 2025) EQUALS JUST FALSE

§ `Under regulation 23(3), did I tell the FCA within 28 days that I had ceased to act`
-- case: told the FCA on the 28th day after ceasing
#ASSERT `Under regulation 23(3), did I tell the FCA within 28 days that I had ceased to act` (Date 1 3 2025) (Date 29 3 2025) EQUALS JUST TRUE

§ `Under regulation 23(3A), did I give the FCA the details of a change or the correction of an inaccuracy within 30 days`
-- case: gave the details on the 30th day beginning with the date
#ASSERT `Under regulation 23(3A), did I give the FCA the details of a change or the correction of an inaccuracy within 30 days` (Date 1 3 2025) (Date 30 3 2025) EQUALS JUST TRUE
-- case: gave the details on the 31st day
#ASSERT `Under regulation 23(3A), did I give the FCA the details of a change or the correction of an inaccuracy within 30 days` (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE

§ `Under regulation 24(1), have I made my employees aware of the law and trained them, and kept a record of the training`
-- case: a business that has trained its staff and kept the record
#ASSERT `Under regulation 24(1), have I made my employees aware of the law and trained them, and kept a record of the training` TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 26(1), may this person be a beneficial owner, officer or manager of my firm, or act as a sole practitioner`
-- case: an approved owner of an estate agency
#ASSERT `Under regulation 26(1), may this person be a beneficial owner, officer or manager of my firm, or act as a sole practitioner` TRUE `estate agent` TRUE No No EQUALS JUST TRUE

§ `Under regulation 26(4), may this person be appointed, or continue to act, as an officer or manager of my firm`
-- case: an approved manager
#ASSERT `Under regulation 26(4), may this person be appointed, or continue to act, as an officer or manager of my firm` TRUE FALSE EQUALS JUST TRUE

§ `Under regulation 26(10)(a), did I tell my supervisory authority of my conviction within 30 days`
-- case: told the authority on the 30th day
#ASSERT `Under regulation 26(10)(a), did I tell my supervisory authority of my conviction within 30 days` Yes (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE
-- case: not sure whether the offence is a relevant offence
#ASSERT `Under regulation 26(10)(a), did I tell my supervisory authority of my conviction within 30 days` `I am not sure` (Date 1 3 2025) (Date 31 3 2025) EQUALS NOTHING

§ `Under regulation 26(10)(b), did my firm tell its supervisory authority of the conviction within 30 days of becoming aware of it`
-- case: told the authority on the 30th day after becoming aware
#ASSERT `Under regulation 26(10)(b), did my firm tell its supervisory authority of the conviction within 30 days of becoming aware of it` Yes (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE

§ `Under regulation 27(1), must I apply customer due diligence measures on the general occasions`
-- case: a new customer relationship
#ASSERT `Under regulation 27(1), must I apply customer due diligence measures on the general occasions` Yes TRUE 0 FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- case: nothing on these routes
#ASSERT `Under regulation 27(1), must I apply customer due diligence measures on the general occasions` No FALSE 100 FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- case: suspicion alone
#ASSERT `Under regulation 27(1), must I apply customer due diligence measures on the general occasions` `I am not sure` FALSE 100 FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE

§ `Under regulation 27(2), must I apply customer due diligence measures to an occasional transaction of 12000 pounds or more`
-- case: an estate agent, occasional transaction of exactly 12000 pounds
#ASSERT `Under regulation 27(2), must I apply customer due diligence measures to an occasional transaction of 12000 pounds or more` `estate agent` 12000 FALSE FALSE FALSE EQUALS JUST TRUE
-- case: an estate agent, 11999 pounds
#ASSERT `Under regulation 27(2), must I apply customer due diligence measures to an occasional transaction of 12000 pounds or more` `estate agent` 11999 FALSE FALSE FALSE EQUALS JUST FALSE
-- case: a casino, which is excluded from this paragraph
#ASSERT `Under regulation 27(2), must I apply customer due diligence measures to an occasional transaction of 12000 pounds or more` `casino` 50000 FALSE FALSE FALSE EQUALS JUST FALSE

§ `Under regulation 27(3), must I, as a high value dealer, apply customer due diligence measures to an occasional transaction in cash of 10000 pounds or more`
-- case: a high value dealer, 10000 pounds in cash
#ASSERT `Under regulation 27(3), must I, as a high value dealer, apply customer due diligence measures to an occasional transaction in cash of 10000 pounds or more` `high value dealer` 10000 TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- case: a high value dealer, 9999 pounds in cash
#ASSERT `Under regulation 27(3), must I, as a high value dealer, apply customer due diligence measures to an occasional transaction in cash of 10000 pounds or more` `high value dealer` 9999 TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- case: a high value dealer, paid by card: no notes, coins or travellers cheques are paid, so the transaction is not in cash (regulation 3(1))
#ASSERT `Under regulation 27(3), must I, as a high value dealer, apply customer due diligence measures to an occasional transaction in cash of 10000 pounds or more` `high value dealer` 20000 FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Under regulation 27(5), must I, as a casino, apply customer due diligence measures to a transaction of 2000 pounds or more`
-- case: a casino, a 2000 pound wager
#ASSERT `Under regulation 27(5), must I, as a casino, apply customer due diligence measures to a transaction of 2000 pounds or more` `casino` 2000 `reg 27(6)(a) the wagering of a stake` 0 EQUALS JUST TRUE
-- case: a casino, a 2500 pound wager of which 600 is re-used winnings
#ASSERT `Under regulation 27(5), must I, as a casino, apply customer due diligence measures to a transaction of 2000 pounds or more` `casino` 2500 `reg 27(6)(a) the wagering of a stake` 600 EQUALS JUST FALSE

§ `Under regulation 27(7A), must I, as a letting agent, apply customer due diligence measures to this letting`
-- case: a letting agent, a year at 10000 a month
#ASSERT `Under regulation 27(7A), must I, as a letting agent, apply customer due diligence measures to this letting` `letting agent` FALSE TRUE 12 10000 EQUALS JUST TRUE
-- case: a letting agent, a year at 9999 a month
#ASSERT `Under regulation 27(7A), must I, as a letting agent, apply customer due diligence measures to this letting` `letting agent` FALSE TRUE 12 9999 EQUALS JUST FALSE

§ `Under regulation 27(7C)(a), must I, as an art market participant, apply customer due diligence measures to a trade in a work of art of 10000 pounds or more`
-- case: an art market participant, a 10000 pound sale
#ASSERT `Under regulation 27(7C)(a), must I, as an art market participant, apply customer due diligence measures to a trade in a work of art of 10000 pounds or more` `art market participant` 10000 FALSE FALSE FALSE TRUE EQUALS JUST TRUE

§ `Under regulation 27(7C)(b), must I, as an art market participant operating a freeport, apply customer due diligence measures to storage of works of art worth 10000 pounds or more`
-- case: a freeport operator storing 10000 pounds of art for a person
#ASSERT `Under regulation 27(7C)(b), must I, as an art market participant operating a freeport, apply customer due diligence measures to storage of works of art worth 10000 pounds or more` `art market participant` TRUE 10000 EQUALS JUST TRUE

§ `Under regulation 27(7D), must I, as a cryptoasset exchange provider, apply customer due diligence measures to a transaction carried out using my machine`
-- case: a cryptoasset exchange provider with a machine
#ASSERT `Under regulation 27(7D), must I, as a cryptoasset exchange provider, apply customer due diligence measures to a transaction carried out using my machine` `cryptoasset exchange provider` TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 27(7E), must I, as a cryptoasset exchange provider or custodian wallet provider, apply customer due diligence measures to a cryptoasset transfer of 800 pounds or more`
-- case: a custodian wallet provider, 800 pounds
#ASSERT `Under regulation 27(7E), must I, as a cryptoasset exchange provider or custodian wallet provider, apply customer due diligence measures to a cryptoasset transfer of 800 pounds or more` `custodian wallet provider` `an unhosted wallet transfer` 800 EQUALS JUST TRUE
-- case: a custodian wallet provider, 799 pounds
#ASSERT `Under regulation 27(7E), must I, as a cryptoasset exchange provider or custodian wallet provider, apply customer due diligence measures to a cryptoasset transfer of 800 pounds or more` `custodian wallet provider` `an unhosted wallet transfer` 799 EQUALS JUST FALSE

§ `Under regulation 27(8), must I apply customer due diligence measures to an existing customer now`
-- case: circumstances of an existing customer have changed
#ASSERT `Under regulation 27(8), must I apply customer due diligence measures to an existing customer now` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- case: nothing on these routes
#ASSERT `Under regulation 27(8), must I apply customer due diligence measures to an existing customer now` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `Under regulation 27, am I required to apply customer due diligence measures on this occasion`
-- case: an estate agent with nothing triggering
#ASSERT `Under regulation 27, am I required to apply customer due diligence measures on this occasion` `estate agent` No FALSE 100 FALSE TRUE FALSE FALSE FALSE FALSE FALSE 0 `reg 27(6) another transaction` FALSE 0 0 FALSE FALSE 0 FALSE FALSE `an unhosted wallet transfer` 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- case: an estate agent who suspects money laundering
#ASSERT `Under regulation 27, am I required to apply customer due diligence measures on this occasion` `estate agent` No FALSE 100 FALSE TRUE FALSE TRUE FALSE FALSE FALSE 0 `reg 27(6) another transaction` FALSE 0 0 FALSE FALSE 0 FALSE FALSE `an unhosted wallet transfer` 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- case: a casino, a 2000 pound collection of winnings
#ASSERT `Under regulation 27, am I required to apply customer due diligence measures on this occasion` `casino` No FALSE 2000 FALSE TRUE FALSE FALSE FALSE FALSE FALSE 0 `reg 27(6)(b) the collection of winnings` FALSE 0 0 FALSE FALSE 0 FALSE FALSE `an unhosted wallet transfer` 0 FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- case: an estate agent establishing something that may be a business relationship, not sure, nothing else triggering
#ASSERT `Under regulation 27, am I required to apply customer due diligence measures on this occasion` `estate agent` `I am not sure` TRUE 100 FALSE TRUE FALSE FALSE FALSE FALSE FALSE 0 `reg 27(6) another transaction` FALSE 0 0 FALSE FALSE 0 FALSE FALSE `an unhosted wallet transfer` 0 FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Under regulation 28(2)(a), must I identify the customer`
-- case: a new customer whose identity is not yet known to us
#ASSERT `Under regulation 28(2)(a), must I identify the customer` Yes FALSE EQUALS JUST TRUE
-- case: an existing customer already known and verified
#ASSERT `Under regulation 28(2)(a), must I identify the customer` Yes TRUE EQUALS JUST FALSE
-- case: not sure whether regulation 27 requires measures
#ASSERT `Under regulation 28(2)(a), must I identify the customer` `I am not sure` FALSE EQUALS NOTHING

§ `Under regulation 28(2)(b), must I verify the customer's identity`
-- case: a customer not yet verified
#ASSERT `Under regulation 28(2)(b), must I verify the customer's identity` Yes FALSE EQUALS JUST TRUE

§ `Under regulation 28(2)(c), must I assess the purpose and intended nature of the business relationship or occasional transaction`
-- case: regulation 27 requires measures
#ASSERT `Under regulation 28(2)(c), must I assess the purpose and intended nature of the business relationship or occasional transaction` Yes EQUALS JUST TRUE
-- case: regulation 27 does not require measures: regulation 28 applies only when it does
#ASSERT `Under regulation 28(2)(c), must I assess the purpose and intended nature of the business relationship or occasional transaction` No EQUALS JUST FALSE

§ `Under regulation 28(3)(a), must I obtain and verify the name, registration number and addresses of a customer that is a body corporate`
-- case: a body corporate customer
#ASSERT `Under regulation 28(3)(a), must I obtain and verify the name, registration number and addresses of a customer that is a body corporate` Yes Yes EQUALS JUST TRUE
-- case: not sure whether the customer is a body corporate
#ASSERT `Under regulation 28(3)(a), must I obtain and verify the name, registration number and addresses of a customer that is a body corporate` Yes `I am not sure` EQUALS NOTHING

§ `Under regulation 28(3)(a), what particulars of a body corporate must I obtain and verify`
-- case: the three particulars
#ASSERT sum (map (GIVEN s YIELD 1) (`Under regulation 28(3)(a), what particulars of a body corporate must I obtain and verify`)) EQUALS 3

§ `Under regulation 28(3)(b), must I take reasonable measures to determine and verify the law, constitution and management of a customer that is a body corporate`
-- case: a body corporate that is not a listed company
#ASSERT `Under regulation 28(3)(b), must I take reasonable measures to determine and verify the law, constitution and management of a customer that is a body corporate` Yes Yes FALSE EQUALS JUST TRUE
-- case: a company listed on a regulated market: paragraph (5) takes it out
#ASSERT `Under regulation 28(3)(b), must I take reasonable measures to determine and verify the law, constitution and management of a customer that is a body corporate` Yes Yes TRUE EQUALS JUST FALSE

§ `Under regulation 28(4), must I identify the beneficial owner and take reasonable measures to verify their identity`
-- case: a customer beneficially owned by another person
#ASSERT `Under regulation 28(4), must I identify the beneficial owner and take reasonable measures to verify their identity` Yes TRUE FALSE EQUALS JUST TRUE
-- case: a customer not beneficially owned by another person: the "where" is not met
#ASSERT `Under regulation 28(4), must I identify the beneficial owner and take reasonable measures to verify their identity` Yes FALSE FALSE EQUALS JUST FALSE

§ `Under regulation 28(10), must I verify that a person acting for the customer is authorised, identify them and verify their identity`
-- case: a person purports to act for the customer
#ASSERT `Under regulation 28(10), must I verify that a person acting for the customer is authorised, identify them and verify their identity` Yes TRUE EQUALS JUST TRUE

§ `Under regulation 28(11), must I conduct ongoing monitoring of the business relationship`
-- case: an existing business relationship
#ASSERT `Under regulation 28(11), must I conduct ongoing monitoring of the business relationship` Yes Yes EQUALS JUST TRUE
-- case: no business relationship: the paragraph is about a business relationship
#ASSERT `Under regulation 28(11), must I conduct ongoing monitoring of the business relationship` Yes No EQUALS NOTHING

§ `Under regulation 28(14), am I still required to continue to apply customer due diligence measures after a disclosure that would make continuing a tipping-off offence`
-- case: a disclosure that makes continuing an offence: no longer required
#ASSERT `Under regulation 28(14), am I still required to continue to apply customer due diligence measures after a disclosure that would make continuing a tipping-off offence` TRUE TRUE TRUE EQUALS JUST FALSE
-- case: no disclosure: the paragraph does not answer
#ASSERT `Under regulation 28(14), am I still required to continue to apply customer due diligence measures after a disclosure that would make continuing a tipping-off offence` TRUE FALSE TRUE EQUALS NOTHING

§ `Under regulation 28(16), am I able to demonstrate to my supervisory authority that the extent of my measures is appropriate to the risks`
-- case: able to demonstrate, and not the National Savings Bank
#ASSERT `Under regulation 28(16), am I able to demonstrate to my supervisory authority that the extent of my measures is appropriate to the risks` TRUE TRUE FALSE EQUALS JUST TRUE
-- case: the National Savings Bank: paragraph (17) disapplies the duty
#ASSERT `Under regulation 28(16), am I able to demonstrate to my supervisory authority that the extent of my measures is appropriate to the risks` TRUE TRUE TRUE EQUALS JUST TRUE

§ `Under regulation 28(18)(a), is the identity verified on the basis of documents or information from a reliable source independent of the person`
-- case: a reliable, independent source
#ASSERT `Under regulation 28(18)(a), is the identity verified on the basis of documents or information from a reliable source independent of the person` TRUE TRUE EQUALS JUST TRUE
-- case: a source that is not independent
#ASSERT `Under regulation 28(18)(a), is the identity verified on the basis of documents or information from a reliable source independent of the person` TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 29(1), does regulation 29 apply to me in addition to regulation 28`
-- case: a financial institution
#ASSERT `Under regulation 29(1), does regulation 29 apply to me in addition to regulation 28` `financial institution` EQUALS JUST TRUE
-- case: an estate agent: regulation 29 applies where the person is a credit institution or a financial institution, and an estate agent is neither
#ASSERT `Under regulation 29(1), does regulation 29 apply to me in addition to regulation 28` `estate agent` EQUALS JUST FALSE

§ `Under regulation 29(6), may I set up an anonymous account, passbook or safe-deposit box`
-- case: a credit institution
#ASSERT `Under regulation 29(6), may I set up an anonymous account, passbook or safe-deposit box` `credit institution` EQUALS JUST FALSE
-- case: an estate agent: regulation 29 does not reach it
#ASSERT `Under regulation 29(6), may I set up an anonymous account, passbook or safe-deposit box` `estate agent` EQUALS NOTHING

§ `Under regulation 29(8), may I issue shares evidenced by a share certificate`
-- case: a financial institution that is an investment company authorised in 2020
#ASSERT `Under regulation 29(8), may I issue shares evidenced by a share certificate` `financial institution` TRUE (Date 1 3 2020) (Date 1 1 2020) (Date 1 3 2020) EQUALS JUST FALSE

§ `Under regulation 29(15), did my customer keep the records of a pooled-account payment for the whole five years`
-- case: kept the records to the day before the fifth anniversary
#ASSERT `Under regulation 29(15), did my customer keep the records of a pooled-account payment for the whole five years` (Date 15 3 2022) (Date 14 3 2027) EQUALS TRUE
-- case: stopped keeping the records two days early
#ASSERT `Under regulation 29(15), did my customer keep the records of a pooled-account payment for the whole five years` (Date 15 3 2022) (Date 12 3 2027) EQUALS FALSE

§ `Under regulation 30(3), may I complete the verification during the establishment of the business relationship`
-- case: verification completed as soon as practicable, necessary, little risk
#ASSERT `Under regulation 30(3), may I complete the verification during the establishment of the business relationship` TRUE TRUE TRUE EQUALS JUST TRUE
-- case: there is a real risk of money laundering
#ASSERT `Under regulation 30(3), may I complete the verification during the establishment of the business relationship` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Under regulation 30(4), may a credit institution or financial institution verify the identity of a customer opening an account after the account has been opened`
-- case: a credit institution with adequate safeguards
#ASSERT `Under regulation 30(4), may a credit institution or financial institution verify the identity of a customer opening an account after the account has been opened` `credit institution` TRUE TRUE EQUALS JUST TRUE
-- case: a credit institution without adequate safeguards
#ASSERT `Under regulation 30(4), may a credit institution or financial institution verify the identity of a customer opening an account after the account has been opened` `credit institution` TRUE FALSE EQUALS JUST FALSE
-- case: an estate agent: the paragraph is about credit and financial institutions
#ASSERT `Under regulation 30(4), may a credit institution or financial institution verify the identity of a customer opening an account after the account has been opened` `estate agent` TRUE TRUE EQUALS NOTHING

§ `Under regulation 30ZA(5), is this customer an insolvent bank customer`
-- case: a customer of an insolvent bank, new relationship on the 30th day
#ASSERT `Under regulation 30ZA(5), is this customer an insolvent bank customer` TRUE (Date 30 3 2024) (Date 1 3 2024) EQUALS JUST TRUE
-- case: new relationship on the 31st day
#ASSERT `Under regulation 30ZA(5), is this customer an insolvent bank customer` TRUE (Date 31 3 2024) (Date 1 3 2024) EQUALS JUST FALSE

§ `Under regulation 30A(3), to whom must I report a material discrepancy`
-- case: a company with persons of significant control
#ASSERT `Under regulation 30A(3), to whom must I report a material discrepancy` `reg 30A(1)(a) a company which is subject to the requirements of Part 21A of the Companies Act 2006` EQUALS JUST `reg 30A(3)(a) the registrar referred to in section 1060(3) of the Companies Act 2006`
-- case: a trust registered under Part 5
#ASSERT `Under regulation 30A(3), to whom must I report a material discrepancy` `reg 30A(1)(e) a trust which is subject to registration under Part 5 of these Regulations` EQUALS JUST `reg 30A(3)(b) the Commissioners`
-- case: an overseas entity
#ASSERT `Under regulation 30A(3), to whom must I report a material discrepancy` `reg 30A(1)(f) an overseas entity which is subject to registration under Part 1 of the Economic Crime (Transparency and Enforcement) Act 2022` EQUALS JUST `reg 30A(3)(c) the registrar of companies for England and Wales`
-- case: a customer of a type paragraph (1) does not describe: the text does not answer
#ASSERT `Under regulation 30A(3), to whom must I report a material discrepancy` `reg 30A(1) a customer of another type` EQUALS NOTHING

§ `Under regulation 31(1)(a), may I carry out a transaction through a bank account with a customer whose due diligence I cannot complete`
-- case: unable to complete due diligence: no transaction through a bank account
#ASSERT `Under regulation 31(1)(a), may I carry out a transaction through a bank account with a customer whose due diligence I cannot complete` TRUE `I am not sure` No No EQUALS JUST FALSE
-- case: repaying the depositor with consent where a disclosure is required
#ASSERT `Under regulation 31(1)(a), may I carry out a transaction through a bank account with a customer whose due diligence I cannot complete` TRUE Yes No No EQUALS JUST TRUE
-- case: a solicitor defending a client in proceedings: paragraph (3) takes the case out
#ASSERT `Under regulation 31(1)(a), may I carry out a transaction through a bank account with a customer whose due diligence I cannot complete` TRUE No Yes No EQUALS NOTHING

§ `Under regulation 31(1)(b), may I establish a business relationship or carry out a transaction with a customer, otherwise than through a bank account, whose due diligence I cannot complete`
-- case: unable to complete due diligence: no relationship or transaction outside a bank account
#ASSERT `Under regulation 31(1)(b), may I establish a business relationship or carry out a transaction with a customer, otherwise than through a bank account, whose due diligence I cannot complete` TRUE No No EQUALS JUST FALSE

§ `Under regulation 31(1)(c), must I terminate an existing business relationship with a customer whose due diligence I cannot complete`
-- case: unable to complete due diligence: must terminate
#ASSERT `Under regulation 31(1)(c), must I terminate an existing business relationship with a customer whose due diligence I cannot complete` TRUE FALSE EQUALS JUST TRUE
-- case: an insolvency practitioner within paragraph (5): the duty falls away
#ASSERT `Under regulation 31(1)(c), must I terminate an existing business relationship with a customer whose due diligence I cannot complete` TRUE TRUE EQUALS JUST FALSE

§ `Under regulation 31(1)(d), must I consider whether I am required to make a disclosure`
-- case: unable to complete due diligence: must consider a disclosure
#ASSERT `Under regulation 31(1)(d), must I consider whether I am required to make a disclosure` TRUE FALSE EQUALS JUST TRUE

§ `Under regulation 32(1), am I required to apply the measure in regulation 28(3) and (4) to the holders of debt instruments of which I am trustee`
-- case: a trustee of a debt issue with specified instruments
#ASSERT `Under regulation 32(1), am I required to apply the measure in regulation 28(3) and (4) to the holders of debt instruments of which I am trustee` TRUE FALSE Yes EQUALS JUST FALSE
-- case: a trustee of a debt issue whose instruments are not specified: the regulation does not answer
#ASSERT `Under regulation 32(1), am I required to apply the measure in regulation 28(3) and (4) to the holders of debt instruments of which I am trustee` TRUE FALSE No EQUALS NOTHING

