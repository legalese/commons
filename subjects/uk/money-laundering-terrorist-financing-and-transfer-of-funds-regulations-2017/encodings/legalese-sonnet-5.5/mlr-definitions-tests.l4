#ASSERT `reg 6(5) the interest is a specified interest` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 6(5) the interest is a specified interest` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 6(5) the interest is a specified interest` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 6(5) the interest is a specified interest` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- reg 6(6): the estate of a deceased person in the course of administration.
