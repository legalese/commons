-- "supervisory functions" means the functions given to a supervisory authority under these Regulations.
#ASSERT `reg 3(1) the function is a supervisory function` TRUE EQUALS JUST TRUE
#ASSERT `reg 3(1) the function is a supervisory function` FALSE EQUALS JUST FALSE

-- "terrorist financing" (except where the context otherwise requires): a closed list of offences.
#ASSERT `reg 3(1) the act is terrorist financing` FALSE `an offence under section 15, 16, 17, 18 or 63 of the Terrorism Act 2000` EQUALS JUST TRUE
#ASSERT `reg 3(1) the act is terrorist financing` FALSE `an offence under paragraph 7(2) or (3) of Schedule 3 to the Anti-terrorism, Crime and Security Act 2001` EQUALS JUST TRUE
#ASSERT `reg 3(1) the act is terrorist financing` FALSE `an offence under regulations 8 to 13, 25 or 26 of the ISIL (Da'esh) and Al-Qaida (United Nations Sanctions) (EU Exit) Regulations 2019 or regulations 11 to 16 of the Counter-Terrorism (International Sanctions) (EU Exit) Regulations 2019` EQUALS JUST TRUE
#ASSERT `reg 3(1) the act is terrorist financing` FALSE `an offence under regulations 11 to 16 of the Counter-Terrorism (Sanctions) (EU Exit) Regulations 2019` EQUALS JUST TRUE
#ASSERT `reg 3(1) the act is terrorist financing` FALSE `an offence under any other provision` EQUALS JUST FALSE
#ASSERT `reg 3(1) the act is terrorist financing` TRUE `an offence under section 15, 16, 17, 18 or 63 of the Terrorism Act 2000` EQUALS NOTHING

-- "third country" means a state other than the United Kingdom.
#ASSERT `reg 3(1) the place is a third country` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 3(1) the place is a third country` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 3(1) the place is a third country` FALSE FALSE EQUALS JUST FALSE

-- "UK regulated market" means a recognised investment exchange within section 285(1)(a) of FSMA which is not an overseas investment exchange.
#ASSERT `reg 3(1) the market is a UK regulated market` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 3(1) the market is a UK regulated market` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 3(1) the market is a UK regulated market` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 3(1) the market is a UK regulated market` FALSE TRUE EQUALS JUST FALSE

§ `Tests: reg 3(2), rules of reading`

-- (b): a sum in sterling is converted at the London closing rate for the previous working day.  800 pounds at 1.25 units per pound is 1000 units.
#ASSERT `reg 3(2)(b) the equivalent in another currency of a sum in sterling` 800 1.25 EQUALS JUST 1000
#ASSERT `reg 3(2)(b) the equivalent in another currency of a sum in sterling` 0 1.25 EQUALS JUST 0
-- the rate is outside the text; a rate that is not positive is no rate
#ASSERT `reg 3(2)(b) the equivalent in another currency of a sum in sterling` 800 0 EQUALS NOTHING
#ASSERT `reg 3(2)(b) the equivalent in another currency of a sum in sterling` 800 (0 MINUS 1) EQUALS NOTHING

-- (a): "an amount in sterling includes ... an equivalent amount in any currency".  A threshold of 800 pounds is 1000 units at 1.25.
#ASSERT `reg 3(2)(a) the amount is at least the sterling threshold` 800 TRUE 800 1 EQUALS JUST TRUE
#ASSERT `reg 3(2)(a) the amount is at least the sterling threshold` 799 TRUE 800 1 EQUALS JUST FALSE
#ASSERT `reg 3(2)(a) the amount is at least the sterling threshold` 1000 FALSE 800 1.25 EQUALS JUST TRUE
#ASSERT `reg 3(2)(a) the amount is at least the sterling threshold` 999 FALSE 800 1.25 EQUALS JUST FALSE
#ASSERT `reg 3(2)(a) the amount is at least the sterling threshold` 1000 FALSE 800 0 EQUALS NOTHING
#ASSERT `reg 3(2)(a) the amount exceeds the sterling threshold` 800 TRUE 800 1 EQUALS JUST FALSE
#ASSERT `reg 3(2)(a) the amount exceeds the sterling threshold` 801 TRUE 800 1 EQUALS JUST TRUE
#ASSERT `reg 3(2)(a) the amount exceeds the sterling threshold` 1000 FALSE 800 1.25 EQUALS JUST FALSE
#ASSERT `reg 3(2)(a) the amount exceeds the sterling threshold` 1001 FALSE 800 1.25 EQUALS JUST TRUE
#ASSERT `reg 3(2)(a) the amount exceeds the sterling threshold` 1001 FALSE 800 0 EQUALS NOTHING

-- (c): "real property" includes, in relation to Scotland, heritable property.
#ASSERT `reg 3(2)(c) the property is real property` `Scotland` TRUE EQUALS JUST TRUE
#ASSERT `reg 3(2)(c) the property is real property` `Scotland` FALSE EQUALS NOTHING
#ASSERT `reg 3(2)(c) the property is real property` `England and Wales` TRUE EQUALS NOTHING
#ASSERT `reg 3(2)(c) the property is real property` `Northern Ireland` TRUE EQUALS NOTHING

-- (d), (e), (f): rules of reading that point.
#ASSERT `reg 3(2)(d) references to carrying on business in the United Kingdom are read in accordance with` EQUALS "regulation 9"
#ASSERT `reg 3(2)(e) a qualifying relationship is read in accordance with` EQUALS "section 415B(4) of FSMA"
#ASSERT `reg 3(2)(f) parent undertaking and subsidiary undertaking have the same meaning as in` EQUALS "the Companies Acts (see section 1162 of and Schedule 7 to, the Companies Act 2006 (parent and subsidiary undertaking) )"

§ `Tests: reg 4, business relationship`

-- (1): a business, professional or commercial relationship between a relevant person and a customer which arises out of the business and is expected to have an element of duration.
#ASSERT `reg 4(1) the relationship is a business relationship` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 4(1) the relationship is a business relationship` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 4(1) the relationship is a business relationship` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 4(1) the relationship is a business relationship` TRUE TRUE FALSE EQUALS JUST FALSE
-- (2): the services of regulation 12(2)(a), (ab), (b) or (d) are a business relationship whether or not duration is expected.
#ASSERT `reg 4(2) the relationship is treated as a business relationship` TRUE EQUALS JUST TRUE
#ASSERT `reg 4(2) the relationship is treated as a business relationship` FALSE EQUALS NOTHING
-- (3): an estate agent and a purchaser, at the point the offer is accepted.
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` (LIST `letting agent`, `estate agent`) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) TRUE FALSE EQUALS NOTHING
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) FALSE TRUE EQUALS NOTHING
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` (LIST `letting agent`) TRUE TRUE EQUALS NOTHING
#ASSERT `reg 4(3) the estate agent is treated as entering into a business relationship with the purchaser` EMPTY TRUE TRUE EQUALS NOTHING
#ASSERT `reg 4(3) the date on which the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) TRUE (JUST (Date 12 3 2026)) EQUALS JUST (Date 12 3 2026)
#ASSERT `reg 4(3) the date on which the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 4(3) the date on which the estate agent is treated as entering into a business relationship with the purchaser` (LIST `estate agent`) FALSE (JUST (Date 12 3 2026)) EQUALS NOTHING
#ASSERT `reg 4(3) the date on which the estate agent is treated as entering into a business relationship with the purchaser` (LIST `letting agent`) TRUE (JUST (Date 12 3 2026)) EQUALS NOTHING
-- (1) to (3) gathered: any route that holds settles it; with none, reg 4(1) "means" and the answer is no.
#ASSERT `reg 4(1) to (3) there is a business relationship` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `reg 4(1) to (3) there is a business relationship` (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `reg 4(1) to (3) there is a business relationship` (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 4(1) to (3) there is a business relationship` (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `reg 4(1) to (3) there is a business relationship` NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `reg 4(1) to (3) there is a business relationship` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE

§ `Tests: reg 5, beneficial owner of a body corporate or partnership`

-- Test fixtures: a customer of a given form, and the facts about one individual and the entity.
GIVEN form IS A `Form of customer`
      listed IS A BOOLEAN
GIVETH A Customer
`reg 5 test case: a customer` MEANS
    Customer WITH
        `form of the customer` IS form
        `securities listed on a regulated market` IS listed
        `beneficially owned by another person` IS FALSE
        `a person purports to act on its behalf` IS FALSE

GIVEN control IS A BOOLEAN
      shares IS A NUMBER
      voting IS A NUMBER
      `the Schedule 1A conditions` IS A BOOLEAN
      `the subsidiary undertaking test` IS A BOOLEAN
GIVETH A `reg 5 Facts about an individual and a body corporate`
`reg 5 test case: facts about a body corporate` MEANS
    `reg 5 Facts about an individual and a body corporate` WITH
        `exercises ultimate control over the management of the body corporate` IS control
        `percentage of the shares ultimately owned or controlled, directly or indirectly` IS shares
        `percentage of the voting rights ultimately owned or controlled, directly or indirectly` IS voting
        `satisfies one or more of the conditions in Part 1 of Schedule 1A to the Companies Act 2006` IS `the Schedule 1A conditions`
        `the body corporate would be a subsidiary undertaking of the individual, if the individual was an undertaking, under section 1162 of the Companies Act 2006 read with Schedule 7 to that Act` IS `the subsidiary undertaking test`

-- reg 5(2): an individual controls a body corporate if (a) it is a company or LLP and the individual satisfies a Schedule 1A condition, or (b) it would be the individual's subsidiary undertaking.
#ASSERT `reg 5(2) the individual controls the body corporate` `a company` (`reg 5 test case: facts about a body corporate` FALSE 0 0 TRUE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(2) the individual controls the body corporate` `a limited liability partnership` (`reg 5 test case: facts about a body corporate` FALSE 0 0 TRUE FALSE) EQUALS JUST TRUE
-- limb (a) is limited to a company or a limited liability partnership
#ASSERT `reg 5(2) the individual controls the body corporate` `a body corporate of another kind` (`reg 5 test case: facts about a body corporate` FALSE 0 0 TRUE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(2) the individual controls the body corporate` `a body corporate of another kind` (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE TRUE) EQUALS JUST TRUE
#ASSERT `reg 5(2) the individual controls the body corporate` `a company` (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE TRUE) EQUALS JUST TRUE
#ASSERT `reg 5(2) the individual controls the body corporate` `a company` (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE FALSE) EQUALS JUST FALSE

-- reg 5(1): (a) ultimate control over management; (b) MORE THAN 25% of the shares or voting rights; (c) control under paragraph (2).
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` TRUE 0 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 26 0 FALSE FALSE) EQUALS JUST TRUE
-- the boundary: exactly 25% is not "more than 25%"
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 25 25 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 25.5 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 26 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 25 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 0 TRUE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE TRUE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a limited liability partnership` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 26 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a limited liability partnership` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a body corporate of another kind` FALSE) (`reg 5 test case: facts about a body corporate` FALSE 30 0 FALSE FALSE) EQUALS JUST TRUE
-- a company whose securities are listed on a regulated market: paragraph (1) is silent
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` TRUE) (`reg 5 test case: facts about a body corporate` TRUE 90 90 TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a company` TRUE) (`reg 5 test case: facts about a body corporate` FALSE 0 0 FALSE FALSE) EQUALS NOTHING
-- other forms: paragraph (1) is about a body corporate
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a body corporate` TRUE 90 90 TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a trust` FALSE) (`reg 5 test case: facts about a body corporate` TRUE 90 90 TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `an individual` FALSE) (`reg 5 test case: facts about a body corporate` TRUE 90 90 TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 5(1) the individual is a beneficial owner of the body corporate` (`reg 5 test case: a customer` `a corporation sole` FALSE) (`reg 5 test case: facts about a body corporate` TRUE 90 90 TRUE TRUE) EQUALS NOTHING

-- reg 5(3): a partnership other than a limited liability partnership.
GIVEN capital IS A NUMBER
      profits IS A NUMBER
      voting IS A NUMBER
      `the Scottish conditions` IS A BOOLEAN
      control IS A BOOLEAN
GIVETH A `reg 5 Facts about an individual and a partnership`
`reg 5 test case: facts about a partnership` MEANS
    `reg 5 Facts about an individual and a partnership` WITH
        `percentage of the capital ultimately entitled to or controlled, directly or indirectly` IS capital
        `percentage of the profits ultimately entitled to or controlled, directly or indirectly` IS profits
        `percentage of the voting rights ultimately entitled to or controlled, directly or indirectly` IS voting
        `satisfies one or more of the conditions in Part 1 of Schedule 1 to the Scottish Partnerships (Register of People with Significant Control) Regulations 2017` IS `the Scottish conditions`
        `otherwise exercises ultimate control over the management of the partnership` IS control

#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 26 0 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 0 26 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 0 0 26 FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 25 25 25 FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 0 0 0 TRUE FALSE) EQUALS JUST TRUE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 0 0 0 FALSE TRUE) EQUALS JUST TRUE
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a partnership other than a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 0 0 0 FALSE FALSE) EQUALS JUST FALSE
-- a limited liability partnership is governed by paragraph (1), not (3)
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a limited liability partnership` FALSE) (`reg 5 test case: facts about a partnership` 90 90 90 TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 5(3) the individual is a beneficial owner of the partnership` (`reg 5 test case: a customer` `a company` FALSE) (`reg 5 test case: facts about a partnership` 90 90 90 TRUE TRUE) EQUALS NOTHING

-- reg 5(4): "limited liability partnership" is a borrowed term.
#ASSERT `reg 5(4) limited liability partnership is given by` EQUALS "the Limited Liability Partnerships Act 2000"

§ `Tests: reg 6, beneficial owner of a trust, similar arrangement or other entity`

-- reg 6(2): "control" means a power under the trust instrument or by law to do one of five things.
#ASSERT `reg 6(2) the power is control over the trust` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 6(2) the power is control over the trust` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 6(2) the power is control over the trust` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 6(2) the power is control over the trust` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 6(2) the power is control over the trust` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 6(2) the power is control over the trust` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 6(2) the power is control over the trust` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- reg 6(4)(b): an individual does not have control SOLELY as a result of any one of four things.
#ASSERT `reg 6(4)(b) the individual has control over the trust, given the four exclusions` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 6(4)(b) the individual has control over the trust, given the four exclusions` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 6(4)(b) the individual has control over the trust, given the four exclusions` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 6(4)(b) the individual has control over the trust, given the four exclusions` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- any other basis: the paragraph says nothing
#ASSERT `reg 6(4)(b) the individual has control over the trust, given the four exclusions` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- gathered: the exclusion (a flat negative) defeats a power that reg 6(2) would otherwise call control
#ASSERT `reg 6(2) and (4)(b) the individual has control over the trust` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 6(2) and (4)(b) the individual has control over the trust` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `reg 6(2) and (4)(b) the individual has control over the trust` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `reg 6(2) and (4)(b) the individual has control over the trust` NOTHING NOTHING EQUALS NOTHING

-- reg 6(1): in relation to a trust, each of the settlor, the trustees, the beneficiaries, the class (where the individuals have not been determined) and any individual with control.
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `the settlor` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `a trustee` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `a beneficiary` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `a member of the class of persons in whose main interest the trust is set up, or operates` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `a member of the class of persons in whose main interest the trust is set up, or operates` FALSE NOTHING EQUALS NOTHING
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `an individual who has control over the trust` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `an individual who has control over the trust` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `an individual who has control over the trust` FALSE NOTHING EQUALS NOTHING
#ASSERT `reg 6(1) the person is a beneficial owner of the trust` `some other position in relation to the trust` FALSE NOTHING EQUALS JUST FALSE

-- reg 6(3): a foundation or other legal arrangement similar to a trust.
#ASSERT `reg 6(3) the individual is a beneficial owner of the foundation or other legal arrangement` TRUE EQUALS JUST TRUE
#ASSERT `reg 6(3) the individual is a beneficial owner of the foundation or other legal arrangement` FALSE EQUALS JUST FALSE

-- reg 6(4)(a): the beneficial owner of a body corporate that has the interest or the control is regarded as having it.
