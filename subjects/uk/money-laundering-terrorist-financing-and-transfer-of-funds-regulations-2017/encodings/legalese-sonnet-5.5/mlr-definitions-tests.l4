-- reg 7(1)(a): the FCA.  (i) credit and financial institutions (including money service businesses) which are authorised persons but not excluded money service businesses.
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an authorised bank`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an authorised financial institution`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an authorised money service business`
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an unauthorised bank`)
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an excluded money service business`)
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an unauthorised money service business`)
-- (ii) trust or company service providers which are authorised persons
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an authorised trust or company service provider`
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an unauthorised trust or company service provider with no professional body`)
-- (iii) Annex 1 financial institutions; (iv) electronic money institutions; (v) auction platforms; (vi) credit unions in Northern Ireland; (vii) recognised investment exchanges; (viii) cryptoasset exchange providers; (ix) custodian wallet providers
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an Annex 1 financial institution`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an electronic money institution`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: an auction platform`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a credit union in Northern Ireland`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a recognised investment exchange`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a cryptoasset exchange provider`
#ASSERT `reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a custodian wallet provider`
-- a class the FCA does not supervise
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a casino`)
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a high value dealer`)
#ASSERT NOT (`reg 7(1)(a) the relevant person is within a class the FCA supervises` `reg 7 test case: a person in no listed class`)

-- reg 7(1)(b): each professional body listed in Schedule 1 is the supervisory authority for relevant persons who are members of it, or regulated or supervised by it.
#ASSERT `reg 7(1)(b) the professional bodies that are supervisory authorities for the relevant person` `reg 7 test case: an auditor in the Institute of Chartered Accountants in England and Wales` EQUALS LIST `a professional body listed in Schedule 1` `Institute of Chartered Accountants in England and Wales`
#ASSERT `reg 7(1)(b) the professional bodies that are supervisory authorities for the relevant person` `reg 7 test case: an unauthorised trust or company service provider in the Law Society` EQUALS LIST `a professional body listed in Schedule 1` `Law Society`
#ASSERT `reg 7(1)(b) the professional bodies that are supervisory authorities for the relevant person` `reg 7 test case: an auditor with no professional body` EQUALS EMPTY

-- reg 7(1)(c): the Commissioners.  (i) high value dealers
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a high value dealer`
-- (ii) money service businesses which are not supervised by the FCA
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an unauthorised money service business`
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an excluded money service business`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an authorised money service business`)
-- (iii) trust or company service providers not supervised by the FCA or one of the professional bodies
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an unauthorised trust or company service provider with no professional body`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an unauthorised trust or company service provider in the Law Society`)
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an authorised trust or company service provider`)
-- (iv) auditors, external accountants and tax advisers not supervised by a professional body
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an auditor with no professional body`
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an external accountant with no professional body`
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a tax adviser with no professional body`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an auditor in the Institute of Chartered Accountants in England and Wales`)
-- (v) bill payment service providers and (vi) telecommunication, digital and IT payment service providers, not supervised by the FCA
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a bill payment service provider not supervised by the FCA`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a bill payment service provider that is an authorised bank`)
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a telecommunication, digital and IT payment service provider not supervised by the FCA`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a telecommunication, digital and IT payment service provider that is an authorised bank`)
-- (vii) estate agents and letting agents not supervised by a professional body
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an estate agent with no professional body`
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a letting agent with no professional body`
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an estate agent in the Law Society`)
-- (viii) art market participants
#ASSERT `reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an art market participant`
-- not the Commissioners' class
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a casino`)
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: an authorised bank`)
#ASSERT NOT (`reg 7(1)(c) the relevant person is within a class the Commissioners supervise` `reg 7 test case: a person in no listed class`)

-- reg 7(1)(d): the Gambling Commission is the supervisory authority for casinos.
#ASSERT `reg 7(1)(d) the relevant person is within a class the Gambling Commission supervises` `reg 7 test case: a casino`
#ASSERT `reg 7(1)(d) the relevant person is within a class the Gambling Commission supervises` `reg 7 test case: a casino that is also a high value dealer`
#ASSERT NOT (`reg 7(1)(d) the relevant person is within a class the Gambling Commission supervises` `reg 7 test case: a high value dealer`)
#ASSERT NOT (`reg 7(1)(d) the relevant person is within a class the Gambling Commission supervises` `reg 7 test case: a person in no listed class`)

-- reg 7(1) as a whole: all the authorities that apply, in the order (a), (b), (c), (d); NOTHING for a person no paragraph lists.
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: an authorised bank` EQUALS JUST (LIST `the Financial Conduct Authority`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: a high value dealer` EQUALS JUST (LIST `the Commissioners for Her Majesty's Revenue and Customs`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: a casino` EQUALS JUST (LIST `the Gambling Commission`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: a casino that is also a high value dealer` EQUALS JUST (LIST `the Commissioners for Her Majesty's Revenue and Customs`, `the Gambling Commission`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: an auditor in the Institute of Chartered Accountants in England and Wales` EQUALS JUST (LIST `a professional body listed in Schedule 1` `Institute of Chartered Accountants in England and Wales`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: an unauthorised trust or company service provider in the Law Society` EQUALS JUST (LIST `a professional body listed in Schedule 1` `Law Society`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: an excluded money service business` EQUALS JUST (LIST `the Commissioners for Her Majesty's Revenue and Customs`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: a bill payment service provider that is an authorised bank` EQUALS JUST (LIST `the Financial Conduct Authority`)
#ASSERT `reg 7(1) the supervisory authorities of the relevant person` `reg 7 test case: a person in no listed class` EQUALS NOTHING

-- reg 7(2): more than one supervisory authority, so they may agree that one acts.
#ASSERT `reg 7(2) the supervisory authorities may agree that one of them acts as the supervisory authority` EMPTY EQUALS NOTHING
#ASSERT `reg 7(2) the supervisory authorities may agree that one of them acts as the supervisory authority` (LIST `the Financial Conduct Authority`) EQUALS NOTHING
#ASSERT `reg 7(2) the supervisory authorities may agree that one of them acts as the supervisory authority` (LIST `the Commissioners for Her Majesty's Revenue and Customs`, `the Gambling Commission`) EQUALS JUST TRUE
#ASSERT `reg 7(2) the supervisory authorities may agree that one of them acts as the supervisory authority` (LIST `the Financial Conduct Authority`, `the Commissioners for Her Majesty's Revenue and Customs`, `the Gambling Commission`) EQUALS JUST TRUE

-- reg 7(3): where there has been an agreement, the authority which has agreed to act must notify the relevant person or publish the agreement.
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(3) the authority which agreed to act has notified the relevant person or published the agreement` TRUE FALSE FALSE EQUALS JUST FALSE

-- reg 7(4): where there has not been an agreement, the supervisory authorities must co-operate.
#ASSERT `reg 7(4) the supervisory authorities for the relevant person must co-operate in the performance of their functions` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(4) the supervisory authorities for the relevant person must co-operate in the performance of their functions` TRUE TRUE EQUALS NOTHING
#ASSERT `reg 7(4) the supervisory authorities for the relevant person must co-operate in the performance of their functions` FALSE FALSE EQUALS NOTHING

-- reg 7(5): an excluded money service business is an authorised money service business with the credit-agreement or hire permission and no other permission.
#ASSERT `reg 7(5) the money service business is an excluded money service business` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 7(5) the money service business is an excluded money service business` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 7(5) the money service business is an excluded money service business` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 7(5) the money service business is an excluded money service business` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 7(5) the money service business is an excluded money service business` FALSE TRUE TRUE FALSE EQUALS JUST FALSE

-- reg 7(6): paragraph (5) is read with three provisions of FSMA.
#ASSERT `reg 7(6) paragraph (5) must be read with` EQUALS LIST "section 22 of FSMA (regulated activities)", "any relevant order under that section", "Schedule 2 to that Act"

-- reg 7(7): a credit union in Northern Ireland is registered under the 1985 Order or the 1969 Act, and is an authorised person.
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 7(7) the credit union is a credit union in Northern Ireland` FALSE FALSE TRUE EQUALS JUST FALSE
