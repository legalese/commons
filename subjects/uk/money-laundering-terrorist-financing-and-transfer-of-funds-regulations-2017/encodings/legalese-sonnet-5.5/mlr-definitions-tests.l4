#ASSERT `reg 3(1) the entity is a body corporate` `a limited liability partnership` FALSE EQUALS JUST TRUE
#ASSERT `reg 3(1) the entity is a body corporate` `a body corporate of another kind` FALSE EQUALS JUST TRUE
