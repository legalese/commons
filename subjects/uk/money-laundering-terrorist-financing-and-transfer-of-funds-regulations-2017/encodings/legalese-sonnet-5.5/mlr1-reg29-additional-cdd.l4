        IF NOT (`the beneficiary is a named person or legal arrangement`) THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "the beneficiary is a named person or legal arrangement" (Marginal readings, (a): a failed condition of an "if")
        OTHERWISE JUST TRUE

@ref reg 29(3)(a) (src:880-881)
