        IF `reg 29(1) this regulation applies` EQUALS JUST FALSE THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "This regulation applies in addition to regulation 28 where a relevant person is a credit institution or a financial institution" (assumed 2026-11-05, fork F-when: "when" read as "where"; ruling (b): a "where" condition not met)
        IF NOT (`reg 29(1) this regulation applies` EQUALS JUST TRUE) THEN NOTHING -- NOTHING-kind (points outside the text): "reg 29(1) this regulation applies" has not been answered
        IF `reg 29(2) paragraphs (3) to (5) apply` EQUALS JUST FALSE THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "Paragraphs (3) to (5) apply if the relevant person is providing a customer with a contract of long-term insurance" (Marginal readings, (a): a failed condition of an "if")
        IF NOT (`reg 29(2) paragraphs (3) to (5) apply` EQUALS JUST TRUE) THEN NOTHING -- NOTHING-kind (points outside the text): "reg 29(2) paragraphs (3) to (5) apply" has not been answered
        IF NOT (`the beneficiaries of the insurance policy are identified or designated`) THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "the beneficiaries of the insurance policy are identified or designated" (ruling 2026-11-05, (b): a "where" condition not met; "when", "upon", "whenever" read as "where", fork F-when)
        OTHERWISE JUST TRUE

@ref reg 29(3)(a) (src:881-881)
