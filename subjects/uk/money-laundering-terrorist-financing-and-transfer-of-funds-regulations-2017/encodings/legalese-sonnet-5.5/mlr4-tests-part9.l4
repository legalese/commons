IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr4-part9`


-- TESTS for mlr4-part9 (regulations 75 to 92).  Every expected value was decided by reading the
-- provision (the words are quoted beside the assertion), not by running the code.  A function
-- that can answer NOTHING has a NOTHING case; a boundary has a case on each side.

§ `Tests -- Part 9`

§§ `Regulation 75`

#ASSERT `reg 75 the requirement is a relevant requirement` (JUST TRUE) EQUALS JUST TRUE -- Schedule 6 lists it
#ASSERT `reg 75 the requirement is a relevant requirement` (JUST FALSE) EQUALS JUST FALSE -- Schedule 6 does not
#ASSERT `reg 75 the requirement is a relevant requirement` NOTHING EQUALS NOTHING -- Schedule 6 has not answered

§§ `Regulation 76`

#ASSERT `reg 76(8)(b) the body is a designated supervisory authority` `the Financial Conduct Authority` EQUALS JUST TRUE -- "the FCA or the Commissioners"
#ASSERT `reg 76(8)(b) the body is a designated supervisory authority` `the Commissioners for Her Majesty's Revenue and Customs` EQUALS JUST TRUE
#ASSERT `reg 76(8)(b) the body is a designated supervisory authority` `the Treasury` EQUALS JUST FALSE -- "means"
#ASSERT `reg 76(8)(b) the body is a designated supervisory authority` `the Prudential Regulation Authority` EQUALS JUST FALSE
#ASSERT `reg 76(8)(a) the penalty or measure is appropriate` FALSE TRUE TRUE TRUE EQUALS JUST TRUE -- effective, proportionate and dissuasive
#ASSERT `reg 76(8)(a) the penalty or measure is appropriate` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- not dissuasive
#ASSERT `reg 76(8)(a) the penalty or measure is appropriate` FALSE FALSE TRUE TRUE EQUALS JUST FALSE -- not effective
#ASSERT `reg 76(8)(a) the penalty or measure is appropriate` FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- not proportionate
#ASSERT `reg 76(8)(a) the penalty or measure is appropriate` TRUE TRUE TRUE TRUE EQUALS NOTHING -- "other than in references to an appropriate body"
#ASSERT `reg 76(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 76(1) paragraph (2) applies` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE -- not satisfied that P has contravened
#ASSERT `reg 76(1) paragraph (2) applies` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE -- not a designated supervisory authority
#ASSERT `reg 76(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE -- not a relevant requirement
#ASSERT `reg 76(1) paragraph (2) applies` NOTHING TRUE (JUST TRUE) EQUALS NOTHING -- the authority's status is not shown
#ASSERT `reg 76(1) paragraph (2) applies` (JUST TRUE) TRUE NOTHING EQUALS NOTHING -- Schedule 6 has not answered
#ASSERT `reg 76(1) paragraph (2) applies` NOTHING FALSE (JUST TRUE) EQUALS JUST FALSE -- not satisfied, whatever the authority's status
#ASSERT `reg 76(2) the designated supervisory authority may` (JUST TRUE) `reg 76(2)(a) impose a penalty of such amount as it considers appropriate on P` EQUALS JUST TRUE -- impose a penalty
#ASSERT `reg 76(2) the designated supervisory authority may` (JUST TRUE) `reg 76(2)(b) publish a statement censuring P` EQUALS JUST TRUE -- publish a statement
#ASSERT `reg 76(2) the designated supervisory authority may` (JUST TRUE) `reg 76(2) some other measure` EQUALS NOTHING
#ASSERT `reg 76(2) the designated supervisory authority may` (JUST FALSE) `reg 76(2)(a) impose a penalty of such amount as it considers appropriate on P` EQUALS JUST FALSE -- "Paragraph (2) applies if" and it does not (marginal reading (a); was NOTHING)
#ASSERT `reg 76(2) the designated supervisory authority may` NOTHING `reg 76(2)(a) impose a penalty of such amount as it considers appropriate on P` EQUALS NOTHING
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST TRUE) NOTHING TRUE (JUST TRUE) EQUALS NOTHING -- the officer's status is not shown
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST TRUE) (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE -- the authority does not consider it: failed "if" (marginal reading (a)); was NOTHING
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST FALSE) (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE -- failed "if" (marginal reading (a)); was NOTHING
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST TRUE) (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE -- not an officer at all: a failed "if" (marginal reading (a))
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` (JUST TRUE) (JUST TRUE) TRUE NOTHING EQUALS NOTHING -- whether the requirement is a relevant requirement is not shown
#ASSERT `reg 76(3) the designated supervisory authority may impose a penalty on the officer` NOTHING (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE -- a definite no wins over an answer that is not in
#ASSERT `reg 76(4) the designated supervisory authority may impose a penalty on P` TRUE TRUE EQUALS JUST FALSE -- "must not impose a penalty on P ... if the authority is satisfied"
#ASSERT `reg 76(4) the designated supervisory authority may impose a penalty on P` TRUE FALSE EQUALS NOTHING -- not satisfied of the steps
#ASSERT `reg 76(4) the designated supervisory authority may impose a penalty on P` FALSE TRUE EQUALS NOTHING -- a penalty on an officer is outside paragraph (4)
#ASSERT `reg 76(4) the prohibition on the designated supervisory authority` (JUST TRUE) EQUALS FULFILLED -- nothing is prohibited
#ASSERT `reg 76(4) the prohibition on the designated supervisory authority` NOTHING EQUALS FULFILLED
#TRACE `reg 76(4) the prohibition on the designated supervisory authority` (JUST FALSE) AT 0 WITH
    PARTY `reg 76(4) the designated supervisory authority` DOES `reg 76(4) the designated supervisory authority imposes a penalty on P` AT 2
#TRACE `reg 76(4) the prohibition on the designated supervisory authority` (JUST FALSE) AT 0 WITH
    WAITUNTIL 10
#ASSERT `reg 76(5) the FCA consulted the PRA` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 76(5) the FCA consulted the PRA` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- no consultation
#ASSERT `reg 76(5) the FCA consulted the PRA` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- qualifying relationship
#ASSERT `reg 76(5) the FCA consulted the PRA` TRUE FALSE FALSE FALSE EQUALS NOTHING -- neither kind of person
#ASSERT `reg 76(5) the FCA consulted the PRA` FALSE TRUE FALSE FALSE EQUALS NOTHING -- no penalty proposed
#ASSERT `reg 76(5) the duty to consult the PRA arises` TRUE TRUE FALSE EQUALS JUST TRUE -- a PRA-authorised person
#ASSERT `reg 76(5) the duty to consult the PRA arises` TRUE FALSE TRUE EQUALS JUST TRUE -- a qualifying relationship
#ASSERT `reg 76(5) the duty to consult the PRA arises` TRUE FALSE FALSE EQUALS JUST FALSE -- neither kind of person: "Where ..." (ruled 2026-11-05 (b))
#ASSERT `reg 76(5) the duty to consult the PRA arises` FALSE TRUE FALSE EQUALS JUST FALSE -- no penalty proposed
#ASSERT `reg 76(6)(b) the guidance is guidance the authority must consider` TRUE FALSE FALSE EQUALS JUST TRUE -- issued by the FCA
#ASSERT `reg 76(6)(b) the guidance is guidance the authority must consider` FALSE TRUE TRUE EQUALS JUST TRUE -- other authority and approved by the Treasury
#ASSERT `reg 76(6)(b) the guidance is guidance the authority must consider` FALSE TRUE FALSE EQUALS JUST FALSE -- not approved
#ASSERT `reg 76(6)(b) the guidance is guidance the authority must consider` FALSE FALSE TRUE EQUALS JUST FALSE -- nobody listed issued it
#ASSERT `reg 76(6) the authority considered whether P followed the guidance` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 76(6) the authority considered whether P followed the guidance` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE -- "must consider"
#ASSERT `reg 76(6) the authority considered whether P followed the guidance` TRUE (JUST FALSE) FALSE EQUALS NOTHING -- not that kind of guidance
#ASSERT `reg 76(6) the authority considered whether P followed the guidance` FALSE (JUST TRUE) FALSE EQUALS NOTHING -- not deciding whether P contravened
#ASSERT `reg 76(7) the penalty is payable to` TRUE `the Financial Conduct Authority` EQUALS JUST `the Financial Conduct Authority` -- payable to the authority that imposes it
#ASSERT `reg 76(7) the penalty is payable to` TRUE `the Commissioners for Her Majesty's Revenue and Customs` EQUALS JUST `the Commissioners for Her Majesty's Revenue and Customs`
#ASSERT `reg 76(7) the penalty is payable to` TRUE `the Treasury` EQUALS NOTHING -- not a designated supervisory authority
#ASSERT `reg 76(7) the penalty is payable to` FALSE `the Financial Conduct Authority` EQUALS NOTHING -- not imposed under this Part

