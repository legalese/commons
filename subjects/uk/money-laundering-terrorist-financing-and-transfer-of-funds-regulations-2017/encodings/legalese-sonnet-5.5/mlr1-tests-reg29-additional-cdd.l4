#ASSERT `reg 29(4) the relevant person has verified the identity of the beneficiaries as paragraph (4) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 29(4) the relevant person has verified the identity of the beneficiaries as paragraph (4) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 29(5) the relevant person must identify the new beneficiary` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 29(5) the relevant person must identify the new beneficiary` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `reg 29(5) the relevant person must identify the new beneficiary` NOTHING (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `reg 29(5) the relevant person must identify the new beneficiary` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
