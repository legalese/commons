#ASSERT `reg 29(3)(a) the relevant person has taken the full name of the beneficiary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 29(3)(a) the relevant person has taken the full name of the beneficiary` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 29(3)(a) the relevant person has taken the full name of the beneficiary` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 29(3)(b) the relevant person must obtain sufficient information about the beneficiaries` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 29(3)(b) the relevant person must obtain sufficient information about the beneficiaries` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 29(3)(b) the relevant person must obtain sufficient information about the beneficiaries` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 29(3)(b) the relevant person must obtain sufficient information about the beneficiaries` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 29(3)(b) the relevant person has obtained sufficient information about the beneficiaries` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 29(3)(b) the relevant person has obtained sufficient information about the beneficiaries` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 29(3)(b) the relevant person has obtained sufficient information about the beneficiaries` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 29(4) the relevant person must verify the identity of the beneficiaries before any payment is made` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 29(4) the relevant person must verify the identity of the beneficiaries before any payment is made` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 29(4) the relevant person must verify the identity of the beneficiaries before any payment is made` NOTHING (JUST TRUE) EQUALS NOTHING
