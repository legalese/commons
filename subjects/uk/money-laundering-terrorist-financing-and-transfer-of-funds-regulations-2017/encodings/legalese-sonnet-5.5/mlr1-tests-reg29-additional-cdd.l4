#ASSERT `reg 29(7) the relevant person has applied customer due diligence measures to the anonymous account or passbook` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 29(7) the relevant person has applied customer due diligence measures to the anonymous account or passbook` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 29(7A) the date of 10th January 2019` EQUALS Date 10 1 2019
#ASSERT `reg 29(7A) the relevant person must apply customer due diligence measures to the anonymous safe-deposit box` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 29(7A) the relevant person must apply customer due diligence measures to the anonymous safe-deposit box` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `reg 29(7A) the relevant person must apply customer due diligence measures to the anonymous safe-deposit box` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 29(7A) the relevant person must apply customer due diligence measures to the anonymous safe-deposit box` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 29(7A) the relevant person has applied customer due diligence measures to the anonymous safe-deposit box` TRUE TRUE EQUALS JUST TRUE
