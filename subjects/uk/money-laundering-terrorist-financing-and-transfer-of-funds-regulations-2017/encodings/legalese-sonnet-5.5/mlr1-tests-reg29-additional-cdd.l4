#ASSERT `reg 29(16) the customer has provided the information to the law enforcement authority` TRUE EQUALS JUST TRUE
#ASSERT `reg 29(16) the customer has provided the information to the law enforcement authority` FALSE EQUALS JUST FALSE
#ASSERT `reg 29(17) the customer is required under paragraph (13), (14) or (16) to provide the information` TRUE EQUALS JUST FALSE
#ASSERT `reg 29(17) the customer is required under paragraph (13), (14) or (16) to provide the information` FALSE EQUALS NOTHING
#ASSERT `reg 29(18) the disclosure breaches a duty of confidentiality owed by a professional legal adviser to a client or any other restriction on the disclosure of information` TRUE EQUALS JUST FALSE
