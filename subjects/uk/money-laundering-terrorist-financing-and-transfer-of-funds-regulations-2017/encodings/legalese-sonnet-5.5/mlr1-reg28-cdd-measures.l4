        IF NOT (`reg 28(1) this regulation applies` EQUALS JUST TRUE) THEN NOTHING -- NOTHING-kind (points outside the text): "reg 28(1) this regulation applies" has not been answered
        IF `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` EQUALS JUST FALSE THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "Where the customer is a legal person, trust, company, foundation or similar legal arrangement" (assumed 2026-11-05, fork F-when: "when" read as "where"; ruling (b): a "where" condition not met)
        IF NOT (`reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` EQUALS JUST TRUE) THEN NOTHING -- NOTHING-kind (points outside the text): "reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement" has not been answered
        IF `paragraph (5) applies: the customer is a company which is listed on a regulated market` THEN JUST FALSE -- FALSE-kind (the text says no in its own words): "Subject to paragraph (5) ... Paragraphs (3)(b), (3A) and (4) do not apply where the customer is a company which is listed on a regulated market"
