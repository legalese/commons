IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr3-supervision`

-- TESTS for mlr3-supervision.l4 (regs 46 to 52B).  Every expected value is written here from the
-- text of the regulation named beside it, before the code was run: JUST TRUE where the provision
-- gives the answer yes, JUST FALSE where its own words say no, NOTHING where it does not answer.
-- A #TRACE is not an assertion (its outcome is printed, not counted), so each #TRACE carries the
-- outcome it must print in an `-- EXPECT` comment, and the work directory's tracecheck script
-- reads the two together; the decision functions above are the asserted twins.

§ `Tests -- regs 46 to 52B`

§§ `reg 46`

`reg 46 test the FCA and the Treasury` MEANS LIST `the Financial Conduct Authority`, `the Treasury`

-- reg 46(1): the authority named in the list monitors the person; another authority, or no answer from reg 7, is not covered
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` (JUST `reg 46 test the FCA and the Treasury`) `the Financial Conduct Authority` EQUALS JUST TRUE
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` (JUST `reg 46 test the FCA and the Treasury`) `the Treasury` EQUALS JUST TRUE
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` (JUST `reg 46 test the FCA and the Treasury`) `the Gambling Commission` EQUALS NOTHING
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` (JUST (LIST (`a professional body listed in Schedule 1` `Law Society`))) (`a professional body listed in Schedule 1` `Law Society`) EQUALS JUST TRUE
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` (JUST (LIST (`a professional body listed in Schedule 1` `Law Society`))) (`a professional body listed in Schedule 1` `Law Society of Scotland`) EQUALS NOTHING
#ASSERT `reg 46(1) the authority must monitor the relevant person as part of its own sector` NOTHING `the Treasury` EQUALS NOTHING

-- reg 46(1)(a), (b)
#ASSERT `reg 46(1)(a) the authority has taken necessary measures for the purpose of securing compliance` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(1)(a) the authority has taken necessary measures for the purpose of securing compliance` FALSE EQUALS JUST FALSE
#ASSERT `reg 46(1)(b) the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 46(1)(b) the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 46(1)(b) the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 46(1)(b) the application approved under regulation 26 meets the requirements of regulation 26(7)` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 46(1)(b) whether or not the person is a relevant person, the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 46(1)(b) whether or not the person is a relevant person, the application approved under regulation 26 meets the requirements of regulation 26(7)` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 46(1)(b) whether or not the person is a relevant person, the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 46(1)(b) whether or not the person is a relevant person, the application approved under regulation 26 meets the requirements of regulation 26(7)` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 46(1)(b) whether or not the person is a relevant person, the application approved under regulation 26 meets the requirements of regulation 26(7)` TRUE FALSE (JUST TRUE) EQUALS NOTHING

-- reg 46(2)(a) to (g): every limb must be met, so each limb missing is a no
#ASSERT `reg 46(2)(a) the authority has adopted a risk-based approach informed by its risk assessments` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(a) the authority has adopted a risk-based approach informed by its risk assessments` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(a) the authority has adopted a risk-based approach informed by its risk assessments` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 46(2)(a) the authority has adopted a risk-based approach informed by its risk assessments` FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(b) the authority has ensured access to relevant information on the risks` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(b) the authority has ensured access to relevant information on the risks` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(b) the authority has ensured access to relevant information on the risks` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 46(2)(c) the authority bases the frequency and intensity of supervision on the risk profiles prepared under regulation 17(4)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(c) the authority bases the frequency and intensity of supervision on the risk profiles prepared under regulation 17(4)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(c) the authority bases the frequency and intensity of supervision on the risk profiles prepared under regulation 17(4)` FALSE TRUE EQUALS JUST FALSE
-- (d): the reasons need recording only for a case in which the authority decided not to act
#ASSERT `reg 46(2)(d) the authority keeps a record in writing of its actions and of its reasons for deciding not to act` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 46(2)(d) the authority keeps a record in writing of its actions and of its reasons for deciding not to act` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(d) the authority keeps a record in writing of its actions and of its reasons for deciding not to act` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(d) the authority keeps a record in writing of its actions and of its reasons for deciding not to act` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(2)(e) the authority takes effective measures to encourage its own sector to report breaches` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(e) the authority takes effective measures to encourage its own sector to report breaches` FALSE EQUALS JUST FALSE
-- (f): "one or more" channels: one is enough, none is not
#ASSERT `reg 46(2)(f) the authority provides one or more secure communication channels for reporting breaches` 1 EQUALS JUST TRUE
#ASSERT `reg 46(2)(f) the authority provides one or more secure communication channels for reporting breaches` 3 EQUALS JUST TRUE
#ASSERT `reg 46(2)(f) the authority provides one or more secure communication channels for reporting breaches` 0 EQUALS JUST FALSE
#ASSERT `reg 46(2)(g) the authority takes reasonable measures to ensure that the identity of the reporting person is known only to it` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(2)(g) the authority takes reasonable measures to ensure that the identity of the reporting person is known only to it` FALSE EQUALS JUST FALSE

-- reg 46(3)(b), 46(4)
#ASSERT `reg 46(3)(b) the authority has taken account of the degree of discretion permitted to relevant persons` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(3)(b) the authority has taken account of the degree of discretion permitted to relevant persons` FALSE EQUALS JUST FALSE
#ASSERT `reg 46(4)(a) the authority takes appropriate measures to review the risk assessments carried out by relevant persons` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(4)(a) the authority takes appropriate measures to review the risk assessments carried out by relevant persons` FALSE EQUALS JUST FALSE
#ASSERT `reg 46(4)(b) the authority takes appropriate measures to review the adequacy and implementation of policies, controls and procedures` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(4)(b) the authority takes appropriate measures to review the adequacy and implementation of policies, controls and procedures` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(4)(b) the authority takes appropriate measures to review the adequacy and implementation of policies, controls and procedures` FALSE TRUE EQUALS JUST FALSE

-- reg 46(5): the duty arises on knowledge or suspicion; otherwise the paragraph says nothing
#ASSERT `reg 46(5) the authority must inform the NCA` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(5) the authority must inform the NCA` FALSE EQUALS NOTHING
#ASSERT `reg 46(5) the authority has informed the NCA as soon as practicable` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 46(5) the authority has informed the NCA as soon as practicable` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(5) the authority has informed the NCA as soon as practicable` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(5) the authority has informed the NCA as soon as practicable` TRUE FALSE FALSE EQUALS JUST FALSE

-- reg 46(6), 46(7)
#ASSERT `reg 46(6) the disclosure is not to be taken to breach any restriction on the disclosure of information` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(6) the disclosure is not to be taken to breach any restriction on the disclosure of information` FALSE EQUALS NOTHING
#ASSERT `reg 46(7) no civil liability arises in respect of the disclosure on the part of the person who made it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 46(7) no civil liability arises in respect of the disclosure on the part of the person who made it` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 46(7) no civil liability arises in respect of the disclosure on the part of the person who made it` FALSE TRUE EQUALS JUST FALSE

-- reg 46(8), 46(9)
#ASSERT `reg 46(8)(a) the authority must effectively monitor the auction platform's compliance` `the Financial Conduct Authority` TRUE EQUALS JUST TRUE
#ASSERT `reg 46(8)(a) the authority must effectively monitor the auction platform's compliance` `the Financial Conduct Authority` FALSE EQUALS JUST FALSE
