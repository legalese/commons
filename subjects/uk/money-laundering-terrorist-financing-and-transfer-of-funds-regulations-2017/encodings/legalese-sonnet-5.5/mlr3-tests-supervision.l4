#ASSERT count `reg 48(2) the matters on which the guidance must include guidance` EQUALS 12
#ASSERT elem `reg 48(2)(l) how to address risks where a politically exposed person, a family member or a known close associate is a beneficial owner or a beneficiary` `reg 48(2) the matters on which the guidance must include guidance`
#ASSERT `reg 48(2) the guidance includes guidance on every one of the matters` `reg 48(2) the matters on which the guidance must include guidance` EQUALS JUST TRUE
#ASSERT `reg 48(2) the guidance includes guidance on every one of the matters` (LIST `reg 48(2)(a) what functions are, and are not, prominent public functions`) EQUALS JUST FALSE
#ASSERT `reg 48(2) the guidance includes guidance on every one of the matters` EMPTY EQUALS JUST FALSE

#ASSERT `reg 49(1)(a) the self-regulatory organisation has made arrangements to ensure that its supervisory functions are exercised independently` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(1)(a) the self-regulatory organisation has made arrangements to ensure that its supervisory functions are exercised independently` FALSE EQUALS JUST FALSE
#ASSERT `reg 49(1)(b) the self-regulatory organisation has made arrangements to ensure that sensitive information is appropriately handled` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(1)(b) the self-regulatory organisation has made arrangements to ensure that sensitive information is appropriately handled` FALSE EQUALS JUST FALSE
#ASSERT `reg 49(1)(c) the self-regulatory organisation has made arrangements to ensure that it employs only suitably qualified persons` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(1)(c) the self-regulatory organisation has made arrangements to ensure that it employs only suitably qualified persons` FALSE EQUALS JUST FALSE
#ASSERT `reg 49(1)(d) the self-regulatory organisation has made arrangements to ensure that a contravention renders the person liable to disciplinary measures` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(1)(d) the self-regulatory organisation has made arrangements to ensure that a contravention renders the person liable to disciplinary measures` FALSE EQUALS JUST FALSE
-- what (d) means to the relevant person: liable if it contravened a relevant requirement and the organisation supervises it
#ASSERT `reg 49(1)(d) the relevant person is liable to effective, proportionate and dissuasive disciplinary measures under the organisation's rules` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 49(1)(d) the relevant person is liable to effective, proportionate and dissuasive disciplinary measures under the organisation's rules` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 49(1)(d) the relevant person is liable to effective, proportionate and dissuasive disciplinary measures under the organisation's rules` TRUE FALSE EQUALS NOTHING
