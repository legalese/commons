#ASSERT `reg 49(1)(e) the self-regulatory organisation has made arrangements to ensure that potential conflicts of interest are appropriately handled` FALSE EQUALS JUST FALSE
#ASSERT `reg 49(2)(a) the self-regulatory organisation provides adequate resources to carry out the supervisory functions` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(2)(a) the self-regulatory organisation provides adequate resources to carry out the supervisory functions` FALSE EQUALS JUST FALSE
#ASSERT `reg 49(2)(b) the self-regulatory organisation has appointed a person to monitor and manage its compliance` TRUE EQUALS JUST TRUE
#ASSERT `reg 49(2)(b) the self-regulatory organisation has appointed a person to monitor and manage its compliance` FALSE EQUALS JUST FALSE
-- reg 49(3)(a): SA or registering authority, overseas authority, law enforcement authority (reg 44(10), S-15)
#ASSERT `reg 49(3)(a) the person appointed is responsible for liaison with the body` TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `reg 49(3)(a) the person appointed is responsible for liaison with the body` FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `reg 49(3)(a) the person appointed is responsible for liaison with the body` FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 49(3)(a) the person appointed is responsible for liaison with the body` FALSE NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 49(3)(a) the person appointed is responsible for liaison with the body` FALSE (JUST FALSE) FALSE EQUALS NOTHING
-- reg 49(3)(b)
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` TRUE (JUST FALSE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` TRUE (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` TRUE (JUST FALSE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` FALSE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` FALSE (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` FALSE (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` FALSE NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 49(3)(b) the self-regulatory organisation has responded fully and rapidly to the request` TRUE (JUST FALSE) FALSE TRUE TRUE EQUALS NOTHING

