#ASSERT `reg 46(8)(a) the FCA has monitored the auction platform's compliance with all three sets of requirements` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 46(8)(a) the FCA has monitored the auction platform's compliance with all three sets of requirements` TRUE TRUE FALSE EQUALS JUST FALSE
