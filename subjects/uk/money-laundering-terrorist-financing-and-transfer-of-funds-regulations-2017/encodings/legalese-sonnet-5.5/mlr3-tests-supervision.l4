#ASSERT `reg 47(3)(f) the information includes the report prepared by the Treasury and the Home Office` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 47(3)(f) the information includes the report prepared by the Treasury and the Home Office` TRUE TRUE EQUALS JUST TRUE
