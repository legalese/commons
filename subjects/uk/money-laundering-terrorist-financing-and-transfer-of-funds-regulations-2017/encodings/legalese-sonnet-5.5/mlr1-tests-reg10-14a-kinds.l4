#ASSERT `reg 13(2) the dealing counts as disposing of or acquiring an interest in land for estate agency work` (`reg 13(2) dealing in land` OF FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `reg 13(2) the dealing counts as disposing of or acquiring an interest in land for estate agency work` (`reg 13(2) dealing in land` OF FALSE, FALSE) EQUALS NOTHING

§ `reg 13(4): letting agency work (src:331-337)`
#ASSERT `reg 13(4)(b)(ii) the monthly rent of 10000 pounds sterling` EQUALS 10000
-- arguments: a prospective landlord's instructions; a prospective tenant's instructions; an agreement is concluded for letting land; the term in months; the monthly rent
#ASSERT `reg 13(4) the work is letting agency work` TRUE FALSE TRUE 12 10000 EQUALS JUST TRUE
#ASSERT `reg 13(4) the work is letting agency work` FALSE TRUE TRUE 1 10000 EQUALS JUST TRUE
#ASSERT `reg 13(4) the work is letting agency work` TRUE TRUE TRUE 6 25000 EQUALS JUST TRUE
#ASSERT `reg 13(4) the work is letting agency work` TRUE FALSE TRUE 12 9999 EQUALS JUST FALSE
#ASSERT `reg 13(4) the work is letting agency work` TRUE FALSE TRUE 0 20000 EQUALS JUST FALSE
#ASSERT `reg 13(4) the work is letting agency work` FALSE FALSE TRUE 12 10000 EQUALS JUST FALSE
#ASSERT `reg 13(4) the work is letting agency work` TRUE FALSE FALSE 12 10000 EQUALS JUST FALSE

§ `reg 13(5) and (6): what letting agency work does not include (src:338-343)`
-- arguments: the thing done; the firm or sole practitioner, or an employee, does anything else within paragraph (4)
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6)(a) publishing advertisements or disseminating information` FALSE EQUALS JUST FALSE
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6)(b) providing a means by which a prospective landlord or a prospective tenant can, in response to an advertisement or dissemination of information, make direct contact with a prospective tenant or a prospective landlord` FALSE EQUALS JUST FALSE
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6)(c) providing a means by which a prospective landlord and a prospective tenant can communicate directly with each other` FALSE EQUALS JUST FALSE
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6)(d) the provision of legal or notarial services by a barrister, advocate, solicitor or other legal representative communications with whom may be the subject of a claim to professional privilege or, in Scotland, protected from disclosure in legal proceedings on grounds of confidentiality of communication` FALSE EQUALS JUST FALSE
-- the "if neither ... does anything else" limit: when it is not met, the paragraph is silent
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6)(a) publishing advertisements or disseminating information` TRUE EQUALS NOTHING
-- a thing not listed in paragraph (6): the paragraph is silent
#ASSERT `reg 13(5) the thing done is letting agency work` `reg 13(6) another thing` FALSE EQUALS NOTHING

§ `reg 13(7): land (src:344)`
#ASSERT `reg 13(7) the thing let is land for paragraph (4)` `reg 13(7) land` EQUALS JUST TRUE
#ASSERT `reg 13(7) the thing let is land for paragraph (4)` `reg 13(7) part of a building` EQUALS JUST TRUE
#ASSERT `reg 13(7) the thing let is land for paragraph (4)` `reg 13(7) part of any other structure` EQUALS JUST TRUE
#ASSERT `reg 13(7) the thing let is land for paragraph (4)` `reg 13(7) something else` EQUALS NOTHING

