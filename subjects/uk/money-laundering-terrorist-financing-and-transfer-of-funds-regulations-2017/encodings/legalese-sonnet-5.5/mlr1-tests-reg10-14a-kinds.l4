-- arguments: cryptographically secured; a digital representation of value or contractual rights; uses distributed ledger technology; can be transferred, stored or traded electronically
#ASSERT `reg 14A(3)(a) the thing is a cryptoasset` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(3)(a) the thing is a cryptoasset` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(3)(a) the thing is a cryptoasset` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(3)(a) the thing is a cryptoasset` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(3)(a) the thing is a cryptoasset` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

