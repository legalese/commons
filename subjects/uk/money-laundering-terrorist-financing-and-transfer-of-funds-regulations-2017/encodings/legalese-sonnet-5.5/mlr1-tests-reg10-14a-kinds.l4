IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg10-14a-kinds`

-- TESTS for regulations 10 to 14A.  Every expected value is written from the text of the regulation (the line named
-- in the comment), not from what the module computes.  Inputs are positional, in the order of the function's GIVEN.

§ `reg 10(1): credit institution (src:271-274)`
-- arguments: is a credit institution in the CRR sense; is a UK branch of one; accepts deposits; grants credits; bids in auctions
#ASSERT `reg 10(1) the person is a credit institution` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 10(1) the person is a credit institution` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 10(1) the person is a credit institution` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(1) the person is a credit institution` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- in the class, outside the "when" limit: the definition does not decide
#ASSERT `reg 10(1) the person is a credit institution` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(1) the person is a credit institution` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- not in the class: "means" closes it
#ASSERT `reg 10(1) the person is a credit institution` FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `reg 10(4)(a): listed activities and Schedule 2 points, fork F4 reading 2 (src:295)`
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `lending` EQUALS 2
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `financial leasing` EQUALS 3
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `payment services` EQUALS 4
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `issuing and administering other means of payment` EQUALS 5
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `guarantees and commitments` EQUALS 6
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `trading for own account or for account of customers` EQUALS 7
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `participation in securities issues and related services` EQUALS 8
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `advice to undertakings on capital structure, industrial strategy and mergers` EQUALS 9
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `money broking` EQUALS 10
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `portfolio management and advice` EQUALS 11
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `safekeeping and administration of securities` EQUALS 12
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `safe custody services` EQUALS 14
#ASSERT `reg 10(4)(a) the number of the point in Schedule 2 that lists the activity` `issuing electronic money` EQUALS 15
-- every one of the thirteen printed items is a listed activity under that reading
#ASSERT `reg 10(4)(a) the activity is a listed activity` `lending` EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the activity is a listed activity` `trading for own account or for account of customers` EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the activity is a listed activity` `safekeeping and administration of securities` EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the activity is a listed activity` `safe custody services` EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the activity is a listed activity` `issuing electronic money` EQUALS JUST TRUE
-- the point numbers the paragraph names
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 1 EQUALS JUST FALSE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 2 EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 7 EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 12 EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 13 EQUALS JUST FALSE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 14 EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 15 EQUALS JUST TRUE
#ASSERT `reg 10(4)(a) the point of Schedule 2 is among points 2 to 12, 14 and 15` 16 EQUALS JUST FALSE

§ `reg 10(4)(b): Regulated Activities Order (src:296)`
#ASSERT `reg 10(4)(b) “Regulated Activities Order” means` EQUALS "the Financial Services and Markets Act 2000 (Regulated Activities) Order 2001"

§ `reg 10(3)(a): a credit institution (src:287-288)`
#ASSERT `reg 10(3)(a) the undertaking is a credit institution` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 10(3)(a) the undertaking is a credit institution` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 10(3)(a) the undertaking is a credit institution` NOTHING EQUALS NOTHING

§ `reg 10(3)(b): a creditor under a debtor-creditor-supplier agreement (src:289-292)`
-- arguments: only listed activity is as a creditor under an agreement; falls within section 12(a); fixed sum credit for services;
-- deferred payment or instalments; number of months
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE TRUE TRUE TRUE 12 EQUALS JUST TRUE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE TRUE TRUE TRUE 6 EQUALS JUST TRUE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE TRUE TRUE TRUE 13 EQUALS JUST FALSE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` FALSE TRUE TRUE TRUE 12 EQUALS JUST FALSE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE FALSE TRUE TRUE 12 EQUALS JUST FALSE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE TRUE FALSE TRUE 12 EQUALS JUST FALSE
#ASSERT `reg 10(3)(b) the undertaking is one whose only listed activity is as a creditor under such an agreement` TRUE TRUE TRUE FALSE 12 EQUALS JUST FALSE

§ `reg 10(3)(c): trading for its own account (src:293)`
-- arguments: the listed activities it carries out; its trading in point 7 products is for its own account; it has a customer
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` (LIST `trading for own account or for account of customers`) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` (LIST `trading for own account or for account of customers`) TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` (LIST `trading for own account or for account of customers`, `lending`) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` (LIST `lending`) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` EMPTY TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(3)(c) the undertaking is one whose only listed activity is trading for its own account` (LIST `trading for own account or for account of customers`) FALSE FALSE EQUALS JUST FALSE

§ `reg 10(3): the institutions referred to (src:287-293)`
#ASSERT `reg 10(3) the undertaking is an institution referred to in paragraph (3)` (LIST NOTHING, JUST TRUE, NOTHING) EQUALS JUST TRUE
#ASSERT `reg 10(3) the undertaking is an institution referred to in paragraph (3)` (LIST JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 10(3) the undertaking is an institution referred to in paragraph (3)` (LIST JUST FALSE, NOTHING, JUST FALSE) EQUALS NOTHING

§ `reg 10(2): a financial institution, limb by limb (src:275-286)`
-- (a) arguments: is an undertaking; the answer for paragraph (3); the Schedule 2 activities it carries out
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE (JUST FALSE) (LIST `lending`) EQUALS JUST TRUE
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE (JUST TRUE) (LIST `lending`) EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` FALSE (JUST FALSE) (LIST `lending`) EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE (JUST FALSE) EMPTY EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE NOTHING (LIST `lending`) EQUALS NOTHING
-- no listed activity: outside (a) whatever paragraph (3) says ("means ... when the undertaking carries out one or more listed activity")
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE NOTHING EMPTY EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE (JUST FALSE) EMPTY EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE (JUST TRUE) EMPTY EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE NOTHING EMPTY EQUALS JUST FALSE
-- (b) arguments: authorised person with Part 4A permission; carrying out long-term insurance other than reinsurance
#ASSERT `reg 10(2)(b) the person is a financial institution as an insurance undertaking` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(b) the person is a financial institution as an insurance undertaking` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(b) the person is a financial institution as an insurance undertaking` FALSE TRUE EQUALS JUST FALSE
-- (c) arguments: regular occupation is investment services; within an exclusion; providing investment services; bidding in auctions
#ASSERT `reg 10(2)(c) the person is a financial institution as an investment firm` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 10(2)(c) the person is a financial institution as an investment firm` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(c) the person is a financial institution as an investment firm` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(c) the person is a financial institution as an investment firm` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 10(2)(c) the person is a financial institution as an investment firm` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (d) arguments: within paragraph 1(k) of Part 1 of Schedule 3 to the Regulated Activities Order; bidding for clients of its main business
#ASSERT `reg 10(2)(d) the person is a financial institution as a person within paragraph 1(k) of Part 1 of Schedule 3 to the Regulated Activities Order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(d) the person is a financial institution as a person within paragraph 1(k) of Part 1 of Schedule 3 to the Regulated Activities Order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(d) the person is a financial institution as a person within paragraph 1(k) of Part 1 of Schedule 3 to the Regulated Activities Order` FALSE TRUE EQUALS JUST FALSE
-- (e) arguments: a collective investment undertaking; marketing or offering its units or shares
#ASSERT `reg 10(2)(e) the person is a financial institution as a collective investment undertaking` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(e) the person is a financial institution as a collective investment undertaking` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(e) the person is a financial institution as a collective investment undertaking` FALSE TRUE EQUALS JUST FALSE
-- (f) arguments: an insurance intermediary; acting in respect of contracts of long-term insurance
#ASSERT `reg 10(2)(f) the person is a financial institution as an insurance intermediary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(f) the person is a financial institution as an insurance intermediary` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(f) the person is a financial institution as an insurance intermediary` FALSE TRUE EQUALS JUST FALSE
-- (g) arguments: a UK branch of a person in (a) to (f); carrying out an activity mentioned in (a) to (f)
#ASSERT `reg 10(2)(g) the person is a financial institution as a branch of a person referred to in paragraphs (a) to (f)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(g) the person is a financial institution as a branch of a person referred to in paragraphs (a) to (f)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(g) the person is a financial institution as a branch of a person referred to in paragraphs (a) to (f)` FALSE TRUE EQUALS JUST FALSE
-- (h)
#ASSERT `reg 10(2)(h) the person is a financial institution as the National Savings Bank` TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(h) the person is a financial institution as the National Savings Bank` FALSE EQUALS JUST FALSE
-- (i) arguments: is the Director of Savings; money is being raised under the National Loans Act 1968
#ASSERT `reg 10(2)(i) the person is a financial institution as the Director of Savings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 10(2)(i) the person is a financial institution as the Director of Savings` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 10(2)(i) the person is a financial institution as the Director of Savings` FALSE TRUE EQUALS JUST FALSE
-- the whole paragraph, hand-gathered from the nine limbs
#ASSERT `reg 10(2) the person is a financial institution` (LIST JUST FALSE, JUST FALSE, JUST TRUE, NOTHING, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 10(2) the person is a financial institution` (LIST JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 10(2) the person is a financial institution` (LIST JUST FALSE, NOTHING, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS NOTHING

§ `reg 11(a): auditor (src:298-301)`
-- arguments: a firm or individual; a statutory auditor; carrying out statutory audit work; a local auditor; carrying out an audit required by the 2014 Act
#ASSERT `reg 11(a) the person is an auditor` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 11(a) the person is an auditor` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 11(a) the person is an auditor` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 11(a) the person is an auditor` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(a) the person is an auditor` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(a) the person is an auditor` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(a) the person is an auditor` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE

§ `reg 11(b) to (d): insolvency practitioner, external accountant, tax adviser (src:302-304)`
#ASSERT `reg 11(b) the person is an insolvency practitioner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 11(b) the person is an insolvency practitioner` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(b) the person is an insolvency practitioner` FALSE TRUE EQUALS JUST FALSE
-- arguments: a firm or sole practitioner; provides the services by way of business; is providing such services
#ASSERT `reg 11(c) the person is an external accountant` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 11(c) the person is an external accountant` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(c) the person is an external accountant` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 11(c) the person is an external accountant` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 11(d) the person is a tax adviser` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 11(d) the person is a tax adviser` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 11(d) the person is a tax adviser` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 11(d) the person is a tax adviser` FALSE TRUE TRUE EQUALS JUST FALSE

§ `reg 12(1): independent legal professional (src:306-312)`
-- arguments: a firm or sole practitioner; provides legal or notarial services by way of business; assists or acts for a client in the transaction; what the transaction concerns
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1)(a) the buying and selling of real property or business entities` EQUALS JUST TRUE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1)(b) the managing of client money, securities or other assets` EQUALS JUST TRUE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1)(c) the opening or management of bank, savings or securities accounts` EQUALS JUST TRUE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1)(d) the organisation of contributions necessary for the creation, operation or management of companies` EQUALS JUST TRUE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1)(e) the creation, operation or management of trusts, companies, foundations or similar structures` EQUALS JUST TRUE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE TRUE `reg 12(1) something else` EQUALS JUST FALSE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE TRUE FALSE `reg 12(1)(a) the buying and selling of real property or business entities` EQUALS JUST FALSE
#ASSERT `reg 12(1) the person is an independent legal professional` TRUE FALSE TRUE `reg 12(1)(a) the buying and selling of real property or business entities` EQUALS JUST FALSE
#ASSERT `reg 12(1) the person is an independent legal professional` FALSE TRUE TRUE `reg 12(1)(a) the buying and selling of real property or business entities` EQUALS JUST FALSE

§ `reg 12(2): trust or company service provider (src:313-323)`
-- arguments: a firm or sole practitioner; the services it provides; if it acts as a nominee shareholder, for a company listed on a regulated market; providing such services
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(a) forming a firm`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(ab) selling an off-the-shelf firm`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(b)(i) acting, or arranging for another person to act, as a director or secretary of a company`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(b)(ii) acting, or arranging for another person to act, as a partner of a partnership`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(b)(iii) acting, or arranging for another person to act, in a similar capacity in relation to other legal persons`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(c) providing a registered office, business address, correspondence or administrative address or other related services for a company, partnership or any other legal person or legal arrangement`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(d)(i) acting, or arranging for another person to act, as a trustee of an express trust or similar legal arrangement`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(d)(ii) acting, or arranging for another person to act, as a nominee shareholder`) FALSE TRUE EQUALS JUST TRUE
-- a nominee shareholder for a listed company does not count
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(d)(ii) acting, or arranging for another person to act, as a nominee shareholder`) TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(d)(ii) acting, or arranging for another person to act, as a nominee shareholder`, `reg 12(2)(a) forming a firm`) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2) another service`) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE EMPTY FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 12(2) the person is a trust or company service provider` FALSE (LIST `reg 12(2)(a) forming a firm`) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 12(2) the person is a trust or company service provider` TRUE (LIST `reg 12(2)(a) forming a firm`) FALSE FALSE EQUALS JUST FALSE

