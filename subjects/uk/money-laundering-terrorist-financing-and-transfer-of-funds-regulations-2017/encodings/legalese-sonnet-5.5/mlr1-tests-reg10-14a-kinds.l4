#ASSERT `reg 14A(3)(b) the thing is money` `reg 14A(3)(b) something else` EQUALS JUST FALSE

§ `reg 14A(1): cryptoasset exchange provider (src:360-363)`
-- arguments: a firm or sole practitioner; the services it provides by way of business; it is providing such services
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE (LIST `reg 14A(1)(a) exchanging, or arranging or making arrangements with a view to the exchange of, cryptoassets for money or money for cryptoassets`) TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE (LIST `reg 14A(1)(b) exchanging, or arranging or making arrangements with a view to the exchange of, one cryptoasset for another`) TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE (LIST `reg 14A(1) another service`, `reg 14A(1)(c) operating a machine which utilises automated processes to exchange cryptoassets for money or money for cryptoassets`) TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE (LIST `reg 14A(1) another service`) TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE EMPTY TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` FALSE (LIST `reg 14A(1)(a) exchanging, or arranging or making arrangements with a view to the exchange of, cryptoassets for money or money for cryptoassets`) TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(1) the person is a cryptoasset exchange provider` TRUE (LIST `reg 14A(1)(a) exchanging, or arranging or making arrangements with a view to the exchange of, cryptoassets for money or money for cryptoassets`) FALSE EQUALS JUST FALSE

§ `reg 14A(2): custodian wallet provider (src:364-367)`
-- arguments: a firm or sole practitioner; what it provides services to safeguard (or safeguard and administer); it is providing such services
#ASSERT `reg 14A(2) the person is a custodian wallet provider` TRUE (LIST `reg 14A(2)(a) cryptoassets on behalf of its customers`) TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(2) the person is a custodian wallet provider` TRUE (LIST `reg 14A(2)(b) private cryptographic keys on behalf of its customers in order to hold, store and transfer cryptoassets`) TRUE EQUALS JUST TRUE
#ASSERT `reg 14A(2) the person is a custodian wallet provider` TRUE (LIST `reg 14A(2) something else`) TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(2) the person is a custodian wallet provider` TRUE EMPTY TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(2) the person is a custodian wallet provider` FALSE (LIST `reg 14A(2)(a) cryptoassets on behalf of its customers`) TRUE EQUALS JUST FALSE
#ASSERT `reg 14A(2) the person is a custodian wallet provider` TRUE (LIST `reg 14A(2)(a) cryptoassets on behalf of its customers`) FALSE EQUALS JUST FALSE

§ `reg 10(2)(a): the seam answer S-10 (src:275-276)`
-- arguments: an undertaking; the answer of paragraph (3); the activities carried out (point 2 of Schedule 2 is the first listed activity)
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE (JUST FALSE) (LIST `lending`) EQUALS `reg 10(2)(a) the person is a financial institution as an undertaking carrying out a listed activity` TRUE (JUST FALSE) (LIST `lending`)
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` FALSE (JUST FALSE) (LIST `lending`) EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE (JUST TRUE) (LIST `lending`) EQUALS JUST FALSE
#ASSERT `reg 10(2)(a) the person falls within regulation 10(2)(a)` TRUE NOTHING (LIST `lending`) EQUALS NOTHING
