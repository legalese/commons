#ASSERT `reg 14(1)(a) the person is a high value dealer` TRUE TRUE 9999 EQUALS JUST FALSE
#ASSERT `reg 14(1)(a) the person is a high value dealer` TRUE FALSE 10000 EQUALS JUST FALSE
#ASSERT `reg 14(1)(a) the person is a high value dealer` FALSE TRUE 10000 EQUALS JUST FALSE

