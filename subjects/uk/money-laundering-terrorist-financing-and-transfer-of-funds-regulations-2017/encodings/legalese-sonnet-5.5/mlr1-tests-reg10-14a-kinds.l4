§ `reg 14(1)(d): art market participant (src:350-352)`
#ASSERT `reg 14(1)(d) the art transaction or storage value of 10000 pounds sterling` EQUALS 10000
-- (i) arguments: a firm or sole practitioner; trades in or intermediates works of art by way of business; the value of the transaction or linked transactions; the answer for paragraph (3)
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` TRUE TRUE 10000 NOTHING EQUALS JUST TRUE
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` TRUE TRUE 250000 NOTHING EQUALS JUST TRUE
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` TRUE TRUE 10000 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` TRUE TRUE 9999 NOTHING EQUALS JUST FALSE
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` TRUE FALSE 20000 NOTHING EQUALS JUST FALSE
#ASSERT `reg 14(1)(d)(i) the person is an art market participant as a trader or intermediary` FALSE TRUE 20000 NOTHING EQUALS JUST FALSE
-- (ii) arguments: a firm or sole practitioner; operator of a freeport which stores works of art by way of business; the value stored for a person or linked persons
#ASSERT `reg 14(1)(d)(ii) the person is an art market participant as the operator of a freeport` TRUE TRUE 10000 EQUALS JUST TRUE
#ASSERT `reg 14(1)(d)(ii) the person is an art market participant as the operator of a freeport` TRUE TRUE 9999 EQUALS JUST FALSE
#ASSERT `reg 14(1)(d)(ii) the person is an art market participant as the operator of a freeport` TRUE FALSE 20000 EQUALS JUST FALSE
#ASSERT `reg 14(1)(d)(ii) the person is an art market participant as the operator of a freeport` FALSE TRUE 20000 EQUALS JUST FALSE
-- the whole paragraph from its two limbs; paragraph (3) removes only limb (i)
#ASSERT `reg 14(1)(d) the person is an art market participant` (LIST JUST TRUE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 14(1)(d) the person is an art market participant` (LIST JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 14(1)(d) the person is an art market participant` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 14(1)(d) the person is an art market participant` (LIST JUST FALSE, NOTHING) EQUALS NOTHING

§ `reg 14(1)(e) and (f): freeport, work of art (src:353-354)`
#ASSERT `reg 14(1)(e) the place is a freeport` TRUE EQUALS JUST TRUE
