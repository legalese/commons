IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg16-17-authorities`

-- TESTS for regulations 16, 16A and 17.  The duty checklists are tested from their own specification: every condition met answers
-- JUST TRUE; one condition not met answers JUST FALSE; an "unless" exception met answers JUST TRUE; a "where" limit not reached answers JUST TRUE (no requirement has arisen: ruling 2026-11-05, (b), fork F-where); a scope limit not reached answers NOTHING.
-- Inputs are positional, in the order of the function's GIVEN (the conditions, then the "unless" exception, then the "where" limit, then the scope limit).

§ `The duty checklists of regulations 16, 16A and 17`
-- reg 16(2)
#ASSERT `reg 16(2) the risk assessment does what paragraph (2) requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(2) the risk assessment does what paragraph (2) requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(2) the risk assessment does what paragraph (2) requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(2) the risk assessment does what paragraph (2) requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(2) the risk assessment does what paragraph (2) requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- reg 16(3)
#ASSERT `reg 16(3) the Treasury and the Home Office ensure that the risk assessment is used as paragraph (3) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(3) the Treasury and the Home Office ensure that the risk assessment is used as paragraph (3) requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(3) the Treasury and the Home Office ensure that the risk assessment is used as paragraph (3) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(3) the Treasury and the Home Office ensure that the risk assessment is used as paragraph (3) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- reg 16(6)
#ASSERT `reg 16(6) the Treasury and the Home Office prepare the joint report as paragraph (6) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(6) the Treasury and the Home Office prepare the joint report as paragraph (6) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(6) the Treasury and the Home Office prepare the joint report as paragraph (6) requires` TRUE FALSE EQUALS JUST FALSE
-- reg 16(6A)
#ASSERT `reg 16(6A) the report sets out what paragraph (6A) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(6A) the report sets out what paragraph (6A) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(6A) the report sets out what paragraph (6A) requires` TRUE FALSE EQUALS JUST FALSE
-- reg 16(7)
#ASSERT `reg 16(7) a copy of the report is laid before Parliament and sent as paragraph (7) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(7) a copy of the report is laid before Parliament and sent as paragraph (7) requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(7) a copy of the report is laid before Parliament and sent as paragraph (7) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(7) a copy of the report is laid before Parliament and sent as paragraph (7) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- reg 16(8)
#ASSERT `reg 16(8) the Treasury and the Home Office make information from the risk assessment available to the supervisory authorities` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(8) the Treasury and the Home Office make information from the risk assessment available to the supervisory authorities` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16(8) the Treasury and the Home Office make information from the risk assessment available to the supervisory authorities` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16(8) the Treasury and the Home Office make information from the risk assessment available to the supervisory authorities` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 16(8) the Treasury and the Home Office make information from the risk assessment available to the supervisory authorities` FALSE FALSE FALSE EQUALS JUST TRUE
-- reg 16(9)
#ASSERT `reg 16(9) the Treasury and the Home Office take the steps paragraph (9) requires` TRUE EQUALS JUST TRUE
#ASSERT `reg 16(9) the Treasury and the Home Office take the steps paragraph (9) requires` FALSE EQUALS JUST FALSE
-- reg 16A(1)
#ASSERT `reg 16A(1) the Treasury makes arrangements for the proliferation financing risk assessment` TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(1) the Treasury makes arrangements for the proliferation financing risk assessment` FALSE EQUALS JUST FALSE
