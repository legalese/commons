§ `reg 16(1): arrangements before 26th June 2018 (src:408)`
#ASSERT `reg 16(1) the date before which the arrangements must be made` EQUALS Date 26 6 2018
#ASSERT `reg 16(1) the Treasury and the Home Office made the arrangements in time` (Date 25 6 2018) EQUALS JUST TRUE
#ASSERT `reg 16(1) the Treasury and the Home Office made the arrangements in time` (Date 1 1 2018) EQUALS JUST TRUE
#ASSERT `reg 16(1) the Treasury and the Home Office made the arrangements in time` (Date 26 6 2018) EQUALS JUST FALSE
#ASSERT `reg 16(1) the Treasury and the Home Office made the arrangements in time` (Date 27 6 2018) EQUALS JUST FALSE

§ `reg 16(4): provider of gambling services (src:418)`
#ASSERT `reg 16(4) the person is a provider of gambling services` TRUE EQUALS JUST TRUE
#ASSERT `reg 16(4) the person is a provider of gambling services` FALSE EQUALS JUST FALSE

§ `reg 16A(7) and (8): permissions (src:445-446)`
#ASSERT `reg 16A(7) the proliferation financing risk assessment may be included in the risk assessment made under regulation 16` TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(7) the proliferation financing risk assessment may be included in the risk assessment made under regulation 16` FALSE EQUALS NOTHING
#ASSERT `reg 16A(8) the report may be included within the joint report` TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(8) the report may be included within the joint report` FALSE EQUALS NOTHING

§ `reg 16A(9): proliferation financing (src:447)`
-- arguments: providing funds or financial services; for use in connection with CBRN weapons, delivery means or goods; in contravention of a relevant financial sanctions obligation
#ASSERT `reg 16A(9) the act is proliferation financing` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(9) the act is proliferation financing` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16A(9) the act is proliferation financing` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16A(9) the act is proliferation financing` TRUE TRUE FALSE EQUALS JUST FALSE

§ `reg 16A(10): definitions (src:448-459)`
-- biological weapon: arguments are the s 1(1)(a) agent or toxin limb and the s 1(1)(b) limb
#ASSERT `reg 16A(10) the thing is a biological weapon` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is a biological weapon` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is a biological weapon` FALSE FALSE EQUALS JUST FALSE
-- chemical weapon and technology point outside the text
#ASSERT `reg 16A(10) the thing is a chemical weapon` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is a chemical weapon` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 16A(10) the thing is a chemical weapon` NOTHING EQUALS NOTHING
#ASSERT `reg 16A(10) the thing is technology` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is technology` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 16A(10) the thing is technology` NOTHING EQUALS NOTHING
-- CBRN-related goods and technology: technology or dual-use goods; used for non-legitimate purposes
#ASSERT `reg 16A(10) the thing is CBRN-related goods and technology` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is CBRN-related goods and technology` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the thing is CBRN-related goods and technology` FALSE TRUE EQUALS JUST FALSE
-- dual-use goods: specified in Annex I; is dual-use technology; is a storage medium for dual-use technology
#ASSERT `reg 16A(10) the thing is dual-use goods` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is dual-use goods` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the thing is dual-use goods` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is dual-use goods` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is dual-use goods` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) “Dual-Use Regulation” means` EQUALS "Council Regulation (EC) No 428/2009 of 5 May 2009 setting up a Community regime for the control of exports, transfer, brokering and transit of dual-use items"
-- dual-use technology: specified in Annex I; described as software or technology
#ASSERT `reg 16A(10) the thing is dual-use technology` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is dual-use technology` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the thing is dual-use technology` FALSE TRUE EQUALS JUST FALSE
-- nuclear weapon "includes": not closed
#ASSERT `reg 16A(10) the thing is a nuclear weapon` TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is a nuclear weapon` FALSE EQUALS NOTHING
#ASSERT `reg 16A(10) the thing is a radiological weapon` TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the thing is a radiological weapon` FALSE EQUALS JUST FALSE
-- relevant financial sanctions obligation and relevant UN obligation
#ASSERT `reg 16A(10) the obligation is a relevant financial sanctions obligation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the obligation is a relevant financial sanctions obligation` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the obligation is a relevant financial sanctions obligation` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the obligation is a relevant financial sanctions obligation` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the obligation is a relevant UN obligation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 16A(10) the obligation is a relevant UN obligation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 16A(10) the obligation is a relevant UN obligation` FALSE TRUE EQUALS JUST FALSE

§ `reg 17(5): a single risk profile (src:469-471)`
#ASSERT `reg 17(5) the supervisory authority may prepare a single risk profile` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 17(5) the supervisory authority may prepare a single risk profile` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 17(5) the supervisory authority may prepare a single risk profile` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 17(5) the supervisory authority may prepare a single risk profile` FALSE FALSE EQUALS JUST FALSE

§ `Who bears the duty: reg 16(1), reg 16A(1), reg 17(1) (src:408, 435, 461)`
#ASSERT `reg 16(1) the bearer of the duty to make the arrangements` EQUALS "the Treasury and the Home Office"
#ASSERT `reg 16A(1) the bearer of the duty to make the arrangements` EQUALS "the Treasury"
#ASSERT `reg 17(1) the bearer of the duty to identify and assess the risks` EQUALS "each supervisory authority, as to the relevant persons in its own sector"
