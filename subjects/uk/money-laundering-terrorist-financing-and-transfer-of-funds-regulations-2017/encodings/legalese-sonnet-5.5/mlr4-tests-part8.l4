IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr4-part8`

-- TESTS for mlr4-part8 (regulations 65 to 74C).  Every expected value was decided by reading the
-- provision (the words are quoted beside the assertion), not by running the code.  A function
-- that can answer NOTHING has a NOTHING case; a boundary has a case on each side.

§ `Tests -- Part 8`

§§ `Regulation 65`

-- 65(1) "premises" means any building or other structure, including a moveable structure, other than premises used only as a dwelling.
#ASSERT `reg 65(1) the place is premises` TRUE FALSE EQUALS JUST TRUE -- an office building
#ASSERT `reg 65(1) the place is premises` TRUE TRUE EQUALS JUST FALSE -- used only as a dwelling
#ASSERT `reg 65(1) the place is premises` FALSE FALSE EQUALS JUST FALSE -- not a building or other structure
#ASSERT `reg 65(1) the place is premises` FALSE TRUE EQUALS JUST FALSE

-- 65(1) "tribunal": the First-tier Tribunal or, where determined by or under Tribunal Procedure Rules, the Upper Tribunal.
#ASSERT `reg 65(1) the tribunal for the purposes of Part 8 is` FALSE EQUALS `reg 65(1) the First-tier Tribunal`
#ASSERT `reg 65(1) the tribunal for the purposes of Part 8 is` TRUE EQUALS `reg 65(1) the Upper Tribunal`

-- 65(2) "officer" (four limbs) and "relevant officer".  Fields, in order: officer of the FCA; officer of Revenue and Customs; employee or agent of a Schedule 1 body; authorised by that body; officer of a local weights and measures authority; officer of the Department for the Economy; where the person acts; acting pursuant to arrangements.
`person: officer of the FCA` MEANS `reg 65(2) person` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, `England and Wales`, FALSE
`person: officer of Revenue and Customs` MEANS `reg 65(2) person` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, `England and Wales`, FALSE
`person: authorised employee of a professional body` MEANS `reg 65(2) person` OF FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, `England and Wales`, FALSE
`person: unauthorised employee of a professional body` MEANS `reg 65(2) person` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, `England and Wales`, FALSE
`person: weights and measures officer in Scotland under arrangements` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, Scotland, TRUE
`person: weights and measures officer in Scotland without arrangements` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, Scotland, FALSE
`person: weights and measures officer in Northern Ireland under arrangements` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, `Northern Ireland`, TRUE
`person: Department for the Economy officer in Northern Ireland under arrangements` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, `Northern Ireland`, TRUE
`person: Department for the Economy officer in England and Wales under arrangements` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, `England and Wales`, TRUE
`person: nobody in particular` MEANS `reg 65(2) person` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, `England and Wales`, FALSE

#ASSERT `reg 65(2) the person is a relevant officer` `person: weights and measures officer in Scotland under arrangements` EQUALS JUST TRUE -- "in Great Britain, an officer of a local weights and measures authority ... acting pursuant to arrangements"
#ASSERT `reg 65(2) the person is a relevant officer` `person: weights and measures officer in Scotland without arrangements` EQUALS JUST FALSE -- no arrangements with the FCA or the Commissioners
#ASSERT `reg 65(2) the person is a relevant officer` `person: weights and measures officer in Northern Ireland under arrangements` EQUALS JUST FALSE -- in Northern Ireland only the Department's officer counts
#ASSERT `reg 65(2) the person is a relevant officer` `person: Department for the Economy officer in Northern Ireland under arrangements` EQUALS JUST TRUE
#ASSERT `reg 65(2) the person is a relevant officer` `person: Department for the Economy officer in England and Wales under arrangements` EQUALS JUST FALSE -- the Department's officer counts only in Northern Ireland
#ASSERT `reg 65(2) the person is an officer` `person: officer of the FCA` EQUALS JUST TRUE -- limb (a)
#ASSERT `reg 65(2) the person is an officer` `person: officer of Revenue and Customs` EQUALS JUST TRUE -- limb (b)
#ASSERT `reg 65(2) the person is an officer` `person: authorised employee of a professional body` EQUALS JUST TRUE -- limb (c)
#ASSERT `reg 65(2) the person is an officer` `person: unauthorised employee of a professional body` EQUALS JUST FALSE -- limb (c) needs the body's authorisation
#ASSERT `reg 65(2) the person is an officer` `person: weights and measures officer in Scotland under arrangements` EQUALS JUST TRUE -- limb (d), a relevant officer
#ASSERT `reg 65(2) the person is an officer` `person: weights and measures officer in Northern Ireland under arrangements` EQUALS JUST FALSE
#ASSERT `reg 65(2) the person is an officer` `person: nobody in particular` EQUALS JUST FALSE

-- 65(3): a connected person is one listed in Schedule 5 (the answer arrives as an input).
#ASSERT `reg 65(3) the person is a connected person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 65(3) the person is a connected person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 65(3) the person is a connected person` NOTHING EQUALS NOTHING -- Schedule 5 has not answered

§§ `Regulation 66`

`two authorities` MEANS LIST `the Financial Conduct Authority`, `the Gambling Commission`
`the Law Society as an authority` MEANS `a professional body listed in Schedule 1` `Law Society`

-- 66(1) "A supervisory authority".
#ASSERT `reg 66(1) the body is a supervisory authority` `the Financial Conduct Authority` (JUST `two authorities`) EQUALS JUST TRUE
#ASSERT `reg 66(1) the body is a supervisory authority` `the Treasury` (JUST `two authorities`) EQUALS NOTHING -- not on regulation 7's list for this person
#ASSERT `reg 66(1) the body is a supervisory authority` `the Financial Conduct Authority` NOTHING EQUALS NOTHING -- regulation 7 has not answered
#ASSERT `reg 66(1) the body is a supervisory authority` `the Law Society as an authority` (JUST (LIST `the Law Society as an authority`)) EQUALS JUST TRUE

-- 66(1) the grant.  Arguments: body is an SA; relevant person; payment service provider; connected person; in writing; what the notice requires; time and place specified.
`attend` MEANS `reg 66(1)(c) the notice requires P to attend before an officer at a time and place specified in the notice and answer questions`
`provide` MEANS `reg 66(1)(a) the notice requires P to provide specified information, or information of a specified description`
`produce` MEANS `reg 66(1)(b) the notice requires P to produce specified documents, or documents of a specified description`
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) TRUE `provide` FALSE EQUALS JUST TRUE -- a relevant person, by notice in writing, to provide information
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) TRUE `produce` FALSE EQUALS JUST TRUE -- to produce documents
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) TRUE `attend` TRUE EQUALS JUST TRUE -- to attend, time and place specified
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) TRUE `attend` FALSE EQUALS NOTHING -- attendance needs "a time and place specified in the notice"
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) FALSE `provide` FALSE EQUALS NOTHING -- not "by notice in writing"
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST FALSE) TRUE (JUST FALSE) TRUE `provide` FALSE EQUALS JUST TRUE -- a payment service provider
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) NOTHING FALSE (JUST TRUE) TRUE `provide` FALSE EQUALS JUST TRUE -- a connected person (relevant person not shown)
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) TRUE `provide` FALSE EQUALS NOTHING -- none of the three kinds of person
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST TRUE) NOTHING FALSE NOTHING TRUE `provide` FALSE EQUALS NOTHING -- neither answer in
#ASSERT `reg 66(1) the supervisory authority may require P` NOTHING (JUST TRUE) FALSE (JUST FALSE) TRUE `provide` FALSE EQUALS NOTHING -- whether the body is a supervisory authority is not shown
#ASSERT `reg 66(1) the supervisory authority may require P` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) TRUE `provide` FALSE EQUALS NOTHING -- the text does not say a body outside regulation 7's list may not

-- 66(1A): "includes".
#ASSERT `reg 66(1A) the power in paragraph (1) includes requiring the information` TRUE EQUALS JUST TRUE -- a copy of a suspicious activity disclosure made to the NCA
#ASSERT `reg 66(1A) the power in paragraph (1) includes requiring the information` FALSE EQUALS NOTHING -- the list is not closed

-- 66(2)(a): before the end of such reasonable period as may be specified; the last day of the period is inside it.
#ASSERT `reg 66(2)(a) the information or documents were provided or produced in time` (JUST 14) TRUE 10 EQUALS JUST TRUE
#ASSERT `reg 66(2)(a) the information or documents were provided or produced in time` (JUST 14) TRUE 14 EQUALS JUST TRUE -- the boundary: day 14 of a 14-day period
#ASSERT `reg 66(2)(a) the information or documents were provided or produced in time` (JUST 14) TRUE 15 EQUALS JUST FALSE -- one day after the end
#ASSERT `reg 66(2)(a) the information or documents were provided or produced in time` (JUST 14) FALSE 15 EQUALS NOTHING -- a period that is not reasonable is not "such reasonable period"
#ASSERT `reg 66(2)(a) the information or documents were provided or produced in time` NOTHING TRUE 3 EQUALS NOTHING -- no period specified

-- 66(2)(b): at such place as may be specified.
#ASSERT `reg 66(2)(b) the information or documents were provided or produced at the specified place` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 66(2)(b) the information or documents were provided or produced at the specified place` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 66(2)(b) the information or documents were provided or produced at the specified place` NOTHING EQUALS NOTHING -- no place specified

-- 66(2)(a) as a regulative rule: P must provide within the period.  Traces print their outcomes; they cannot be asserted on the main binary.
#TRACE `reg 66(2)(a) P must provide the information or produce the documents` 14 AT 0 WITH
    PARTY `reg 66(2) P` DOES `reg 66(2) P provides the information or produces the documents` AT 14
#TRACE `reg 66(2)(a) P must provide the information or produce the documents` 14 AT 0 WITH
    PARTY `reg 66(2) P` DOES `reg 66(2) P provides the information or produces the documents` AT 15

-- 66(3): an officer with written authorisation; the third argument is the answer of reg 66(4) (the powers "may only be exercised" by an authorised officer, in relation to what is reasonably required).
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) TRUE (JUST TRUE) `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS JUST TRUE
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) TRUE (JUST TRUE) `reg 66(3)(b) the officer requires P to produce specified documents, or documents of a specified description` EQUALS JUST TRUE
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) TRUE (JUST TRUE) `reg 66(3) the officer requires something else of P` EQUALS NOTHING -- the list is not closed (attendance is not among the two)
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) FALSE (JUST TRUE) `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS JUST FALSE -- no authorisation in writing: reg 66(4) "may only be exercised ... by an officer authorised under paragraph (3)" (marginal reading (a); was NOTHING)
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) FALSE NOTHING `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS JUST FALSE -- no authorisation in writing: a definite no, whatever reg 66(4) says
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) TRUE (JUST FALSE) `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS JUST FALSE -- reg 66(4) says the information is not reasonably required in connection with supervisory functions
#ASSERT `reg 66(3) the officer may require P` (JUST TRUE) TRUE NOTHING `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS NOTHING -- reg 66(4) has not been answered
#ASSERT `reg 66(3) the officer may require P` (JUST FALSE) TRUE (JUST TRUE) `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS NOTHING -- not an officer: who may ask is a scope limit (ruled 2026-11-05, (c))
#ASSERT `reg 66(3) the officer may require P` NOTHING TRUE (JUST TRUE) `reg 66(3)(a) the officer requires P to provide specified information, or information of a specified description` EQUALS NOTHING
#ASSERT `reg 66(3) P provided or produced without unreasonable delay` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 66(3) P provided or produced without unreasonable delay` TRUE FALSE EQUALS JUST FALSE -- unreasonable delay
#ASSERT `reg 66(3) P provided or produced without unreasonable delay` FALSE TRUE EQUALS NOTHING -- not a requirement under paragraph (3)

-- 66(4): "may only be exercised".
#ASSERT `reg 66(4) the powers in regulation 66 may be exercised` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 66(4) the powers in regulation 66 may be exercised` TRUE FALSE EQUALS JUST FALSE -- not reasonably required in connection with supervisory functions
#ASSERT `reg 66(4) the powers in regulation 66 may be exercised` FALSE TRUE EQUALS JUST FALSE -- not by a supervisory authority or an authorised officer
#ASSERT `reg 66(4) the powers in regulation 66 may be exercised` FALSE FALSE EQUALS JUST FALSE

-- 66(5): the notice must set out the reasons unless the authority is not permitted to disclose them.
#ASSERT `reg 66(5) the notice complies with the requirement to set out the reasons` `provide` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 66(5) the notice complies with the requirement to set out the reasons` `produce` FALSE FALSE EQUALS JUST FALSE -- no reasons, and no bar on disclosing them
#ASSERT `reg 66(5) the notice complies with the requirement to set out the reasons` `produce` FALSE TRUE EQUALS JUST TRUE -- "unless the supervisory authority ... is not permitted to disclose"
#ASSERT `reg 66(5) the notice complies with the requirement to set out the reasons` `attend` FALSE FALSE EQUALS NOTHING -- the paragraph speaks of information and documents, not attendance
#ASSERT `reg 66(5) the duty to set out the reasons arises` `provide` EQUALS JUST TRUE -- "requires information to be provided"
#ASSERT `reg 66(5) the duty to set out the reasons arises` `produce` EQUALS JUST TRUE -- "or documents to be produced"
#ASSERT `reg 66(5) the duty to set out the reasons arises` `attend` EQUALS JUST FALSE -- a notice that requires attendance only is outside "Where ... requires information to be provided or documents to be produced" (ruled 2026-11-05 (b))

-- 66(6)(a), (b), (7), (8), (9).
#ASSERT `reg 66(6)(a) the supervisory authority may require the information to be produced in legible form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 66(6)(a) the supervisory authority may require the information to be produced in legible form` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 66(6)(a) the supervisory authority may require the information to be produced in legible form` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 66(6)(b) the supervisory authority may require the information to be provided in the form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 66(6)(b) the supervisory authority may require the information to be provided in the form` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 66(6)(b) the supervisory authority may require the information to be provided in the form` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 66(7) the production of the document affects a lien on it` TRUE EQUALS JUST FALSE -- "does not affect any lien"
#ASSERT `reg 66(7) the production of the document affects a lien on it` FALSE EQUALS NOTHING
#ASSERT `reg 66(8) the supervisory authority may exercise the power in relation to the third person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 66(8) the supervisory authority may exercise the power in relation to the third person` TRUE FALSE EQUALS JUST FALSE -- failed "if" (marginal reading (a)) (was NOTHING): the document does not appear to be with a third person
#ASSERT `reg 66(8) the supervisory authority may exercise the power in relation to the third person` FALSE TRUE EQUALS JUST FALSE -- failed "if" (marginal reading (a)) (was NOTHING): the authority has no such power
#ASSERT `reg 66(9) suspicious activity disclosure is given by` EQUALS "regulation 104(4)"

-- S-12 (answering): failure to comply with a requirement of a notice.
#ASSERT `reg 66 the person has failed to comply with a requirement of a notice given under regulation 66` FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `reg 66 the person has failed to comply with a requirement of a notice given under regulation 66` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `reg 66 the person has failed to comply with a requirement of a notice given under regulation 66` FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `reg 66 the person has failed to comply with a requirement of a notice given under regulation 66` FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `reg 66 the person has failed to comply with a requirement of a notice given under regulation 66` FALSE FALSE FALSE TRUE EQUALS TRUE

§§ `Regulation 67`

#ASSERT `reg 67(1) the supervisory authority may exercise the power in regulation 66 to meet the request` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 67(1) the supervisory authority may exercise the power in regulation 66 to meet the request` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 67(1) the supervisory authority may exercise the power in regulation 66 to meet the request` TRUE NOTHING EQUALS NOTHING -- paragraph (2) not answered
#ASSERT `reg 67(1) the supervisory authority may exercise the power in regulation 66 to meet the request` FALSE (JUST TRUE) EQUALS NOTHING

#ASSERT `reg 67(2) paragraph (2) applies to the request` TRUE FALSE FALSE EQUALS JUST TRUE -- fourth money laundering directive
#ASSERT `reg 67(2) paragraph (2) applies to the request` FALSE TRUE FALSE EQUALS JUST TRUE -- funds transfer regulation
#ASSERT `reg 67(2) paragraph (2) applies to the request` FALSE FALSE TRUE EQUALS JUST TRUE -- equivalent law of a third country
#ASSERT `reg 67(2) paragraph (2) applies to the request` FALSE FALSE FALSE EQUALS JUST FALSE -- "applies if" none of the three

#ASSERT `reg 67(3) the supervisory authority may take the matter into account` `reg 67(3)(a) whether, in the territory of the foreign authority concerned, corresponding assistance would be given to the supervisory authority` EQUALS JUST TRUE
#ASSERT `reg 67(3) the supervisory authority may take the matter into account` `reg 67(3)(b) whether the case concerns the breach of a law, or other requirement, which has no close parallel in the United Kingdom or involves the assertion of a jurisdiction not recognised by the United Kingdom` EQUALS JUST TRUE
#ASSERT `reg 67(3) the supervisory authority may take the matter into account` `reg 67(3)(c) the seriousness of the case and its importance to persons in the United Kingdom` EQUALS JUST TRUE
#ASSERT `reg 67(3) the supervisory authority may take the matter into account` `reg 67(3) some other matter` EQUALS NOTHING -- "in particular": the list is not closed

#ASSERT `reg 67(4) the supervisory authority may decide not to exercise its powers` FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 67(4) the supervisory authority may decide not to exercise its powers` TRUE FALSE EQUALS JUST TRUE -- only one undertaking given
#ASSERT `reg 67(4) the supervisory authority may decide not to exercise its powers` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 67(4) the supervisory authority may decide not to exercise its powers` TRUE TRUE EQUALS JUST FALSE -- "unless the foreign authority undertakes" both

#ASSERT `reg 67(6) the authority is a foreign authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 67(6) the authority is a foreign authority` TRUE FALSE EQUALS JUST FALSE -- exercises no function referred to in paragraph (2)
#ASSERT `reg 67(6) the authority is a foreign authority` FALSE TRUE EQUALS JUST FALSE -- a United Kingdom authority

-- 66(4) as extended by 67(1).
#ASSERT `reg 66(4) and 67(1) the information or documents may be required under regulation 66` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 66(4) and 67(1) the information or documents may be required under regulation 66` TRUE FALSE TRUE EQUALS JUST TRUE -- reasonably required to meet a foreign request
#ASSERT `reg 66(4) and 67(1) the information or documents may be required under regulation 66` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 66(4) and 67(1) the information or documents may be required under regulation 66` FALSE TRUE TRUE EQUALS JUST FALSE

§§ `Regulation 68`

#ASSERT `reg 68(1) this regulation applies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 68(1) this regulation applies` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 68(1) this regulation applies` TRUE FALSE TRUE EQUALS JUST FALSE -- available in the United Kingdom
#ASSERT `reg 68(1) this regulation applies` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 68(2) the supervisory authority may request the assistance of the foreign authority` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 68(2) the supervisory authority may request the assistance of the foreign authority` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE -- reg 68(1) "applies if" and does not apply (was NOTHING)
#ASSERT `reg 68(2) the supervisory authority may request the assistance of the foreign authority` (JUST TRUE) NOTHING EQUALS NOTHING -- reg 68(1) not answered
#ASSERT `reg 68(2) the supervisory authority may request the assistance of the foreign authority` (JUST FALSE) (JUST TRUE) EQUALS NOTHING -- not a supervisory authority: who may ask is a scope limit (ruled 2026-11-05, (c))
#ASSERT `reg 68(2) the supervisory authority may request the assistance of the foreign authority` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 68(3) the use made of the information or documents is permitted` TRUE TRUE FALSE EQUALS JUST TRUE -- for the purpose for which it was provided
#ASSERT `reg 68(3) the use made of the information or documents is permitted` TRUE FALSE TRUE EQUALS JUST TRUE -- for proceedings arising from a contravention
#ASSERT `reg 68(3) the use made of the information or documents is permitted` TRUE FALSE FALSE EQUALS JUST FALSE -- "must only be used"
#ASSERT `reg 68(3) the use made of the information or documents is permitted` FALSE FALSE FALSE EQUALS NOTHING -- not provided under paragraph (2)
#ASSERT `reg 68(4) paragraph (3) applies` TRUE EQUALS JUST FALSE -- the foreign authority consents
#ASSERT `reg 68(4) paragraph (3) applies` FALSE EQUALS NOTHING -- paragraph (4) says when (3) does not apply, not when it does
#ASSERT `reg 68(5) foreign authority is given by` EQUALS "regulation 67(6)"

§§ `Regulation 69`

#ASSERT `reg 69(4) the person is a duly authorised officer` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- an FCA officer authorised by a Head of Department
#ASSERT `reg 69(4) the person is a duly authorised officer` FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE -- a Revenue and Customs officer authorised by a senior officer
#ASSERT `reg 69(4) the person is a duly authorised officer` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- authorised by someone other than a Head of Department
#ASSERT `reg 69(4) the person is a duly authorised officer` FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- below the grade of senior officer
#ASSERT `reg 69(4) the person is a duly authorised officer` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- limbs mixed

-- 69(1).  Arguments: duly authorised officer; SA in relation to P; relevant person; payment service provider; premises ground; contravention ground.
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST TRUE) FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE NOTHING TRUE TRUE TRUE EQUALS JUST TRUE -- a payment service provider
#ASSERT `reg 69(1) paragraph (2) applies` NOTHING TRUE (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE NOTHING FALSE TRUE TRUE EQUALS NOTHING -- not a payment service provider and the relevant person question not answered
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST FALSE) FALSE TRUE TRUE EQUALS JUST FALSE -- neither a relevant person nor a payment service provider: "applies where" (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) FALSE (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE -- not an officer of or acting for a supervisory authority (was NOTHING)
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE -- no reasonable grounds to believe the premises are used by P (was NOTHING)
#ASSERT `reg 69(1) paragraph (2) applies` (JUST TRUE) TRUE (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE -- no reasonable grounds to believe P may have contravened the requirements (was NOTHING)
#ASSERT `reg 69(1) paragraph (2) applies` (JUST FALSE) TRUE (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE -- not a duly authorised officer
#ASSERT `reg 69(1) paragraph (2) applies` NOTHING TRUE (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE -- a definite no wins over an answer that is not in

-- 69(2).  Arguments: paragraph (2) applies; evidence of authority produced; reasonable time; the power.
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(a) enter the premises` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(b) inspect the premises` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(c) observe the carrying on of business or professional activities by P` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(d) inspect any documents or other information found on the premises` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(e) require any person on the premises to provide an explanation of any document or to state where documents or information might be found` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2)(f) inspect any cash found on the premises` EQUALS JUST TRUE
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE TRUE `reg 69(2) some other power` EQUALS NOTHING -- the list is not closed
#ASSERT `reg 69(2) the officer may` (JUST TRUE) FALSE TRUE `reg 69(2)(a) enter the premises` EQUALS NOTHING -- no evidence of authority produced
#ASSERT `reg 69(2) the officer may` (JUST TRUE) TRUE FALSE `reg 69(2)(a) enter the premises` EQUALS NOTHING -- not at a reasonable time
#ASSERT `reg 69(2) the officer may` NOTHING TRUE TRUE `reg 69(2)(a) enter the premises` EQUALS NOTHING
#ASSERT `reg 69(2) the officer may` (JUST FALSE) TRUE TRUE `reg 69(2)(a) enter the premises` EQUALS JUST FALSE -- paragraph (2) does not apply: "Paragraph (2) applies where" (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 69(3) the officer may take copies of, or make extracts from, the documents` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 69(3) the officer may take copies of, or make extracts from, the documents` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 69(3) the officer may take copies of, or make extracts from, the documents` NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 69(3) the officer may take copies of, or make extracts from, the documents` (JUST FALSE) TRUE EQUALS JUST FALSE -- paragraph (2) does not apply: "Paragraph (2) applies where" (ruled 2026-11-05 (b))
#ASSERT `reg 69(3) the officer may take copies of, or make extracts from, the documents` (JUST FALSE) FALSE EQUALS JUST FALSE -- paragraph (2) does not apply, so no power in it was exercised (ruled 2026-11-05 (b))

§§ `Regulation 70`

-- 70(13) "justice".
#ASSERT `reg 70(13) the person is a justice` `England and Wales` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 70(13) the person is a justice` `Northern Ireland` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 70(13) the person is a justice` Scotland FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 70(13) the person is a justice` `England and Wales` FALSE TRUE FALSE EQUALS JUST FALSE -- a lay magistrate is a justice only in Northern Ireland
#ASSERT `reg 70(13) the person is a justice` Scotland TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 70(13) the person is a justice` `Northern Ireland` FALSE FALSE TRUE EQUALS JUST FALSE
-- 70(13) "duly authorised officer" and "executing officer".
#ASSERT `reg 70(13) the person is a duly authorised officer` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 70(13) the person is a duly authorised officer` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 70(13) the person is a duly authorised officer` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 70(13) the person is a duly authorised officer` FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- the warrant is not on the basis of the FCA's information
#ASSERT `reg 70(13) the person is an executing officer` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- a constable, FCA warrant
