#ASSERT `reg 74C(3) a direction may be imposed for the purpose` `reg 74C(3)(c) preventing the cryptoasset business from being used for money laundering, terrorist financing or proliferation financing` EQUALS JUST TRUE
#ASSERT `reg 74C(3) a direction may be imposed for the purpose` `reg 74C(3) some other purpose` EQUALS NOTHING
#ASSERT `reg 74C(4) a direction may have the content` `reg 74C(4) require the taking of specified action` EQUALS JUST TRUE
#ASSERT `reg 74C(4) a direction may have the content` `reg 74C(4) prohibit the taking of specified action` EQUALS JUST TRUE
#ASSERT `reg 74C(4) a direction may have the content` `reg 74C(4) some other content` EQUALS NOTHING
#ASSERT `reg 74C(5) the FCA may on its own initiative` TRUE `reg 74C(5)(a) impose a new direction` EQUALS JUST TRUE
#ASSERT `reg 74C(5) the FCA may on its own initiative` TRUE `reg 74C(5)(b) vary a direction imposed under this regulation` EQUALS JUST TRUE
#ASSERT `reg 74C(5) the FCA may on its own initiative` TRUE `reg 74C(5)(c) rescind such a direction` EQUALS JUST TRUE
#ASSERT `reg 74C(5) the FCA may on its own initiative` FALSE `reg 74C(5)(a) impose a new direction` EQUALS NOTHING
#ASSERT `reg 74C(6) the FCA may on the request of the cryptoasset business` TRUE `reg 74C(6)(a) impose a new direction` EQUALS JUST TRUE
#ASSERT `reg 74C(6) the FCA may on the request of the cryptoasset business` TRUE `reg 74C(6)(b) vary a direction imposed under this regulation` EQUALS JUST TRUE
#ASSERT `reg 74C(6) the FCA may on the request of the cryptoasset business` TRUE `reg 74C(6)(c) rescind such a direction` EQUALS JUST TRUE
#ASSERT `reg 74C(6) the FCA may on the request of the cryptoasset business` FALSE `reg 74C(6)(c) rescind such a direction` EQUALS NOTHING
-- 74C(7).  Arguments: imposes or varies; PRA authorised person; group member; consulted the PRA.
#ASSERT `reg 74C(7) the FCA consulted the PRA as required` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(7) the FCA consulted the PRA as required` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- a group member of a PRA authorised person, no consultation
#ASSERT `reg 74C(7) the FCA consulted the PRA as required` TRUE FALSE FALSE FALSE EQUALS NOTHING -- the duty does not reach the direction
#ASSERT `reg 74C(7) the FCA consulted the PRA as required` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 74C(8) the direction may be expressed to expire at the end of the period` TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(8) the direction may be expressed to expire at the end of the period` FALSE EQUALS NOTHING
#ASSERT `reg 74C(8) the expiry of the direction affects the FCA's power to impose a new direction` TRUE EQUALS JUST FALSE
#ASSERT `reg 74C(8) the expiry of the direction affects the FCA's power to impose a new direction` FALSE EQUALS NOTHING
#ASSERT `reg 74C(9) the FCA gave the notice in writing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(9) the FCA gave the notice in writing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(9) the FCA gave the notice in writing` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 74C(9) the duty to give the notice in writing arises` TRUE EQUALS JUST TRUE -- "If the FCA imposes or varies a direction under paragraph (5)(a) or (b)"
#ASSERT `reg 74C(9) the duty to give the notice in writing arises` FALSE EQUALS JUST FALSE -- no direction imposed or varied under (5): the duty does not arise (marginal reading (a))
-- 74C(10).  Arguments: it is the paragraph (9) notice; (a) details; (b) reasons; (c) representations; (d) when it takes effect; (e) right to refer.
#ASSERT `reg 74C(10) the notice contains what it must` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(10) the notice contains what it must` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- no statement of the right to refer to the Upper Tribunal
#ASSERT `reg 74C(10) the notice contains what it must` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 74C(10) the notice contains what it must` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 74C(11) the FCA may extend the period` TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(11) the FCA may extend the period` FALSE EQUALS NOTHING
#ASSERT `reg 74C(12) the FCA gave the notice in writing of its decision not to rescind` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(12) the FCA gave the notice in writing of its decision not to rescind` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(12) the FCA gave the notice in writing of its decision not to rescind` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 74C(12) the duty to give notice of the decision not to rescind arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(12) the duty to give notice of the decision not to rescind arises` TRUE FALSE EQUALS JUST FALSE -- the FCA decided to rescind or vary
#ASSERT `reg 74C(12) the duty to give notice of the decision not to rescind arises` FALSE TRUE EQUALS JUST FALSE -- representations not considered (marginal reading (a))
#ASSERT `reg 74C(13) the FCA gave the notice in writing of its decision on the representations` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- varies
#ASSERT `reg 74C(13) the FCA gave the notice in writing of its decision on the representations` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- rescinds and imposes a different direction
#ASSERT `reg 74C(13) the FCA gave the notice in writing of its decision on the representations` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- rescinds, no notice
#ASSERT `reg 74C(13) the FCA gave the notice in writing of its decision on the representations` TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING -- none of (a) to (c)
#ASSERT `reg 74C(13) the duty to give notice of the decision on the representations arises` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- varies
#ASSERT `reg 74C(13) the duty to give notice of the decision on the representations arises` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- rescinds and imposes a different direction
#ASSERT `reg 74C(13) the duty to give notice of the decision on the representations arises` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- rescinds and imposes none
#ASSERT `reg 74C(13) the duty to give notice of the decision on the representations arises` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a) to (c): the FCA decides not to rescind, which paragraph (12) governs (marginal reading (a))
#ASSERT `reg 74C(13) the duty to give notice of the decision on the representations arises` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(14) the notice informs the cryptoasset business of its right to refer the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(14) the notice informs the cryptoasset business of its right to refer the matter` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(14) the notice informs the cryptoasset business of its right to refer the matter` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 74C(15) the notice complies with paragraph (10)` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 74C(15) the notice complies with paragraph (10)` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 74C(15) the notice complies with paragraph (10)` TRUE NOTHING EQUALS NOTHING -- paragraph (10) not answered: not a "no"
#ASSERT `reg 74C(15) the notice complies with paragraph (10)` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 74C(16) the notice gives an indication of the procedure on a reference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(16) the notice gives an indication of the procedure on a reference` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(16) the notice gives an indication of the procedure on a reference` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 74C(16) the duty to indicate the procedure on a reference arises` TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(16) the duty to indicate the procedure on a reference arises` FALSE EQUALS JUST FALSE -- the notice does not inform the business of a right to refer: "If a notice informs ..." (marginal reading (a))
#ASSERT `reg 74C(17) the FCA gave the notice in writing of the direction imposed or varied on request` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(17) the FCA gave the notice in writing of the direction imposed or varied on request` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(17) the FCA gave the notice in writing of the direction imposed or varied on request` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 74C(17) the duty to give the notice in writing of the direction imposed or varied on request arises` TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(17) the duty to give the notice in writing of the direction imposed or varied on request arises` FALSE EQUALS JUST FALSE -- no direction imposed or varied under (6)(a) or (b) (marginal reading (a))
#ASSERT `reg 74C(18) the notice contains what it must` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(18) the notice contains what it must` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- no reasons
#ASSERT `reg 74C(18) the notice contains what it must` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 74C(19) the FCA gave the notice in writing of the rescission` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(19) the FCA gave the notice in writing of the rescission` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(19) the FCA gave the notice in writing of the rescission` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 74C(19) the duty to give the notice in writing of the rescission arises` TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(19) the duty to give the notice in writing of the rescission arises` FALSE EQUALS JUST FALSE -- no rescission under (6)(c) (marginal reading (a))
#ASSERT `reg 74C(20) the FCA may publish information about the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(20) the FCA may publish information about the notice` FALSE TRUE EQUALS JUST FALSE -- the FCA does not consider it proportionate: "if it considers it proportionate" (marginal reading (a); was NOTHING)
#ASSERT `reg 74C(20) the FCA may publish information about the notice` TRUE FALSE EQUALS NOTHING -- a notice not given under paragraph (9), (13) or (17): a scope limit (ruled 2026-11-05, (c))
#ASSERT `reg 74C(21) the FCA published the fact of the rescission` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(21) the FCA published the fact of the rescission` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(21) the FCA published the fact of the rescission` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 74C(21) the duty to publish the fact of the rescission arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(21) the duty to publish the fact of the rescission arises` TRUE FALSE EQUALS JUST FALSE -- the FCA does not decide to rescind: "Where ..." (ruled 2026-11-05 (b))
#ASSERT `reg 74C(21) the duty to publish the fact of the rescission arises` FALSE TRUE EQUALS JUST FALSE -- the FCA has published nothing under paragraph (20)
#ASSERT `reg 74C(22) the FCA published the status of the appeal and its outcome` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(22) the FCA published the status of the appeal and its outcome` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 74C(22) the FCA published the status of the appeal and its outcome` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 74C(22) the duty to publish the status of the appeal and its outcome arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 74C(22) the duty to publish the status of the appeal and its outcome arises` TRUE FALSE EQUALS JUST FALSE -- the matter was not referred to the Upper Tribunal: "Where ..." (ruled 2026-11-05 (b))
#ASSERT `reg 74C(22) the duty to publish the status of the appeal and its outcome arises` FALSE TRUE EQUALS JUST FALSE
