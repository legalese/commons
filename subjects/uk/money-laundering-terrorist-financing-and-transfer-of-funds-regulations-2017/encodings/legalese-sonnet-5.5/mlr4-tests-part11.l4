IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr4-part11`


-- TESTS for mlr4-part11 (regulations 101 to 110).  Every expected value was decided by reading the
-- provision (the words are quoted beside the assertion), not by running the code.

§ `Tests -- Part 11`

§§ `Regulation 101`

#ASSERT `reg 101 the charge or penalty is a debt due to` TRUE `the Financial Conduct Authority` EQUALS JUST `the Financial Conduct Authority` -- due to the FCA "respectively"
#ASSERT `reg 101 the charge or penalty is a debt due to` TRUE `the Commissioners for Her Majesty's Revenue and Customs` EQUALS JUST `the Commissioners for Her Majesty's Revenue and Customs`
#ASSERT `reg 101 the charge or penalty is a debt due to` TRUE `the Treasury` EQUALS NOTHING
#ASSERT `reg 101 the charge or penalty is a debt due to` FALSE `the Financial Conduct Authority` EQUALS NOTHING -- imposed on neither a relevant person nor a provider (an officer, under regulation 76(3))

§§ `Regulation 102`

#ASSERT `reg 102(1) the charge may be imposed on` TRUE `reg 102(1)(a) applicants for approval under Chapter 3 of Part 2` EQUALS JUST TRUE
#ASSERT `reg 102(1) the charge may be imposed on` TRUE `reg 102(1)(c) relevant persons supervised by them` EQUALS JUST TRUE
#ASSERT `reg 102(1) the charge may be imposed on` TRUE `reg 102(1)(e) professional bodies listed in Schedule 1, for which they undertake enforcement action in relation to relevant persons supervised by those professional bodies` EQUALS JUST TRUE
#ASSERT `reg 102(1) the charge may be imposed on` TRUE `reg 102(1) some other class` EQUALS NOTHING
#ASSERT `reg 102(1) the charge may be imposed on` FALSE `reg 102(1)(a) applicants for approval under Chapter 3 of Part 2` EQUALS NOTHING
#ASSERT `reg 102(2) the charge is permitted` 100 100 EQUALS NOTHING -- "must not exceed": equal does not exceed
#ASSERT `reg 102(2) the charge is permitted` 101 100 EQUALS JUST FALSE
#ASSERT `reg 102(2) the charge is permitted` 0 100 EQUALS NOTHING
#ASSERT `reg 102(3) a charge may be levied in respect of each of the premises` TRUE EQUALS JUST TRUE
#ASSERT `reg 102(3) a charge may be levied in respect of each of the premises` FALSE EQUALS NOTHING
#ASSERT `reg 102(4) the FCA paid the penalties it received to the Treasury` 0 0 EQUALS NOTHING -- nothing received that year
#ASSERT `reg 102(4) the FCA paid the penalties it received to the Treasury` 1000 1000 EQUALS JUST TRUE
#ASSERT `reg 102(4) the FCA paid the penalties it received to the Treasury` 1000 999 EQUALS JUST FALSE
#ASSERT `reg 102(4) the FCA paid the penalties it received to the Treasury` 1000 1500 EQUALS JUST TRUE
#ASSERT `reg 102(5) the Treasury may give directions to the FCA` TRUE EQUALS JUST TRUE
#ASSERT `reg 102(5) the Treasury may give directions to the FCA` FALSE EQUALS NOTHING
#ASSERT `reg 102(6) the directions may` TRUE `reg 102(6)(a) specify the time when any payment is required to be made to the Treasury` EQUALS JUST TRUE
#ASSERT `reg 102(6) the directions may` TRUE `reg 102(6)(b) require the FCA to provide the Treasury at specified times with information relating to penalties that the FCA has imposed under Part 9` EQUALS JUST TRUE
#ASSERT `reg 102(6) the directions may` TRUE `reg 102(6) some other content` EQUALS NOTHING -- "in particular"
#ASSERT `reg 102(6) the directions may` FALSE `reg 102(6)(a) specify the time when any payment is required to be made to the Treasury` EQUALS NOTHING
#ASSERT `reg 102(7) the Treasury paid the sums into the Consolidated Fund` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 102(7) the Treasury paid the sums into the Consolidated Fund` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 102(7) the Treasury paid the sums into the Consolidated Fund` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 102(8) the expenses are expenses within paragraph (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 102(8) the expenses are expenses within paragraph (2)` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 102(8) the expenses are expenses within paragraph (2)` FALSE TRUE EQUALS NOTHING

§§ `Regulation 103`

#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(a) the Auditor General for Scotland` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(f) the FCA` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(l) the Secretary of State, in the exercise of his or her functions under enactments relating to companies and insolvency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(u) a person authorised to require the production of documents under section 447 of the Companies Act 1985, or section 84 of the Companies Act 1989` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(f) the FCA` TRUE FALSE EQUALS JUST FALSE -- knows or suspects and did not inform the NCA
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1)(f) the FCA` FALSE FALSE EQUALS NOTHING -- neither knows nor suspects
#ASSERT `reg 103(1) the body or person informed the NCA as required` `reg 103(1) some other body` TRUE TRUE EQUALS NOTHING -- not one of the twenty-one
#ASSERT `reg 103(2) the disclosure breaches a restriction on the disclosure of information` TRUE EQUALS JUST FALSE
#ASSERT `reg 103(2) the disclosure breaches a restriction on the disclosure of information` FALSE EQUALS NOTHING
#ASSERT `reg 103(3) civil liability arises in respect of the disclosure` TRUE EQUALS JUST FALSE
#ASSERT `reg 103(3) civil liability arises in respect of the disclosure` FALSE EQUALS NOTHING -- not in good faith

§§ `Regulation 104`

#ASSERT `reg 104(4) the disclosure is a suspicious activity disclosure` TRUE TRUE FALSE EQUALS JUST TRUE -- Part 3 of the Terrorism Act 2000
#ASSERT `reg 104(4) the disclosure is a suspicious activity disclosure` TRUE FALSE TRUE EQUALS JUST TRUE -- Part 7 of the Proceeds of Crime Act 2002
#ASSERT `reg 104(4) the disclosure is a suspicious activity disclosure` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 104(4) the disclosure is a suspicious activity disclosure` FALSE TRUE TRUE EQUALS JUST FALSE -- not made to the NCA
#ASSERT `reg 104(1) the NCA made arrangements to provide appropriate feedback` 1 TRUE EQUALS JUST TRUE -- "at least once a year"
#ASSERT `reg 104(1) the NCA made arrangements to provide appropriate feedback` 0 TRUE EQUALS JUST FALSE
#ASSERT `reg 104(1) the NCA made arrangements to provide appropriate feedback` 2 TRUE EQUALS JUST TRUE
#ASSERT `reg 104(1) the NCA made arrangements to provide appropriate feedback` 1 FALSE EQUALS JUST FALSE -- the feedback is not appropriate
#ASSERT `reg 104(2) the feedback may be provided in the way` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 104(2) the feedback may be provided in the way` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 104(2) the feedback may be provided in the way` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 104(3) the feedback may be provided in the form` TRUE EQUALS JUST TRUE
#ASSERT `reg 104(3) the feedback may be provided in the form` FALSE EQUALS NOTHING
#ASSERT `reg 104A the provision in relation to the NCA as the United Kingdom's financial intelligence unit is made by` EQUALS "Schedule 6A"

§§ `Regulation 105`

#ASSERT `reg 105(1) the Commissioners may disclose the information to the FCA` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 105(1) the Commissioners may disclose the information to the FCA` TRUE FALSE EQUALS JUST FALSE -- "if the disclosure is made for the purpose of"
#ASSERT `reg 105(1) the Commissioners may disclose the information to the FCA` FALSE TRUE EQUALS JUST FALSE
-- 105(2).  Arguments: disclosed to the FCA under (1); (a) to or authorised by the Commissioners; (b) criminal proceedings; (c) other proceedings by the FCA; (d) summary form.
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- the bar applies
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- exception (a)
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- exception (b)
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- exception (c)
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- exception (d)
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not information disclosed under paragraph (1)
#ASSERT `reg 105(2) the FCA or a recipient must not disclose the information` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 105(2) FCA the prohibition on the FCA` (JUST FALSE) EQUALS FULFILLED
#ASSERT `reg 105(2) FCA the prohibition on the FCA` NOTHING EQUALS FULFILLED
#ASSERT `reg 105(2) recipient the prohibition on a person who receives the information from the FCA` (JUST FALSE) EQUALS FULFILLED
#TRACE `reg 105(2) FCA the prohibition on the FCA` (JUST TRUE) AT 0 WITH
    PARTY `reg 105(2) the FCA` DOES `reg 105(2) the FCA discloses the information` AT 4
#TRACE `reg 105(2) recipient the prohibition on a person who receives the information from the FCA` (JUST TRUE) AT 0 WITH
    PARTY `reg 105(2) a person who receives the information from the FCA` DOES `reg 105(2) the person discloses the information` AT 4

§§ `Regulation 106`

#ASSERT `reg 106 these Regulations authorise or require the disclosure` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 106 these Regulations authorise or require the disclosure` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 106 these Regulations authorise or require the disclosure` FALSE FALSE EQUALS NOTHING

§§ `Regulation 107`

#ASSERT `reg 107 the transfer is treated as a transfer of funds within the United Kingdom` TRUE `reg 107(a) the Channel Islands` EQUALS JUST TRUE
#ASSERT `reg 107 the transfer is treated as a transfer of funds within the United Kingdom` TRUE `reg 107(b) the Isle of Man` EQUALS JUST TRUE
#ASSERT `reg 107 the transfer is treated as a transfer of funds within the United Kingdom` TRUE `reg 107 some other place` EQUALS NOTHING
#ASSERT `reg 107 the transfer is treated as a transfer of funds within the United Kingdom` FALSE `reg 107(a) the Channel Islands` EQUALS NOTHING

§§ `Regulation 108`

#ASSERT `reg 108(1) the Treasury carried out a review and published a report` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 108(1) the Treasury carried out a review and published a report` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 108(1) the Treasury carried out a review and published a report` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 108(2) the first report was published in time` (Date 25 6 2022) EQUALS JUST TRUE -- before 26th June 2022
#ASSERT `reg 108(2) the first report was published in time` (Date 26 6 2022) EQUALS JUST FALSE -- on that day is not before it
#ASSERT `reg 108(2) the first report was published in time` (Date 1 1 2020) EQUALS JUST TRUE
#ASSERT `reg 108(3) the subsequent report was published in time` TRUE 5 EQUALS JUST TRUE -- "not exceeding 5 years"
#ASSERT `reg 108(3) the subsequent report was published in time` TRUE 6 EQUALS JUST FALSE
#ASSERT `reg 108(3) the subsequent report was published in time` FALSE 9 EQUALS NOTHING -- the first report is under paragraph (2)
#ASSERT `reg 108(4) the review had regard to how the instruments are implemented in other member States` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 108(4) the review had regard to how the instruments are implemented in other member States` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 108(4) the review had regard to how the instruments are implemented in other member States` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- 108(5).  Arguments: a report under this regulation; (a) objectives; (b) extent achieved; (c) still appropriate; the objectives remain appropriate; (d) a less onerous way.
#ASSERT `reg 108(5) the report sets out what it must` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 108(5) the report sets out what it must` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- objectives remain appropriate and no assessment of a less onerous way
#ASSERT `reg 108(5) the report sets out what it must` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- objectives no longer appropriate: (d) is not needed
#ASSERT `reg 108(5) the report sets out what it must` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 108(5) the report sets out what it must` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 108(6) regulatory provision is given by` EQUALS "sections 28 to 32 of the Small Business, Enterprise and Employment Act 2015 (see section 32 of that Act)"

§§ `Regulation 109`

#ASSERT `reg 109 the amendments relating to these Regulations are made by` EQUALS "Schedule 7"

§§ `Regulation 110`

#ASSERT `reg 110(5) the instrument is one of the old money laundering regulations` `reg 110(5)(a) the Money Laundering Regulations 2007` EQUALS JUST TRUE
#ASSERT `reg 110(5) the instrument is one of the old money laundering regulations` `reg 110(5)(e) the Money Laundering (Amendment) Regulations 2015` EQUALS JUST TRUE
#ASSERT `reg 110(5) the instrument is one of the old money laundering regulations` `reg 110(6) the Transfer of Funds (Information on the Payer) Regulations 2007` EQUALS JUST FALSE -- "means" the five
#ASSERT `reg 110(5) the instrument is one of the old money laundering regulations` `reg 110 some other instrument` EQUALS JUST FALSE
#ASSERT `reg 110(6) the instrument is the old transfer of funds regulations` `reg 110(6) the Transfer of Funds (Information on the Payer) Regulations 2007` EQUALS JUST TRUE
#ASSERT `reg 110(6) the instrument is the old transfer of funds regulations` `reg 110(5)(a) the Money Laundering Regulations 2007` EQUALS JUST FALSE
#ASSERT `reg 110(6) the instrument is the old transfer of funds regulations` `reg 110 some other instrument` EQUALS JUST FALSE
#ASSERT `reg 110(1) the instrument is revoked` TRUE EQUALS JUST TRUE
#ASSERT `reg 110(1) the instrument is revoked` FALSE EQUALS NOTHING
#ASSERT `reg 110(2) the old regulations continue to have effect` (Date 25 6 2017) EQUALS JUST TRUE -- the day before these Regulations came into force
#ASSERT `reg 110(2) the old regulations continue to have effect` (Date 26 6 2017) EQUALS JUST FALSE -- the day they came into force is not before it: "where ... began before" (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 110(2) the old regulations continue to have effect` (Date 1 1 2017) EQUALS JUST TRUE
#ASSERT `reg 110(2) the old regulations continue to have effect` (Date 27 6 2017) EQUALS JUST FALSE -- conduct that began after they came into force (ruled 2026-11-05 (b); was NOTHING)
#ASSERT `reg 110(3) a penalty or an offence under the relevant Part of these Regulations has effect` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 110(3) a penalty or an offence under the relevant Part of these Regulations has effect` (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 110(3) a penalty or an offence under the relevant Part of these Regulations has effect` NOTHING EQUALS NOTHING
#ASSERT `reg 110(4) the conduct is taken to have begun on` TRUE (Date 3 3 2017) EQUALS JUST (Date 3 3 2017)
#ASSERT `reg 110(4) the conduct is taken to have begun on` FALSE (Date 3 3 2017) EQUALS NOTHING

