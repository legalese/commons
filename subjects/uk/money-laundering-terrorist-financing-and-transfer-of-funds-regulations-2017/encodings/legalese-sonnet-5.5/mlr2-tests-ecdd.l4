#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(b)(v) new products and new business practices are involved, including new` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(b)(v) new products and new business practices are involved, including new` EQUALS JUST "new products and new business practices are involved, including new delivery mechanisms, and the use of new or developing technologies for both new and pre-existing products"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(b)(vi) the service involves the provision of nominee directors, nominee` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(b)(vi) the service involves the provision of nominee directors, nominee` EQUALS JUST "the service involves the provision of nominee directors, nominee shareholders or shadow directors, or the formation of companies in a third country"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(b)(vii) there is a transaction related to oil, arms, precious metals, tobacco` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(b)(vii) there is a transaction related to oil, arms, precious metals, tobacco` EQUALS JUST "there is a transaction related to oil, arms, precious metals, tobacco products, cultural artefacts, ivory or other items related to protected species, or other items of archaeological, historical, cultural or religious significance or of rare scientific value"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(i) countries identified by credible sources, such as mutual evaluations` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(i) countries identified by credible sources, such as mutual evaluations` EQUALS JUST "countries identified by credible sources, such as mutual evaluations, detailed assessment reports or published follow-up reports, as not having effective systems to counter money laundering or terrorist financing"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(ii) countries identified by credible sources as having significant levels` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(ii) countries identified by credible sources as having significant levels` EQUALS JUST "countries identified by credible sources as having significant levels of corruption or other criminal activity, such as terrorism (within the meaning of section 1 of the Terrorism Act 2000 ), money laundering, and the production and supply of illicit drugs"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(iii) countries subject to sanctions, embargos or similar measures issued` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(iii) countries subject to sanctions, embargos or similar measures issued` EQUALS JUST "countries subject to sanctions, embargos or similar measures issued by, for example, the European Union or the United Nations"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(iv) countries providing funding or support for terrorism` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(iv) countries providing funding or support for terrorism` EQUALS JUST "countries providing funding or support for terrorism"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(v) countries that have organisations operating within their territory` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(v) countries that have organisations operating within their territory` EQUALS JUST "countries that have organisations operating within their territory which have been designated— (aa) by the government of the United Kingdom as proscribed organisations under Schedule 2 to the Terrorism Act 2000 , or (bb) by other countries, international organisations or the European Union as terrorist organisations"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6)(c)(vi) countries identified by credible sources, such as evaluations, detailed` EQUALS JUST TRUE
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6)(c)(vi) countries identified by credible sources, such as evaluations, detailed` EQUALS JUST "countries identified by credible sources, such as evaluations, detailed assessment reports or published follow-up reports published by the Financial Action Task Force, the International Monetary Fund, the World Bank, the Organisation for Economic Co-operation and Development or other international bodies or non-governmental organisations as not implementing requirements to counter money laundering and terrorist financing that are consistent with the recommendations published by the Financial Action Task Force in February 2012 and updated in June 2019"
#ASSERT `reg 33(6) the relevant person must take the risk factor into account` `reg 33(6) another risk factor` EQUALS NOTHING
#ASSERT `reg 33(6) the wording of the entry` `reg 33(6) another risk factor` EQUALS NOTHING

-- (6): the heading each listed risk factor stands under, and how many stand under each
#ASSERT `reg 33(6) the heading under which the risk factor is listed` `reg 33(6)(a)(i) the business relationship is conducted in unusual circumstances` EQUALS JUST `reg 33(6)(a) customer risk factors`
#ASSERT `reg 33(6) the heading under which the risk factor is listed` `reg 33(6)(b)(i) the product involves private banking` EQUALS JUST `reg 33(6)(b) product, service, transaction or delivery channel risk factors`
#ASSERT `reg 33(6) the heading under which the risk factor is listed` `reg 33(6)(c)(i) countries identified by credible sources, such as mutual evaluations` EQUALS JUST `reg 33(6)(c) geographical risk factors`
#ASSERT `reg 33(6) the heading under which the risk factor is listed` `reg 33(6) another risk factor` EQUALS NOTHING
#ASSERT `reg 33(6) the number of listed risk factors under the heading` `reg 33(6)(a) customer risk factors` EQUALS 8
#ASSERT `reg 33(6) the number of listed risk factors under the heading` `reg 33(6)(b) product, service, transaction or delivery channel risk factors` EQUALS 7
#ASSERT `reg 33(6) the number of listed risk factors under the heading` `reg 33(6)(c) geographical risk factors` EQUALS 6
-- (6) arguments: relevant person; assessing; the risk factor.  "When assessing ..." counts as "where" (ruling of 2026-11-05 (b))
#ASSERT `reg 33(6) the relevant person must take account of the risk factor when assessing` (JUST TRUE) TRUE `reg 33(6)(a)(i) the business relationship is conducted in unusual circumstances` EQUALS JUST TRUE
#ASSERT `reg 33(6) the relevant person must take account of the risk factor when assessing` (JUST TRUE) FALSE `reg 33(6)(a)(i) the business relationship is conducted in unusual circumstances` EQUALS JUST FALSE
#ASSERT `reg 33(6) the relevant person must take account of the risk factor when assessing` (JUST TRUE) TRUE `reg 33(6) another risk factor` EQUALS NOTHING
#ASSERT `reg 33(6) the relevant person must take account of the risk factor when assessing` (JUST FALSE) TRUE `reg 33(6)(a)(i) the business relationship is conducted in unusual circumstances` EQUALS NOTHING

-- (7): "may not always indicate" -- nothing, whatever the number of risk factors
#ASSERT `reg 33(7) the presence of the risk factors indicates a high risk of money laundering or terrorist financing` 0 EQUALS NOTHING
#ASSERT `reg 33(7) the presence of the risk factors indicates a high risk of money laundering or terrorist financing` 1 EQUALS NOTHING
#ASSERT `reg 33(7) the presence of the risk factors indicates a high risk of money laundering or terrorist financing` 7 EQUALS NOTHING

§ `Regulation 34`

-- generated tests for the entries of reg 34(1) (expected wording read from the raw text by line number)
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(a) gather sufficient information about the respondent to understand fully` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(a) gather sufficient information about the respondent to understand fully` EQUALS JUST "gather sufficient information about the respondent to understand fully the nature of its business"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(b) determine from publicly-available information from credible sources` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(b) determine from publicly-available information from credible sources` EQUALS JUST "determine from publicly-available information from credible sources the reputation of the respondent and the quality of the supervision to which the respondent is subject"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(c) assess the respondent's controls to counter money laundering` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(c) assess the respondent's controls to counter money laundering` EQUALS JUST "assess the respondent's controls to counter money laundering and terrorist financing"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(d) obtain approval from senior management before establishing a new` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(d) obtain approval from senior management before establishing a new` EQUALS JUST "obtain approval from senior management before establishing a new correspondent relationship"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(e) document the responsibilities of the respondent and correspondent` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(e) document the responsibilities of the respondent and correspondent` EQUALS JUST "document the responsibilities of the respondent and correspondent in the correspondent relationship"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1)(f) be satisfied that, in respect of those of the respondent's customers` EQUALS JUST TRUE
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1)(f) be satisfied that, in respect of those of the respondent's customers` EQUALS JUST "be satisfied that, in respect of those of the respondent's customers who have direct access to accounts with the correspondent, the respondent— (i) has verified the identity of, and conducts ongoing customer due diligence measures in relation to, such customers; and (ii) is able to provide to the correspondent, upon request, the documents or information obtained when applying such customer due diligence measures"
#ASSERT `reg 34(1) the measure must be taken` `reg 34(1) another measure` EQUALS NOTHING
#ASSERT `reg 34(1) the wording of the entry` `reg 34(1) another measure` EQUALS NOTHING

-- (1) arguments: the kind of institution; has a correspondent relationship involving payments with another such institution; the respondent is from a third country
#ASSERT `reg 34(1) the correspondent must take the measures that the paragraph lists` `credit institution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 34(1) the correspondent must take the measures that the paragraph lists` `financial institution` TRUE TRUE EQUALS JUST TRUE
-- not from a third country, or no such relationship: the paragraph says nothing
#ASSERT `reg 34(1) the correspondent must take the measures that the paragraph lists` `credit institution` TRUE FALSE EQUALS NOTHING
#ASSERT `reg 34(1) the correspondent must take the measures that the paragraph lists` `credit institution` FALSE TRUE EQUALS NOTHING
-- an estate agent is neither
#ASSERT `reg 34(1) the correspondent must take the measures that the paragraph lists` `estate agent` TRUE TRUE EQUALS NOTHING
-- (1)(d): arguments the date approval was obtained; the date the new correspondent relationship was established
#ASSERT `reg 34(1)(d) approval was obtained before the new correspondent relationship was established` (JUST (Date 1 3 2021)) (Date 2 3 2021) EQUALS JUST TRUE
#ASSERT `reg 34(1)(d) approval was obtained before the new correspondent relationship was established` (JUST (Date 2 3 2021)) (Date 2 3 2021) EQUALS JUST FALSE
#ASSERT `reg 34(1)(d) approval was obtained before the new correspondent relationship was established` (JUST (Date 3 3 2021)) (Date 2 3 2021) EQUALS JUST FALSE
-- established with no approval at all: the "before" duty was missed
#ASSERT `reg 34(1)(d) approval was obtained before the new correspondent relationship was established` NOTHING (Date 2 3 2021) EQUALS JUST FALSE
#ASSERT `reg 34(1) the measures taken include every measure that the paragraph requires` (`reg 34(1) the entries listed`) EQUALS JUST TRUE
#ASSERT `reg 34(1) the measures taken include every measure that the paragraph requires` (drop 1 (`reg 34(1) the entries listed`)) EQUALS JUST FALSE
#ASSERT `reg 34(1) the measures taken include every measure that the paragraph requires` (take 5 (`reg 34(1) the entries listed`)) EQUALS JUST FALSE

-- (2): "must not enter into, or continue, a correspondent relationship with a shell bank"
#ASSERT `reg 34(2) the institution may enter into or continue a correspondent relationship with the other party` `credit institution` TRUE EQUALS JUST FALSE
#ASSERT `reg 34(2) the institution may enter into or continue a correspondent relationship with the other party` `financial institution` TRUE EQUALS JUST FALSE
#ASSERT `reg 34(2) the institution may enter into or continue a correspondent relationship with the other party` `credit institution` FALSE EQUALS NOTHING
#ASSERT `reg 34(2) the institution may enter into or continue a correspondent relationship with the other party` `estate agent` TRUE EQUALS NOTHING
-- (3) arguments: the kind; the other institution is known to allow its accounts to be used by a shell bank
#ASSERT `reg 34(3) the institution must take appropriate enhanced measures to ensure it does not enter into or continue the relationship` `credit institution` TRUE EQUALS JUST TRUE
#ASSERT `reg 34(3) the institution must take appropriate enhanced measures to ensure it does not enter into or continue the relationship` `credit institution` FALSE EQUALS NOTHING
#ASSERT `reg 34(3) the institution must take appropriate enhanced measures to ensure it does not enter into or continue the relationship` `high value dealer` TRUE EQUALS NOTHING

-- (4)(a): each listed service or relationship is included; another is not covered; the definition is "means"
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) providing a current or other liability account and related services` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) cash management` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) international funds transfers` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) cheque clearing` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) providing customers of the respondent with direct access to accounts with the correspondent (and vice versa)` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(i) providing foreign exchange services` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(ii) a relationship established for securities transactions` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a)(ii) a relationship established for funds transfers` EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) the service or relationship is included in a correspondent relationship` `reg 34(4)(a) another service or relationship` EQUALS NOTHING
#ASSERT `reg 34(4)(a) there is a correspondent relationship` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) there is a correspondent relationship` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 34(4)(a) there is a correspondent relationship` FALSE FALSE EQUALS JUST FALSE
-- (4)(b) arguments: a credit or financial institution (or equivalent); incorporated where it has no physical presence; part of a financial conglomerate
#ASSERT `reg 34(4)(b) the institution is a shell bank` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 34(4)(b) the institution is a shell bank` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 34(4)(b) the institution is a shell bank` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 34(4)(b) the institution is a shell bank` TRUE TRUE TRUE EQUALS JUST FALSE
