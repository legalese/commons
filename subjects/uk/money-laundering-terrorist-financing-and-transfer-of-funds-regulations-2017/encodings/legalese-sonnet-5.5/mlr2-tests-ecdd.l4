IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr2-helpers`
IMPORT `mlr2-ecdd`

-- TESTS for mlr2-helpers.l4 and mlr2-ecdd.l4 (regulations 33 to 36).  Every expected value is written by hand from the text
-- beside the assertion; none is copied from the encoding's own output.  Each line is one #ASSERT.

§ `Helpers (three-valued logic)`

#ASSERT `mlr2 both are true` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `mlr2 both are true` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `mlr2 both are true` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `mlr2 both are true` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `mlr2 both are true` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `mlr2 both are true` NOTHING NOTHING EQUALS NOTHING
#ASSERT `mlr2 either is true` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `mlr2 either is true` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `mlr2 either is true` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `mlr2 either is true` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `mlr2 either is true` NOTHING NOTHING EQUALS NOTHING
#ASSERT `mlr2 the opposite of` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `mlr2 the opposite of` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `mlr2 the opposite of` NOTHING EQUALS NOTHING
#ASSERT `mlr2 the fact stated` TRUE EQUALS JUST TRUE
#ASSERT `mlr2 the fact stated` FALSE EQUALS JUST FALSE
#ASSERT `mlr2 for a relevant person` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `mlr2 for a relevant person` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `mlr2 for a relevant person` (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `mlr2 for a relevant person` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `mlr2 if the condition holds` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `mlr2 if the condition holds` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `mlr2 if the condition holds` NOTHING (JUST TRUE) EQUALS NOTHING

§ `Regulation 33(3) -- the three definitions`

-- (3)(a) "means a country named on the list" -- named: yes; not named: no.
#ASSERT `reg 33(3)(a) the country is a FATF call for action country` TRUE EQUALS JUST TRUE
#ASSERT `reg 33(3)(a) the country is a FATF call for action country` FALSE EQUALS JUST FALSE
-- (3)(b) "means a transaction in relation to which the relevant person is required to apply customer due diligence measures under regulation 27".
#ASSERT `reg 33(3)(b) the transaction is a relevant transaction` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 33(3)(b) the transaction is a relevant transaction` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 33(3)(b) the transaction is a relevant transaction` NOTHING EQUALS NOTHING

-- (3)(c)(i): a legal person is established where it is incorporated or has its principal place of business; (ii) an individual where resident, not merely born there.
-- fields: kind, incorporated, principal place of business, principal regulatory authority, resident, born
GIVEN kind IS A `reg 33(3)(c) kind of person`
      incorporated IS A BOOLEAN
      business IS A BOOLEAN
      authority IS A BOOLEAN
      resident IS A BOOLEAN
      born IS A BOOLEAN
GIVETH A `reg 33(3)(c) the person and the country`
`reg 33(3)(c) test person` MEANS `reg 33(3)(c) the person and the country` WITH
    `kind of person` IS kind
    `incorporated in the country` IS incorporated
    `has its principal place of business in the country` IS business
    `has its principal regulatory authority in the country` IS authority
    `resident in the country` IS resident
    `born in the country` IS born

#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a legal person other than a financial institution or a credit institution` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a legal person other than a financial institution or a credit institution` FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- a legal person that is not a financial or credit institution is not established in a country only because its principal regulatory authority is there, or because someone resident there owns it
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a legal person other than a financial institution or a credit institution` FALSE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a legal person other than a financial institution or a credit institution` FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE
-- a financial institution or a credit institution is also established where its principal regulatory authority is
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a financial institution or a credit institution` FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a financial institution or a credit institution` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(i) a financial institution or a credit institution` FALSE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
-- an individual: resident, yes; merely born there, no
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(ii) an individual` FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(3)(c) the person is established in the country` (`reg 33(3)(c) test person` `reg 33(3)(c)(ii) an individual` FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE

§ `Regulation 33(1)(b) and (1)`

-- (1)(b): route one needs a business relationship AND a person established in a FATF country; route two needs a relevant transaction AND a party established there.
-- arguments: business relationship, person established, relevant transaction, a party established
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- neither route holds (the person is not established in a FATF country, and no party to the transaction is): "in any ... where" is not met, so no (ruling of 2026-11-05 (b))
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- one route fails and the other seam is unanswered: nothing
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS NOTHING
-- no relationship and no transaction: no
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- seams unanswered (S-K1 and S-1 unanswered): nothing
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` NOTHING (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
-- one route holds although the other seam is unanswered
#ASSERT `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE

-- the record of a case, built from ten answers in the order of the paragraph:
-- (a)(i) (a)(ii) (b) (c) (d) (e) (f)(i) (f)(ii) (f)(iii) (g)
GIVEN ai IS A BOOLEAN
      aii IS A BOOLEAN
      b IS A MAYBE BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      fi IS A BOOLEAN
      fii IS A BOOLEAN
      fiii IS A BOOLEAN
      g IS A BOOLEAN
GIVETH A `reg 33(1) the case`
`reg 33(1) test case` MEANS `reg 33(1) the case` WITH
    `the relevant person's risk assessment under regulation 18(1) identified the case as one where there is a high risk of money laundering or terrorist financing` IS ai
    `information made available under regulations 17(9) and 47 identified the case as one where there is a high risk of money laundering or terrorist financing` IS aii
    `reg 33(1)(b) the business relationship or transaction is connected with a FATF call for action country` IS b
    `the case is a correspondent relationship with a credit institution or a financial institution` IS c
    `the relevant person has determined that the customer or potential customer is a PEP, or a family member or known close associate of a PEP` IS d
    `the relevant person has discovered that the customer has provided false or stolen identification documentation or information, and proposes to continue to deal with that customer` IS e
    `a transaction is unusually complex or unusually large, in each case given the nature of the transaction` IS fi
    `there is an unusual pattern of transactions` IS fii
    `the transaction or transactions have no apparent economic or legal purpose` IS fiii
    `the case by its nature can present a higher risk of money laundering or terrorist financing` IS g

-- each limb alone makes the duty arise
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` TRUE FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE TRUE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- no limb holds: every limb is an "in any case where" or an "if", and limb (g) catches any other case that can present a higher risk, so the answer is no (ruling of 2026-11-05 (b))
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST TRUE) (`reg 33(1) test case` FALSE FALSE NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- the duty is a relevant person's: for anyone else, or where regulation 8 has not answered, nothing
#ASSERT `reg 33(1) enhanced customer due diligence is required` (JUST FALSE) (`reg 33(1) test case` TRUE TRUE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT `reg 33(1) enhanced customer due diligence is required` NOTHING (`reg 33(1) test case` TRUE TRUE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- 33(1) in addition to regulation 28: arguments the 33(1) answer; enhanced due diligence applied; enhanced ongoing monitoring applied; the regulation 28 (and 29) measures also applied
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 33(1) the relevant person has applied the enhanced measures in addition to the regulation 28 measures` NOTHING TRUE TRUE TRUE EQUALS NOTHING

§ `Regulation 33(2) -- the exception for branches and subsidiaries of third-country entities`

-- arguments: the customer is a branch or subsidiary of a third-country entity; (a)(i); (a)(ii); (b); (c)
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the customer is not such a branch or subsidiary: the exception says "when the customer is" one, so nothing
-- "when the customer is a branch or majority owned subsidiary" is not met: no ("when" counts as "where", ruling of 2026-11-05)
#ASSERT `reg 33(2) paragraph (1)(b) does not apply` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Regulation 33(3A) and (4) -- what the measures must include`

-- generated tests for the entries of reg 33(3A) (expected wording read from the raw text by line number)
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(a) obtaining additional information on the customer and on the customer's` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(a) obtaining additional information on the customer and on the customer's` EQUALS JUST "obtaining additional information on the customer and on the customer’s beneficial owner"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(b) obtaining additional information on the intended nature of the business` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(b) obtaining additional information on the intended nature of the business` EQUALS JUST "obtaining additional information on the intended nature of the business relationship"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(c) obtaining information on the source of funds and source of wealth` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(c) obtaining information on the source of funds and source of wealth` EQUALS JUST "obtaining information on the source of funds and source of wealth of the customer and of the customer’s beneficial owner"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(d) obtaining information on the reasons for the transactions` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(d) obtaining information on the reasons for the transactions` EQUALS JUST "obtaining information on the reasons for the transactions"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(e) obtaining the approval of senior management for establishing` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(e) obtaining the approval of senior management for establishing` EQUALS JUST "obtaining the approval of senior management for establishing or continuing the business relationship"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A)(f) conducting enhanced monitoring of the business relationship` EQUALS JUST TRUE
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A)(f) conducting enhanced monitoring of the business relationship` EQUALS JUST "conducting enhanced monitoring of the business relationship by increasing the number and timing of controls applied, and selecting patterns of transactions that need further examination"
#ASSERT `reg 33(3A) the measure must be included` `reg 33(3A) another measure` EQUALS NOTHING
#ASSERT `reg 33(3A) the wording of the entry` `reg 33(3A) another measure` EQUALS NOTHING

-- every one of the six measures taken: yes; one missing: no (the paragraph says "must include"); not for paragraph (1)(b): nothing; extra measures do not matter
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` TRUE (`reg 33(3A) the entries listed`) EQUALS JUST TRUE
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` TRUE (`reg 33(3A) another measure` FOLLOWED BY `reg 33(3A) the entries listed`) EQUALS JUST TRUE
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` TRUE (drop 1 (`reg 33(3A) the entries listed`)) EQUALS JUST FALSE
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` TRUE (take 5 (`reg 33(3A) the entries listed`)) EQUALS JUST FALSE
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` TRUE EMPTY EQUALS JUST FALSE
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` FALSE (`reg 33(3A) the entries listed`) EQUALS NOTHING
#ASSERT `reg 33(3A) the enhanced measures taken include every measure that the paragraph requires` FALSE EMPTY EQUALS NOTHING

-- generated tests for the entries of reg 33(4) (expected wording read from the raw text by line number)
#ASSERT `reg 33(4) the measure must be included` `reg 33(4)(a) as far as reasonably possible, examining the background and purpose` EQUALS JUST TRUE
#ASSERT `reg 33(4) the wording of the entry` `reg 33(4)(a) as far as reasonably possible, examining the background and purpose` EQUALS JUST "as far as reasonably possible, examining the background and purpose of the transaction"
#ASSERT `reg 33(4) the measure must be included` `reg 33(4)(b) increasing the degree and nature of monitoring of the business` EQUALS JUST TRUE
#ASSERT `reg 33(4) the wording of the entry` `reg 33(4)(b) increasing the degree and nature of monitoring of the business` EQUALS JUST "increasing the degree and nature of monitoring of the business relationship in which the transaction is made to determine whether that transaction or that relationship appear to be suspicious"
#ASSERT `reg 33(4) the measure must be included` `reg 33(4) another measure` EQUALS NOTHING
#ASSERT `reg 33(4) the wording of the entry` `reg 33(4) another measure` EQUALS NOTHING

#ASSERT `reg 33(4) the enhanced measures taken include every measure that the paragraph requires` TRUE (`reg 33(4) the entries listed`) EQUALS JUST TRUE
#ASSERT `reg 33(4) the enhanced measures taken include every measure that the paragraph requires` TRUE (drop 1 (`reg 33(4) the entries listed`)) EQUALS JUST FALSE
#ASSERT `reg 33(4) the enhanced measures taken include every measure that the paragraph requires` TRUE (take 1 (`reg 33(4) the entries listed`)) EQUALS JUST FALSE
#ASSERT `reg 33(4) the enhanced measures taken include every measure that the paragraph requires` FALSE (`reg 33(4) the entries listed`) EQUALS NOTHING

§ `Regulation 33(4A), (4B), (5), (6), (7)`

#ASSERT `reg 33(4A) the relevant person must consider the nature and identity of the beneficiary of the policy` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 33(4A) the relevant person must consider the nature and identity of the beneficiary of the policy` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 33(4A) the relevant person must consider the nature and identity of the beneficiary of the policy` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `reg 33(4A) the relevant person must consider the nature and identity of the beneficiary of the policy` NOTHING TRUE EQUALS NOTHING

-- (4B): the beneficiary is a legal person or arrangement AND presents a high risk
#ASSERT `reg 33(4B) the relevant person must take reasonable measures to identify and verify the identity of the beneficial owner of the beneficiary` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 33(4B) the relevant person must take reasonable measures to identify and verify the identity of the beneficial owner of the beneficiary` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 33(4B) the relevant person must take reasonable measures to identify and verify the identity of the beneficial owner of the beneficiary` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 33(4B) the relevant person must take reasonable measures to identify and verify the identity of the beneficial owner of the beneficiary` (JUST FALSE) TRUE TRUE EQUALS NOTHING
