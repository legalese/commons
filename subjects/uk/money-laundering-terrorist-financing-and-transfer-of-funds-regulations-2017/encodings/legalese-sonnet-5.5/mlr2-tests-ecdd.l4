#ASSERT `reg 34(4)(c) the meaning of the term is given by` `reg 34(4)(c) third-country financial conglomerate` EQUALS "regulation 7(1) of the Financial Conglomerates and Other Financial Groups Regulations 2004"

§ `Regulation 35`

-- (1)
#ASSERT `reg 35(1) the relevant person must have in place appropriate risk-management systems and procedures` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 35(1) the relevant person must have in place appropriate risk-management systems and procedures` (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 35(1) the relevant person must have in place appropriate risk-management systems and procedures` NOTHING EQUALS NOTHING

-- generated tests for the entries of reg 35(2) (expected wording read from the raw text by line number)
#ASSERT `reg 35(2) the relevant person must take the matter into account` `reg 35(2)(a) the risk assessment it carried out under regulation 18(1)` EQUALS JUST TRUE
#ASSERT `reg 35(2) the wording of the entry` `reg 35(2)(a) the risk assessment it carried out under regulation 18(1)` EQUALS JUST "the risk assessment it carried out under regulation 18(1)"
#ASSERT `reg 35(2) the relevant person must take the matter into account` `reg 35(2)(b) the level of risk of money laundering and terrorist financing inherent` EQUALS JUST TRUE
#ASSERT `reg 35(2) the wording of the entry` `reg 35(2)(b) the level of risk of money laundering and terrorist financing inherent` EQUALS JUST "the level of risk of money laundering and terrorist financing inherent in its business"
#ASSERT `reg 35(2) the relevant person must take the matter into account` `reg 35(2)(c) the extent to which that risk would be increased by its business` EQUALS JUST TRUE
#ASSERT `reg 35(2) the wording of the entry` `reg 35(2)(c) the extent to which that risk would be increased by its business` EQUALS JUST "the extent to which that risk would be increased by its business relationship or transactions with a PEP, or a family member or known close associate of a PEP"
#ASSERT `reg 35(2) the relevant person must take the matter into account` `reg 35(2)(d) any relevant information made available to the relevant person under` EQUALS JUST TRUE
#ASSERT `reg 35(2) the wording of the entry` `reg 35(2)(d) any relevant information made available to the relevant person under` EQUALS JUST "any relevant information made available to the relevant person under regulations 17(9) and 47"
#ASSERT `reg 35(2) the relevant person must take the matter into account` `reg 35(2) another matter` EQUALS NOTHING
#ASSERT `reg 35(2) the wording of the entry` `reg 35(2) another matter` EQUALS NOTHING

