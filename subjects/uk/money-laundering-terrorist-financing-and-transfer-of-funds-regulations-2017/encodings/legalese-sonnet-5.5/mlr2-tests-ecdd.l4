#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` NOTHING NOTHING EQUALS NOTHING
#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` (JUST (Date 1 3 2021)) NOTHING EQUALS NOTHING
#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` NOTHING (JUST (Date 10 3 2021)) EQUALS JUST FALSE
#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` (JUST (Date 9 3 2021)) (JUST (Date 10 3 2021)) EQUALS JUST TRUE
#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` (JUST (Date 10 3 2021)) (JUST (Date 10 3 2021)) EQUALS JUST FALSE
#ASSERT `reg 33(4B) the measures were taken before any payment was made under the policy` (JUST (Date 11 3 2021)) (JUST (Date 10 3 2021)) EQUALS JUST FALSE

-- generated tests for the entries of reg 33(5) (expected wording read from the raw text by line number)
#ASSERT `reg 33(5) the measure may be included` `reg 33(5)(a) seeking additional independent, reliable sources to verify information` EQUALS JUST TRUE
#ASSERT `reg 33(5) the wording of the entry` `reg 33(5)(a) seeking additional independent, reliable sources to verify information` EQUALS JUST "seeking additional independent, reliable sources to verify information provided or made available to the relevant person"
#ASSERT `reg 33(5) the measure may be included` `reg 33(5)(b) taking additional measures to understand better the background` EQUALS JUST TRUE
#ASSERT `reg 33(5) the wording of the entry` `reg 33(5)(b) taking additional measures to understand better the background` EQUALS JUST "taking additional measures to understand better the background, ownership and financial situation of the customer, and other parties to the transaction"
