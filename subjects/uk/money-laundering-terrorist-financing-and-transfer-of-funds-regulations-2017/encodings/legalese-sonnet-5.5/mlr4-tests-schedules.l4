IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr4-schedules`


-- TESTS for mlr4-schedules (Schedules 1, 2, 3 and 3AZA).  Every expected value was decided by
-- reading the Schedule (the words are quoted beside the assertion), not by running the code.

§ `Tests -- Schedules`

§§ `Schedule 1`

#ASSERT `sch 1 the body is a professional body listed in Schedule 1` (`a professional body listed in Schedule 1` `Law Society`) EQUALS JUST TRUE
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` (`a professional body listed in Schedule 1` `Association of Accounting Technicians`) EQUALS JUST TRUE -- the first row
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` (`a professional body listed in Schedule 1` `Law Society of Scotland`) EQUALS JUST TRUE -- the last row
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` (`a professional body listed in Schedule 1` `Faculty of Advocates`) EQUALS JUST TRUE
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` `the Treasury` EQUALS JUST FALSE -- not a professional body listed in the Schedule
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` `the Financial Conduct Authority` EQUALS JUST FALSE
#ASSERT `sch 1 the body is a professional body listed in Schedule 1` `a local weights and measures authority` EQUALS JUST FALSE

§§ `Schedule 2`

#ASSERT `sch 2 the activity is a listed activity` (JUST lending) EQUALS JUST TRUE
#ASSERT `sch 2 the activity is a listed activity` (JUST `issuing electronic money`) EQUALS JUST TRUE -- the last item
#ASSERT `sch 2 the activity is a listed activity` (JUST `money broking`) EQUALS JUST TRUE
#ASSERT `sch 2 the activity is a listed activity` (JUST `financial leasing`) EQUALS JUST TRUE -- item 2
#ASSERT `sch 2 the activity is a listed activity` (JUST `payment services`) EQUALS JUST TRUE -- item 3
#ASSERT `sch 2 the activity is a listed activity` (JUST `issuing and administering other means of payment`) EQUALS JUST TRUE -- item 4
#ASSERT `sch 2 the activity is a listed activity` (JUST `guarantees and commitments`) EQUALS JUST TRUE -- item 5
#ASSERT `sch 2 the activity is a listed activity` (JUST `trading for own account or for account of customers`) EQUALS JUST TRUE -- item 6
#ASSERT `sch 2 the activity is a listed activity` (JUST `participation in securities issues and related services`) EQUALS JUST TRUE -- item 7
#ASSERT `sch 2 the activity is a listed activity` (JUST `advice to undertakings on capital structure, industrial strategy and mergers`) EQUALS JUST TRUE -- item 8
#ASSERT `sch 2 the activity is a listed activity` (JUST `portfolio management and advice`) EQUALS JUST TRUE -- item 10
#ASSERT `sch 2 the activity is a listed activity` (JUST `safekeeping and administration of securities`) EQUALS JUST TRUE -- item 11
#ASSERT `sch 2 the activity is a listed activity` (JUST `safe custody services`) EQUALS JUST TRUE -- item 12
#ASSERT `sch 2 the activity is a listed activity` NOTHING EQUALS JUST FALSE -- "The activities ... are—" closes the list
#ASSERT `sch 2 item 1 the kind of credit is within lending` TRUE EQUALS JUST TRUE
#ASSERT `sch 2 item 1 the kind of credit is within lending` FALSE EQUALS NOTHING -- "inter alia"
#ASSERT `sch 2 item 3 the service is within payment services` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 2 item 3 the service is within payment services` TRUE TRUE EQUALS JUST FALSE -- "other than an account information service"
#ASSERT `sch 2 item 3 the service is within payment services` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6(a) money market instruments (cheques, bills, certificates of deposit, etc.)` EQUALS JUST TRUE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6(b) foreign exchange` EQUALS JUST TRUE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6(c) financial futures and options` EQUALS JUST TRUE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6(d) exchange and interest-rate instruments` EQUALS JUST TRUE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6(e) transferable securities` EQUALS JUST TRUE
#ASSERT `sch 2 item 6 the trading is within the item` TRUE `sch 2 item 6 some other instrument` EQUALS NOTHING
#ASSERT `sch 2 item 6 the trading is within the item` FALSE `sch 2 item 6(a) money market instruments (cheques, bills, certificates of deposit, etc.)` EQUALS NOTHING

§§ `Schedule 3`

-- Paragraph 36.  Arguments: an offence abroad; the paragraph (1 to 36) it would have fallen under; in a part of the UK; by a person linked to a part; as regards the UK.
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 1 TRUE FALSE FALSE EQUALS JUST TRUE -- paragraph 1, in a part of the United Kingdom
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 34 FALSE TRUE FALSE EQUALS JUST TRUE -- paragraph 34, by a linked person
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 34 FALSE FALSE TRUE EQUALS JUST TRUE -- paragraph 34, as regards the United Kingdom
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 35 TRUE TRUE TRUE EQUALS NOTHING -- "paragraphs 1 to 34" does not reach 35
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 36 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 0 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 3 para 36 the act is a relevant offence` TRUE 5 FALSE FALSE FALSE EQUALS NOTHING -- would not have been an offence in any of the three settings
#ASSERT `sch 3 para 36 the act is a relevant offence` FALSE 5 TRUE TRUE TRUE EQUALS NOTHING -- not an offence abroad
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 1 an offence under the Perjury Act 1911` NOTHING EQUALS JUST TRUE -- the Perjury Act 1911
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 17 an offence under the Terrorism Act 2000` NOTHING EQUALS JUST TRUE -- the Terrorism Act 2000
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 31 any offence which has deception or dishonesty as one of its components` NOTHING EQUALS JUST TRUE -- deception or dishonesty
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 34 an offence under section 44 of the Serious Crime Act 2007` NOTHING EQUALS JUST TRUE
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 35 an offence of aiding, abetting, counselling or procuring the commission of an offence specified in this Schedule` NOTHING EQUALS JUST TRUE -- aiding and abetting
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 36 an act done outside the United Kingdom that is an offence abroad` (JUST TRUE) EQUALS JUST TRUE -- an act done abroad that meets paragraph 36
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 para 36 an act done outside the United Kingdom that is an offence abroad` NOTHING EQUALS NOTHING -- an act abroad that does not
#ASSERT `sch 3 the offence is a relevant offence` `sch 3 none of these paragraphs` NOTHING EQUALS NOTHING -- the Schedule does not say others are not relevant offences

§§ `Schedule 3AZA`

-- Paragraph 1.  Arguments: a beneficial owner; a person of significant control; a registrable beneficial owner.
#ASSERT `sch 3AZA para 1 a material discrepancy may arise in relation to the information` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 3AZA para 1 a material discrepancy may arise in relation to the information` NOTHING TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 3AZA para 1 a material discrepancy may arise in relation to the information` NOTHING FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 3AZA para 1 a material discrepancy may arise in relation to the information` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `sch 3AZA para 1 a material discrepancy may arise in relation to the information` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `sch 3AZA para 2 the discrepancy satisfies the condition` TRUE FALSE EQUALS JUST TRUE -- linked to money laundering or terrorist financing
#ASSERT `sch 3AZA para 2 the discrepancy satisfies the condition` FALSE TRUE EQUALS JUST TRUE -- conceals details of the business of the customer
#ASSERT `sch 3AZA para 2 the discrepancy satisfies the condition` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(a) a difference in name` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(b) an incorrect entry for nature of control` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(c) an incorrect entry for date of birth` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(d) an incorrect entry for nationality` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(e) an incorrect entry for correspondence address` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(f) a missing entry for a person of significant control or a registrable beneficial owner` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3(g) an incorrect entry for the date the individual became a registrable person` EQUALS JUST TRUE
#ASSERT `sch 3AZA para 3 the discrepancy is in a form listed in paragraph 3` `sch 3AZA para 3 some other form` EQUALS JUST FALSE
-- The whole.  Arguments: paragraph 1; paragraph 2; paragraph 3.
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- the condition is met, whatever the form
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING -- a listed form that fails the condition: "including" leaves it open
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST TRUE) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING -- not about the information the paragraph names
#ASSERT `sch 3AZA the discrepancy is a material discrepancy` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING

