§ `reg 18(5): the notification that no record is required (src:495)`
#ASSERT `reg 18(5) the supervisory authority may give the notification referred to in paragraph (4)` TRUE EQUALS JUST TRUE
#ASSERT `reg 18(5) the supervisory authority may give the notification referred to in paragraph (4)` FALSE EQUALS JUST FALSE

§ `reg 19(4)(e) and reg 19A(4)(d): the agent question, seam S-4 (src:538-540, 568-570)`
#ASSERT `reg 19(4)(e)(i) the agent would satisfy the fit and proper test provided for in regulation 58` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 19(4)(e)(i) the agent would satisfy the fit and proper test provided for in regulation 58` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 19(4)(e)(i) the agent would satisfy the fit and proper test provided for in regulation 58` NOTHING EQUALS NOTHING
#ASSERT `reg 19A(4)(d)(i) the agent would satisfy the fit and proper test provided for in regulation 58` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 19A(4)(d)(i) the agent would satisfy the fit and proper test provided for in regulation 58` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 19A(4)(d)(i) the agent would satisfy the fit and proper test provided for in regulation 58` NOTHING EQUALS NOTHING

§ `reg 19(5): guidance (src:541-543)`
-- arguments: issued by the FCA; issued by another supervisory authority or appropriate body; approved by the Treasury
#ASSERT `reg 19(5) the relevant person may take the guidance into account` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 19(5) the relevant person may take the guidance into account` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 19(5) the relevant person may take the guidance into account` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 19(5) the relevant person may take the guidance into account` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `reg 19(5) the relevant person may take the guidance into account` FALSE FALSE FALSE EQUALS NOTHING

§ `reg 20(6): technical standards (src:590-592)`
-- arguments: specify the additional measures required under paragraph (4); specify the minimum action where paragraph (4) applies
#ASSERT `reg 20(6) the FCA may make the technical standards` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 20(6) the FCA may make the technical standards` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 20(6) the FCA may make the technical standards` FALSE FALSE EQUALS NOTHING
