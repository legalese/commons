IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr1-reg08-09-application`
IMPORT `mlr1-reg28-cdd-measures`

-- TESTS for regulation 28.  Expected values are written from the text (the line named in each heading).  Inputs are positional, in the
-- order of the function's GIVEN.  For the "must" functions the first input is the answer of paragraph (1) and each later input is,
-- in turn, a seam answer, a condition of the case ("where") or an exception ("unless").

§ `reg 28(1): this regulation applies (src:806)`
#ASSERT `reg 28(1) this regulation applies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(1) this regulation applies` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(1) this regulation applies` NOTHING EQUALS NOTHING

§ `reg 28(2): identify, verify, assess (src:807-810)`
#ASSERT `reg 28(2)(a) the relevant person must identify the customer` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 28(2)(a) the relevant person must identify the customer` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(2)(a) the relevant person must identify the customer` NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 28(2)(a) the relevant person must identify the customer` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `reg 28(2)(b) the relevant person must verify the customer's identity` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 28(2)(b) the relevant person must verify the customer's identity` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(2)(b) the relevant person must verify the customer's identity` NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 28(2)(b) the relevant person must verify the customer's identity` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `reg 28(2)(c) the relevant person must assess the purpose and intended nature of the business relationship or occasional transaction` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(2)(c) the relevant person must assess the purpose and intended nature of the business relationship or occasional transaction` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(2)(c) the relevant person must assess the purpose and intended nature of the business relationship or occasional transaction` NOTHING EQUALS NOTHING

§ `reg 28(3): bodies corporate (src:811-818)`
#ASSERT `reg 28(3)(a) the relevant person must obtain and verify the particulars of the body corporate` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(3)(a) the relevant person must obtain and verify the particulars of the body corporate` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 28(3)(a) the relevant person must obtain and verify the particulars of the body corporate` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 28(3)(a) the relevant person must obtain and verify the particulars of the body corporate` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(3)(a) the relevant person must obtain and verify the particulars of the body corporate` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT sum (map (GIVEN s YIELD 1) (`reg 28(3)(a) the particulars the relevant person must obtain and verify`)) EQUALS 3
#ASSERT elem "the name of the body corporate" (`reg 28(3)(a) the particulars the relevant person must obtain and verify`) EQUALS TRUE
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` NOTHING (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 28(3)(b) the relevant person must take reasonable measures to determine and verify the law, constitution and management of the body corporate` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT sum (map (GIVEN s YIELD 1) (`reg 28(3)(b) the matters the relevant person must take reasonable measures to determine and verify`)) EQUALS 2

§ `reg 28(3A): legal persons, trusts and similar arrangements (src:819)`
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a company` EQUALS JUST TRUE
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a trust` EQUALS JUST TRUE
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a foundation or other legal arrangement similar to a trust` EQUALS JUST TRUE
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `an individual` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a limited liability partnership` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a body corporate of another kind` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a corporation sole` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `a partnership other than a limited liability partnership` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `an unincorporated association` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `the estate of a deceased person in the course of administration` EQUALS NOTHING
#ASSERT `reg 28(3A) the form of customer is a legal person, trust, company, foundation or similar legal arrangement` `another legal entity or legal arrangement` EQUALS NOTHING
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` NOTHING (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `reg 28(3A) the relevant person must take reasonable measures to understand the ownership and control structure of the customer` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST FALSE

§ `reg 28(4) and (5): beneficial owners (src:820-824)`
#ASSERT `reg 28(4) the relevant person must identify the beneficial owner and take reasonable measures to verify the beneficial owner's identity` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 28(4) the relevant person must identify the beneficial owner and take reasonable measures to verify the beneficial owner's identity` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(4) the relevant person must identify the beneficial owner and take reasonable measures to verify the beneficial owner's identity` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `reg 28(4) the relevant person must identify the beneficial owner and take reasonable measures to verify the beneficial owner's identity` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(4) the relevant person must identify the beneficial owner and take reasonable measures to verify the beneficial owner's identity` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(4)(c) the relevant person must take reasonable measures to understand the ownership and control structure of the beneficial owner` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(5) paragraphs (3)(b), (3A) and (4) do not apply to the customer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(5) paragraphs (3)(b), (3A) and (4) do not apply to the customer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(5) paragraphs (3)(b), (3A) and (4) do not apply to the customer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(5) paragraphs (3)(b), (3A) and (4) do not apply to the customer` FALSE FALSE EQUALS JUST FALSE

§ `reg 28(6) to (8): the senior person as beneficial owner (src:825-833)`
-- (7) arguments: exhausted all possible means; has not succeeded; is not satisfied that the individual identified is the owner
#ASSERT `reg 28(7) this paragraph applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 28(7) this paragraph applies` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(7) this paragraph applies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(7) this paragraph applies` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(7) this paragraph applies` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(7) this paragraph applies` FALSE FALSE FALSE EQUALS JUST FALSE
-- (6) arguments: the answer of regulation 3(1) for a body corporate; the answer of paragraph (7)
#ASSERT `reg 28(6) the relevant person may treat the senior person responsible for managing the body corporate as its beneficial owner` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(6) the relevant person may treat the senior person responsible for managing the body corporate as its beneficial owner` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 28(6) the relevant person may treat the senior person responsible for managing the body corporate as its beneficial owner` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(6) the relevant person may treat the senior person responsible for managing the body corporate as its beneficial owner` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 28(6) the relevant person may treat the senior person responsible for managing the body corporate as its beneficial owner` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `reg 28(8) the relevant person must keep the records and verify the senior person's identity` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(8) the relevant person must keep the records and verify the senior person's identity` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(8) the relevant person must keep the records and verify the senior person's identity` NOTHING EQUALS NOTHING

§ `reg 28(9) and (9A): registrar information (src:834-841)`
#ASSERT `reg 28(9) the relevant person satisfies its requirements under paragraph (4)` TRUE EQUALS JUST FALSE
#ASSERT `reg 28(9) the relevant person satisfies its requirements under paragraph (4)` FALSE EQUALS NOTHING
#ASSERT `reg 28(9A) the individual is a registrable beneficial owner` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(9A) the individual is a registrable beneficial owner` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(9A) the individual is a registrable beneficial owner` NOTHING EQUALS NOTHING
#ASSERT `reg 28(9A) the person is a registrable person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(9A) the person is a registrable person` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(9A) the person is a registrable person` NOTHING EQUALS NOTHING
#ASSERT `reg 28(9A) the entity is a registrable relevant legal entity` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(9A) the entity is a registrable relevant legal entity` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 28(9A) the entity is a registrable relevant legal entity` NOTHING EQUALS NOTHING
#ASSERT `reg 28(9A) the registrar` `reg 28(9A) Part 1 of the Economic Crime (Transparency and Enforcement) Act 2022` EQUALS `reg 28(9A) the registrar of companies for England and Wales`
#ASSERT `reg 28(9A) the registrar` `reg 28(9A) any other enactment` EQUALS `reg 28(9A) the registrar referred to in section 1060(3) of the Companies Act 2006`

§ `reg 28(10) to (13): agents, monitoring, risk (src:842-857)`
#ASSERT `reg 28(10) the relevant person must verify A's authority, identify A and verify A's identity` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 28(10) the relevant person must verify A's authority, identify A and verify A's identity` (JUST FALSE) TRUE EQUALS JUST FALSE
