#ASSERT `reg 28(17) paragraph (16) does not apply to the relevant person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(17) paragraph (16) does not apply to the relevant person` FALSE FALSE EQUALS NOTHING
-- (18)(a) arguments: from a reliable source; independent of the person
#ASSERT `reg 28(18)(a) the identity is verified` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(18)(a) the identity is verified` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(18)(a) the identity is verified` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(18)(b) the documents are to be regarded as independent of the person` TRUE EQUALS JUST TRUE
#ASSERT `reg 28(18)(b) the documents are to be regarded as independent of the person` FALSE EQUALS NOTHING
#ASSERT `reg 28(19) the information may be regarded as obtained from a reliable source independent of the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(19) the information may be regarded as obtained from a reliable source independent of the person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(19) the information may be regarded as obtained from a reliable source independent of the person` FALSE TRUE EQUALS JUST FALSE
