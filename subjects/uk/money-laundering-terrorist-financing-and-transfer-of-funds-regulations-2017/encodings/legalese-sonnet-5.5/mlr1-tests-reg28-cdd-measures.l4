#ASSERT `reg 28(10) the relevant person must verify A's authority, identify A and verify A's identity` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT sum (map (GIVEN s YIELD 1) (`reg 28(10) the steps the relevant person must take in relation to A`)) EQUALS 3
#ASSERT `reg 28(11) the relevant person must conduct ongoing monitoring of a business relationship` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `reg 28(11) the relevant person must conduct ongoing monitoring of a business relationship` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `reg 28(11) the relevant person must conduct ongoing monitoring of a business relationship` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 28(11) the relevant person must conduct ongoing monitoring of a business relationship` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 28(11) the relevant person must conduct ongoing monitoring of a business relationship` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT sum (map (GIVEN s YIELD 1) (`reg 28(11) what ongoing monitoring includes`)) EQUALS 2
#ASSERT `reg 28(12)(a) the ways and extent of the measures reflect what sub-paragraph (a) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(12)(a) the ways and extent of the measures reflect what sub-paragraph (a) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(12)(a) the ways and extent of the measures reflect what sub-paragraph (a) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 28(12)(b) the ways and extent of the measures may differ from case to case` TRUE EQUALS JUST TRUE
#ASSERT `reg 28(12)(b) the ways and extent of the measures may differ from case to case` FALSE EQUALS NOTHING
#ASSERT `reg 28(13) the relevant person has taken account of what paragraph (13) requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(13) the relevant person has taken account of what paragraph (13) requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(13) the relevant person has taken account of what paragraph (13) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(13) the relevant person has taken account of what paragraph (13) requires` TRUE TRUE FALSE EQUALS JUST FALSE

§ `reg 28(14) to (19): discontinuing, demonstrating and verifying (src:858-876)`
-- (15) arguments: has taken measures; makes a disclosure; continuing would be an offence
#ASSERT `reg 28(15) this paragraph applies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 28(15) this paragraph applies` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(15) this paragraph applies` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 28(15) this paragraph applies` TRUE TRUE FALSE EQUALS JUST FALSE
