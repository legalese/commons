IMPORT prelude
IMPORT daydate
IMPORT `mlr-core`
IMPORT `mlr2-helpers`
IMPORT `mlr2-reliance-records`

-- TESTS for mlr2-reliance-records.l4 (regulations 39 to 41).  Every expected value is written by hand from the text beside the
-- assertion; none is copied from the encoding's own output.  Each line is one #ASSERT.

§ `Regulation 39(3) -- who may be relied on`

-- arguments: relevant person (S-7); carries on business in a third country; (c)(i) equivalent requirements; (c)(ii) supervised equivalently; (d) an organisation whose members are such persons
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- a third-country person needs the third country, (c)(i) and (c)(ii) together; regulation 39(1) hands "a person who falls within paragraph (3)" to this list, so a person in none of the heads is outside it (ruling of 2026-11-05, delegated definitions (a); fork F39-1)
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- none of (a), (c), (d): outside the delegated list, so no; and nothing where regulation 8 has not answered
#ASSERT `reg 39(3) the person falls within paragraph (3)` (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(3) the person falls within paragraph (3)` NOTHING FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Regulation 39(1), (2) -- reliance`

-- (1) arguments: relevant person; the third party falls within paragraph (3); the measure is one of regulation 28(2) to (6) and (10) or 30A
#ASSERT `reg 39(1) the relevant person may rely on the third party` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 39(1) the relevant person may rely on the third party` (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 39(1) the relevant person may rely on the third party` (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `reg 39(1) the relevant person may rely on the third party` (JUST TRUE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `reg 39(1) the relevant person may rely on the third party` (JUST FALSE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `reg 39(1) the relevant person remains liable for any failure to apply such measures` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 39(1) the relevant person remains liable for any failure to apply such measures` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `reg 39(1) the relevant person remains liable for any failure to apply such measures` NOTHING TRUE EQUALS NOTHING
-- (2): the duty exists only "when" the relevant person relies
#ASSERT `reg 39(2) the relevant person must obtain the information and enter into the arrangements` (JUST TRUE) TRUE EQUALS JUST TRUE
-- not relying: "When a relevant person relies on the third party" is not met, so no ("when" counts as "where", ruling of 2026-11-05)
#ASSERT `reg 39(2) the relevant person must obtain the information and enter into the arrangements` (JUST TRUE) FALSE EQUALS JUST FALSE
-- (2) compliance: relies; (a) obtained immediately; (b)(i) arrangements enable copies on request; (b)(ii) arrangements require retention
#ASSERT `reg 39(2) the relevant person has met the requirements` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 39(2) the relevant person has met the requirements` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 39(2) the relevant person has met the requirements` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 39(2) the relevant person has met the requirements` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(2) the relevant person has met the requirements` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Regulation 39(4) to (8)`

-- (5): the third party is a branch or majority owned subsidiary; (a)(i); (a)(ii); (b)(i); (b)(ii)
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- "all the following conditions": missing (a) or missing (b)
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not a branch or majority owned subsidiary: nothing
-- not a branch or majority owned subsidiary: the exception is not made and paragraph (4) stands (fork F39-4)
#ASSERT `reg 39(5) paragraph (4) does not apply to the third party` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (4): arguments: relevant person; established in a FATF call for action country; paragraph (5) disapplies
#ASSERT `reg 39(4) the relevant person may rely on the third party established in a FATF call for action country` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `reg 39(4) the relevant person may rely on the third party established in a FATF call for action country` (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `reg 39(4) the relevant person may rely on the third party established in a FATF call for action country` (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `reg 39(4) the relevant person may rely on the third party established in a FATF call for action country` (JUST TRUE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `reg 39(4) the relevant person may rely on the third party established in a FATF call for action country` (JUST FALSE) TRUE (JUST FALSE) EQUALS NOTHING
-- (6): same group; group applies measures; supervised by an EEA authority; supervised by an equivalent third-country authority
#ASSERT `reg 39(6) the relevant person is to be treated by a supervisory authority as having complied with the requirements of paragraph (2)` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 39(6) the relevant person is to be treated by a supervisory authority as having complied with the requirements of paragraph (2)` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 39(6) the relevant person is to be treated by a supervisory authority as having complied with the requirements of paragraph (2)` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(6) the relevant person is to be treated by a supervisory authority as having complied with the requirements of paragraph (2)` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 39(6) the relevant person is to be treated by a supervisory authority as having complied with the requirements of paragraph (2)` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (7): relevant person; applies by means of an agent or outsourcing provider; arrangements keep the relevant person liable
#ASSERT `reg 39(7) nothing in this regulation prevents the relevant person applying the measures by means of the agent or outsourcing service provider` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 39(7) nothing in this regulation prevents the relevant person applying the measures by means of the agent or outsourcing service provider` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 39(7) nothing in this regulation prevents the relevant person applying the measures by means of the agent or outsourcing service provider` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `reg 39(7) nothing in this regulation prevents the relevant person applying the measures by means of the agent or outsourcing service provider` (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- (8): performs a process that the relevant person would otherwise undertake; is not an employee
#ASSERT `reg 39(8) the person is an outsourcing service provider` TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 39(8) the person is an outsourcing service provider` TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 39(8) the person is an outsourcing service provider` FALSE FALSE EQUALS JUST FALSE

§ `Regulation 40 -- Record-keeping`

-- (2): arguments: relevant person; the record; inter-cryptoasset business transfer; unhosted wallet transfer; the regulation 64C/64D/64G fact (S-14)
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(a) a copy of documents and information obtained to satisfy the customer due diligence requirements` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(b) sufficient supporting records in respect of a transaction` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(c) documents and information received in an inter-cryptoasset business transfer` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(c) documents and information received in an inter-cryptoasset business transfer` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(c) documents and information received in an inter-cryptoasset business transfer` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(d) documents and information received in an unhosted wallet transfer` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(d) documents and information received in an unhosted wallet transfer` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2)(d) documents and information received in an unhosted wallet transfer` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST TRUE) `reg 40(2) another record` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 40(2) the record is one that the relevant person must keep` (JUST FALSE) `reg 40(2)(a) a copy of documents and information obtained to satisfy the customer due diligence requirements` FALSE FALSE FALSE EQUALS NOTHING
-- (3): five years beginning on 10 March 2020 end on 9 March 2025
#ASSERT `reg 40(3) the last day of the period of five years` (Date 10 3 2020) EQUALS Date 9 3 2025
#ASSERT `reg 40(3) the last day of the period of five years` (Date 1 1 2021) EQUALS Date 31 12 2025
-- (1) asked on a day: arguments: relevant person; the day the period begins (MAYBE); the date asked
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST TRUE) (JUST (Date 10 3 2020)) (Date 10 3 2020) EQUALS JUST TRUE
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST TRUE) (JUST (Date 10 3 2020)) (Date 9 3 2025) EQUALS JUST TRUE
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST TRUE) (JUST (Date 10 3 2020)) (Date 10 3 2025) EQUALS JUST FALSE
-- a day before the period begins is outside the period (ruling of 2026-11-05 (a))
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST TRUE) (JUST (Date 10 3 2020)) (Date 9 3 2020) EQUALS JUST FALSE
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST TRUE) NOTHING (Date 10 3 2020) EQUALS NOTHING
#ASSERT `reg 40(1) the relevant person must still keep the records on the date asked` (JUST FALSE) (JUST (Date 10 3 2020)) (Date 10 3 2020) EQUALS NOTHING
-- (4): the ten-year ceiling applies to the (3)(b)(i) records only
#ASSERT `reg 40(4) the relevant person is required to keep the record` `reg 40(3)(b)(i) a record relating to a transaction which occurs as part of a business relationship` (Date 10 3 2020) (Date 10 3 2030) EQUALS JUST FALSE
#ASSERT `reg 40(4) the relevant person is required to keep the record` `reg 40(3)(b)(i) a record relating to a transaction which occurs as part of a business relationship` (Date 10 3 2020) (Date 9 3 2030) EQUALS NOTHING
#ASSERT `reg 40(4) the relevant person is required to keep the record` `reg 40(3)(b)(ii) a record relating to customer due diligence measures taken in connection with a business relationship` (Date 10 3 2020) (Date 10 3 2035) EQUALS NOTHING
#ASSERT `reg 40(4) the relevant person is required to keep the record` `reg 40(3)(a) a record relating to an occasional transaction` (Date 10 3 2020) (Date 10 3 2035) EQUALS NOTHING
-- (5): arguments: relevant person; the period has expired; required by an enactment; required for court proceedings; the data subject consents; reasonable grounds for legal proceedings
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- the period has not expired: "Once ..." is read as "where" and is not met, so no (assumed, not ruled)
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 40(5) the relevant person must delete the personal data obtained for the purposes of these Regulations` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (6)
#ASSERT `reg 40(6) the relevant person who is relied on must keep the records specified in paragraph (2)` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `reg 40(6) the relevant person who is relied on must keep the records specified in paragraph (2)` (JUST TRUE) FALSE EQUALS NOTHING
-- (7) and (8): A within regulation 39(3); A is relied on; B's request on; the last day of the period; B uses an agent or outsourcing provider
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) TRUE (JUST (Date 1 6 2021)) (Date 9 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) TRUE (JUST (Date 9 3 2025)) (Date 9 3 2025) FALSE EQUALS JUST TRUE
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) TRUE (JUST (Date 10 3 2025)) (Date 9 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) TRUE NOTHING (Date 9 3 2025) FALSE EQUALS JUST FALSE
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) TRUE (JUST (Date 1 6 2021)) (Date 9 3 2025) TRUE EQUALS JUST FALSE
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST FALSE) TRUE (JUST (Date 1 6 2021)) (Date 9 3 2025) FALSE EQUALS NOTHING
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` NOTHING TRUE (JUST (Date 1 6 2021)) (Date 9 3 2025) FALSE EQUALS NOTHING
#ASSERT `reg 40(7) the person relied on must make the information available and forward copies of the data and documents to the relevant person` (JUST TRUE) FALSE (JUST (Date 1 6 2021)) (Date 9 3 2025) FALSE EQUALS NOTHING
-- (9)
#ASSERT `reg 40(9)(a) B relies on A` TRUE EQUALS JUST TRUE
#ASSERT `reg 40(9)(a) B relies on A` FALSE EQUALS JUST FALSE
#ASSERT `reg 40(9)(b) the thing is a copy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 40(9)(b) the thing is a copy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 40(9)(b) the thing is a copy` FALSE TRUE EQUALS JUST FALSE
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(c) data subject` EQUALS "section 3 of the Data Protection Act 2018"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(d) personal data` EQUALS "section 3(2) and (14) of the Data Protection Act 2018, for the purposes of Parts 5 to 7 of that Act"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(e) beneficiary` EQUALS "regulation 64B"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(e) cryptoasset business` EQUALS "regulation 64B"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(e) inter-cryptoasset business transfer` EQUALS "regulation 64B"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(e) intermediary cryptoasset business` EQUALS "regulation 64B"
#ASSERT `reg 40(9) the meaning of the term is given by` `reg 40(9)(e) unhosted wallet transfer` EQUALS "regulation 64B"

§ `Regulation 41 -- Data protection`

-- (1): arguments: obtained by a relevant person for the purposes of the Regulations; the purpose
#ASSERT `reg 41(1) the personal data may be processed for the purpose` TRUE `reg 41(1) preventing money laundering` EQUALS JUST TRUE
#ASSERT `reg 41(1) the personal data may be processed for the purpose` TRUE `reg 41(1) preventing terrorist financing` EQUALS JUST TRUE
#ASSERT `reg 41(1) the personal data may be processed for the purpose` TRUE `reg 41(1) preventing proliferation financing` EQUALS JUST TRUE
#ASSERT `reg 41(1) the personal data may be processed for the purpose` TRUE `reg 41(1) another purpose` EQUALS JUST FALSE
#ASSERT `reg 41(1) the personal data may be processed for the purpose` FALSE `reg 41(1) another purpose` EQUALS NOTHING
-- (3): personal data referred to in (1); permitted by another enactment; consent
#ASSERT `reg 41(3) another use of the personal data may be made` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 41(3) another use of the personal data may be made` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `reg 41(3) another use of the personal data may be made` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `reg 41(3) another use of the personal data may be made` FALSE FALSE FALSE EQUALS NOTHING
-- (6): arguments: relevant person; a new customer; the statement says it; the date the statement was given; the date the relationship was established or the transaction entered into
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) TRUE TRUE (JUST (Date 1 5 2021)) (Date 2 5 2021) EQUALS JUST TRUE
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) TRUE TRUE (JUST (Date 2 5 2021)) (Date 2 5 2021) EQUALS JUST FALSE
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) TRUE TRUE (JUST (Date 3 5 2021)) (Date 2 5 2021) EQUALS JUST FALSE
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) TRUE TRUE NOTHING (Date 2 5 2021) EQUALS JUST FALSE
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) TRUE FALSE (JUST (Date 1 5 2021)) (Date 2 5 2021) EQUALS JUST FALSE
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST TRUE) FALSE TRUE (JUST (Date 1 5 2021)) (Date 2 5 2021) EQUALS NOTHING
#ASSERT `reg 41(6) the relevant person has provided the customer with the statement before establishing the business relationship or entering into the occasional transaction` (JUST FALSE) TRUE TRUE (JUST (Date 1 5 2021)) (Date 2 5 2021) EQUALS NOTHING
-- (7)
#ASSERT `reg 41(7) the processing is processing necessary for the performance of a task carried out in the public interest, within point (e) of Article 6(1) of the UK GDPR` TRUE EQUALS JUST TRUE
#ASSERT `reg 41(7) the processing is processing necessary for the performance of a task carried out in the public interest, within point (e) of Article 6(1) of the UK GDPR` FALSE EQUALS NOTHING
-- (8)
#ASSERT `reg 41(8) the provision about when sensitive processing meets a requirement of Article 9(2) or 10 of the UK GDPR is made by` EQUALS "section 10 of, and Schedule 1 to, the Data Protection Act 2018"
-- (9)
#ASSERT `reg 41(9) the processing is sensitive processing` TRUE EQUALS JUST TRUE
#ASSERT `reg 41(9) the processing is sensitive processing` FALSE EQUALS JUST FALSE
#ASSERT `reg 41(9) the meaning of the term is given by` `reg 41(9) data subject` EQUALS "section 3 of the Data Protection Act 2018"
#ASSERT `reg 41(9) the meaning of the term is given by` `reg 41(9) personal data` EQUALS "section 3(2) and (14) of the Data Protection Act 2018, for the purposes of Parts 5 to 7 of that Act"
#ASSERT `reg 41(9) the meaning of the term is given by` `reg 41(9) processing` EQUALS "section 3(4) of the Data Protection Act 2018, for the purposes of Parts 5 to 7 of that Act"
