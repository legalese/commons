IMPORT prelude
IMPORT daydate
IMPORT `lta-types`
IMPORT `lta-repair`
IMPORT `lta-service-charges`
IMPORT `lta-information`
IMPORT `lta-goal`

-- Landlord and Tenant Act 1985 (UK) — the encoder's tests. Expected values
-- are worked by hand from the Act.

§ `Tests`

hffha MEANS Date 20 3 2019

GIVEN country IS A `Country`, g IS A DATE, e IS A DATE, special IS A `Special tenancy`, ex IS A `Section 14 exception`
GIVETH A `Lease`
`a lease in` country `granted` g `ending` e `, kind` special `, exception` ex MEANS
    `Lease` OF country, TRUE, g, e, FALSE, FALSE, FALSE, special, ex, FALSE, FALSE, FALSE, FALSE, FALSE, hffha

GIVEN g IS A DATE, e IS A DATE
GIVETH A `Lease`
`an English lease granted` g `ending` e MEANS
    `a lease in` `England` `granted` g `ending` e `, kind` `an ordinary lease` `, exception` `no exception`

-- Fields: country, dwelling, granted, ends, periodic, determinable, renewal,
-- special, exception, Welsh, prior agreement, existing periodic, arose on
-- expiry, renewed, commencement.
GIVEN periodic IS A BOOLEAN, determinable IS A BOOLEAN, renewal IS A BOOLEAN, welsh IS A BOOLEAN
GIVETH A `Lease`
`a 2020-2030 lease, periodic` periodic `, determinable` determinable `, renewal` renewal `, Welsh occupation` welsh MEANS
    `Lease` OF `England`, TRUE, Date 1 1 2020, Date 31 12 2029, periodic, determinable, renewal, `an ordinary lease`, `no exception`, welsh, FALSE, FALSE, FALSE, FALSE, hffha

§§ `Goal 1 — repair and fitness`

-- Seven years beginning 1 January 2020 end 31 December 2026.
#ASSERT `section 11 applies to` (`an English lease granted` (Date 1 1 2020) `ending` (Date 30 12 2026))
#ASSERT NOT (`section 11 applies to` (`an English lease granted` (Date 1 1 2020) `ending` (Date 31 12 2026)))
-- s 13(2)(b)-(c), and periodic tenancies.
#ASSERT `section 11 applies to` (`a 2020-2030 lease, periodic` FALSE `, determinable` TRUE `, renewal` FALSE `, Welsh occupation` FALSE)
#ASSERT `section 11 applies to` (`a 2020-2030 lease, periodic` TRUE `, determinable` FALSE `, renewal` FALSE `, Welsh occupation` FALSE)
#ASSERT NOT (`section 11 applies to` (`a 2020-2030 lease, periodic` FALSE `, determinable` FALSE `, renewal` FALSE `, Welsh occupation` FALSE))
#ASSERT NOT (`section 11 applies to` (`Lease` OF `England`, TRUE, Date 1 1 2020, Date 31 12 2024, FALSE, FALSE, TRUE, `an ordinary lease`, `no exception`, FALSE, FALSE, FALSE, FALSE, FALSE, hffha))
-- s 13(1ZA)
#ASSERT NOT (`section 11 applies to` (`a 2020-2030 lease, periodic` TRUE `, determinable` FALSE `, renewal` FALSE `, Welsh occupation` TRUE))
-- Granted before 24 October 1961.
#ASSERT NOT (`section 11 applies to` (`an English lease granted` (Date 23 10 1961) `ending` (Date 22 10 1963)))
#ASSERT `section 11 applies to` (`an English lease granted` (Date 24 10 1961) `ending` (Date 23 10 1963))
-- s 13(1A): a long secure tenancy in England, not in Wales.
#ASSERT `section 11 applies to` (`a lease in` `England` `granted` (Date 1 1 2020) `ending` (Date 31 12 2029) `, kind` `a long secure tenancy under s 13(1A)` `, exception` `no exception`)
#ASSERT NOT (`section 11 applies to` (`a lease in` `Wales` `granted` (Date 1 1 2020) `ending` (Date 31 12 2029) `, kind` `a long secure tenancy under s 13(1A)` `, exception` `no exception`))
-- s 13(1ZC); s 14.
#ASSERT NOT (`section 11 applies to` (`a lease in` `England` `granted` (Date 1 1 2020) `ending` (Date 31 12 2024) `, kind` `an assured tenancy within s 13(1ZC)` `, exception` `no exception`))
#ASSERT NOT (`section 11 applies to` (`a lease in` `England` `granted` (Date 1 1 2020) `ending` (Date 31 12 2024) `, kind` `an ordinary lease` `, exception` `a lease to a body listed in s 14(4) or (5)`))

-- s 9A
#ASSERT `section 9A applies to` (`an English lease granted` (Date 1 1 2020) `ending` (Date 31 12 2024))
#ASSERT `the first day the fitness covenant bites for` (`an English lease granted` (Date 1 1 2020) `ending` (Date 31 12 2024)) EQUALS JUST (Date 1 1 2020)
#ASSERT NOT (`section 9A applies to` (`a lease in` `Wales` `granted` (Date 1 1 2020) `ending` (Date 31 12 2024) `, kind` `an ordinary lease` `, exception` `no exception`))
-- Granted before the commencement date: not, unless (4)-(6).
#ASSERT NOT (`section 9A applies to` (`an English lease granted` (Date 1 1 2019) `ending` (Date 31 12 2023)))
#ASSERT `the first day the fitness covenant bites for` (`an English lease granted` (Date 1 1 2019) `ending` (Date 31 12 2023)) EQUALS NOTHING
-- s 9B(4): an existing periodic tenancy — from 20 March 2020.
existing MEANS `Lease` OF `England`, TRUE, Date 1 1 2015, Date 1 1 2015, TRUE, FALSE, FALSE, `an ordinary lease`, `no exception`, FALSE, FALSE, TRUE, FALSE, FALSE, hffha
#ASSERT `section 9A applies to` existing
#ASSERT `the first day the fitness covenant bites for` existing EQUALS JUST (Date 20 3 2020)
-- s 9B(3)(b): granted after under an earlier agreement.
#ASSERT NOT (`section 9A applies to` (`Lease` OF `England`, TRUE, Date 1 6 2019, Date 31 5 2021, FALSE, FALSE, FALSE, `an ordinary lease`, `no exception`, FALSE, TRUE, FALSE, FALSE, FALSE, hffha))
-- s 9B(6): renewed on or after.
#ASSERT `section 9A applies to` (`Lease` OF `England`, TRUE, Date 1 1 2018, Date 31 12 2020, FALSE, FALSE, FALSE, `an ordinary lease`, `no exception`, FALSE, FALSE, FALSE, FALSE, TRUE, hffha)

§§ `Goal 2 — service charges`

-- Fields: charged, reasonable, incurred, notified, qualifying works without
-- consultation, appropriate amount.
GIVEN incurred IS A DATE, notified IS A MAYBE DATE
GIVETH A `Cost item`
`£1,000 (reasonable £800) incurred` incurred `, notified` notified MEANS
    `Cost item` OF 1000, 800, incurred, notified, FALSE, 250

july MEANS Date 1 7 2026
-- 18 months beginning 1 January 2025 end 30 June 2026.
#ASSERT `the payable part of` (`£1,000 (reasonable £800) incurred` (Date 1 1 2025) `, notified` NOTHING) `in a demand served on` july EQUALS 0
#ASSERT `the payable part of` (`£1,000 (reasonable £800) incurred` (Date 2 1 2025) `, notified` NOTHING) `in a demand served on` july EQUALS 800
#ASSERT `the payable part of` (`£1,000 (reasonable £800) incurred` (Date 1 1 2025) `, notified` (JUST (Date 30 6 2026))) `in a demand served on` july EQUALS 800
#ASSERT `the payable part of` (`£1,000 (reasonable £800) incurred` (Date 1 1 2025) `, notified` (JUST (Date 1 7 2026))) `in a demand served on` july EQUALS 0
-- s 20: qualifying works without consultation, capped at £250.
works MEANS `Cost item` OF 5000, 5000, Date 1 3 2026, NOTHING, TRUE, 250
#ASSERT `the payable part of` works `in a demand served on` july EQUALS 250
#ASSERT `the payable part of` (`Cost item` OF 5000, 4000, Date 1 3 2026, NOTHING, FALSE, 250) `in a demand served on` july EQUALS 4000
demand MEANS `Service charge demand` OF july, (LIST works, (`£1,000 (reasonable £800) incurred` (Date 2 1 2025) `, notified` NOTHING), (`£1,000 (reasonable £800) incurred` (Date 1 1 2025) `, notified` NOTHING)), TRUE
#ASSERT `the service charge payable on` demand EQUALS 1050
#ASSERT NOT (`the tenant may withhold payment of` demand)
#ASSERT `the tenant may withhold payment of` (`Service charge demand` OF july, (LIST works), FALSE)

§§ `Goal 3 — information about the landlord`

#ASSERT `the last day to disclose the landlord's identity after a request received on` (Date 12 1 2026) EQUALS Date 1 2 2026
#ASSERT `the last day for notice of an assignment on` (Date 15 3 2026) `with next rent day` (Date 25 3 2026) EQUALS Date 15 5 2026
#ASSERT `the last day for notice of an assignment on` (Date 15 3 2026) `with next rent day` (Date 1 6 2026) EQUALS Date 1 6 2026
#ASSERT `the last day for notice of an assignment on` (Date 31 12 2025) `with next rent day` (Date 1 2 2026) EQUALS Date 28 2 2026
GIVEN newN IS A MAYBE DATE, oldN IS A MAYBE DATE
GIVETH A `Landlord information facts`
`notices, new` newN `, old` oldN MEANS
    `Landlord information facts` OF NOTHING, JUST (Date 15 3 2026), Date 25 3 2026, newN, oldN, NOTHING, NOTHING
#ASSERT `the end of the old landlord's liability under` (`notices, new` (JUST (Date 10 4 2026)) `, old` (JUST (Date 5 4 2026))) EQUALS JUST (Date 5 4 2026)
#ASSERT `the end of the old landlord's liability under` (`notices, new` (JUST (Date 10 4 2026)) `, old` NOTHING) EQUALS JUST (Date 10 4 2026)
#ASSERT `the end of the old landlord's liability under` (`notices, new` NOTHING `, old` NOTHING) EQUALS NOTHING
#ASSERT `the last day to request inspection after a summary obtained on` (Date 31 8 2026) EQUALS Date 28 2 2027
#ASSERT `the latest start of the inspection facilities after a request on` (Date 31 1 2027) EQUALS Date 28 2 2027

§§ `The top-level goal`

info MEANS `Landlord information facts` OF JUST (Date 12 1 2026), JUST (Date 15 3 2026), Date 25 3 2026, NOTHING, NOTHING, NOTHING, NOTHING
pos MEANS `the lease position for` (`Lease case` OF (`an English lease granted` (Date 1 1 2020) `ending` (Date 31 12 2024)), JUST demand, info)
#ASSERT pos's `repairing covenant implied (s 11)`
#ASSERT pos's `fitness covenant implied (s 9A)`
#ASSERT pos's `service charge payable` EQUALS JUST 1050
#ASSERT pos's `service charge may be withheld` EQUALS JUST FALSE
#ASSERT pos's `last day to disclose the landlord's identity` EQUALS JUST (Date 1 2 2026)
#ASSERT pos's `last day for notice of the assignment` EQUALS JUST (Date 15 5 2026)
#ASSERT pos's `end of the old landlord's liability` EQUALS NOTHING
#ASSERT pos's `last day to request inspection of accounts` EQUALS NOTHING
