IMPORT prelude
IMPORT daydate

-- Landlord and Tenant Act 1985 (UK) — THE NOUNS. Facts about a lease, its
-- service charges and the landlord. No rules here.
-- Source: ../registers/source-bundle/ukpga-1985-70.txt (point in time
-- 29 June 2026).

§ `Nouns`

DECLARE `Country` IS ONE OF `England`, `Wales`

-- s 14(1), (3)-(5): who the lessee is, or what the lease is, for the
-- exceptions.
DECLARE `Section 14 exception` IS ONE OF
    `no exception`
    -- s 14(1): a new lease to an existing or former tenant whose previous
    -- lease was not one to which s 11 applied.
    `a new lease to a tenant whose previous lease was outside s 11`
    -- s 14(3)
    `an agricultural holding or farm business tenancy`
    -- s 14(4)-(5): a lease granted on or after 3 October 1980 to a local
    -- authority, registered provider, the Crown, etc.
    `a lease to a body listed in s 14(4) or (5)`

-- s 13(1A)-(1AA), (1ZC): the social and assured tenancies that are dealt
-- with specially.
DECLARE `Special tenancy` IS ONE OF
    `an ordinary lease`
    -- s 13(1A)(a): a secure tenancy for a fixed term of 7 years or more,
    -- granted on or after s 166 of the Localism Act 2011 came into force.
    `a long secure tenancy under s 13(1A)`
    -- s 13(1AA)
    `a long private registered provider tenancy under s 13(1AA)`
    -- s 13(1ZC): an assured tenancy immediately before the Renters' Rights
    -- Act 2025 commencement date, granted for 7 years or more by someone
    -- other than a private registered provider.
    `an assured tenancy within s 13(1ZC)`

DECLARE `Lease` HAS
    `country`                                           IS A `Country`
    `a dwelling-house let wholly or mainly for human habitation` IS A BOOLEAN
    `granted on`                                        IS A DATE
    -- s 13(2)(a): the term counts from the grant; its last day.
    `term ends on`                                      IS A DATE
    -- A periodic tenancy has no fixed end; treated as under 7 years.
    `periodic`                                          IS A BOOLEAN
    -- s 13(2)(b)
    `determinable by the lessor within seven years`     IS A BOOLEAN
    -- s 13(2)(c)
    `lessee's renewal option takes it to seven years or more` IS A BOOLEAN
    `special tenancy`                                   IS A `Special tenancy`
    `section 14 exception`                              IS A `Section 14 exception`
    -- s 13(1ZA): a Welsh dwelling subject to an occupation contract.
    `a Welsh occupation contract`                       IS A BOOLEAN
    -- s 9B(3)-(6)
    `granted under an agreement or order made before 9A commenced` IS A BOOLEAN
    `a periodic or secure tenancy in existence when 9A commenced` IS A BOOLEAN
    `arose on expiry of a lease granted before 9A commenced` IS A BOOLEAN
    `a fixed term renewed on or after 9A commenced`     IS A BOOLEAN
    -- s 9B(9): when the Homes (Fitness for Human Habitation) Act 2018 came
    -- into force.
    `the commencement date of s 9A`                     IS A DATE

-- One item of relevant costs in a service charge demand (ss 18-20B).
DECLARE `Cost item` HAS
    `amount charged`                                    IS A NUMBER
    -- s 19(1): the part reasonably incurred, for services or works of a
    -- reasonable standard (a finding).
    `amount reasonably incurred`                        IS A NUMBER
    `incurred on`                                       IS A DATE
    -- s 20B(2): written notice that the costs were incurred and would be
    -- charged; NOTHING if none.
    `tenant notified on`                                IS A MAYBE DATE
    -- s 20: qualifying works whose relevant costs exceed the appropriate
    -- amount, and the consultation requirements not complied with or
    -- dispensed with.
    `qualifying works without consultation`             IS A BOOLEAN
    -- s 20(7): the appropriate amount for the tenant's contribution.
    `the appropriate amount`                            IS A NUMBER

DECLARE `Service charge demand` HAS
    `served on`                                         IS A DATE
    `items`                                             IS A LIST OF `Cost item`
    -- s 21B(1)
    `accompanied by the summary of rights and obligations` IS A BOOLEAN

DECLARE `Landlord information facts` HAS
    -- s 1(1): the day the written request was received, if any.
    `identity request received on`                      IS A MAYBE DATE
    -- s 3(1): the assignment of the landlord's interest and the next rent day.
    `assigned on`                                       IS A MAYBE DATE
    `next rent day after the assignment`                IS A DATE
    -- s 3(3B)
    `new landlord's notice given on`                    IS A MAYBE DATE
    `old landlord's notice given on`                    IS A MAYBE DATE
    -- s 22(2), (4)
    `summary obtained on`                               IS A MAYBE DATE
    `inspection requested on`                           IS A MAYBE DATE
