IMPORT prelude
IMPORT `mc97-nouns`
IMPORT `mc97-preamble`

-- TESTS for mc97-preamble.l4. Every expected value is written from the text (extract lines 23 and 26), before the run.

§ `Tests: the preamble`

§§ `Who speaks at the head of each paragraph`

-- Paragraph 1 names EDWARD, King of England, Lord of Ireland, and Duke of Guyan.
#ASSERT `the speaker named at the head of` `preamble paragraph 1` EQUALS JUST (Speaker WITH name IS "EDWARD", titles IS LIST "King of England", "Lord of Ireland", "Duke of Guyan")
-- Paragraph 2 names HENRY, King of England, Lord of Ireland, Duke of Normandy and Guyan, and Earl of Anjou.
#ASSERT `the speaker named at the head of` `preamble paragraph 2` EQUALS JUST (Speaker WITH name IS "HENRY", titles IS LIST "King of England", "Lord of Ireland", "Duke of Normandy and Guyan", "Earl of Anjou")
-- No other passage names who speaks: the answer is NOTHING, not a guess.
#ASSERT `the speaker named at the head of` `chapter 1` EQUALS NOTHING
#ASSERT `the speaker named at the head of` `chapter 9` EQUALS NOTHING
#ASSERT `the speaker named at the head of` `chapter 29` EQUALS NOTHING
#ASSERT `the speaker named at the head of` `the first unnumbered paragraph under the General Saving heading` EQUALS NOTHING
#ASSERT `the speaker named at the head of` `the second unnumbered paragraph under the General Saving heading` EQUALS NOTHING
#ASSERT `the speaker named at the head of` `the third unnumbered paragraph under the General Saving heading` EQUALS NOTHING
-- The two speakers are different people on the face of the text.
#ASSERT NOT (`the speaker named at the head of` `preamble paragraph 1` EQUALS `the speaker named at the head of` `preamble paragraph 2`)

§§ `The charter paragraph 1 says it has seen`

#ASSERT `the charter that preamble paragraph 1 says it has seen` EQUALS "the Great Charter of the Lord Henry sometimes King of England, our Father, of the Liberties of England"
#ASSERT `how preamble paragraph 1 introduces what follows` EQUALS "in these words"

§§ `Paragraph 2: to whom the Liberties following are given and granted`

-- Named in the paragraph: Archbishops, Bishops, Abbots, Priors, Earls, Barons, and (in brackets) Freemen. Seven.
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `an Archbishop` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Bishop` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `an Abbot` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Prior` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `an Earl` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Baron` EQUALS `covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Freeman of the Realm` EQUALS `covered by the text`
-- Not named in the paragraph: the other six capacities. The paragraph is silent about them.
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Templar` EQUALS `not covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Hospitaller` EQUALS `not covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Knight` EQUALS `not covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `a Freeholder` EQUALS `not covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `another Subject` EQUALS `not covered by the text`
#ASSERT `preamble paragraph 2: these Liberties following are given and granted to` `another Person` EQUALS `not covered by the text`

§§ `Paragraph 2: where, and for how long; and who keeps them`

#ASSERT `preamble paragraph 2: where the Liberties following are to be kept` EQUALS "our Kingdom of England"
#ASSERT `preamble paragraph 2: for how long the Liberties following are to be kept` EQUALS "for ever"
-- "to be kept" has no agent in the text: no party is named.
#ASSERT `preamble paragraph 2: the party the text names to keep the Liberties following` EQUALS NOTHING
