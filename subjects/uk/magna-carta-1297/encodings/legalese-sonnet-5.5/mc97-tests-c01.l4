IMPORT prelude
IMPORT `mc97-nouns`
IMPORT `mc97-c01`

-- TESTS for mc97-c01.l4. Every expected value is written from the text of chapter I (extract line 29), before the run.

§ `Tests: chapter 1`

§§ `The Church of England: free, and her whole Rights and Liberties inviolable`

-- "the Church of England shall be free": covered for the Church of England, not covered for any other body.
#ASSERT `chapter 1: the body shall be free` `the Church of England` EQUALS `covered by the text`
#ASSERT `chapter 1: the body shall be free` `another body` EQUALS `not covered by the text`
-- "and shall have all her whole Rights and Liberties inviolable": the same two sides.
#ASSERT `chapter 1: the body shall have all her whole Rights and Liberties inviolable` `the Church of England` EQUALS `covered by the text`
#ASSERT `chapter 1: the body shall have all her whole Rights and Liberties inviolable` `another body` EQUALS `not covered by the text`
-- "We have granted to God": the text names God and no one else as the grantee of the first sentence.
#ASSERT `chapter 1: to whom the first sentence says the grant is made` EQUALS "God"
-- "shall be free" and "shall have ... inviolable" are in the passive and name no one to keep them: NOTHING, not a guess.
#ASSERT `chapter 1: the party the text names to keep the Church free` EQUALS NOTHING

§§ `For Us and our Heirs, of Us and our Heirs`

#ASSERT `chapter 1: the grants are made for, and the Liberties are held of, the party` `the King` EQUALS `covered by the text`
#ASSERT `chapter 1: the grants are made for, and the Liberties are held of, the party` `an Heir of the King` EQUALS `covered by the text`
#ASSERT `chapter 1: the grants are made for, and the Liberties are held of, the party` `a Man of the Realm` EQUALS `not covered by the text`

§§ `The Freemen of the Realm and their Heirs`

-- A Freeman: holds as a Freeman, whether or not also an Heir of a Freeman (the first limb is read first).
#ASSERT `chapter 1: how the Liberties under-written are held` TRUE FALSE EQUALS `holds as a Freeman of the Realm`
#ASSERT `chapter 1: how the Liberties under-written are held` TRUE TRUE EQUALS `holds as a Freeman of the Realm`
-- Not a Freeman but an Heir of one: "to them and their Heirs".
#ASSERT `chapter 1: how the Liberties under-written are held` FALSE TRUE EQUALS `holds as an Heir of a Freeman of the Realm`
-- Neither: the sentence is silent.
#ASSERT `chapter 1: how the Liberties under-written are held` FALSE FALSE EQUALS `not covered by chapter 1's second sentence`

§§ `Which of the chapters after chapter 1 this text shows words for`

-- Chapters 9 and 29 show no repeal annotation (extract table rows for 9 and 29); every other chapter 2 to 37 has a status entry.
#ASSERT `status table: words are shown for chapter` 9 EQUALS JUST TRUE
#ASSERT `status table: words are shown for chapter` 29 EQUALS JUST TRUE
-- A chapter the table shows repealed: the table says so in its own words, so JUST FALSE.
#ASSERT `status table: words are shown for chapter` 2 EQUALS JUST FALSE
#ASSERT `status table: words are shown for chapter` 8 EQUALS JUST FALSE
#ASSERT `status table: words are shown for chapter` 36 EQUALS JUST FALSE
-- Chapter 37 is shown repealed in part, and the table does not say which words remain (F-SAVING-C37): NOTHING, not FALSE.
#ASSERT `status table: words are shown for chapter` 37 EQUALS NOTHING
-- A number outside the cc. 1-37 the extract names: the extract's "includes cc. 1-37" does not close the list, so NOTHING, not FALSE.
#ASSERT `status table: words are shown for chapter` 38 EQUALS NOTHING
#ASSERT `status table: words are shown for chapter` 0 EQUALS NOTHING
-- The list of such chapters, over a range.
#ASSERT `the chapters with words shown from` 2 `up to` 8 EQUALS EMPTY
#ASSERT `the chapters with words shown from` 9 `up to` 9 EQUALS LIST 9
#ASSERT `the chapters with words shown from` 10 `up to` 9 EQUALS EMPTY
#ASSERT `the chapters with words shown from` 2 `up to` 37 EQUALS LIST 9, 29
#ASSERT `chapter 1: the chapters after chapter 1 for which this text shows words` EQUALS LIST 9, 29
