IMPORT prelude
IMPORT `mc97-nouns`
IMPORT `mc97-c29`

-- TESTS for mc97-c29.l4. Every expected value is written from the text of chapter XXIX (extract line 35), before the run.
-- The decision tables are laid out by treatment; the traces carry an `-- expect:` line that check-traces.py reads back.

§ `Tests: chapter 29`

§§ `First sentence: each of the ten treatments, for a Freeman`

-- Arguments: the person is a Freeman, the treatment, by lawful judgment of his Peers, by the Law of the Land.
-- Neither exception limb: forbidden. Either limb alone, or both: not forbidden by the chapter.

-- taken
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `taken` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `taken` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `taken` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `taken` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- imprisoned
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `imprisoned` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `imprisoned` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `imprisoned` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `imprisoned` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- disseised of his Freehold
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Freehold` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Freehold` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Freehold` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Freehold` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- disseised of his Liberties
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Liberties` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Liberties` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Liberties` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his Liberties` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- disseised of his free Customs
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his free Customs` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his free Customs` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his free Customs` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `disseised of his free Customs` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- outlawed
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `outlawed` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `outlawed` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `outlawed` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `outlawed` TRUE TRUE EQUALS `not forbidden by chapter 29`

-- exiled
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `exiled` FALSE FALSE EQUALS `forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `exiled` TRUE FALSE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `exiled` FALSE TRUE EQUALS `not forbidden by chapter 29`
#ASSERT `chapter 29, first sentence: what is done to a Freeman` TRUE `exiled` TRUE TRUE EQUALS `not forbidden by chapter 29`

