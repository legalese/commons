IMPORT prelude
IMPORT daydate

-- Renters' Rights Act 2025 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2025-26.txt (point in time
-- 22 June 2026).

§ `Nouns`

-- HA 1988 s 4A(3), (8): the rent periods the terms provide for.
DECLARE `Rent period kind` IS ONE OF
    `periods of days` HAS `length in days` IS A NUMBER
    -- s 4A(8): successive months, disregarding a first period of up to 30
    -- days.
    `monthly`
    `longer periods, such as quarterly or yearly`

DECLARE `Tenancy terms` HAS
    `an assured tenancy`                                IS A BOOLEAN
    -- s 4A(1)(a)-(b)
    `provides for a fixed term`                         IS A BOOLEAN
    `periods of the tenancy differ from the rent periods` IS A BOOLEAN
    `rent periods`                                      IS A `Rent period kind`
    -- s 4B(2)(a)-(b)
    `entered into before the commencement date`         IS A BOOLEAN
    `an excepted tenancy`                               IS A BOOLEAN
    `entered into on`                                   IS A DATE
    `first day of the tenancy`                          IS A DATE

-- s 4B: one rent period and when the terms make its rent due.
DECLARE `Rent period` HAS
    `period begins on`                                  IS A DATE
    `period ends on`                                    IS A DATE
    `due under the terms on`                            IS A DATE
    -- s 4B(4), (6): the regular rent day falling in this period, if the
    -- compliant rent periods have a regular pattern; NOTHING otherwise.
    `regular rent day in this period`                   IS A MAYBE DATE

-- ss 56-57: rental bidding.
DECLARE `Letting conduct` HAS
    -- s 56(1), (6): a letting that may give rise to a relevant tenancy.
    `may give rise to a relevant tenancy`               IS A BOOLEAN
    -- s 56(2), (5)
    `advertised or offered in writing`                  IS A BOOLEAN
    `a sign at the dwelling merely saying it is to let` IS A BOOLEAN
    `a specific rent was stated`                        IS A BOOLEAN
    -- s 56(3)
    `invited or accepted an offer above the stated rent` IS A BOOLEAN
    -- s 57(1): the authority is satisfied on the balance of probabilities.
    `authority satisfied`                               IS A BOOLEAN

DECLARE `Earlier penalty` HAS
    `imposed on`                                        IS A DATE
    `for the same subsection of s 56`                   IS A BOOLEAN
    `withdrawn or quashed`                              IS A BOOLEAN
