IMPORT prelude
IMPORT daydate

-- Electricity Act 1989 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1989-29.txt (point in time
-- 24 July 2026). Seat: the electricity customer.

§ `Nouns`

§§ `Connection (ss 16-23)`

DECLARE `Connection request` HAS
    -- s 16(1)(a): required by the owner or occupier, or by an authorised
    -- supplier with their consent.
    `required by the owner or occupier, or a supplier with consent` IS A BOOLEAN
    -- s 22(2): a special connection agreement is in effect.
    `a special connection agreement is effective`       IS A BOOLEAN
    -- s 16(4)(a): the connection is already being maintained.
    `already connected`                                 IS A BOOLEAN
    -- s 16A(1)-(2): the notice requiring terms, and whether it specifies the
    -- premises, the date for the connection and the maximum power.
    `notice given on`                                   IS A MAYBE DATE
    `the notice specifies premises, date and maximum power` IS A BOOLEAN
    -- s 17(1)(a)
    `the distributor is prevented by circumstances outside its control` IS A BOOLEAN
    -- s 17(1)(b)
    `a breach of safety regulations despite reasonable steps` IS A BOOLEAN
    -- s 17(1)(ba)
    `not in accordance with the designated strategic plans` IS A BOOLEAN
    -- s 17(1)(c): a finding that it is not reasonable in all the
    -- circumstances to require the connection.
    `not reasonable in all the circumstances`           IS A BOOLEAN
    -- s 17(2)(a)-(c): a Schedule 3 or 4 power is needed, the licence does not
    -- provide for it, and the consent needed has not been given.
    `a Schedule 3 or 4 power is needed without consent` IS A BOOLEAN
    -- s 20(1A): security required and not given (or no longer sufficient).
    `security required and not given`                   IS A BOOLEAN
    -- s 17(3): a notice of intention to disconnect, and the day of the
    -- disconnection.
    `disconnection notice given on`                     IS A MAYBE DATE
    `disconnection on`                                  IS A MAYBE DATE
    -- s 23(1C): the day the connection was made.
    `connection made on`                                IS A MAYBE DATE

DECLARE `Connection outcome` IS ONE OF
    `the special connection agreement governs`
    `the duty is not engaged`
    `no valid notice yet`
    `need not connect under s 17`
    `may refuse the lines or plant until security is given`
    `may disconnect for want of security`
    `must offer terms and connect`
    `must maintain the connection`

-- s 20(3): money deposited as security.
DECLARE `Security deposit` HAS
    `amount deposited`                                  IS A NUMBER
    -- the rate fixed by the distributor, as a sum per 50p for each three
    -- months
    `interest per 50p per three months`                 IS A NUMBER
    `deposited on`                                      IS A DATE
    `returned on`                                       IS A DATE

§§ `Non-payment, and entry (Schedule 6)`

DECLARE `Supplier's action` IS ONE OF
    `install a pre-payment meter`
    `disconnect the premises`

DECLARE `Non-payment case` HAS
    -- Sch 6 para 2(3): the written demand for the relevant payments.
    `demand made on`                                    IS A DATE
    `paid on`                                           IS A MAYBE DATE
    -- para 2(2)(a), disregarding a dispute under s 39.
    `genuinely in dispute`                              IS A BOOLEAN
    -- para 2(2)(b): the notice of intention to the occupier (or owner).
    `notice of intention given on`                      IS A MAYBE DATE
    `the action`                                        IS A `Supplier's action`
    `action on`                                         IS A DATE
    -- paras 7(4)-(5), 8(3)-(4), 10(4): entry for the purpose.
    `entry notice given on`                             IS A MAYBE DATE
    `entry at a reasonable time`                        IS A BOOLEAN
    `authority document produced`                       IS A BOOLEAN
    -- para 5: consent to restoring the connection.
    `the supplier's consent to restore`                 IS A BOOLEAN

§§ `Redress and resale (ss 27G-27O, 44)`

-- s 27K(1), (3): a final or provisional order under s 25 for the
-- contravention.
DECLARE `Prior order` IS ONE OF
    `a final order`                                     HAS `final order made on` IS A DATE
    `a confirmed provisional order`                     HAS `provisional order confirmed on` IS A DATE
    `an unconfirmed provisional order`                  HAS `provisional order made on` IS A DATE

DECLARE `Contravention facts` HAS
    `contravention on`                                  IS A DATE
    -- s 27G(1)(b)
    `I suffered loss, damage or inconvenience`          IS A BOOLEAN
    -- s 27N(4)
    `after Schedule 14 to the Energy Act 2013 came into force` IS A BOOLEAN
    -- s 27N(2): a finding by the Authority.
    `the Authority is satisfied the Competition Act 1998 is most appropriate` IS A BOOLEAN
    `the prior order`                                   IS A MAYBE `Prior order`
    `section 27I notice served on`                      IS A MAYBE DATE
    `section 28(2) notice served on`                    IS A MAYBE DATE
    `redress order made on`                             IS A DATE

DECLARE `Redress order facts` HAS
    `copy served on the supplier on`                    IS A DATE
    `compliance date`                                   IS A DATE
    `appeal made on`                                    IS A MAYBE DATE
    `appeal determined on`                              IS A MAYBE DATE
    `compensation paid on`                              IS A MAYBE DATE
    `turnover`                                          IS A NUMBER
    `penalty imposed`                                   IS A NUMBER

-- s 44: electricity supplied by an authorised supplier and resold to me.
DECLARE `Resale facts` HAS
    `price paid`                                        IS A NUMBER
    `maximum price`                                     IS A NUMBER
    -- s 44(2)(b)
    `maximum price without the information`             IS A MAYBE NUMBER
    -- s 44(4)(b)
    `interest under the direction`                      IS A NUMBER
