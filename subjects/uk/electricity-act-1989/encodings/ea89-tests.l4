IMPORT prelude
IMPORT daydate
IMPORT `ea89-types`
IMPORT `ea89-days`
IMPORT `ea89-connection`
IMPORT `ea89-nonpayment`
IMPORT `ea89-redress`
IMPORT `ea89-goal`

-- Electricity Act 1989 (UK) — the encoder's tests. Expected values are
-- worked by hand from the Act.

§ `Tests`

-- England and Wales bank holidays in 2026 (Good Friday, 3 April, and
-- Christmas Day are excluded by s 64(1) itself).
hols MEANS LIST Date 1 1 2026, Date 6 4 2026, Date 4 5 2026, Date 25 5 2026, Date 31 8 2026, Date 28 12 2026

§§ `Working days`

#ASSERT `is a working day` (Date 30 3 2026) `, bank holidays` hols
#ASSERT NOT (`is a working day` (Date 3 4 2026) `, bank holidays` hols)
#ASSERT NOT (`is a working day` (Date 6 4 2026) `, bank holidays` hols)
#ASSERT NOT (`is a working day` (Date 25 12 2026) `, bank holidays` hols)
#ASSERT NOT (`is a working day` (Date 4 4 2026) `, bank holidays` hols)
#ASSERT `Easter Sunday in` 2026 EQUALS Date 5 4 2026
#ASSERT `Easter Sunday in` 2027 EQUALS Date 28 3 2027

§§ `Goal 1 — connection`

-- Fields: required by owner or occupier, special agreement, already
-- connected, notice, notice complete, prevented, safety regulations,
-- strategic plans, not reasonable, Schedule 3 or 4 power, security not
-- given, disconnection notice, disconnection day, connection made on.
base MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
special MEANS `Connection request` OF TRUE, TRUE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
stranger MEANS `Connection request` OF FALSE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
nonotice MEANS `Connection request` OF TRUE, FALSE, FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
incomplete MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
prevented MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
strategic MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
unreasonable MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, JUST (Date 30 3 2026), NOTHING, NOTHING
schedule MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, NOTHING, NOTHING, NOTHING
nosecurity MEANS `Connection request` OF TRUE, FALSE, FALSE, JUST (Date 1 3 2026), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING, NOTHING, NOTHING
existing MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, JUST (Date 15 3 2026)
existingPrevented MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING
existingNoSecurity MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING, NOTHING, NOTHING
-- s 17(3): notice Monday 30 March 2026. Working days: 31 March, 1, 2, (3
-- Good Friday, 4-5 weekend, 6 Easter Monday), 7, 8, 9, 10 April.
existingUnreasonable MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, JUST (Date 30 3 2026), JUST (Date 10 4 2026), JUST (Date 29 2 2024)
existingTooSoon MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, JUST (Date 30 3 2026), JUST (Date 9 4 2026), JUST (Date 31 1 2026)
-- Notice Friday 18 December 2026: 21, 22, 23, 24, (25 Christmas, 26-27
-- weekend, 28 bank holiday), 29, 30, 31 December.
christmas MEANS `Connection request` OF TRUE, FALSE, TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, JUST (Date 18 12 2026), NOTHING, NOTHING

#ASSERT `must the distributor connect` base EQUALS `must offer terms and connect`
#ASSERT `must the distributor connect` special EQUALS `the special connection agreement governs`
#ASSERT `must the distributor connect` stranger EQUALS `the duty is not engaged`
#ASSERT `must the distributor connect` nonotice EQUALS `no valid notice yet`
#ASSERT `must the distributor connect` incomplete EQUALS `no valid notice yet`
#ASSERT `must the distributor connect` prevented EQUALS `need not connect under s 17`
#ASSERT `must the distributor connect` strategic EQUALS `need not connect under s 17`
#ASSERT `must the distributor connect` unreasonable EQUALS `need not connect under s 17`
#ASSERT `must the distributor connect` schedule EQUALS `need not connect under s 17`
#ASSERT `must the distributor connect` nosecurity EQUALS `may refuse the lines or plant until security is given`
#ASSERT `must the distributor connect` existing EQUALS `must maintain the connection`
#ASSERT `must the distributor connect` existingPrevented EQUALS `need not connect under s 17`
#ASSERT `must the distributor connect` existingNoSecurity EQUALS `may disconnect for want of security`
#ASSERT `must the distributor connect` existingUnreasonable EQUALS `must maintain the connection`
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` existingUnreasonable `, bank holidays` hols EQUALS JUST (Date 10 4 2026)
#ASSERT `the disconnection under s 17(1)(c) is allowed on the day for` existingUnreasonable `, bank holidays` hols
#ASSERT NOT (`the disconnection under s 17(1)(c) is allowed on the day for` existingTooSoon `, bank holidays` hols)
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` christmas `, bank holidays` hols EQUALS JUST (Date 31 12 2026)
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` unreasonable `, bank holidays` hols EQUALS NOTHING
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` existing `, bank holidays` hols EQUALS NOTHING
-- s 23(1C): 12 months beginning with 15 March 2026 end on 14 March 2027.
#ASSERT `the last day to refer a connection dispute for` existing EQUALS JUST (Date 14 3 2027)
#ASSERT `the last day to refer a connection dispute for` existingUnreasonable EQUALS JUST (Date 28 2 2025)
#ASSERT `the last day to refer a connection dispute for` existingTooSoon EQUALS JUST (Date 30 1 2027)
#ASSERT `the last day to refer a connection dispute for` base EQUALS NOTHING

-- s 20(3): £10.25 is 20 sums of 50p.
#ASSERT `the interest on my security deposit` (`Security deposit` OF 10.25, 1/100, Date 1 1 2026, Date 1 7 2026) EQUALS 2/5
#ASSERT `the interest on my security deposit` (`Security deposit` OF 10.25, 1/100, Date 1 1 2026, Date 30 6 2026) EQUALS 1/5
#ASSERT `the interest on my security deposit` (`Security deposit` OF 10.25, 1/100, Date 1 1 2026, Date 31 3 2026) EQUALS 0
#ASSERT `the interest on my security deposit` (`Security deposit` OF 0.4, 1/100, Date 1 1 2026, Date 1 7 2027) EQUALS 0

§§ `Goal 2 — non-payment`

-- Fields: demand, paid, dispute, notice, action, action day, entry notice,
-- reasonable time, document, consent to restore.
-- Demand Monday 2 March 2026: the 28 days end on 30 March; the power can be
-- exercised from 31 March at the earliest.
GIVEN nt IS A MAYBE DATE, pd IS A MAYBE DATE, act IS A DATE
GIVETH A `Non-payment case`
`unpaid with notice` nt `paid` pd `acting on` act MEANS
    `Non-payment case` OF Date 2 3 2026, pd, FALSE, nt, `disconnect the premises`, act, JUST (Date 7 4 2026), TRUE, TRUE, FALSE

-- Notice 2 March: its seventh working day is 11 March, before 31 March.
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 2 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS JUST (Date 31 3 2026)
-- Notice Friday 27 March: 30, 31 March, 1, 2, (3-6), 7, 8, 9 April.
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS JUST (Date 9 4 2026)
#ASSERT `the supplier may act on the day for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols
#ASSERT NOT (`the supplier may act on the day for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` NOTHING `acting on` (Date 8 4 2026)) `, bank holidays` hols)
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 1 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS NOTHING
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` NOTHING `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS NOTHING
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` (JUST (Date 30 3 2026)) `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS NOTHING
-- A late payment does not end the power (F5).
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` (JUST (Date 1 4 2026)) `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS JUST (Date 9 4 2026)
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` (JUST (Date 10 4 2026)) `acting on` (Date 9 4 2026)) `, bank holidays` hols EQUALS JUST (Date 9 4 2026)
#ASSERT `the earliest day for a pre-payment meter or disconnection for` (`Non-payment case` OF Date 2 3 2026, NOTHING, TRUE, JUST (Date 27 3 2026), `install a pre-payment meter`, Date 9 4 2026, NOTHING, TRUE, TRUE, FALSE) `, bank holidays` hols EQUALS NOTHING

-- Entry: notice Tuesday 7 April; its second working day is 9 April.
#ASSERT `the officer may enter for` (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)) `, bank holidays` hols
#ASSERT NOT (`the officer may enter for` (`Non-payment case` OF Date 2 3 2026, NOTHING, FALSE, JUST (Date 27 3 2026), `install a pre-payment meter`, Date 9 4 2026, JUST (Date 8 4 2026), TRUE, TRUE, FALSE) `, bank holidays` hols)
#ASSERT NOT (`the officer may enter for` (`Non-payment case` OF Date 2 3 2026, NOTHING, FALSE, JUST (Date 27 3 2026), `install a pre-payment meter`, Date 9 4 2026, JUST (Date 7 4 2026), TRUE, FALSE, FALSE) `, bank holidays` hols)
#ASSERT NOT (`the officer may enter for` (`Non-payment case` OF Date 2 3 2026, NOTHING, FALSE, JUST (Date 27 3 2026), `install a pre-payment meter`, Date 9 4 2026, JUST (Date 7 4 2026), FALSE, TRUE, FALSE) `, bank holidays` hols)
#ASSERT NOT (`the officer may enter for` (`Non-payment case` OF Date 2 3 2026, NOTHING, FALSE, JUST (Date 27 3 2026), `install a pre-payment meter`, Date 9 4 2026, NOTHING, TRUE, TRUE, FALSE) `, bank holidays` hols)
#ASSERT `restoring the connection myself is an offence for` (`unpaid with notice` NOTHING `paid` NOTHING `acting on` (Date 9 4 2026))
#ASSERT NOT (`restoring the connection myself is an offence for` (`Non-payment case` OF Date 2 3 2026, NOTHING, FALSE, NOTHING, `disconnect the premises`, Date 9 4 2026, NOTHING, TRUE, TRUE, TRUE))

§§ `Goal 3 — redress and resale`

-- Fields: contravention, loss, after Sch 14, Competition Act, prior order,
-- s 27I notice, s 38 notice, order made on.
GIVEN cd IS A DATE, po IS A MAYBE `Prior order`, n27I IS A MAYBE DATE, n28 IS A MAYBE DATE, od IS A DATE
GIVETH A `Contravention facts`
`a contravention on` cd `prior` po `27I` n27I `28(2)` n28 `order on` od MEANS
    `Contravention facts` OF cd, TRUE, TRUE, FALSE, po, n27I, n28, od

-- Contravention 15 June 2020: the five years end on 15 June 2025.
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `27I` NOTHING `28(2)` NOTHING `order on` (Date 15 6 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `27I` NOTHING `28(2)` NOTHING `order on` (Date 16 6 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `27I` (JUST (Date 10 6 2025)) `28(2)` NOTHING `order on` (Date 1 1 2026))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `27I` NOTHING `28(2)` (JUST (Date 15 6 2025)) `order on` (Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 15 6 2020) `prior` NOTHING `27I` NOTHING `28(2)` (JUST (Date 16 6 2025)) `order on` (Date 1 1 2026)))
-- 29 February 2020: the five years end on 28 February 2025.
#ASSERT `the end of the five years for` (`a contravention on` (Date 29 2 2020) `prior` NOTHING `27I` NOTHING `28(2)` NOTHING `order on` (Date 1 1 2025)) EQUALS Date 28 2 2025
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 29 2 2020) `prior` NOTHING `27I` NOTHING `28(2)` NOTHING `order on` (Date 1 3 2025)))
-- s 27G(1)(b), 27N(2), (4).
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, FALSE, TRUE, FALSE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, TRUE, FALSE, FALSE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
#ASSERT NOT (`a consumer redress order can be made for` (`Contravention facts` OF Date 15 6 2024, TRUE, TRUE, TRUE, NOTHING, NOTHING, NOTHING, Date 1 1 2026))
-- s 27K(3): a final order made 31 January 2025: 3 months from it is
-- 30 April 2025 (no 31 April).
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `27I` (JUST (Date 30 4 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `27I` (JUST (Date 1 5 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025)))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `27I` NOTHING `28(2)` NOTHING `order on` (Date 1 9 2025)))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a final order` (Date 31 1 2025))) `27I` (JUST (Date 15 1 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a confirmed provisional order` (Date 10 3 2025))) `27I` (JUST (Date 10 6 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`a confirmed provisional order` (Date 10 3 2025))) `27I` (JUST (Date 11 6 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025)))
#ASSERT `a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`an unconfirmed provisional order` (Date 1 1 2025))) `27I` (JUST (Date 1 7 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025))
#ASSERT NOT (`a consumer redress order can be made for` (`a contravention on` (Date 1 6 2024) `prior` (JUST (`an unconfirmed provisional order` (Date 1 1 2025))) `27I` (JUST (Date 2 7 2025)) `28(2)` NOTHING `order on` (Date 1 9 2025)))

-- Fields: served, compliance date, appeal made, appeal determined, paid,
-- turnover, penalty. Served 1 March 2026.
GIVEN due IS A DATE, ap IS A MAYBE DATE, dc IS A MAYBE DATE, pd IS A MAYBE DATE
GIVETH A `Redress order facts`
`an order due` due `appeal` ap `decided` dc `paid` pd MEANS
    `Redress order facts` OF Date 1 3 2026, due, ap, dc, pd, 1000000, 30000

#ASSERT `the compliance date is lawful for` (`an order due` (Date 8 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING)
#ASSERT NOT (`the compliance date is lawful for` (`an order due` (Date 7 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING))
#ASSERT `the supplier's last day to appeal for` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS Date 12 4 2026
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` (JUST (Date 31 3 2026))) EQUALS NOTHING
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` (JUST (Date 2 4 2026))) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 10 4 2026)) `decided` NOTHING `paid` NOTHING) EQUALS NOTHING
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 10 4 2026)) `decided` (JUST (Date 1 6 2026)) `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
#ASSERT `interest on my compensation runs from` (`an order due` (Date 31 3 2026) `appeal` (JUST (Date 13 4 2026)) `decided` NOTHING `paid` NOTHING) EQUALS JUST (Date 1 4 2026)
-- s 27O: 10% of 1,000,000 less a 30,000 penalty.
#ASSERT `the most compensation for the contravention under` (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING) EQUALS 70000
#ASSERT `the most compensation for the contravention under` (`Redress order facts` OF Date 1 3 2026, Date 31 3 2026, NOTHING, NOTHING, NOTHING, 1000000, 150000) EQUALS 0
#ASSERT `the most compensation for the contravention under` (`Redress order facts` OF Date 1 3 2026, Date 31 3 2026, NOTHING, NOTHING, NOTHING, 1000000, 0) EQUALS 100000

-- s 44. Fields: price paid, maximum, reduced maximum, interest.
#ASSERT `what I can recover on resale under` (`Resale facts` OF 120, 100, NOTHING, 5) EQUALS 25
#ASSERT `what I can recover on resale under` (`Resale facts` OF 90, 100, NOTHING, 5) EQUALS 0
#ASSERT `what I can recover on resale under` (`Resale facts` OF 90, 100, JUST 80, 2) EQUALS 12

§§ `The top-level goal`

empty MEANS `Electricity customer case` OF hols, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING
full MEANS `Electricity customer case` OF hols, JUST existingUnreasonable, JUST (`Security deposit` OF 10.25, 1/100, Date 1 1 2026, Date 1 7 2026), JUST (`unpaid with notice` (JUST (Date 27 3 2026)) `paid` NOTHING `acting on` (Date 9 4 2026)), NOTHING, JUST (`an order due` (Date 31 3 2026) `appeal` NOTHING `decided` NOTHING `paid` NOTHING), JUST (`Resale facts` OF 120, 100, NOTHING, 5)

#ASSERT (`the electricity customer position for` empty)'s `connection` EQUALS NOTHING
#ASSERT (`the electricity customer position for` empty)'s `supplier may act on the day` EQUALS NOTHING
#ASSERT (`the electricity customer position for` empty)'s `recoverable on resale` EQUALS NOTHING
#ASSERT (`the electricity customer position for` full)'s `connection` EQUALS JUST `must maintain the connection`
#ASSERT (`the electricity customer position for` full)'s `earliest disconnection under s 17(1)(c)` EQUALS JUST (Date 10 4 2026)
#ASSERT (`the electricity customer position for` full)'s `last day to refer a connection dispute` EQUALS JUST (Date 28 2 2025)
#ASSERT (`the electricity customer position for` full)'s `interest on my security deposit` EQUALS JUST (2/5)
#ASSERT (`the electricity customer position for` full)'s `earliest day for a pre-payment meter or disconnection` EQUALS JUST (Date 9 4 2026)
#ASSERT (`the electricity customer position for` full)'s `supplier may act on the day` EQUALS JUST TRUE
#ASSERT (`the electricity customer position for` full)'s `officer may enter` EQUALS JUST TRUE
#ASSERT (`the electricity customer position for` full)'s `restoring it myself is an offence` EQUALS JUST TRUE
#ASSERT (`the electricity customer position for` full)'s `redress order can be made` EQUALS NOTHING
#ASSERT (`the electricity customer position for` full)'s `supplier's last day to appeal` EQUALS JUST (Date 12 4 2026)
#ASSERT (`the electricity customer position for` full)'s `interest on compensation runs from` EQUALS JUST (Date 1 4 2026)
#ASSERT (`the electricity customer position for` full)'s `most compensation for the contravention` EQUALS JUST 70000
#ASSERT (`the electricity customer position for` full)'s `recoverable on resale` EQUALS JUST 25
