IMPORT prelude
IMPORT daydate
IMPORT `ea89-types`
IMPORT `ea89-days`
IMPORT `ea89-connection`
IMPORT `ea89-nonpayment`
IMPORT `ea89-redress`
IMPORT `ea89-goal`

-- Electricity Act 1989 (UK) — INDEPENDENT TESTS.
-- Expected values come from independent-expectations.md, written from the
-- brief and the source text before the encoding was read. Scenario ids (C, N,
-- R) refer to that file. A failing assertion is a finding: the expected
-- values are never changed to fit the code.

§ `Inputs`

-- 2026 England and Wales bank holidays, plus 1 Jan 2027.
bh MEANS LIST Date 1 1 2026, Date 6 4 2026, Date 4 5 2026, Date 25 5 2026, Date 31 8 2026, Date 28 12 2026, Date 1 1 2027

-- Easter Monday 2027 only (Good Friday 2027 must be computed).
bh27 MEANS LIST Date 29 3 2027

none MEANS LIST Date 1 1 1900

§§ `Builders`

-- A maintained connection, s 17(1)(c) found, with a disconnection notice and day.
GIVEN nn IS A MAYBE DATE, dd IS A MAYBE DATE
GIVETH A `Connection request`
`kept` nn dd MEANS
    `Connection request` OF TRUE, FALSE, TRUE, (JUST (Date 1 6 2020)), TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, nn, dd, NOTHING

-- A new request with a notice given 2 Mar 2026.
GIVEN own IS A BOOLEAN, spec IS A BOOLEAN, prev IS A BOOLEAN, brk IS A BOOLEAN, strat IS A BOOLEAN, unr IS A BOOLEAN, sch IS A BOOLEAN, sec IS A BOOLEAN
GIVETH A `Connection request`
`fresh` own spec prev brk strat unr sch sec MEANS
    `Connection request` OF own, FALSE, FALSE, (JUST (Date 2 3 2026)), spec, prev, brk, strat, unr, sch, sec, NOTHING, NOTHING, NOTHING

GIVEN cm IS A DATE
GIVETH A `Connection request`
`made` cm MEANS
    `Connection request` OF TRUE, FALSE, TRUE, (JUST (Date 1 6 2020)), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, (JUST cm)

GIVEN amt IS A NUMBER, rte IS A NUMBER, dfrom IS A DATE, dto IS A DATE
GIVETH A NUMBER
`interest` amt rte dfrom dto MEANS `the interest on my security deposit` (`Security deposit` OF amt, rte, dfrom, dto)

GIVEN dm IS A DATE, pd IS A MAYBE DATE, ds IS A BOOLEAN, nt IS A MAYBE DATE, ac IS A `Supplier's action`, ao IS A DATE, en IS A MAYBE DATE, rt IS A BOOLEAN, dc IS A BOOLEAN, cs IS A BOOLEAN
GIVETH A `Non-payment case`
`np` dm pd ds nt ac ao en rt dc cs MEANS
    `Non-payment case` OF dm, pd, ds, nt, ac, ao, en, rt, dc, cs

GIVEN con IS A DATE, lss IS A BOOLEAN, sch14 IS A BOOLEAN, cmp IS A BOOLEAN, pri IS A MAYBE `Prior order`, n27 IS A MAYBE DATE, n28 IS A MAYBE DATE, mo IS A DATE
GIVETH A BOOLEAN
`can order` con lss sch14 cmp pri n27 n28 mo MEANS
    `a consumer redress order can be made for` (`Contravention facts` OF con, lss, sch14, cmp, pri, n27, n28, mo)

GIVEN srv IS A DATE, cmpl IS A DATE, apm IS A MAYBE DATE, apd IS A MAYBE DATE, pon IS A MAYBE DATE, trn IS A NUMBER, pen IS A NUMBER
GIVETH A `Redress order facts`
`ro` srv cmpl apm apd pon trn pen MEANS
    `Redress order facts` OF srv, cmpl, apm, apd, pon, trn, pen

GIVEN pp IS A NUMBER, mx IS A NUMBER, rd IS A MAYBE NUMBER, iu IS A NUMBER
GIVETH A NUMBER
`resale` pp mx rd iu MEANS `what I can recover on resale under` (`Resale facts` OF pp, mx, rd, iu)

GIVEN r IS A `Connection request`
GIVETH A MAYBE DATE
`earliest cut` r MEANS `the earliest day I can be disconnected under s 17(1)(c) for` r `, bank holidays` bh

GIVEN r IS A `Connection request`
GIVETH A BOOLEAN
`cut ok` r MEANS `the disconnection under s 17(1)(c) is allowed on the day for` r `, bank holidays` bh

GIVEN k IS A `Non-payment case`
GIVETH A MAYBE DATE
`earliest act` k MEANS `the earliest day for a pre-payment meter or disconnection for` k `, bank holidays` bh

GIVEN k IS A `Non-payment case`
GIVETH A BOOLEAN
`act ok` k MEANS `the supplier may act on the day for` k `, bank holidays` bh

GIVEN k IS A `Non-payment case`
GIVETH A BOOLEAN
`enter ok` k MEANS `the officer may enter for` k `, bank holidays` bh

§ `Working days (s 64(1))`

#ASSERT NOT (`is a working day` (Date 3 4 2026) `, bank holidays` none)
#ASSERT NOT (`is a working day` (Date 26 3 2027) `, bank holidays` none)
#ASSERT NOT (`is a working day` (Date 25 12 2026) `, bank holidays` none)
#ASSERT `is a working day` (Date 24 12 2026) `, bank holidays` bh
#ASSERT NOT (`is a working day` (Date 28 12 2026) `, bank holidays` bh)
#ASSERT `is a working day` (Date 6 4 2026) `, bank holidays` none
-- N10: Good Friday 2027 computed, Easter Monday from the list.
#ASSERT `the` 2 `th working day after` (Date 25 3 2027) `, bank holidays` bh27 EQUALS Date 31 3 2027

§ `Goal 1 — connection`

-- C1, C2
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `must offer terms and connect`
-- not required by owner, occupier or supplier with consent
#ASSERT `must the distributor connect` (`fresh` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `the duty is not engaged`
-- C3
#ASSERT `must the distributor connect` (`fresh` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS `no valid notice yet`
-- C4
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS `need not connect under s 17`
-- C5
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS `need not connect under s 17`
-- C6
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS `need not connect under s 17`
-- C7
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS `need not connect under s 17`
-- C8
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS `need not connect under s 17`
-- C8c
#ASSERT `must the distributor connect` (`Connection request` OF TRUE, TRUE, FALSE, (JUST (Date 2 3 2026)), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, NOTHING, NOTHING, NOTHING) EQUALS `the special connection agreement governs`
-- C8d
#ASSERT `must the distributor connect` (`fresh` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS `may refuse the lines or plant until security is given`
-- C8e
#ASSERT `must the distributor connect` (`Connection request` OF TRUE, FALSE, TRUE, (JUST (Date 1 6 2020)), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, NOTHING, NOTHING, NOTHING) EQUALS `may disconnect for want of security`

-- C9: notice Mon 30 Mar 2026 across Easter.
#ASSERT `earliest cut` (`kept` (JUST (Date 30 3 2026)) NOTHING) EQUALS JUST (Date 10 4 2026)
-- C9a
#ASSERT NOT (`cut ok` (`kept` (JUST (Date 30 3 2026)) (JUST (Date 9 4 2026))))
#ASSERT `cut ok` (`kept` (JUST (Date 30 3 2026)) (JUST (Date 10 4 2026)))
#ASSERT `cut ok` (`kept` (JUST (Date 30 3 2026)) (JUST (Date 13 4 2026)))
-- C9b: no bank holidays; Good Friday still out.
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` (`kept` (JUST (Date 30 3 2026)) NOTHING) `, bank holidays` none EQUALS JUST (Date 9 4 2026)
-- C9c: Christmas
#ASSERT `earliest cut` (`kept` (JUST (Date 21 12 2026)) NOTHING) EQUALS JUST (Date 4 1 2027)
-- C9d: Christmas Day from s 64 itself
#ASSERT `the earliest day I can be disconnected under s 17(1)(c) for` (`kept` (JUST (Date 21 12 2026)) NOTHING) `, bank holidays` none EQUALS JUST (Date 31 12 2026)
-- C9e
#ASSERT `earliest cut` (`kept` (JUST (Date 9 10 2026)) NOTHING) EQUALS JUST (Date 20 10 2026)
#ASSERT `earliest cut` (`kept` (JUST (Date 10 10 2026)) NOTHING) EQUALS JUST (Date 20 10 2026)
-- C9f
#ASSERT `earliest cut` (`kept` (JUST (Date 1 5 2026)) NOTHING) EQUALS JUST (Date 13 5 2026)
-- C9g DISSENT (clear days): expected to fail against the brief's convention.
#ASSERT `earliest cut` (`kept` (JUST (Date 30 3 2026)) NOTHING) EQUALS JUST (Date 13 4 2026)
-- C9h: no notice
#ASSERT `earliest cut` (`kept` NOTHING NOTHING) EQUALS NOTHING
#ASSERT NOT (`cut ok` (`kept` NOTHING (JUST (Date 13 4 2026))))

-- C10 - C10d: s 20(3)
#ASSERT `interest` 100.25 0.01 (Date 15 1 2026) (Date 15 7 2026) EQUALS 4
#ASSERT `interest` 100.25 0.01 (Date 15 1 2026) (Date 14 7 2026) EQUALS 2
#ASSERT `interest` 100.25 0.01 (Date 15 1 2026) (Date 14 4 2026) EQUALS 0
#ASSERT `interest` 0.49 0.01 (Date 15 1 2026) (Date 15 1 2027) EQUALS 0
#ASSERT `interest` 10 0.02 (Date 31 8 2026) (Date 30 11 2026) EQUALS 0.4

-- C11 - C11d: s 23(1C)
#ASSERT `the last day to refer a connection dispute for` (`made` (Date 15 3 2026)) EQUALS JUST (Date 14 3 2027)
#ASSERT `the last day to refer a connection dispute for` (`made` (Date 29 2 2028)) EQUALS JUST (Date 28 2 2029)
#ASSERT `the last day to refer a connection dispute for` (`made` (Date 1 3 2027)) EQUALS JUST (Date 29 2 2028)
#ASSERT `the last day to refer a connection dispute for` (`made` (Date 1 1 2026)) EQUALS JUST (Date 31 12 2026)

§ `Goal 2 — non-payment and entry`

-- N1
#ASSERT `the last day of the requisite period for` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE) EQUALS Date 30 3 2026
-- N2
#ASSERT `earliest act` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE) EQUALS JUST (Date 31 3 2026)
#ASSERT `act ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE)
#ASSERT NOT (`act ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 30 3 2026) NOTHING TRUE TRUE FALSE))
-- N3, N3a
#ASSERT `earliest act` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 7 4 2026) NOTHING TRUE TRUE FALSE) EQUALS JUST (Date 7 4 2026)
#ASSERT NOT (`act ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 2 4 2026) NOTHING TRUE TRUE FALSE))
#ASSERT `act ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 7 4 2026) NOTHING TRUE TRUE FALSE)
-- N4: paid on day 28
#ASSERT `earliest act` (`np` (Date 1 2 2026) (JUST (Date 1 3 2026)) FALSE (JUST (Date 2 2 2026)) `disconnect the premises` (Date 2 3 2026) NOTHING TRUE TRUE FALSE) EQUALS NOTHING
-- N4a: paid on day 29
#ASSERT `earliest act` (`np` (Date 1 2 2026) (JUST (Date 2 3 2026)) FALSE (JUST (Date 2 2 2026)) `disconnect the premises` (Date 2 3 2026) NOTHING TRUE TRUE FALSE) EQUALS JUST (Date 2 3 2026)
-- N5 leap year
#ASSERT `earliest act` (`np` (Date 1 2 2028) NOTHING FALSE (JUST (Date 1 2 2028)) `disconnect the premises` (Date 1 3 2028) NOTHING TRUE TRUE FALSE) EQUALS JUST (Date 1 3 2028)
-- N5a
#ASSERT `earliest act` (`np` (Date 31 1 2026) NOTHING FALSE (JUST (Date 2 2 2026)) `disconnect the premises` (Date 1 3 2026) NOTHING TRUE TRUE FALSE) EQUALS JUST (Date 1 3 2026)
-- N6
#ASSERT `earliest act` (`np` (Date 2 3 2026) NOTHING TRUE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE) EQUALS NOTHING
-- N7
#ASSERT `earliest act` (`np` (Date 2 3 2026) NOTHING FALSE NOTHING `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT NOT (`act ok` (`np` (Date 2 3 2026) NOTHING FALSE NOTHING `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE))

-- N8: entry to install a pre-payment meter, entry notice Thu 2 Apr 2026, entry Wed 8 Apr 2026.
#ASSERT `enter ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 8 4 2026) (JUST (Date 2 4 2026)) TRUE TRUE FALSE)
-- N8a: entry Tue 7 Apr 2026
#ASSERT NOT (`enter ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 7 4 2026) (JUST (Date 2 4 2026)) TRUE TRUE FALSE))
-- N8b: no document
#ASSERT NOT (`enter ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 8 4 2026) (JUST (Date 2 4 2026)) TRUE FALSE FALSE))
-- N8c: not a reasonable time
#ASSERT NOT (`enter ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 8 4 2026) (JUST (Date 2 4 2026)) FALSE TRUE FALSE))
-- N9: entry to disconnect over Christmas
#ASSERT `enter ok` (`np` (Date 2 11 2026) NOTHING FALSE (JUST (Date 1 12 2026)) `disconnect the premises` (Date 30 12 2026) (JUST (Date 24 12 2026)) TRUE TRUE FALSE)
-- N9a
#ASSERT NOT (`enter ok` (`np` (Date 2 11 2026) NOTHING FALSE (JUST (Date 1 12 2026)) `disconnect the premises` (Date 29 12 2026) (JUST (Date 24 12 2026)) TRUE TRUE FALSE))
-- no entry notice at all
#ASSERT NOT (`enter ok` (`np` (Date 2 11 2026) NOTHING FALSE (JUST (Date 1 12 2026)) `disconnect the premises` (Date 30 12 2026) NOTHING TRUE TRUE FALSE))
-- N12 DISSENT (clear days): expected to fail against the brief's convention.
#ASSERT NOT (`enter ok` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 25 3 2026)) `install a pre-payment meter` (Date 8 4 2026) (JUST (Date 2 4 2026)) TRUE TRUE FALSE))

-- N11, N11a: para 5
#ASSERT `restoring the connection myself is an offence for` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE FALSE)
#ASSERT NOT (`restoring the connection myself is an offence for` (`np` (Date 2 3 2026) NOTHING FALSE (JUST (Date 20 3 2026)) `disconnect the premises` (Date 31 3 2026) NOTHING TRUE TRUE TRUE))

§ `Goal 3 — redress and resale`

-- R1 - R1c: s 27K(1)-(2)
#ASSERT `can order` (Date 10 3 2020) TRUE TRUE FALSE NOTHING NOTHING NOTHING (Date 10 3 2025)
#ASSERT NOT (`can order` (Date 10 3 2020) TRUE TRUE FALSE NOTHING NOTHING NOTHING (Date 11 3 2025))
#ASSERT `can order` (Date 10 3 2020) TRUE TRUE FALSE NOTHING (JUST (Date 1 3 2025)) NOTHING (Date 11 3 2025)
#ASSERT `can order` (Date 10 3 2020) TRUE TRUE FALSE NOTHING NOTHING (JUST (Date 1 3 2025)) (Date 11 3 2025)
#ASSERT `can order` (Date 29 2 2020) TRUE TRUE FALSE NOTHING NOTHING NOTHING (Date 28 2 2025)
#ASSERT NOT (`can order` (Date 29 2 2020) TRUE TRUE FALSE NOTHING NOTHING NOTHING (Date 1 3 2025))
-- R2 - R2b: s 27K(3)
#ASSERT `can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`a final order` (Date 30 11 2024))) (JUST (Date 28 2 2025)) NOTHING (Date 1 6 2025)
#ASSERT NOT (`can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`a final order` (Date 30 11 2024))) (JUST (Date 1 3 2025)) NOTHING (Date 1 6 2025))
#ASSERT `can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`a confirmed provisional order` (Date 15 1 2025))) (JUST (Date 15 4 2025)) NOTHING (Date 1 6 2025)
#ASSERT NOT (`can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`a confirmed provisional order` (Date 15 1 2025))) (JUST (Date 16 4 2025)) NOTHING (Date 1 6 2025))
#ASSERT `can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`an unconfirmed provisional order` (Date 31 8 2024))) (JUST (Date 28 2 2025)) NOTHING (Date 1 6 2025)
#ASSERT NOT (`can order` (Date 1 6 2024) TRUE TRUE FALSE (JUST (`an unconfirmed provisional order` (Date 31 8 2024))) (JUST (Date 1 3 2025)) NOTHING (Date 1 6 2025))
-- R3, R4, R5
#ASSERT NOT (`can order` (Date 10 3 2024) TRUE TRUE TRUE NOTHING NOTHING NOTHING (Date 10 3 2025))
#ASSERT NOT (`can order` (Date 10 3 2010) TRUE FALSE FALSE NOTHING NOTHING NOTHING (Date 10 3 2014))
#ASSERT NOT (`can order` (Date 10 3 2024) FALSE TRUE FALSE NOTHING NOTHING NOTHING (Date 10 3 2025))

-- R6, R6a: s 27G(5)
#ASSERT `the compliance date is lawful for` (`ro` (Date 24 12 2025) (Date 31 12 2025) NOTHING NOTHING NOTHING 1000000 0)
#ASSERT NOT (`the compliance date is lawful for` (`ro` (Date 24 12 2025) (Date 30 12 2025) NOTHING NOTHING NOTHING 1000000 0))
#ASSERT `the compliance date is lawful for` (`ro` (Date 25 2 2028) (Date 3 3 2028) NOTHING NOTHING NOTHING 1000000 0)
#ASSERT NOT (`the compliance date is lawful for` (`ro` (Date 25 2 2028) (Date 2 3 2028) NOTHING NOTHING NOTHING 1000000 0))
-- R7, R7a: s 27M(2), (5)
#ASSERT `the supplier's last day to appeal for` (`ro` (Date 1 3 2026) (Date 31 3 2026) NOTHING NOTHING NOTHING 1000000 0) EQUALS Date 12 4 2026
#ASSERT `compliance is suspended by an appeal for` (`ro` (Date 1 3 2026) (Date 31 3 2026) (JUST (Date 12 4 2026)) NOTHING NOTHING 1000000 0)
#ASSERT NOT (`compliance is suspended by an appeal for` (`ro` (Date 1 3 2026) (Date 31 3 2026) (JUST (Date 13 4 2026)) NOTHING NOTHING 1000000 0))
-- R8, R8a: s 27N(1)
#ASSERT `interest on my compensation runs from` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING NOTHING 1000000 0) EQUALS JUST (Date 1 2 2026)
#ASSERT `interest on my compensation runs from` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING (JUST (Date 31 1 2026)) 1000000 0) EQUALS NOTHING
#ASSERT `interest on my compensation runs from` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING (JUST (Date 1 2 2026)) 1000000 0) EQUALS JUST (Date 1 2 2026)
-- R9, R9a, R9b: s 27O
#ASSERT `the most compensation for the contravention under` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING NOTHING 1000000 0) EQUALS 100000
#ASSERT `the most compensation for the contravention under` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING NOTHING 1000000 60000) EQUALS 40000
#ASSERT `the most compensation for the contravention under` (`ro` (Date 20 1 2026) (Date 31 1 2026) NOTHING NOTHING NOTHING 1000000 120000) EQUALS 0

-- R10 - R10c: s 44 (totals, in pounds, for 1,000 kWh)
#ASSERT `resale` 350 300 NOTHING 0 EQUALS 50
#ASSERT `resale` 280 300 NOTHING 0 EQUALS 0
#ASSERT `resale` 300 300 (JUST 270) 0 EQUALS 30
#ASSERT `resale` 350 300 NOTHING 5 EQUALS 55

§ `Top-level goal`

caseA MEANS `Electricity customer case` OF bh, (JUST (`kept` (JUST (Date 21 12 2026)) NOTHING)), NOTHING, NOTHING, NOTHING, NOTHING, (JUST (`Resale facts` OF 350, 300, NOTHING, 0))

posA MEANS `the electricity customer position for` caseA

#ASSERT posA's `earliest disconnection under s 17(1)(c)` EQUALS JUST (Date 4 1 2027)
#ASSERT posA's `recoverable on resale` EQUALS JUST 50
#ASSERT posA's `redress order can be made` EQUALS NOTHING
