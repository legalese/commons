IMPORT prelude
IMPORT daydate

-- Employment Rights Act 2025 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2025-36.txt (point in time
-- 1 July 2026).

§ `Nouns`

DECLARE `Sickness facts` HAS
    `normal weekly earnings`                            IS A NUMBER
    -- SSCBA s 152(2) as amended: the days of incapacity in the period.
    `first day of incapacity`                           IS A DATE
    `days of incapacity`                                IS A NUMBER

DECLARE `Dismissal facts` HAS
    `continuous employment began on`                    IS A DATE
    -- ERA 1996 s 97(1), as extended by s 97(2) or (4).
    `effective date of termination`                     IS A DATE
    `dismissed for a s 64(2) requirement`               IS A BOOLEAN
    `a reason needing no qualifying period`             IS A BOOLEAN

-- ERA 1996 s 27BG: the kind of complaint, by the s 27BH subsection that
-- times it.
DECLARE `Complaint kind` IS ONE OF
    -- s 27BH(1): no offer by the end of the offer period (trigger: the last
    -- day of the offer period).
    `no guaranteed hours offer (27BG(1))`
    -- (2)-(3): an offer not compliant, or (4) reduced (trigger: the offer).
    `a defective or reduced offer (27BG(2)-(4))`
    -- (4): preventing qualification (trigger: what would have been the last
    -- day of the offer period).
    `preventing qualification (27BG(5))`
    -- (5): failure to give a notice (trigger: the day it should have been
    -- given).
    `failure to give a notice (27BG(7)(a))`
    -- (6): a notice wrongly given (trigger: the notice).
    `a notice wrongly given (27BG(7)(b)-(c))`
    -- (7): information duty under s 27BF(1) (trigger: the last day of the
    -- initial information period).
    `initial information failure (27BG(8)(a))`
    -- (8): s 27BF(2) (trigger: the day the worker first becomes aware).
    `other information failure (27BG(8)(b))`

DECLARE `Early conciliation` HAS
    `Day A`                                             IS A DATE
    `Day B`                                             IS A DATE

DECLARE `Complaint facts` HAS
    `kind`                                              IS A `Complaint kind`
    `trigger day`                                       IS A DATE
    `early conciliation`                                IS A MAYBE `Early conciliation`
