IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc3-helpers`
IMPORT `ssc3-a-s43-s44`
IMPORT `ssc3-b-s44a-s44c`

-- Tests for ssc3-b-s44a-s44c.l4 (ss 44A, 44B, 44C).
-- Every expected value is written by hand from the text of the section named beside it; none is copied from the encoding's output.

§ `Fixtures`

GIVEN sex IS A Sex, born IS A DATE
GIVETH A Person
`a pensioner of the sex born on` MEANS
    Person WITH
        `date of birth` IS born
        `sex` IS sex
        `marital status` IS `married`
        `date of attaining pensionable age` IS Date 1 1 2020

GIVEN day IS A DATE
GIVETH A Person
`a pensioner attaining pensionable age on` MEANS
    Person WITH
        `date of birth` IS Date 1 1 1950
        `sex` IS Woman
        `marital status` IS `married`
        `date of attaining pensionable age` IS day

§ `Section 44A: deemed earnings factors`

-- (A1): the first appointed year or a later year before 2010-11.
#ASSERT `s 44A(A1) subsections (1) to (4) apply to the year` (`Tax year` OF 2009) TRUE EQUALS JUST TRUE
#ASSERT `s 44A(A1) subsections (1) to (4) apply to the year` (`Tax year` OF 2010) TRUE EQUALS NOTHING
#ASSERT `s 44A(A1) subsections (1) to (4) apply to the year` (`Tax year` OF 2005) FALSE EQUALS NOTHING
-- (2)(a): from the qualifying earnings factor (5000, inclusive) up to the low earnings threshold (9500, exclusive).
#ASSERT `s 44A(2)(a) the earnings factor lies from the qualifying earnings factor up to the low earnings threshold` 5000 5000 9500
#ASSERT `s 44A(2)(a) the earnings factor lies from the qualifying earnings factor up to the low earnings threshold` 9499 5000 9500
#ASSERT (NOT (`s 44A(2)(a) the earnings factor lies from the qualifying earnings factor up to the low earnings threshold` 4999 5000 9500))
#ASSERT (NOT (`s 44A(2)(a) the earnings factor lies from the qualifying earnings factor up to the low earnings threshold` 9500 5000 9500))
-- (2)(b): carer's allowance payable throughout the year, or would have been but for the reduction to nil.
#ASSERT `s 44A(2)(b) carer's allowance condition` TRUE FALSE
#ASSERT `s 44A(2)(b) carer's allowance condition` FALSE TRUE
#ASSERT (NOT (`s 44A(2)(b) carer's allowance condition` FALSE FALSE))
-- (2)(c): child benefit for a child under six (s 173's answer), or another prescribed condition.
#ASSERT `s 44A(2)(c) responsibilities at home condition` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 44A(2)(c) responsibilities at home condition` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 44A(2)(c) responsibilities at home condition` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 44A(2)(c) responsibilities at home condition` FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 44A(2)(c) responsibilities at home condition` FALSE NOTHING FALSE EQUALS JUST FALSE
-- (2)(d): the (3) requirement together with incapacity benefit payable, or the two "but for" cases.
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) TRUE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE FALSE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE FALSE TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE FALSE TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE FALSE TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST TRUE) FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44A(2)(d) incapacity benefit condition` (JUST FALSE) TRUE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44A(2)(d) incapacity benefit condition` NOTHING TRUE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- (1) with (2): any of the conditions.
#ASSERT `s 44A(2) any of the conditions in subsection (2) is satisfied` FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44A(2) any of the conditions in subsection (2) is satisfied` TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44A(2) any of the conditions in subsection (2) is satisfied` FALSE FALSE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 44A(2) any of the conditions in subsection (2) is satisfied` FALSE FALSE NOTHING (JUST TRUE) EQUALS JUST TRUE
-- (1): the deemed factor brings the aggregate up to the low earnings threshold (9500).
#ASSERT `s 44A(1) the deemed earnings factor in pounds` (JUST TRUE) 9500 8000 EQUALS JUST 1500
#ASSERT `s 44A(1) the deemed earnings factor in pounds` (JUST TRUE) 9500 9500 EQUALS JUST 0
#ASSERT `s 44A(1) the deemed earnings factor in pounds` (JUST TRUE) 9500 9600 EQUALS NOTHING
#ASSERT `s 44A(1) the deemed earnings factor in pounds` (JUST FALSE) 9500 8000 EQUALS NOTHING
#ASSERT `s 44A(1) the deemed earnings factor in pounds` NOTHING 9500 8000 EQUALS NOTHING
-- (4)(a) and (b): the working life, and one tenth of it rounded to the nearest whole year, half a year rounded down.
#ASSERT `s 44A(4)(a) the pensioner's working life in years` 40 5 3 EQUALS 32
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 32 EQUALS 3
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 25 EQUALS 2
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 26 EQUALS 3
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 24 EQUALS 2
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 5 EQUALS 0
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 6 EQUALS 1
#ASSERT `s 44A(4)(b) one tenth of the working life rounded to the nearest whole year` 4 EQUALS 0
-- (3): at least one year with the full factor, and those years at least one tenth of the working life.
#ASSERT `s 44A(3) the requirement referred to in subsection (2)(d) is satisfied` 1 1
#ASSERT `s 44A(3) the requirement referred to in subsection (2)(d) is satisfied` 3 3
#ASSERT `s 44A(3) the requirement referred to in subsection (2)(d) is satisfied` 1 0
#ASSERT (NOT (`s 44A(3) the requirement referred to in subsection (2)(d) is satisfied` 0 0))
#ASSERT (NOT (`s 44A(3) the requirement referred to in subsection (2)(d) is satisfied` 2 3))
-- (4A): the requirement and subsections (3) and (4) do not apply to a pensioner attaining pensionable age on or after 6 April 2010.
#ASSERT `s 44A(4A) the requirement in subsection (2)(d) and subsections (3) and (4) apply to the pensioner` (`a pensioner attaining pensionable age on` (Date 6 4 2010)) EQUALS JUST FALSE
#ASSERT `s 44A(4A) the requirement in subsection (2)(d) and subsections (3) and (4) apply to the pensioner` (`a pensioner attaining pensionable age on` (Date 5 4 2010)) EQUALS NOTHING
-- (5): 9,500 pounds, unless altered under section 148A.
#ASSERT `s 44A(5) the low earnings threshold in pounds` TRUE NOTHING EQUALS JUST 9500
#ASSERT `s 44A(5) the low earnings threshold in pounds` TRUE (JUST 10000) EQUALS JUST 10000
#ASSERT `s 44A(5) the low earnings threshold in pounds` FALSE NOTHING EQUALS NOTHING
-- (5A): same meaning as in section 44.
#ASSERT `s 44A(5A) the applicable limit in pounds` (`Earnings limits` OF (`Tax year` OF 2008), 87, 100, 3000, 90) EQUALS 3000
#ASSERT `s 44A(5A) the applicable limit in pounds` (`Earnings limits` OF (`Tax year` OF 2010), 95, 110, 3500, 100) EQUALS 770
-- (6): the scheme meanings are s 30DD(6)'s.
#ASSERT `s 44A(6) the scheme is an occupational pension scheme` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44A(6) the scheme is an occupational pension scheme` NOTHING EQUALS NOTHING
#ASSERT `s 44A(6) the scheme is a personal pension scheme` (JUST FALSE) EQUALS JUST FALSE
-- (7): qualifying employment and support allowance.
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 1 1 1950)) TRUE 52 FALSE FALSE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 1 1 1950)) TRUE 51 FALSE FALSE))
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 1 1 1950)) TRUE 4 TRUE FALSE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 1 1 1950)) FALSE 52 TRUE TRUE))
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 6 4 1944)) TRUE 13 FALSE TRUE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 5 4 1944)) TRUE 13 FALSE TRUE))
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 5 4 1947)) TRUE 13 FALSE TRUE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 6 4 1947)) TRUE 13 FALSE TRUE))
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Woman (Date 6 4 1949)) TRUE 13 FALSE TRUE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Woman (Date 5 4 1949)) TRUE 13 FALSE TRUE))
#ASSERT `s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Woman (Date 5 4 1951)) TRUE 13 FALSE TRUE
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Woman (Date 6 4 1951)) TRUE 13 FALSE TRUE))
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Woman (Date 1 1 1945)) TRUE 13 FALSE TRUE))
#ASSERT (NOT (`s 44A(7) the allowance is qualifying employment and support allowance` (`a pensioner of the sex born on` Man (Date 1 1 1950)) TRUE 13 FALSE TRUE))

§ `Section 44B: deemed earnings factors, 2010-11 onwards`

#ASSERT `s 44B(1) this section applies to the year` (`Tax year` OF 2010) EQUALS JUST TRUE
#ASSERT `s 44B(1) this section applies to the year` (`Tax year` OF 2009) EQUALS NOTHING
-- (3): Condition A: from the QEF (5000) up to, not including, the threshold (9500).
#ASSERT `s 44B(3) Condition A is satisfied` 5000 5000 9500
#ASSERT (NOT (`s 44B(3) Condition A is satisfied` 4999 5000 9500))
#ASSERT (NOT (`s 44B(3) Condition A is satisfied` 9500 5000 9500))
-- (4): Condition B: below the QEF, with credits exactly equal to the difference.
#ASSERT `s 44B(4) Condition B is satisfied` 3000 5000 2000
#ASSERT (NOT (`s 44B(4) Condition B is satisfied` 3000 5000 1999))
#ASSERT (NOT (`s 44B(4) Condition B is satisfied` 3000 5000 2001))
#ASSERT (NOT (`s 44B(4) Condition B is satisfied` 5000 5000 0))
-- (5): Condition C: 52 credits.
#ASSERT `s 44B(5) Condition C is satisfied` 52
#ASSERT (NOT (`s 44B(5) Condition C is satisfied` 51))
#ASSERT `s 44B(5) Condition C is satisfied` 53
-- (2): the deemed factor brings the aggregate up to the threshold; from the flat rate introduction year the text names a range, not an amount.
#ASSERT `s 44B(2) the deemed earnings factor in pounds` TRUE FALSE FALSE FALSE 9500 6000 EQUALS JUST 3500
#ASSERT `s 44B(2) the deemed earnings factor in pounds` FALSE TRUE FALSE FALSE 9500 6000 EQUALS JUST 3500
#ASSERT `s 44B(2) the deemed earnings factor in pounds` FALSE FALSE TRUE FALSE 9500 6000 EQUALS JUST 3500
#ASSERT `s 44B(2) the deemed earnings factor in pounds` FALSE FALSE FALSE FALSE 9500 6000 EQUALS NOTHING
#ASSERT `s 44B(2) the deemed earnings factor in pounds` TRUE FALSE FALSE FALSE 9500 9600 EQUALS NOTHING
#ASSERT `s 44B(2) the deemed earnings factor in pounds` FALSE TRUE FALSE TRUE 9500 6000 EQUALS NOTHING
-- (6): from the flat rate introduction year Condition A is omitted and the aggregate is a range.
#ASSERT `s 44B(6)(b) Condition A is available` TRUE EQUALS JUST FALSE
#ASSERT `s 44B(6)(b) Condition A is available` FALSE EQUALS NOTHING
#ASSERT `s 44B(6)(a) the aggregate is one that subsection (2)(b) refers to` TRUE 6000 5000 9500
#ASSERT (NOT (`s 44B(6)(a) the aggregate is one that subsection (2)(b) refers to` TRUE 5000 5000 9500))
#ASSERT (NOT (`s 44B(6)(a) the aggregate is one that subsection (2)(b) refers to` TRUE 9500 5000 9500))
#ASSERT `s 44B(6)(a) the aggregate is one that subsection (2)(b) refers to` FALSE 9500 5000 9500
#ASSERT (NOT (`s 44B(6)(a) the aggregate is one that subsection (2)(b) refers to` FALSE 9000 5000 9500))
-- (7)(b), (c).
#ASSERT `s 44B(7)(b) the low earnings threshold in pounds` TRUE NOTHING EQUALS JUST 9500
#ASSERT `s 44B(7)(c) the pensioner's earnings factor for a relevant year` 1234 EQUALS 1234

§ `Section 44C: earnings factor credits`

#ASSERT `s 44C(1) this section applies to the year` (`Tax year` OF 2010) EQUALS JUST TRUE
#ASSERT `s 44C(1) this section applies to the year` (`Tax year` OF 2009) EQUALS NOTHING
-- (3): eligibility, limb by limb. Order of inputs: relevant carer; carer's allowance payable; would have been; severe disablement allowance; long-term incapacity benefit payable; failed contribution conditions; reduced to nil (benefits); reduced to nil (scheme payments); occupational; personal; other prescribed.
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` NOTHING FALSE FALSE TRUE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE TRUE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE TRUE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE TRUE FALSE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 44C(3) the pensioner is eligible for earnings factor enhancement in respect of the week` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE
-- (2): 1/52 of the QEF for each eligible week in a relevant year to which the section applies.
#ASSERT `s 44C(2) the earnings factor credit for the week in pounds` TRUE (JUST TRUE) 5200 EQUALS JUST 100
#ASSERT `s 44C(2) the earnings factor credit for the week in pounds` TRUE (JUST FALSE) 5200 EQUALS NOTHING
#ASSERT `s 44C(2) the earnings factor credit for the week in pounds` FALSE (JUST TRUE) 5200 EQUALS NOTHING
#ASSERT `s 44C(2) the earnings factor credit for the week in pounds` TRUE NOTHING 5200 EQUALS NOTHING
-- (5): the aggregate for Condition B is capped at the difference between the QEF and the earnings factor.
#ASSERT `s 44C(5) the aggregate amount of credits the pensioner is entitled to for Condition B` 2400 5200 3000 EQUALS 2200
#ASSERT `s 44C(5) the aggregate amount of credits the pensioner is entitled to for Condition B` 2000 5200 3000 EQUALS 2000
-- (6): a week that begins in one tax year and ends in the next is treated as falling in the year it begins in.
#ASSERT `s 44C(6) the tax year the week is treated as falling in` (Date 3 4 2011) EQUALS `Tax year` OF 2010
#ASSERT `s 44C(6) the tax year the week is treated as falling in` (Date 5 4 2011) EQUALS `Tax year` OF 2010
#ASSERT `s 44C(6) the tax year the week is treated as falling in` (Date 6 4 2011) EQUALS `Tax year` OF 2011
-- (4): scheme meanings are s 30DD(6)'s.
#ASSERT `s 44C(4) the scheme is an occupational pension scheme` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44C(4) the scheme is a personal pension scheme` NOTHING EQUALS NOTHING
-- (7)(b): credits are treated as an earnings factor of that amount.
#ASSERT `s 44C(7)(b) the earnings factor the person is treated as having for the year by virtue of subsection (2)` 1300 EQUALS 1300
