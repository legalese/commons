IMPORT prelude
IMPORT `ssc5-logic`

-- Tests for the helpers of ssc5-logic.l4.  Expected values are the Kleene truth tables, written by hand:
-- a conjunction with a false member is false even if the other is unknown; with an unknown and a true member
-- it stays unknown; a disjunction is the dual.

#ASSERT `s 124(1) both hold` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 124(1) both hold` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 124(1) both hold` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 124(1) both hold` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 124(1) both hold` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 124(1) both hold` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 124(1) both hold` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 124(1) both hold` NOTHING NOTHING EQUALS NOTHING

#ASSERT `s 124(1) either holds` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 124(1) either holds` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 124(1) either holds` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 124(1) either holds` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 124(1) either holds` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 124(1) either holds` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 124(1) either holds` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 124(1) either holds` NOTHING NOTHING EQUALS NOTHING

#ASSERT `s 124(1) does not hold` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 124(1) does not hold` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 124(1) does not hold` NOTHING EQUALS NOTHING

#ASSERT `s 124(1) is known to hold` (JUST TRUE) EQUALS TRUE
#ASSERT `s 124(1) is known to hold` (JUST FALSE) EQUALS FALSE
#ASSERT `s 124(1) is known to hold` NOTHING EQUALS FALSE

#ASSERT `s 124(1) holds or else nothing` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 124(1) holds or else nothing` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 124(1) holds or else nothing` NOTHING EQUALS NOTHING

#ASSERT `s 124(1) the fact as an answer` TRUE EQUALS JUST TRUE
#ASSERT `s 124(1) the fact as an answer` FALSE EQUALS JUST FALSE

#ASSERT `s 124(1) all of these hold` EMPTY EQUALS JUST TRUE
#ASSERT `s 124(1) all of these hold` (LIST JUST TRUE, JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 124(1) all of these hold` (LIST JUST TRUE, NOTHING, JUST TRUE) EQUALS NOTHING
#ASSERT `s 124(1) all of these hold` (LIST JUST TRUE, NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 124(1) all of these hold` (LIST JUST FALSE, JUST TRUE, NOTHING) EQUALS JUST FALSE
