IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc4-carers-allowance`

-- TESTS for ssc4-carers-allowance.l4 (s 70; ss 68 and 69 are blank in this text). Expected values are written from the text beside each assertion.

§ `Tests -- s 70`

§§ `s 70(2) -- who is a severely disabled person`

#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) attendance allowance` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) disability living allowance, care component at the highest rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) disability living allowance, care component at the middle rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) personal independence payment, daily living component at the standard rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) personal independence payment, daily living component at the enhanced rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) adult disability payment, daily living component at the standard rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) adult disability payment, daily living component at the enhanced rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) child disability payment, care component at the middle rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) child disability payment, care component at the highest rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) Scottish adult disability living allowance, care component at the middle rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) Scottish adult disability living allowance, care component at the highest rate` NOTHING EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) pension age disability payment` NOTHING EQUALS JUST TRUE
-- "means": a payment the definition does not name (the lowest rate of the care component, say) is JUST FALSE.
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) a payment the definition does not name` NOTHING EQUALS JUST FALSE
-- "such other payment ... as may be prescribed": the prescription is an input.
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) such other payment out of public funds on account of his need for attendance` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) such other payment out of public funds on account of his need for attendance` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 70(2) the person cared for is a severely disabled person` `s 70(2) such other payment out of public funds on account of his need for attendance` NOTHING EQUALS NOTHING

§§ `s 70(1) -- entitlement for a day`

-- All of (a), (b), (c) satisfied: entitled. Gainfully employed, not regularly and substantially engaged, not caring on the day: JUST FALSE. The prescribed relation unknown: NOTHING.
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` FALSE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE TRUE FALSE NOTHING EQUALS NOTHING
-- A known failure of another limb beats an unknown prescribed relation.
#ASSERT `s 70(1) the person is entitled to a carer's allowance for the day` TRUE TRUE TRUE NOTHING EQUALS JUST FALSE

§§ `s 70(1A) -- continuing entitlement after the death`

-- The weekday helper: 5 January 2025 was a Sunday (0), 8 January a Wednesday (3), 11 January a Saturday (6), 12 January a Sunday again (0).
#ASSERT `s 70(1A) the days since the last Sunday` (Date 5 1 2025) EQUALS 0
#ASSERT `s 70(1A) the days since the last Sunday` (Date 8 1 2025) EQUALS 3
#ASSERT `s 70(1A) the days since the last Sunday` (Date 11 1 2025) EQUALS 6
#ASSERT `s 70(1A) the days since the last Sunday` (Date 12 1 2025) EQUALS 0
#ASSERT `s 70(1A) the days since the last Sunday` (Date 31 12 2024) EQUALS 2

-- Death on Sunday 5 January 2025, no other requirement ceases: eight weeks begin with the date of death and end Saturday 1 March 2025 (5 January + 55 days).
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 5 1 2025) NOTHING (Date 1 3 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 5 1 2025) NOTHING (Date 2 3 2025) EQUALS JUST FALSE
-- The death day itself is covered.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 5 1 2025) NOTHING (Date 5 1 2025) EQUALS JUST TRUE
-- A day before the death is outside the continuation.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 5 1 2025) NOTHING (Date 4 1 2025) EQUALS NOTHING
-- Death on Wednesday 8 January 2025: the Sunday following is 12 January, so the eight weeks end Saturday 8 March 2025.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) NOTHING (Date 8 3 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) NOTHING (Date 9 3 2025) EQUALS JUST FALSE
-- The person ceases to satisfy another requirement on Wednesday 15 January 2025: the end of that week (Sunday to Saturday) is 18 January, which is earlier than 8 March.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 15 1 2025)) (Date 18 1 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 15 1 2025)) (Date 19 1 2025) EQUALS JUST FALSE
-- Ceasing on Saturday 18 January: the week ends that day. Ceasing on Sunday 19 January: the week ends 25 January.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 18 1 2025)) (Date 18 1 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 18 1 2025)) (Date 19 1 2025) EQUALS JUST FALSE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 19 1 2025)) (Date 25 1 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 19 1 2025)) (Date 26 1 2025) EQUALS JUST FALSE
-- Ceasing after the eight weeks have run: the eight weeks (ending 8 March) come first.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 20 3 2025)) (Date 8 3 2025) EQUALS JUST TRUE
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` TRUE (Date 8 1 2025) (JUST (Date 20 3 2025)) (Date 9 3 2025) EQUALS JUST FALSE
-- Not entitled immediately before the death: the rule does not apply.
#ASSERT `s 70(1A) the person continues to be entitled to a carer's allowance for the day` FALSE (Date 8 1 2025) NOTHING (Date 9 1 2025) EQUALS NOTHING

§§ `s 70(3) to (4A) -- bars`

-- s 70(3): under 16 or in full-time education: barred. Neither: "if" fails, no bar (FALSE). Age unknown and not in education: NOTHING.
#ASSERT `s 70(3) the person is barred from a carer's allowance by age or education` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 70(3) the person is barred from a carer's allowance by age or education` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 70(3) the person is barred from a carer's allowance by age or education` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 70(3) the person is barred from a carer's allowance by age or education` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 70(3) the person is barred from a carer's allowance by age or education` NOTHING TRUE EQUALS JUST TRUE

-- s 70(4): the prescribed conditions satisfied: "unless" met, no bar (FALSE); not satisfied: barred (TRUE); unknown: NOTHING.
#ASSERT `s 70(4) the person is barred from a carer's allowance by the residence and presence conditions` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 70(4) the person is barred from a carer's allowance by the residence and presence conditions` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 70(4) the person is barred from a carer's allowance by the residence and presence conditions` NOTHING EQUALS NOTHING

#ASSERT `s 70(4A) the person is barred from a carer's allowance for the period by the Regulations` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 70(4A) the person is barred from a carer's allowance for the period by the Regulations` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 70(4A) the person is barred from a carer's allowance for the period by the Regulations` FALSE FALSE EQUALS NOTHING

§§ `s 70(7) to (7B) -- one allowance, joint elections, the Scottish provisions`

-- s 70(7): two allowances for the same day: barred. One allowance and carer support payment: barred. One allowance alone: NOTHING.
#ASSERT `s 70(7) the person is barred from a further allowance for the day` 2 FALSE EQUALS JUST TRUE
#ASSERT `s 70(7) the person is barred from a further allowance for the day` 1 TRUE EQUALS JUST TRUE
#ASSERT `s 70(7) the person is barred from a further allowance for the day` 1 FALSE EQUALS NOTHING
#ASSERT `s 70(7) the person is barred from a further allowance for the day` 0 TRUE EQUALS NOTHING

-- s 70(7ZA): fewer than two persons: NOTHING. Two persons: the joint election names this person (TRUE) or another (FALSE); in default the Secretary of State's determination decides; neither yet: NOTHING.
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 1 (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 2 (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 2 (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 2 NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 3 NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 70(7ZA) the person is the one who has the relevant entitlement for the day` 2 NOTHING NOTHING EQUALS NOTHING

#ASSERT `s 70(7ZB) subsection (7ZC) applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 70(7ZB) subsection (7ZC) applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 70(7ZB) subsection (7ZC) applies` FALSE FALSE EQUALS NOTHING

-- s 70(7ZC): where it applies, B is barred unless (a) the joint election or (b) the Secretary of State's satisfaction in default.
#ASSERT `s 70(7ZC) the other person B is barred from a relevant entitlement for the day` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 70(7ZC) the other person B is barred from a relevant entitlement for the day` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 70(7ZC) the other person B is barred from a relevant entitlement for the day` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 70(7ZC) the other person B is barred from a relevant entitlement for the day` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 70(7ZC) the other person B is barred from a relevant entitlement for the day` (JUST FALSE) TRUE TRUE EQUALS NOTHING

#ASSERT `s 70(7A) the person has a relevant entitlement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 70(7A) the person has a relevant entitlement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 70(7A) the person has a relevant entitlement` FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 70(7B) the payment is carer support payment` TRUE EQUALS JUST TRUE
#ASSERT `s 70(7B) the payment is carer support payment` FALSE EQUALS JUST FALSE

§§ `s 70(9) -- the rate`

-- The Schedule 4 figure is an input; 83.5 is a test number only.
#ASSERT `s 70(9) the weekly rate of a carer's allowance in pounds` (JUST 83.5) EQUALS JUST 83.5
#ASSERT `s 70(9) the weekly rate of a carer's allowance in pounds` NOTHING EQUALS NOTHING
