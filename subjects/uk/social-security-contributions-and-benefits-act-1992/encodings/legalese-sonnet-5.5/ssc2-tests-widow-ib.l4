#ASSERT `s 40(6)(b) the weekly rate of the Category A retirement pension in pounds` NOTHING EQUALS NOTHING
-- (7): the days treated as days of entitlement
#ASSERT `s 40(7) the number of days treated as days of entitlement to short-term incapacity benefit` TRUE TRUE 100 EQUALS JUST 100
#ASSERT `s 40(7) the number of days treated as days of entitlement to short-term incapacity benefit` TRUE FALSE 100 EQUALS NOTHING
#ASSERT `s 40(7) the number of days treated as days of entitlement to short-term incapacity benefit` FALSE TRUE 100 EQUALS NOTHING
-- (8): including
