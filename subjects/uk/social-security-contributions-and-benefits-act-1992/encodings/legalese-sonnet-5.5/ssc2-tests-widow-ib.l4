-- arguments: the day her husband died, the day she ceased to be entitled to a widowed mother's allowance
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 6 4 1979) NOTHING EQUALS JUST TRUE
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 5 4 1979) NOTHING EQUALS JUST FALSE
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 5 4 1979) (JUST (Date 6 4 1979)) EQUALS JUST TRUE
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 5 4 1979) (JUST (Date 5 4 1979)) EQUALS JUST FALSE
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 1 1 1970) (JUST (Date 1 1 1985)) EQUALS JUST TRUE
#ASSERT `s 40(2) the section is not excluded by subsection (2)` (Date 1 1 1970) (JUST (Date 1 1 1975)) EQUALS JUST FALSE

§ `Tests -- s 40(1): to whom the section applies`

-- arguments: (2) answer, not entitled to a widowed mother's allowance on his death (a), ceases to be entitled (a), incapable of work (b), would have been entitled to a widow's pension over 45 (c)(i), entitled with a reduction (c)(ii), entitled to incapacity benefit apart from this section (d)
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) TRUE FALSE (JUST TRUE) (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) FALSE TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 40(1) the section applies to the woman` (JUST FALSE) TRUE FALSE (JUST TRUE) (JUST TRUE) NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 40(1) the section applies to the woman` NOTHING TRUE FALSE (JUST TRUE) (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE
-- a condition fails: the grant is limited by its own wording, so not covered
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) FALSE FALSE (JUST TRUE) (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) TRUE FALSE (JUST FALSE) (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) TRUE FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) TRUE FALSE (JUST TRUE) (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `s 40(1) the section applies to the woman` (JUST TRUE) TRUE FALSE NOTHING (JUST TRUE) NOTHING FALSE EQUALS NOTHING

§ `Tests -- s 40(3), (4): the days of entitlement`

-- (3) arguments: applies, a day of incapacity in a period, the day, the time of the husband's death or the end of the widowed mother's allowance, the first day of the period, the number of the day in the period
-- the period began on 1 May 2024, before the time, 1 June 2024; the day is after the time and the 365th day
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS JUST TRUE
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 364 EQUALS NOTHING
-- the period began on the very day of the time, which is not "before"
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 6 2024) 365 EQUALS NOTHING
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 31 5 2024) 365 EQUALS JUST TRUE
-- the day must be after the time
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 1 6 2024) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS NOTHING
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (Date 2 6 2024) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS JUST TRUE
-- the section does not apply, or the day is not a day of incapacity
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST FALSE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS NOTHING
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` (JUST TRUE) (JUST FALSE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS NOTHING
#ASSERT `s 40(3) the woman is entitled to long-term incapacity benefit under this section for the day` NOTHING (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 365 EQUALS NOTHING
-- (4): terminally ill
#ASSERT `s 40(4) the woman is terminally ill` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 40(4) the woman is terminally ill` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 40(4) the woman is terminally ill` FALSE TRUE EQUALS JUST FALSE
-- "not entitled under (3)": entitled under (3) is a no; no entitlement under (3), or (3) not covered, is a yes
#ASSERT `s 40(4) the woman is not entitled to long-term incapacity benefit under subsection (3)` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 40(4) the woman is not entitled to long-term incapacity benefit under subsection (3)` NOTHING EQUALS JUST TRUE
#ASSERT `s 40(4) the woman is not entitled to long-term incapacity benefit under subsection (3)` (JUST FALSE) EQUALS JUST TRUE
-- (4) arguments: applies, not entitled under (3), terminally ill, a day of incapacity in a period, the day, the time, the first day of the period, the number of the day
-- (4) is a grant worded "A woman to whom this section applies who is not entitled ... but who is terminally ill, is entitled": a failed condition in it leaves the grant unanswered (NOTHING), not a no.
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS JUST TRUE
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 196 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 6 2024) 197 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 6 2024) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS NOTHING
#ASSERT `s 40(4) the woman is entitled to short-term incapacity benefit under this section for the day` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (Date 1 1 2025) (Date 1 6 2024) (Date 1 5 2024) 197 EQUALS NOTHING

