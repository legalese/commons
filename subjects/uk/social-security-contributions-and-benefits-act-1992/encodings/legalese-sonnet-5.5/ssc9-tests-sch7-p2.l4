IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc9-sch7-p2`

-- Tests for ssc9-sch7-p2.l4 (Schedule 7 Parts II and III). Expected values are written by hand from the text, beside each assertion.

§ `Tests -- Schedule 7 Parts II and III`

§§ `Paragraph 9(3) -- 90 days, disregarding Sundays`

-- An accident on Monday 4 November 2024: each week has six days that are not Sundays; 90 such days are 15 weeks, the 90th being Saturday
-- 15 February 2025 (Monday 4 Nov + 14 weeks = Monday 10 Feb 2025; its Saturday is 15 Feb). The first day after the 90 days is Sunday 16 Feb 2025.
#ASSERT `sch 7 pt II para 9(3) the first day after the 90 days` (Date 4 11 2024) EQUALS Date 16 2 2025
-- An accident on a Sunday, 3 November 2024: the Sunday is disregarded, so the count starts on Monday 4 Nov and the result is the same, 16 Feb 2025.
#ASSERT `sch 7 pt II para 9(3) the first day after the 90 days` (Date 3 11 2024) EQUALS Date 16 2 2025
-- An accident on a Saturday, 2 November 2024: Saturday 2 Nov is day 1; Monday 4 Nov to Saturday 8 Feb 2025 are 14 weeks of six days (84), making 85;
-- five more (Mon 10 Feb to Fri 14 Feb 2025) make 90. The first day after the 90th is Saturday 15 Feb 2025.
#ASSERT `sch 7 pt II para 9(3) the first day after the 90 days` (Date 2 11 2024) EQUALS Date 15 2 2025
-- Entitlement on the day: before the first day after the 90 days the sub-paragraph says no; on or after it, it says nothing.
#ASSERT `sch 7 pt II para 9(3) the person may be entitled to a gratuity on the day` (Date 4 11 2024) (Date 15 2 2025) EQUALS JUST FALSE
#ASSERT `sch 7 pt II para 9(3) the person may be entitled to a gratuity on the day` (Date 4 11 2024) (Date 16 2 2025) EQUALS NOTHING
#ASSERT `sch 7 pt II para 9(3) the person may be entitled to a gratuity on the day` (Date 4 11 2024) (Date 17 2 2025) EQUALS NOTHING

§§ `Paragraph 9(1), (2)`

-- Expected: employed earner, claim 30 Sep 1986, assessed 1 to 19 -> entitled; claim 1 Oct 1986, assessed 0.99, 20, or not an employed earner -> not entitled;
-- no assessment -> NOTHING.
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 30 9 1986) (JUST 1) EQUALS JUST TRUE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 30 9 1986) (JUST 19) EQUALS JUST TRUE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 30 9 1986) (JUST 0.99) EQUALS JUST FALSE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 30 9 1986) (JUST 20) EQUALS JUST FALSE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 1 10 1986) (JUST 10) EQUALS JUST FALSE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` FALSE (Date 30 9 1986) (JUST 10) EQUALS JUST FALSE
#ASSERT `sch 7 pt II para 9(1) the employed earner is entitled to a disablement gratuity` TRUE (Date 30 9 1986) NOTHING EQUALS NOTHING
-- 9(2)(a): the scale amount 800 is capped at the Schedule 4 maximum 700 -> 700; a scale amount 600 under the cap stays 600; an omitted cap or scale -> NOTHING.
#ASSERT `sch 7 pt II para 9(2)(a) the amount of the gratuity` (JUST 800) (JUST 700) EQUALS JUST 700
#ASSERT `sch 7 pt II para 9(2)(a) the amount of the gratuity` (JUST 600) (JUST 700) EQUALS JUST 600
#ASSERT `sch 7 pt II para 9(2)(a) the amount of the gratuity` (JUST 600) NOTHING EQUALS NOTHING
#ASSERT `sch 7 pt II para 9(2)(a) the amount of the gratuity` NOTHING (JUST 700) EQUALS NOTHING
-- 9(2)(b): instalments only as regulations provide.
#ASSERT `sch 7 pt II para 9(2)(b) the gratuity is payable by instalments` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 7 pt II para 9(2)(b) the gratuity is payable by instalments` NOTHING EQUALS NOTHING

§§ `Paragraph 10`

-- 10(1): in-patient period that commenced 5 Apr 1987 -> (a). Commenced 6 Apr 1987: only if within 28 days of the end of the last increased period.
-- Last increase ended 1 May 1987: a period commencing 29 May 1987 is within 28 days (1 May + 28 = 29 May); 30 May 1987 is not.
#ASSERT `sch 7 pt III para 10(1) this Part has effect in relation to the period` TRUE (Date 5 4 1987) NOTHING EQUALS JUST TRUE
#ASSERT `sch 7 pt III para 10(1) this Part has effect in relation to the period` TRUE (Date 6 4 1987) NOTHING EQUALS NOTHING
#ASSERT `sch 7 pt III para 10(1) this Part has effect in relation to the period` TRUE (Date 29 5 1987) (JUST (Date 1 5 1987)) EQUALS JUST TRUE
#ASSERT `sch 7 pt III para 10(1) this Part has effect in relation to the period` TRUE (Date 30 5 1987) (JUST (Date 1 5 1987)) EQUALS NOTHING
#ASSERT `sch 7 pt III para 10(1) this Part has effect in relation to the period` FALSE (Date 5 4 1987) NOTHING EQUALS NOTHING
-- 10(2), (3): assessed at 50, in-patient -> 100; assessed at 50, not in-patient -> not covered; assessed at 19 -> stays 19; assessed at 100 and in-patient -> 100? (not less than 100: not covered).
#ASSERT `sch 7 pt III para 10(2) the extent treated as assessed for the part of the period` 50 TRUE EQUALS JUST 100
#ASSERT `sch 7 pt III para 10(2) the extent treated as assessed for the part of the period` 50 FALSE EQUALS NOTHING
#ASSERT `sch 7 pt III para 10(2) the extent treated as assessed for the part of the period` 19 TRUE EQUALS JUST 19
#ASSERT `sch 7 pt III para 10(2) the extent treated as assessed for the part of the period` 20 TRUE EQUALS JUST 100
#ASSERT `sch 7 pt III para 10(2) the extent treated as assessed for the part of the period` 100 TRUE EQUALS NOTHING
-- 10(3): the weekly rate 80 less a prescribed gratuity value of 12 = 68; without a gratuity, or if not payable by virtue of this paragraph, 80.
#ASSERT `sch 7 pt III para 10(3) the weekly rate of the pension after the reduction` TRUE TRUE 80 12 EQUALS 68
#ASSERT `sch 7 pt III para 10(3) the weekly rate of the pension after the reduction` TRUE FALSE 80 12 EQUALS 80
#ASSERT `sch 7 pt III para 10(3) the weekly rate of the pension after the reduction` FALSE TRUE 80 12 EQUALS 80
