#ASSERT `s 37(1)(c) the woman is pregnant in the circumstances described` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 37(1)(c) the woman is pregnant in the circumstances described` FALSE TRUE EQUALS JUST FALSE
