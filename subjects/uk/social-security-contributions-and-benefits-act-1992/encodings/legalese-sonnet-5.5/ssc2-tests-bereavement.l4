#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving spouse` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving spouse` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving cohabiting partner` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
