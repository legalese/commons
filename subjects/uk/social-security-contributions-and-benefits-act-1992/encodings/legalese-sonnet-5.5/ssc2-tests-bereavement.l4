-- (c) is for a civil partner or cohabiting partner who is a woman, residing together and artificially inseminated
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving civil partner` TRUE FALSE FALSE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving cohabiting partner` TRUE FALSE FALSE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving spouse` TRUE FALSE FALSE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving civil partner` TRUE FALSE FALSE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE
-- (b) and (c) need a woman
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving spouse` FALSE FALSE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
-- an unknown (b)(ii) is not turned into no
#ASSERT `s 39A(2) the survivor satisfies the requirements of paragraph (a), (b) or (c)` `s 39A the surviving spouse` TRUE FALSE FALSE NOTHING FALSE FALSE EQUALS NOTHING
-- the entitlement: arguments: s 39A(1) applies, s 39A(1A), contribution conditions, requirements
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` NOTHING NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` (JUST TRUE) NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` (JUST TRUE) NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 39A(2) the survivor is entitled to a widowed parent's allowance` (JUST TRUE) NOTHING NOTHING (JUST TRUE) EQUALS NOTHING

§ `Tests -- s 39A(3A) to (3D): only one person is entitled`

-- arguments to the candidate: kind, a member of the same household, pregnant or entitled to child benefit, days in the household
-- one candidate alone
#ASSERT `s 39A(3B) the persons entitled` (LIST `s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100) EQUALS JUST (LIST `s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100)
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100) (LIST `s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100) EQUALS JUST TRUE
-- (3C): only one of two is a member of the same household
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` FALSE TRUE 0)) EQUALS JUST TRUE
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` FALSE TRUE 0) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` FALSE TRUE 0)) EQUALS JUST FALSE
-- (3C) applies even when the one household member would not be within (3D)(a) or (b)
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE FALSE 50) (LIST (`s 39A test candidate` `s 39A the surviving spouse` FALSE TRUE 0), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE FALSE 50)) EQUALS JUST TRUE
-- (3D)(a): a spouse beats a cohabiting partner, both in the household
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 900)) EQUALS JUST TRUE
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 900) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 900)) EQUALS JUST FALSE
-- a civil partner counts as a spouse for (3D)(a)
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving civil partner` TRUE TRUE 10) (LIST (`s 39A test candidate` `s 39A the surviving civil partner` TRUE TRUE 10), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 900)) EQUALS JUST TRUE
-- (3D)(b): the spouse is not pregnant or entitled to child benefit, the cohabiting partner is
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 50) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE FALSE 500), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 50)) EQUALS JUST TRUE
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving spouse` TRUE FALSE 500) (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE FALSE 500), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 50)) EQUALS JUST FALSE
-- (3D)(c): of two cohabiting partners, the longer in the household
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 200) (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 200)) EQUALS JUST TRUE
#ASSERT `s 39A(3A) the candidate is the one person entitled to a widowed parent's allowance in respect of the death` (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100) (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 200)) EQUALS JUST FALSE
-- (3D)(d): equal time is left to the Secretary of State, so the text does not decide
#ASSERT `s 39A(3B) the persons entitled` (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100)) EQUALS NOTHING
#ASSERT `s 39A(3D)(d) the Secretary of State has to determine who is entitled` (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100))
#ASSERT NOT (`s 39A(3D)(d) the Secretary of State has to determine who is entitled` (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 200)))
#ASSERT NOT (`s 39A(3D)(d) the Secretary of State has to determine who is entitled` (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100)))
-- two spouses or civil partners within (a): not decided
#ASSERT `s 39A(3B) the persons entitled` (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving civil partner` TRUE TRUE 50)) EQUALS NOTHING
-- no one within (a) or (b); no household member
#ASSERT `s 39A(3B) the persons entitled` (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE FALSE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE FALSE 50)) EQUALS NOTHING
#ASSERT `s 39A(3B) the persons entitled` (LIST (`s 39A test candidate` `s 39A the surviving spouse` FALSE TRUE 0), (`s 39A test candidate` `s 39A the surviving cohabiting partner` FALSE TRUE 0)) EQUALS NOTHING

-- the duties: (3D)(d) arises only on a tie; (8) is unconditional
#TRACE `s 39A(3D)(d) the Secretary of State must determine who is entitled` (LIST (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100)) AT 0 WITH
    PARTY `s 39A(3D)(d) the Secretary of State` DOES `s 39A(3D)(d) determine who is entitled to the widowed parent's allowance` AT 5
#EVAL `s 39A(3D)(d) the Secretary of State must determine who is entitled` (LIST (`s 39A test candidate` `s 39A the surviving spouse` TRUE TRUE 100), (`s 39A test candidate` `s 39A the surviving cohabiting partner` TRUE TRUE 100))
#TRACE `s 39A(8) the Secretary of State must issue a statement of policy` AT 0 WITH
    PARTY `s 39A(3D)(d) the Secretary of State` DOES `s 39A(8) issue a statement of the Secretary of State's policy with respect to making determinations under subsection (3D)(d)` AT 9
#ASSERT `s 39A(8) the Secretary of State is required to issue a statement of policy` EQUALS JUST TRUE

§ `Tests -- s 39A(4), (5), (7)`

-- the requirements named for each kind of survivor: arguments: kind, (2)(a), (2)(b), (2)(c)
#ASSERT `s 39A(4) the survivor satisfies the requirements named for the kind of survivor` `s 39A the surviving spouse` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 39A(4) the survivor satisfies the requirements named for the kind of survivor` `s 39A the surviving spouse` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 39A(4) the survivor satisfies the requirements named for the kind of survivor` `s 39A the surviving civil partner` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 39A(4) the survivor satisfies the requirements named for the kind of survivor` `s 39A the surviving cohabiting partner` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 39A(4) the survivor satisfies the requirements named for the kind of survivor` `s 39A the surviving spouse` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
-- the survivor (pensionable age 1 January 2030): arguments: the day, the survivor, the day of a later marriage or partnership, the requirements
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 31 12 2029) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 1 1 2030) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 11 6 2025) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) (JUST (Date 10 6 2025)) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 10 6 2025) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) (JUST (Date 10 6 2025)) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 9 6 2025) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 39A(4) the survivor is entitled to the allowance on the day` (Date 9 6 2025) (`s 38 test person attaining pensionable age on` (Date 1 1 2030)) NOTHING NOTHING EQUALS NOTHING
-- (5): arguments: the day, the commencing day, living together as a couple
#ASSERT `s 39A(5) the allowance is payable for the day` (Date 5 1 2020) (JUST (Date 10 1 2020)) FALSE EQUALS JUST FALSE
#ASSERT `s 39A(5) the allowance is payable for the day` (Date 5 1 2020) (JUST (Date 5 1 2020)) FALSE EQUALS NOTHING
#ASSERT `s 39A(5) the allowance is payable for the day` (Date 5 1 2020) (JUST (Date 1 1 2020)) TRUE EQUALS JUST FALSE
#ASSERT `s 39A(5) the allowance is payable for the day` (Date 5 1 2020) NOTHING FALSE EQUALS NOTHING
-- (7): arguments: married or civil partners, living together as if married or in a civil partnership
#ASSERT `s 39A(7) the two persons are cohabiting partners` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 39A(7) the two persons are cohabiting partners` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 39A(7) the two persons are cohabiting partners` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 39A(7) the two persons are cohabiting partners` TRUE FALSE EQUALS JUST FALSE

