#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST FALSE) TRUE (JUST TRUE) TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST TRUE) FALSE (JUST TRUE) TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST TRUE) TRUE (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST TRUE) TRUE NOTHING TRUE FALSE (JUST FALSE) EQUALS NOTHING
-- an unknown contribution answer does not hide a missing child or pregnancy
#ASSERT `s 37(1) the woman is entitled to a widowed mother's allowance` (JUST TRUE) TRUE NOTHING FALSE FALSE (JUST FALSE) EQUALS JUST FALSE

