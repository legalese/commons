    IF NOT `regulations under s 171ZU(3) provide that the claimant is entitled where the conditions in subsection (4) are satisfied`
    THEN NOTHING   -- NOTHING-kind (points outside the text): "Regulations may provide that" -- the entitlement exists only as regulations provide
    ELSE IF `s 171ZW(1)(a) regulations disapply or modify a condition in the claimant's case`
         THEN NOTHING   -- NOTHING-kind (points outside the text): s 171ZW(1)(a) lets regulations disapply or modify the conditions in prescribed cases
         ELSE IF `s 171ZU(4) all the conditions are satisfied` facts `s 5(1)(a) the lower earnings limit in force at the time in pounds`
              THEN JUST TRUE
