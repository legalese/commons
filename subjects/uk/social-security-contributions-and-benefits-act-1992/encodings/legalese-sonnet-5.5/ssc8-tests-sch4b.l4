IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc8-sch4b`

-- Tests for ssc8-sch4b.l4 (Schedule 4B). Expected values are worked by hand from the paragraph named beside each
-- assertion. The figures other than the Act's own £72.80, £93.60, 10%, 20% and 44 are illustrative inputs.

§ `Tests for Schedule 4B`

§§ `Builders (test helpers)`

-- A relevant year: earnings factor, assumed earnings factor, surplus?, would-be surplus?, LET, QEF, tax weeks,
-- contracted-out weeks, section 148 percentage, relevant years in the working life.
GIVEN ef IS A NUMBER
      aef IS A NUMBER
      sur IS A BOOLEAN
      wsur IS A BOOLEAN
      lt IS A NUMBER
      qef IS A NUMBER
      weeks IS A NUMBER
      cweeks IS A NUMBER
      pct IS A NUMBER
      yrs IS A NUMBER
GIVETH A `sch 4B a relevant year`
`sch 4B test a year` MEANS `sch 4B a relevant year` OF ef, aef, sur, wsur, lt, qef, weeks, cweeks, pct, yrs

-- The final relevant year, the section 148AA percentage, the 2015-16 percentage.
GIVEN y IS A NUMBER
      p148AA IS A NUMBER
      p2015 IS A NUMBER
GIVETH A `sch 4B the final relevant year`
`sch 4B test final` MEANS `sch 4B the final relevant year` OF (`Tax year` OF y), p148AA, p2015

-- Final relevant year 2020: FRAA 93.60, increased by 20%: 112.32. Final relevant year 2015: FRAA 72.80, increased by 10%: 80.08.
`sch 4B test final 2020` MEANS `sch 4B test final` 2020 10 20
`sch 4B test final 2015` MEANS `sch 4B test final` 2015 10 20

§§ `Paragraphs 12 and 13 -- interpretation`

#ASSERT `sch 4B para 13 the flat rate accrual amount` (`sch 4B test final` 2015 0 0) EQUALS 72.80
#ASSERT `sch 4B para 13 the flat rate accrual amount` (`sch 4B test final` 2014 0 0) EQUALS 72.80
#ASSERT `sch 4B para 13 the flat rate accrual amount` (`sch 4B test final` 2016 0 0) EQUALS 93.60
#ASSERT `sch 4B para 13 the flat rate accrual amount` (`sch 4B test final` 2030 0 0) EQUALS 93.60
#ASSERT `sch 4B para 12 the contracted-out condition is satisfied for the tax week` TRUE EQUALS TRUE
#ASSERT `sch 4B para 12 the contracted-out condition is satisfied for the tax week` FALSE EQUALS FALSE

§§ `Paragraph 4 -- the flat rate amount`

-- final relevant year 2015-16: the FRAA 72.80 increased by the section 148AA percentage (10): 72.80 x 1.1 = 80.08.
#ASSERT `sch 4B para 4 the flat rate amount` `sch 4B test final 2015` EQUALS 80.08
-- later: 93.60 increased by the 2015-16 percentage (20): 93.60 x 1.2 = 112.32.
#ASSERT `sch 4B para 4 the flat rate amount` `sch 4B test final 2020` EQUALS 112.32
-- no increase directed: the FRAA itself.
#ASSERT `sch 4B para 4 the flat rate amount` (`sch 4B test final` 2020 10 0) EQUALS 93.60
#ASSERT `sch 4B para 4 the flat rate amount` (`sch 4B test final` 2014 0 20) EQUALS 72.80

§§ `Paragraph 5 -- the earnings-related amount`

-- (20,000 - 15,000) = 5,000; x 1.1 = 5,500; x 10% = 550; / 44 = 12.5.
#ASSERT `sch 4B para 5 the earnings-related amount` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 12.5
-- earnings factor at the LET: nothing above it.
#ASSERT `sch 4B para 5 the earnings-related amount` (`sch 4B test a year` 15000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 0
-- below the LET: the part that exceeds it is nothing, never negative.
#ASSERT `sch 4B para 5 the earnings-related amount` (`sch 4B test a year` 14000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 0
-- with no increase directed: 5,000 x 10% / 44 = 500 / 44 = 125/11.
#ASSERT `sch 4B para 5 the earnings-related amount` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 0 44) EQUALS 125 DIVIDED BY 11

§§ `Paragraph 3 -- the appropriate amount under Part 2`

-- earnings factor above the LET: flat rate amount 112.32 plus 12.5.
#ASSERT `sch 4B para 3 the appropriate amount for the year under Part 2` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) `sch 4B test final 2020` EQUALS 124.82
-- earnings factor at the LET: (a) the flat rate amount only.
#ASSERT `sch 4B para 3 the appropriate amount for the year under Part 2` (`sch 4B test a year` 15000 0 TRUE FALSE 15000 12000 52 0 10 44) `sch 4B test final 2020` EQUALS 112.32
-- earnings factor 1 above the LET: 112.32 + (1 x 1.1 x 10% / 44 = 0.0025).
#ASSERT `sch 4B para 3 the appropriate amount for the year under Part 2` (`sch 4B test a year` 15001 0 TRUE FALSE 15000 12000 52 0 10 44) `sch 4B test final 2020` EQUALS 112.3225
-- final relevant year 2015-16.
#ASSERT `sch 4B para 3 the appropriate amount for the year under Part 2` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) `sch 4B test final 2015` EQUALS 92.58

§§ `Paragraphs 2 and 6 -- which Part applies`

-- Part 2: (a) the condition satisfied in no tax week, and (b) a surplus.
#ASSERT `sch 4B para 2 Part 2 applies to the relevant year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS JUST TRUE
#ASSERT `sch 4B para 2 Part 2 applies to the relevant year` (`sch 4B test a year` 20000 0 FALSE FALSE 15000 12000 52 0 10 44) EQUALS JUST FALSE
-- the condition satisfied in one week: Part 2 does not apply.
#ASSERT `sch 4B para 2 Part 2 applies to the relevant year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 1 10 44) EQUALS JUST FALSE
-- Part 3: (a) the condition satisfied in each tax week, and (b) a would-be surplus.
#ASSERT `sch 4B para 6 Part 3 applies to the relevant year` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS JUST TRUE
#ASSERT `sch 4B para 6 Part 3 applies to the relevant year` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 53 53 10 44) EQUALS JUST TRUE
#ASSERT `sch 4B para 6 Part 3 applies to the relevant year` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 51 10 44) EQUALS JUST FALSE
#ASSERT `sch 4B para 6 Part 3 applies to the relevant year` (`sch 4B test a year` 0 20000 FALSE FALSE 15000 12000 52 52 10 44) EQUALS JUST FALSE
-- which Part governs.
#ASSERT `sch 4B para 11 which Part governs the year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS `sch 4B Part 2 governs the year`
#ASSERT `sch 4B para 11 which Part governs the year` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS `sch 4B Part 3 governs the year`
-- some weeks contracted out and some not: neither Part (Part 4 hands the case to regulations).
#ASSERT `sch 4B para 11 which Part governs the year` (`sch 4B test a year` 20000 20000 TRUE TRUE 15000 12000 52 10 10 44) EQUALS `sch 4B neither Part governs the year`

§§ `Paragraphs 8 to 10 -- amounts A and B`

-- amount A, assumed earnings factor not above the LET: the flat rate amount.
#ASSERT `sch 4B para 8 amount A where the assumed earnings factor does not exceed the LET` `sch 4B test final 2020` EQUALS 112.32
-- amount A, above the LET: 12.5 + 112.32.
#ASSERT `sch 4B para 9 amount A where the assumed earnings factor exceeds the LET` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) `sch 4B test final 2020` EQUALS 124.82
-- amount B: (20,000 - 12,000) = 8,000; x 1.1 = 8,800; x 20% = 1,760; / 44 = 40.
#ASSERT `sch 4B para 10 amount B` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS JUST 40
-- assumed earnings factor at or below the QEF: nothing above it.
#ASSERT `sch 4B para 10 amount B` (`sch 4B test a year` 0 12000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS JUST 0
#ASSERT `sch 4B para 10 amount B` (`sch 4B test a year` 0 11000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS JUST 0
-- no relevant years in the working life to divide by: not answered.
#ASSERT `sch 4B para 10 amount B` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 0) EQUALS NOTHING

-- paragraph 7: A minus B. Assumed earnings factor 20,000 > LET: 124.82 - 40 = 84.82.
#ASSERT `sch 4B para 7 the appropriate amount for the year under Part 3` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) `sch 4B test final 2020` EQUALS JUST 84.82
-- assumed earnings factor 14,000 not above the LET: A = 112.32; B = (14,000 - 12,000) x 1.1 x 20% / 44 = 10.
#ASSERT `sch 4B para 7 the appropriate amount for the year under Part 3` (`sch 4B test a year` 0 14000 FALSE TRUE 15000 12000 52 52 10 44) `sch 4B test final 2020` EQUALS JUST 102.32
-- assumed earnings factor 11,000 below the QEF: B is 0, so the amount is A.
#ASSERT `sch 4B para 7 the appropriate amount for the year under Part 3` (`sch 4B test a year` 0 11000 FALSE TRUE 15000 12000 52 52 10 44) `sch 4B test final 2020` EQUALS JUST 112.32
-- no relevant years: not answered.
#ASSERT `sch 4B para 7 the appropriate amount for the year under Part 3` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 0) `sch 4B test final 2020` EQUALS NOTHING

§§ `Paragraph 3 -- the appropriate amount, from whichever Part governs`

#ASSERT `sch 4B para 3 the appropriate amount for the year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) `sch 4B test final 2020` EQUALS JUST 124.82
#ASSERT `sch 4B para 3 the appropriate amount for the year` (`sch 4B test a year` 0 20000 FALSE TRUE 15000 12000 52 52 10 44) `sch 4B test final 2020` EQUALS JUST 84.82
-- neither Part governs: not answered.
#ASSERT `sch 4B para 3 the appropriate amount for the year` (`sch 4B test a year` 20000 20000 TRUE TRUE 15000 12000 52 10 10 44) `sch 4B test final 2020` EQUALS NOTHING

§§ `Paragraph 1 -- the total`

-- 124.82 + 84.82 = 209.64
#ASSERT `sch 4B para 1 the amount referred to in section 45(2)(d)` 124.82 84.82 EQUALS 209.64
-- a negative sum is nil (paragraph 1(2)).
#ASSERT `sch 4B para 1 the amount referred to in section 45(2)(d)` 124.82 (-200) EQUALS 0
#ASSERT `sch 4B para 1 the amount referred to in section 45(2)(d)` 0 0 EQUALS 0
-- exactly nil is nil, and 1 over is 1.
#ASSERT `sch 4B para 1 the amount referred to in section 45(2)(d)` 100 (-100) EQUALS 0
#ASSERT `sch 4B para 1 the amount referred to in section 45(2)(d)` 100 (-99) EQUALS 1

§§ `Paragraph 12 -- the terms that point at other sections`

#ASSERT `sch 4B para 12 the LET for the year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 15000
#ASSERT `sch 4B para 12 the QEF for the year` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 12000
#ASSERT `sch 4B para 12 the pensioner's assumed earnings factor for the year` (`sch 4B test a year` 0 18000 FALSE TRUE 15000 12000 52 52 10 44) EQUALS 18000
#ASSERT `sch 4B para 12 the number of relevant years in the pensioner's working life` (`sch 4B test a year` 20000 0 TRUE FALSE 15000 12000 52 0 10 44) EQUALS 44
#ASSERT `sch 4B para 12 the final relevant year` `sch 4B test final 2020` EQUALS `Tax year` OF 2020

§§ `Paragraph 10(2)`

#ASSERT `sch 4B para 10(2) section 44B is ignored in applying section 44(6)` `sch 4B para 10(2) calculating amount B` EQUALS JUST TRUE
#ASSERT `sch 4B para 10(2) section 44B is ignored in applying section 44(6)` `sch 4B para 10(2) some other purpose` EQUALS NOTHING
