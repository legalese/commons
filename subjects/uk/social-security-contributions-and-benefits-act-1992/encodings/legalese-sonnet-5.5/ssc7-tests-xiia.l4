IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc7-xiia`

-- Tests for Part XIIA (ss 171A-171G).  Every expected value is written beside its assertion from the
-- text of the Act (src:4252-4330), before the run, and is never copied from the code's output.
-- Calendar facts used: 1 January 2026 is "offset 0" in the fixtures below; offset 59 is 1 March 2026, offset 60 is 2 March,
-- offset 181 is 1 July 2026 (so offset 196 is 16 July), offset 243 is 1 September (so offset 246 is 4 September).

§ `Tests for Part XIIA`

§§ `Fixtures`

-- A date a number of days after Thursday 1 January 2026.
GIVEN offset IS A NUMBER
GIVETH A DATE
`s 171B test day` MEANS Date ((Day (Date 1 1 2026)) PLUS offset)

-- A period from one offset to another, both ends counted.
GIVEN fromOffset IS A NUMBER
      toOffset IS A NUMBER
GIVETH A Period
`s 171B test period` MEANS Period WITH
    `the first day` IS `s 171B test day` fromOffset
    `the last day`  IS `s 171B test day` toOffset

-- n consecutive days of incapacity beginning at an offset.
GIVEN fromOffset IS A NUMBER
      n IS A NUMBER
GIVETH A LIST OF DATE
`s 171B test block` MEANS
    IF n AT MOST 0
    THEN EMPTY
    ELSE (`s 171B test day` fromOffset) FOLLOWED BY (`s 171B test block` (fromOffset PLUS 1) (n MINUS 1))

`s 171B test woman` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Woman
    `marital status` IS `married`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 171B test man` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Man
    `marital status` IS `married`
    `date of attaining pensionable age` IS Date 1 1 2055

§§ `s 171A test of incapacity for work`

-- (1) "save as otherwise expressly provided"
#ASSERT `s 171A(1) this Part determines whether the person is capable or incapable of work` FALSE EQUALS JUST TRUE
#ASSERT `s 171A(1) this Part determines whether the person is capable or incapable of work` TRUE EQUALS NOTHING
-- (2) regulations may treat the person as capable of work after a failure without good cause
#ASSERT `s 171A(2) the person is treated as capable of work` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 171A(2) the person is treated as capable of work` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 171A(2) the person is treated as capable of work` TRUE TRUE FALSE EQUALS JUST TRUE
-- with good cause, the failure does not lead to the treatment
#ASSERT `s 171A(2) the person is treated as capable of work` TRUE TRUE TRUE EQUALS JUST FALSE
-- no failure, no treatment
#ASSERT `s 171A(2) the person is treated as capable of work` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171A(2) the person is treated as capable of work` TRUE FALSE TRUE EQUALS JUST FALSE
-- (2A) "includes": information capable of assisting or encouraging the person to obtain work is within (2)(a); others are not covered
#ASSERT `s 171A(2A) the information or evidence is within subsection (2)(a)` TRUE EQUALS JUST TRUE
#ASSERT `s 171A(2A) the information or evidence is within subsection (2)(a)` FALSE EQUALS NOTHING
-- (3) a person called for a medical examination who fails without good cause to attend is treated as capable of work
#ASSERT `s 171A(3) the person is treated as capable of work` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 171A(3) the person is treated as capable of work` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171A(3) the person is treated as capable of work` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 171A(3) the person is treated as capable of work` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171A(3) the person is treated as capable of work` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- (5) information supplied in pursuance of the section
#ASSERT `s 171A(5) the information is information relating to social security` TRUE EQUALS JUST TRUE
#ASSERT `s 171A(5) the information is information relating to social security` FALSE EQUALS NOTHING

§§ `s 171B the own occupation test`

-- (1) "more than 8 weeks in the 21 weeks immediately preceding the day": 9 and 8.5 are more than 8; 8 is not
#ASSERT `s 171B(1) the own occupation test is applicable` 9 EQUALS JUST TRUE
#ASSERT `s 171B(1) the own occupation test is applicable` (17 DIVIDED BY 2) EQUALS JUST TRUE
#ASSERT `s 171B(1) the own occupation test is applicable` 8 EQUALS NOTHING
#ASSERT `s 171B(1) the own occupation test is applicable` 0 EQUALS NOTHING
-- (2) the test is whether the person is incapable by reason of a specific disease or disablement of the work of the occupation
#ASSERT `s 171B(2) the person is incapable of work on the own occupation test` TRUE EQUALS JUST TRUE
#ASSERT `s 171B(2) the person is incapable of work on the own occupation test` FALSE EQUALS JUST FALSE

-- (3) the series of consecutive days.  Days 1 to 4 January 2026 are offsets 0 to 3.
#ASSERT `s 171B(3) the series of consecutive days of incapacity for work` (`s 171B test block` 0 4) EQUALS LIST (`s 171B test period` 0 3)
-- two blocks one day apart are two series
#ASSERT `s 171B(3) the series of consecutive days of incapacity for work` (append (`s 171B test block` 0 4) (`s 171B test block` 5 4)) EQUALS LIST (`s 171B test period` 0 3), (`s 171B test period` 5 8)
-- the days may come in any order and with repeats
#ASSERT `s 171B(3) the series of consecutive days of incapacity for work` (LIST Date 4 1 2026, Date 2 1 2026, Date 1 1 2026, Date 3 1 2026, Date 2 1 2026) EQUALS LIST (`s 171B test period` 0 3)
#ASSERT `s 171B(3) the series of consecutive days of incapacity for work` (`s 171B test block` 0 0) EQUALS (EMPTY)

-- (3) "a series of 4 or more consecutive days": 3 days are no spell, 4 are
#ASSERT `s 171B(3) the spells of incapacity` (`s 171B test block` 0 3) EQUALS (EMPTY)
#ASSERT `s 171B(3) the spells of incapacity` (`s 171B test block` 0 4) EQUALS LIST (`s 171B test period` 0 3)
#ASSERT `s 171B(3) the spells of incapacity` (`s 171B test block` 0 200) EQUALS LIST (`s 171B test period` 0 199)
-- (3) two spells one day apart are treated as one
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (`s 171B test block` 5 4)) EQUALS LIST (`s 171B test period` 0 8)
-- (3) "not separated by a period of more than 8 weeks": 56 days between (offset 3 to offset 60) is exactly 8 weeks, so one spell; 57 days between is more, so two
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (`s 171B test block` 60 4)) EQUALS LIST (`s 171B test period` 0 63)
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (`s 171B test block` 61 4)) EQUALS LIST (`s 171B test period` 0 3), (`s 171B test period` 61 64)
-- three spells in a chain, each 56 days from the last, are one
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (append (`s 171B test block` 60 4) (`s 171B test block` 120 4))) EQUALS LIST (`s 171B test period` 0 123)
-- a run of fewer than 4 days between two spells does not join them or separate them: the spells are 56 days apart, so one
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (append (`s 171B test block` 10 2) (`s 171B test block` 60 4))) EQUALS LIST (`s 171B test period` 0 63)
-- a run of fewer than 4 days between two spells 96 days apart does not join them
#ASSERT `s 171B(3) the spells of incapacity` (append (`s 171B test block` 0 4) (append (`s 171B test block` 40 2) (`s 171B test block` 100 4))) EQUALS LIST (`s 171B test period` 0 3), (`s 171B test period` 100 103)
-- no days, no spells
#ASSERT `s 171B(3) the spells of incapacity` (`s 171B test block` 0 0) EQUALS (EMPTY)

-- (3) "the spell of incapacity beginning with that day or, as the case may be, in which that day falls"
#ASSERT `s 171B(3) the spell in which the day falls` (`s 171B test block` 0 4) (`s 171B test day` 0) EQUALS JUST (`s 171B test period` 0 3)
#ASSERT `s 171B(3) the spell in which the day falls` (`s 171B test block` 0 4) (`s 171B test day` 3) EQUALS JUST (`s 171B test period` 0 3)
#ASSERT `s 171B(3) the spell in which the day falls` (`s 171B test block` 0 4) (`s 171B test day` 4) EQUALS NOTHING
#ASSERT `s 171B(3) the spell in which the day falls` (`s 171B test block` 0 4) (`s 171B test day` (0 MINUS 1)) EQUALS NOTHING
-- a day in the gap of a merged spell falls in the spell
#ASSERT `s 171B(3) the spell in which the day falls` (append (`s 171B test block` 0 4) (`s 171B test block` 60 4)) (`s 171B test day` 30) EQUALS JUST (`s 171B test period` 0 63)

-- (3) the helpers, directly.  A series of consecutive serial days from offset 0: days at offsets 1, 2 and 5 give the runs 0-2 and 5-5
#ASSERT `s 171B(3) the series of consecutive days from` (Day (`s 171B test day` 0)) (Day (`s 171B test day` 0)) (LIST (Day (`s 171B test day` 1)), (Day (`s 171B test day` 2)), (Day (`s 171B test day` 5))) EQUALS LIST (`s 171B test period` 0 2), (`s 171B test period` 5 5)
-- merging from a spell at offsets 0-3: the next spell at 60-63 is 56 days later (one spell: 0-63); the one at 130-133 is 66 days after that (separate)
#ASSERT `s 171B(3) the spells merged from` (`s 171B test period` 0 3) (LIST (`s 171B test period` 60 63), (`s 171B test period` 130 133)) EQUALS LIST (`s 171B test period` 0 63), (`s 171B test period` 130 133)
#ASSERT `s 171B(3) the spells merged from` (`s 171B test period` 0 3) (EMPTY) EQUALS LIST (`s 171B test period` 0 3)
-- the state within a spell of 200 days (offsets 0-199): to offset 195 the test remains; at offset 196 (the 197th day) the text does not say; after, and after the last day, it has ended
#ASSERT `s 171B(3) the status of the own occupation test within the spell` (`s 171B test block` 0 200) (`s 171B test period` 0 199) (`s 171B test day` 195) EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test within the spell` (`s 171B test block` 0 200) (`s 171B test period` 0 199) (`s 171B test day` 196) EQUALS `s 171B(3) the text does not say whether the test applies`
#ASSERT `s 171B(3) the status of the own occupation test within the spell` (`s 171B test block` 0 200) (`s 171B test period` 0 199) (`s 171B test day` 197) EQUALS `s 171B(3) the stated period has ended`
#ASSERT `s 171B(3) the status of the own occupation test within the spell` (`s 171B test block` 0 200) (`s 171B test period` 0 199) (`s 171B test day` 200) EQUALS `s 171B(3) the stated period has ended`
-- (3) the nth day of incapacity
#ASSERT `s 171B(3) the nth day of incapacity for work` 1 (LIST 5, 6) EQUALS JUST 5
#ASSERT `s 171B(3) the nth day of incapacity for work` 2 (LIST 5, 6) EQUALS JUST 6
#ASSERT `s 171B(3) the nth day of incapacity for work` 3 (LIST 5, 6) EQUALS NOTHING
-- (3) the 197th day of incapacity in the spell: 197 days from 1 January 2026 end on offset 196, which is 16 July 2026
#ASSERT `s 171B(3) the 197th day of incapacity for work in the spell` (`s 171B test block` 0 200) (`s 171B test period` 0 199) EQUALS JUST (Date 16 7 2026)
#ASSERT `s 171B(3) the 197th day of incapacity for work in the spell` (`s 171B test block` 0 197) (`s 171B test period` 0 196) EQUALS JUST (Date 16 7 2026)
-- only 196 days: there is no 197th
#ASSERT `s 171B(3) the 197th day of incapacity for work in the spell` (`s 171B test block` 0 196) (`s 171B test period` 0 195) EQUALS NOTHING
-- only days of incapacity are counted: 100 days at offsets 0-99, then 100 days at offsets 150-249 (the gap is 50 days, within 8 weeks); the 197th is the 97th day of the second block, offset 246, which is 4 September 2026
#ASSERT `s 171B(3) the 197th day of incapacity for work in the spell` (append (`s 171B test block` 0 100) (`s 171B test block` 150 100)) (`s 171B test period` 0 249) EQUALS JUST (Date 4 9 2026)

-- (3) the state of the test on a day.  The determination is on 1 January 2026; 200 days of incapacity follow without a break.
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 200) (`s 171B test day` 0) (`s 171B test day` 0) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 200) (`s 171B test day` 0) (`s 171B test day` 195) FALSE EQUALS `s 171B(3) the test remains applicable`
-- the 197th day itself: the text does not say whether "until" takes it in
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 200) (`s 171B test day` 0) (`s 171B test day` 196) FALSE EQUALS `s 171B(3) the text does not say whether the test applies`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 200) (`s 171B test day` 0) (`s 171B test day` 197) FALSE EQUALS `s 171B(3) the stated period has ended`
-- a spell of 100 days: the test lasts to its end (offset 99 is 10 April 2026) and not after
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 100) (`s 171B test day` 0) (`s 171B test day` 99) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 100) (`s 171B test day` 0) (`s 171B test day` 100) FALSE EQUALS `s 171B(3) the stated period has ended`
-- a day before the determination has nothing carried forward
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 100) (`s 171B test day` 10) (`s 171B test day` 5) FALSE EQUALS `s 171B(3) there is no determination to carry forward`
-- regulations under subsection (8) may change the figures: the text alone does not say
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 100) (`s 171B test day` 0) (`s 171B test day` 5) TRUE EQUALS `s 171B(3) the text does not say whether the test applies`
-- a determination day outside every series of 4 or more days has no spell to last through
#ASSERT `s 171B(3) the status of the own occupation test on the day` (`s 171B test block` 0 3) (`s 171B test day` 0) (`s 171B test day` 1) FALSE EQUALS `s 171B(3) the text does not say whether the test applies`
-- a merged spell: offsets 0-3 and 60-63 are one spell (gap 56); day 30 is in the gap and the test still applies; day 63 is the last day; day 64 is after
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 4) (`s 171B test block` 60 4)) (`s 171B test day` 0) (`s 171B test day` 30) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 4) (`s 171B test block` 60 4)) (`s 171B test day` 0) (`s 171B test day` 63) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 4) (`s 171B test block` 60 4)) (`s 171B test day` 0) (`s 171B test day` 64) FALSE EQUALS `s 171B(3) the stated period has ended`
-- spells 57 days apart are two: a determination in the first does not reach the second
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 4) (`s 171B test block` 61 4)) (`s 171B test day` 0) (`s 171B test day` 62) FALSE EQUALS `s 171B(3) the stated period has ended`
-- the 197th day counts incapacity days only: with the merged spell above (100 + 100 days, 50 apart) the 197th is offset 246
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 100) (`s 171B test block` 150 100)) (`s 171B test day` 0) (`s 171B test day` 245) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 100) (`s 171B test block` 150 100)) (`s 171B test day` 0) (`s 171B test day` 246) FALSE EQUALS `s 171B(3) the text does not say whether the test applies`
#ASSERT `s 171B(3) the status of the own occupation test on the day` (append (`s 171B test block` 0 100) (`s 171B test block` 150 100)) (`s 171B test day` 0) (`s 171B test day` 247) FALSE EQUALS `s 171B(3) the stated period has ended`

-- (4) "a day of incapacity for work means a day" ...
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test man` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test man` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test woman` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test man` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (c) is for a woman: a man within a maternity allowance period is not on that ground
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test man` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171B(4) the day is a day of incapacity for work` `s 171B test woman` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (5) provisions of the Act that treat a day as, or not as, a day of incapacity are disregarded, apart from subsection (4)
#ASSERT `s 171B(5) the provision is disregarded for the purposes of section 171B` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171B(5) the provision is disregarded for the purposes of section 171B` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 171B(5) the provision is disregarded for the purposes of section 171B` FALSE FALSE EQUALS NOTHING
#ASSERT `s 171B(5) the provision is disregarded for the purposes of section 171B` FALSE TRUE EQUALS NOTHING

§§ `s 171C personal capability assessments`

-- (1) the own occupation test, if applicable or carried forward; a personal capability assessment if not applicable or ceased
#ASSERT `s 171C(1) the test that decides` (JUST TRUE) `s 171B(3) the test remains applicable` EQUALS `s 171C(1) the own occupation test`
#ASSERT `s 171C(1) the test that decides` NOTHING `s 171B(3) the test remains applicable` EQUALS `s 171C(1) the own occupation test`
#ASSERT `s 171C(1) the test that decides` NOTHING `s 171B(3) the stated period has ended` EQUALS `s 171C(1) a personal capability assessment`
#ASSERT `s 171C(1) the test that decides` NOTHING `s 171B(3) there is no determination to carry forward` EQUALS `s 171C(1) a personal capability assessment`
#ASSERT `s 171C(1) the test that decides` NOTHING `s 171B(3) the text does not say whether the test applies` EQUALS `s 171C(1) the text does not say which test decides`
-- s 171B(1) makes the test applicable on the day itself, whatever s 171B(3) says about an earlier spell
#ASSERT `s 171C(1) the test that decides` (JUST TRUE) `s 171B(3) the stated period has ended` EQUALS `s 171C(1) the own occupation test`
-- (3) regulations may treat the person as incapable of work in accordance with a personal capability assessment until it is carried out
#ASSERT `s 171C(3) the person is treated as incapable of work in accordance with a personal capability assessment` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 171C(3) the person is treated as incapable of work in accordance with a personal capability assessment` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171C(3) the person is treated as incapable of work in accordance with a personal capability assessment` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 171C(3) the person is treated as incapable of work in accordance with a personal capability assessment` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 171C(3) the person is treated as incapable of work in accordance with a personal capability assessment` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (4) "Except in prescribed circumstances"
#ASSERT `s 171C(4) the earlier assessment is as effective as a later one` FALSE EQUALS JUST TRUE
#ASSERT `s 171C(4) the earlier assessment is as effective as a later one` TRUE EQUALS NOTHING
-- (5) the Secretary of State may require the question to be determined afresh
#ASSERT `s 171C(5) the Secretary of State may require the question to be determined afresh` TRUE EQUALS JUST TRUE
#ASSERT `s 171C(5) the Secretary of State may require the question to be determined afresh` FALSE EQUALS NOTHING

§§ `s 171D persons to be treated as incapable or capable of work`

-- (1) regulations may treat a person as capable, or as incapable, of work; both at once is not settled by the text
#ASSERT `s 171D(1) the treatment of the person` TRUE FALSE EQUALS `s 171D(1) treated as capable of work`
#ASSERT `s 171D(1) the treatment of the person` FALSE TRUE EQUALS `s 171D(1) treated as incapable of work`
#ASSERT `s 171D(1) the treatment of the person` TRUE TRUE EQUALS `s 171D(1) regulations give both treatments`
#ASSERT `s 171D(1) the treatment of the person` FALSE FALSE EQUALS `s 171D(1) no treatment under this subsection applies`

§§ `s 171E disqualification`

-- (1) disqualification: own misconduct, or a failure without good cause to attend for treatment or to observe the rules of behaviour
#ASSERT `s 171E(1) the person is disqualified for receiving a benefit, allowance or other advantage` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 171E(1) the person is disqualified for receiving a benefit, allowance or other advantage` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is disqualified for receiving a benefit, allowance or other advantage` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is disqualified for receiving a benefit, allowance or other advantage` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is disqualified for receiving a benefit, allowance or other advantage` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (1) treated as capable of work, on the same three grounds
#ASSERT `s 171E(1) the person is treated as capable of work` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 171E(1) the person is treated as capable of work` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is treated as capable of work` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is treated as capable of work` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171E(1) the person is treated as capable of work` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (2) "not exceeding 6 weeks": 42 days (6 weeks of 7 days) is allowed, 43 is not
#ASSERT `s 171E(2) the period of the disqualification or treatment as capable of work is allowed` 42 EQUALS JUST TRUE
#ASSERT `s 171E(2) the period of the disqualification or treatment as capable of work is allowed` 43 EQUALS JUST FALSE
#ASSERT `s 171E(2) the period of the disqualification or treatment as capable of work is allowed` 0 EQUALS JUST TRUE

§§ `s 171F work as councillor`

-- (1) work undertaken as a councillor is disregarded
#ASSERT `s 171F(1) the work is disregarded in determining whether the person is capable or incapable of work` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(1) the work is disregarded in determining whether the person is capable or incapable of work` FALSE EQUALS NOTHING
-- (2) England and Wales: the six councils named
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) a London borough council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) a county or county borough council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) a district council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) a parish or community council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) the Common Council of the City of London` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) the Council of the Isles of Scilly` TRUE EQUALS JUST TRUE
-- Scotland: regional, islands or district council
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(b) a regional council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(b) an islands council` TRUE EQUALS JUST TRUE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(b) a district council` TRUE EQUALS JUST TRUE
-- a council of the other limb, a council not named, or a non-member is not within the definition ("means")
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(b) a regional council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(b) an islands council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(b) a district council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(c) another kind of council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(a) a parish or community council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(a) a district council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(a) a London borough council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(c) another kind of council` TRUE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) England and Wales` `s 171F(2)(a) a district council` FALSE EQUALS JUST FALSE
#ASSERT `s 171F(2) the person is a councillor` `s 171F(2) Scotland` `s 171F(2)(b) a regional council` FALSE EQUALS JUST FALSE
-- (3) "shall be taken to include" work as a member of the bodies, by virtue of being a councillor
#ASSERT `s 171F(3) the work counts as work undertaken as a councillor` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171F(3) the work counts as work undertaken as a councillor` TRUE FALSE EQUALS NOTHING
#ASSERT `s 171F(3) the work counts as work undertaken as a councillor` FALSE TRUE EQUALS NOTHING
