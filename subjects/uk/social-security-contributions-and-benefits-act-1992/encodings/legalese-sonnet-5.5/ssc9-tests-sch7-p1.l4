IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc9-sch7-p1`

-- Tests for ssc9-sch7-p1.l4 (Schedule 7 Part I). Expected values are written by hand from the text, beside each assertion.

§ `Tests -- Schedule 7 Part I`

§§ `Paragraph 1 -- availability`

-- Reading (e): inside the closed scope the sentence states, the Part applies (the other reading answers NOTHING).
#ASSERT `sch 7 pt I para 1 this Part applies to the person` TRUE EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 1 this Part applies to the person` FALSE EQUALS JUST FALSE

§§ `Paragraph 2 -- rate and duration`

-- 2(3): an amount prescribed below 104 is outside the power (NOTHING); at 104 or more the likelihood decides.
#ASSERT `sch 7 pt I para 2(3) the beneficiary may be treated as incapable of work and likely to remain so permanently` TRUE 103.99 EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(3) the beneficiary may be treated as incapable of work and likely to remain so permanently` TRUE 104 EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 2(3) the beneficiary may be treated as incapable of work and likely to remain so permanently` FALSE 104 EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 2(3) the beneficiary may be treated as incapable of work and likely to remain so permanently` TRUE 500 EQUALS JUST TRUE
-- 2(1): argument order: s 94(6) answer; permanence; treated under (3).
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` NOTHING TRUE NOTHING EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` NOTHING FALSE NOTHING EQUALS JUST FALSE
-- Treated under (3): increased though not incapable.
#ASSERT `sch 7 pt I para 2(1) the weekly rate is increased` (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST TRUE
-- The amount: the Schedule 4 figure when increased; 0 when not; NOTHING when the table is omitted or the answer is unknown.
#ASSERT `sch 7 pt I para 2(1) the amount of the increase` (JUST TRUE) (JUST 30) EQUALS JUST 30
#ASSERT `sch 7 pt I para 2(1) the amount of the increase` (JUST FALSE) (JUST 30) EQUALS JUST 0
#ASSERT `sch 7 pt I para 2(1) the amount of the increase` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(1) the amount of the increase` NOTHING (JUST 30) EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(2) what an increase of pension under this paragraph is called` EQUALS `unemployability supplement`
-- 2(4): granted 1 Jan to 31 Dec 2025, renewed 1 Jan to 30 Jun 2026: payable within either period (NOTHING: the rest of the Act decides); outside both also NOTHING, because "payable for such period" is a stated period and the text does not say the supplement is unpayable outside it.
#ASSERT `sch 7 pt I para 2(4) the supplement is payable on the day` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 31 12 2025) (LIST Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 6 2026) (Date 31 12 2025) EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(4) the supplement is payable on the day` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 31 12 2025) (LIST Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 6 2026) (Date 1 1 2026) EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(4) the supplement is payable on the day` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 31 12 2025) (LIST Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 6 2026) (Date 1 7 2026) EQUALS NOTHING
#ASSERT `sch 7 pt I para 2(4) the supplement is payable on the day` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 31 12 2025) (LIST Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 6 2026) (Date 31 12 2024) EQUALS NOTHING

§§ `Paragraph 3 -- increase of unemployability supplement`

-- 3(1): a man under 60, a woman under 55 (the K2 answers are inputs: argument order sex, under 60, under 55).
#ASSERT `sch 7 pt I para 3(1) the beneficiary meets the age condition on the qualifying date` Man (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 3(1) the beneficiary meets the age condition on the qualifying date` Man (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 3(1) the beneficiary meets the age condition on the qualifying date` Woman (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 3(1) the beneficiary meets the age condition on the qualifying date` Woman (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 3(1) the beneficiary meets the age condition on the qualifying date` Woman NOTHING NOTHING EQUALS NOTHING
#ASSERT `sch 7 pt I para 3(1) the increase before the deductions` (JUST TRUE) (JUST 12.5) EQUALS JUST 12.5
#ASSERT `sch 7 pt I para 3(1) the increase before the deductions` (JUST FALSE) (JUST 12.5) EQUALS JUST 0
#ASSERT `sch 7 pt I para 3(1) the increase before the deductions` NOTHING (JUST 12.5) EQUALS NOTHING
#ASSERT `sch 7 pt I para 3(1) the increase before the deductions` (JUST TRUE) NOTHING EQUALS NOTHING
-- 3(3), (3A), (4): additional pension 20, of which 4 is units and 3 is a Schedule 5 increase -> 13; reduced by a section 46 reduction of 5 -> 8; more than the whole -> 0.
#ASSERT `sch 7 pt I para 3(3) the relevant amount` 20 4 3 5 EQUALS 8
#ASSERT `sch 7 pt I para 3(3) the relevant amount` 20 4 3 13 EQUALS 0
#ASSERT `sch 7 pt I para 3(3) the relevant amount` 20 4 3 20 EQUALS 0
-- 3(2): argument order: entitled to the pension; includes additional pension; relevant amount; the increase otherwise made.
#ASSERT `sch 7 pt I para 3(2) the increase after the deduction` TRUE TRUE 8 10 EQUALS 2
#ASSERT `sch 7 pt I para 3(2) the increase after the deduction` TRUE TRUE 10 10 EQUALS 0
#ASSERT `sch 7 pt I para 3(2) the increase after the deduction` TRUE TRUE 12 10 EQUALS 0
#ASSERT `sch 7 pt I para 3(2) the increase after the deduction` TRUE FALSE 8 10 EQUALS 10
#ASSERT `sch 7 pt I para 3(2) the increase after the deduction` FALSE TRUE 8 10 EQUALS 10
-- 3(5) to (7): argument order: first week qualified; part of an interruption; first day of incapacity in it; earlier prescribed day; two or more periods; first week of the period of the day.
-- (5) alone: the beginning of the first week qualified.
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) FALSE (Date 1 1 2025) NOTHING FALSE (Date 20 1 2025) EQUALS Date 6 1 2025
-- (6): the first day of incapacity in the interruption (1 Jan), not the later week start.
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) TRUE (Date 1 1 2025) NOTHING FALSE (Date 20 1 2025) EQUALS Date 1 1 2025
-- (6) with a prescribed earlier day (25 Dec 2024): that day. With a prescribed day later than the first incapacity day: the first incapacity day.
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) TRUE (Date 1 1 2025) (JUST (Date 25 12 2024)) FALSE (Date 20 1 2025) EQUALS Date 25 12 2024
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) TRUE (Date 1 1 2025) (JUST (Date 5 1 2025)) FALSE (Date 20 1 2025) EQUALS Date 1 1 2025
-- (7): two or more periods and (6) does not apply: the beginning of the first week of the period of the day.
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) FALSE (Date 1 1 2025) NOTHING TRUE (Date 20 1 2025) EQUALS Date 20 1 2025
-- (7) is "subject to" (6): when (6) applies, it prevails.
#ASSERT `sch 7 pt I para 3(5) the qualifying date` (Date 6 1 2025) TRUE (Date 1 1 2025) NOTHING TRUE (Date 20 1 2025) EQUALS Date 1 1 2025
-- 3(8), (9): break of 8 weeks -> disregarded; 8.5 -> two periods; with regulations substituting 12: 12 disregarded, 13 two periods; a substituted 8 or less -> NOTHING.
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 8 NOTHING EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 9 NOTHING EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 12 (JUST 12) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 13 (JUST 12) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 9 (JUST 8) EQUALS NOTHING
#ASSERT `sch 7 pt I para 3(8) the periods before and after the break are two different periods` 9 (JUST 6) EQUALS NOTHING
#ASSERT `sch 7 pt I para 3(10) the period is a period of interruption of employment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 3(10) the period is a period of interruption of employment` NOTHING EQUALS NOTHING
-- 3(11): the increase stands only when section 46(6) and (7) are known not to limit it.
#ASSERT `sch 7 pt I para 3(11) the increase subject to section 46(6) and (7)` (JUST 7) (JUST FALSE) EQUALS JUST 7
#ASSERT `sch 7 pt I para 3(11) the increase subject to section 46(6) and (7)` (JUST 7) (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 7 pt I para 3(11) the increase subject to section 46(6) and (7)` (JUST 7) NOTHING EQUALS NOTHING

§§ `Paragraph 4 -- children`

#ASSERT `sch 7 pt I para 4(6) the meaning of week` EQUALS `such period of 7 days as may be prescribed`
-- 4(5): no order -> 215; an order for 250 -> 250; an order for 215 or less is outside the power (NOTHING).
#ASSERT `sch 7 pt I para 4(5) the amount for the time being specified` 215 NOTHING EQUALS JUST 215
#ASSERT `sch 7 pt I para 4(5) the amount for the time being specified` 215 (JUST 250) EQUALS JUST 250
#ASSERT `sch 7 pt I para 4(5) the amount for the time being specified` 215 (JUST 215) EQUALS NOTHING
#ASSERT `sch 7 pt I para 4(5) the amount for the time being specified` 28 (JUST 20) EQUALS NOTHING
-- 4(4): argument order: couple; other had earnings; earnings; number of children; pounds for the first child; pounds per further child.
-- Earnings 214.99: nobody withheld. 215: the first child. 242.99: still only the first (no complete £28 above 215). 243: first plus one further.
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 214.99 3 215 28 EQUALS 0
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 215 3 215 28 EQUALS 1
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 242.99 3 215 28 EQUALS 1
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 243 3 215 28 EQUALS 2
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 271 3 215 28 EQUALS 3
-- Earnings far above: capped at the number of children. Two children, earnings 1000 -> 2.
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 1000 2 215 28 EQUALS 2
-- One child only, earnings 243: the first child only -> 1.
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 243 1 215 28 EQUALS 1
-- Not a couple, or the other person had no earnings, or no children: nothing withheld.
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` FALSE TRUE 500 3 215 28 EQUALS 0
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE FALSE 500 3 215 28 EQUALS 0
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 500 0 215 28 EQUALS 0
-- With larger substituted amounts (250 and 30): earnings 249 -> 0; 250 -> 1; 280 -> 2.
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 249 3 250 30 EQUALS 0
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 250 3 250 30 EQUALS 1
#ASSERT `sch 7 pt I para 4(4) the number of children and qualifying young persons for whom no increase is payable` TRUE TRUE 280 3 250 30 EQUALS 2
-- 4(1): both conditions -> NOTHING (subject to 4(4) and paragraph 5); otherwise the text's no.
#ASSERT `sch 7 pt I para 4(1) the weekly rate is increased for children` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 7 pt I para 4(1) the weekly rate is increased for children` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 4(1) the weekly rate is increased for children` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 7 pt I para 4(1) the weekly rate is increased for children` FALSE FALSE EQUALS NOTHING
-- 4(2): 3 children at the Schedule 4 amount of 11.5 -> 34.5; amount omitted -> NOTHING.
#ASSERT `sch 7 pt I para 4(2) the amount of the increase` 3 (JUST 11.5) EQUALS JUST 34.5
#ASSERT `sch 7 pt I para 4(2) the amount of the increase` 0 (JUST 11.5) EQUALS JUST 0
#ASSERT `sch 7 pt I para 4(2) the amount of the increase` 3 NOTHING EQUALS NOTHING

§§ `Paragraph 5 -- conditions on the child increase`

-- 5(2): argument order: beneficiary's weekly rate; two spouses residing together; the other spouse's rate; the amount referred to; prescribed case; S18 answer.
-- Beneficiary alone gives 8, the amount is 10 -> short -> FALSE; two spouses residing together give 8 + 3 = 11 -> enough.
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 8 FALSE 3 (JUST 10) FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 8 TRUE 3 (JUST 10) FALSE (JUST TRUE) EQUALS JUST TRUE
-- Exactly 10: not less than the amount -> enough.
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 10 FALSE 0 (JUST 10) FALSE (JUST TRUE) EQUALS JUST TRUE
-- (b): over and above those required for s 143(1)(b) (S18) -- false -> not satisfied unless a prescribed case.
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 10 FALSE 0 (JUST 10) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 10 FALSE 0 (JUST 10) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 10 FALSE 0 (JUST 10) FALSE NOTHING EQUALS NOTHING
-- The amount referred to is dangling (sub-paragraph (1) names none): NOTHING.
#ASSERT `sch 7 pt I para 5(2) the condition in paragraph (b) of sub-paragraph (1) is satisfied` 10 FALSE 0 NOTHING FALSE (JUST TRUE) EQUALS NOTHING
-- 5(1): living with -> NOTHING ("only if" is not a grant); neither -> FALSE; contributions condition unknown -> NOTHING.
#ASSERT `sch 7 pt I para 5(1) the increase for the child may be payable` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 7 pt I para 5(1) the increase for the child may be payable` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 7 pt I para 5(1) the increase for the child may be payable` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 5(1) the increase for the child may be payable` FALSE NOTHING EQUALS NOTHING

§§ `Paragraph 6 -- adult dependants`

-- 6(2): the requisite rate is not less than the Schedule 4 amount (say 20).
#ASSERT `sch 7 pt I para 6(2) the beneficiary is contributing at the requisite rate` 19.99 (JUST 20) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 6(2) the beneficiary is contributing at the requisite rate` 20 (JUST 20) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 6(2) the beneficiary is contributing at the requisite rate` 20 NOTHING EQUALS NOTHING
-- 6(1): argument order: entitled to the supplement; residing with spouse; contributing at the requisite rate; a person has the care of children; further conditions.
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` FALSE TRUE (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST FALSE
-- Unknown Schedule 4 amount, nothing else holding: NOTHING; unknown prescribed conditions with a carer present: NOTHING.
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE NOTHING FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 7 pt I para 6(1) the weekly rate is increased for an adult dependant` TRUE FALSE (JUST FALSE) TRUE NOTHING EQUALS NOTHING
-- 6(7): at most one person.
#ASSERT `sch 7 pt I para 6(7) the number of persons in respect of whom the increase is payable` 0 EQUALS 0
#ASSERT `sch 7 pt I para 6(7) the number of persons in respect of whom the increase is payable` 1 EQUALS 1
#ASSERT `sch 7 pt I para 6(7) the number of persons in respect of whom the increase is payable` 2 EQUALS 1

§§ `Paragraph 7 -- earnings include pensions`

#ASSERT `sch 7 pt I para 7(1) the earnings counted for paragraph 4 or 6` 100 40 FALSE EQUALS 140
#ASSERT `sch 7 pt I para 7(1) the earnings counted for paragraph 4 or 6` 100 40 TRUE EQUALS 100

§§ `Paragraph 8 -- continuation of awards`

-- Argument order: awarded; ceased by reason only of earnings; would have continued apart from the excess; relevant earnings; amount.
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` TRUE TRUE TRUE 30 40 EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` TRUE TRUE TRUE 40 40 EQUALS JUST TRUE
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` TRUE TRUE TRUE 40.01 40 EQUALS JUST FALSE
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` FALSE TRUE TRUE 30 40 EQUALS NOTHING
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` TRUE FALSE TRUE 30 40 EQUALS NOTHING
#ASSERT `sch 7 pt I para 8(1) the increase is payable for the week` TRUE TRUE FALSE 30 40 EQUALS NOTHING
