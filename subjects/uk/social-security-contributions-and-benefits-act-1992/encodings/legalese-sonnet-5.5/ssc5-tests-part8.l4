IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc5-logic`
IMPORT `ssc5-part8`

-- Tests for ssc5-part8.l4 (ss 138 to 140B).  Every expected value is written by hand from the text of the
-- section named beside it, before the run.

§ `Tests -- Part VIII and Part 8A`

§§ `s 138(1) -- payments that may be made out of the social fund`

-- Arguments: the kind; amount and circumstances prescribed; in accordance with directions or guidance.
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(a) a payment to meet maternity expenses` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(a) a payment to meet funeral expenses` TRUE FALSE EQUALS JUST TRUE
-- Paragraph (a) wants a prescribed amount in prescribed circumstances; directions do not supply them.
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(a) a payment to meet maternity expenses` FALSE TRUE EQUALS NOTHING
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(a) a payment to meet funeral expenses` FALSE TRUE EQUALS NOTHING
-- Paragraph (b) payments are made in accordance with directions or guidance.
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a community care grant` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a crisis loan` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a budgeting loan` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a community care grant` TRUE FALSE EQUALS NOTHING
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a crisis loan` FALSE FALSE EQUALS NOTHING
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1)(b) a budgeting loan` TRUE FALSE EQUALS NOTHING
-- A kind the subsection does not list: the subsection does not say "only", so no answer.
#ASSERT `s 138(1) the payment may be made out of the social fund` `s 138(1) some other kind of payment` TRUE TRUE EQUALS NOTHING

§§ `s 138(2) -- heating payments in cold weather`

#ASSERT `s 138(2) the heating payment may be made out of the social fund` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(2) the heating payment may be made out of the social fund` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 138(2) the heating payment may be made out of the social fund` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 138(2) the heating payment may be made out of the social fund` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 138(2) the heating payment may be made out of the social fund` TRUE TRUE TRUE FALSE EQUALS NOTHING

§§ `s 138(3) -- payment to a third party`

#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(b) a community care grant` TRUE EQUALS JUST TRUE
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(b) a crisis loan` TRUE EQUALS JUST TRUE
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(b) a budgeting loan` TRUE EQUALS JUST TRUE
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(b) a community care grant` FALSE EQUALS NOTHING
-- "such as is mentioned in subsection (1)(b)": paragraph (a) payments are not covered.
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(a) a payment to meet maternity expenses` TRUE EQUALS NOTHING
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1)(a) a payment to meet funeral expenses` TRUE EQUALS NOTHING
#ASSERT `s 138(3) the payment may be made to a third party` `s 138(1) some other kind of payment` TRUE EQUALS NOTHING

§§ `s 138(4) to (4B) -- prescribed; Scotland`

#ASSERT (`s 138(4) how the term is defined` `s 138(4) prescribed`)'s `what it points at or says` EQUALS "specified in or determined in accordance with regulations"
#ASSERT (`s 138(4) how the term is defined` `s 138(4) prescribed`)'s `the way it is defined` EQUALS `s 122(1) a definition by "means"`

#ASSERT `s 138(4A) the reference is read in Scotland as` `s 138(4A)(a) the making of payments out of the social fund, in subsections (1)(a) and (2)` TRUE EQUALS JUST "the making of payments by the Scottish Ministers"
#ASSERT `s 138(4A) the reference is read in Scotland as` `s 138(4A)(b) the Secretary of State, in subsection (2)` TRUE EQUALS JUST "the Scottish Ministers"
#ASSERT `s 138(4A) the reference is read in Scotland as` `s 138(4A)(c) regulations, in subsection (4)` TRUE EQUALS JUST "regulations made by the Scottish Ministers"
-- Not in or as regards Scotland: the subsection does not speak.
#ASSERT `s 138(4A) the reference is read in Scotland as` `s 138(4A)(b) the Secretary of State, in subsection (2)` FALSE EQUALS NOTHING

#ASSERT `s 138(4B)(a) sections 175(2) and (7) and 176 apply to the regulations` TRUE EQUALS JUST FALSE
#ASSERT `s 138(4B)(a) sections 175(2) and (7) and 176 apply to the regulations` FALSE EQUALS NOTHING

§§ `s 138(5) -- budgeting loan, community care grant, crisis loan`

-- Meeting a need "includes helping to meet" it.
#ASSERT `s 138(5) the payment meets a need or defrays an expense` TRUE FALSE EQUALS TRUE
#ASSERT `s 138(5) the payment meets a need or defrays an expense` FALSE TRUE EQUALS TRUE
#ASSERT `s 138(5) the payment meets a need or defrays an expense` TRUE TRUE EQUALS TRUE
#ASSERT `s 138(5) the payment meets a need or defrays an expense` FALSE FALSE EQUALS FALSE

-- Arguments: a loan; awarded in circumstances specified in directions; meets a need or defrays an expense; the expense or need.
#ASSERT `s 138(5) the payment is a budgeting loan` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(5) the payment is a budgeting loan` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a budgeting loan` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a budgeting loan` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a budgeting loan` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- Arguments: a grant; awarded in circumstances specified in directions; meets a need; a need for community care.
#ASSERT `s 138(5) the payment is a community care grant` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(5) the payment is a community care grant` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a community care grant` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a community care grant` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a community care grant` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- Arguments: a loan; awarded in circumstances specified in directions; meets a need; an immediate short term need.
#ASSERT `s 138(5) the payment is a crisis loan` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(5) the payment is a crisis loan` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a crisis loan` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a crisis loan` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 138(5) the payment is a crisis loan` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§§ `s 139 -- awards by social fund officers`

#ASSERT `s 139(1) the person is an appropriate officer` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(1) the person is an appropriate officer` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 139(1) the person is an appropriate officer` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 139(1) the person is an appropriate officer` TRUE TRUE FALSE EQUALS JUST FALSE

#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1)(b) a community care grant` EQUALS JUST TRUE
#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1)(b) a crisis loan` EQUALS JUST TRUE
#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1)(b) a budgeting loan` EQUALS JUST TRUE
#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1)(a) a payment to meet maternity expenses` EQUALS NOTHING
#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1)(a) a payment to meet funeral expenses` EQUALS NOTHING
#ASSERT `s 139(1) the question of whether to award and how much is one for an appropriate officer` `s 138(1) some other kind of payment` EQUALS NOTHING

-- (2): an appropriate officer may determine instalments.
#ASSERT `s 139(2) the person may determine that an award shall be payable in specified instalments at specified times` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 139(2) the person may determine that an award shall be payable in specified instalments at specified times` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 139(2) the person may determine that an award shall be payable in specified instalments at specified times` NOTHING EQUALS NOTHING

-- (4): repayable on the terms notified before the award was paid.
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(b) a crisis loan` TRUE EQUALS JUST TRUE
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(b) a budgeting loan` TRUE EQUALS JUST TRUE
-- No terms notified before payment: the subsection is silent.
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(b) a crisis loan` FALSE EQUALS NOTHING
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(b) a budgeting loan` FALSE EQUALS NOTHING
-- A community care grant is not a loan: the subsection does not speak of it.
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(b) a community care grant` TRUE EQUALS NOTHING
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(a) a payment to meet maternity expenses` TRUE EQUALS NOTHING
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1)(a) a payment to meet funeral expenses` TRUE EQUALS NOTHING
#ASSERT `s 139(4) the award is repayable on the notified terms` `s 138(1) some other kind of payment` TRUE EQUALS NOTHING

-- (5): paid to the applicant unless the appropriate officer determines otherwise.
#ASSERT `s 139(5) payment of the award is to be made to the applicant` FALSE EQUALS JUST TRUE
#ASSERT `s 139(5) payment of the award is to be made to the applicant` TRUE EQUALS JUST FALSE

-- The regulative twin: the applicant repays; the duty is fulfilled when it is done.
#TRACE `s 139(4) the duty to repay a crisis loan or budgeting loan on the notified terms` AT 0 WITH
    PARTY `s 139 the person by or on behalf of whom the application for the loan was made` DOES `s 139 repay the loan on the terms the Secretary of State notified` AT 3

§§ `s 140 -- principles of determination`

-- Arguments: the kind; the matter; the payment is repayable; a direction or guidance under (2) displaces the duty.
-- A community care grant or crisis loan: all the circumstances, and in particular (a) to (e).
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(b) the existence of resources from which the need may be met` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(c) the possibility that some other person or body may wholly or partly meet it` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(e) any relevant allocation under section 168(1) to (4) of the Administration Act` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1) any other of the circumstances of the case` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a crisis loan` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS JUST TRUE
-- (d) is "where the payment is repayable".
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a crisis loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a crisis loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` FALSE FALSE EQUALS NOTHING
-- Personal circumstances "specified in directions" are the budgeting loan's matter.
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1A)(a) such of the applicant's personal circumstances as are of a description specified in directions` FALSE FALSE EQUALS NOTHING
-- (1A): a budgeting loan.
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1A)(a) such of the applicant's personal circumstances as are of a description specified in directions` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(b) the existence of resources from which the need may be met` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(e) any relevant allocation under section 168(1) to (4) of the Administration Act` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` FALSE FALSE EQUALS NOTHING
-- (1A) names only (b), (d) and (e) of subsection (1).
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1)(c) the possibility that some other person or body may wholly or partly meet it` FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1) any other of the circumstances of the case` FALSE FALSE EQUALS NOTHING
-- "subject to subsection (2)": a direction or guidance may displace the duty.
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a community care grant` `s 140(1)(a) the nature, extent and urgency of the need` FALSE TRUE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(b) a budgeting loan` `s 140(1A)(a) such of the applicant's personal circumstances as are of a description specified in directions` FALSE TRUE EQUALS NOTHING
-- Kinds the duty is not stated for.
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(a) a payment to meet maternity expenses` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1)(a) a payment to meet funeral expenses` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(1) the officer must have regard to the matter` `s 138(1) some other kind of payment` `s 140(1)(a) the nature, extent and urgency of the need` FALSE FALSE EQUALS NOTHING

-- (2): in accordance with the general directions, and taking account of the general guidance.
#ASSERT `s 140(2) the officer has done what the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 140(2) the officer has done what the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 140(2) the officer has done what the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 140(2) the officer has done what the subsection requires` FALSE FALSE EQUALS JUST FALSE

-- (4ZA): a multiplier applied to the most recent relevant sum.
#ASSERT `s 140(4ZA) the sum determined by applying the multiplier in pounds` 1.5 100 EQUALS 150
#ASSERT `s 140(4ZA) the sum determined by applying the multiplier in pounds` 2 87.5 EQUALS 175
#ASSERT `s 140(4ZA) the sum determined by applying the multiplier in pounds` 0 500 EQUALS 0

#ASSERT (`s 140(4ZB) how the term is defined` `s 140(4ZB) relevant sum`)'s `what it points at or says` EQUALS "a sum determined from time to time by reference to so much of any relevant allocation under section 168(1) to (4) of the Administration Act as is available for making payments"
#ASSERT (`s 140(4ZB) how the term is defined` `s 140(4ZB) relevant sum`)'s `the way it is defined` EQUALS `s 122(1) a plain statement of what the term is`

-- (5): guidance of the officer nominated for the area, subject to the Secretary of State's directions or guidance.
#ASSERT `s 140(5) the officer must take account of the guidance of the officer nominated for the area` FALSE EQUALS JUST TRUE
#ASSERT `s 140(5) the officer must take account of the guidance of the officer nominated for the area` TRUE EQUALS NOTHING

#TRACE `s 140(1) the appropriate officer's duty to have regard` AT 0 WITH
    PARTY `s 140 an appropriate officer` DOES `s 140 have regard to the matters the section requires` AT 2
#TRACE `s 140(2) the appropriate officer's duty to follow the general directions` AT 0 WITH
    PARTY `s 140 an appropriate officer` DOES `s 140 determine in accordance with the general directions and take account of the general guidance` AT 2

§§ `s 140A -- entitlement to health in pregnancy grant`

#ASSERT `s 140A(5) the person is a woman` Woman EQUALS JUST TRUE
#ASSERT `s 140A(5) the person is a woman` Man EQUALS JUST FALSE

#ASSERT (`s 140A(5) how the term is defined` `s 140A(5) woman`)'s `what it points at or says` EQUALS "a female of any age"
#ASSERT (`s 140A(5) how the term is defined` `s 140A(5) woman`)'s `the way it is defined` EQUALS `s 122(1) a definition by "means"`
#ASSERT (`s 140A(5) how the term is defined` `s 140A(5) prescribed`)'s `what it points at or says` EQUALS "prescribed by regulations"
#ASSERT (`s 140A(5) how the term is defined` `s 140A(5) health professional`)'s `what it points at or says` EQUALS "such meaning as may be prescribed"
#ASSERT (`s 140A(5) how the term is defined` `s 140A(5) health professional`)'s `the way it is defined` EQUALS `s 122(1) a meaning borrowed from another Act or instrument`

-- (1): a woman who satisfies prescribed conditions in relation to a pregnancy of hers.
#ASSERT `s 140A(1) the woman is entitled to payment of health in pregnancy grant` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 140A(1) the woman is entitled to payment of health in pregnancy grant` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 140A(1) the woman is entitled to payment of health in pregnancy grant` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 140A(1) the woman is entitled to payment of health in pregnancy grant` NOTHING TRUE EQUALS NOTHING

-- (2): reached the 25th week before 1 January 2011.  Argument order: has reached it; the date she reached it.
#ASSERT `s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 31 12 2010) EQUALS JUST TRUE
#ASSERT `s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 25 12 2010) EQUALS JUST TRUE
-- On 1 January 2011 is not "before 1st January 2011".
#ASSERT `s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 1 1 2011) EQUALS JUST FALSE
#ASSERT `s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 2 1 2011) EQUALS JUST FALSE
-- Never reached the 25th week: she did not reach it before that date.
#ASSERT `s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` FALSE (Date 1 1 2010) EQUALS JUST FALSE

-- (3)(a) and (3)(b).
#ASSERT `s 140A(3)(a) the woman is entitled to health in pregnancy grant as far as paragraph (a) goes` TRUE EQUALS JUST TRUE
#ASSERT `s 140A(3)(a) the woman is entitled to health in pregnancy grant as far as paragraph (a) goes` FALSE EQUALS JUST FALSE
#ASSERT `s 140A(3)(b) the woman is entitled to health in pregnancy grant as far as paragraph (b) goes` TRUE EQUALS JUST TRUE
#ASSERT `s 140A(3)(b) the woman is entitled to health in pregnancy grant as far as paragraph (b) goes` FALSE EQUALS JUST FALSE

-- The grant and the bars: arguments are the answers of (1), (2), (3)(a), (3)(b).
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (JUST TRUE) NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (JUST TRUE) NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` NOTHING (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
-- Two bars at once.
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE

-- End to end: a woman, conditions satisfied, reached the 25th week on 1 December 2010, advised, in Great Britain.
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (`s 140A(1) the woman is entitled to payment of health in pregnancy grant` (`s 140A(5) the person is a woman` Woman) TRUE) (`s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 1 12 2010)) (`s 140A(3)(a) the woman is entitled to health in pregnancy grant as far as paragraph (a) goes` TRUE) (`s 140A(3)(b) the woman is entitled to health in pregnancy grant as far as paragraph (b) goes` TRUE) EQUALS JUST TRUE
-- The same woman, but she reached the 25th week on 3 January 2011.
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (`s 140A(1) the woman is entitled to payment of health in pregnancy grant` (`s 140A(5) the person is a woman` Woman) TRUE) (`s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 3 1 2011)) (`s 140A(3)(a) the woman is entitled to health in pregnancy grant as far as paragraph (a) goes` TRUE) (`s 140A(3)(b) the woman is entitled to health in pregnancy grant as far as paragraph (b) goes` TRUE) EQUALS JUST FALSE
-- A man cannot satisfy limb (1), and no bar speaks: no answer.
#ASSERT `s 140A the woman is entitled to health in pregnancy grant` (`s 140A(1) the woman is entitled to payment of health in pregnancy grant` (`s 140A(5) the person is a woman` Man) TRUE) (`s 140A(2) the woman is entitled to health in pregnancy grant as far as subsection (2) goes` TRUE (Date 1 12 2010)) (`s 140A(3)(a) the woman is entitled to health in pregnancy grant as far as paragraph (a) goes` TRUE) (`s 140A(3)(b) the woman is entitled to health in pregnancy grant as far as paragraph (b) goes` TRUE) EQUALS NOTHING

§§ `s 140B -- amount`

#ASSERT `s 140B(1) the amount of health in pregnancy grant in pounds` (JUST 190) EQUALS JUST 190
#ASSERT `s 140B(1) the amount of health in pregnancy grant in pounds` NOTHING EQUALS NOTHING

§§ `s 140(1) and (1A) -- the matters, directly`

-- (1): for a community care grant or a crisis loan.  Arguments: the matter; the payment is repayable.
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(a) the nature, extent and urgency of the need` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(b) the existence of resources from which the need may be met` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(c) the possibility that some other person or body may wholly or partly meet it` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` TRUE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` FALSE EQUALS NOTHING
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1)(e) any relevant allocation under section 168(1) to (4) of the Administration Act` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1) any other of the circumstances of the case` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1) the matter for a grant or a crisis loan` `s 140(1A)(a) such of the applicant's personal circumstances as are of a description specified in directions` FALSE EQUALS NOTHING

-- (1A): for a budgeting loan.
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1A)(a) such of the applicant's personal circumstances as are of a description specified in directions` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(b) the existence of resources from which the need may be met` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` TRUE EQUALS JUST TRUE
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(d) where the payment is repayable, the likelihood of repayment and the time within which repayment is likely` FALSE EQUALS NOTHING
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(e) any relevant allocation under section 168(1) to (4) of the Administration Act` FALSE EQUALS JUST TRUE
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(a) the nature, extent and urgency of the need` FALSE EQUALS NOTHING
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1)(c) the possibility that some other person or body may wholly or partly meet it` FALSE EQUALS NOTHING
#ASSERT `s 140(1A) the matter for a budgeting loan` `s 140(1) any other of the circumstances of the case` FALSE EQUALS NOTHING
