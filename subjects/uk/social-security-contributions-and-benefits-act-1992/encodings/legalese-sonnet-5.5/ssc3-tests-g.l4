IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc3-helpers`
IMPORT `ssc3-g-s60-s62`

-- Tests for ssc3-g-s60-s62.l4 (ss 60, 60A, 61, 61A, 62).
-- Every expected value is written by hand from the text of the section named beside it; none is copied from the encoding's output.

§ `Fixtures`

`a contributor` MEANS
    Person WITH
        `date of birth` IS Date 1 1 1950
        `sex` IS Man
        `marital status` IS `married`
        `date of attaining pensionable age` IS Date 1 1 2015

§ `Section 60: complete or partial failure to satisfy contribution conditions`

-- (9): a retirement pension to which paragraph 5A applies is not one for section 60.
#ASSERT `s 60(9) the pension counts as a Category A or Category B retirement pension in section 60` FALSE
#ASSERT (NOT (`s 60(9) the pension counts as a Category A or Category B retirement pension in section 60` TRUE))
-- (8): subsection (2) only has effect for a death on or after 11 April 1988.
#ASSERT `s 60(8) subsection (2) has effect` (Date 11 4 1988)
#ASSERT `s 60(8) subsection (2) has effect` (Date 1 1 2000)
#ASSERT (NOT (`s 60(8) subsection (2) has effect` (Date 10 4 1988)))
-- (3): the benefits referred to in subsection (2).
#ASSERT `s 60(3) the benefit is one of those referred to in subsection (2)` `widowed mother's allowance` FALSE FALSE
#ASSERT `s 60(3) the benefit is one of those referred to in subsection (2)` `widowed parent's allowance` FALSE FALSE
#ASSERT `s 60(3) the benefit is one of those referred to in subsection (2)` `widow's pension` FALSE FALSE
#ASSERT `s 60(3) the benefit is one of those referred to in subsection (2)` `Category B retirement pension` TRUE FALSE
#ASSERT (NOT (`s 60(3) the benefit is one of those referred to in subsection (2)` `Category B retirement pension` FALSE FALSE))
#ASSERT (NOT (`s 60(3) the benefit is one of those referred to in subsection (2)` `Category B retirement pension` TRUE TRUE))
#ASSERT (NOT (`s 60(3) the benefit is one of those referred to in subsection (2)` `Category A retirement pension` TRUE FALSE))
#ASSERT (NOT (`s 60(3) the benefit is one of those referred to in subsection (2)` `child benefit` FALSE FALSE))
-- (2): an employed earner who is married or a civil partner dies from an injury or disease within section 94(1) or 108(1), the conditions are not wholly satisfied, and the death was on or after 11 April 1988.
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 10 4 1988) TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) FALSE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE NOTHING (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE (JUST TRUE) NOTHING FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the contribution conditions are taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 11 4 1988) TRUE (JUST TRUE) NOTHING TRUE FALSE EQUALS JUST FALSE
-- (1): a retirement pension is payable only by virtue of section 60(1) where the regulations so provide, the first contribution condition is satisfied and the second is not (and paragraph 5A does not apply).
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category B retirement pension` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST TRUE) (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` NOTHING (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `Category A retirement pension` (JUST TRUE) (JUST TRUE) NOTHING FALSE EQUALS NOTHING
#ASSERT `s 60(1) the retirement pension would be payable only by virtue of section 60` `widow's pension` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING
-- Section 60 as a whole: by virtue of (1) or of (2).
#ASSERT `s 60 the retirement pension would be payable only by virtue of section 60 as a whole` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 60 the retirement pension would be payable only by virtue of section 60 as a whole` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 60 the retirement pension would be payable only by virtue of section 60 as a whole` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 60 the retirement pension would be payable only by virtue of section 60 as a whole` NOTHING (JUST FALSE) EQUALS NOTHING
-- (4): the prescribed rate must be less than the full rate.
#ASSERT `s 60(4) the weekly rate payable by virtue of regulations under section 60(1) in pounds` (JUST 50) (JUST 100) EQUALS JUST 50
#ASSERT `s 60(4) the weekly rate payable by virtue of regulations under section 60(1) in pounds` (JUST 100) (JUST 100) EQUALS NOTHING
#ASSERT `s 60(4) the weekly rate payable by virtue of regulations under section 60(1) in pounds` (JUST 120) (JUST 100) EQUALS NOTHING
#ASSERT `s 60(4) the weekly rate payable by virtue of regulations under section 60(1) in pounds` NOTHING (JUST 100) EQUALS NOTHING
#ASSERT `s 60(4) the weekly rate payable by virtue of regulations under section 60(1) in pounds` (JUST 50) NOTHING EQUALS NOTHING
-- (7): a single payment where the pension is only an additional pension and it and any graduated retirement benefit together are under the prescribed rate (10): 3 + 2 = 5.
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST TRUE) TRUE 3 2 (JUST 10) EQUALS JUST TRUE
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST TRUE) TRUE 5 5 (JUST 10) EQUALS JUST FALSE
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST TRUE) TRUE 8 5 (JUST 10) EQUALS JUST FALSE
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST TRUE) FALSE 3 2 (JUST 10) EQUALS JUST FALSE
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST FALSE) TRUE 3 2 (JUST 10) EQUALS JUST FALSE
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` NOTHING TRUE 3 2 (JUST 10) EQUALS NOTHING
#ASSERT `s 60(7) the entitlement as respects the retirement pension is satisfied by a single payment` (JUST TRUE) TRUE 3 2 NOTHING EQUALS NOTHING

§ `Section 60A: failure to satisfy contribution condition in paragraph 5A of Schedule 3`

-- (6): where paragraph 5A(4) modifies the condition, the modified condition is applied.
#ASSERT `s 60A(6) the contribution condition in Schedule 3, Part I, paragraph 5A is satisfied for the purposes of subsections (1) to (3)` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 60A(6) the contribution condition in Schedule 3, Part I, paragraph 5A is satisfied for the purposes of subsections (1) to (3)` FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 60A(6) the contribution condition in Schedule 3, Part I, paragraph 5A is satisfied for the purposes of subsections (1) to (3)` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
-- (4): the contributor is the person by whom the condition is to be satisfied.
#ASSERT `s 60A(4) the contributor` `a contributor` EQUALS `a contributor`
-- (1): subsection (2) applies if the condition is not satisfied in relation to a benefit to which paragraph 5A applies.
#ASSERT `s 60A(1) subsection (2) applies` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 60A(1) subsection (2) applies` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 60A(1) subsection (2) applies` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 60A(1) subsection (2) applies` (JUST FALSE) FALSE EQUALS JUST FALSE
-- (3): a year falls within the subsection if the requirements in 5A(2)(a) and (b) are both satisfied for it.
#ASSERT `s 60A(3) the year of the contributor's working life falls within this subsection` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 60A(3) the year of the contributor's working life falls within this subsection` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 60A(3) the year of the contributor's working life falls within this subsection` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 60A(3) the year of the contributor's working life falls within this subsection` NOTHING (JUST FALSE) EQUALS JUST FALSE
-- (2): a prescribed proportion for each qualifying year. 12 years at 0.01 = 0.12.
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST TRUE) (JUST TRUE) 12 (JUST 0.01) EQUALS JUST 0.12
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST TRUE) (JUST TRUE) 0 (JUST 0.01) EQUALS JUST 0
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST FALSE) (JUST TRUE) 12 (JUST 0.01) EQUALS JUST 0
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST TRUE) (JUST FALSE) 12 (JUST 0.01) EQUALS JUST 0
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST TRUE) NOTHING 12 (JUST 0.01) EQUALS NOTHING
#ASSERT `s 60A(2) the proportion of the benefit to which the person is entitled` (JUST TRUE) (JUST TRUE) 12 NOTHING EQUALS NOTHING
-- (5): a death on or after 6 April 2010 from an injury or disease within section 94(1) or 108(1), with the condition unsatisfied, for a Category B pension under section 48B.
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 5 4 2010) TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) FALSE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE NOTHING (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE (JUST TRUE) NOTHING FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 60A(5) the condition in Schedule 3, Part I, paragraph 5A is taken to be satisfied for the entitlement of the widow, widower or surviving civil partner` (Date 6 4 2010) TRUE (JUST TRUE) NOTHING TRUE FALSE EQUALS JUST FALSE

§ `Section 61: exclusion of increase of benefit for failure to satisfy contribution condition`

-- (1): a pension or allowance payable by virtue of section 60(1) that contains no basic pension is not increased under section 47(1) or Part IV.
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category A retirement pension` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category B retirement pension` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `widowed mother's allowance` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `widowed parent's allowance` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category A retirement pension` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category A retirement pension` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category A retirement pension` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `Category A retirement pension` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `widow's pension` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 61(1) the increase under section 47(1) is excluded` `child benefit` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- (2): short-term incapacity benefit at a rate determined under section 30B(3) by reference to a retirement pension that would have been payable only by virtue of section 60 and would have contained no basic pension.
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 61(2) the increase of the short-term incapacity benefit under section 47(1) or Part IV is excluded` NOTHING (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE

§ `Section 61A: contributions paid in error`

-- (1): the section applies if the individual paid primary Class 1 contributions in error because not an employed earner, and prescribed conditions are satisfied.
#ASSERT `s 61A(1) this section applies in the case of the individual` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61A(1) this section applies in the case of the individual` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61A(1) this section applies in the case of the individual` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61A(1) this section applies in the case of the individual` TRUE NOTHING EQUALS NOTHING
-- (3): the additional pension referred to in (2).
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `Category A retirement pension` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `widowed mother's allowance` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `widow's pension` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `widowed parent's allowance` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `Category B retirement pension` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `Category B retirement pension` FALSE FALSE EQUALS NOTHING
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `long-term incapacity benefit` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `long-term incapacity benefit` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `short-term incapacity benefit` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61A(3) the additional pension is one to which subsection (2) refers` `child benefit` FALSE FALSE EQUALS NOTHING
-- (2): regulations may treat the contributions as properly paid where the section applies and the Inland Revenue consider it appropriate.
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` (JUST TRUE) TRUE NOTHING EQUALS NOTHING
-- (2): regulations that do not so provide are the last limb of the same "where" list as (a) and (b), read like a failed "where" (marginal reading (a2)).
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61A(2) the contributions are treated as properly paid, as if the individual had been an employed earner, for the additional pension` NOTHING FALSE (JUST TRUE) EQUALS JUST FALSE
-- (5): where such provision applies, regulations under paragraph 8(1)(m) of Schedule 1 may not require repayment.
#ASSERT `s 61A(5) regulations under paragraph 8(1)(m) of Schedule 1 may require the amounts to be repaid` TRUE EQUALS JUST FALSE
#ASSERT `s 61A(5) regulations under paragraph 8(1)(m) of Schedule 1 may require the amounts to be repaid` FALSE EQUALS NOTHING

§ `Section 62: graduated retirement benefit`

-- (4): a relevant gender change case: the late wife was a woman by gender recognition at death and the marriage subsisted before the certificate.
#ASSERT `s 62(4) the case is a relevant gender change case` TRUE TRUE
#ASSERT (NOT (`s 62(4) the case is a relevant gender change case` TRUE FALSE))
#ASSERT (NOT (`s 62(4) the case is a relevant gender change case` FALSE TRUE))
-- (3): in such cases a woman and her late wife are treated as a woman and her late husband.
#ASSERT `s 62(3) the woman and her late wife are treated in the same way as a woman and her late husband for sections 36 and 37 of the National Insurance Act 1965` TRUE EQUALS JUST TRUE
#ASSERT `s 62(3) the woman and her late wife are treated in the same way as a woman and her late husband for sections 36 and 37 of the National Insurance Act 1965` FALSE EQUALS NOTHING
