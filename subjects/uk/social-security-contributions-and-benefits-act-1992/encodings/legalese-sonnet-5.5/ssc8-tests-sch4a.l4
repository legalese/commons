IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc8-sch4a`

-- Tests for ssc8-sch4a.l4 (Schedule 4A). Expected values are worked by hand from the paragraph named beside each
-- assertion. The tables are omitted from the text, so the bands below are illustrative inputs.

§ `Tests for Schedule 4A`

§§ `Builders (test helpers)`

-- Two illustrative bands: the first 5,000 of surplus at 20%, the rest at 10%.
`sch 4A test two bands` MEANS LIST (`sch 4A a band` OF 0, (JUST 5000), 20), (`sch 4A a band` OF 5000, NOTHING, 10)

§§ `Paragraph 2(3) -- which table applies`

-- First appointed year 2002-03 (ends 5 April 2003). A person attaining pensionable age on 6 April 2003 is after its end.
#ASSERT `sch 4A para 2(3) which table applies` (Date 6 4 2003) (`Tax year` OF 2005) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (3)`
#ASSERT `sch 4A para 2(3) which table applies` (Date 5 4 2009) (`Tax year` OF 2012) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (3)`
-- on 5 April 2003 it is not after the end of the first appointed year: no table is given.
#ASSERT `sch 4A para 2(3) which table applies` (Date 5 4 2003) (`Tax year` OF 2005) (`Tax year` OF 2002) EQUALS `sch 4A no table is given`
-- on or after 6 April 2009: (4) for a tax year before 2010-11, (4A) from 2010-11.
#ASSERT `sch 4A para 2(3) which table applies` (Date 6 4 2009) (`Tax year` OF 2009) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (4)`
#ASSERT `sch 4A para 2(3) which table applies` (Date 6 4 2009) (`Tax year` OF 2010) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (4A)`
#ASSERT `sch 4A para 2(3) which table applies` (Date 1 1 2015) (`Tax year` OF 2012) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (4A)`
#ASSERT `sch 4A para 2(3) which table applies` (Date 1 1 2015) (`Tax year` OF 2008) (`Tax year` OF 2002) EQUALS `sch 4A the table of sub-paragraph (4)`

§§ `Paragraph 2(1) -- when Part II applies`

#ASSERT `sch 4A para 2(1) Part II applies to the tax year` TRUE 0 EQUALS JUST TRUE
#ASSERT `sch 4A para 2(1) Part II applies to the tax year` FALSE 0 EQUALS JUST FALSE
-- Part II "does not apply" if the condition is satisfied in one or more tax weeks (paragraph 3(3)).
#ASSERT `sch 4A para 2(1) Part II applies to the tax year` TRUE 1 EQUALS JUST FALSE
#ASSERT `sch 4A para 2(1) Part II applies to the tax year` FALSE 3 EQUALS JUST FALSE

§§ `Paragraph 2(2) -- the amount for the year, band by band`

-- the first band runs from 0 to 5,000; the second from 5,000 up.
#ASSERT `sch 4A para 2(2)(a) the part of the surplus in the band` (`sch 4A a band` OF 0, (JUST 5000), 20) 8000 EQUALS 5000
#ASSERT `sch 4A para 2(2)(a) the part of the surplus in the band` (`sch 4A a band` OF 0, (JUST 5000), 20) 3000 EQUALS 3000
#ASSERT `sch 4A para 2(2)(a) the part of the surplus in the band` (`sch 4A a band` OF 5000, NOTHING, 10) 8000 EQUALS 3000
#ASSERT `sch 4A para 2(2)(a) the part of the surplus in the band` (`sch 4A a band` OF 5000, NOTHING, 10) 4000 EQUALS 0
#ASSERT `sch 4A para 2(2)(a) the part of the surplus in the band` (`sch 4A a band` OF 5000, NOTHING, 10) 5000 EQUALS 0

-- order increase 10%: surplus 8,000: 5,000 x 1.1 x 20% = 1,100; 3,000 x 1.1 x 10% = 330; total 1,430.
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 8000 `sch 4A test two bands` 10 EQUALS 1430
-- surplus 4,000 lies wholly in the first band: 4,000 x 1.1 x 20% = 880.
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 4000 `sch 4A test two bands` 10 EQUALS 880
-- surplus 5,000 is the top of the first band: 1,100, nothing in the second.
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 5000 `sch 4A test two bands` 10 EQUALS 1100
-- 1 over: 1,100 + 1 x 1.1 x 10% = 1,100.11.
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 5001 `sch 4A test two bands` 10 EQUALS 1100.11
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 0 `sch 4A test two bands` 10 EQUALS 0
-- no increase directed: 5,000 x 20% = 1,000 and 3,000 x 10% = 300.
#ASSERT `sch 4A para 2(2) the amount for the year found band by band` 8000 `sch 4A test two bands` 0 EQUALS 1300

-- Part II as a whole.
#ASSERT `sch 4A para 2 the amount for the year` (JUST TRUE) 1430 EQUALS JUST 1430
#ASSERT `sch 4A para 2 the amount for the year` (JUST FALSE) 1430 EQUALS NOTHING
#ASSERT `sch 4A para 2 the amount for the year` NOTHING 1430 EQUALS NOTHING

§§ `Paragraph 2(6), (7), (8) -- N, LET, QEF, 2QEF`

-- N is 0.5 for each tax year by which the tax year of attaining pensionable age precedes 2009-10.
#ASSERT `sch 4A para 2(6)(a) the value of N` (Date 15 6 2005) EQUALS 2
#ASSERT `sch 4A para 2(6)(a) the value of N` (Date 5 4 2009) EQUALS 0.5
#ASSERT `sch 4A para 2(6)(a) the value of N` (Date 6 4 2009) EQUALS 0
#ASSERT `sch 4A para 2(6)(a) the value of N` (Date 1 1 2012) EQUALS 0
#ASSERT `sch 4A para 2(6)(a) the calendar year in which the tax year containing the day begins` (Date 5 4 2009) EQUALS 2008
#ASSERT `sch 4A para 2(6)(a) the calendar year in which the tax year containing the day begins` (Date 6 4 2009) EQUALS 2009

#ASSERT `sch 4A para 2(6)(b) LET` 9500 EQUALS 9500
#ASSERT `sch 4A para 2(6)(c) QEF` 4000 EQUALS 4000
#ASSERT `sch 4A para 2(8) the final relevant year` (`Tax year` OF 2020) EQUALS `Tax year` OF 2020

-- 2QEF: double the QEF and round to the nearest whole 100, a 50 going to the previous whole 100.
#ASSERT `sch 4A para 2(7) 2QEF` 6175 EQUALS 12300
#ASSERT `sch 4A para 2(7) 2QEF` 6174 EQUALS 12300
#ASSERT `sch 4A para 2(7) 2QEF` 6176 EQUALS 12400
#ASSERT `sch 4A para 2(7) 2QEF` 6225 EQUALS 12400
#ASSERT `sch 4A para 2(7) 2QEF` 6226 EQUALS 12500
#ASSERT `sch 4A para 2(7) 2QEF` 6150 EQUALS 12300
#ASSERT `sch 4A para 2(7) 2QEF` 0 EQUALS 0
#ASSERT `sch 4A para 2(7) 2QEF` 25 EQUALS 0
#ASSERT `sch 4A para 2(7) 2QEF` 26 EQUALS 100

§§ `Part I -- the amount (paragraph 1)`

-- (3): tax years which begin after 5 April 1978 and end before the date entitlement commences.
#ASSERT `sch 4A para 1(3) the first alternative number` (Date 6 4 1979) EQUALS 1
#ASSERT `sch 4A para 1(3) the first alternative number` (Date 5 4 1979) EQUALS 0
#ASSERT `sch 4A para 1(3) the first alternative number` (Date 15 6 2000) EQUALS 22
#ASSERT `sch 4A para 1(3) the first alternative number` (Date 1 1 1970) EQUALS 0
-- (4): from the tax year of attaining 16 (or 1978-79 if later) to the year before the tax year of attaining pensionable age.
#ASSERT `sch 4A para 1(4) the second alternative number` (Date 1 6 1980) (Date 1 6 2030) EQUALS 50
#ASSERT `sch 4A para 1(4) the second alternative number` (Date 1 6 1970) (Date 1 6 2030) EQUALS 52
#ASSERT `sch 4A para 1(4) the second alternative number` (Date 1 6 1970) (Date 1 6 1978) EQUALS 0
#ASSERT `sch 4A para 1(4) the second alternative number` (Date 1 6 1970) (Date 1 6 1975) EQUALS 0
-- (2): the smaller of the two where the deceased died under pensionable age; the number of relevant years otherwise.
#ASSERT `sch 4A para 1(2) the divisor for the amount` TRUE 44 22 50 EQUALS 22
#ASSERT `sch 4A para 1(2) the divisor for the amount` TRUE 44 60 50 EQUALS 50
#ASSERT `sch 4A para 1(2) the divisor for the amount` TRUE 44 50 50 EQUALS 50
#ASSERT `sch 4A para 1(2) the divisor for the amount` FALSE 44 22 50 EQUALS 44
-- (6), (7), (5): the same for section 48BB(5).
#ASSERT `sch 4A para 1(6) the first alternative number` (Date 6 4 1979) EQUALS 1
#ASSERT `sch 4A para 1(6) the first alternative number` (Date 5 4 1979) EQUALS 0
#ASSERT `sch 4A para 1(7) the second alternative number` (Date 1 6 1980) (Date 1 6 2030) EQUALS 50
#ASSERT `sch 4A para 1(5) the divisor for the amount` TRUE 44 22 50 EQUALS 22
#ASSERT `sch 4A para 1(5) the divisor for the amount` FALSE 44 22 50 EQUALS 44
-- (1): the amounts added, divided by the divisor; a negative result is nil.
#ASSERT `sch 4A para 1 the amount referred to in section 45(2)(c)` (LIST 100, 200, 300) 4 EQUALS JUST 150
#ASSERT `sch 4A para 1 the amount referred to in section 45(2)(c)` (LIST (-100), 50) 2 EQUALS JUST 0
#ASSERT `sch 4A para 1 the amount referred to in section 45(2)(c)` (LIST 100, 200, 300) 0 EQUALS NOTHING
#ASSERT `sch 4A para 1 the amount referred to in section 45(2)(c)` EMPTY 3 EQUALS JUST 0

§§ `Part III -- contracted-out employment`

#ASSERT `sch 4A para 3(1) Part III applies to the tax year` 52 52 EQUALS JUST TRUE
#ASSERT `sch 4A para 3(1) Part III applies to the tax year` 53 53 EQUALS JUST TRUE
#ASSERT `sch 4A para 3(1) Part III applies to the tax year` 52 51 EQUALS JUST FALSE
#ASSERT `sch 4A para 3(1) Part III applies to the tax year` 52 0 EQUALS JUST FALSE
#ASSERT `sch 4A para 3(3) Part II does not apply because of the condition` 1 EQUALS JUST TRUE
#ASSERT `sch 4A para 3(3) Part II does not apply because of the condition` 52 EQUALS JUST TRUE
#ASSERT `sch 4A para 3(3) Part II does not apply because of the condition` 0 EQUALS JUST FALSE
#ASSERT `sch 4A para 8(2) there is an assumed surplus in the pensioner's earnings factor for the year` TRUE EQUALS TRUE
#ASSERT `sch 4A para 8(2) there is an assumed surplus in the pensioner's earnings factor for the year` FALSE EQUALS FALSE

-- amount A with an assumed surplus of 8,000: as Part II, 1,430.
#ASSERT `sch 4A para 5 amount A` TRUE 8000 `sch 4A test two bands` 10 EQUALS JUST 1430
-- no assumed surplus: the text gives no amount.
#ASSERT `sch 4A para 5 amount A` FALSE 0 `sch 4A test two bands` 10 EQUALS NOTHING
-- amount B, second case: as amount A.
#ASSERT `sch 4A para 7 amount B in the second case` TRUE 8000 `sch 4A test two bands` 10 EQUALS JUST 1430
#ASSERT `sch 4A para 7 amount B in the second case` FALSE 0 `sch 4A test two bands` 10 EQUALS NOTHING

-- amount B, first case, assumed surplus 8,000, order increase 10% (x 1.1), first appointed year 2002-03:
-- pensionable age on or after 6 April 2009: 20% -> 8,000 x 1.1 x 0.20 = 1,760.
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 6 4 2009) (`Tax year` OF 2002) 10 EQUALS JUST 1760
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 1 1 2015) (`Tax year` OF 2002) 10 EQUALS JUST 1760
-- 15 June 2005 is in tax year 2005-06: N = 0.5 x 4 = 2, so 22% -> 8,000 x 1.1 x 0.22 = 1,936.
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 15 6 2005) (`Tax year` OF 2002) 10 EQUALS JUST 1936
-- 6 April 2003 is the first day after the first appointed year: tax year 2003-04, N = 3, so 23% -> 2,024.
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 6 4 2003) (`Tax year` OF 2002) 10 EQUALS JUST 2024
-- 5 April 2009 is in tax year 2008-09: N = 0.5, so 20.5% -> 8,000 x 1.1 x 0.205 = 1,804.
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 5 4 2009) (`Tax year` OF 2002) 10 EQUALS JUST 1804
-- 5 April 2003 is not after the end of the first appointed year: no percentage is given.
#ASSERT `sch 4A para 6 amount B in the first case` TRUE 8000 (Date 5 4 2003) (`Tax year` OF 2002) 10 EQUALS NOTHING
-- no assumed surplus: the text gives no amount.
#ASSERT `sch 4A para 6 amount B in the first case` FALSE 0 (Date 6 4 2009) (`Tax year` OF 2002) 10 EQUALS NOTHING

-- paragraph 4: amount C is A minus B, B being the first case's or the second's according to the kind of employment.
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by a salary related or money purchase contracted-out scheme` (JUST 2000) (JUST 1760) (JUST 500) EQUALS JUST 240
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by an appropriate personal pension scheme` (JUST 2000) (JUST 1760) (JUST 500) EQUALS JUST 1500
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by a salary related or money purchase contracted-out scheme` (JUST 100) (JUST 300) NOTHING EQUALS JUST (-200)
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by a salary related or money purchase contracted-out scheme` (JUST 2000) NOTHING (JUST 500) EQUALS NOTHING
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by a salary related or money purchase contracted-out scheme` NOTHING (JUST 1760) (JUST 500) EQUALS NOTHING
#ASSERT `sch 4A para 4 amount C` `sch 4A employment entirely qualifying for a pension provided by an appropriate personal pension scheme` (JUST 2000) (JUST 1760) NOTHING EQUALS NOTHING
-- employment that is not entirely of either kind: no amount B is given.
#ASSERT `sch 4A para 4 amount C` `sch 4A employment of neither kind` (JUST 2000) (JUST 1760) (JUST 500) EQUALS NOTHING
#ASSERT `sch 4A para 4 the difference` (JUST 5) (JUST 3) EQUALS JUST 2
#ASSERT `sch 4A para 8(3) section 44A is ignored in applying section 44(6)` `sch 4A para 8(3) calculating amount B` EQUALS JUST TRUE
#ASSERT `sch 4A para 8(3) section 44A is ignored in applying section 44(6)` `sch 4A para 8(3) some other purpose` EQUALS NOTHING
