#ASSERT `s 67(5) the enactment is a specified enactment` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 67(5) the enactment is a specified enactment` NOTHING EQUALS NOTHING

#ASSERT `s 67(7) the provision is within the word enactment in this section` TRUE EQUALS JUST TRUE
