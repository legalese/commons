IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc4-attendance-allowance`

-- TESTS for ssc4-attendance-allowance.l4 (ss 63-67). Every expected value is written from the text, beside its assertion,
-- before the run. A failing assertion is a finding and is never edited to match the code.

§ `Tests -- ss 63 to 67`

§§ `s 63 -- the list of non-contributory benefits`

-- s 63(a), (c), (d), (e), (f)(i), (f)(ii), (g) are named, so each is JUST TRUE.
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `attendance allowance` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `carer's allowance` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `disability living allowance` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `guardian's allowance` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `Category C retirement pension` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `Category D retirement pension` EQUALS JUST TRUE
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `age addition` EQUALS JUST TRUE
-- A benefit the list does not name: the list is not closed with "only", so NOTHING and never FALSE.
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `short-term incapacity benefit` EQUALS NOTHING
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `child benefit` EQUALS NOTHING
#ASSERT `s 63 the benefit is a non-contributory benefit under Part III` `Category A retirement pension` EQUALS NOTHING

-- s 63(f)(i): a widow whose husband was over pensionable age on 5 July 1948 (TRUE); a woman whose marriage to such a husband ended otherwise than by his death (TRUE); otherwise NOTHING.
#ASSERT `s 63(f)(i) a Category C retirement pension is payable in the case described` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 63(f)(i) a Category C retirement pension is payable in the case described` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 63(f)(i) a Category C retirement pension is payable in the case described` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 63(f)(i) a Category C retirement pension is payable in the case described` FALSE FALSE TRUE EQUALS NOTHING

-- s 63(f)(ii): over 80 -> TRUE; not over 80 or unknown -> NOTHING.
#ASSERT `s 63(f)(ii) a Category D retirement pension is payable to the person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 63(f)(ii) a Category D retirement pension is payable to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 63(f)(ii) a Category D retirement pension is payable to the person` NOTHING EQUALS NOTHING

-- s 63(g): over 80 and an increase of a retirement pension (TRUE) or of some other pension or allowance (TRUE); neither -> NOTHING; not over 80 -> NOTHING.
#ASSERT `s 63(g) an age addition is payable in the case described` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 63(g) an age addition is payable in the case described` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 63(g) an age addition is payable in the case described` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 63(g) an age addition is payable in the case described` (JUST FALSE) TRUE TRUE EQUALS NOTHING

§§ `s 64 -- entitlement`

-- s 64(1A): the five named allowances are within the subsection; another allowance is NOTHING (list not closed).
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A)(a) personal independence payment` EQUALS JUST TRUE
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A)(aa) adult disability payment` EQUALS JUST TRUE
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A)(b) the care component of a disability living allowance` EQUALS JUST TRUE
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A)(c) pension age disability payment` EQUALS JUST TRUE
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A)(d) the care component of Scottish adult disability living allowance` EQUALS JUST TRUE
#ASSERT `s 64(1A) the allowance is within this subsection` `s 64(1A) another allowance` EQUALS NOTHING

-- s 64(2): severely disabled, and either frequent attention or continual supervision.
`s 64(2) test day facts` MEANS `s 64(2) Day attendance facts` OF TRUE, TRUE, FALSE
`s 64(2) test day facts supervision only` MEANS `s 64(2) Day attendance facts` OF TRUE, FALSE, TRUE
`s 64(2) test day facts neither` MEANS `s 64(2) Day attendance facts` OF TRUE, FALSE, FALSE
`s 64(2) test day facts not severely disabled` MEANS `s 64(2) Day attendance facts` OF FALSE, TRUE, TRUE
#ASSERT `s 64(2) the person satisfies the day attendance condition` `s 64(2) test day facts` EQUALS JUST TRUE
#ASSERT `s 64(2) the person satisfies the day attendance condition` `s 64(2) test day facts supervision only` EQUALS JUST TRUE
#ASSERT `s 64(2) the person satisfies the day attendance condition` `s 64(2) test day facts neither` EQUALS JUST FALSE
#ASSERT `s 64(2) the person satisfies the day attendance condition` `s 64(2) test day facts not severely disabled` EQUALS JUST FALSE

-- s 64(3): severely disabled, and either prolonged or repeated attention or another person awake.
`s 64(3) test night facts` MEANS `s 64(3) Night attendance facts` OF TRUE, TRUE, FALSE
`s 64(3) test night facts watching only` MEANS `s 64(3) Night attendance facts` OF TRUE, FALSE, TRUE
`s 64(3) test night facts neither` MEANS `s 64(3) Night attendance facts` OF TRUE, FALSE, FALSE
`s 64(3) test night facts not severely disabled` MEANS `s 64(3) Night attendance facts` OF FALSE, TRUE, TRUE
#ASSERT `s 64(3) the person satisfies the night attendance condition` `s 64(3) test night facts` EQUALS JUST TRUE
#ASSERT `s 64(3) the person satisfies the night attendance condition` `s 64(3) test night facts watching only` EQUALS JUST TRUE
#ASSERT `s 64(3) the person satisfies the night attendance condition` `s 64(3) test night facts neither` EQUALS JUST FALSE
#ASSERT `s 64(3) the person satisfies the night attendance condition` `s 64(3) test night facts not severely disabled` EQUALS JUST FALSE

-- s 64(1): fixtures. The person attains pensionable age on 1 January 2016.
`s 64(1) test person` MEANS Person WITH
    `date of birth` IS Date 1 1 1950
    `sex` IS Woman
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2016

-- All conditions met, a month after pensionable age, no (1A) allowance, day condition only, prescribed conditions satisfied: entitled.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST TRUE
-- Boundary: on the very day pensionable age is attained the person "has attained" it (s 173(a): the time is the commencement of the anniversary, taken here as the day itself): entitled.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 1 2016) EMPTY `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST TRUE
-- Boundary: the day before pensionable age is attained, the "if he has attained pensionable age" fails: JUST FALSE.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 31 12 2015) EMPTY `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST FALSE
-- Night condition alone suffices ("either").
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts neither` `s 64(3) test night facts` (JUST TRUE) EQUALS JUST TRUE
-- Neither condition: JUST FALSE.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts neither` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST FALSE
-- Entitled to personal independence payment (within (1A)): "he is not entitled to an allowance within subsection (1A)" fails: JUST FALSE.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) (LIST `s 64(1A)(a) personal independence payment`) `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST FALSE
-- An allowance the (1A) list does not name: not decided, NOTHING.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) (LIST `s 64(1A) another allowance`) `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS NOTHING
-- A named (1A) allowance beside an unnamed one: the named one decides, JUST FALSE.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) (LIST `s 64(1A) another allowance`, `s 64(1A)(c) pension age disability payment`) `s 64(2) test day facts` `s 64(3) test night facts neither` (JUST TRUE) EQUALS JUST FALSE
-- Prescribed conditions known to fail: JUST FALSE. Unknown: NOTHING (the regulations are outside the sources).
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts` `s 64(3) test night facts` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts` `s 64(3) test night facts` NOTHING EQUALS NOTHING
-- A known failure of another limb beats an unknown prescribed condition: still JUST FALSE.
#ASSERT `s 64(1) the person is entitled to an attendance allowance` `s 64(1) test person` (Date 1 2 2016) EMPTY `s 64(2) test day facts neither` `s 64(3) test night facts neither` NOTHING EQUALS JUST FALSE

§§ `s 65 -- period and rate`

-- The calendar helper: the same day of the month some months from a date; NOTHING where the target month has no such day.
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 15 3 2025) 6 EQUALS JUST (Date 15 9 2025)
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 15 3 2025) (0 MINUS 6) EQUALS JUST (Date 15 9 2024)
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 10 1 2025) (0 MINUS 3) EQUALS JUST (Date 10 10 2024)
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 31 8 2025) 6 EQUALS NOTHING
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 31 3 2025) (0 MINUS 1) EQUALS NOTHING
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 29 3 2024) (0 MINUS 1) EQUALS JUST (Date 29 2 2024)
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 30 11 2025) 3 EQUALS NOTHING
#ASSERT `s 65(1)(b) the same day of the month some months from` (Date 30 10 2025) 3 EQUALS JUST (Date 30 1 2026)

-- s 65(1)(b): 1 January to 30 June is 6 months (the day after 30 June is the same day six months after 1 January): not less than 6 months.
#ASSERT `s 65(1)(b) the preceding period is not less than 6 months` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 30 6 2025) EQUALS JUST TRUE
-- One day short: 1 January to 29 June is less than 6 months.
#ASSERT `s 65(1)(b) the preceding period is not less than 6 months` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 29 6 2025) EQUALS JUST FALSE
-- Longer than 6 months.
#ASSERT `s 65(1)(b) the preceding period is not less than 6 months` (Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 31 7 2025) EQUALS JUST TRUE
-- A period beginning on the 31st: six months on is "31 February", which the Act does not resolve: NOTHING.
#ASSERT `s 65(1)(b) the preceding period is not less than 6 months` (Period WITH `the first day` IS Date 31 8 2025, `the last day` IS Date 28 2 2026) EQUALS NOTHING

-- s 65(1): fixtures. The period is 1 July to 31 December 2025; the preceding periods end at different times.
`s 65(1) test period` MEANS Period WITH `the first day` IS Date 1 7 2025, `the last day` IS Date 31 12 2025
`s 65(1) test preceding period immediately before` MEANS Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 30 6 2025
`s 65(1) test preceding period five days before` MEANS Period WITH `the first day` IS Date 1 12 2024, `the last day` IS Date 25 6 2025
`s 65(1) test preceding period too short` MEANS Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 29 6 2025
`s 65(1) test preceding period overlapping` MEANS Period WITH `the first day` IS Date 1 1 2025, `the last day` IS Date 2 7 2025
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period immediately before` TRUE NOTHING EQUALS JUST TRUE
-- A gap of 5 days (26-30 June) is within a prescribed time of 5 days (boundary) but not of 4 (just outside).
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period five days before` TRUE (JUST 5) EQUALS JUST TRUE
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period five days before` TRUE (JUST 4) EQUALS NOTHING
-- The prescribed time is not supplied: NOTHING.
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period five days before` TRUE NOTHING EQUALS NOTHING
-- The preceding period is under 6 months, or overlaps, or the conditions were not satisfied: NOTHING (the text states what the period "shall be").
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period too short` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period overlapping` TRUE (JUST 10) EQUALS NOTHING
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` FALSE `s 65(1) test preceding period immediately before` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 65(1) the period is one for which the person is entitled to an attendance allowance` `s 65(1) test period` TRUE `s 65(1) test preceding period immediately before` FALSE NOTHING EQUALS NOTHING

-- s 65(2): renal failure, prescribed treatment, prescribed circumstances: deemed. Otherwise NOTHING.
#ASSERT `s 65(2) the person is deemed to satisfy or to be likely to satisfy the day or the night attendance condition or both` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 65(2) the person is deemed to satisfy or to be likely to satisfy the day or the night attendance condition or both` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 65(2) the person is deemed to satisfy or to be likely to satisfy the day or the night attendance condition or both` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 65(2) the person is deemed to satisfy or to be likely to satisfy the day or the night attendance condition or both` TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- s 65(3): higher rate if both conditions both for the period and for the 6 months; the lower rate "in any other case". Rates are inputs (Schedule 4 table omitted): 100 and 60 are test numbers only.
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` TRUE TRUE (JUST 100) (JUST 60) EQUALS JUST 100
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` TRUE FALSE (JUST 100) (JUST 60) EQUALS JUST 60
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` FALSE TRUE (JUST 100) (JUST 60) EQUALS JUST 60
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` FALSE FALSE (JUST 100) (JUST 60) EQUALS JUST 60
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` TRUE TRUE NOTHING (JUST 60) EQUALS NOTHING
#ASSERT `s 65(3) the weekly rate of the attendance allowance in pounds` FALSE FALSE (JUST 100) NOTHING EQUALS NOTHING

-- s 65(4): barred for a day before the claim date (TRUE). The claim date itself and later days are outside the bar (NOTHING).
#ASSERT `s 65(4) the person is barred from an attendance allowance for the day by the date of claim` (Date 14 3 2025) (Date 15 3 2025) EQUALS JUST TRUE
#ASSERT `s 65(4) the person is barred from an attendance allowance for the day by the date of claim` (Date 15 3 2025) (Date 15 3 2025) EQUALS NOTHING
#ASSERT `s 65(4) the person is barred from an attendance allowance for the day by the date of claim` (Date 16 3 2025) (Date 15 3 2025) EQUALS NOTHING

-- s 65(6)(a): the period of entitlement begins 1 October 2025; the 6 months immediately preceding run from 1 April 2025 to 30 September 2025.
#ASSERT `s 65(6)(a) the claim may be made on the day` (Date 1 10 2025) (Date 1 4 2025) EQUALS JUST TRUE
#ASSERT `s 65(6)(a) the claim may be made on the day` (Date 1 10 2025) (Date 31 3 2025) EQUALS NOTHING
#ASSERT `s 65(6)(a) the claim may be made on the day` (Date 1 10 2025) (Date 30 9 2025) EQUALS JUST TRUE
#ASSERT `s 65(6)(a) the claim may be made on the day` (Date 1 10 2025) (Date 1 10 2025) EQUALS NOTHING
-- A period beginning 31 March: six months before is "31 September", which does not exist: NOTHING.
#ASSERT `s 65(6)(a) the claim may be made on the day` (Date 31 3 2026) (Date 15 1 2026) EQUALS NOTHING

-- s 65(6)(b): both conditions throughout (TRUE); at the lower rate one condition throughout (TRUE); otherwise "subject to the condition" fails (FALSE).
#ASSERT `s 65(6)(b) the condition on an award made on a claim made in advance is satisfied` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 65(6)(b) the condition on an award made on a claim made in advance is satisfied` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 65(6)(b) the condition on an award made on a claim made in advance is satisfied` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 65(6)(b) the condition on an award made on a claim made in advance is satisfied` FALSE TRUE FALSE EQUALS JUST FALSE

-- s 65(7): the Regulations apply and the UK is not competent: barred (TRUE). They apply and the UK is competent: "unless" is met, no bar (FALSE). They do not apply: NOTHING.
#ASSERT `s 65(7) the person is barred from an attendance allowance for the period by the Regulations` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 65(7) the person is barred from an attendance allowance for the period by the Regulations` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 65(7) the person is barred from an attendance allowance for the period by the Regulations` FALSE FALSE EQUALS NOTHING
#ASSERT `s 65(7) the person is barred from an attendance allowance for the period by the Regulations` FALSE TRUE EQUALS NOTHING

§§ `s 66 -- the terminally ill`

#ASSERT `s 66(2)(a) the person is terminally ill at the time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 66(2)(a) the person is terminally ill at the time` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 66(2)(a) the person is terminally ill at the time` FALSE TRUE EQUALS JUST FALSE

-- s 66(1)(a)(i) and (b): claim made on 10 March 2025 expressly on the ground; terminally ill throughout. A day before the claim is outside (NOTHING); the claim day is inside (TRUE).
#ASSERT `s 66(1)(a)(i) the person is taken to satisfy both the day attendance condition and the night attendance condition on the day` TRUE TRUE (Date 10 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 66(1)(a)(i) the person is taken to satisfy both the day attendance condition and the night attendance condition on the day` TRUE TRUE (Date 9 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 66(1)(a)(i) the person is taken to satisfy both the day attendance condition and the night attendance condition on the day` FALSE TRUE (Date 11 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 66(1)(a)(i) the person is taken to satisfy both the day attendance condition and the night attendance condition on the day` TRUE FALSE (Date 11 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 66(1)(b) the day is in the period for which the person is entitled to attendance allowance` TRUE TRUE (Date 10 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 66(1)(b) the day is in the period for which the person is entitled to attendance allowance` TRUE TRUE (Date 9 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 66(1)(b) the day is in the period for which the person is entitled to attendance allowance` FALSE TRUE (Date 20 3 2025) (Date 10 3 2025) EQUALS NOTHING

-- s 66(1)(a)(ii): the later of six months before the claim date and the first date terminally ill.
-- Claim 10 September 2025: six months before is 10 March 2025. Terminally ill since 1 January 2025 (earlier): 10 March 2025.
#ASSERT `s 66(1)(a)(ii) the first day of the period for which the person is taken to have satisfied the conditions` (Date 10 9 2025) (Date 1 1 2025) EQUALS JUST (Date 10 3 2025)
-- Terminally ill only since 1 June 2025 (later): 1 June 2025.
#ASSERT `s 66(1)(a)(ii) the first day of the period for which the person is taken to have satisfied the conditions` (Date 10 9 2025) (Date 1 6 2025) EQUALS JUST (Date 1 6 2025)
-- Terminally ill since exactly 10 March 2025: that day.
#ASSERT `s 66(1)(a)(ii) the first day of the period for which the person is taken to have satisfied the conditions` (Date 10 9 2025) (Date 10 3 2025) EQUALS JUST (Date 10 3 2025)
-- Claim 31 August 2025: six months before is "31 February 2025", which does not exist: NOTHING.
#ASSERT `s 66(1)(a)(ii) the first day of the period for which the person is taken to have satisfied the conditions` (Date 31 8 2025) (Date 1 1 2025) EQUALS NOTHING

#ASSERT `s 66(2)(b) the other person is regarded as making the claim` TRUE EQUALS JUST TRUE
#ASSERT `s 66(2)(b) the other person is regarded as making the claim` FALSE EQUALS NOTHING

