#ASSERT `s 67(3) the establishment is a care home` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 67(3) the establishment is a care home` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 67(3) the establishment is a care home` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 67(3) the establishment is a care home` FALSE TRUE TRUE EQUALS JUST FALSE

