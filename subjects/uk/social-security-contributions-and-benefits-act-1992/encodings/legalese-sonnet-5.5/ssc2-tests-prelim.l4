IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc2-prelim`

-- Tests for ssc2-prelim.l4 (ss 20 and 21). Every expected value is written by hand from the text,
-- beside the assertion, before the run. Calendar facts used (not from the Act):
--   1 January 2023 was a Sunday; 1 January 2021 a Friday, 2022 a Saturday, 2024 a Monday, 2025 a Wednesday;
--   25 December 2022 was a Sunday; 6 April 2010 was a Tuesday.

§ `Tests -- s 20 Descriptions of contributory benefits`

-- s 20(1): each listed description is a contributory benefit.
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `short-term incapacity benefit` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `long-term incapacity benefit` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `maternity allowance` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `widowed mother's allowance` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `widow's pension` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `widowed parent's allowance` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `Category A retirement pension` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `Category B retirement pension` FALSE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `shared additional pension` FALSE EQUALS JUST TRUE
-- limb (g): "for existing beneficiaries only" -- on both sides of the condition
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `child's special allowance` TRUE EQUALS JUST TRUE
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `child's special allowance` FALSE EQUALS JUST FALSE
-- outside the list: not covered (the list is not closed with "only")
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `attendance allowance` FALSE EQUALS NOTHING
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `child benefit` TRUE EQUALS NOTHING
#ASSERT `s 20(1) the benefit is a contributory benefit under this Part` `Christmas bonus` FALSE EQUALS NOTHING

-- s 20(2) "long-term benefit" means: LTIB, widowed mother's allowance, widowed parent's allowance,
-- widow's pension, a Category A or Category B retirement pension, a shared additional pension.
#ASSERT `s 20(2) the benefit is a long-term benefit` `long-term incapacity benefit` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `widowed mother's allowance` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `widowed parent's allowance` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `widow's pension` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `Category A retirement pension` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `Category B retirement pension` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a long-term benefit` `shared additional pension` EQUALS JUST TRUE
-- not on the "means" list: no
#ASSERT `s 20(2) the benefit is a long-term benefit` `short-term incapacity benefit` EQUALS JUST FALSE
#ASSERT `s 20(2) the benefit is a long-term benefit` `maternity allowance` EQUALS JUST FALSE
#ASSERT `s 20(2) the benefit is a long-term benefit` `child's special allowance` EQUALS JUST FALSE
#ASSERT `s 20(2) the benefit is a long-term benefit` `Category C retirement pension` EQUALS JUST FALSE

-- s 20(2) "short-term benefit" means: short-term incapacity benefit; maternity allowance.
#ASSERT `s 20(2) the benefit is a short-term benefit` `short-term incapacity benefit` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a short-term benefit` `maternity allowance` EQUALS JUST TRUE
#ASSERT `s 20(2) the benefit is a short-term benefit` `long-term incapacity benefit` EQUALS JUST FALSE
#ASSERT `s 20(2) the benefit is a short-term benefit` `widow's pension` EQUALS JUST FALSE
#ASSERT `s 20(2) the benefit is a short-term benefit` `Category A retirement pension` EQUALS JUST FALSE

-- s 20(3): subject to the Pensions Act reduction for a member of a contracted-out scheme.
#ASSERT `s 20(3) the provisions of this Part are subject to the Pensions Act reduction` TRUE EQUALS JUST TRUE
#ASSERT `s 20(3) the provisions of this Part are subject to the Pensions Act reduction` FALSE EQUALS NOTHING

§ `Tests -- s 21 Contribution conditions`

-- s 21(1): the requirement applies to a listed benefit by the ordinary route.
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `short-term incapacity benefit` FALSE `s 21(1) any route not carved out` EQUALS JUST TRUE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `Category A retirement pension` FALSE `s 21(1) any route not carved out` EQUALS JUST TRUE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `widow's pension` FALSE `s 21(1) any route not carved out` EQUALS JUST TRUE
-- each carve-out ("other than ...") is the text's own no
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `short-term incapacity benefit` FALSE `s 21(1) short-term incapacity benefit under section 30A(1)(b)` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `long-term incapacity benefit` FALSE `s 21(1) long-term incapacity benefit under section 30A(5)` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `maternity allowance` FALSE `s 21(1) maternity allowance under section 35` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `maternity allowance` FALSE `s 21(1) maternity allowance under section 35B` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `short-term incapacity benefit` FALSE `s 21(1) incapacity benefit under section 40` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `long-term incapacity benefit` FALSE `s 21(1) incapacity benefit under section 41` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `shared additional pension` FALSE `s 21(1) shared additional pension under section 55A` EQUALS JUST FALSE
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `shared additional pension` FALSE `s 21(1) shared additional pension under section 55AA` EQUALS JUST FALSE
-- a route that does not belong to the benefit named: not covered
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `widow's pension` FALSE `s 21(1) maternity allowance under section 35` EQUALS NOTHING
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `maternity allowance` FALSE `s 21(1) long-term incapacity benefit under section 30A(5)` EQUALS NOTHING
-- a benefit that s 20(1) does not decide, or child's special allowance for someone who is not an existing beneficiary
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `attendance allowance` FALSE `s 21(1) any route not carved out` EQUALS NOTHING
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `child's special allowance` FALSE `s 21(1) any route not carved out` EQUALS NOTHING
#ASSERT `s 21(1) the requirement of contribution conditions applies to the entitlement` `child's special allowance` TRUE `s 21(1) any route not carved out` EQUALS JUST TRUE

-- s 21(2): the table is omitted; the classes are an input.
#ASSERT `s 21(2) the classes of contribution relevant to the benefit` (JUST (LIST `Class 1 primary`, `Class 2`)) EQUALS JUST (LIST `Class 1 primary`, `Class 2`)
#ASSERT `s 21(2) the classes of contribution relevant to the benefit` NOTHING EQUALS NOTHING

-- s 21(3): Schedule 3 Part I answers; passed through.
#ASSERT `s 21(3) the relevant contribution conditions are those in Schedule 3 Part I` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 21(3) the relevant contribution conditions are those in Schedule 3 Part I` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 21(3) the relevant contribution conditions are those in Schedule 3 Part I` NOTHING EQUALS NOTHING

-- s 21(5)(a): the contributor concerned is the person by whom the condition is to be satisfied.
§§ `s 21(5) fixtures`
`s 21(5)(a) the claimant, a man born 3 March 1960` MEANS Person WITH
    `date of birth` IS Date 3 3 1960
    `sex` IS Man
    `marital status` IS `married`
    `date of attaining pensionable age` IS Date 3 3 2026
`s 21(5)(a) the late spouse, a woman born 9 June 1962` MEANS Person WITH
    `date of birth` IS Date 9 6 1962
    `sex` IS Woman
    `marital status` IS `widowed or a surviving civil partner`
    `date of attaining pensionable age` IS Date 9 6 2028

GIVEN p IS A MAYBE Person
GIVETH A BOOLEAN
`s 21(5)(a) test the person is the claimant` MEANS
    CONSIDER p
    WHEN JUST q THEN q's `date of birth` EQUALS Date 3 3 1960
    OTHERWISE FALSE
GIVEN p IS A MAYBE Person
GIVETH A BOOLEAN
`s 21(5)(a) test the person is the other person` MEANS
    CONSIDER p
    WHEN JUST q THEN q's `date of birth` EQUALS Date 9 6 1962
    OTHERWISE FALSE

#ASSERT `s 21(5)(a) test the person is the claimant` (`s 21(5)(a) the contributor concerned` `s 21(5)(a) the claimant, a man born 3 March 1960` (JUST `s 21(5)(a) the late spouse, a woman born 9 June 1962`) FALSE)
#ASSERT `s 21(5)(a) test the person is the other person` (`s 21(5)(a) the contributor concerned` `s 21(5)(a) the claimant, a man born 3 March 1960` (JUST `s 21(5)(a) the late spouse, a woman born 9 June 1962`) TRUE)
#ASSERT `s 21(5)(a) the contributor concerned` `s 21(5)(a) the claimant, a man born 3 March 1960` NOTHING TRUE EQUALS NOTHING

-- s 21(5)(b): a relevant class is one specified for the benefit in subsection (2).
#ASSERT `s 21(5)(b) the class is a relevant class in relation to the benefit` (JUST (LIST `Class 1 primary`, `Class 2`)) `Class 2` EQUALS JUST TRUE
#ASSERT `s 21(5)(b) the class is a relevant class in relation to the benefit` (JUST (LIST `Class 1 primary`, `Class 2`)) `Class 3` EQUALS JUST FALSE
#ASSERT `s 21(5)(b) the class is a relevant class in relation to the benefit` NOTHING `Class 2` EQUALS NOTHING

-- s 21(5)(c): paragraph (i) from 1987-88 (the tax year that begins in 1987), (ii) before.
#ASSERT `s 21(5)(c) the paragraph that governs the year` (`Tax year` WITH `calendar year in which it begins` IS 1987) EQUALS `s 21(5)(c)(i) the year is 1987-88 or a later tax year`
#ASSERT `s 21(5)(c) the paragraph that governs the year` (`Tax year` WITH `calendar year in which it begins` IS 2009) EQUALS `s 21(5)(c)(i) the year is 1987-88 or a later tax year`
#ASSERT `s 21(5)(c) the paragraph that governs the year` (`Tax year` WITH `calendar year in which it begins` IS 1986) EQUALS `s 21(5)(c)(ii) the year is an earlier tax year`
-- (i): 3000 + 500 + 200 = 3700 ; (ii): 100 + 200 = 300, and none is 0.
#ASSERT `s 21(5)(c)(i) the earnings factor for a year from 1987-88` 3000 500 200 EQUALS 3700
#ASSERT `s 21(5)(c)(i) the earnings factor for a year from 1987-88` 0 0 0 EQUALS 0
#ASSERT `s 21(5)(c)(ii) the earnings factor for an earlier year` (LIST 100, 200) EQUALS 300
#ASSERT `s 21(5)(c)(ii) the earnings factor for an earlier year` EMPTY EQUALS 0

-- s 21(5)(d): "year" means a tax year, except in "benefit year".
#ASSERT `s 21(5)(d) what year means` FALSE EQUALS `s 21(5)(d) a tax year`
#ASSERT `s 21(5)(d) what year means` TRUE EQUALS `s 21(5)(d) the period defined in subsection (6)`

-- s 21(5A): contributions treated as paid on so much of the earnings as did not exceed the upper
-- earnings limit. With a limit of 770: 800 -> 770, 770 -> 770, 700 -> 700; not paid -> not covered.
#ASSERT `s 21(5A) the earnings on which contributions are treated as paid` 800 770 TRUE EQUALS JUST 770
#ASSERT `s 21(5A) the earnings on which contributions are treated as paid` 770 770 TRUE EQUALS JUST 770
#ASSERT `s 21(5A) the earnings on which contributions are treated as paid` 700 770 TRUE EQUALS JUST 700
#ASSERT `s 21(5A) the earnings on which contributions are treated as paid` 800 770 FALSE EQUALS NOTHING
-- the provisions the three paragraphs list (spot checks in each of (a), (b) and (c)), and one that is not listed
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "21(5)(c)" EQUALS JUST TRUE
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "22(1)(a)" EQUALS JUST TRUE
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "44(6)(za)" EQUALS JUST TRUE
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "sch 3 para 7(4)(a)" EQUALS JUST TRUE
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "22(1)(b)" EQUALS NOTHING
#ASSERT `s 21(5A) the provision is one mentioned in section 21(5A)(a) to (c)` "sch 3 para 2(4)(b)" EQUALS NOTHING
#ASSERT count `s 21(5A) the provisions mentioned in paragraphs (a) to (c)` EQUALS 15

§ `Tests -- s 21(6) benefit year`

-- Weekdays (0 Sunday ... 6 Saturday): the Sunday of 1 January 2023, the Saturday before it, a Monday, and dates before
-- the 2023 anchor (the modulo must stay positive).
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 1 1 2023) EQUALS 0
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 31 12 2022) EQUALS 6
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 1 1 2024) EQUALS 1
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 25 12 2022) EQUALS 0
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 6 4 2010) EQUALS 2
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (Date 1 1 2021) EQUALS 5

-- (a) first Sunday in January
#ASSERT `s 21(6)(a) the first Sunday in January of the year` 2021 EQUALS Date 3 1 2021
#ASSERT `s 21(6)(a) the first Sunday in January of the year` 2022 EQUALS Date 2 1 2022
#ASSERT `s 21(6)(a) the first Sunday in January of the year` 2023 EQUALS Date 1 1 2023
#ASSERT `s 21(6)(a) the first Sunday in January of the year` 2024 EQUALS Date 7 1 2024
#ASSERT `s 21(6)(a) the first Sunday in January of the year` 2025 EQUALS Date 5 1 2025
-- (b) the Saturday before the first Sunday of the following January
#ASSERT `s 21(6)(b) the last day of the benefit year that begins in the year` 2021 EQUALS Date 1 1 2022
#ASSERT `s 21(6)(b) the last day of the benefit year that begins in the year` 2022 EQUALS Date 31 12 2022
#ASSERT `s 21(6)(b) the last day of the benefit year that begins in the year` 2023 EQUALS Date 6 1 2024
#ASSERT `s 21(6)(b) the last day of the benefit year that begins in the year` 2024 EQUALS Date 4 1 2025
-- the Saturday that ends one year is followed by the Sunday that starts the next: both sides of the boundary
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` (`s 21(6)(b) the last day of the benefit year that begins in the year` 2022) EQUALS 6
#ASSERT `s 21(6)(a) the weekday of the date, 0 for Sunday` ((`s 21(6)(b) the last day of the benefit year that begins in the year` 2022) PLUS 1) EQUALS 0
#ASSERT (`s 21(6)(b) the last day of the benefit year that begins in the year` 2022) PLUS 1 EQUALS `s 21(6)(a) the first Sunday in January of the year` 2023
-- the whole period, with no prescribed other period
#ASSERT (`s 21(6) the benefit year that begins in the calendar year` 2023 NOTHING)'s `the first day` EQUALS Date 1 1 2023
#ASSERT (`s 21(6) the benefit year that begins in the calendar year` 2023 NOTHING)'s `the last day` EQUALS Date 6 1 2024
-- a period of 53 weeks is possible: 371 days from Sunday 1 January 2023 to Saturday 6 January 2024
#ASSERT (Day (Date 6 1 2024)) MINUS (Day (Date 1 1 2023)) PLUS 1 EQUALS 371
-- the proviso: prescribed other period
#ASSERT (`s 21(6) the benefit year that begins in the calendar year` 2023 (JUST (Period WITH `the first day` IS Date 6 4 2023, `the last day` IS Date 5 4 2024)))'s `the first day` EQUALS Date 6 4 2023
#ASSERT (`s 21(6) the benefit year that begins in the calendar year` 2023 (JUST (Period WITH `the first day` IS Date 6 4 2023, `the last day` IS Date 5 4 2024)))'s `the last day` EQUALS Date 5 4 2024
