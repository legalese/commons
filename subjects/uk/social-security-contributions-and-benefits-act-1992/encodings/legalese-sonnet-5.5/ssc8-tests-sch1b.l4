IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc8-sch1b`

-- Tests for ssc8-sch1b.l4 (Schedule 1, paragraphs 6 to 11). Expected values are worked by hand from the paragraph named beside each assertion.

§ `Tests for Schedule 1, paragraphs 6 to 11`

§§ `Paragraph 6 -- power to combine collection of contributions with tax`

#ASSERT `sch 1 para 6(2) the reference in sub-paragraph (1)(b) or (c) includes the thing` `sch 1 para 6(2) interest in respect of contributions or income tax` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(2) the reference in sub-paragraph (1)(b) or (c) includes the thing` `sch 1 para 6(2) a penalty in respect of contributions or income tax` EQUALS JUST TRUE
#ASSERT `sch 1 para 6(2) the reference in sub-paragraph (1)(b) or (c) includes the thing` `sch 1 para 6(2) something else` EQUALS NOTHING
#ASSERT `sch 1 para 6(3) the rate of interest` (JUST 4.5) EQUALS JUST 4.5
#ASSERT `sch 1 para 6(3) the rate of interest` NOTHING EQUALS NOTHING
-- (4): decision pending and affecting the interest: the regulations may not require it; once made, or if either limb is missing: the sub-paragraph says nothing.
#ASSERT `sch 1 para 6(4) regulations under sub-paragraph (1) may require the interest to be paid` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4) regulations under sub-paragraph (1) may require the interest to be paid` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 6(4) regulations under sub-paragraph (1) may require the interest to be paid` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 6(4) regulations under sub-paragraph (1) may require the interest to be paid` TRUE FALSE FALSE EQUALS NOTHING
-- (4A): a relevant tax appeal brought but not finally determined.
#ASSERT `sch 1 para 6(4A) regulations under sub-paragraph (1) may require interest on the Class 1B sum to be paid` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4A) regulations under sub-paragraph (1) may require interest on the Class 1B sum to be paid` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 6(4A) regulations under sub-paragraph (1) may require interest on the Class 1B sum to be paid` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 6(4A) regulations under sub-paragraph (1) may require interest on the Class 1B sum to be paid` FALSE TRUE FALSE EQUALS NOTHING
-- (4B) and (4C).
#ASSERT `sch 1 para 6(4B) a deduction of income tax is made from the interest` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4B) a deduction of income tax is made from the interest` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 6(4B) the interest is taken into account in computing income, profits or losses for tax purposes` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4B) the interest is taken into account in computing income, profits or losses for tax purposes` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 6(4C) the interest is taken into account in computing income, profits or losses for tax purposes` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 6(4C) the interest is taken into account in computing income, profits or losses for tax purposes` FALSE EQUALS NOTHING

§§ `Paragraph 7 -- special penalties in the case of certain returns`

#ASSERT `sch 1 para 7(1) this paragraph applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 1 para 7(1) this paragraph applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 7(1) this paragraph applies` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(2) section 98A of the Taxes Management Act 1970 applies to the contributions return as to the tax return` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 7(2) section 98A of the Taxes Management Act 1970 applies to the contributions return as to the tax return` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(2) section 98A of the Taxes Management Act 1970 applies to the contributions return as to the tax return` NOTHING TRUE EQUALS NOTHING
#ASSERT `sch 1 para 7(2) section 98A of the Taxes Management Act 1970 applies to the contributions return as to the tax return` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `sch 1 para 7(3) the person may also be required to pay a penalty under paragraph (a) for the associated contributions return` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 7(3) the person may also be required to pay a penalty under paragraph (a) for the associated contributions return` FALSE EQUALS NOTHING
-- (5): the limit is the two maxima added: 300 + 200.
#ASSERT `sch 1 para 7(5) the limit of the single penalty` 300 200 EQUALS 500
-- (4): a single penalty not exceeding the limit: 450 proposed, limit 500 -> 450; 600 proposed -> 500.
#ASSERT `sch 1 para 7(4) the single penalty that may be imposed` TRUE TRUE 450 500 EQUALS JUST 450
#ASSERT `sch 1 para 7(4) the single penalty that may be imposed` TRUE TRUE 600 500 EQUALS JUST 500
#ASSERT `sch 1 para 7(4) the single penalty that may be imposed` TRUE TRUE 500 500 EQUALS JUST 500
#ASSERT `sch 1 para 7(4) the single penalty that may be imposed` TRUE FALSE 450 500 EQUALS NOTHING
#ASSERT `sch 1 para 7(4) the single penalty that may be imposed` FALSE TRUE 450 500 EQUALS NOTHING
-- (6): 600 recovered, T = 100, C = 200: income tax 600 x 100/300 = 200; contributions 600 x 200/300 = 400.
#ASSERT `sch 1 para 7(6) the part apportioned to income tax` 600 100 200 EQUALS JUST 200
#ASSERT `sch 1 para 7(6) the part apportioned to contributions` 600 100 200 EQUALS JUST 400
-- T nil: all to contributions; both nil: the ratio is not defined.
#ASSERT `sch 1 para 7(6) the part apportioned to income tax` 90 0 50 EQUALS JUST 0
#ASSERT `sch 1 para 7(6) the part apportioned to contributions` 90 0 50 EQUALS JUST 90
#ASSERT `sch 1 para 7(6) the part apportioned to income tax` 90 0 0 EQUALS NOTHING
#ASSERT `sch 1 para 7(6) the part apportioned to contributions` 90 0 0 EQUALS NOTHING
#ASSERT `sch 1 para 7(8) sub-paragraph (6) has effect` TRUE EQUALS TRUE
#ASSERT `sch 1 para 7(8) sub-paragraph (6) has effect` FALSE EQUALS TRUE
#ASSERT `sch 1 para 7(9) the tax year corresponding to the year of assessment` 2004 EQUALS `Tax year` OF 2004
#ASSERT `sch 1 para 7(10) what is omitted in applying the subsection` `sch 1 para 7(10)(a) subsection (2)` EQUALS JUST "the words ' or Northern Ireland ' and paragraph (c)"
#ASSERT `sch 1 para 7(10) what is omitted in applying the subsection` `sch 1 para 7(10)(b) subsection (3)` EQUALS JUST "the words from ' and any such proceedings instituted in Northern Ireland ' onwards"
#ASSERT `sch 1 para 7(10) what is omitted in applying the subsection` `sch 1 para 7(10) some other subsection` EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 1 primary` EQUALS JUST TRUE
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 1 secondary` EQUALS JUST TRUE
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 1A` EQUALS JUST TRUE
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 1B` EQUALS JUST TRUE
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 2` EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 3` EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 3A` EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(a) the reference to tax in section 103(1) includes the contributions` `Class 4` EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(b) the penalty is regarded as a penalty in respect of the tax return` TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 7(11)(b) the penalty is regarded as a penalty in respect of the tax return` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(11)(c) section 103(1)(b) applies to the penalty in respect of the associated contributions return` TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 7(11)(c) section 103(1)(b) applies to the penalty in respect of the associated contributions return` FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(12) a penalty under section 98A may be imposed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 1 para 7(12) a penalty under section 98A may be imposed` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(12) a penalty under section 98A may be imposed` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 7(12) a penalty under section 98A may be imposed` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7(13) the contributions return and the tax return are associated` TRUE FALSE EQUALS TRUE
#ASSERT `sch 1 para 7(13) the contributions return and the tax return are associated` FALSE TRUE EQUALS TRUE
#ASSERT `sch 1 para 7(13) the contributions return and the tax return are associated` TRUE TRUE EQUALS TRUE
#ASSERT `sch 1 para 7(13) the contributions return and the tax return are associated` FALSE FALSE EQUALS FALSE

§§ `Paragraph 7A -- penalties for fraud or negligence in contributions returns`

#ASSERT `sch 1 para 7A(1) this paragraph applies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `sch 1 para 7A(1) this paragraph applies` (JUST FALSE) EQUALS NOTHING
#ASSERT `sch 1 para 7A(1) this paragraph applies` NOTHING EQUALS NOTHING
-- leap years: 2024 and 2000 are; 1900 and 2023 are not.
#ASSERT `sch 1 paras 7A and 7B the year is a leap year` 2024 EQUALS TRUE
#ASSERT `sch 1 paras 7A and 7B the year is a leap year` 2000 EQUALS TRUE
#ASSERT `sch 1 paras 7A and 7B the year is a leap year` 1900 EQUALS FALSE
#ASSERT `sch 1 paras 7A and 7B the year is a leap year` 2023 EQUALS FALSE
-- anniversaries: 15 March 2010 + 6 years; 29 February 2008 + 4 years is 29 February 2012; + 6 or + 3 years there is no 29 February.
#ASSERT `sch 1 paras 7A and 7B the anniversary of the day` 6 (Date 15 3 2010) EQUALS JUST (Date 15 3 2016)
#ASSERT `sch 1 paras 7A and 7B the anniversary of the day` 4 (Date 29 2 2008) EQUALS JUST (Date 29 2 2012)
#ASSERT `sch 1 paras 7A and 7B the anniversary of the day` 6 (Date 29 2 2008) EQUALS NOTHING
#ASSERT `sch 1 paras 7A and 7B the anniversary of the day` 3 (Date 29 2 2008) EQUALS NOTHING
-- (3)(b): incurred 15 March 2010; the sixth anniversary, 15 March 2016, is the last day.
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 14 3 2016) EQUALS JUST TRUE
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 15 3 2016) EQUALS JUST TRUE
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 16 3 2016) EQUALS NOTHING
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 16 3 2010) EQUALS JUST TRUE
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 15 3 2010) EQUALS NOTHING
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) (Date 14 3 2010) EQUALS NOTHING
-- incurred on 29 February 2008: the sixth anniversary does not exist.
#ASSERT `sch 1 para 7A(3)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 29 2 2008) (Date 1 1 2010) EQUALS NOTHING

§§ `Paragraph 7B -- collection of contributions otherwise than through the PAYE system`

#ASSERT `sch 1 para 7B(3) regulations under sub-paragraph (2)(e) may require the interest to be paid` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 1 para 7B(3) regulations under sub-paragraph (2)(e) may require the interest to be paid` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 7B(3) regulations under sub-paragraph (2)(e) may require the interest to be paid` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 7B(3) regulations under sub-paragraph (2)(e) may require the interest to be paid` TRUE FALSE FALSE EQUALS NOTHING
-- (5)(b)(i): within six years of incurring on 15 March 2010.
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) FALSE NOTHING (Date 15 3 2016) EQUALS JUST TRUE
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) FALSE NOTHING (Date 16 3 2016) EQUALS NOTHING
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) TRUE NOTHING (Date 14 3 2016) EQUALS JUST TRUE
-- (5)(b)(ii): amount ascertained by reference to contributions, final determination on 1 June 2015: three years after is 1 June 2018.
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) TRUE (JUST (Date 1 6 2015)) (Date 16 3 2016) EQUALS JUST TRUE
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) TRUE (JUST (Date 1 6 2015)) (Date 1 6 2018) EQUALS JUST TRUE
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) TRUE (JUST (Date 1 6 2015)) (Date 2 6 2018) EQUALS NOTHING
-- no final determination yet, or the amount is not ascertained by reference to contributions: only limb (i) is open.
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) TRUE NOTHING (Date 16 3 2016) EQUALS NOTHING
#ASSERT `sch 1 para 7B(5)(b) the penalty may be imposed by the Inland Revenue on the day` (Date 15 3 2010) FALSE (JUST (Date 1 6 2015)) (Date 16 3 2016) EQUALS NOTHING
-- (8): "only to the extent": the smaller of what was charged and what would have been chargeable.
#ASSERT `sch 1 para 7B(8) the interest or penalties that may be charged for the earlier period` 500 300 EQUALS 300
#ASSERT `sch 1 para 7B(8) the interest or penalties that may be charged for the earlier period` 200 300 EQUALS 200
#ASSERT `sch 1 para 7B(8) the interest or penalties that may be charged for the earlier period` 300 300 EQUALS 300
#ASSERT `sch 1 para 7B(9) the reference to contributions in sub-paragraph (1) includes the thing` `sch 1 para 7B(9)(e) interest payable in respect of contributions by virtue of regulations under paragraph (e) of sub-paragraph (2)` EQUALS JUST TRUE
#ASSERT `sch 1 para 7B(9) the reference to contributions in sub-paragraph (1) includes the thing` `sch 1 para 7B(9)(h) a penalty payable in respect of contributions by virtue of regulations under paragraph (h) of sub-paragraph (2)` EQUALS JUST TRUE
#ASSERT `sch 1 para 7B(9) the reference to contributions in sub-paragraph (1) includes the thing` `sch 1 para 7B(9) something else` EQUALS NOTHING
#ASSERT `sch 1 para 7B(10) the rate of interest` (JUST 3) EQUALS JUST 3
#ASSERT `sch 1 para 7B(10) the rate of interest` NOTHING EQUALS NOTHING

§§ `Paragraph 7C -- recovery in a similar manner to income tax`

#ASSERT `sch 1 para 7C(3) the reference to contributions in this paragraph includes the thing` `sch 1 para 7C(3)(e) interest payable in respect of contributions by virtue of regulations under paragraph (e) of paragraph 7B(2)` EQUALS JUST TRUE
#ASSERT `sch 1 para 7C(3) the reference to contributions in this paragraph includes the thing` `sch 1 para 7C(3)(h) a penalty payable in respect of contributions by virtue of regulations under paragraph (h) of paragraph 7B(2)` EQUALS JUST TRUE
#ASSERT `sch 1 para 7C(3) the reference to contributions in this paragraph includes the thing` `sch 1 para 7C(3) something else` EQUALS NOTHING

§§ `Paragraph 10 -- deduction of contributions from pension, etc.`

-- (1): any class other than Class 1 (primary or secondary) and Class 4, a pension payable by the Secretary of State, the person consenting.
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 2` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 3` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 3A` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 1A` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 1B` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 1 primary` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 1 secondary` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 4` TRUE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 2` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the Secretary of State may pay the contributions and deduct the amount from the pension or allowance` `Class 2` TRUE FALSE EQUALS NOTHING
-- deduction: 100 less 30 is 70; 100 less 100 is nil; 101 exceeds the pension payable: the text is silent.
#ASSERT `sch 1 para 10(1) the pension or allowance left after the deduction` (JUST TRUE) 100 30 EQUALS JUST 70
#ASSERT `sch 1 para 10(1) the pension or allowance left after the deduction` (JUST TRUE) 100 100 EQUALS JUST 0
#ASSERT `sch 1 para 10(1) the pension or allowance left after the deduction` (JUST TRUE) 100 101 EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the pension or allowance left after the deduction` NOTHING 100 30 EQUALS NOTHING
#ASSERT `sch 1 para 10(1) the pension or allowance left after the deduction` (JUST FALSE) 100 30 EQUALS NOTHING
-- (2): notwithstanding anything in any Act, Royal Warrant, Order in Council, order or scheme.
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) an Act` EQUALS JUST TRUE
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) a Royal Warrant` EQUALS JUST TRUE
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) an Order in Council` EQUALS JUST TRUE
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) an order` EQUALS JUST TRUE
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) a scheme` EQUALS JUST TRUE
#ASSERT `sch 1 para 10(2) sub-paragraph (1) has effect despite the instrument` `sch 1 para 10(2) something else` EQUALS NOTHING

§§ `Paragraph 11 -- sickness payments counting as remuneration`

#ASSERT `sch 1 para 11(2) the amendments may be made notwithstanding the society's rules` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 1 para 11(2) the amendments may be made notwithstanding the society's rules` TRUE FALSE EQUALS NOTHING
#ASSERT `sch 1 para 11(2) the amendments may be made notwithstanding the society's rules` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 1 para 11(2) the amendments may be made notwithstanding the society's rules` FALSE FALSE EQUALS NOTHING

§§ `The regulative twin of paragraph 10(1) (trace; check.sh does not see its outcome)`

-- 10(1): the Secretary of State pays and deducts at time 1: FULFILLED expected.
#TRACE `sch 1 para 10(1) the Secretary of State's permission to pay and deduct` AT 0 WITH
    PARTY `sch 1 para 10(1) the Secretary of State` DOES `sch 1 para 10(1) pays the contributions and deducts the amount from the pension or allowance` AT 1
