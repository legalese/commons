IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc4-guardians-and-aged`

-- TESTS for ssc4-guardians-and-aged.l4 (ss 77-79). Expected values are written from the text beside each assertion.

§ `Tests -- ss 77 to 79`

§§ `s 77 -- guardian's allowance`

-- s 77(2): (a) both parents dead; (b) one dead, claimant unaware of the other's whereabouts and failed after reasonable efforts; (c) one dead, the other in prison.
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE TRUE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE TRUE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 77(2) the circumstances are among those referred to in subsection (1)(b)` FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 77(1): entitled to child benefit and the circumstances are in (2): entitled. Either fails: JUST FALSE. The circumstances unknown: NOTHING, unless child benefit already fails.
#ASSERT `s 77(1) the person is entitled to a guardian's allowance in respect of the child or qualifying young person` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 77(1) the person is entitled to a guardian's allowance in respect of the child or qualifying young person` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 77(1) the person is entitled to a guardian's allowance in respect of the child or qualifying young person` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(1) the person is entitled to a guardian's allowance in respect of the child or qualifying young person` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 77(1) the person is entitled to a guardian's allowance in respect of the child or qualifying young person` FALSE NOTHING EQUALS JUST FALSE

-- s 77(3): the prescribed conditions met by a parent: no bar (FALSE). Not met: barred (TRUE). Unknown: NOTHING.
#ASSERT `s 77(3) the person is barred from a guardian's allowance by the parents' conditions` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 77(3) the person is barred from a guardian's allowance by the parents' conditions` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(3) the person is barred from a guardian's allowance by the parents' conditions` NOTHING EQUALS NOTHING

-- s 77(6): the amount otherwise payable is 20 pounds a week (a test number: the real one is in Schedule 4).
-- (a) at least 20 a week by the beneficiary: boundary 20 meets it, 19.99 does not. Spouses residing together may pool: 12 + 8 together is 20.
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 20 FALSE 0 (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 19.99 FALSE 0 (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 12 TRUE 20 (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 12 TRUE 19 (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- Pooling is for spouses residing together only.
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 12 FALSE 20 (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- (b): over and above the s 143(1)(b) contributions, or a prescribed case; both negative: FALSE; unknown: NOTHING.
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 20 FALSE 0 (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 20 FALSE 0 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 20 FALSE 0 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 20 FALSE 0 (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 77(6) the condition in subsection (5)(b) is satisfied` 20 10 FALSE 0 NOTHING NOTHING EQUALS JUST FALSE

-- s 77(4): either condition of (5) met: payable, no bar (FALSE). Neither: barred (TRUE). Unknown: NOTHING.
#ASSERT `s 77(4) the amount is barred from payment by the conditions in subsection (5)` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(4) the amount is barred from payment by the conditions in subsection (5)` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 77(4) the amount is barred from payment by the conditions in subsection (5)` (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(4) the amount is barred from payment by the conditions in subsection (5)` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 77(4) the amount is barred from payment by the conditions in subsection (5)` NOTHING (JUST TRUE) EQUALS JUST FALSE

#ASSERT `s 77(7) the weekly rate of a guardian's allowance in pounds` (JUST 21.15) EQUALS JUST 21.15
#ASSERT `s 77(7) the weekly rate of a guardian's allowance in pounds` NOTHING EQUALS NOTHING

-- s 77(9): a married or civil-partnered man and woman residing together, each entitled: only the woman. Otherwise outside the sentence.
#ASSERT `s 77(9) the person is the one who is entitled to the guardian's allowance` Woman TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 77(9) the person is the one who is entitled to the guardian's allowance` Man TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 77(9) the person is the one who is entitled to the guardian's allowance` Man FALSE TRUE EQUALS NOTHING
#ASSERT `s 77(9) the person is the one who is entitled to the guardian's allowance` Woman TRUE FALSE EQUALS NOTHING
-- Payment: to either unless she elects it is not to be made to him.
#ASSERT `s 77(9) payment may be made to the man` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77(9) payment may be made to the man` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 77(9) payment may be made to the man` FALSE FALSE EQUALS NOTHING
-- The permission as a regulative rule, read with #TRACE: the woman elects (FULFILLED). The text sets no time limit, so none is invented; the permission cannot be shown breached.
#TRACE `s 77(9) the woman may elect that payment is not to be made to the man` AT 0 WITH
    PARTY `s 77(9) the woman` DOES `s 77(9) elects in the prescribed manner that payment is not to be made to the man` AT 5

-- s 77(11) and (10).
#ASSERT `s 77(11) subsection (10) does not terminate the person's entitlement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 77(11) subsection (10) does not terminate the person's entitlement` TRUE FALSE EQUALS NOTHING
#ASSERT `s 77(11) subsection (10) does not terminate the person's entitlement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 77(10) the person is barred from a guardian's allowance because he or she is the parent` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(10) the person is barred from a guardian's allowance because he or she is the parent` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 77(10) the person is barred from a guardian's allowance because he or she is the parent` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 77(10) the person is barred from a guardian's allowance because he or she is the parent` FALSE (JUST FALSE) EQUALS NOTHING

§§ `s 78 -- Category D retirement pension`

-- s 78(4): 100 less 10 (additional pension), 5, 3 (increases) and 2 (graduated retirement benefit) is 80.
#ASSERT `s 78(4) the weekly rate of the pension disregarding the elements in pounds` 100 10 5 3 2 EQUALS 80
#ASSERT `s 78(4) the weekly rate of the pension disregarding the elements in pounds` 100 0 0 0 0 EQUALS 100

`s 78(3) test person reached pensionable age on 5 April 2016` MEANS Person WITH
    `date of birth` IS Date 5 4 1951
    `sex` IS Woman
    `marital status` IS `widowed or a surviving civil partner`
    `date of attaining pensionable age` IS Date 5 4 2016
`s 78(3) test person reached pensionable age on 6 April 2016` MEANS Person WITH
    `date of birth` IS Date 6 4 1951
    `sex` IS Woman
    `marital status` IS `widowed or a surviving civil partner`
    `date of attaining pensionable age` IS Date 6 4 2016

-- s 78(3): within the class (over 80, before 6 April 2016, prescribed conditions) and (a) not entitled to Category A, B or C: entitled.
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) FALSE 0 NOTHING EQUALS JUST TRUE
-- (b) entitled to such a pension at 80 a week (disregarding the elements) against the appropriate rate of 100 (a test number): less, so entitled; equal or more: not.
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) TRUE 80 (JUST 100) EQUALS JUST TRUE
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) TRUE 99.99 (JUST 100) EQUALS JUST TRUE
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) TRUE 100 (JUST 100) EQUALS JUST FALSE
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) TRUE 120 (JUST 100) EQUALS JUST FALSE
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST TRUE) TRUE 80 NOTHING EQUALS NOTHING
-- Outside the class: reached pensionable age on 6 April 2016 (not "before"), not over 80, or prescribed conditions not met: NOTHING.
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 6 April 2016` (JUST TRUE) (JUST TRUE) FALSE 0 NOTHING EQUALS NOTHING
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST FALSE) (JUST TRUE) FALSE 0 NOTHING EQUALS NOTHING
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) (JUST FALSE) FALSE 0 NOTHING EQUALS NOTHING
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` NOTHING (JUST TRUE) FALSE 0 NOTHING EQUALS NOTHING
#ASSERT `s 78(3) the person is entitled to a Category D retirement pension` `s 78(3) test person reached pensionable age on 5 April 2016` (JUST TRUE) NOTHING FALSE 0 NOTHING EQUALS NOTHING

#ASSERT `s 78(6) the appropriate weekly rate of a Category D retirement pension in pounds` (JUST 88.9) EQUALS JUST 88.9
#ASSERT `s 78(6) the appropriate weekly rate of a Category D retirement pension in pounds` NOTHING EQUALS NOTHING
#ASSERT `s 78(7) the entitlement continues on the day` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 78(7) the entitlement continues on the day` TRUE FALSE EQUALS NOTHING
#ASSERT `s 78(7) the entitlement continues on the day` FALSE TRUE EQUALS NOTHING
-- s 78(8): the commencing day is 10 March 2025: a day before it is barred; the day itself and later days are outside the bar.
#ASSERT `s 78(8) the Category D retirement pension is barred from payment for the day` (Date 9 3 2025) (Date 10 3 2025) EQUALS JUST TRUE
#ASSERT `s 78(8) the Category D retirement pension is barred from payment for the day` (Date 10 3 2025) (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 78(8) the Category D retirement pension is barred from payment for the day` (Date 11 3 2025) (Date 10 3 2025) EQUALS NOTHING

§§ `s 79 -- age addition`

#ASSERT `s 79(1) the person is entitled to an age addition to a retirement pension` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 79(1) the person is entitled to an age addition to a retirement pension` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 79(1) the person is entitled to an age addition to a retirement pension` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 79(1) the person is entitled to an age addition to a retirement pension` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 79(2) the person is entitled to an age addition to another pension or allowance` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 79(2) the person is entitled to an age addition to another pension or allowance` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 79(2) the person is entitled to an age addition to another pension or allowance` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 79(2) the person is entitled to an age addition to another pension or allowance` (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 79(3) the age addition is payable on the day` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 79(3) the age addition is payable on the day` TRUE FALSE EQUALS NOTHING
#ASSERT `s 79(3) the weekly rate of age addition in pounds` (JUST 0.25) EQUALS JUST 0.25
#ASSERT `s 79(3) the weekly rate of age addition in pounds` NOTHING EQUALS NOTHING
