#ASSERT `s 171ZZ(2) the agreement authorising deductions is not void by virtue of subsection (1)(a)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZZ(2) the agreement authorising deductions is not void by virtue of subsection (1)(a)` FALSE FALSE EQUALS JUST FALSE

