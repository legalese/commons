IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc1-prelim`
IMPORT `ssc1-class1`
IMPORT `ssc1-class4`
IMPORT `ssc1-class23`

-- Tests for ssc1-class23.l4 (ss 11 to 14C). Every expected value is written from the text beside the assertion.

§ `Tests for ss 11 to 14C`

§§ `s 11`

-- s 11(1)
#ASSERT `s 11(1) section 11 applies` TRUE EQUALS JUST TRUE
#ASSERT `s 11(1) section 11 applies` FALSE EQUALS JUST FALSE
-- s 11(3): profits from the employment on which Class 4 is payable (or would be above the lower limit)
#ASSERT `s 11(3) the profits are relevant profits` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 11(3) the profits are relevant profits` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 11(3) the profits are relevant profits` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 11(3) the profits are relevant profits` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 11(3) the profits are relevant profits` FALSE NOTHING EQUALS JUST FALSE
-- s 11(4)(b): "£7,105"
#ASSERT `s 11(4)(b) the small profits threshold as the Act states it` EQUALS 7105
-- s 11(7): weeks before the week of attaining 16 or after the week of attaining pensionable age
#ASSERT `s 11(7) a Class 2 contribution is to be paid or treated as paid in respect of the week` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 11(7) a Class 2 contribution is to be paid or treated as paid in respect of the week` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 11(7) a Class 2 contribution is to be paid or treated as paid in respect of the week` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 11(7) a Class 2 contribution is to be paid or treated as paid in respect of the week` FALSE FALSE EQUALS NOTHING
-- s 11(5A), (5B): relevant profits of, or exceeding, 7105 -- exactly 7105 counts; 7104.99 does not
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 7105 7105 NOTHING EQUALS JUST TRUE
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 9000 7105 NOTHING EQUALS JUST TRUE
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 7104.99 7105 NOTHING EQUALS NOTHING
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 9000 7105 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` NOTHING TRUE 9000 7105 NOTHING EQUALS NOTHING
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST TRUE) FALSE 9000 7105 NOTHING EQUALS NOTHING
#ASSERT `s 11(5B) the earner is treated for relevant purposes as having actually paid a Class 2 contribution in respect of the week` (JUST FALSE) TRUE 9000 7105 NOTHING EQUALS JUST FALSE
-- s 11(6): "£3.65"; payable by an earner NOT at or above the threshold
#ASSERT `s 11(6) the Class 2 contribution as the Act states it` EQUALS 3.65
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 7104.99 7105 NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 7105 7105 NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 5000 7105 NOTHING TRUE EQUALS NOTHING
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST TRUE) TRUE 5000 7105 (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` NOTHING TRUE 5000 7105 NOTHING FALSE EQUALS NOTHING
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST TRUE) FALSE 5000 7105 NOTHING FALSE EQUALS NOTHING
-- s 11(1): "This section applies if ..."; where section 11 does not apply, subsections (5B) and (6) have no case (marginal reading M1(a))
#ASSERT `s 11(6) the earner may pay a Class 2 contribution in respect of the week` (JUST FALSE) TRUE 5000 7105 NOTHING FALSE EQUALS JUST FALSE
-- seam S4: weeks counted = treated as paid under (5B) or paid under (6): of four weeks (TT, FT, TF, FF) three count
#ASSERT `s 11 the number of weeks for which a Class 2 contribution was paid in the tax year` (LIST (`s 11 Week of the tax year` OF TRUE, FALSE), (`s 11 Week of the tax year` OF FALSE, TRUE), (`s 11 Week of the tax year` OF TRUE, TRUE), (`s 11 Week of the tax year` OF FALSE, FALSE)) EQUALS 3
#ASSERT `s 11 the number of weeks for which a Class 2 contribution was paid in the tax year` (LIST (`s 11 Week of the tax year` OF FALSE, FALSE)) EQUALS 0

§§ `s 11A`

#ASSERT `s 11A(1) Part 2 of the Taxes Management Act 1970 applies, with the necessary modifications, for the purpose` `s 11A(1) establishing whether an earner has relevant profits of, or exceeding, the small profits threshold for a tax year` EQUALS JUST TRUE
#ASSERT `s 11A(1) Part 2 of the Taxes Management Act 1970 applies, with the necessary modifications, for the purpose` `s 11A(1) another purpose` EQUALS NOTHING
#ASSERT `s 11A(2) the profits are relevant profits` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 11A(2) the profits are relevant profits` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 11A(2) the profits are relevant profits` NOTHING EQUALS NOTHING

§§ `s 12`

-- s 12(1): a s 11(6) contribution paid in a later tax year than the week's
#ASSERT `s 12(1) section 12 applies to the contribution` TRUE (`Tax year` OF 2020) (`Tax year` OF 2021) EQUALS JUST TRUE
#ASSERT `s 12(1) section 12 applies to the contribution` TRUE (`Tax year` OF 2021) (`Tax year` OF 2021) EQUALS NOTHING
#ASSERT `s 12(1) section 12 applies to the contribution` TRUE (`Tax year` OF 2022) (`Tax year` OF 2021) EQUALS NOTHING
#ASSERT `s 12(1) section 12 applies to the contribution` FALSE (`Tax year` OF 2020) (`Tax year` OF 2021) EQUALS NOTHING
-- s 12(8): "ordinary contribution" means a contribution of the amount specified in section 11(6)
#ASSERT `s 12(8) the contribution is an ordinary contribution` TRUE EQUALS JUST TRUE
#ASSERT `s 12(8) the contribution is an ordinary contribution` FALSE EQUALS JUST FALSE
-- s 12(3)(a), (b): payment after the end of the year following the contribution year -- 2022 yes, 2021 no -- and the rates differ
#ASSERT `s 12(3)(a) and (b) the contribution is paid after the end of the tax year immediately following the contribution year, and the weekly rates differ` (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 EQUALS TRUE
#ASSERT `s 12(3)(a) and (b) the contribution is paid after the end of the tax year immediately following the contribution year, and the weekly rates differ` (`Tax year` OF 2020) (`Tax year` OF 2021) 3.50 3.65 EQUALS FALSE
#ASSERT `s 12(3)(a) and (b) the contribution is paid after the end of the tax year immediately following the contribution year, and the weekly rates differ` (`Tax year` OF 2020) (`Tax year` OF 2022) 3.65 3.65 EQUALS FALSE
-- s 12(2): the contribution-year amount; s 12(3): the highest weekly rate in the period
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2021) 3.50 3.65 (LIST 3.50, 3.65) FALSE EQUALS JUST 3.50
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50, 3.60, 3.65) FALSE EQUALS JUST 3.65
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50, 3.90, 3.65) FALSE EQUALS JUST 3.90
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.65 3.65 (LIST 3.65, 4.00, 3.65) FALSE EQUALS JUST 3.65
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST FALSE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50, 3.90, 3.65) FALSE EQUALS JUST 3.50
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) NOTHING (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50, 3.90, 3.65) FALSE EQUALS NOTHING
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) NOTHING (`Tax year` OF 2020) (`Tax year` OF 2021) 3.50 3.65 (LIST 3.50) FALSE EQUALS JUST 3.50
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` (JUST TRUE) (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50) TRUE EQUALS NOTHING
#ASSERT `s 12(2) the amount of the late paid Class 2 contribution` NOTHING (JUST TRUE) (`Tax year` OF 2020) (`Tax year` OF 2022) 3.50 3.65 (LIST 3.50) FALSE EQUALS NOTHING

§§ `s 13`

#ASSERT `s 13(1) the amount of a Class 3 contribution as the Act states it` EQUALS 18.40
-- s 13(1): over 16 and entitled by regulations
#ASSERT `s 13(1) the person is entitled to pay a Class 3 contribution` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 13(1) the person is entitled to pay a Class 3 contribution` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 13(1) the person is entitled to pay a Class 3 contribution` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 13(1) the person is entitled to pay a Class 3 contribution` NOTHING TRUE EQUALS NOTHING
-- s 13(2): "only with a view to": a necessary condition
#ASSERT `s 13(2) payment of the Class 3 contribution is allowed` TRUE EQUALS NOTHING
#ASSERT `s 13(2) payment of the Class 3 contribution is allowed` FALSE EQUALS JUST FALSE
-- s 13(5)
#ASSERT `s 13(5) the payment year` (`Tax year` OF 2025) EQUALS `Tax year` OF 2025
#ASSERT `s 13(5) the contribution year` (`Tax year` OF 2021) EQUALS `Tax year` OF 2021
-- s 13(4), (6): the same as the earlier year's amount unless paid after the end of the next tax year but one following the contribution year
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2020) 18 19 (LIST ) FALSE EQUALS NOTHING
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2021) 18 19 (LIST ) FALSE EQUALS JUST 18
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2022) 18 19 (LIST ) FALSE EQUALS JUST 18
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2023) 18 19 (LIST ) FALSE EQUALS JUST 19
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2023) 19 18 (LIST ) FALSE EQUALS JUST 19
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2023) 18.40 19 (LIST 21) FALSE EQUALS JUST 21
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2023) 18 18 (LIST 21) FALSE EQUALS JUST 18
#ASSERT `s 13(4) the amount of the Class 3 contribution for the earlier tax year` (`Tax year` OF 2020) (`Tax year` OF 2023) 18 19 (LIST ) TRUE EQUALS NOTHING
-- seam S4: 10 weeks paid, 3 appropriated in, 2 appropriated out: 11
#ASSERT `s 13 the number of weeks for which a Class 3 contribution was paid in the tax year` 10 3 2 EQUALS 11
-- the combination of bars: one JUST FALSE bar answers JUST FALSE; otherwise the grant stands
#ASSERT `s 13 the Class 3 contribution may be paid once the bars are taken into account` (LIST (JUST FALSE), NOTHING) NOTHING EQUALS JUST FALSE
#ASSERT `s 13 the Class 3 contribution may be paid once the bars are taken into account` (LIST NOTHING, (JUST TRUE)) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 13 the Class 3 contribution may be paid once the bars are taken into account` (LIST NOTHING) NOTHING EQUALS NOTHING

§§ `s 13A`

-- s 13A(2): a missing year is not earlier than 1975-76 (1975)
#ASSERT `s 13A(2) the tax year is a missing year` (`Tax year` OF 1975) TRUE EQUALS JUST TRUE
#ASSERT `s 13A(2) the tax year is a missing year` (`Tax year` OF 1974) TRUE EQUALS JUST FALSE
#ASSERT `s 13A(2) the tax year is a missing year` (`Tax year` OF 1975) FALSE EQUALS JUST FALSE
-- s 13A(3): not more than 6 tax years
#ASSERT `s 13A(3) the person is entitled to pay a contribution under section 13A for the tax year` 6 EQUALS NOTHING
#ASSERT `s 13A(3) the person is entitled to pay a contribution under section 13A for the tax year` 7 EQUALS JUST FALSE
#ASSERT `s 13A(3) the person is entitled to pay a contribution under section 13A for the tax year` 0 EQUALS NOTHING
-- s 13A(4): the end of 6 years beginning with 6 April 2010 is 5 April 2016; a day of 29 February has no anniversary in a common year (fork F4)
#ASSERT `s 13A(4) the last day on which a contribution may be paid under section 13A` (Date 6 4 2010) EQUALS JUST (Date 5 4 2016)
#ASSERT `s 13A(4) the last day on which a contribution may be paid under section 13A` (Date 1 1 2012) EQUALS JUST (Date 31 12 2017)
#ASSERT `s 13A(4) the last day on which a contribution may be paid under section 13A` (Date 29 2 2012) EQUALS NOTHING
#ASSERT `s 13A(4) the person is entitled to pay a contribution under section 13A on the day` (Date 6 4 2010) (Date 5 4 2016) EQUALS NOTHING
#ASSERT `s 13A(4) the person is entitled to pay a contribution under section 13A on the day` (Date 6 4 2010) (Date 6 4 2016) EQUALS JUST FALSE
#ASSERT `s 13A(4) the person is entitled to pay a contribution under section 13A on the day` (Date 29 2 2012) (Date 6 4 2030) EQUALS NOTHING
-- s 13A(6): 6 April 2008 to 5 April 2015, both ends included
#ASSERT `s 13A(6) the first condition is satisfied` (Date 5 4 2008) EQUALS JUST FALSE
#ASSERT `s 13A(6) the first condition is satisfied` (Date 6 4 2008) EQUALS JUST TRUE
#ASSERT `s 13A(6) the first condition is satisfied` (Date 5 4 2015) EQUALS JUST TRUE
#ASSERT `s 13A(6) the first condition is satisfied` (Date 6 4 2015) EQUALS JUST FALSE
-- s 13A(8): earnings factor not less than the qualifying earnings factor
#ASSERT `s 13A(8) the year is a year to which subsection (8) applies` TRUE 100 100 EQUALS JUST TRUE
#ASSERT `s 13A(8) the year is a year to which subsection (8) applies` TRUE 99.99 100 EQUALS JUST FALSE
#ASSERT `s 13A(8) the year is a year to which subsection (8) applies` FALSE 200 100 EQUALS JUST FALSE
-- s 13A(9)(a)(i), (13)(a)(i): so much of the earnings as did not exceed the upper earnings limit (1000): above it, the limit; at it, the limit; below it, the earnings
#ASSERT `s 13A(9)(a)(i) the earnings from which the earnings factor is derived` 1500 1000 EQUALS 1000
#ASSERT `s 13A(9)(a)(i) the earnings from which the earnings factor is derived` 1000 1000 EQUALS 1000
#ASSERT `s 13A(9)(a)(i) the earnings from which the earnings factor is derived` 999.99 1000 EQUALS 999.99
#ASSERT `s 13A(13)(a)(i) the earnings from which the earnings factor is derived` 1500 1000 EQUALS 1000
#ASSERT `s 13A(13)(a)(i) the earnings from which the earnings factor is derived` 800 1000 EQUALS 800
-- s 13A(10): only for those reaching pensionable age before 6 April 2010
#ASSERT `s 13A(10) the year is a year to which subsection (10) applies` (Date 5 4 2010) TRUE EQUALS JUST TRUE
#ASSERT `s 13A(10) the year is a year to which subsection (10) applies` (Date 5 4 2010) FALSE EQUALS JUST FALSE
#ASSERT `s 13A(10) the year is a year to which subsection (10) applies` (Date 6 4 2010) TRUE EQUALS NOTHING
-- s 13A(7): at least 20
#ASSERT `s 13A(7) the second condition is satisfied` 20 EQUALS JUST TRUE
#ASSERT `s 13A(7) the second condition is satisfied` 19 EQUALS JUST FALSE
-- s 13A(11), (12)
#ASSERT `s 13A(11) the third condition applies` (Date 5 4 2010) EQUALS JUST TRUE
#ASSERT `s 13A(11) the third condition applies` (Date 6 4 2010) EQUALS JUST FALSE
#ASSERT `s 13A(12) the third condition is satisfied` TRUE 100 100 EQUALS JUST TRUE
#ASSERT `s 13A(12) the third condition is satisfied` TRUE 99.99 100 EQUALS JUST FALSE
#ASSERT `s 13A(12) the third condition is satisfied` FALSE 200 100 EQUALS JUST FALSE
-- s 13A(5): an eligible person satisfies the conditions; the third counts only where it applies
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 13A(5) the person is an eligible person` (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 13A(5) the person is an eligible person` NOTHING (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 13A(5) the person is an eligible person` NOTHING (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 13A(5) the person is an eligible person` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS NOTHING
-- s 13A(1) with (3), (4)
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST TRUE) (JUST TRUE) NOTHING NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING TRUE EQUALS JUST FALSE
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST TRUE) (JUST TRUE) NOTHING (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST TRUE) (JUST TRUE) NOTHING NOTHING FALSE EQUALS NOTHING
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST FALSE) (JUST TRUE) NOTHING NOTHING TRUE EQUALS NOTHING
#ASSERT `s 13A(1) an eligible person is entitled to pay a Class 3 contribution in respect of the missing year, having regard to subsections (3) and (4)` (JUST TRUE) (JUST FALSE) NOTHING NOTHING TRUE EQUALS NOTHING

§§ `s 14`

-- s 14(1): no entitlement where the earnings factor equals or exceeds the qualifying earnings factor
#ASSERT `s 14(1) the person is entitled to pay a Class 3 contribution for the tax year` 100 100 EQUALS JUST FALSE
#ASSERT `s 14(1) the person is entitled to pay a Class 3 contribution for the tax year` 101 100 EQUALS JUST FALSE
#ASSERT `s 14(1) the person is entitled to pay a Class 3 contribution for the tax year` 99.99 100 EQUALS NOTHING
-- s 14(3)
#ASSERT `s 14(3) the contribution is treated as not having been paid for the purpose of determining entitlement to any benefit` TRUE EQUALS JUST TRUE
#ASSERT `s 14(3) the contribution is treated as not having been paid for the purpose of determining entitlement to any benefit` FALSE EQUALS NOTHING
-- s 14(4): earnings up to the upper earnings limit
#ASSERT `s 14(4) the earnings on which primary Class 1 contributions are treated as paid for the purposes of subsection (1)(a)` 1500 1000 EQUALS 1000
#ASSERT `s 14(4) the earnings on which primary Class 1 contributions are treated as paid for the purposes of subsection (1)(a)` 1000 1000 EQUALS 1000
#ASSERT `s 14(4) the earnings on which primary Class 1 contributions are treated as paid for the purposes of subsection (1)(a)` 800 1000 EQUALS 800

§§ `s 14A`

-- s 14A(1A): the later of 5 April 2017 and the end of the 30-day period beginning with the day of the information (7 March + 29 days = 5 April)
#ASSERT `s 14A(1A) the cut-off date` NOTHING EQUALS Date 5 4 2017
#ASSERT `s 14A(1A) the cut-off date` (JUST (Date 1 3 2017)) EQUALS Date 5 4 2017
#ASSERT `s 14A(1A) the cut-off date` (JUST (Date 7 3 2017)) EQUALS Date 5 4 2017
#ASSERT `s 14A(1A) the cut-off date` (JUST (Date 8 3 2017)) EQUALS Date 6 4 2017
#ASSERT `s 14A(1A) the cut-off date` (JUST (Date 1 5 2017)) EQUALS Date 30 5 2017
-- s 14A(2)
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` FALSE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` FALSE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 14A(2) the person is eligible to pay a Class 3A contribution` TRUE NOTHING FALSE EQUALS JUST TRUE
-- s 14A(1): before the cut-off date -- the day itself is not before it
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 4 4 2017) (Date 5 4 2017) EQUALS JUST TRUE
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 5 4 2017) (Date 5 4 2017) EQUALS NOTHING
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST FALSE) (Date 1 1 2017) (Date 5 4 2017) EQUALS NOTHING
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` NOTHING (Date 1 1 2017) (Date 5 4 2017) EQUALS NOTHING
-- s 14A(1): "before the cut-off date" is strict, so the cut-off day itself and later days are outside the grant: NOTHING, not JUST FALSE (the grant is limited by a stated date)
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 30 4 2017) (`s 14A(1A) the cut-off date` (JUST (Date 1 4 2017))) EQUALS NOTHING
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 29 4 2017) (`s 14A(1A) the cut-off date` (JUST (Date 1 4 2017))) EQUALS JUST TRUE
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 1 5 2017) (`s 14A(1A) the cut-off date` (JUST (Date 1 4 2017))) EQUALS NOTHING
#ASSERT `s 14A(1) the person is entitled to pay a Class 3A contribution on the day` (JUST TRUE) (Date 6 4 2017) (`s 14A(1A) the cut-off date` NOTHING) EQUALS NOTHING
-- s 14A(5): more than one occasion; not more than the maximum number of units
#ASSERT `s 14A(5) the person may pay a Class 3A contribution on this occasion` TRUE 5 1 6 EQUALS JUST TRUE
#ASSERT `s 14A(5) the person may pay a Class 3A contribution on this occasion` TRUE 5 2 6 EQUALS JUST FALSE
#ASSERT `s 14A(5) the person may pay a Class 3A contribution on this occasion` FALSE 0 1 6 EQUALS NOTHING
#ASSERT `s 14A(5) the person may pay a Class 3A contribution on this occasion` FALSE 0 7 6 EQUALS JUST FALSE
-- s 14A(7), (8)
#ASSERT `s 14A(7) the graduated retirement benefit is deferred` TRUE EQUALS JUST TRUE
#ASSERT `s 14A(7) the graduated retirement benefit is deferred` FALSE EQUALS JUST FALSE
#ASSERT `s 14A(8) the Category A or Category B retirement pension is deferred` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 14A(8) the Category A or Category B retirement pension is deferred` NOTHING EQUALS NOTHING

§§ `s 14B`

#ASSERT `s 14B(3) the person is treated as never having had the unit of additional pension` TRUE EQUALS JUST TRUE
#ASSERT `s 14B(3) the person is treated as never having had the unit of additional pension` FALSE EQUALS JUST FALSE
