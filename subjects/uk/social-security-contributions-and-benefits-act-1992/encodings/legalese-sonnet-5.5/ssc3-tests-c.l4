IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc3-helpers`
IMPORT `ssc3-a-s43-s44`
IMPORT `ssc3-c-s45-s46`

-- Tests for ssc3-c-s45-s46.l4 (ss 45, 45AA, 45B, 46).
-- Every expected value is written by hand from the text of the section named beside it; none is copied from the encoding's output.

§ `Fixtures`

GIVEN day IS A DATE
GIVETH A Person
`a pensioner attaining pensionable age on` MEANS
    Person WITH
        `date of birth` IS Date 1 1 1950
        `sex` IS Woman
        `marital status` IS `married`
        `date of attaining pensionable age` IS day

§ `Section 45: the additional pension`

-- (7) and (6): the weekly equivalent is the amount divided by 52, rounded to the nearest penny, a half penny going up; under half a penny is nil.
#ASSERT `s 45(7) the amount calculated under subsection (6) is taken to be zero` 0.004
#ASSERT (NOT (`s 45(7) the amount calculated under subsection (6) is taken to be zero` 0.005))
#ASSERT (NOT (`s 45(7) the amount calculated under subsection (6) is taken to be zero` 0.006))
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 1000 EQUALS 19.23
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 52 EQUALS 1
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 0.26 EQUALS 0.01
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 0.25 EQUALS 0
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 0 EQUALS 0
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 78 EQUALS 1.5
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 100 EQUALS 1.92
#ASSERT `s 45(6) the weekly equivalent of the amount in pounds` 5.2 EQUALS 0.1
-- (2A) and (1)(b): a specified amount for each unit.
#ASSERT `s 45(2A) the specified amount for each unit in pounds` (JUST 3.1) EQUALS JUST 3.1
#ASSERT `s 45(2A) the specified amount for each unit in pounds` NOTHING EQUALS NOTHING
#ASSERT `s 45(1)(b) the weekly amount for the units of additional pension in pounds` 0 NOTHING EQUALS JUST 0
#ASSERT `s 45(1)(b) the weekly amount for the units of additional pension in pounds` 2 (JUST 3.1) EQUALS JUST 6.2
#ASSERT `s 45(1)(b) the weekly amount for the units of additional pension in pounds` 2 NOTHING EQUALS NOTHING
-- (4)(a): X is 0.5 for each tax year by which the pensioner's tax year precedes 2009-10.
#ASSERT `s 45(4)(a) X` (`a pensioner attaining pensionable age on` (Date 1 6 2008)) EQUALS 0.5
#ASSERT `s 45(4)(a) X` (`a pensioner attaining pensionable age on` (Date 5 4 2009)) EQUALS 0.5
#ASSERT `s 45(4)(a) X` (`a pensioner attaining pensionable age on` (Date 6 4 2009)) EQUALS 0
#ASSERT `s 45(4)(a) X` (`a pensioner attaining pensionable age on` (Date 1 6 1999)) EQUALS 5
#ASSERT `s 45(4)(a) X` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) EQUALS 0
-- (4)(b): N is the number of tax years in the working life after 5 April 1978.
#ASSERT `s 45(4)(b) N` 35 EQUALS 35
#ASSERT `s 45(4)(b) N` 0 EQUALS 0
-- (5): years disregarded, but "not so as to reduce the number of years below 20".
#ASSERT `s 45(5) N after the years directed to be disregarded` 40 5 EQUALS 35
#ASSERT `s 45(5) N after the years directed to be disregarded` 40 25 EQUALS 20
#ASSERT `s 45(5) N after the years directed to be disregarded` 25 5 EQUALS 20
#ASSERT `s 45(5) N after the years directed to be disregarded` 25 0 EQUALS 25
#ASSERT `s 45(5) N after the years directed to be disregarded` 21 1 EQUALS 20
#ASSERT `s 45(5) N after the years directed to be disregarded` 20 5 EQUALS 20
#ASSERT `s 45(5) N after the years directed to be disregarded` 19 3 EQUALS 19
#ASSERT `s 45(5) the year is one the regulations may direct to be disregarded` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 45(5) the year is one the regulations may direct to be disregarded` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 45(5) the year is one the regulations may direct to be disregarded` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 45(5) the year is one the regulations may direct to be disregarded` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 45(5) the year is one the regulations may direct to be disregarded` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- (3): the relevant percentage: 20/N from 2009-10; (20+X)/N for 1999-2000 to 2008-09.
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 40 EQUALS JUST 0.5
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 6 4 2009)) 40 EQUALS JUST 0.5
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 5 4 2009)) 40 EQUALS JUST 0.5125
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 1 6 2005)) 40 EQUALS JUST 0.55
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 6 4 1999)) 40 EQUALS JUST 0.625
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 5 4 1999)) 40 EQUALS NOTHING
#ASSERT `s 45(3) the relevant percentage` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 0 EQUALS NOTHING
-- (3A): the tax years within the subsection.
#ASSERT `s 45(3A) the tax year falls within this subsection` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 45(3A) the tax year falls within this subsection` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 45(3A) the tax year falls within this subsection` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 45(3A) the tax year falls within this subsection` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 45(3A) the tax year falls within this subsection` FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (1): a pensioner who attained pensionable age before 6 April 1999: 1 1/4 per cent. of 10,400 is 130, a weekly 2.50; each unit at the specified amount.
#ASSERT `s 45(1) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 5 4 1999)) 10400 0 NOTHING EQUALS JUST 2.5
#ASSERT `s 45(1) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 5 4 1999)) 10400 2 (JUST 3.1) EQUALS JUST 8.7
#ASSERT `s 45(1) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 5 4 1999)) 10400 2 NOTHING EQUALS NOTHING
#ASSERT `s 45(1) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 6 4 1999)) 10400 0 NOTHING EQUALS NOTHING
-- (2): a pensioner who attained pensionable age after 5 April 1999. 2012: (a) 2.50, (b) 4.00, (c) 10.00, (d) 20.00, (e) 2.50 = 39.00.
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 31200 30 (JUST 520) (JUST 1040) FALSE 1 (JUST 2.5) EQUALS JUST 39
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 31200 30 (JUST 520) (JUST 1040) TRUE 1 (JUST 2.5) EQUALS JUST 19
-- 2005: the relevant percentage is (20+2)/30, so (b) is 228.80 a year, 4.40 a week: 2.50 + 4.40 + 10 + 20 + 2.50.
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2005)) 15600 31200 30 (JUST 520) (JUST 1040) FALSE 1 (JUST 2.5) EQUALS JUST 39.4
-- each weekly equivalent is rounded on its own: 0.19 + 0.15 = 0.34, where rounding 18/52 together would give 0.35.
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 1000 1000 25 (JUST 0) (JUST 0) FALSE 0 NOTHING EQUALS JUST 0.34
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 31200 30 NOTHING (JUST 1040) FALSE 1 (JUST 2.5) EQUALS NOTHING
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 31200 30 (JUST 520) NOTHING FALSE 1 (JUST 2.5) EQUALS NOTHING
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 31200 30 (JUST 520) NOTHING TRUE 1 (JUST 2.5) EQUALS JUST 19
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 15600 0 0 (JUST 0) (JUST 0) FALSE 0 NOTHING EQUALS NOTHING
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 1 6 2012)) 0 0 0 (JUST 0) (JUST 0) FALSE 0 NOTHING EQUALS JUST 0
#ASSERT `s 45(2) the weekly rate of the additional pension in pounds` (`a pensioner attaining pensionable age on` (Date 5 4 1999)) 15600 31200 30 (JUST 520) (JUST 1040) FALSE 1 (JUST 2.5) EQUALS NOTHING

§ `Section 45AA: working families' tax credit and disabled person's tax credit`

#ASSERT `s 45AA(4) subsection (1) applies to the woman` TRUE EQUALS JUST FALSE
#ASSERT `s 45AA(4) subsection (1) applies to the woman` FALSE EQUALS NOTHING
-- (1)(a): earnings of 6,000 (not less than the QEF of 5,000) plus the credit of 1,000; (b): below the QEF, the credit plus the QEF.
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 6000 5000 1000 40000 EQUALS JUST 7000
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 5000 5000 1000 40000 EQUALS JUST 6000
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 4999 5000 1000 40000 EQUALS JUST 6000
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 4000 5000 1000 40000 EQUALS JUST 6000
-- (3): not more than the upper earnings limit multiplied by 53 (100 x 53 = 5,300).
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 5200 5000 500 100 EQUALS JUST 5300
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 5000 5000 300 100 EQUALS JUST 5300
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE NOTHING 5000 5000 299 100 EQUALS JUST 5299
-- no credit paid, or (4): the section gives no figure.
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` FALSE NOTHING 6000 5000 1000 40000 EQUALS NOTHING
#ASSERT `s 45AA(1) the qualifying earnings treated as paid in pounds` TRUE (JUST FALSE) 6000 5000 1000 40000 EQUALS NOTHING
-- (2): the person in respect of whom the credit is paid.
#ASSERT `s 45AA(2) the person in respect of whom the credit is paid` (JUST TRUE) EQUALS `s 45AA(2)(a) the prescribed member of the couple`
#ASSERT `s 45AA(2) the person in respect of whom the credit is paid` (JUST FALSE) EQUALS `s 45AA(2)(b) the person to whom it is paid`
#ASSERT `s 45AA(2) the person in respect of whom the credit is paid` NOTHING EQUALS `s 45AA(2) not determined because it is not known whether the two persons are a couple`
-- (5): the same meanings as s 137 and s 44.
#ASSERT `s 45AA(5) the two persons are a couple` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 45AA(5) the two persons are a couple` NOTHING EQUALS NOTHING
#ASSERT `s 45AA(5) the tax year is a relevant year` (`a pensioner attaining pensionable age on` (Date 1 6 2015)) (JUST (Date 15 8 1990)) (`Tax year` OF 1990) EQUALS JUST TRUE
#ASSERT `s 45AA(5) the tax year is a relevant year` (`a pensioner attaining pensionable age on` (Date 1 6 2015)) (JUST (Date 15 8 1990)) (`Tax year` OF 2015) EQUALS JUST FALSE

§ `Section 45B: reduction of additional pension: pension sharing`

#ASSERT `s 45B(1) the weekly rate of the additional pension is reduced` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 45B(1) the weekly rate of the additional pension is reduced` TRUE FALSE EQUALS NOTHING
#ASSERT `s 45B(1) the weekly rate of the additional pension is reduced` FALSE TRUE EQUALS NOTHING
-- (8): the final relevant year is the tax year before the one in which pensionable age is attained.
#ASSERT `s 45B(8) the final relevant year` (`a pensioner attaining pensionable age on` (Date 1 6 2015)) EQUALS `Tax year` OF 2014
#ASSERT `s 45B(8) the final relevant year` (`a pensioner attaining pensionable age on` (Date 5 4 2015)) EQUALS `Tax year` OF 2013
#ASSERT `s 45B(8) the debit is a state scheme pension debit` TRUE
#ASSERT (NOT (`s 45B(8) the debit is a state scheme pension debit` FALSE))
#ASSERT `s 45B(8) the valuation day` (Date 1 1 2020) EQUALS Date 1 1 2020
-- (4), (6): inputs passed through.
#ASSERT `s 45B(4) the appropriate weekly amount in pounds` (JUST 12.5) EQUALS JUST 12.5
#ASSERT `s 45B(4) the appropriate weekly amount in pounds` NOTHING EQUALS NOTHING
#ASSERT `s 45B(6) the relevant revaluation percentage` (JUST 150) EQUALS JUST 150
-- (5): the later of pensionable age and the valuation day.
#ASSERT `s 45B(5) the day the notional pension becomes payable` (`a pensioner attaining pensionable age on` (Date 1 1 2020)) (Date 1 1 2021) EQUALS Date 1 1 2021
#ASSERT `s 45B(5) the day the notional pension becomes payable` (`a pensioner attaining pensionable age on` (Date 1 1 2020)) (Date 1 1 2019) EQUALS Date 1 1 2020
#ASSERT `s 45B(5) the day the notional pension becomes payable` (`a pensioner attaining pensionable age on` (Date 1 1 2020)) (Date 1 1 2020) EQUALS Date 1 1 2020
-- (2): in or after the final relevant year, less the appropriate weekly amount (100 - 20 = 80); (3): before it, less that amount multiplied by the percentage (100 - 20 x 150% = 70).
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 20) TRUE (JUST 150) EQUALS JUST 80
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 20) TRUE NOTHING EQUALS JUST 80
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 20) FALSE (JUST 150) EQUALS JUST 70
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 20) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 80) FALSE (JUST 150) EQUALS NOTHING
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 100) TRUE NOTHING EQUALS JUST 0
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 (JUST 101) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 45B(2) the weekly rate of the additional pension after the reduction in pounds` 100 NOTHING TRUE (JUST 150) EQUALS NOTHING

§ `Section 46: modifications of section 45`

-- (2): application, by kind of deceased person.
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` TRUE (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` TRUE NOTHING NOTHING FALSE EQUALS NOTHING
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased spouse` FALSE (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased civil partner` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased civil partner` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased civil partner` TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased cohabiting partner` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) the substituted definition of N applies` `s 46 a deceased cohabiting partner` TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS NOTHING
-- (2)(a): tax years beginning after 5 April 1978 and ending before the date. The year ending 5 April 2005 ends before 6 April 2005 but not before 5 April 2005.
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 1 1 2005) EQUALS 26
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 5 4 2005) EQUALS 26
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 6 4 2005) EQUALS 27
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 1 1 1978) EQUALS 0
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 6 4 1978) EQUALS 0
#ASSERT `s 46(2)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 6 4 1979) EQUALS 1
-- (2)(b): from the year of the sixteenth birthday (or 1978-79 if later) up to the year before the year of pensionable age.
#ASSERT `s 46(2)(b) the number of tax years from the sixteenth birthday or 1978-79 to the year before S would have attained pensionable age` (`a pensioner attaining pensionable age on` (Date 1 6 2020)) (JUST (Date 15 8 1990)) EQUALS JUST 30
#ASSERT `s 46(2)(b) the number of tax years from the sixteenth birthday or 1978-79 to the year before S would have attained pensionable age` (`a pensioner attaining pensionable age on` (Date 1 6 2020)) (JUST (Date 1 1 1970)) EQUALS JUST 42
#ASSERT `s 46(2)(b) the number of tax years from the sixteenth birthday or 1978-79 to the year before S would have attained pensionable age` (`a pensioner attaining pensionable age on` (Date 1 6 2020)) NOTHING EQUALS NOTHING
#ASSERT `s 46(2)(b) the number of tax years from the sixteenth birthday or 1978-79 to the year before S would have attained pensionable age` (`a pensioner attaining pensionable age on` (Date 1 6 1978)) (JUST (Date 1 1 1960)) EQUALS JUST 0
-- (2), (3): whichever is the smaller number.
#ASSERT `s 46(2) the substituted N` 26 (JUST 30) EQUALS JUST 26
#ASSERT `s 46(2) the substituted N` 40 (JUST 30) EQUALS JUST 30
#ASSERT `s 46(2) the substituted N` 30 (JUST 30) EQUALS JUST 30
#ASSERT `s 46(2) the substituted N` 26 NOTHING EQUALS NOTHING
#ASSERT `s 46(3)(a) the number of tax years which begin after 5th April 1978 and end before the date` (Date 1 1 2005) EQUALS 26
#ASSERT `s 46(3)(b) the number of tax years from the sixteenth birthday or 1978-79 to the year before S would have attained pensionable age` (`a pensioner attaining pensionable age on` (Date 1 6 2020)) (JUST (Date 15 8 1990)) EQUALS JUST 30
#ASSERT `s 46(3) the substituted N` 26 (JUST 30) EQUALS JUST 26
#ASSERT `s 46(3) the substituted N` 40 (JUST 30) EQUALS JUST 30
#ASSERT `s 46(3) the substituted N` 40 NOTHING EQUALS NOTHING
#ASSERT `s 46(3) the substituted definition of N applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46(3) the substituted definition of N applies` TRUE FALSE EQUALS NOTHING
#ASSERT `s 46(3) the substituted definition of N applies` FALSE TRUE EQUALS NOTHING
-- (4): the additional modifications.
#ASSERT `s 46(4) section 45 has effect subject to the additional modifications` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 46(4) section 45 has effect subject to the additional modifications` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 46(4) section 45 has effect subject to the additional modifications` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 46(4) section 45 has effect subject to the additional modifications` NOTHING TRUE EQUALS NOTHING
