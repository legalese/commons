IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc1-prelim`
IMPORT `ssc1-class1`
IMPORT `ssc1-class1a1b`

-- Tests for ssc1-class1a1b.l4 (ss 10 to 10A). Every expected value is written from the text beside the assertion.

§ `Tests for ss 10 to 10A`

§§ `s 10`

-- s 10(1): all four conditions needed
#ASSERT `s 10(1) a Class 1A contribution is payable for the tax year` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10(1) a Class 1A contribution is payable for the tax year` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 10(1) a Class 1A contribution is payable for the tax year` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 10(1) a Class 1A contribution is payable for the tax year` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 10(1) a Class 1A contribution is payable for the tax year` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- s 10(1A): "if and so far as" (a) and (b)
#ASSERT `s 10(1A) a Class 1A contribution is payable for the tax year in respect of the termination award` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10(1A) a Class 1A contribution is payable for the tax year in respect of the termination award` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10(1A) a Class 1A contribution is payable for the tax year in respect of the termination award` FALSE TRUE EQUALS JUST FALSE
-- s 10(1B), (1C)
#ASSERT `s 10(1B) a Class 1A contribution is payable under subsection (1A) in respect of the amount` TRUE EQUALS JUST FALSE
#ASSERT `s 10(1B) a Class 1A contribution is payable under subsection (1A) in respect of the amount` FALSE EQUALS NOTHING
#ASSERT `s 10(1C) a Class 1A contribution is payable under subsection (1A)` FALSE EQUALS JUST FALSE
#ASSERT `s 10(1C) a Class 1A contribution is payable under subsection (1A)` TRUE EQUALS NOTHING
-- s 10(2): subject to ss 10ZA and 10ZBA
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST `s 10(2)(a) the person liable to pay the secondary Class 1 contribution relating to the last (or only) relevant payment of earnings in the tax year`
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST `s 10(2)(b) the person who would be liable to pay the secondary Class 1 contribution if the general earnings were earnings in respect of which Class 1 contributions would be payable`
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST `s 10ZA(3) the person providing the benefit`
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST `s 10ZBA(2) the controller of the sporting testimonial`
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 10(2) who pays the Class 1A contribution payable under subsection (1)` TRUE (JUST FALSE) NOTHING EQUALS NOTHING
-- s 10(3), (3A)
#ASSERT `s 10(3) the payment is a relevant payment of earnings` TRUE EQUALS JUST TRUE
#ASSERT `s 10(3) the payment is a relevant payment of earnings` FALSE EQUALS JUST FALSE
#ASSERT `s 10(3A) who pays the Class 1A contribution payable under subsection (1A)` (JUST TRUE) EQUALS JUST `s 10(2)(b) the person who would be liable to pay the secondary Class 1 contribution if the general earnings were earnings in respect of which Class 1 contributions would be payable`
#ASSERT `s 10(3A) who pays the Class 1A contribution payable under subsection (1A)` (JUST FALSE) EQUALS NOTHING
-- s 10(4), (4A), (5): percentage 15% of 2000 = 300; of a termination award of 4000 = 600
#ASSERT `s 10(5) the Class 1A percentage` (15%) EQUALS 0.15
#ASSERT `s 10(4) the amount of the Class 1A contribution payable under subsection (1)` (JUST TRUE) 2000 (15%) EQUALS JUST 300
#ASSERT `s 10(4) the amount of the Class 1A contribution payable under subsection (1)` (JUST FALSE) 2000 (15%) EQUALS NOTHING
#ASSERT `s 10(4) the amount of the Class 1A contribution payable under subsection (1)` NOTHING 2000 (15%) EQUALS NOTHING
#ASSERT `s 10(4A) the amount of the Class 1A contribution payable under subsection (1A)` (JUST TRUE) 4000 (15%) EQUALS JUST 600
#ASSERT `s 10(4A) the amount of the Class 1A contribution payable under subsection (1A)` (JUST FALSE) 4000 (15%) EQUALS NOTHING
-- s 10(6)
#ASSERT `s 10(6) a Class 1A contribution is payable in respect of the general earnings` TRUE EQUALS JUST FALSE
#ASSERT `s 10(6) a Class 1A contribution is payable in respect of the general earnings` FALSE EQUALS NOTHING
-- s 10(7B): the excluded provisions
#ASSERT `s 10(7B) the provision is an excluded provision` `s 10(7B)(a) a provision of Chapter 2 of Part 5 other than section 352` EQUALS JUST TRUE
#ASSERT `s 10(7B) the provision is an excluded provision` `s 10(7B)(a) section 352 (limited deduction for agency fees paid by entertainers)` EQUALS JUST FALSE
#ASSERT `s 10(7B) the provision is an excluded provision` `s 10(7B)(aa) any of sections 363 to 365` EQUALS JUST TRUE
#ASSERT `s 10(7B) the provision is an excluded provision` `s 10(7B)(b) any provision of Chapter 5 of Part 5` EQUALS JUST TRUE
#ASSERT `s 10(7B) the provision is an excluded provision` `s 10(7B) another provision` EQUALS JUST FALSE
-- s 10(7), (7A): general earnings 5000; corresponding amount 800. Deduction 799.99 is less than the whole: disregarded, so 5000. Deduction 800 is at least the whole: 800 treated as not included, so 4200.
#ASSERT `s 10(7) the amount of the general earnings received` 5000 TRUE 799.99 800 EQUALS JUST 5000
#ASSERT `s 10(7) the amount of the general earnings received` 5000 TRUE 800 800 EQUALS JUST 4200
#ASSERT `s 10(7) the amount of the general earnings received` 5000 TRUE 900 800 EQUALS JUST 4200
#ASSERT `s 10(7) the amount of the general earnings received` 5000 FALSE 900 800 EQUALS NOTHING
-- s 10(12)
#ASSERT `s 10(12) the payment or benefit is a termination award` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10(12) the payment or benefit is a termination award` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10(12) the payment or benefit is a termination award` FALSE TRUE EQUALS JUST FALSE

§§ `s 10ZA, s 10ZB, s 10ZBA, s 10ZC`

-- s 10ZA(1), (1A)
#ASSERT `s 10ZA(1) section 10ZA applies` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 10ZA(1) section 10ZA applies` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 10ZA(1) section 10ZA applies` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 10ZA(1) section 10ZA applies` TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 10ZA(1) section 10ZA applies` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 10ZA(1) section 10ZA applies` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- s 10ZA(2)
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 10ZA(2) the amount of the payment is treated as general earnings consisting in the provision of a benefit to the earner in that tax year` NOTHING TRUE TRUE EQUALS NOTHING
-- s 10ZA(4): the tax year beginning 6 April 2000: notice on or before 6 July 2001
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 2000) (JUST (Date 6 7 2001)) EQUALS JUST TRUE
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 2000) (JUST (Date 5 7 2001)) EQUALS JUST TRUE
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 2000) (JUST (Date 7 7 2001)) EQUALS JUST FALSE
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 2000) NOTHING EQUALS JUST FALSE
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 2001) NOTHING EQUALS NOTHING
#ASSERT `s 10ZA(4) subsection (3) applies in the case of a Class 1A contribution for the tax year` (`Tax year` OF 1999) (JUST (Date 1 1 2000)) EQUALS NOTHING
-- s 10ZA(3)
#ASSERT `s 10ZA(3) the liability falls on the person providing the benefit` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 10ZA(3) the liability falls on the person providing the benefit` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 10ZA(3) the liability falls on the person providing the benefit` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 10ZA(3) the liability falls on the person providing the benefit` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 10ZA(3) the liability falls on the person providing the benefit` NOTHING NOTHING EQUALS NOTHING
-- s 10ZA(6)
#ASSERT `s 10ZA(6) the person is a member of a person's family or household` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZA(6) the person is a member of a person's family or household` FALSE EQUALS JUST FALSE
-- s 10ZB
#ASSERT `s 10ZB(1) the provision is the provision of a benefit for the purposes of section 10ZA` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZB(1) the provision is the provision of a benefit for the purposes of section 10ZA` FALSE EQUALS NOTHING
#ASSERT `s 10ZB(2) sections 10 and 10ZA have effect as if the employment were not lower-paid employment as a minister of religion` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10ZB(2) sections 10 and 10ZA have effect as if the employment were not lower-paid employment as a minister of religion` TRUE FALSE EQUALS NOTHING
#ASSERT `s 10ZB(2) sections 10 and 10ZA have effect as if the employment were not lower-paid employment as a minister of religion` FALSE TRUE EQUALS NOTHING
#ASSERT `s 10ZB(3) the voucher is a non-cash voucher` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZB(3) the voucher is a non-cash voucher` FALSE EQUALS JUST FALSE
-- s 10ZBA
#ASSERT `s 10ZBA(1) section 10ZBA applies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10ZBA(1) section 10ZBA applies` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 10ZBA(1) section 10ZBA applies` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 10ZBA(1) section 10ZBA applies` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 10ZBA(2) the liability falls on the controller of the sporting testimonial` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 10ZBA(2) the liability falls on the controller of the sporting testimonial` NOTHING EQUALS NOTHING
#ASSERT `s 10ZBA(4) the amount to cover tax is treated as general earnings consisting in the making of a sporting testimonial payment to the earner` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10ZBA(4) the amount to cover tax is treated as general earnings consisting in the making of a sporting testimonial payment to the earner` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZBA(4) the amount to cover tax is treated as general earnings consisting in the making of a sporting testimonial payment to the earner` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 10ZBA(4) the amount to cover tax is treated as general earnings consisting in the making of a sporting testimonial payment to the earner` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZBA(4) the amount to cover tax is treated as general earnings consisting in the making of a sporting testimonial payment to the earner` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 10ZBA(5) the liability for the further payment falls on the controller of the sporting testimonial` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZBA(5) the liability for the further payment falls on the controller of the sporting testimonial` FALSE EQUALS NOTHING
#ASSERT `s 10ZBA(6) the expression has the meaning it has in section 226E of ITEPA 2003` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZBA(6) the expression has the meaning it has in section 226E of ITEPA 2003` FALSE EQUALS NOTHING
-- s 10ZC
#ASSERT `s 10ZC(2) the provision is a relevant retrospective tax provision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10ZC(2) the provision is a relevant retrospective tax provision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZC(2) the provision is a relevant retrospective tax provision` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 10ZC(3) the relevant retrospective tax provision counts` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZC(3) the relevant retrospective tax provision counts` FALSE EQUALS JUST TRUE
#ASSERT `s 10ZC(5) regulations under section 10ZC may have effect in relation to the time` (Date 1 12 2004) EQUALS JUST FALSE
#ASSERT `s 10ZC(5) regulations under section 10ZC may have effect in relation to the time` (Date 2 12 2004) EQUALS NOTHING
#ASSERT `s 10ZC(7) regulations under section 10ZC may have that effect` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 10ZC(7) regulations under section 10ZC may have that effect` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 10ZC(7) regulations under section 10ZC may have that effect` FALSE FALSE EQUALS NOTHING
#ASSERT `s 10ZC(8)(a) the powers are without prejudice to the liability` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZC(8)(a) the powers are without prejudice to the liability` FALSE EQUALS NOTHING
#ASSERT `s 10ZC(10) the day is the commencement day` (Date 10 5 2006) (Date 10 5 2006) EQUALS JUST TRUE
#ASSERT `s 10ZC(10) the day is the commencement day` (Date 11 5 2006) (Date 10 5 2006) EQUALS JUST FALSE
#ASSERT `s 10ZC(10) the thing is an enactment` TRUE EQUALS JUST TRUE
#ASSERT `s 10ZC(10) the thing is an enactment` FALSE EQUALS NOTHING

§§ `s 10A`

#ASSERT `s 10A(1) a Class 1B contribution is payable by the person for the tax year` TRUE EQUALS JUST TRUE
#ASSERT `s 10A(1) a Class 1B contribution is payable by the person for the tax year` FALSE EQUALS NOTHING
#ASSERT `s 10A(4) the general earnings are chargeable emoluments` TRUE EQUALS JUST TRUE
#ASSERT `s 10A(4) the general earnings are chargeable emoluments` FALSE EQUALS JUST FALSE
#ASSERT `s 10A(5) the general earnings are taken to be included in the PAYE settlement agreement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 10A(5) the general earnings are taken to be included in the PAYE settlement agreement` TRUE FALSE EQUALS NOTHING
#ASSERT `s 10A(5) the general earnings are taken to be included in the PAYE settlement agreement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 10A(6) the Class 1B percentage` (15%) EQUALS 0.15
-- s 10A(3): 15% of (chargeable emoluments 1000 plus tax 400) = 15% x 1400 = 210
#ASSERT `s 10A(3) the amount of the Class 1B contribution` (JUST TRUE) 1000 400 (15%) EQUALS JUST 210
#ASSERT `s 10A(3) the amount of the Class 1B contribution` (JUST FALSE) 1000 400 (15%) EQUALS NOTHING
#ASSERT `s 10A(3) the amount of the Class 1B contribution` NOTHING 1000 400 (15%) EQUALS NOTHING
