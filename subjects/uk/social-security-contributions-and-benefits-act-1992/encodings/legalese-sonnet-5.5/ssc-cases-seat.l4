-- No income: the applicable amount, 100.
#ASSERT `Under section 124(4), how much income support am I entitled to in pounds a week` TRUE TRUE FALSE TRUE 999 100 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST 100
-- Not entitled (working): no amount.
#ASSERT `Under section 124(4), how much income support am I entitled to in pounds a week` TRUE TRUE FALSE FALSE 30 100 TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- A period of less than a week: subsection (5) governs, not subsection (4).
#ASSERT `Under section 124(4), how much income support am I entitled to in pounds a week` TRUE TRUE FALSE FALSE 30 100 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
