-- Not in Great Britain.
#ASSERT `Under section 124(1), am I entitled to income support` TRUE FALSE FALSE FALSE 30 100 FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
