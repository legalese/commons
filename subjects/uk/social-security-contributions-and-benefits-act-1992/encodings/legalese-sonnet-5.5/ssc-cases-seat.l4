#ASSERT `Under section 171ZU(14), may I vary the number of weeks for which I intend to claim shared parental pay` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171ZU(14), may I vary the number of weeks for which I intend to claim shared parental pay` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING

-- s 171ZX(1): the person of whom I have been an employee as the conditions describe is liable; any other is not covered (the Commissioners may be made liable)
#ASSERT `Under section 171ZX(1), is my employer liable to pay me shared parental pay` TRUE EQUALS JUST TRUE
#ASSERT `Under section 171ZX(1), is my employer liable to pay me shared parental pay` FALSE EQUALS NOTHING

-- s 171ZY(2): a week in my notice's period, not afterwards excluded, and no more than the weeks determined (the 4th of 4 is payable, the 5th is outside the grant)
#ASSERT `Under section 171ZY(2), is shared parental pay payable to me for a given week` TRUE FALSE 3 4 EQUALS JUST TRUE
#ASSERT `Under section 171ZY(2), is shared parental pay payable to me for a given week` TRUE FALSE 4 4 EQUALS JUST TRUE
#ASSERT `Under section 171ZY(2), is shared parental pay payable to me for a given week` TRUE FALSE 5 4 EQUALS NOTHING
-- a week afterwards excluded by a variation is not a week in a relevant period (s 171ZY(7)), so the grant does not reach it
#ASSERT `Under section 171ZY(2), is shared parental pay payable to me for a given week` TRUE TRUE 1 4 EQUALS NOTHING
-- s 171ZY(3): not payable for a week in a relevant period if it is not my intention at the beginning of the week to care for the child (unless prescribed otherwise)
#ASSERT `Under section 171ZY(3), is shared parental pay payable to me for a week if I do not intend to care for the child` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171ZY(3), is shared parental pay payable to me for a week if I do not intend to care for the child` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 171ZY(3), is shared parental pay payable to me for a week if I do not intend to care for the child` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- s 171ZY(4): not payable for a week in a relevant period during any part of which I work for any employer (unless prescribed otherwise)
#ASSERT `Under section 171ZY(4), is shared parental pay payable to me for a week in which I work for an employer` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171ZY(4), is shared parental pay payable to me for a week in which I work for an employer` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 171ZY(4), is shared parental pay payable to me for a week in which I work for an employer` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- s 171ZZ(1): void to the extent that it purports to limit the Part or to make me contribute to my employer's costs; an agreement that does neither is not said to be void
#ASSERT `Under section 171ZZ(1), is my agreement void to the extent that it limits my shared parental pay or makes me pay my employer's costs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 171ZZ(1), is my agreement void to the extent that it limits my shared parental pay or makes me pay my employer's costs` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 171ZZ(1), is my agreement void to the extent that it limits my shared parental pay or makes me pay my employer's costs` FALSE FALSE EQUALS NOTHING

§§ `Statutory parental bereavement pay (Part 12ZD)`

-- s 171ZZ6(1), (2): the child, born alive, died on Sat 10 Jan 2026 aged under 18; the relevant week is Sun 28 Dec 2025 to Sat 3 Jan 2026;
-- 52 weeks of employment (at least 26), earnings 150 against the limit of 100, entitled to be in the job, in it from 1 Jan 2025 and still; a prescribed relationship
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- 25 weeks against 26: one week short
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 25 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- exactly 26 weeks: "at least"
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 26 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- earnings 99 against the lower earnings limit of 100
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 99 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- employment begun on 5 Jan 2026, after the end of the relevant week (3 Jan 2026): not in it from the end of that week
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 5 1 2026) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- employment ended on 9 Jan 2026, before the child died on 10 Jan 2026
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 1 1 2025) TRUE (Date 9 1 2026) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- employment ended on the day the child died: in it "ending with the day on which the child dies"
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 1 1 2025) TRUE (Date 10 1 2026) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- a person of 18 or over is not a "child" (s 171ZZ14(1)): no bereaved parent
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) FALSE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- the prescribed relationship is not satisfied
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- not entitled to be in the job at the end of the relevant week, and section 63(3) in force before the death: paragraph (c) applies
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 FALSE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- section 63(3) not yet in force on the day of death: paragraph (c) is omitted (s 171ZZ6(7)), so not being entitled to be in the job does not matter
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 FALSE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2030) FALSE EQUALS JUST TRUE
-- regulations modify or disapply a condition: the text alone does not answer
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` FALSE 40 (Date 1 6 2020) TRUE (Date 10 1 2026) TRUE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) TRUE EQUALS NOTHING
-- a child stillborn after 25 weeks counts (s 171ZZ15(a)); the day of birth is the day of death (s 171ZZ15(b)): the relevant week is still the week before 10 Jan 2026
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` TRUE 25 (Date 10 1 2026) FALSE (Date 1 1 2020) FALSE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- a child stillborn at 24 weeks or less is not covered by "include a child stillborn after twenty-four weeks"
#ASSERT `Under section 171ZZ6(1), am I entitled to statutory parental bereavement pay` TRUE 24 (Date 10 1 2026) FALSE (Date 1 1 2020) FALSE 52 150 TRUE (Date 1 1 2025) FALSE (Date 1 1 2025) TRUE 100 (Date 1 1 2020) FALSE EQUALS NOTHING
-- s 171ZZ9(2): at 100 a week, 2 weeks of a prescribed 2, within the qualifying period: 200; 3 weeks is outside the grant
#ASSERT `Under section 171ZZ9(2), how much parental bereavement pay is payable to me for the weeks I choose` 100 2 2 TRUE EQUALS JUST 200
#ASSERT `Under section 171ZZ9(2), how much parental bereavement pay is payable to me for the weeks I choose` 100 3 2 TRUE EQUALS NOTHING
#ASSERT `Under section 171ZZ9(2), how much parental bereavement pay is payable to me for the weeks I choose` 100 2 2 FALSE EQUALS NOTHING
-- s 171ZZ9(8): not payable for a statutory pay week during any part of which I work for an employer not liable to pay me (unless prescribed otherwise)
#ASSERT `Under section 171ZZ9(8), is parental bereavement pay payable to me for a week in which I work for another employer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171ZZ9(8), is parental bereavement pay payable to me for a week in which I work for another employer` FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 171ZZ9(8), is parental bereavement pay payable to me for a week in which I work for another employer` TRUE TRUE EQUALS NOTHING
-- s 171ZZ15(a): stillborn after twenty-four weeks: 25 weeks counts, 24 does not (not covered), a child born alive is not within this paragraph
#ASSERT `Under section 171ZZ15(a), does my stillborn child count as a child for parental bereavement pay` TRUE 25 EQUALS JUST TRUE
#ASSERT `Under section 171ZZ15(a), does my stillborn child count as a child for parental bereavement pay` TRUE 24 EQUALS NOTHING
#ASSERT `Under section 171ZZ15(a), does my stillborn child count as a child for parental bereavement pay` FALSE 40 EQUALS NOTHING

§§ `Statutory neonatal care pay (Part 12ZE)`

-- s 171ZZ16(1), (2): child born 1 Jan 2026; neonatal care of a prescribed kind starting 5 Jan 2026 (within 28 days of birth) and continuing to 12 Jan 2026 (seven days after the day it started);
-- a prescribed relationship; 52 weeks of employment (at least 26); entitled to be in the job; earnings 150 against the limit of 100
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- care continued only to 11 Jan, six days after the day it started: not "at least seven days"
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 11 1 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- care starting on 29 Jan 2026, 28 days after the birth, is within the 28 days beginning with the day after the birth
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 29 1 2026) TRUE (Date 5 2 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- care starting on 30 Jan 2026, 29 days after the birth, is after the 28 days: not neonatal care
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 30 1 2026) TRUE (Date 6 2 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- the care is not of a prescribed medical or palliative kind
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) FALSE (Date 12 1 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- 25 weeks against 26
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 25 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- earnings 99 against the limit of 100
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 52 TRUE 99 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- no prescribed relationship with the child
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) FALSE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- a further condition under subsection (3) applies and is satisfied
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 52 TRUE 150 TRUE TRUE TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST TRUE
-- a further condition under subsection (3) applies and is not satisfied (not in the employment at the beginning of the week)
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 52 TRUE 150 TRUE FALSE TRUE 100 (Date 1 1 2020) FALSE EQUALS JUST FALSE
-- regulations modify or disapply a condition: the text alone does not answer
#ASSERT `Under section 171ZZ16(1), am I entitled to statutory neonatal care pay` (Date 1 1 2026) (Date 5 1 2026) TRUE (Date 12 1 2026) TRUE 52 TRUE 150 FALSE FALSE FALSE 100 (Date 1 1 2020) TRUE EQUALS NOTHING
-- s 171ZZ19(2): at 100 a week, 2 weeks of a prescribed 2, within the qualifying period: 200; 3 weeks is outside the grant
#ASSERT `Under section 171ZZ19(2), how much neonatal care pay is payable to me for the weeks I choose` 100 2 2 TRUE EQUALS JUST 200
#ASSERT `Under section 171ZZ19(2), how much neonatal care pay is payable to me for the weeks I choose` 100 3 2 TRUE EQUALS NOTHING
-- s 171ZZ19(8): not payable for a week during any part of which I work for an employer not liable to pay me (unless prescribed otherwise)
#ASSERT `Under section 171ZZ19(8), is neonatal care pay payable to me for a week in which I work for another employer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171ZZ19(8), is neonatal care pay payable to me for a week in which I work for another employer` FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 171ZZ19(8), is neonatal care pay payable to me for a week in which I work for another employer` TRUE TRUE EQUALS NOTHING
-- s 171ZZ16(4): care of a prescribed kind that starts within 28 days of the child's birth (1 Jan 2026): starting 29 Jan 2026 is within; 30 Jan 2026 is not
#ASSERT `Under section 171ZZ16(4), is my child's care neonatal care` TRUE (Date 29 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `Under section 171ZZ16(4), is my child's care neonatal care` TRUE (Date 30 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
#ASSERT `Under section 171ZZ16(4), is my child's care neonatal care` FALSE (Date 5 1 2026) (Date 1 1 2026) EQUALS JUST FALSE

§§ `Incapacity for work (Part XIIA)`

-- s 171A(1): arguments: Part V purpose, Part XI purpose, other purpose, otherwise expressly provided; (2) regulations, failed, good cause; (3) regulations, called, failed, good cause;
-- s 171E(1) regulations, misconduct, treatment, behaviour; s 171D(1) capable, incapable; weeks worked of 21; first day of series; day in question; (8) figures changed;
-- incapable on the own occupation test; incapable on a personal capability assessment; assessment carried out
-- 12 of the last 21 weeks in remunerative work (more than 8): the own occupation test applies, and I am incapable on it
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- the own occupation test applies and I am not incapable on it
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- for the purposes of statutory sick pay (Part XI) this Part does not apply (s 171G(1)): the question is for another provision
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS NOTHING
-- another provision expressly provides otherwise (s 171A(1), "save as otherwise expressly provided")
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS NOTHING
-- regulations treat me as capable of work after I failed, without good cause, to give the information: capable, whatever the test says
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- with good cause for the failure, that treatment does not apply: the own occupation test decides
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- regulations treat me as capable of work after I missed a medical examination without good cause
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations treat me as capable of work because I became incapable through my own misconduct (s 171E(1))
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations under section 171D(1) treat me as incapable of work: incapable, whatever the test says
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- regulations under section 171D(1) treat me as capable of work
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations treat me both as capable and as incapable of work; the text does not say which prevails
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE 12 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS NOTHING
-- 5 of the last 21 weeks (not more than 8): the own occupation test is not applicable by itself; it is carried forward from the determination on 1 Jan 2026
-- 10 January 2026 is within the spell, before the 197th day: the own occupation test is still the test
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 5 (Date 1 1 2026) (Date 10 1 2026) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- the 197th day of incapacity is 16 July 2026: the text does not say whether it is inside "until"; the day after, the period has ended and a personal capability assessment decides
-- on the 197th day itself the text does not say which test decides
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 5 (Date 1 1 2026) (Date 16 7 2026) FALSE TRUE FALSE FALSE EQUALS NOTHING
-- after the 197th day a personal capability assessment decides; it finds me incapable
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 5 (Date 1 1 2026) (Date 17 7 2026) FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- the assessment has been carried out and finds me capable
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 5 (Date 1 1 2026) (Date 17 7 2026) FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- no assessment has been carried out: the text alone does not answer
#ASSERT `Under section 171A(1), am I incapable of work on a given day` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 5 (Date 1 1 2026) (Date 17 7 2026) FALSE TRUE FALSE FALSE EQUALS NOTHING

-- s 171B(1): more than 8 weeks of the last 21: 9 is more
#ASSERT `Under section 171B(1), does the own occupation test apply to me` 9 EQUALS JUST TRUE
-- exactly 8 weeks is not more than 8: the text is silent
#ASSERT `Under section 171B(1), does the own occupation test apply to me` 8 EQUALS NOTHING
-- s 171B(3): an unbroken series beginning 1 Jan 2026: the test remains applicable through to the day before the 197th day (16 July 2026), the 197th day is not covered, later days are after the stated period
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 1 1 2026) (Date 10 1 2026) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 1 1 2026) (Date 15 7 2026) FALSE EQUALS `s 171B(3) the test remains applicable`
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 1 1 2026) (Date 16 7 2026) FALSE EQUALS `s 171B(3) the text does not say whether the test applies`
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 1 1 2026) (Date 17 7 2026) FALSE EQUALS `s 171B(3) the stated period has ended`
-- regulations under section 171B(8) change the figures: the text alone does not answer
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 1 1 2026) (Date 10 1 2026) TRUE EQUALS `s 171B(3) the text does not say whether the test applies`
-- a day before the determination
#ASSERT `Under section 171B(3), does the own occupation test still apply to me on a given day` (Date 10 1 2026) (Date 5 1 2026) FALSE EQUALS `s 171B(3) there is no determination to carry forward`
-- s 171B(4): a woman whose day falls within her maternity allowance period: yes; a man in the same position is not within (c); a day with none of the four: no ("means")
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 171B(4), is a given day a day of incapacity for work for me` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 171E(2): not exceeding 6 weeks, 42 days
#ASSERT `Under section 171E(2), may my disqualification or treatment as capable of work last a given number of days` 42 EQUALS JUST TRUE
#ASSERT `Under section 171E(2), may my disqualification or treatment as capable of work last a given number of days` 43 EQUALS JUST FALSE
-- s 171F(2): England and Wales: a member of a parish or community council is a councillor; Scotland: a parish council is not listed, a regional council is; a non-member is not
#ASSERT `Under section 171F(2), am I a councillor whose work as a councillor is disregarded` `s 171F(2) England and Wales` `s 171F(2)(a) a parish or community council` TRUE EQUALS JUST TRUE
#ASSERT `Under section 171F(2), am I a councillor whose work as a councillor is disregarded` `s 171F(2) Scotland` `s 171F(2)(a) a parish or community council` TRUE EQUALS JUST FALSE
#ASSERT `Under section 171F(2), am I a councillor whose work as a councillor is disregarded` `s 171F(2) Scotland` `s 171F(2)(b) a regional council` TRUE EQUALS JUST TRUE
#ASSERT `Under section 171F(2), am I a councillor whose work as a councillor is disregarded` `s 171F(2) England and Wales` `s 171F(2)(a) a parish or community council` FALSE EQUALS JUST FALSE
-- s 171G(1): not for the purposes of Part V, Part XI or prescribed purposes; for any other purpose the subsection is silent
#ASSERT `Under section 171G(1), does the Part on incapacity for work apply for my purpose` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171G(1), does the Part on incapacity for work apply for my purpose` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 171G(1), does the Part on incapacity for work apply for my purpose` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 171G(1), does the Part on incapacity for work apply for my purpose` FALSE FALSE FALSE EQUALS NOTHING

-- ====================================================================================================
-- cases-seat questions from part ssc8 (merged by the lead on 2026-11-04; unchanged text follows)
-- ====================================================================================================
-- Cases for the seat layer ssc8-seat.l4: Schedules 1, 2, 3, 4A and 4B of the Social Security Contributions and Benefits Act 1992.
-- Each case states the facts a person in the seat would give and the answer worked out by hand from the paragraph named in its comment;
-- JUST FALSE is the text's own "no" and NOTHING is "not covered". The assertions written equal the assertions satisfied.

§ `Seat cases`

-- 1(1)(a): employer paid 100 and 50 in the week: one payment of 150.
#ASSERT `Under schedule 1 paragraph 1(1)(a), how much of what one employer paid me in a week counts as a single payment of earnings` 100 50 FALSE EQUALS JUST 150

-- 1(1)(a): regulations provide otherwise: not covered.
#ASSERT `Under schedule 1 paragraph 1(1)(a), how much of what one employer paid me in a week counts as a single payment of earnings` 100 50 TRUE EQUALS NOTHING

-- 1(1)(b): two employers paid 100 and 70; prescribed circumstances: 170.
#ASSERT `Under schedule 1 paragraph 1(1)(b), how much of what different people paid me in a week counts as a single payment of earnings` 100 70 TRUE EQUALS JUST 170

-- 1(1)(b): not prescribed circumstances: not covered.
#ASSERT `Under schedule 1 paragraph 1(1)(b), how much of what different people paid me in a week counts as a single payment of earnings` 100 70 FALSE EQUALS NOTHING

-- 3(1): the whole of an 80 contribution is paid first.
#ASSERT `Under schedule 1 paragraph 3(1), how much of my own Class 1 contribution does my employer have to pay first, on my behalf` TRUE TRUE FALSE 80 FALSE 0 EQUALS JUST 80

-- 3(1): regulations prescribe a part, 30.
#ASSERT `Under schedule 1 paragraph 3(1), how much of my own Class 1 contribution does my employer have to pay first, on my behalf` TRUE TRUE FALSE 80 TRUE 30 EQUALS JUST 30

-- 3(1): prescribed circumstances: not covered.
#ASSERT `Under schedule 1 paragraph 3(1), how much of my own Class 1 contribution does my employer have to pay first, on my behalf` TRUE TRUE TRUE 80 FALSE 0 EQUALS NOTHING

-- 3(1): the payment was not made to an employed earner: not covered.
#ASSERT `Under schedule 1 paragraph 3(1), how much of my own Class 1 contribution does my employer have to pay first, on my behalf` FALSE TRUE FALSE 80 FALSE 0 EQUALS NOTHING

-- 3(3): regulations allow recovery of 45.
#ASSERT `Under schedule 1 paragraph 3(3), how much of my Class 1 contribution that my employer has paid may my employer recover from me` TRUE 45 EQUALS JUST 45

-- 3(3): regulations do not provide for recovery: not covered.
#ASSERT `Under schedule 1 paragraph 3(3), how much of my Class 1 contribution that my employer has paid may my employer recover from me` FALSE 45 EQUALS NOTHING

-- 3(3): recovery by deduction from earnings: allowed.
#ASSERT `Under schedule 1 paragraph 3(3), can my employer recover what it paid in any way other than by deduction from my earnings` TRUE FALSE EQUALS JUST TRUE

-- 3(3): recovery in another way, outside sub-paragraphs (3A) to (5): the text says no.
#ASSERT `Under schedule 1 paragraph 3(3), can my employer recover what it paid in any way other than by deduction from my earnings` FALSE FALSE EQUALS JUST FALSE

-- 3(3): recovery in another way, in a non-monetary case: sub-paragraphs (3A) to (5) govern: not covered here.
#ASSERT `Under schedule 1 paragraph 3(3), can my employer recover what it paid in any way other than by deduction from my earnings` FALSE TRUE EQUALS NOTHING

-- 3(3B): regulations allow up to 20 of the 35 paid.
