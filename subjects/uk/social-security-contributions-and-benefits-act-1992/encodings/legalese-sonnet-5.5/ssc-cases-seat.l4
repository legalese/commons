-- The child is under 16: a child is not a qualifying young person.
#ASSERT `Under section 142(2), is my child a qualifying young person` TRUE TRUE TRUE EQUALS JUST FALSE
-- Not under the prescribed age.
#ASSERT `Under section 142(2), is my child a qualifying young person` FALSE FALSE TRUE EQUALS JUST FALSE
