IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc1-class4`

-- Tests for ssc1-class4.l4 (ss 15 to 18A). Every expected value is written from the text beside the assertion.
-- Figures: lower limit 12,570, upper limit 50,270, main percentage 6%, additional percentage 2% (the Act's own figures).

§ `Tests for ss 15 to 18A`

§§ `s 15`

-- s 15(1): (a) and (b) hold and (c) does not
#ASSERT `s 15(1) Class 4 contributions are payable for the tax year in respect of the profits` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15(1) Class 4 contributions are payable for the tax year in respect of the profits` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 15(1) Class 4 contributions are payable for the tax year in respect of the profits` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 15(1) Class 4 contributions are payable for the tax year in respect of the profits` TRUE TRUE TRUE EQUALS NOTHING
-- s 15(2)
#ASSERT `s 15(2) the person is liable to pay the Class 4 contribution` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 15(2) the person is liable to pay the Class 4 contribution` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 15(2) the person is liable to pay the Class 4 contribution` NOTHING TRUE EQUALS NOTHING
-- s 15(3), (3ZA): the Act's figures
#ASSERT `s 15(3)(a) the lower profits limit as the Act states it` EQUALS 12570
#ASSERT `s 15(3)(b) the upper profits limit as the Act states it` EQUALS 50270
#ASSERT `s 15(3ZA)(a) the main Class 4 percentage as the Act states it` EQUALS 0.06
#ASSERT `s 15(3ZA)(b) the additional Class 4 percentage as the Act states it` EQUALS 0.02
-- s 15(3): nothing at or below 12,570; 6% of the excess up to 50,270; 2% of the excess above it
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 0 12570 50270 (6%) (2%) EQUALS JUST 0
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 10000 12570 50270 (6%) (2%) EQUALS JUST 0
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 12570 12570 50270 (6%) (2%) EQUALS JUST 0
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 12670 12570 50270 (6%) (2%) EQUALS JUST 6
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 50270 12570 50270 (6%) (2%) EQUALS JUST 2262
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 50370 12570 50270 (6%) (2%) EQUALS JUST 2264
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST TRUE) 60000 12570 50270 (6%) (2%) EQUALS JUST 2456.6
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` (JUST FALSE) 60000 12570 50270 (6%) (2%) EQUALS NOTHING
#ASSERT `s 15(3) the amount of the Class 4 contribution for the tax year` NOTHING 60000 12570 50270 (6%) (2%) EQUALS NOTHING
-- s 15(3A)
#ASSERT `s 15(3A) Class 4 contributions are payable by the member of the limited liability partnership` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 15(3A) Class 4 contributions are payable by the member of the limited liability partnership` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 15(3A) Class 4 contributions are payable by the member of the limited liability partnership` FALSE TRUE EQUALS NOTHING
#ASSERT `s 15(3A) Class 4 contributions are payable by the member of the limited liability partnership` FALSE FALSE EQUALS NOTHING
-- s 15(5)
#ASSERT `s 15(5) the year of assessment corresponds to the tax year` TRUE EQUALS JUST TRUE
#ASSERT `s 15(5) the year of assessment corresponds to the tax year` FALSE EQUALS JUST FALSE

§§ `s 16`

#ASSERT `s 16(1) the provision of the Income Tax Acts applies, with the necessary modifications, in relation to Class 4 contributions` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 16(1) the provision of the Income Tax Acts applies, with the necessary modifications, in relation to Class 4 contributions` FALSE FALSE EQUALS NOTHING
#ASSERT `s 16(1) the provision of the Income Tax Acts applies, with the necessary modifications, in relation to Class 4 contributions` TRUE TRUE EQUALS NOTHING
#ASSERT `s 16(3) Schedule 2 has effect in relation to the class of contribution` `Class 4` EQUALS JUST TRUE
#ASSERT `s 16(3) Schedule 2 has effect in relation to the class of contribution` `Class 2` EQUALS NOTHING

§§ `s 18`

-- s 18(1)(c): the total "exceeds" 12,570
#ASSERT `s 18(1) the regulations may make the earner liable to pay a Class 4 contribution in respect of the earnings` TRUE TRUE 12570.01 12570 EQUALS JUST TRUE
#ASSERT `s 18(1) the regulations may make the earner liable to pay a Class 4 contribution in respect of the earnings` TRUE TRUE 12570 12570 EQUALS NOTHING
#ASSERT `s 18(1) the regulations may make the earner liable to pay a Class 4 contribution in respect of the earnings` FALSE TRUE 20000 12570 EQUALS NOTHING
#ASSERT `s 18(1) the regulations may make the earner liable to pay a Class 4 contribution in respect of the earnings` TRUE FALSE 20000 12570 EQUALS NOTHING
-- s 18(1A): worked as in section 15(3)
#ASSERT `s 18(1A) the amount of the Class 4 contribution payable by virtue of regulations under section 18` TRUE 12570 12570 50270 (6%) (2%) EQUALS JUST 0
#ASSERT `s 18(1A) the amount of the Class 4 contribution payable by virtue of regulations under section 18` TRUE 50270 12570 50270 (6%) (2%) EQUALS JUST 2262
#ASSERT `s 18(1A) the amount of the Class 4 contribution payable by virtue of regulations under section 18` TRUE 50370 12570 50270 (6%) (2%) EQUALS JUST 2264
#ASSERT `s 18(1A) the amount of the Class 4 contribution payable by virtue of regulations under section 18` FALSE 50370 12570 50270 (6%) (2%) EQUALS NOTHING

§§ `s 18A`

#ASSERT `s 18A(2) the body is a firm` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 18A(2) the body is a firm` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 18A(2) the body is a firm` FALSE FALSE EQUALS NOTHING
#ASSERT `s 18A(2) the person is a partner` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 18A(2) the person is a partner` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 18A(2) the person is a partner` FALSE FALSE EQUALS NOTHING
-- s 18A(3): not before the beginning of the tax year (6 April 2025) in which they are made
#ASSERT `s 18A(3) regulations under section 18A may have effect from the day` (Date 5 4 2025) (Date 6 4 2025) EQUALS JUST FALSE
#ASSERT `s 18A(3) regulations under section 18A may have effect from the day` (Date 6 4 2025) (Date 6 4 2025) EQUALS NOTHING
#ASSERT `s 18A(3) regulations under section 18A may have effect from the day` (Date 7 4 2025) (Date 6 4 2025) EQUALS NOTHING
