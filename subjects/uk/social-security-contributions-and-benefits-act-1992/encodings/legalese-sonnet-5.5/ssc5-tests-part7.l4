§§ `s 137(1) -- the definitions for Part VII`

`s 137(1) test man` MEANS Person WITH
    `date of birth` IS Date 1 6 1960
    `sex` IS Man
    `marital status` IS `married`
    `date of attaining pensionable age` IS Date 1 6 2026
`s 137(1) test woman` MEANS Person WITH
    `date of birth` IS Date 1 6 1962
    `sex` IS Woman
    `marital status` IS `married`
    `date of attaining pensionable age` IS Date 1 6 2028

-- Positional record: one member, other member, married, civil partners, same household, living together as if married.
`s 137(1) test couple, married and one household` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, TRUE, FALSE, TRUE, FALSE
`s 137(1) test couple, civil partners and one household` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, FALSE, TRUE, TRUE, FALSE
`s 137(1) test couple, married but not one household` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, TRUE, FALSE, FALSE, FALSE
`s 137(1) test couple, married, apart, but living together as if married` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, TRUE, FALSE, FALSE, TRUE
`s 137(1) test couple, unmarried and living together as if married` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, FALSE, FALSE, FALSE, TRUE
`s 137(1) test couple, unmarried and not living together` MEANS Couple OF `s 137(1) test man`, `s 137(1) test woman`, FALSE, FALSE, FALSE, FALSE

#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, married and one household` FALSE EQUALS JUST TRUE
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, civil partners and one household` FALSE EQUALS JUST TRUE
-- Limb one needs the same household; limb two is only for people who are not married or civil partners.
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, married but not one household` FALSE EQUALS JUST FALSE
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, married, apart, but living together as if married` FALSE EQUALS JUST FALSE
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, unmarried and living together as if married` FALSE EQUALS JUST TRUE
-- "otherwise than in prescribed circumstances"
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, unmarried and living together as if married` TRUE EQUALS JUST FALSE
#ASSERT `s 137(1) the two persons are a couple` `s 137(1) test couple, unmarried and not living together` FALSE EQUALS JUST FALSE

-- The qualifying age: a woman's pensionable age; a man's is the date a woman born on his birthday attains it.
#ASSERT `s 137(1) the date the person attains the qualifying age for state pension credit` `s 137(1) test woman` (Date 1 1 2000) EQUALS Date 1 6 2028
#ASSERT `s 137(1) the date the person attains the qualifying age for state pension credit` `s 137(1) test man` (Date 1 9 2026) EQUALS Date 1 9 2026
#ASSERT `s 137(1) the person has attained the qualifying age for state pension credit` (Date 1 9 2026) (Date 1 9 2026) EQUALS TRUE
#ASSERT `s 137(1) the person has attained the qualifying age for state pension credit` (Date 1 9 2026) (Date 31 8 2026) EQUALS FALSE
#ASSERT `s 137(1) the person has attained the qualifying age for state pension credit` (Date 1 9 2026) (Date 2 9 2026) EQUALS TRUE

#ASSERT `s 137(1) the person is a child` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 137(1) the person is a child` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 137(1) the person is a child` NOTHING EQUALS NOTHING
#ASSERT `s 137(1) the accommodation is a dwelling` TRUE EQUALS JUST TRUE
#ASSERT `s 137(1) the accommodation is a dwelling` FALSE EQUALS JUST FALSE

-- "family": (a) a couple; (b) a couple and a child; (c) a lone person with a child, except in prescribed circumstances.
-- Arguments: couple answer; (b) child; not a member of a couple; (c) child; (c) excluded by prescribed circumstances.
#ASSERT `s 137(1) the persons are a family` (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137(1) the persons are a family` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137(1) the persons are a family` (JUST FALSE) FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137(1) the persons are a family` (JUST FALSE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 137(1) the persons are a family` (JUST FALSE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(1) the persons are a family` (JUST FALSE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(1) the persons are a family` NOTHING FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137(1) the persons are a family` NOTHING FALSE TRUE TRUE FALSE EQUALS JUST TRUE

#ASSERT `s 137(1) the scheme is an industrial injuries scheme` `s 137(1) a scheme made under Schedule 8 to this Act` EQUALS JUST TRUE
#ASSERT `s 137(1) the scheme is an industrial injuries scheme` `s 137(1) a scheme made under section 159 of the 1975 Act` EQUALS JUST TRUE
#ASSERT `s 137(1) the scheme is an industrial injuries scheme` `s 137(1) a scheme made under the Old Cases Act` EQUALS JUST TRUE
#ASSERT `s 137(1) the scheme is an industrial injuries scheme` `s 137(1) a scheme of another kind` EQUALS JUST FALSE
#ASSERT `s 137(1) the body is a local authority in relation to Scotland` TRUE EQUALS JUST TRUE
#ASSERT `s 137(1) the body is a local authority in relation to Scotland` FALSE EQUALS JUST FALSE
#ASSERT `s 137(1) the scheme is a war pension scheme` TRUE EQUALS JUST TRUE
#ASSERT `s 137(1) the scheme is a war pension scheme` FALSE EQUALS JUST FALSE

-- "week", for council tax benefit, begins on a Monday: 4 March 2024 was a Monday and 10 March 2024 a Sunday.
#ASSERT (`s 137(1) the week in relation to council tax benefit containing the date` (Date 4 3 2024))'s `the first day` EQUALS Date 4 3 2024
#ASSERT (`s 137(1) the week in relation to council tax benefit containing the date` (Date 5 3 2024))'s `the first day` EQUALS Date 4 3 2024
#ASSERT (`s 137(1) the week in relation to council tax benefit containing the date` (Date 10 3 2024))'s `the first day` EQUALS Date 4 3 2024
#ASSERT (`s 137(1) the week in relation to council tax benefit containing the date` (Date 10 3 2024))'s `the last day` EQUALS Date 10 3 2024
#ASSERT (`s 137(1) the week in relation to council tax benefit containing the date` (Date 11 3 2024))'s `the first day` EQUALS Date 11 3 2024

#ASSERT (`s 137(1) how the term is defined` `s 137(1) prescribed`)'s `the way it is defined` EQUALS `s 122(1) a definition by "means"`
#ASSERT (`s 137(1) how the term is defined` `s 137(1) billing authority`)'s `the way it is defined` EQUALS `s 122(1) a meaning borrowed from another Act or instrument`

§§ `s 137(1) -- unless the context otherwise requires`

#ASSERT `s 137(1) the defined meaning applies` FALSE EQUALS JUST TRUE
#ASSERT `s 137(1) the defined meaning applies` TRUE EQUALS JUST FALSE

§§ `s 124(1)(c) -- remunerative work, and the substituted paragraph (c) of s 127(b)`

-- Paragraph (c): not engaged in remunerative work and, if a member of a couple, the other member is not so engaged.
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, every condition met` EQUALS TRUE
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, working` EQUALS FALSE
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, partner working` EQUALS FALSE
-- In the 15 days after a return to work with the same employer, paragraph (c) reads only "in the case of a member
-- of a couple, the other member is not engaged in remunerative work": the claimant's own work no longer bars.
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, working, in the 15 days after return` EQUALS TRUE
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, partner working, in the 15 days after return` EQUALS FALSE
-- A flag about a partner's work, but no couple: the couple limb does not arise.
#ASSERT `s 124(1)(c) the person satisfies paragraph (c)` `s 124(1) test claimant, a flag about a partner but not a couple` EQUALS TRUE
