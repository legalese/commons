#ASSERT `s 161(3) the establishment or organisation is part of Her Majesty's forces` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 161(3) the establishment or organisation is part of Her Majesty's forces` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 161(3) the establishment or organisation is part of Her Majesty's forces` NOTHING TRUE EQUALS NOTHING
-- Arguments: on a ship etc.; outside Great Britain at a prescribed time; continental shelf operations (s 120(2)); prescribed employment.
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 162(1) regulations may modify Part XI in its application to the person` FALSE FALSE FALSE FALSE EQUALS NOTHING

§§ `s 163 -- interpretation`

-- "contract of service". Arguments: it is one in the ordinary sense; an arrangement providing the terms of appointment of an employee; the phrase is in paragraph (a) of the definition of employee.
#ASSERT `s 163(1) the arrangement counts as a contract of service` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 163(1) the arrangement counts as a contract of service` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 163(1) the arrangement counts as a contract of service` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 163(1) the arrangement counts as a contract of service` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the arrangement counts as a contract of service` FALSE FALSE FALSE EQUALS NOTHING

-- fixtures
`s 163(1) test person` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Man
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 163(1) test employment in Great Britain` MEANS Employment WITH
    `the employee` IS `s 163(1) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

`s 163(1) test employment abroad` MEANS Employment WITH
    `the employee` IS `s 163(1) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS FALSE

`s 163(1) test employment in an office` MEANS Employment WITH
    `the employee` IS `s 163(1) test person`
    `the kind of employer` IS `the Crown`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS TRUE
    `carried on in Great Britain` IS TRUE

`s 163(1) test employment neither contract nor office` MEANS Employment WITH
    `the employee` IS `s 163(1) test person`
    `the kind of employer` IS `an individual`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

