#ASSERT `s 161 Part XI applies to the person employed by or under the Crown` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 161 Part XI applies to the person employed by or under the Crown` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 161 Part XI applies to the person employed by or under the Crown` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 161 Part XI applies to the person employed by or under the Crown` FALSE FALSE EQUALS NOTHING
