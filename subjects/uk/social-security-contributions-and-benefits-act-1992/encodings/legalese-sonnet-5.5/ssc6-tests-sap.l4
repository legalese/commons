IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc6-sap`

-- Tests for ssc6-sap.l4 (Part 12ZB, ss 171ZL-171ZT).
-- Every expected value is written by hand from the Act's text (ukpga-1992-4.txt, lines 3559-3717),
-- beside the assertion. None is copied from what the code printed.
-- Arbitrary dates: 4 January 2026 is a Sunday; 8 November 2026 is a Sunday, 44 weeks later.
-- A figure regulations would supply (a weekly rate, the lower earnings limit) is arbitrary here.

§ `Tests for Part 12ZB`

§§ `Sundays`

#ASSERT (Day (Date 4 1 2026)) MODULO 7 EQUALS 0
#ASSERT (Day (Date 8 11 2026)) MODULO 7 EQUALS 0
#ASSERT NOT ((Day (Date 12 11 2026)) MODULO 7 EQUALS 0)

§§ `The helper -- three-valued AND`

#ASSERT `s 171ZL(1) all of these answers hold` (LIST) EQUALS JUST TRUE
#ASSERT `s 171ZL(1) all of these answers hold` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZL(1) all of these answers hold` (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(1) all of these answers hold` (LIST JUST FALSE, JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZL(1) all of these answers hold` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 171ZL(1) all of these answers hold` (LIST NOTHING, JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZL(1) all of these answers hold` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(1) all of these answers hold` (LIST JUST FALSE, NOTHING) EQUALS JUST FALSE

§§ `The numbers the Act states`

#ASSERT `s 171ZL(2)(b) the number of weeks of continuous employment required` EQUALS 26
#ASSERT `s 171ZL(6)(b) the least number of days of notice before the liability begins` EQUALS 28
#ASSERT `s 171ZN(2) the longest adoption pay period in weeks` EQUALS 52
#ASSERT `s 171ZN(2E)(a) the number of weeks payable at the earnings-related rate` EQUALS 6
#ASSERT `s 171ZN(2F) the percentage of normal weekly earnings` EQUALS 90%

§§ `s 171ZL(2) -- the conditions`

#ASSERT `s 171ZL(2)(a) he is a person with whom a child is, or is expected to be, placed for adoption` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(a) he is a person with whom a child is, or is expected to be, placed for adoption` FALSE EQUALS JUST FALSE
-- Arguments: the service (weeks, normal weekly earnings, last day of the relevant week); employed earner's employment.
#ASSERT `s 171ZL(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 26, 150, Date 14 11 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 25, 150, Date 14 11 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 100, 150, Date 14 11 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 100, 150, Date 14 11 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 171ZL(2)(c) he has ceased to work for the employer` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(c) he has ceased to work for the employer` FALSE EQUALS JUST FALSE
-- Arguments: the service; the lower earnings limit (arbitrary here: 123).
#ASSERT `s 171ZL(2)(d) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 123, Date 14 11 2026) 123 EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(d) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 122.99, Date 14 11 2026) 123 EQUALS JUST FALSE
#ASSERT `s 171ZL(2)(d) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 500, Date 14 11 2026) 123 EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(e) he has elected to receive statutory adoption pay` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(2)(e) he has elected to receive statutory adoption pay` FALSE EQUALS JUST FALSE
-- Arguments: conditions (a), (b), (c), (d), (e).
#ASSERT `s 171ZL(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZL(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZL(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZL(2) the conditions are satisfied` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- Arguments: he is, or has been, an employee (s 171ZS(2)); the conditions of subsection (2).
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 171ZL(1) he is entitled to statutory adoption pay` NOTHING (JUST FALSE) EQUALS JUST FALSE

§§ `s 171ZL(3) -- the relevant week (seam S30)`

-- Arguments: kind, the day he was notified of the match, the day the child was or is expected to be placed.
`s 171ZL(3) test placement notified Wednesday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 11 11 2026, Date 20 11 2026
`s 171ZL(3) test placement notified Sunday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 8 11 2026, Date 20 11 2026
`s 171ZL(3) test placement notified Saturday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 14 11 2026, Date 20 11 2026
`s 171ZL(3) test placement under section 22C` MEANS Placement OF `placed under section 22C of the Children Act 1989`, Date 15 11 2026, Date 20 11 2026
`s 171ZL(3) test placement under section 81` MEANS Placement OF `placed under section 81 of the Social Services and Well-being (Wales) Act 2014`, Date 18 11 2026, Date 20 11 2026

-- Arguments: the placement; regulations prescribe another period.
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement notified Wednesday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement notified Sunday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement notified Saturday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
-- subsections (9)(b) and (11)(b): the same week, counted from the day he is told the child is to be placed with him
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement under section 22C` FALSE EQUALS JUST (Period WITH `the first day` IS Date 15 11 2026, `the last day` IS Date 21 11 2026)
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement under section 81` FALSE EQUALS JUST (Period WITH `the first day` IS Date 15 11 2026, `the last day` IS Date 21 11 2026)
#ASSERT `s 171ZL(2) the relevant week` `s 171ZL(3) test placement notified Wednesday` TRUE EQUALS NOTHING

§§ `s 171ZL(4), (4A), (4B) -- elections and couples`

-- Arguments: the law; section 144(4) answer; section 29(3) answer.
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of England and Wales or Northern Ireland` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of England and Wales or Northern Ireland` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of England and Wales or Northern Ireland` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of Scotland` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of Scotland` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of Scotland` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 171ZL(4B) he is a member of a couple` `s 171ZL(4B) the law of another place` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
-- Arguments: the child is placed with him; (4B) answer; the other member meets the conditions of (2); the other member has elected.
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(4A) he falls within the subsection` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE NOTHING TRUE TRUE EQUALS NOTHING
-- when another limb already fails, the unanswered couple question changes nothing
#ASSERT `s 171ZL(4A) he falls within the subsection` TRUE NOTHING FALSE TRUE EQUALS JUST FALSE
-- Arguments: he has elected to receive statutory paternity pay under s 171ZB; (4A) answer.
#ASSERT `s 171ZL(4) he may elect to receive statutory adoption pay` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(4) he may elect to receive statutory adoption pay` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZL(4) he may elect to receive statutory adoption pay` TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 171ZL(4) he may elect to receive statutory adoption pay` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 171ZL(4) he may elect to receive statutory adoption pay` FALSE NOTHING EQUALS NOTHING

§§ `s 171ZL(5) -- more than one child`

#ASSERT `s 171ZL(5) the entitlement is affected by the placement, or expected placement, of more than one child` TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(5) the entitlement is affected by the placement, or expected placement, of more than one child` FALSE EQUALS NOTHING

§§ `s 171ZL(6), (7) -- notice`

#ASSERT `s 171ZL(6)(a) he gives the notice of the date the liability is to begin` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(a) he gives the notice of the date the liability is to begin` FALSE EQUALS JUST FALSE
-- Arguments: the day the notice is given; the date the liability is expected to begin; not reasonably practicable to give 28 days; given as soon as reasonably practicable.
-- 1 January 2026 plus 28 days is 29 January 2026.
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 29 1 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 30 1 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 28 1 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 28 1 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 28 1 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 1 1 2026) (Date 28 1 2026) FALSE TRUE EQUALS JUST FALSE
-- a notice given after the date: 28 days cannot have been given, so only the "as soon as reasonably practicable" limb is left
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 10 2 2026) (Date 1 2 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 10 2 2026) (Date 1 2 2026) FALSE TRUE EQUALS JUST FALSE
-- across a year end: 20 December 2025 plus 28 days is 17 January 2026
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 20 12 2025) (Date 17 1 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZL(6)(b) the notice is given at least 28 days before that date or, if that is not reasonably practicable, as soon as is reasonably practicable` (Date 20 12 2025) (Date 16 1 2026) FALSE FALSE EQUALS JUST FALSE
-- Arguments: paragraph (a); paragraph (b).
#ASSERT `s 171ZL(6) the notice condition for payments of statutory adoption pay is met` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZL(6) the notice condition for payments of statutory adoption pay is met` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(6) the notice condition for payments of statutory adoption pay is met` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZL(6) the notice condition for payments of statutory adoption pay is met` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZL(7) the notice shall be in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(7) the notice shall be in writing` FALSE EQUALS JUST FALSE

§§ `s 171ZL(9) to (12) -- other placements`

-- Arguments: the kind of placement; placed by a local authority with a local authority foster parent approved as a prospective adopter.
#ASSERT `s 171ZL(9) the placement is one to which the conditions of subsection (2) are applied` `placed for adoption under the law of a part of the United Kingdom` FALSE EQUALS JUST TRUE
#ASSERT `s 171ZL(9) the placement is one to which the conditions of subsection (2) are applied` `placed under section 22C of the Children Act 1989` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(9) the placement is one to which the conditions of subsection (2) are applied` `placed under section 22C of the Children Act 1989` FALSE EQUALS NOTHING
#ASSERT `s 171ZL(9) the placement is one to which the conditions of subsection (2) are applied` `placed under section 81 of the Social Services and Well-being (Wales) Act 2014` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZL(9) the placement is one to which the conditions of subsection (2) are applied` `placed under section 81 of the Social Services and Well-being (Wales) Act 2014` FALSE EQUALS NOTHING
#ASSERT `s 171ZL(10) he may become entitled as a result of the child being placed for adoption` TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(10) he may become entitled as a result of the child being placed for adoption` FALSE EQUALS NOTHING
#ASSERT `s 171ZL(12) he may become entitled as a result of the child being placed for adoption` TRUE EQUALS JUST FALSE
#ASSERT `s 171ZL(12) he may become entitled as a result of the child being placed for adoption` FALSE EQUALS NOTHING

§§ `s 171ZM -- liability`

#ASSERT `s 171ZM(1) the liability to make payments of statutory adoption pay is the person's` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZM(1) the liability to make payments of statutory adoption pay is the person's` FALSE EQUALS NOTHING

§§ `s 171ZN(2), (2A) -- the adoption pay period (seams S28, S29)`

-- 52 weeks from 1 January 2026 is 364 days, the last of which is 30 December 2026 (1 January 2027 is day 365).
-- Arguments: the first day; the duration in weeks.
#ASSERT `s 171ZN(2) the adoption pay period` (Date 1 1 2026) 52 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 12 2026)
#ASSERT `s 171ZN(2) the adoption pay period` (Date 1 1 2026) 39 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 9 2026)
#ASSERT `s 171ZN(2) the adoption pay period` (Date 1 1 2026) 1 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 7 1 2026)
#ASSERT `s 171ZN(2) the adoption pay period` (Date 1 1 2026) 53 EQUALS NOTHING
#ASSERT `s 171ZN(2) the adoption pay period` (Date 1 1 2026) 0 EQUALS NOTHING
#ASSERT `s 171ZS(1) the adoption pay period` (Date 1 1 2026) 39 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 9 2026)
#ASSERT `s 171ZS(1) the adoption pay period` (Date 1 1 2026) 53 EQUALS NOTHING
-- Arguments: the first day; the duration in weeks; the number of weeks to which it has been reduced.
#ASSERT `s 171ZN(2A) the adoption pay period as reduced` (Date 1 1 2026) 52 39 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 9 2026)
#ASSERT `s 171ZN(2A) the adoption pay period as reduced` (Date 1 1 2026) 52 51 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 23 12 2026)
#ASSERT `s 171ZN(2A) the adoption pay period as reduced` (Date 1 1 2026) 52 52 EQUALS NOTHING
#ASSERT `s 171ZN(2A) the adoption pay period as reduced` (Date 1 1 2026) 52 0 EQUALS NOTHING
#ASSERT `s 171ZN(2A) the adoption pay period as reduced` (Date 1 1 2026) 39 52 EQUALS NOTHING

§§ `s 171ZN(2E), (2F), (2G) -- the rate`

-- Normal weekly earnings 200 give an earnings-related rate of 90 per cent of 200, which is 180.
#ASSERT `s 171ZN(2F) the earnings-related rate in pounds` (`Service for statutory pay` OF 30, 200, Date 14 11 2026) EQUALS 180
#ASSERT `s 171ZN(2F) the earnings-related rate in pounds` (`Service for statutory pay` OF 30, 100, Date 14 11 2026) EQUALS 90
-- Arguments: the week number (the first week paid is week 1); the service; the weekly rate prescribed (150 here).
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 1 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS JUST 180
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 6 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS JUST 180
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 7 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS JUST 150
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 52 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS JUST 150
-- when the prescribed rate is higher than the earnings-related rate, the lower of the two is paid
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 7 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 250 EQUALS JUST 180
-- the first 6 weeks are at the earnings-related rate even when it is higher than the prescribed rate
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 3 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 100 EQUALS JUST 180
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 53 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS NOTHING
#ASSERT `s 171ZN(2E) the weekly rate of statutory adoption pay for the week in pounds` 0 (`Service for statutory pay` OF 30, 200, Date 14 11 2026) 150 EQUALS NOTHING
-- Arguments: the weekly rate prescribed; the weekly rate of statutory sick pay specified in s 157(1) (123.25).
#ASSERT `s 171ZN(2G) the weekly rate prescribed is not less than the weekly rate of statutory sick pay` 123.25 123.25 EQUALS JUST TRUE
#ASSERT `s 171ZN(2G) the weekly rate prescribed is not less than the weekly rate of statutory sick pay` 123.24 123.25 EQUALS JUST FALSE
#ASSERT `s 171ZN(2G) the weekly rate prescribed is not less than the weekly rate of statutory sick pay` 150 123.25 EQUALS JUST TRUE

§§ `s 171ZN(3) to (10) -- weeks, work, daily rate`

-- Arguments: the other works under a contract of service with him in part of the week; that contract existed before the adoption pay period (immaterial); the case is prescribed.
#ASSERT `s 171ZN(3) the person is liable to pay statutory adoption pay to the other in respect of the week` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZN(3) the person is liable to pay statutory adoption pay to the other in respect of the week` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZN(3) the person is liable to pay statutory adoption pay to the other in respect of the week` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 171ZN(3) the person is liable to pay statutory adoption pay to the other in respect of the week` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 171ZN(3) the person is liable to pay statutory adoption pay to the other in respect of the week` FALSE TRUE TRUE EQUALS NOTHING
-- Arguments: during part of the week he works for an employer not liable to pay him; the case is prescribed.
#ASSERT `s 171ZN(5) statutory adoption pay is payable to him in respect of the week` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZN(5) statutory adoption pay is payable to him in respect of the week` TRUE TRUE EQUALS NOTHING
#ASSERT `s 171ZN(5) statutory adoption pay is payable to him in respect of the week` FALSE FALSE EQUALS NOTHING
#ASSERT `s 171ZN(5) statutory adoption pay is payable to him in respect of the week` FALSE TRUE EQUALS NOTHING
-- One seventh of the weekly rate: 140 a week is 20 a day; 175 is 25.
#ASSERT `s 171ZN(6A) the daily rate of statutory adoption pay in pounds` 140 EQUALS 20
#ASSERT `s 171ZN(6A) the daily rate of statutory adoption pay in pounds` 175 EQUALS 25
#ASSERT `s 171ZN(7) the week convention of subsections (2) and (2E)` EQUALS `any period of 7 days`
#ASSERT `s 171ZN(8) the week convention of subsections (3), (5) and (6)` EQUALS `a period of 7 days beginning with the day on which a stated period begins`
#ASSERT `s 171ZP(7) the week convention of subsection (5)` EQUALS `a period of 7 days beginning with the day on which a stated period begins`
-- The adoption pay period begins on Wednesday 7 January 2026. Its weeks run Wednesday to Tuesday.
-- Arguments: the day; the first day of the adoption pay period.
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 7 1 2026) (Date 7 1 2026) EQUALS JUST (Date 7 1 2026)
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 13 1 2026) (Date 7 1 2026) EQUALS JUST (Date 7 1 2026)
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 14 1 2026) (Date 7 1 2026) EQUALS JUST (Date 14 1 2026)
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 20 1 2026) (Date 7 1 2026) EQUALS JUST (Date 14 1 2026)
-- 3 February 2026 is 27 days after 7 January, so 6 days into its week, which began on 28 January
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 3 2 2026) (Date 7 1 2026) EQUALS JUST (Date 28 1 2026)
#ASSERT `s 171ZN(8) the first day of the week of the adoption pay period containing the day` (Date 6 1 2026) (Date 7 1 2026) EQUALS NOTHING
-- Arguments: pay is payable by virtue of s 171ZL(9); by virtue of s 171ZL(11).
#ASSERT `s 171ZN(9) the placement that the notification in subsection (2F) is read as` TRUE FALSE EQUALS JUST `placed under section 22C of the Children Act 1989`
#ASSERT `s 171ZN(9) the placement that the notification in subsection (2F) is read as` FALSE TRUE EQUALS JUST `placed under section 81 of the Social Services and Well-being (Wales) Act 2014`
#ASSERT `s 171ZN(9) the placement that the notification in subsection (2F) is read as` TRUE TRUE EQUALS NOTHING
#ASSERT `s 171ZN(9) the placement that the notification in subsection (2F) is read as` FALSE FALSE EQUALS NOTHING

