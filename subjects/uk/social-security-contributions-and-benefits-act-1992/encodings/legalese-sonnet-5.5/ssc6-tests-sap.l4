#ASSERT `s 171ZO(2) the agreement is protected from being void by virtue of subsection (1)(a)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZO(2) the agreement is protected from being void by virtue of subsection (1)(a)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZO(2) the agreement is protected from being void by virtue of subsection (1)(a)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZO(2) the agreement is protected from being void by virtue of subsection (1)(a)` FALSE TRUE TRUE EQUALS NOTHING

§§ `s 171ZP -- relationship with benefits and other payments`

-- Arguments: the day falls within the adoption pay period; the case is prescribed.
#ASSERT `s 171ZP(1) the day is treated as a day of incapacity for work` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZP(1) the day is treated as a day of incapacity for work` TRUE TRUE EQUALS NOTHING
#ASSERT `s 171ZP(1) the day is treated as a day of incapacity for work` FALSE FALSE EQUALS NOTHING
#ASSERT `s 171ZP(1) the day is treated as a day of incapacity for work` FALSE TRUE EQUALS NOTHING
#ASSERT `s 171ZP(4) the entitlement to statutory adoption pay affects his right to contractual remuneration` TRUE EQUALS JUST FALSE
#ASSERT `s 171ZP(4) the entitlement to statutory adoption pay affects his right to contractual remuneration` FALSE EQUALS NOTHING
-- Arguments: the liability to pay statutory adoption pay for the week; the contractual pay paid for the same week.
#ASSERT `s 171ZP(5)(a) the statutory adoption pay still owed for the week in pounds` 150 100 EQUALS 50
#ASSERT `s 171ZP(5)(a) the statutory adoption pay still owed for the week in pounds` 150 150 EQUALS 0
#ASSERT `s 171ZP(5)(a) the statutory adoption pay still owed for the week in pounds` 150 200 EQUALS 0
#ASSERT `s 171ZP(5)(a) the statutory adoption pay still owed for the week in pounds` 150 0 EQUALS 150
-- Arguments: the liability to pay contractual pay for the week; the statutory adoption pay paid for the same week.
#ASSERT `s 171ZP(5)(b) the contractual remuneration still owed for the week in pounds` 300 150 EQUALS 150
#ASSERT `s 171ZP(5)(b) the contractual remuneration still owed for the week in pounds` 300 400 EQUALS 0
#ASSERT `s 171ZP(5)(b) the contractual remuneration still owed for the week in pounds` 300 0 EQUALS 300

§§ `s 171ZQ, s 171ZR -- the Crown; special classes`

#ASSERT `s 171ZQ Part 12ZB applies to the person as it applies to persons employed otherwise than by or under the Crown` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZQ Part 12ZB applies to the person as it applies to persons employed otherwise than by or under the Crown` FALSE EQUALS NOTHING
-- Arguments: on a ship, vessel, hovercraft or aircraft; outside Great Britain; continental shelf operations (s 120(2)); prescribed employment.
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 171ZR(1) regulations may modify Part 12ZB in its application to the person` FALSE FALSE FALSE FALSE EQUALS NOTHING

§§ `s 171ZS -- definitions`

#ASSERT `s 171ZS(1) the Board` EQUALS `the Commissioners of Inland Revenue`

-- Arguments: s 6 answer; but for s 6(1)(b); but for being under 16; s 173(a) "under 16" answer.
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` NOTHING FALSE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE NOTHING EQUALS NOTHING
-- an answer that cannot matter does not turn the result into NOTHING
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 171ZS(1) the person is the employer in relation to the employee` NOTHING TRUE FALSE (JUST FALSE) EQUALS JUST TRUE

-- "local authority" and "local authority foster parent" are the Children Act 1989's: the answer is passed through.
#ASSERT `s 171ZS(1) the body is a local authority` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the body is a local authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZS(1) the body is a local authority` NOTHING EQUALS NOTHING
#ASSERT `s 171ZS(1) the person is a local authority foster parent` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the person is a local authority foster parent` NOTHING EQUALS NOTHING

-- "includes additions, omissions and amendments": another kind of change is not ruled out.
#ASSERT `s 171ZS(1) the change is a modification` `s 171ZS(1) an addition` EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the change is a modification` `s 171ZS(1) an omission` EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the change is a modification` `s 171ZS(1) an amendment` EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the change is a modification` `s 171ZS(1) another kind of change` EQUALS NOTHING
#ASSERT `s 171ZS(1) the thing is prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZS(1) the thing is prescribed` FALSE EQUALS JUST FALSE

§§ `s 171ZS(2), (3) -- employee`

`s 171ZS(2) test person` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Man
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 171ZS(2) test employment in Great Britain` MEANS Employment WITH
    `the employee` IS `s 171ZS(2) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

`s 171ZS(2) test employment abroad` MEANS Employment WITH
    `the employee` IS `s 171ZS(2) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS FALSE

`s 171ZS(2) test employment in an office` MEANS Employment WITH
    `the employee` IS `s 171ZS(2) test person`
    `the kind of employer` IS `the Crown`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS TRUE
    `carried on in Great Britain` IS TRUE

`s 171ZS(2) test employment neither contract nor office` MEANS Employment WITH
    `the employee` IS `s 171ZS(2) test person`
    `the kind of employer` IS `an individual`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

-- Arguments: the employment; gainfully employed; the work is in the territorial waters adjacent to Great Britain; s 172(a) answer;
-- with earnings (Parts 1 to 5); regulations say he is not to be treated as an employee; regulations say he is to be.
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in an office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in Great Britain` FALSE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in Great Britain` TRUE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment neither contract nor office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- work on the sea adjacent to Great Britain: s 172(a) decides whether that is "in Great Britain"
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` TRUE TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` TRUE TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` TRUE TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
-- when another limb already fails, the unanswered s 172(a) question changes nothing
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` FALSE TRUE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations under subsection (3)
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment abroad` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZS(2) the person is an employee` `s 171ZS(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE TRUE EQUALS NOTHING

