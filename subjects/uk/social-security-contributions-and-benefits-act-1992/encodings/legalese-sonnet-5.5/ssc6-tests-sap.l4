#ASSERT `s 171ZS(5) the first day of the week containing the day` (Date 7 1 2026) FALSE EQUALS JUST (Date 4 1 2026)
#ASSERT `s 171ZS(5) the first day of the week containing the day` (Date 10 1 2026) FALSE EQUALS JUST (Date 4 1 2026)
#ASSERT `s 171ZS(5) the first day of the week containing the day` (Date 11 1 2026) FALSE EQUALS JUST (Date 11 1 2026)
#ASSERT `s 171ZS(5) the first day of the week containing the day` (Date 7 1 2026) TRUE EQUALS NOTHING
-- Arguments: earnings paid in the relevant period; weeks in it; the case is one for which regulations require another calculation.
#ASSERT `s 171ZS(6) his normal weekly earnings in pounds` 1200 8 FALSE EQUALS JUST 150
#ASSERT `s 171ZS(6) his normal weekly earnings in pounds` 1000 8 FALSE EQUALS JUST 125
#ASSERT `s 171ZS(6) his normal weekly earnings in pounds` 0 8 FALSE EQUALS JUST 0
#ASSERT `s 171ZS(6) his normal weekly earnings in pounds` 1200 0 FALSE EQUALS NOTHING
