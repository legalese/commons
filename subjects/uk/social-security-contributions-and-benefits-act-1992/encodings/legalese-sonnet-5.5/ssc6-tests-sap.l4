#ASSERT `s 171ZO(1) the agreement is void to the extent that it purports` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZO(1) the agreement is void to the extent that it purports` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZO(1) the agreement is void to the extent that it purports` FALSE FALSE EQUALS NOTHING
