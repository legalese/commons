            `the tax year` IS `Tax year` WITH `calendar year in which it begins` IS 2000
            `lower earnings limit` IS `the lower earnings limit for the tax year in pounds a week`
            `primary threshold` IS 0
            `upper earnings limit` IS 0
            `secondary threshold` IS 0

