#ASSERT `s 171ZI(1) regulations may modify Part 12ZA in its application to the person` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 171ZI(1) regulations may modify Part 12ZA in its application to the person` FALSE FALSE FALSE FALSE EQUALS NOTHING

