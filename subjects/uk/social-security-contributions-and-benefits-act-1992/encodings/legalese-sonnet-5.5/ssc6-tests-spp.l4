#ASSERT `s 171ZJ(1) the Board` EQUALS `the Commissioners of Inland Revenue`

-- Arguments: s 6 answer; but for s 6(1)(b); but for being under 16; s 173(a) "under 16" answer.
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` NOTHING FALSE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE TRUE NOTHING EQUALS NOTHING
-- an answer that cannot matter does not turn the result into NOTHING
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` (JUST FALSE) FALSE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 171ZJ(1) the person is the employer in relation to the employee` NOTHING TRUE FALSE (JUST FALSE) EQUALS JUST TRUE

-- "local authority" and "local authority foster parent" are the Children Act 1989's: the answer is passed through.
#ASSERT `s 171ZJ(1) the body is a local authority` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the body is a local authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZJ(1) the body is a local authority` NOTHING EQUALS NOTHING
#ASSERT `s 171ZJ(1) the person is a local authority foster parent` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the person is a local authority foster parent` NOTHING EQUALS NOTHING

-- "includes additions, omissions and amendments": another kind of change is not ruled out.
#ASSERT `s 171ZJ(1) the change is a modification` `s 171ZJ(1) an addition` EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the change is a modification` `s 171ZJ(1) an omission` EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the change is a modification` `s 171ZJ(1) an amendment` EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the change is a modification` `s 171ZJ(1) another kind of change` EQUALS NOTHING
#ASSERT `s 171ZJ(1) the thing is prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZJ(1) the thing is prescribed` FALSE EQUALS JUST FALSE

§§ `s 171ZJ(2), (3) -- employee`

`s 171ZJ(2) test person` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Man
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 171ZJ(2) test employment in Great Britain` MEANS Employment WITH
    `the employee` IS `s 171ZJ(2) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

`s 171ZJ(2) test employment abroad` MEANS Employment WITH
    `the employee` IS `s 171ZJ(2) test person`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS FALSE

`s 171ZJ(2) test employment in an office` MEANS Employment WITH
    `the employee` IS `s 171ZJ(2) test person`
    `the kind of employer` IS `the Crown`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS TRUE
    `carried on in Great Britain` IS TRUE

`s 171ZJ(2) test employment neither contract nor office` MEANS Employment WITH
    `the employee` IS `s 171ZJ(2) test person`
    `the kind of employer` IS `an individual`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

-- Arguments: the employment; gainfully employed; the work is in the territorial waters adjacent to Great Britain; s 172(a) answer;
-- with earnings (Parts 1 to 5); regulations say he is not to be treated as an employee; regulations say he is to be.
-- A man can be an employee: unlike Part XII, this definition does not speak of a woman.
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in an office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in Great Britain` FALSE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in Great Britain` TRUE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment neither contract nor office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- work on the sea adjacent to Great Britain: s 172(a) decides whether that is "in Great Britain"
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` TRUE TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` TRUE TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` TRUE TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
-- when another limb already fails, the unanswered s 172(a) question changes nothing
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` FALSE TRUE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations under subsection (3)
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment abroad` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZJ(2) the person is an employee` `s 171ZJ(2) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE TRUE EQUALS NOTHING

§§ `s 171ZJ(6), (7), (8) -- normal weekly earnings`

-- Arguments: earnings paid in the relevant period; weeks in it; the case is one for which regulations require another calculation.
#ASSERT `s 171ZJ(6) his normal weekly earnings in pounds` 1200 8 FALSE EQUALS JUST 150
#ASSERT `s 171ZJ(6) his normal weekly earnings in pounds` 1000 8 FALSE EQUALS JUST 125
#ASSERT `s 171ZJ(6) his normal weekly earnings in pounds` 0 8 FALSE EQUALS JUST 0
#ASSERT `s 171ZJ(6) his normal weekly earnings in pounds` 1200 0 FALSE EQUALS NOTHING
#ASSERT `s 171ZJ(6) his normal weekly earnings in pounds` 1200 8 TRUE EQUALS NOTHING
