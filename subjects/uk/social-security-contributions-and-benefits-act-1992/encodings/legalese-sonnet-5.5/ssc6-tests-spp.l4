#ASSERT `s 171ZF(2) the agreement is protected from being void by virtue of subsection (1)(a)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZF(2) the agreement is protected from being void by virtue of subsection (1)(a)` TRUE FALSE FALSE EQUALS JUST FALSE
