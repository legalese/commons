IMPORT prelude
IMPORT daydate
IMPORT `ssc-core`
IMPORT `ssc6-spp`

-- Tests for ssc6-spp.l4 (Part 12ZA, ss 171ZA-171ZK).
-- Every expected value is written by hand from the Act's text (ukpga-1992-4.txt, lines 3385-3558),
-- beside the assertion. None is copied from what the code printed.
-- Arbitrary dates: 4 January 2026 is a Sunday; 8 November 2026 is a Sunday, 44 weeks later;
-- 3 January 2027 is a Sunday.
-- A figure regulations would supply (a weekly rate, the lower earnings limit) is arbitrary here.

§ `Tests for Part 12ZA`

§§ `Sundays`

#ASSERT (Day (Date 4 1 2026)) MODULO 7 EQUALS 0
#ASSERT (Day (Date 8 11 2026)) MODULO 7 EQUALS 0
#ASSERT (Day (Date 3 1 2027)) MODULO 7 EQUALS 0
#ASSERT NOT ((Day (Date 12 11 2026)) MODULO 7 EQUALS 0)

§§ `The helper -- three-valued AND`

#ASSERT `s 171ZA(1) all of these answers hold` (LIST) EQUALS JUST TRUE
#ASSERT `s 171ZA(1) all of these answers hold` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZA(1) all of these answers hold` (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZA(1) all of these answers hold` (LIST JUST FALSE, JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZA(1) all of these answers hold` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 171ZA(1) all of these answers hold` (LIST NOTHING, JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZA(1) all of these answers hold` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZA(1) all of these answers hold` (LIST JUST FALSE, NOTHING) EQUALS JUST FALSE

§§ `Weeks`

-- Arguments: the day; regulations prescribe another period for the case.
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 4 1 2026) FALSE EQUALS JUST (Date 4 1 2026)
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 7 1 2026) FALSE EQUALS JUST (Date 4 1 2026)
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 10 1 2026) FALSE EQUALS JUST (Date 4 1 2026)
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 11 1 2026) FALSE EQUALS JUST (Date 11 1 2026)
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 1 1 2026) FALSE EQUALS JUST (Date 28 12 2025)
#ASSERT `s 171ZJ(5) the first day of the week containing the day` (Date 7 1 2026) TRUE EQUALS NOTHING
#ASSERT `s 171ZJ(5) the week convention of Part 12ZA` EQUALS `a period of 7 days beginning with Sunday or another prescribed period`
#ASSERT `s 171ZE(11) the week convention of section 171ZE` EQUALS `any period of 7 days`
#ASSERT `s 171ZA(2)(b) the number of weeks of continuous employment required` EQUALS 26

§§ `s 171ZA(2)(a) -- the prescribed relationship conditions`

-- Arguments: relationship with a newborn child; relationship with the child's mother.
#ASSERT `s 171ZA(2)(a) he satisfies prescribed conditions as to relationship with a newborn child and with the child's mother` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(a) he satisfies prescribed conditions as to relationship with a newborn child and with the child's mother` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZA(2)(a) he satisfies prescribed conditions as to relationship with a newborn child and with the child's mother` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 171ZA(2)(a) he satisfies prescribed conditions as to relationship with a newborn child and with the child's mother` FALSE FALSE EQUALS JUST FALSE

§§ `s 171ZA(2)(b), (c), (d) -- service, earnings, staying in employment`

-- Arguments: the service (weeks, normal weekly earnings, last day of the relevant week); employed earner's employment.
#ASSERT `s 171ZA(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 26, 150, Date 1 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 25, 150, Date 1 8 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171ZA(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 52, 150, Date 1 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 52, 150, Date 1 8 2026) FALSE EQUALS JUST FALSE
-- Arguments: the service; the lower earnings limit (arbitrary here: 123).
#ASSERT `s 171ZA(2)(c) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 123, Date 1 8 2026) 123 EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(c) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 122.99, Date 1 8 2026) 123 EQUALS JUST FALSE
#ASSERT `s 171ZA(2)(c) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 500, Date 1 8 2026) 123 EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(d) he has been in employed earner's employment with that employer from the end of the relevant week to the day the child is born` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZA(2)(d) he has been in employed earner's employment with that employer from the end of the relevant week to the day the child is born` FALSE EQUALS JUST FALSE

§§ `s 171ZA(2), (1) -- the conditions and the entitlement`

-- Arguments: conditions (a), (b), (c), (d).
#ASSERT `s 171ZA(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZA(2) the conditions are satisfied` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZA(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZA(2) the conditions are satisfied` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZA(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 171ZA(2) the conditions are satisfied` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171ZA(1) he is entitled to statutory paternity pay on a birth` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZA(1) he is entitled to statutory paternity pay on a birth` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZA(1) he is entitled to statutory paternity pay on a birth` NOTHING EQUALS NOTHING

§§ `s 171ZA(3) -- the relevant week (seam S30)`

-- The expected week of the child's birth begins Sunday 8 November 2026. The 14th week before it begins 98 days earlier,
-- on Sunday 2 August 2026; the week immediately preceding that runs Sunday 26 July to Saturday 1 August 2026.
-- Arguments: a day in the expected week; regulations prescribe another period.
#ASSERT `s 171ZA(2) the relevant week` (Date 12 11 2026) FALSE EQUALS JUST (Period WITH `the first day` IS Date 26 7 2026, `the last day` IS Date 1 8 2026)
#ASSERT `s 171ZA(2) the relevant week` (Date 8 11 2026) FALSE EQUALS JUST (Period WITH `the first day` IS Date 26 7 2026, `the last day` IS Date 1 8 2026)
#ASSERT `s 171ZA(2) the relevant week` (Date 14 11 2026) FALSE EQUALS JUST (Period WITH `the first day` IS Date 26 7 2026, `the last day` IS Date 1 8 2026)
-- the next day starts a new expected week, and the relevant week moves a week with it
#ASSERT `s 171ZA(2) the relevant week` (Date 15 11 2026) FALSE EQUALS JUST (Period WITH `the first day` IS Date 2 8 2026, `the last day` IS Date 8 8 2026)
-- an expected week beginning Sunday 3 January 2027: 105 days earlier is Sunday 20 September 2026, 99 days earlier is Saturday 26 September 2026
#ASSERT `s 171ZA(2) the relevant week` (Date 5 1 2027) FALSE EQUALS JUST (Period WITH `the first day` IS Date 20 9 2026, `the last day` IS Date 26 9 2026)
#ASSERT `s 171ZA(2) the relevant week` (Date 12 11 2026) TRUE EQUALS NOTHING

§§ `s 171ZA(4), (5) -- more than one child; stillbirth`

#ASSERT `s 171ZA(4) the entitlement is affected by the birth, or expected birth, of more than one child` TRUE EQUALS JUST FALSE
#ASSERT `s 171ZA(4) the entitlement is affected by the birth, or expected birth, of more than one child` FALSE EQUALS NOTHING
-- "stillborn after twenty-four weeks of pregnancy": more than 24. The word is "includes", so the others are NOTHING.
#ASSERT `s 171ZA(5) a child stillborn counts as a newborn child` 25 EQUALS JUST TRUE
#ASSERT `s 171ZA(5) a child stillborn counts as a newborn child` 24.5 EQUALS JUST TRUE
#ASSERT `s 171ZA(5) a child stillborn counts as a newborn child` 36 EQUALS JUST TRUE
#ASSERT `s 171ZA(5) a child stillborn counts as a newborn child` 24 EQUALS NOTHING
#ASSERT `s 171ZA(5) a child stillborn counts as a newborn child` 23 EQUALS NOTHING

§§ `s 171ZB(2) -- the adoption conditions`

-- Arguments: relationship with the child placed; relationship with the person with whom the child is placed.
#ASSERT `s 171ZB(2)(a) he satisfies prescribed conditions as to relationship with the child and with the person with whom the child is placed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(a) he satisfies prescribed conditions as to relationship with the child and with the person with whom the child is placed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171ZB(2)(a) he satisfies prescribed conditions as to relationship with the child and with the person with whom the child is placed` FALSE TRUE EQUALS JUST FALSE
-- Arguments: the service; employed earner's employment.
#ASSERT `s 171ZB(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 26, 150, Date 1 8 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 25, 150, Date 1 8 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171ZB(2)(b) he has been in employed earner's employment with an employer for a continuous period of at least 26 weeks ending with the relevant week` (`Service for statutory pay` OF 40, 150, Date 1 8 2026) FALSE EQUALS JUST FALSE
-- Arguments: the service; the lower earnings limit (arbitrary here: 123).
#ASSERT `s 171ZB(2)(c) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 123, Date 1 8 2026) 123 EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(c) his normal weekly earnings are not less than the lower earnings limit at the end of the relevant week` (`Service for statutory pay` OF 30, 122.99, Date 1 8 2026) 123 EQUALS JUST FALSE
#ASSERT `s 171ZB(2)(d) he has been in employed earner's employment with that employer from the end of the relevant week to the day the child is placed` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(d) he has been in employed earner's employment with that employer from the end of the relevant week to the day the child is placed` FALSE EQUALS JUST FALSE
-- (e): the election binds only a person with whom the child is placed. Arguments: the relationship; he has elected.
#ASSERT `s 171ZB(2)(e) where he is a person with whom the child is placed, he has elected to receive statutory paternity pay` `s 171ZB the person with whom the child is placed` TRUE EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(e) where he is a person with whom the child is placed, he has elected to receive statutory paternity pay` `s 171ZB the person with whom the child is placed` FALSE EQUALS JUST FALSE
#ASSERT `s 171ZB(2)(e) where he is a person with whom the child is placed, he has elected to receive statutory paternity pay` `s 171ZB the partner of the person with whom the child is placed` FALSE EQUALS JUST TRUE
#ASSERT `s 171ZB(2)(e) where he is a person with whom the child is placed, he has elected to receive statutory paternity pay` `s 171ZB the partner of the person with whom the child is placed` TRUE EQUALS JUST TRUE
-- Arguments: conditions (a), (b), (c), (d), (e).
#ASSERT `s 171ZB(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZB(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZB(2) the conditions are satisfied` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 171ZB(2) the conditions are satisfied` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZB(1) he is entitled to statutory paternity pay on an adoption` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171ZB(1) he is entitled to statutory paternity pay on an adoption` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171ZB(1) he is entitled to statutory paternity pay on an adoption` NOTHING EQUALS NOTHING

§§ `s 171ZB(3) -- the relevant week for an adoption (seam S30)`

-- Arguments: kind, the day he was notified of the match, the day the child was or is expected to be placed.
`s 171ZB(3) test placement notified Wednesday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 11 11 2026, Date 20 11 2026
`s 171ZB(3) test placement notified Sunday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 8 11 2026, Date 20 11 2026
`s 171ZB(3) test placement notified Saturday` MEANS Placement OF `placed for adoption under the law of a part of the United Kingdom`, Date 14 11 2026, Date 20 11 2026
`s 171ZB(3) test placement under section 22C` MEANS Placement OF `placed under section 22C of the Children Act 1989`, Date 15 11 2026, Date 20 11 2026

-- Arguments: the placement; regulations prescribe another period.
#ASSERT `s 171ZB(2) the relevant week` `s 171ZB(3) test placement notified Wednesday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
#ASSERT `s 171ZB(2) the relevant week` `s 171ZB(3) test placement notified Sunday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
#ASSERT `s 171ZB(2) the relevant week` `s 171ZB(3) test placement notified Saturday` FALSE EQUALS JUST (Period WITH `the first day` IS Date 8 11 2026, `the last day` IS Date 14 11 2026)
-- subsection (8)(b): the same week, counted from the day the prospective adopter is notified
#ASSERT `s 171ZB(2) the relevant week` `s 171ZB(3) test placement under section 22C` FALSE EQUALS JUST (Period WITH `the first day` IS Date 15 11 2026, `the last day` IS Date 21 11 2026)
#ASSERT `s 171ZB(2) the relevant week` `s 171ZB(3) test placement notified Wednesday` TRUE EQUALS NOTHING

