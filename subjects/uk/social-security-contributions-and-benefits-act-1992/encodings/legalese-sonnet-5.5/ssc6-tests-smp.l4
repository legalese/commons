#ASSERT `s 170(1) regulations may modify Part XII in its application to her` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 170(1) regulations may modify Part XII in its application to her` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 170(1) regulations may modify Part XII in its application to her` FALSE FALSE FALSE FALSE EQUALS NOTHING

§§ `s 171(1) -- "confinement"`

-- Arguments: the labour (weeks of pregnancy when it began; whether it issued a living child; the day of the issue);
-- whether it issued a child, alive or dead.
-- limb 1: labour resulting in the issue of a living child, at any stage of pregnancy
#ASSERT `s 171(1) she is confined` (Labour OF 40, TRUE, Date 10 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) she is confined` (Labour OF 20, TRUE, Date 10 3 2026) TRUE EQUALS JUST TRUE
-- limb 2: labour after 24 weeks of pregnancy resulting in the issue of a child, alive or dead
#ASSERT `s 171(1) she is confined` (Labour OF 30, FALSE, Date 10 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) she is confined` (Labour OF 25, FALSE, Date 10 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) she is confined` (Labour OF 24.5, FALSE, Date 10 3 2026) TRUE EQUALS JUST TRUE
-- "after 24 weeks": labour that began at 24 weeks is not after them (fork F-24, reading A)
#ASSERT `s 171(1) she is confined` (Labour OF 24, FALSE, Date 10 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171(1) she is confined` (Labour OF 20, FALSE, Date 10 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171(1) she is confined` (Labour OF 30, FALSE, Date 10 3 2026) FALSE EQUALS JUST FALSE
-- the day she is confined: the day of the issue of the child, or of the last of twins or more
#ASSERT `s 171(1) the day on which she is confined` (Labour OF 40, TRUE, Date 11 3 2026) TRUE EQUALS JUST (Date 11 3 2026)
#ASSERT `s 171(1) the day on which she is confined` (Labour OF 20, FALSE, Date 11 3 2026) TRUE EQUALS NOTHING
-- "otherwise than by confinement": the pregnancy ended, and not by a confinement
#ASSERT `s 171(1) the pregnancy terminated otherwise than by confinement` TRUE (Labour OF 20, FALSE, Date 11 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) the pregnancy terminated otherwise than by confinement` TRUE (Labour OF 40, TRUE, Date 11 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171(1) the pregnancy terminated otherwise than by confinement` TRUE (Labour OF 30, FALSE, Date 11 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 171(1) the pregnancy terminated otherwise than by confinement` FALSE (Labour OF 40, TRUE, Date 11 3 2026) TRUE EQUALS NOTHING
-- "dismissed" is read as Part X of the Employment Rights Act 1996 reads it: a fact asked as an input
#ASSERT `s 171(1) she was dismissed` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171(1) she was dismissed` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171(1) she was dismissed` NOTHING EQUALS NOTHING

§§ `s 171(1) -- "employee"`

-- A woman employed by a company under a contract of service, in Great Britain.
`s 171(1) test person woman` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Woman
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 171(1) test person man` MEANS Person WITH
    `date of birth` IS Date 1 1 1990
    `sex` IS Man
    `marital status` IS `neither married nor in a civil partnership`
    `date of attaining pensionable age` IS Date 1 1 2057

`s 171(1) test employment in Great Britain` MEANS Employment WITH
    `the employee` IS `s 171(1) test person woman`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

`s 171(1) test employment of a man` MEANS Employment WITH
    `the employee` IS `s 171(1) test person man`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

`s 171(1) test employment abroad` MEANS Employment WITH
    `the employee` IS `s 171(1) test person woman`
    `the kind of employer` IS `a company or other body corporate`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS TRUE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS FALSE

`s 171(1) test employment in an office` MEANS Employment WITH
    `the employee` IS `s 171(1) test person woman`
    `the kind of employer` IS `the Crown`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS TRUE
    `carried on in Great Britain` IS TRUE

`s 171(1) test employment neither contract nor office` MEANS Employment WITH
    `the employee` IS `s 171(1) test person woman`
    `the kind of employer` IS `an individual`
    `the employment began on` IS Date 1 1 2020
    `the employment ended on` IS NOTHING
    `held under a contract of service` IS FALSE
    `held in an office` IS FALSE
    `carried on in Great Britain` IS TRUE

-- Arguments: the employment; gainfully employed; the work is in the territorial waters adjacent to Great Britain; s 172(a) answer;
-- with earnings (Parts 1 to 5); regulations (with HMRC concurrence) say she is not an employee; regulations say she is one.
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in Great Britain` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in an office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment of a man` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in Great Britain` FALSE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in Great Britain` TRUE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment neither contract nor office` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- abroad: the field says the work is not in Great Britain
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` TRUE FALSE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- work on the sea adjacent to Great Britain: s 172(a) decides whether that is "in Great Britain"
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` TRUE TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` TRUE TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` TRUE TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
-- when another limb already fails, the unanswered s 172(a) question changes nothing
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` FALSE TRUE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
-- regulations
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment abroad` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment of a man` FALSE FALSE NOTHING FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 171(1) she is an employee` `s 171(1) test employment in Great Britain` TRUE FALSE NOTHING TRUE TRUE TRUE EQUALS NOTHING

§§ `s 171(1) -- "employer", "maternity pay period", "modifications", "prescribed"`

-- Arguments: s 6 answer; but for s 6(1)(b); but for being under 16; s 173(a) "under 16" answer.
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST FALSE) TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST FALSE) FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST FALSE) FALSE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 171(1) the person is the employer in relation to her` NOTHING FALSE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 171(1) the person is the employer in relation to her` NOTHING TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 171(1) the person is the employer in relation to her` (JUST FALSE) FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 171(1) the maternity pay period` (Date 1 1 2026) 39 EQUALS JUST (Period WITH `the first day` IS Date 1 1 2026, `the last day` IS Date 30 9 2026)
#ASSERT `s 171(1) the maternity pay period` (Date 1 1 2026) 60 EQUALS NOTHING
#ASSERT `s 171(1) the change is a modification` `s 171(1) an addition` EQUALS JUST TRUE
#ASSERT `s 171(1) the change is a modification` `s 171(1) an omission` EQUALS JUST TRUE
#ASSERT `s 171(1) the change is a modification` `s 171(1) an amendment` EQUALS JUST TRUE
#ASSERT `s 171(1) the change is a modification` `s 171(1) another kind of change` EQUALS NOTHING
#ASSERT `s 171(1) the thing is prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 171(1) the thing is prescribed` FALSE EQUALS JUST FALSE

§§ `s 171(4) to (6) -- normal weekly earnings`

-- 1,200 earned over an 8-week relevant period is an average of 150 a week.
#ASSERT `s 171(4) her normal weekly earnings in pounds` 1200 8 FALSE EQUALS JUST 150
#ASSERT `s 171(4) her normal weekly earnings in pounds` 1200 5 FALSE EQUALS JUST 240
#ASSERT `s 171(4) her normal weekly earnings in pounds` 0 8 FALSE EQUALS JUST 0
#ASSERT `s 171(4) her normal weekly earnings in pounds` 1200 8 TRUE EQUALS NOTHING
#ASSERT `s 171(4) her normal weekly earnings in pounds` 1200 0 FALSE EQUALS NOTHING
