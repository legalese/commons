#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST TRUE) 50 EQUALS JUST 65
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST TRUE) 46 EQUALS JUST 37
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST TRUE) 45 EQUALS JUST 30
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST TRUE) 44 EQUALS JUST 30
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST TRUE) 20 EQUALS JUST 30
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 (JUST FALSE) 54 EQUALS JUST 100
#ASSERT `s 48BB(8) the weekly rate after the reduction in pounds` 100 NOTHING 54 EQUALS NOTHING
-- (5): the rate corresponds to the additional pension determined as for a Category A retirement pension.
#ASSERT `s 48BB(5) the weekly rate of the Category B retirement pension before the adjustments in pounds` (JUST 20) EQUALS JUST 20
#ASSERT `s 48BB(5) the weekly rate of the Category B retirement pension before the adjustments in pounds` NOTHING EQUALS NOTHING
-- (10): increased by the orders' overall percentage. 80 x (1 + 5/100) = 84.
#ASSERT `s 48BB(10) the weekly rate after the increase in pounds` 80 (JUST 5) EQUALS JUST 84
#ASSERT `s 48BB(10) the weekly rate after the increase in pounds` 80 (JUST 0) EQUALS JUST 80
#ASSERT `s 48BB(10) the weekly rate after the increase in pounds` 80 NOTHING EQUALS NOTHING

§ `Section 48C: Category B retirement pension: general`

-- (1): entitlement begins on the day the conditions are satisfied and continues for life.
#ASSERT `s 48C(1) the entitlement to a Category B retirement pension is running on the day` (Date 1 1 2020) (Date 31 12 2019) NOTHING EQUALS NOTHING
#ASSERT `s 48C(1) the entitlement to a Category B retirement pension is running on the day` (Date 1 1 2020) (Date 1 1 2020) NOTHING EQUALS JUST TRUE
#ASSERT `s 48C(1) the entitlement to a Category B retirement pension is running on the day` (Date 1 1 2020) (Date 1 1 2030) NOTHING EQUALS JUST TRUE
#ASSERT `s 48C(1) the entitlement to a Category B retirement pension is running on the day` (Date 1 1 2020) (Date 1 1 2025) (JUST (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT `s 48C(1) the entitlement to a Category B retirement pension is running on the day` (Date 1 1 2020) (Date 2 1 2025) (JUST (Date 1 1 2025)) EQUALS NOTHING
-- (2): section 47(1) applies also to the Category B pension when both pensions would be payable apart from section 43(1) and section 47(1) applies to the Category A pension.
#ASSERT `s 48C(2) section 47(1) applies also for the increase of the Category B retirement pension` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48C(2) section 47(1) applies also for the increase of the Category B retirement pension` TRUE FALSE EQUALS NOTHING
#ASSERT `s 48C(2) section 47(1) applies also for the increase of the Category B retirement pension` FALSE TRUE EQUALS NOTHING
-- (3): "half of" is omitted where the spouse died on or before 5 October 2002.
#ASSERT `s 48C(3) the words "half of" are omitted from section 48B(2)(b)` (Date 5 10 2002)
#ASSERT `s 48C(3) the words "half of" are omitted from section 48B(2)(b)` (Date 1 1 1999)
#ASSERT (NOT (`s 48C(3) the words "half of" are omitted from section 48B(2)(b)` (Date 6 10 2002)))
-- (4): the pensioner is read as the spouse or civil partner in the provisions applied by section 48B(2) or 48BB(5).
#ASSERT `s 48C(4) the person to whom a reference to the pensioner is taken to refer` (`a woman who attained pensionable age on 1 January 2013`) (`a man who attained pensionable age on 1 January 2013`) TRUE EQUALS JUST (`a man who attained pensionable age on 1 January 2013`)
#ASSERT `s 48C(4) the person to whom a reference to the pensioner is taken to refer` (`a woman who attained pensionable age on 1 January 2013`) (`a man who attained pensionable age on 1 January 2013`) FALSE EQUALS NOTHING
