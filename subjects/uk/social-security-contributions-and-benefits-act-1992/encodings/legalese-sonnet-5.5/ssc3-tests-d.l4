#ASSERT `s 48BB(4) the pensioner is entitled to a Category B retirement pension by virtue of the contributions of the spouse or civil partner` (`a woman who attained pensionable age on 1 January 2013`) FALSE TRUE NOTHING FALSE TRUE EQUALS NOTHING
#ASSERT `s 48BB(4) the pensioner is entitled to a Category B retirement pension by virtue of the contributions of the spouse or civil partner` (`a woman who attained pensionable age on 1 January 2013`) FALSE FALSE NOTHING FALSE TRUE EQUALS JUST FALSE
