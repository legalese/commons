§ `Tests -- s 30C(6): training for work`

-- training begins 1 June 2025; the 56 days before it start on 6 April 2025; entitlement last on 20 May 2025.
-- arguments: first day of training, last day of entitlement, first day after the training ended, that first day is a day of incapacity, the training day
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) TRUE (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) TRUE (Date 1 6 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) TRUE (Date 31 5 2025) EQUALS NOTHING
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) TRUE (Date 31 8 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) TRUE (Date 1 9 2025) EQUALS NOTHING
-- the 56 days: entitled on 6 April 2025 is within them, on 5 April 2025 is not
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 6 4 2025)) (Date 1 9 2025) TRUE (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 5 4 2025)) (Date 1 9 2025) TRUE (Date 10 6 2025) EQUALS NOTHING
-- entitled on the day before the training began is within the 56 days; entitled on the first day of training is not "before"
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 31 5 2025)) (Date 1 9 2025) TRUE (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 1 6 2025)) (Date 1 9 2025) TRUE (Date 10 6 2025) EQUALS NOTHING
-- (c): the first day after training must fall within the two years beginning with 20 May 2025, which end on 19 May 2027
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 19 5 2027) TRUE (Date 10 6 2025) EQUALS JUST TRUE
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 20 5 2027) TRUE (Date 10 6 2025) EQUALS NOTHING
#ASSERT `s 30C(6) the training day is treated as a day of incapacity for work` (Date 1 6 2025) (JUST (Date 20 5 2025)) (Date 1 9 2025) FALSE (Date 10 6 2025) EQUALS NOTHING
