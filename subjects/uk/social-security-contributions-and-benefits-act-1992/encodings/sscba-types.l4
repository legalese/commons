IMPORT prelude
IMPORT daydate

-- Social Security Contributions and Benefits Act 1992 (UK) — THE NOUNS.
-- Source: ../registers/source-bundle/ukpga-1992-4.txt (point in time
-- 8 July 2026). No rules here.

§ `Nouns`

DECLARE `Week of earnings` HAS
    `earnings`                                          IS A NUMBER
    -- s 5(1): the limits and thresholds for the tax year (weekly, or the
    -- prescribed equivalent).
    `primary threshold`                                 IS A NUMBER
    `upper earnings limit`                              IS A NUMBER
    `secondary threshold`                               IS A NUMBER
    -- s 9(1A): the relevant percentage (15%, or the age-related or 0%
    -- percentage, whose table is lost in conversion).
    `secondary percentage`                              IS A NUMBER

DECLARE `Sick pay facts` HAS
    `normal weekly earnings`                            IS A NUMBER
    -- s 157(3): qualifying days in the week (beginning with Sunday).
    `qualifying days in the week`                       IS A NUMBER
    -- s 152(3): the last day of the earlier period of incapacity, and the
    -- first day of the later one; NOTHING if there is only one.
    `earlier period ended on`                           IS A MAYBE DATE
    `later period began on`                             IS A DATE

DECLARE `Maternity facts` HAS
    `expected date of confinement`                      IS A DATE
    `employment began on`                               IS A DATE
    `still employed in the 15th week before`            IS A BOOLEAN
    `normal weekly earnings`                            IS A NUMBER
    `lower earnings limit`                              IS A NUMBER
    `the date in question`                              IS A DATE
    `confined before the 11th week`                     IS A BOOLEAN
    -- s 166(1)(b): the prescribed weekly rate.
    `prescribed weekly rate`                            IS A NUMBER
