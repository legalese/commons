IMPORT prelude
IMPORT daydate
IMPORT `sscba-types`
IMPORT `sscba-rules`
IMPORT `sscba-goal`

-- Independent tests: SSCBA 1992 ss 8-9, 152, 155, 157, 164-166, 171(1A).
-- Expected values were fixed in independent-expectations.md from the Act
-- and the brief, before the encoding was read. A failing assertion is a
-- finding; no expected value was changed to match the code.

§ `Helpers`

GIVEN xe IS A NUMBER, xpt IS A NUMBER, xuel IS A NUMBER, xst IS A NUMBER, xpc IS A NUMBER
GIVETH A `Week of earnings`
mkW xe xpt xuel xst xpc MEANS `Week of earnings` OF xe, xpt, xuel, xst, xpc

-- Standard thresholds: PT 242, UEL 967, ST 96, 15%.
GIVEN xe IS A NUMBER
GIVETH A `Week of earnings`
std xe MEANS mkW xe 242 967 96 15

GIVEN xe IS A NUMBER
GIVETH A NUMBER
prim xe MEANS `the primary Class 1 contribution on` (std xe)

GIVEN xe IS A NUMBER
GIVETH A NUMBER
sec xe MEANS `the secondary Class 1 contribution on` (std xe)

GIVEN xn IS A NUMBER, xq IS A NUMBER, xend IS A MAYBE DATE, xbeg IS A DATE
GIVETH A `Sick pay facts`
mkS xn xq xend xbeg MEANS `Sick pay facts` OF xn, xq, xend, xbeg

GIVEN xn IS A NUMBER, xq IS A NUMBER
GIVETH A `Sick pay facts`
sick xn xq MEANS mkS xn xq NOTHING (Date 1 3 2027)

GIVEN xend IS A DATE, xbeg IS A DATE
GIVETH A BOOLEAN
links xend xbeg MEANS `the periods of incapacity link for` (mkS 200 5 (JUST xend) xbeg)

GIVEN xedc IS A DATE, xbeg IS A DATE, xstill IS A BOOLEAN, xn IS A NUMBER, xlel IS A NUMBER, xq IS A DATE, xconf IS A BOOLEAN, xr IS A NUMBER
GIVETH A `Maternity facts`
mkM xedc xbeg xstill xn xlel xq xconf xr MEANS `Maternity facts` OF xedc, xbeg, xstill, xn, xlel, xq, xconf, xr

-- Baseline: expected Wed 6 Jan 2027, employed from 1 Jan 2025, NWE 300,
-- LEL 129, question date 1 Nov 2026, not confined, prescribed 194.32.
GIVEN xedc IS A DATE
GIVETH A `Maternity facts`
mat xedc MEANS mkM xedc (Date 1 1 2025) TRUE 300 129 (Date 1 11 2026) FALSE 194.32

GIVEN xedc IS A DATE
GIVETH A DATE
ewc xedc MEANS `the expected week of confinement begins for` (mat xedc)

GIVEN xbeg IS A DATE
GIVETH A BOOLEAN
smpEmp xbeg MEANS `is entitled to statutory maternity pay` (mkM (Date 6 1 2027) xbeg TRUE 300 129 (Date 1 11 2026) FALSE 194.32)

GIVEN xn IS A NUMBER
GIVETH A BOOLEAN
smpNwe xn MEANS `is entitled to statutory maternity pay` (mkM (Date 6 1 2027) (Date 1 1 2025) TRUE xn 129 (Date 1 11 2026) FALSE 194.32)

GIVEN xq IS A DATE, xconf IS A BOOLEAN
GIVETH A BOOLEAN
smpQ xq xconf MEANS `is entitled to statutory maternity pay` (mkM (Date 6 1 2027) (Date 1 1 2025) TRUE 300 129 xq xconf 194.32)

GIVEN xedc IS A DATE, xbeg IS A DATE, xq IS A DATE
GIVETH A BOOLEAN
smpE xedc xbeg xq MEANS `is entitled to statutory maternity pay` (mkM xedc xbeg TRUE 300 129 xq FALSE 194.32)

GIVEN xn IS A NUMBER
GIVETH A NUMBER
first6 xn MEANS `the first 6 weeks' rate for` (mkM (Date 6 1 2027) (Date 1 1 2025) TRUE xn 129 (Date 1 11 2026) FALSE 194.32)

GIVEN xn IS A NUMBER
GIVETH A NUMBER
later xn MEANS `the later weeks' rate for` (mkM (Date 6 1 2027) (Date 1 1 2025) TRUE xn 129 (Date 1 11 2026) FALSE 194.32)

§ `A. Class 1 contributions (ss 8-9)`

-- A1-A3: nothing exceeds a threshold
#ASSERT prim 0 EQUALS 0
#ASSERT sec 0 EQUALS 0
#ASSERT prim 50 EQUALS 0
#ASSERT sec 50 EQUALS 0
#ASSERT sec 96 EQUALS 0
-- A4
#ASSERT prim 200 EQUALS 0
#ASSERT sec 200 EQUALS 15.6
-- A5: exactly the primary threshold
#ASSERT prim 242 EQUALS 0
#ASSERT sec 242 EQUALS 21.9
-- A6
#ASSERT prim 243 EQUALS 0.08
#ASSERT sec 243 EQUALS 22.05
-- A7
#ASSERT prim 500 EQUALS 20.64
#ASSERT sec 500 EQUALS 60.6
-- A8: exactly the UEL
#ASSERT prim 967 EQUALS 58
#ASSERT sec 967 EQUALS 130.65
-- A9
#ASSERT prim 968 EQUALS 58.02
#ASSERT sec 968 EQUALS 130.8
-- A10
#ASSERT prim 1000 EQUALS 58.66
#ASSERT sec 1000 EQUALS 135.6
-- A11
#ASSERT prim 2000 EQUALS 78.66
#ASSERT sec 2000 EQUALS 285.6
-- A12: 0% secondary percentage
#ASSERT `the secondary Class 1 contribution on` (mkW 1000 242 967 96 0) EQUALS 0
-- A13: 13.8%
#ASSERT `the secondary Class 1 contribution on` (mkW 500 242 967 96 13.8) EQUALS 55.752
-- A14: equal thresholds
#ASSERT `the primary Class 1 contribution on` (mkW 300 242 967 242 15) EQUALS 4.64
#ASSERT `the secondary Class 1 contribution on` (mkW 300 242 967 242 15) EQUALS 8.7
-- A15: monthly prescribed equivalents
#ASSERT `the primary Class 1 contribution on` (mkW 5000 1048 4189 175 15) EQUALS 267.5

§ `B. Statutory sick pay (ss 152, 155, 157)`

-- B1-B6: weekly rate
#ASSERT `the weekly rate of statutory sick pay for` (sick 200 5) EQUALS 123.25
#ASSERT `the weekly rate of statutory sick pay for` (sick 154.0625 5) EQUALS 123.25
#ASSERT `the weekly rate of statutory sick pay for` (sick 154.0626 5) EQUALS 123.25
#ASSERT `the weekly rate of statutory sick pay for` (sick 154 5) EQUALS 123.2
#ASSERT `the weekly rate of statutory sick pay for` (sick 100 5) EQUALS 80
#ASSERT `the weekly rate of statutory sick pay for` (sick 0 5) EQUALS 0
-- B7-B12: daily amount
#ASSERT `the statutory sick pay for a day for` (sick 200 5) EQUALS 24.65
#ASSERT `the statutory sick pay for a day for` (sick 200 7) EQUALS 123.25 DIVIDED BY 7
#ASSERT `the statutory sick pay for a day for` (sick 200 3) EQUALS 123.25 DIVIDED BY 3
#ASSERT `the statutory sick pay for a day for` (sick 200 1) EQUALS 123.25
#ASSERT `the statutory sick pay for a day for` (sick 100 4) EQUALS 20
#ASSERT `the statutory sick pay for a day for` (sick 154 6) EQUALS 123.2 DIVIDED BY 6
-- B13-B15: entitlement limit
#ASSERT `the entitlement limit for` (sick 200 5) EQUALS 3451
#ASSERT `the entitlement limit for` (sick 100 5) EQUALS 2240
#ASSERT `the entitlement limit for` (sick 154 5) EQUALS 3449.6
-- B16-B20: linking (days between the periods at most 56)
#ASSERT links (Date 1 3 2027) (Date 27 4 2027)
#ASSERT NOT (links (Date 1 3 2027) (Date 28 4 2027))
#ASSERT links (Date 1 3 2027) (Date 2 3 2027)
#ASSERT links (Date 1 3 2027) (Date 8 3 2027)
#ASSERT NOT (links (Date 1 3 2027) (Date 1 11 2027))

§ `C. Statutory maternity pay (ss 164-166, 171(1A))`

-- C1-C8: the expected week of confinement begins on Sunday
#ASSERT ewc (Date 3 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 4 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 6 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 8 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 9 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 10 1 2027) EQUALS Date 10 1 2027
#ASSERT ewc (Date 5 1 2027) EQUALS Date 3 1 2027
#ASSERT ewc (Date 7 1 2027) EQUALS Date 3 1 2027
-- Nth week before (EWC 3 Jan 2027)
#ASSERT `the start of week` 11 `before the expected week for` (mat (Date 6 1 2027)) EQUALS Date 18 10 2026
#ASSERT `the start of week` 14 `before the expected week for` (mat (Date 6 1 2027)) EQUALS Date 27 9 2026
#ASSERT `the start of week` 15 `before the expected week for` (mat (Date 6 1 2027)) EQUALS Date 20 9 2026
#ASSERT `the start of week` 15 `before the expected week for` (mat (Date 11 1 2027)) EQUALS Date 27 9 2026
-- s 165(2): earliest start
#ASSERT `the earliest start of the maternity pay period for` (mat (Date 6 1 2027)) EQUALS Date 18 10 2026
#ASSERT `the earliest start of the maternity pay period for` (mat (Date 9 1 2027)) EQUALS Date 18 10 2026
#ASSERT `the earliest start of the maternity pay period for` (mat (Date 10 1 2027)) EQUALS Date 25 10 2026
-- C9 baseline
#ASSERT `is entitled to statutory maternity pay` (mat (Date 6 1 2027))
-- C10-C12: 26-week employment edge (EWC - 280 = Sun 29 Mar 2026)
#ASSERT smpEmp (Date 29 3 2026)
#ASSERT NOT (smpEmp (Date 30 3 2026))
#ASSERT smpEmp (Date 28 3 2026)
-- C13-C14: LEL edge
#ASSERT smpNwe 129
#ASSERT NOT (smpNwe 128.99)
-- C15-C18: reaching the 11th week (begins Sun 18 Oct 2026)
#ASSERT smpQ (Date 18 10 2026) FALSE
#ASSERT NOT (smpQ (Date 17 10 2026) FALSE)
#ASSERT smpQ (Date 10 10 2026) TRUE
#ASSERT smpQ (Date 17 10 2026) TRUE
-- C19-C22
#ASSERT smpE (Date 10 1 2027) (Date 5 4 2026) (Date 1 11 2026)
#ASSERT NOT (smpE (Date 10 1 2027) (Date 6 4 2026) (Date 1 11 2026))
#ASSERT NOT (smpE (Date 9 1 2027) (Date 5 4 2026) (Date 1 11 2026))
#ASSERT NOT (smpE (Date 10 1 2027) (Date 1 1 2025) (Date 24 10 2026))
-- C23-C28: rates
#ASSERT first6 300 EQUALS 270
#ASSERT later 300 EQUALS 194.32
#ASSERT first6 200 EQUALS 180
#ASSERT later 200 EQUALS 180
#ASSERT first6 215.91 EQUALS 194.319
#ASSERT later 215.91 EQUALS 194.319
#ASSERT first6 1000 EQUALS 900
#ASSERT later 1000 EQUALS 194.32
#ASSERT first6 129 EQUALS 116.1
#ASSERT later 129 EQUALS 116.1

§ `D. The top-level goal`

GIVETH AN `Employee position`
`position one` MEANS `the employee position for` (`Employee case` OF (JUST (std 1000)), (JUST (sick 200 5)), (JUST (mat (Date 6 1 2027))))

GIVETH AN `Employee position`
`position two` MEANS `the employee position for` (`Employee case` OF NOTHING, NOTHING, (JUST (mkM (Date 6 1 2027) (Date 30 3 2026) TRUE 300 129 (Date 1 11 2026) FALSE 194.32)))

#ASSERT `position one`'s `primary Class 1 contribution` EQUALS JUST 58.66
#ASSERT `position one`'s `secondary Class 1 contribution` EQUALS JUST 135.6
#ASSERT `position one`'s `weekly statutory sick pay` EQUALS JUST 123.25
#ASSERT `position one`'s `statutory sick pay for a day` EQUALS JUST 24.65
#ASSERT `position one`'s `statutory sick pay entitlement limit` EQUALS JUST 3451
#ASSERT `position one`'s `entitled to statutory maternity pay` EQUALS JUST TRUE
#ASSERT `position one`'s `earliest start of the maternity pay period` EQUALS JUST (Date 18 10 2026)
#ASSERT `position one`'s `maternity pay for the first 6 weeks` EQUALS JUST 270
#ASSERT `position one`'s `maternity pay for the remaining weeks` EQUALS JUST 194.32
#ASSERT `position two`'s `primary Class 1 contribution` EQUALS NOTHING
#ASSERT `position two`'s `weekly statutory sick pay` EQUALS NOTHING
#ASSERT `position two`'s `entitled to statutory maternity pay` EQUALS JUST FALSE
