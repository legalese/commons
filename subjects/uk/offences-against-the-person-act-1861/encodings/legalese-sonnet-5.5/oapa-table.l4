    WHEN `s 64: making or having gunpowder or a dangerous thing to commit a felony of this Act` THEN `s 64: the sentences the text states`

§§ `Is a proposed custodial sentence within the most the text states?`

-- The three rules below carry no @ref: they cite no line of the text.  They compare a proposed term of months (or
-- "for life") with the figures the lookup above already took from the text, and nothing else.  The figures are the
-- text's; the comparison is arithmetic.  See NOTES.md, "Rules without an @ref".

DECLARE `Kind of custodial sentence` IS ONE OF
    `a sentence of penal servitude`
    `a sentence of imprisonment`

DECLARE `How a proposed term fits one stated option` IS ONE OF
    `the term fits`
    `the term exceeds`
    `the term is not stated`
    `a different kind of sentence`

DECLARE `What the text says of a proposed sentence` IS ONE OF
    `within the maximum the text states`
    `above the maximum the text states`
    `the text states no maximum for that kind of sentence`
    `the text states no sentence of that kind for this offence`

GIVEN `for life` IS A BOOLEAN
      months IS A NUMBER
      t IS A Term
GIVETH A `How a proposed term fits one stated option`
`how a proposed term fits a stated term` `for life` months t MEANS
    CONSIDER t
    WHEN `for life` THEN `the term fits`
    WHEN `for a term not exceeding` m THEN
        IF `for life`
        THEN `the term exceeds`
        ELSE IF months AT MOST m
             THEN `the term fits`
             ELSE `the term exceeds`
    WHEN `for a term the text does not state` THEN `the term is not stated`

GIVEN kind IS A `Kind of custodial sentence`
      `for life` IS A BOOLEAN
      months IS A NUMBER
      option IS A Sentence
GIVETH A `How a proposed term fits one stated option`
`how a proposed sentence fits one stated option` kind `for life` months option MEANS
    CONSIDER option
    WHEN `penal servitude` t THEN
        IF kind EQUALS `a sentence of penal servitude`
        THEN `how a proposed term fits a stated term` `for life` months t
        ELSE `a different kind of sentence`
    WHEN `imprisonment` t THEN
        IF kind EQUALS `a sentence of imprisonment`
        THEN `how a proposed term fits a stated term` `for life` months t
        ELSE `a different kind of sentence`
    WHEN `imprisonment in default of paying a fine and costs` t THEN `a different kind of sentence`
    WHEN `a fine, with any costs, not exceeding` p THEN `a different kind of sentence`

GIVEN o IS AN Offence
      kind IS A `Kind of custodial sentence`
      `for life` IS A BOOLEAN
      months IS A NUMBER
GIVETH A `What the text says of a proposed sentence`
`a proposed custodial sentence measured against the text` o kind `for life` months MEANS
    IF any (GIVEN f YIELD f EQUALS `the term fits`) fits
    THEN `within the maximum the text states`
    ELSE IF any (GIVEN f YIELD f EQUALS `the term is not stated`) fits
         THEN `the text states no maximum for that kind of sentence`
         ELSE IF any (GIVEN f YIELD f EQUALS `the term exceeds`) fits
              THEN `above the maximum the text states`
              ELSE `the text states no sentence of that kind for this offence`
    WHERE
        fits MEANS map (GIVEN op YIELD `how a proposed sentence fits one stated option` kind `for life` months op) (`the sentences the text states for the offence` o)
