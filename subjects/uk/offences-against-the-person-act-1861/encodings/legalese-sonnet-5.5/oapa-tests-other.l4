IMPORT prelude
IMPORT `oapa-nouns`
IMPORT `oapa-other`

-- Offences against the Person Act 1861 -- TESTS for oapa-other.l4 (sections 66 to 79).
-- Every expected value was decided from the section's text before the assertion was
-- written, and is stated beside it.

§ `Tests: other matters`

§§ `Section 68`

-- the offence is one mentioned in the Act, how the text says it is tried, indictable where
-- the text does not say, committed within the jurisdiction of the Admiralty
`s68 tried on indictment per the text` MEANS `Offence within the Admiralty jurisdiction` OF TRUE, `on indictment`, FALSE, TRUE
`s68 summary per the text` MEANS `Offence within the Admiralty jurisdiction` OF TRUE, `summarily before justices of the peace`, TRUE, TRUE
`s68 text silent, person says indictable` MEANS `Offence within the Admiralty jurisdiction` OF TRUE, `the text does not say`, TRUE, TRUE
`s68 text silent, person says not indictable` MEANS `Offence within the Admiralty jurisdiction` OF TRUE, `the text does not say`, FALSE, TRUE
`s68 on indictment but not within the Admiralty jurisdiction` MEANS `Offence within the Admiralty jurisdiction` OF TRUE, `on indictment`, FALSE, FALSE
`s68 on indictment but not an offence of this Act` MEANS `Offence within the Admiralty jurisdiction` OF FALSE, `on indictment`, FALSE, TRUE

#ASSERT `s 68: the offence is indictable` `s68 tried on indictment per the text`
-- the text's own words ("before two justices") govern over what the person says
#ASSERT NOT (`s 68: the offence is indictable` `s68 summary per the text`)
#ASSERT `s 68: the offence is indictable` `s68 text silent, person says indictable`
#ASSERT NOT (`s 68: the offence is indictable` `s68 text silent, person says not indictable`)
#ASSERT `s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 tried on indictment per the text`
#ASSERT `s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 text silent, person says indictable`
#ASSERT NOT (`s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 summary per the text`)
#ASSERT NOT (`s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 text silent, person says not indictable`)
#ASSERT NOT (`s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 on indictment but not within the Admiralty jurisdiction`)
#ASSERT NOT (`s 68: the person is liable to the same punishments as if the offence had been committed upon the land` `s68 on indictment but not an offence of this Act`)

§§ `Section 78`

-- the law's own answer: no extension to Scotland unless expressly provided before
#ASSERT NOT (`s 78: the Act extends to Scotland for this matter` FALSE)
#ASSERT `s 78: the Act extends to Scotland for this matter` TRUE

§§ `Blank sections and section 76`

#ASSERT `s 66: blank in this text` EQUALS "Section 66 shows only its number and a row of dots; there is nothing to encode."
#ASSERT `ss 69 to 74: blank in this text` EQUALS "Sections 69, 70, 71, 72, 73 and 74 show only their numbers and a row of dots; there is nothing to encode."
#ASSERT `s 76: procedure for summary offences, not encoded` EQUALS "Section 76 sends summary prosecutions to the procedure of other Acts that are not inputs here; nothing is decided."
#ASSERT `s 77: blank in this text` EQUALS "Section 77 shows only its number and a row of dots; there is nothing to encode."
#ASSERT `s 79: blank in this text` EQUALS "Section 79 shows only its number and a row of dots; there is nothing to encode."
