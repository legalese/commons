IMPORT prelude
IMPORT daydate

-- Pensions Act 2008 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2008-30.txt (point in time
-- 29 June 2026).

§ `Nouns`

DECLARE `Worker facts` HAS
    `date of birth`                                     IS A DATE
    `reaches pensionable age on`                        IS A DATE
    -- s 1(1)(a)
    `works or ordinarily works in Great Britain under the worker's contract` IS A BOOLEAN
    -- s 3(3)-(4): an active member of a qualifying scheme on the automatic
    -- enrolment date, or ceased to be one by their own act within the
    -- prescribed period before it.
    `excepted from automatic enrolment by s 3(3) or (4)` IS A BOOLEAN
    -- s 7(1): already an active member of a qualifying scheme.
    `an active member of a qualifying scheme`           IS A BOOLEAN
    -- s 9(1)(c): already an active member of a scheme meeting s 9(7).
    `an active member of a section 9 scheme`            IS A BOOLEAN

DECLARE `Pay reference period` HAS
    `first day`                                         IS A DATE
    `length in months`                                  IS A NUMBER
    -- s 13(3): earnings payable in the period.
    `gross earnings`                                    IS A NUMBER

DECLARE `Contributions` HAS
    `employer contribution`                             IS A NUMBER
    `jobholder contribution`                            IS A NUMBER
    -- s 20(1A): for a relevant Master Trust, Conditions 1 and 2 are met (an
    -- input); TRUE where the scheme is not a Master Trust.
    `Master Trust conditions met or not a Master Trust` IS A BOOLEAN

DECLARE `Penalty facts` HAS
    `fixed penalty notice issued on`                    IS A DATE
    `fixed penalty amount`                              IS A NUMBER
    -- s 41(2)
    `a review of the underlying notice is pending`      IS A BOOLEAN
    `a tribunal reference about the fixed penalty is pending` IS A BOOLEAN
    -- s 41(4)-(6)
    `escalating penalty payable from`                   IS A DATE
    `daily rate`                                        IS A NUMBER
    `complied on`                                       IS A DATE
