IMPORT prelude
IMPORT daydate

-- Pension Schemes Act 1993 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1993-48.txt (point in time
-- 31 July 2026).

§ `Nouns`

DECLARE `Leaver facts` HAS
    `pensionable service began on`                      IS A DATE
    `pensionable service ended on`                      IS A DATE
    -- ss 71(7)-(9), 101AA(2)-(3): days of earlier service that count.
    `earlier counting service, in days`                 IS A NUMBER
    -- s 71(1)(aa), (11)
    `all benefit would be money purchase`               IS A BOOLEAN
    `relevant service began before s 36 PA 2014 commenced` IS A BOOLEAN
    -- s 71(1)(b)
    `a personal pension transfer was received`          IS A BOOLEAN
    `reaches normal pension age on`                     IS A DATE
    `normal pension age, in years`                      IS A NUMBER
    -- s 101AB(4)
    `employee contributions`                            IS A NUMBER
    `employee contributions to another scheme relating to a transfer payment` IS A NUMBER
    `the transfer payment`                              IS A NUMBER

DECLARE `Transfer facts` HAS
    -- s 94(1)-(2)
    `money purchase benefits`                           IS A BOOLEAN
    `flexible benefits`                                 IS A BOOLEAN
    -- s 93A(3)-(4): the guarantee date in the statement of entitlement.
    `guarantee date`                                    IS A DATE
    `application made on`                               IS A MAYBE DATE
    -- s 99(3): the conclusion of disciplinary or court proceedings that may
    -- lead to forfeiture; NOTHING if none.
    `forfeiture proceedings concluded on`               IS A MAYBE DATE
    -- s 99(7)
    `carried out on`                                    IS A MAYBE DATE
