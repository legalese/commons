IMPORT prelude
IMPORT daydate
IMPORT `psa93-types`
IMPORT `psa93-leavers`
IMPORT `psa93-transfers`
IMPORT `psa93-goal`

-- Independent tests: expected values decided from the Act and BRIEF.md
-- before the encoding was read (see independent-expectations.md, scenario
-- ids L1.. and T1..). A failing assertion is a finding.

§ `Helpers`

GIVEN s IS A DATE, e IS A DATE, d IS A NUMBER, mp IS A BOOLEAN, pre IS A BOOLEAN, pp IS A BOOLEAN, npa IS A DATE, age IS A NUMBER, ee IS A NUMBER, tr IS A NUMBER, tp IS A NUMBER
GIVETH A `Leaver facts`
mkLeaver s e d mp pre pp npa age ee tr tp MEANS
    `Leaver facts` OF s, e, d, mp, pre, pp, npa, age, ee, tr, tp

-- defaults: NPA 65 reached 1 Jan 2050, not all MP, no pre-s 36 service, no PP transfer
GIVEN s IS A DATE, e IS A DATE, d IS A NUMBER
GIVETH A `Leaver facts`
svc s e d MEANS mkLeaver s e d FALSE FALSE FALSE (Date 1 1 2050) 65 0 0 0

GIVEN s IS A DATE, e IS A DATE, d IS A NUMBER, pre IS A BOOLEAN
GIVETH A `Leaver facts`
mpSvc s e d pre MEANS mkLeaver s e d TRUE pre FALSE (Date 1 1 2050) 65 0 0 0

GIVEN s IS A DATE, e IS A DATE
GIVETH A `Leaver facts`
ppSvc s e MEANS mkLeaver s e 0 FALSE FALSE TRUE (Date 1 1 2050) 65 0 0 0

GIVEN s IS A DATE, e IS A DATE, npa IS A DATE
GIVETH A `Leaver facts`
npaSvc s e npa MEANS mkLeaver s e 0 FALSE FALSE FALSE npa 65 0 0 0

GIVEN ee IS A NUMBER, tr IS A NUMBER, tp IS A NUMBER
GIVETH A `Leaver facts`
refundL ee tr tp MEANS mkLeaver (Date 1 1 2026) (Date 31 3 2026) 0 FALSE FALSE FALSE (Date 1 1 2050) 65 ee tr tp

GIVEN age IS A NUMBER
GIVETH A `Leaver facts`
ageL age MEANS mkLeaver (Date 1 1 2020) (Date 31 12 2021) 0 FALSE FALSE FALSE (Date 1 1 2050) age 0 0 0

GIVEN npa IS A DATE
GIVETH A `Leaver facts`
npaOnly npa MEANS mkLeaver (Date 1 1 2020) (Date 31 12 2021) 0 FALSE FALSE FALSE npa 65 0 0 0

GIVEN mp IS A BOOLEAN, fl IS A BOOLEAN, gd IS A DATE, app IS A MAYBE DATE, conc IS A MAYBE DATE, done IS A MAYBE DATE
GIVETH A `Transfer facts`
tf mp fl gd app conc done MEANS `Transfer facts` OF mp, fl, gd, app, conc, done

GIVEN x IS A `Leaver facts`
GIVETH A BOOLEAN
ssb x MEANS `is entitled to short service benefit` x

GIVEN x IS A `Leaver facts`
GIVETH A BOOLEAN
refundRight x MEANS `may elect a cash transfer sum or contribution refund` x

GIVEN x IS A `Leaver facts`, y IS A `Transfer facts`
GIVETH A MAYBE DATE
applyBy x y MEANS `the last day to apply for a transfer for` x `with` y

GIVEN x IS A `Leaver facts`, y IS A `Transfer facts`
GIVETH A BOOLEAN
lost x y MEANS `the transfer right is lost for` x `with` y

GIVEN y IS A `Transfer facts`
GIVETH A MAYBE DATE
trusteesBy y MEANS `the trustees' last day to transfer for` y

GIVEN y IS A `Transfer facts`
GIVETH A BOOLEAN
notify y MEANS `the trustees must notify the Regulator for` y

§ `Goal 1 — two years' qualifying service, s 71(1)(a), (7)`

-- L1-L2
#ASSERT ssb (svc (Date 1 1 2020) (Date 31 12 2021) 0)
#ASSERT NOT (ssb (svc (Date 1 1 2020) (Date 30 12 2021) 0))
-- L3-L4: 300 earlier days, adjusted start 7 Mar 2024
#ASSERT ssb (svc (Date 1 1 2025) (Date 6 3 2026) 300)
#ASSERT NOT (ssb (svc (Date 1 1 2025) (Date 5 3 2026) 300))
-- L5-L6: 400 earlier days, adjusted start 28 Apr 2023
#ASSERT ssb (svc (Date 1 6 2024) (Date 27 4 2025) 400)
#ASSERT NOT (ssb (svc (Date 1 6 2024) (Date 26 4 2025) 400))
-- L7-L8: 29 February start
#ASSERT ssb (svc (Date 29 2 2020) (Date 28 2 2022) 0)
#ASSERT NOT (ssb (svc (Date 29 2 2020) (Date 27 2 2022) 0))
-- L9-L10
#ASSERT ssb (svc (Date 1 3 2020) (Date 28 2 2022) 0)
#ASSERT NOT (ssb (svc (Date 1 3 2020) (Date 27 2 2022) 0))

§ `Goal 1 — 30 days money purchase, s 71(1)(aa), (10), (11)`

-- L11-L14
#ASSERT ssb (mpSvc (Date 1 3 2026) (Date 30 3 2026) 0 FALSE)
#ASSERT NOT (ssb (mpSvc (Date 1 3 2026) (Date 29 3 2026) 0 FALSE))
#ASSERT NOT (ssb (svc (Date 1 3 2026) (Date 30 3 2026) 0))
#ASSERT NOT (ssb (mpSvc (Date 1 3 2026) (Date 30 3 2026) 0 TRUE))
-- L15-L16
#ASSERT ssb (mpSvc (Date 20 3 2026) (Date 31 3 2026) 18 FALSE)
#ASSERT NOT (ssb (mpSvc (Date 20 3 2026) (Date 31 3 2026) 17 FALSE))
-- L17: 2-year route unaffected by s 71(11)
#ASSERT ssb (mpSvc (Date 1 1 2020) (Date 31 12 2021) 0 TRUE)

§ `Goal 1 — personal pension transfer-in, s 71(1)(b)`

-- L18-L19
#ASSERT ssb (ppSvc (Date 1 3 2026) (Date 7 3 2026))
#ASSERT NOT (ssb (svc (Date 1 3 2026) (Date 7 3 2026) 0))

§ `Goal 1 — terminated before normal pension age`

-- L20: terminated on the day NPA attained: not "before normal pension age"
#ASSERT NOT (ssb (npaSvc (Date 1 1 2020) (Date 1 1 2025) (Date 1 1 2025)))
#ASSERT NOT (refundRight (npaSvc (Date 1 1 2020) (Date 1 1 2025) (Date 1 1 2025)))
-- L21
#ASSERT ssb (npaSvc (Date 1 1 2020) (Date 1 1 2025) (Date 2 1 2025))
-- L22: terminated after NPA
#ASSERT NOT (ssb (npaSvc (Date 1 1 2020) (Date 2 1 2025) (Date 1 1 2025)))
#ASSERT NOT (refundRight (npaSvc (Date 1 1 2020) (Date 2 1 2025) (Date 1 1 2025)))

§ `Goal 1 — three-month condition, s 101AA, 101AB(1)`

-- L23-L24
#ASSERT NOT (ssb (svc (Date 1 1 2026) (Date 31 3 2026) 0))
#ASSERT refundRight (svc (Date 1 1 2026) (Date 31 3 2026) 0)
#ASSERT NOT (refundRight (svc (Date 1 1 2026) (Date 30 3 2026) 0))
-- L25-L26
#ASSERT refundRight (svc (Date 1 3 2026) (Date 31 3 2026) 59)
#ASSERT NOT (refundRight (svc (Date 1 3 2026) (Date 31 3 2026) 58))
-- L27-L28: has relevant accrued rights
#ASSERT NOT (refundRight (svc (Date 1 1 2020) (Date 31 12 2021) 0))
#ASSERT NOT (refundRight (mpSvc (Date 1 3 2026) (Date 30 3 2026) 0 FALSE))
-- L29
#ASSERT NOT (ssb (mpSvc (Date 1 1 2026) (Date 31 3 2026) 0 TRUE))
#ASSERT refundRight (mpSvc (Date 1 1 2026) (Date 31 3 2026) 0 TRUE)
-- L30
#ASSERT ssb (ppSvc (Date 1 1 2026) (Date 31 3 2026))
#ASSERT NOT (refundRight (ppSvc (Date 1 1 2026) (Date 31 3 2026)))

§ `Goal 1 — contribution refund, s 101AB(4)`

-- L31-L35
#ASSERT `the contribution refund for` (refundL 5000 3000 2000) EQUALS 7000
#ASSERT `the contribution refund for` (refundL 5000 1500 2000) EQUALS 6500
#ASSERT `the contribution refund for` (refundL 5000 2000 2000) EQUALS 7000
#ASSERT `the contribution refund for` (refundL 1234.56 0 0) EQUALS 1234.56
#ASSERT `the contribution refund for` (refundL 0 800 500) EQUALS 500

posRefund MEANS `the leaver position for` (`Leaver case` OF (refundL 5000 3000 2000), NOTHING)
#ASSERT posRefund's `contribution refund` EQUALS JUST 7000
#ASSERT posRefund's `entitled to short service benefit` EQUALS FALSE

§ `Goal 1 — latest age for short service benefit, s 71(3)`

-- L36-L38
#ASSERT `the latest age from which short service benefit is payable for` (ageL 60) EQUALS 65
#ASSERT `the latest age from which short service benefit is payable for` (ageL 65) EQUALS 65
#ASSERT `the latest age from which short service benefit is payable for` (ageL 67) EQUALS 67
-- L39 through the top-level goal
posAge68 MEANS `the leaver position for` (`Leaver case` OF (ageL 68), NOTHING)
#ASSERT posAge68's `latest age short service benefit is payable from` EQUALS JUST 68
#ASSERT posAge68's `contribution refund` EQUALS NOTHING

§ `Goal 2 — application deadline, s 95(1A)`

gd15Jan MEANS Date 15 1 2026

-- T1-T2
#ASSERT applyBy (npaOnly (Date 1 1 2050)) (tf FALSE TRUE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 14 4 2026)
#ASSERT applyBy (npaOnly (Date 1 1 2050)) (tf FALSE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 14 4 2026)
-- T3-T4
#ASSERT applyBy (npaOnly (Date 1 3 2027)) (tf FALSE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 1 3 2026)
#ASSERT applyBy (npaOnly (Date 1 3 2027)) (tf FALSE TRUE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 14 4 2026)
-- T5-T6
#ASSERT applyBy (npaOnly (Date 14 4 2027)) (tf FALSE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 14 4 2026)
#ASSERT applyBy (npaOnly (Date 13 4 2027)) (tf FALSE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 13 4 2026)
-- T7-T8: NPA reached 29 Feb 2028
#ASSERT applyBy (npaOnly (Date 29 2 2028)) (tf FALSE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS JUST (Date 14 4 2026)
#ASSERT applyBy (npaOnly (Date 29 2 2028)) (tf FALSE FALSE (Date 15 1 2027) NOTHING NOTHING NOTHING) EQUALS JUST (Date 28 2 2027)
-- money purchase: no s 95(1A) deadline
#ASSERT applyBy (npaOnly (Date 1 1 2050)) (tf TRUE FALSE gd15Jan NOTHING NOTHING NOTHING) EQUALS NOTHING

§ `Goal 2 — loss of right, s 98(1)`

-- T9-T10
#ASSERT NOT (lost (npaOnly (Date 1 1 2050)) (tf FALSE TRUE gd15Jan (JUST (Date 14 4 2026)) NOTHING NOTHING))
#ASSERT lost (npaOnly (Date 1 1 2050)) (tf FALSE TRUE gd15Jan (JUST (Date 15 4 2026)) NOTHING NOTHING)
-- T11-T12
#ASSERT NOT (lost (npaOnly (Date 1 3 2027)) (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) NOTHING NOTHING))
#ASSERT lost (npaOnly (Date 1 3 2027)) (tf FALSE FALSE gd15Jan (JUST (Date 2 3 2026)) NOTHING NOTHING)
-- T13: money purchase never lost under s 98(1)
#ASSERT NOT (lost (npaOnly (Date 1 1 2050)) (tf TRUE FALSE gd15Jan (JUST (Date 15 1 2027)) NOTHING NOTHING))
-- T14
#ASSERT NOT (lost (npaOnly (Date 1 1 2050)) (tf FALSE FALSE gd15Jan (JUST gd15Jan) NOTHING NOTHING))

§ `Goal 2 — trustees' deadline, s 99(2)`

-- T15: DB, from the guarantee date
#ASSERT trusteesBy (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) NOTHING NOTHING) EQUALS JUST (Date 14 7 2026)
-- T16-T17: money purchase, from the application date
#ASSERT trusteesBy (tf TRUE FALSE gd15Jan (JUST (Date 10 3 2026)) NOTHING NOTHING) EQUALS JUST (Date 9 9 2026)
#ASSERT trusteesBy (tf TRUE FALSE gd15Jan (JUST (Date 1 1 2026)) NOTHING NOTHING) EQUALS JUST (Date 30 6 2026)
-- T18
#ASSERT trusteesBy (tf FALSE FALSE (Date 1 3 2026) (JUST (Date 10 3 2026)) NOTHING NOTHING) EQUALS JUST (Date 31 8 2026)

§ `Goal 2 — forfeiture extension, s 99(3)`

-- T19-T22
#ASSERT trusteesBy (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 10 6 2026)) NOTHING) EQUALS JUST (Date 10 9 2026)
#ASSERT trusteesBy (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 1 4 2026)) NOTHING) EQUALS JUST (Date 14 7 2026)
#ASSERT trusteesBy (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 14 4 2026)) NOTHING) EQUALS JUST (Date 14 7 2026)
#ASSERT trusteesBy (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 15 4 2026)) NOTHING) EQUALS JUST (Date 15 7 2026)
-- T23-T24
#ASSERT trusteesBy (tf TRUE FALSE gd15Jan (JUST (Date 10 3 2026)) (JUST (Date 30 11 2026)) NOTHING) EQUALS JUST (Date 28 2 2027)
#ASSERT trusteesBy (tf TRUE FALSE gd15Jan (JUST (Date 10 3 2026)) (JUST (Date 1 12 2026)) NOTHING) EQUALS JUST (Date 1 3 2027)

§ `Goal 2 — notify the Regulator, s 99(7)`

-- T26-T27
#ASSERT NOT (notify (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) NOTHING (JUST (Date 14 7 2026))))
#ASSERT notify (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) NOTHING (JUST (Date 15 7 2026)))
-- T28-T29
#ASSERT NOT (notify (tf TRUE FALSE gd15Jan (JUST (Date 10 3 2026)) NOTHING (JUST (Date 9 9 2026))))
#ASSERT notify (tf TRUE FALSE gd15Jan (JUST (Date 10 3 2026)) NOTHING (JUST (Date 10 9 2026)))
-- T30-T31: s 99(3) extension does not suspend s 99(7)
#ASSERT notify (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 10 6 2026)) (JUST (Date 1 9 2026)))
#ASSERT NOT (notify (tf FALSE FALSE gd15Jan (JUST (Date 1 3 2026)) (JUST (Date 10 6 2026)) (JUST (Date 10 7 2026))))

§ `Top-level goal — a transfer case`

posTransfer MEANS `the leaver position for` (`Leaver case` OF (npaOnly (Date 1 3 2027)), JUST (tf FALSE FALSE gd15Jan (JUST (Date 2 3 2026)) NOTHING NOTHING))
#ASSERT posTransfer's `last day to apply for a transfer` EQUALS JUST (Date 1 3 2026)
#ASSERT posTransfer's `transfer right lost` EQUALS JUST TRUE
#ASSERT posTransfer's `entitled to short service benefit` EQUALS TRUE
