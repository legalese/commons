IMPORT prelude
IMPORT daydate

-- Water Industry Act 1991 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1991-56.txt (point in time
-- 30 July 2026). Seat: the water customer.

§ `Nouns`

§§ `Connections (ss 45-51, 106)`

DECLARE `Connection notice` HAS
    -- s 45(1): served by the owner or occupier of premises that consist of a
    -- building (or part), or on which a building is proposed to be erected.
    `served by the owner or occupier`                   IS A BOOLEAN
    `premises with or for a building`                   IS A BOOLEAN
    `for a domestic supply`                             IS A BOOLEAN
    -- s 45(2)(a)
    `the main is a trunk main or for non-domestic supply only` IS A BOOLEAN
    `notice served on`                                  IS A DATE
    -- s 51(1)(b): the whole of the service pipe was laid when the notice was
    -- served.
    `the service pipe was already laid`                 IS A BOOLEAN
    -- s 51(3), (6)(b): the notice that the customer's part of the pipe has
    -- been laid.
    `pipe-laid notice served on`                        IS A MAYBE DATE
    -- s 47(3): the counter-notice imposing conditions, if any.
    `conditions counter-notice served on`               IS A MAYBE DATE
    -- s 45(2)(b), 51(6)(c): the day all validly imposed conditions were
    -- satisfied; NOTHING if they are not yet satisfied.
    `conditions satisfied on`                           IS A MAYBE DATE

-- s 48: money deposited as security under s 47(2)(a).
DECLARE `Security deposit` HAS
    `amount deposited`                                  IS A NUMBER
    `interest per 50p per three months`                 IS A NUMBER
    `deposited on`                                      IS A DATE
    `returned on`                                       IS A DATE

-- s 106(3)-(4)
DECLARE `Sewer notice` HAS
    `received by the sewerage undertaker on`            IS A DATE
    `refusal notice given on`                           IS A MAYBE DATE

§§ `Disconnection for non-payment (ss 61-63A, Schedule 4A)`

DECLARE `Kind of premises` IS ONE OF
    -- Sch 4A para 1
    `a dwelling that is someone's only or principal home`
    -- para 2
    `a house in multiple occupation that is someone's only or principal home`
    -- para 3
    `accommodation for the elderly that is someone's only or principal home`
    -- paras 4 onwards: hospitals, surgeries, care homes, schools, prisons,
    -- emergency services and the rest
    `other premises listed in Schedule 4A`
    `premises not listed in Schedule 4A`

DECLARE `Non-payment case` HAS
    `the premises`                                      IS A `Kind of premises`
    -- s 61(1ZA)(a): the occupier is liable for the charges.
    `I am liable for the charges`                       IS A BOOLEAN
    `payment notice served on`                          IS A DATE
    `paid on`                                           IS A MAYBE DATE
    -- s 61(2)(b): a counter-notice disputing liability.
    `counter-notice served on`                          IS A MAYBE DATE
    -- s 61(3)
    `a judgment for the charges is enforceable`         IS A BOOLEAN
    `a settlement agreement is in breach`               IS A BOOLEAN
    `cut off on`                                        IS A DATE

§§ `Charges (ss 144-144B)`

DECLARE `Moving out` HAS
    `informed the undertaker on`                        IS A MAYBE DATE
    `ceased to occupy on`                               IS A DATE
    -- s 144(4)(b)-(c)
    `next normal meter reading on`                      IS A DATE
    `new occupier informed the undertaker on`           IS A MAYBE DATE
    -- s 144(2): the charges are fixed by reference to volume.
    `charges by volume`                                 IS A BOOLEAN

DECLARE `Section 62 notice` HAS
    `served on`                                         IS A DATE
    `expires on`                                        IS A DATE

DECLARE `Meter case` HAS
    -- s 144A(1), 144B(1)(a)
    `someone has a home in the premises`                IS A BOOLEAN
    `charges are fixed without reference to volume`     IS A BOOLEAN
    -- s 144A(3): findings
    `metering not reasonably practicable`               IS A BOOLEAN
    `metering would cost unreasonable expense`          IS A BOOLEAN
    -- s 144A(5)-(7)
    `measured charging began on`                        IS A MAYBE DATE
    `my first measured charges notice for the premises` IS A BOOLEAN
    `I remain the consumer`                             IS A BOOLEAN
    -- s 144A(7): the notice-giver left, no one has given an earlier notice,
    -- and everyone in occupation then is still there.
    `the conditions in s 144A(7) are met`               IS A BOOLEAN
    -- s 144B(2)
    `I gave a measured charges notice or consent`       IS A BOOLEAN
    `occupation changed and no charges yet demanded`    IS A BOOLEAN
