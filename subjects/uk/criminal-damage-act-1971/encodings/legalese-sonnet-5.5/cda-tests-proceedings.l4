IMPORT prelude
IMPORT `cda-s6-s9-proceedings`

-- Criminal Damage Act 1971, sections 6, 7 and 9: TESTS.
-- Layer 1 tests. Every expected value below was written from the text before the
-- file was run. A failing assertion here would be a finding, not a value to be edited.

§ `Tests for sections 6, 7 and 9`

§§ `6(1): the justice's power to grant a warrant`

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = TRUE TRUE TRUE FALSE. Expected: may grant (all conditions, limb (a)).
#ASSERT `a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` TRUE TRUE TRUE FALSE

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = TRUE TRUE FALSE TRUE. Expected: may grant (all conditions, limb (b)).
#ASSERT `a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` TRUE TRUE FALSE TRUE

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = TRUE TRUE TRUE TRUE. Expected: may grant (both limbs).
#ASSERT `a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` TRUE TRUE TRUE TRUE

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = FALSE TRUE TRUE TRUE. Expected: may NOT grant (nothing 'made to appear' by information on oath).
#ASSERT NOT (`a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` FALSE TRUE TRUE TRUE)

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = TRUE FALSE TRUE TRUE. Expected: may NOT grant (no reasonable cause to believe the person has the thing).
#ASSERT NOT (`a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` TRUE FALSE TRUE TRUE)

-- s 6(1): inputs (on oath, cause as to custody, limb a, limb b) = TRUE TRUE FALSE FALSE. Expected: may NOT grant (neither limb (a) nor limb (b)).
#ASSERT NOT (`a justice of the peace may grant a warrant authorising any constable to search for and seize the thing` TRUE TRUE FALSE FALSE)

§§ `6(2): the constable's powers`

-- s 6(2): authorised. Expected: may enter and search.
#ASSERT `the constable may enter the premises, by force if need be, and search them` TRUE

-- s 6(2): not authorised. Expected: may not.
#ASSERT NOT (`the constable may enter the premises, by force if need be, and search them` FALSE)

-- s 6(2): authorised and believes the thing was used or intended as described. Expected: may seize.
#ASSERT `the constable may seize the thing` TRUE TRUE

-- s 6(2): authorised but does not believe it. Expected: may not seize.
#ASSERT NOT (`the constable may seize the thing` TRUE FALSE)

-- s 6(2): not authorised, even though believing. Expected: may not seize.
#ASSERT NOT (`the constable may seize the thing` FALSE TRUE)

§§ `6(3): the Police (Property) Act 1897`

-- s 6(3): the property came into police possession under s 6. Expected: the 1897 Act applies.
#ASSERT `the law governing property that has come into the possession of the police under section 6` TRUE EQUALS `the Police (Property) Act 1897 applies, as it applies to property that has come into the possession of the police in the circumstances mentioned in that Act`

-- s 6(3): it did not. Expected: s 6(3) says nothing.
#ASSERT `the law governing property that has come into the possession of the police under section 6` FALSE EQUALS `section 6(3) says nothing about this`

§§ `7(2): jurisdiction of magistrates' courts`

-- s 7(2): an ousting rule, and an offence under the Act or of destroying or damaging property. Expected: no preclusion.
#ASSERT `the effect of a rule of law about a dispute of title on the jurisdiction of magistrates' courts` TRUE TRUE EQUALS `that rule of law does not preclude a magistrates' court from trying the offence`

-- s 7(2): an ousting rule, but some other offence. Expected: s 7(2) says nothing.
#ASSERT `the effect of a rule of law about a dispute of title on the jurisdiction of magistrates' courts` TRUE FALSE EQUALS `section 7(2) says nothing about this`

-- s 7(2): not an ousting rule. Expected: s 7(2) says nothing.
#ASSERT `the effect of a rule of law about a dispute of title on the jurisdiction of magistrates' courts` FALSE TRUE EQUALS `section 7(2) says nothing about this`

§§ `9: answering and complying`

-- s 9: inputs (qualifying proceedings, question, order, may incriminate) = TRUE TRUE FALSE TRUE. Expected: not excused (a question in qualifying proceedings that may incriminate).
#ASSERT `whether the person is excused from answering or complying` TRUE TRUE FALSE TRUE EQUALS `not excused by reason that to answer or comply may incriminate`

-- s 9: inputs (qualifying proceedings, question, order, may incriminate) = TRUE FALSE TRUE TRUE. Expected: not excused (an order in qualifying proceedings that may incriminate).
#ASSERT `whether the person is excused from answering or complying` TRUE FALSE TRUE TRUE EQUALS `not excused by reason that to answer or comply may incriminate`

-- s 9: inputs (qualifying proceedings, question, order, may incriminate) = FALSE TRUE FALSE TRUE. Expected: says nothing (not qualifying proceedings).
#ASSERT `whether the person is excused from answering or complying` FALSE TRUE FALSE TRUE EQUALS `section 9 says nothing about this`

-- s 9: inputs (qualifying proceedings, question, order, may incriminate) = TRUE FALSE FALSE TRUE. Expected: says nothing (neither a question nor an order).
#ASSERT `whether the person is excused from answering or complying` TRUE FALSE FALSE TRUE EQUALS `section 9 says nothing about this`

-- s 9: inputs (qualifying proceedings, question, order, may incriminate) = TRUE TRUE TRUE FALSE. Expected: says nothing (no incrimination, so no excuse is in play).
#ASSERT `whether the person is excused from answering or complying` TRUE TRUE TRUE FALSE EQUALS `section 9 says nothing about this`

§§ `9: what may be used in evidence`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = TRUE TRUE `the person who made it` FALSE. Expected: not admissible (against the person who made it).
#ASSERT `the admissibility of the statement or admission` TRUE TRUE `the person who made it` FALSE EQUALS `not admissible in evidence`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = TRUE TRUE `the spouse or civil partner of the person who made it` FALSE. Expected: not admissible (against the spouse or civil partner, married before the statement).
#ASSERT `the admissibility of the statement or admission` TRUE TRUE `the spouse or civil partner of the person who made it` FALSE EQUALS `not admissible in evidence`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = TRUE TRUE `the spouse or civil partner of the person who made it` TRUE. Expected: says nothing (against a spouse or civil partner who married afterwards: the proviso lifts the bar).
#ASSERT `the admissibility of the statement or admission` TRUE TRUE `the spouse or civil partner of the person who made it` TRUE EQUALS `section 9 says nothing about this`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = TRUE TRUE `the person who made it` TRUE. Expected: not admissible (the proviso concerns only the spouse or civil partner, not the maker).
#ASSERT `the admissibility of the statement or admission` TRUE TRUE `the person who made it` TRUE EQUALS `not admissible in evidence`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = FALSE TRUE `the person who made it` FALSE. Expected: says nothing (not made in answering or complying as described).
#ASSERT `the admissibility of the statement or admission` FALSE TRUE `the person who made it` FALSE EQUALS `section 9 says nothing about this`

-- s 9: inputs (made in answering, offence proceedings, offered against, married after) = TRUE FALSE `the person who made it` FALSE. Expected: says nothing (not proceedings for an offence under the Act).
#ASSERT `the admissibility of the statement or admission` TRUE FALSE `the person who made it` FALSE EQUALS `section 9 says nothing about this`
