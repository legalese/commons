IMPORT prelude
IMPORT `poca-interp`

-- Tests for poca-interp.l4 (section 340).  Every expected value is written from the text of section 340 before the run.

§ `s 340(2) criminal conduct`
#ASSERT `s 340(2) the conduct is criminal conduct` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(2) the conduct is criminal conduct` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(2) the conduct is criminal conduct` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 340(2) the conduct is criminal conduct` FALSE FALSE EQUALS JUST FALSE

§ `s 340(3) criminal property`
-- both limbs: a benefit (or represents one), and the alleged offender knows or suspects
#ASSERT `s 340(3) the property is criminal property` TRUE TRUE EQUALS JUST TRUE
-- a benefit that the alleged offender neither knows nor suspects is not criminal property for him
#ASSERT `s 340(3) the property is criminal property` TRUE FALSE EQUALS JUST FALSE
-- suspicion without a benefit
#ASSERT `s 340(3) the property is criminal property` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 340(3) the property is criminal property` FALSE FALSE EQUALS JUST FALSE

§ `s 340(4) immaterial matters`
#ASSERT `s 340(4) the matter is immaterial` `who carried out the conduct` EQUALS JUST TRUE
#ASSERT `s 340(4) the matter is immaterial` `who benefited from the conduct` EQUALS JUST TRUE
#ASSERT `s 340(4) the matter is immaterial` `whether the conduct occurred before or after the passing of the Act` EQUALS JUST TRUE
-- any other matter: the subsection is silent
#ASSERT `s 340(4) the matter is immaterial` `another matter` EQUALS NOTHING

§ `s 340(5) to (8): benefit`
#ASSERT `s 340(5) the person benefits from the conduct` TRUE EQUALS JUST TRUE
#ASSERT `s 340(5) the person benefits from the conduct` FALSE EQUALS JUST FALSE
-- (6): the sum equals the value of the advantage; with no advantage there is no sum stated
#ASSERT `s 340(6) the sum of money he is taken to obtain, in pounds` TRUE 2500 EQUALS JUST 2500
#ASSERT `s 340(6) the sum of money he is taken to obtain, in pounds` TRUE 0 EQUALS JUST 0
#ASSERT `s 340(6) the sum of money he is taken to obtain, in pounds` FALSE 2500 EQUALS NOTHING
#ASSERT `s 340(7) the property or advantage was obtained in connection with the conduct` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(7) the property or advantage was obtained in connection with the conduct` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(7) the property or advantage was obtained in connection with the conduct` FALSE FALSE EQUALS NOTHING
#ASSERT `s 340(8) the property is his benefit` TRUE EQUALS JUST TRUE
#ASSERT `s 340(8) the property is his benefit` FALSE EQUALS JUST FALSE

§ `s 340(9) and (10): property and interest`
#ASSERT `s 340(9) the thing is property` money EQUALS JUST TRUE
#ASSERT `s 340(9) the thing is property` `real or personal property` EQUALS JUST TRUE
#ASSERT `s 340(9) the thing is property` `heritable or moveable property` EQUALS JUST TRUE
#ASSERT `s 340(9) the thing is property` `a thing in action or other intangible or incorporeal property` EQUALS JUST TRUE
#ASSERT `s 340(9) the thing is property` `something else` EQUALS NOTHING
#ASSERT `s 340(10)(a) the property is obtained by the person` TRUE EQUALS JUST TRUE
#ASSERT `s 340(10)(a) the property is obtained by the person` FALSE EQUALS JUST FALSE
#ASSERT `s 340(10)(b) the thing is an interest in land in England and Wales or Northern Ireland` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 340(10)(b) the thing is an interest in land in England and Wales or Northern Ireland` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(10)(b) the thing is an interest in land in England and Wales or Northern Ireland` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(10)(b) the thing is an interest in land in England and Wales or Northern Ireland` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 340(10)(c) the thing is an interest in land in Scotland` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(10)(c) the thing is an interest in land in Scotland` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(10)(c) the thing is an interest in land in Scotland` FALSE FALSE EQUALS JUST FALSE
-- (d) says "include", so a right that is neither is not said to be excluded
#ASSERT `s 340(10)(d) the thing is an interest in property other than land` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(10)(d) the thing is an interest in property other than land` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(10)(d) the thing is an interest in property other than land` FALSE FALSE EQUALS NOTHING

§ `s 340(11) money laundering`
#ASSERT `s 340(11) the act is money laundering` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 340(11) the act is money laundering` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 340(11) the act is money laundering` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(11) the act is money laundering` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(11) the act is money laundering` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 340(12) and (13): employer, constable`
#ASSERT `s 340(12) the body is the person's employer for a disclosure to a nominated officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(12) the body is the person's employer for a disclosure to a nominated officer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(12) the body is the person's employer for a disclosure to a nominated officer` FALSE FALSE EQUALS NOTHING
#ASSERT `s 340(12)(b) the person is in employment for a disclosure to a nominated officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(12)(b) the person is in employment for a disclosure to a nominated officer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(12)(b) the person is in employment for a disclosure to a nominated officer` FALSE FALSE EQUALS NOTHING
#ASSERT `s 340(13) the person is a constable for the purposes of this Part` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(13) the person is a constable for the purposes of this Part` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(13) the person is a constable for the purposes of this Part` FALSE FALSE EQUALS NOTHING

§ `s 340(14) to (17): bodies and relationships`
-- (14) arguments: accepts deposits (a regulated activity), specified in (14A)(b) regulations as excluded, National Savings Bank, specified in (14)(c) regulations
#ASSERT `s 340(14) the person is a deposit-taking body` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 340(14) the person is a deposit-taking body` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 340(14) the person is a deposit-taking body` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(14) the person is a deposit-taking body` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(14) the person is a deposit-taking body` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(14) the person is a deposit-taking body` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 340(14C) the person is an electronic money institution` TRUE EQUALS JUST TRUE
#ASSERT `s 340(14C) the person is an electronic money institution` FALSE EQUALS NOTHING
#ASSERT `s 340(15) the order is an information order` TRUE EQUALS JUST TRUE
#ASSERT `s 340(15) the order is an information order` FALSE EQUALS JUST FALSE
#ASSERT `s 340(16) the person is a payment institution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 340(16) the person is a payment institution` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 340(16) the person is a payment institution` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 340(17) the relationship is a business relationship` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 340(17) the relationship is a business relationship` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 340(17) the relationship is a business relationship` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 340(17) the relationship is a business relationship` TRUE TRUE FALSE EQUALS JUST FALSE
