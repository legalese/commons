IMPORT prelude
IMPORT daydate
IMPORT `poca-nouns`
IMPORT `poca-disclose`

-- Tests for poca-disclose.l4 (sections 337 to 339ZG).  Every expected value is written from the text before the run.

§ `s 337 protected disclosures`
#ASSERT `s 337(2) the first condition is satisfied` TRUE
#ASSERT NOT `s 337(2) the first condition is satisfied` FALSE
-- (3): knows or suspects, or has reasonable grounds for knowing or suspecting
#ASSERT `s 337(3) the second condition is satisfied` TRUE FALSE
#ASSERT `s 337(3) the second condition is satisfied` FALSE TRUE
#ASSERT NOT `s 337(3) the second condition is satisfied` FALSE FALSE
-- (4): a constable, a customs officer or a nominated officer, as soon as practicable
#ASSERT `s 337(4) the third condition is satisfied` `a constable` TRUE
#ASSERT `s 337(4) the third condition is satisfied` `a customs officer` TRUE
#ASSERT `s 337(4) the third condition is satisfied` `a nominated officer` TRUE
-- s 340(13): a person authorised by the Director General of the National Crime Agency is a constable
#ASSERT `s 337(4) the third condition is satisfied` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` TRUE
#ASSERT NOT `s 337(4) the third condition is satisfied` `a constable` FALSE
#ASSERT NOT `s 337(4) the third condition is satisfied` `anyone else` TRUE
#ASSERT NOT `s 337(4) the third condition is satisfied` `an officer of Revenue and Customs` TRUE
#ASSERT `s 337(1) the disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 337(1) the disclosure is not to be taken to breach a restriction on the disclosure of information` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 337(1) the disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 337(1) the disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 337(4A) the further disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 337(4A) the further disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 337(4A) the further disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 337(4A) the further disclosure is not to be taken to breach a restriction on the disclosure of information` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 337(5) the disclosure is a disclosure to a nominated officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 337(5) the disclosure is a disclosure to a nominated officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 337(5) the disclosure is a disclosure to a nominated officer` FALSE TRUE EQUALS JUST FALSE

§ `s 338 authorised disclosures`
#ASSERT `s 338(2) the first condition is satisfied` TRUE
#ASSERT NOT `s 338(2) the first condition is satisfied` FALSE
-- (2A): while doing the act; began when it was not a prohibited act; own initiative; as soon as practicable
#ASSERT `s 338(2A) the second condition is satisfied` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 338(2A) the second condition is satisfied` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 338(2A) the second condition is satisfied` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 338(2A) the second condition is satisfied` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 338(2A) the second condition is satisfied` TRUE TRUE TRUE FALSE
-- (3): after the act; a reasonable excuse for not disclosing before; own initiative; as soon as practicable
#ASSERT `s 338(3) the third condition is satisfied` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 338(3) the third condition is satisfied` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 338(3) the third condition is satisfied` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 338(3) the third condition is satisfied` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 338(3) the third condition is satisfied` TRUE TRUE TRUE FALSE
-- (1): recipient, by the alleged offender, that property is criminal property, first/second/third condition
#ASSERT `s 338(1) the disclosure is authorised` `a constable` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 338(1) the disclosure is authorised` `a customs officer` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 338(1) the disclosure is authorised` `a nominated officer` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 338(1) the disclosure is authorised` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 338(1) the disclosure is authorised` `anyone else` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 338(1) the disclosure is authorised` `a constable` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 338(1) the disclosure is authorised` `a constable` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 338(1) the disclosure is authorised` `a constable` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 338(4) the authorised disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE EQUALS JUST TRUE
#ASSERT `s 338(4) the authorised disclosure is not to be taken to breach a restriction on the disclosure of information` FALSE EQUALS NOTHING
#ASSERT `s 338(4A) no civil liability arises in respect of the disclosure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 338(4A) no civil liability arises in respect of the disclosure` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 338(4A) no civil liability arises in respect of the disclosure` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 338(5) the disclosure is a disclosure to a nominated officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 338(5) the disclosure is a disclosure to a nominated officer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 338(5) the disclosure is a disclosure to a nominated officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 338(6) the act is the prohibited act` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 338(6) the act is the prohibited act` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 338(6) the act is the prohibited act` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 338(6) the act is the prohibited act` FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 339 form and manner`
-- (1A) arguments: makes a disclosure under s 330/331/332/338, in the prescribed form, in the prescribed manner, a reasonable excuse
-- s 339(1): the Secretary of State may by order prescribe the form and manner in which a disclosure under section 330, 331, 332 or 338 must be made
#ASSERT `s 339(1) the person may by order prescribe the form and manner of the disclosure` `the Secretary of State` TRUE EQUALS JUST TRUE
#ASSERT `s 339(1) the person may by order prescribe the form and manner of the disclosure` `someone else` TRUE EQUALS NOTHING
#ASSERT `s 339(1) the person may by order prescribe the form and manner of the disclosure` `the Secretary of State` FALSE EQUALS NOTHING
#ASSERT `s 339(1A) the person commits an offence` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 339(1A) the person commits an offence` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339(1A) the person commits an offence` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339(1A) the person commits an offence` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339(1A) the person commits an offence` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (1B): a reasonable excuse
#ASSERT `s 339(1A) the person commits an offence` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#TRACE `s 339(1A) the person must not make a disclosure otherwise than in the prescribed form or manner unless he has a reasonable excuse` FALSE AT 0 WITH
    PARTY `the person` DOES `make a disclosure otherwise than in the prescribed form or manner` AT 2
#TRACE `s 339(1A) the person must not make a disclosure otherwise than in the prescribed form or manner unless he has a reasonable excuse` TRUE AT 0 WITH
    PARTY `the person` DOES `make a disclosure otherwise than in the prescribed form or manner` AT 2
-- (3): a form that includes a request must state and explain
#ASSERT `s 339(3) the form complies with the requirements for a form that includes a request` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339(3) the form complies with the requirements for a form that includes a request` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 339(3) the form complies with the requirements for a form that includes a request` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339(3) the form complies with the requirements for a form that includes a request` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 339(4) the disclosure is not to be taken to breach a restriction on the disclosure of information` TRUE EQUALS JUST TRUE
#ASSERT `s 339(4) the disclosure is not to be taken to breach a restriction on the disclosure of information` FALSE EQUALS NOTHING
#ASSERT `s 339(7) subsection (2) does not apply to the disclosure` TRUE EQUALS JUST TRUE
#ASSERT `s 339(7) subsection (2) does not apply to the disclosure` FALSE EQUALS NOTHING

§ `s 339ZA disclosure to the NCA`
-- the duty arises "Where a disclosure is made under this Part to a constable or an officer of Revenue and Customs": a constable includes a person authorised by the Director General of the NCA (s 340(13))
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `a constable` EQUALS JUST TRUE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `an officer of Revenue and Customs` EQUALS JUST TRUE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` EQUALS JUST TRUE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `a customs officer` EQUALS JUST FALSE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `a nominated officer` EQUALS JUST FALSE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` TRUE `anyone else` EQUALS JUST FALSE
#ASSERT `s 339ZA the constable or officer of Revenue and Customs must disclose it in full to an authorised person` FALSE `a constable` EQUALS JUST FALSE
-- the duty has no period ("as soon as practicable"), so with no event the duty stands, and the event discharges it
#TRACE `s 339ZA the constable or officer of Revenue and Customs must disclose the disclosure in full to an authorised person` TRUE `a constable` AT 0 WITH
    PARTY `the constable or officer of Revenue and Customs` DOES `disclose in full to a person authorised by the Director General of the National Crime Agency` AT 5
#TRACE `s 339ZA the constable or officer of Revenue and Customs must disclose the disclosure in full to an authorised person` TRUE `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` AT 0 WITH
    WAITUNTIL 30
#TRACE `s 339ZA the constable or officer of Revenue and Customs must disclose the disclosure in full to an authorised person` TRUE `a customs officer` AT 0 WITH
    WAITUNTIL 30
#TRACE `s 339ZA the constable or officer of Revenue and Customs must disclose the disclosure in full to an authorised person` FALSE `a constable` AT 0 WITH
    WAITUNTIL 30

