IMPORT prelude
IMPORT `poca-nouns`
IMPORT `poca-orders`

-- Tests for poca-orders.l4 (sections 339ZH to 339ZL).  Every expected value is written from the text before the run.

§ `s 339ZH(4) condition 1`
-- arguments: relates to a matter arising from a disclosure under this Part; respondent made the disclosure; respondent otherwise carries on regulated-sector business; assists investigation; reasonable
#ASSERT `s 339ZH(4) condition 1 is met` TRUE TRUE FALSE TRUE TRUE
#ASSERT `s 339ZH(4) condition 1 is met` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(4) condition 1 is met` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT `s 339ZH(4) condition 1 is met` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(4) condition 1 is met` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 339ZH(4) condition 1 is met` TRUE TRUE TRUE TRUE FALSE

§ `s 339ZH(5) and (6) condition 2, external request`
#ASSERT `s 339ZH(5) condition 2 is met` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(5) condition 2 is met` FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(5) condition 2 is met` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(5) condition 2 is met` TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `s 339ZH(5) condition 2 is met` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 339ZH(5) condition 2 is met` TRUE TRUE TRUE TRUE FALSE
#ASSERT `s 339ZH(6) the request is an external request` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(6) the request is an external request` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(6) the request is an external request` FALSE TRUE EQUALS JUST FALSE

§ `s 339ZH(6A) condition 3`
-- arguments: operational analysis, strategic analysis, for the criminal intelligence function, respondent in regulated sector, court, magistrates' court regard to code, sheriff application by procurator fiscal at request, requester regard to code, reasonable
#ASSERT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT `s 339ZH(6A) condition 3 is met` FALSE TRUE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` FALSE FALSE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE FALSE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE FALSE `a magistrates' court` TRUE FALSE FALSE TRUE
-- a magistrates' court application where the applicant did not have regard to the code
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `a magistrates' court` FALSE FALSE FALSE TRUE
-- the sheriff: by a procurator fiscal at the request, and the requester had regard to the code
#ASSERT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `the sheriff` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `the sheriff` FALSE FALSE TRUE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `the sheriff` FALSE TRUE FALSE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `another court` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(6A) condition 3 is met` TRUE FALSE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE FALSE

§ `s 339ZH(6B) condition 4`
-- arguments: foreign FIU request to the NCA, reasonable grounds as to purpose and value, for the criminal intelligence function, respondent in regulated sector, court, magistrates' court regard to code, sheriff by procurator fiscal at request, requester regard to code, reasonable
#ASSERT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` FALSE TRUE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE FALSE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE FALSE TRUE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE FALSE `a magistrates' court` TRUE FALSE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `a magistrates' court` FALSE FALSE FALSE TRUE
#ASSERT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `the sheriff` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `the sheriff` FALSE TRUE FALSE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `the sheriff` FALSE FALSE TRUE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `another court` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 339ZH(6B) condition 4 is met` TRUE TRUE TRUE TRUE `a magistrates' court` TRUE FALSE FALSE FALSE

§ `s 339ZH(1) to (3), (7) to (9): the order`
-- arguments: court, application by a relevant person, conditions 1 to 4
#ASSERT `s 339ZH(1) the court may make an information order` `a magistrates' court` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZH(1) the court may make an information order` `a magistrates' court` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZH(1) the court may make an information order` `the sheriff` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZH(1) the court may make an information order` `the sheriff` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(1) the court may make an information order` `a magistrates' court` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(1) the court may make an information order` `a magistrates' court` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 339ZH(1) the court may make an information order` `another court` TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 339ZH(2) the application has the content it must have` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(2) the application has the content it must have` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 339ZH(2) the application has the content it must have` TRUE FALSE EQUALS JUST FALSE
-- (3): specified or other appropriate information, so far as in the respondent's possession or control
#ASSERT `s 339ZH(3) the information order requires the respondent to provide the information` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(3) the information order requires the respondent to provide the information` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(3) the information order requires the respondent to provide the information` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 339ZH(3) the information order requires the respondent to provide the information` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 339ZH(7) the information order has the content it must have` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(7) the information order has the content it must have` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(7) the information order has the content it must have` FALSE TRUE EQUALS JUST FALSE
-- (8): an amount not exceeding 5,000 pounds
#ASSERT `s 339ZH(8) the magistrates' court may order the person to pay the amount` TRUE 5000 EQUALS JUST TRUE
#ASSERT `s 339ZH(8) the magistrates' court may order the person to pay the amount` TRUE 1 EQUALS JUST TRUE
#ASSERT `s 339ZH(8) the magistrates' court may order the person to pay the amount` TRUE 5001 EQUALS JUST FALSE
#ASSERT `s 339ZH(8) the magistrates' court may order the person to pay the amount` FALSE 100 EQUALS JUST FALSE
#ASSERT `s 339ZH(9) the sum is treated as adjudged to be paid by a conviction of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(9) the sum is treated as adjudged to be paid by a conviction of the court` FALSE EQUALS NOTHING
#ASSERT `s 339ZH(11) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 339ZH(11) the business is a business in the regulated sector` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 339ZH(11) the business is a business in the regulated sector` NOTHING EQUALS NOTHING

§ `s 339ZH(12) definitions`
#ASSERT `s 339ZH(12) the person is an authorised NCA officer` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the person is an authorised NCA officer` FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the requirement is a corresponding disclosure requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the requirement is a corresponding disclosure requirement` FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the offence is a corresponding money laundering offence` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the offence is a corresponding money laundering offence` FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the function is the criminal intelligence function` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the function is the criminal intelligence function` FALSE EQUALS NOTHING
#ASSERT `s 339ZH(12) the place is a foreign country` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the place is a foreign country` FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the body is a foreign FIU` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the body is a foreign FIU` FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the applicant is a relevant person` `a magistrates' court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the applicant is a relevant person` `a magistrates' court` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the applicant is a relevant person` `the sheriff` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZH(12) the applicant is a relevant person` `the sheriff` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZH(12) the applicant is a relevant person` `another court` TRUE TRUE EQUALS NOTHING

§ `s 339ZL the code of practice`
#ASSERT `s 339ZL(7) the failure of itself makes the person liable to criminal or civil proceedings` TRUE EQUALS JUST FALSE
#ASSERT `s 339ZL(7) the failure of itself makes the person liable to criminal or civil proceedings` FALSE EQUALS NOTHING
#ASSERT `s 339ZL(8) the code is admissible in evidence and is to be taken into account` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZL(8) the code is admissible in evidence and is to be taken into account` TRUE FALSE EQUALS NOTHING
#ASSERT `s 339ZL(8) the code is admissible in evidence and is to be taken into account` FALSE TRUE EQUALS NOTHING

§ `s 339ZI statements`
-- arguments: made in response to an information order, used in evidence against the person in criminal proceedings, an exception in (2) applies
#ASSERT `s 339ZI(1) the statement may be used in evidence against the person in criminal proceedings` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZI(1) the statement may be used in evidence against the person in criminal proceedings` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 339ZI(1) the statement may be used in evidence against the person in criminal proceedings` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 339ZI(1) the statement may be used in evidence against the person in criminal proceedings` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 339ZI(4) the prosecution is a prosecution for perjury` `a prosecution for an offence under section 5 of the Perjury Act 1911 (England and Wales)` EQUALS JUST TRUE
#ASSERT `s 339ZI(4) the prosecution is a prosecution for perjury` `a prosecution for an offence under Article 10 of the Perjury (Northern Ireland) Order 1979 (Northern Ireland)` EQUALS JUST TRUE
#ASSERT `s 339ZI(4) the prosecution is a prosecution for perjury` `a prosecution for perjury in Scotland` EQUALS NOTHING
#ASSERT `s 339ZI(4) the prosecution is a prosecution for perjury` `a prosecution for another offence` EQUALS JUST FALSE
-- (3): barred unless evidence is adduced or a question is asked by or for the person
#ASSERT `s 339ZI(3) use of the statement by virtue of subsection (2)(c) is barred` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZI(3) use of the statement by virtue of subsection (2)(c) is barred` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZI(3) use of the statement by virtue of subsection (2)(c) is barred` FALSE TRUE EQUALS JUST FALSE
-- (2): the three exceptions; (c) only if the use is not barred by (3)
#ASSERT `s 339ZI(2) subsection (1) does not apply` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZI(2) subsection (1) does not apply` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZI(2) subsection (1) does not apply` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZI(2) subsection (1) does not apply` FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 339ZI(2) subsection (1) does not apply` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 339ZJ appeals`
#ASSERT `s 339ZJ(1) an appeal lies to the relevant appeal court` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZJ(1) an appeal lies to the relevant appeal court` FALSE EQUALS NOTHING
#ASSERT `s 339ZJ(2) the appeal lies at the instance of the person` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZJ(2) the appeal lies at the instance of the person` FALSE EQUALS NOTHING
#ASSERT `s 339ZJ(3) the relevant appeal court` `a magistrates' court in England and Wales` EQUALS JUST `the Crown Court`
#ASSERT `s 339ZJ(3) the relevant appeal court` `a magistrates' court in Northern Ireland` EQUALS JUST `a county court`
#ASSERT `s 339ZJ(3) the relevant appeal court` `the sheriff` EQUALS JUST `the Sheriff Appeal Court`
#ASSERT `s 339ZJ(3) the relevant appeal court` `another decision-maker` EQUALS NOTHING
#ASSERT `s 339ZJ(4) the relevant appeal court may do the thing on an appeal under this section` `make an information order` EQUALS JUST TRUE
#ASSERT `s 339ZJ(4) the relevant appeal court may do the thing on an appeal under this section` `discharge an information order` EQUALS JUST TRUE
#ASSERT `s 339ZJ(4) the relevant appeal court may do the thing on an appeal under this section` `vary the order` EQUALS JUST TRUE
#ASSERT `s 339ZJ(4) the relevant appeal court may do the thing on an appeal under this section` `something else` EQUALS NOTHING

§ `s 339ZK supplementary`
#ASSERT `s 339ZK(2) the information is privileged information` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 339ZK(2) the information is privileged information` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 339ZK(2) the information is privileged information` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 339ZK(1) the information order confers the right to require the person to provide the information` TRUE EQUALS JUST FALSE
#ASSERT `s 339ZK(1) the information order confers the right to require the person to provide the information` FALSE EQUALS NOTHING
#ASSERT `s 339ZK(3) the provision is not to be taken to breach a restriction on the disclosure of information` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZK(3) the provision is not to be taken to breach a restriction on the disclosure of information` FALSE EQUALS NOTHING
#ASSERT `s 339ZK(4) the application may be heard and determined in private` TRUE EQUALS JUST TRUE
#ASSERT `s 339ZK(4) the application may be heard and determined in private` FALSE EQUALS NOTHING
