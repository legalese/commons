#ASSERT `s 330(12)(a) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 330(12)(a) the business is a business in the regulated sector` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 330(12)(a) the business is a business in the regulated sector` NOTHING EQUALS NOTHING
#ASSERT `s 330(12)(b) the body is a supervisory authority` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 330(12)(b) the body is a supervisory authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 330(12)(b) the body is a supervisory authority` NOTHING EQUALS NOTHING
#ASSERT `s 330(13) the body is an appropriate body` TRUE EQUALS JUST TRUE
#ASSERT `s 330(13) the body is an appropriate body` FALSE EQUALS JUST FALSE
-- (14): Adviser fields are: professional legal adviser; accountant, auditor or tax adviser; member of such a professional body; competence testing; standards; sanctions
#ASSERT `s 330(14) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 330(14) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 330(14) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
