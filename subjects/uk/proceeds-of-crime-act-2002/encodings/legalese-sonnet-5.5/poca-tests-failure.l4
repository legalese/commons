#ASSERT `s 330(14) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 330(14) the person is a relevant professional adviser` (`Adviser` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE

