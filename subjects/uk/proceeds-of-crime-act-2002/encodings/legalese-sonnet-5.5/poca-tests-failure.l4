#ASSERT `s 330(9A) the disclosure is a disclosure to a nominated officer` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 330(9A) the disclosure is a disclosure to a nominated officer` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(9A) the disclosure is a disclosure to a nominated officer` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
