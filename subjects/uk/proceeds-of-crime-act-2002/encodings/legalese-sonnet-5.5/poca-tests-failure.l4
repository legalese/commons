IMPORT prelude
IMPORT `poca-nouns`
IMPORT `poca-failure`

-- Tests for poca-failure.l4 (sections 330, 331, 332).  Every expected value is written from the text before the run.

§ `s 330 the conditions`
#ASSERT `s 330(2) the first condition is satisfied` TRUE FALSE
#ASSERT `s 330(2) the first condition is satisfied` FALSE TRUE
#ASSERT `s 330(2) the first condition is satisfied` TRUE TRUE
#ASSERT NOT `s 330(2) the first condition is satisfied` FALSE FALSE
-- arguments: the Schedule 9 answer, then whether the information came to him in the course of that business
#ASSERT `s 330(3) the second condition is satisfied` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 330(3) the second condition is satisfied` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 330(3) the second condition is satisfied` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 330(3) the second condition is satisfied` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 330(3) the second condition is satisfied` NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 330(3A) the third condition is satisfied` TRUE FALSE
#ASSERT `s 330(3A) the third condition is satisfied` FALSE TRUE
#ASSERT NOT `s 330(3A) the third condition is satisfied` FALSE FALSE
-- (4) is satisfied when the required disclosure was NOT made, to a nominated officer or an authorised person, as soon as practicable
#ASSERT NOT `s 330(4) the fourth condition is satisfied` TRUE FALSE TRUE
#ASSERT NOT `s 330(4) the fourth condition is satisfied` FALSE TRUE TRUE
#ASSERT NOT `s 330(4) the fourth condition is satisfied` TRUE TRUE TRUE
#ASSERT `s 330(4) the fourth condition is satisfied` TRUE FALSE FALSE
#ASSERT `s 330(4) the fourth condition is satisfied` FALSE TRUE FALSE
#ASSERT `s 330(4) the fourth condition is satisfied` FALSE FALSE TRUE
#ASSERT `s 330(4) the fourth condition is satisfied` FALSE FALSE FALSE
-- (5): knows identity, gives identity, knows whereabouts, gives whereabouts, gives the information
#ASSERT `s 330(5) the disclosure is the required disclosure` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(5) the disclosure is the required disclosure` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(5) the disclosure is the required disclosure` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(5) the disclosure is the required disclosure` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 330(5) the disclosure is the required disclosure` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 330(5) the disclosure is the required disclosure` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(5) the disclosure is the required disclosure` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 330(5) the disclosure is the required disclosure` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 330(5A) the property is the laundered property` TRUE EQUALS JUST TRUE
#ASSERT `s 330(5A) the property is the laundered property` FALSE EQUALS JUST FALSE

§ `s 330 the exceptions`
#ASSERT `s 330(6)(a) the exception for a reasonable excuse applies` TRUE
#ASSERT NOT `s 330(6)(a) the exception for a reasonable excuse applies` FALSE
-- (6)(b): an adviser; knows either thing; knows it because of privileged information; the information of subsection (3) came in privileged circumstances
#ASSERT `s 330(6)(b) the exception for a professional adviser applies` TRUE TRUE TRUE FALSE
#ASSERT `s 330(6)(b) the exception for a professional adviser applies` TRUE FALSE FALSE TRUE
#ASSERT `s 330(6)(b) the exception for a professional adviser applies` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 330(6)(b) the exception for a professional adviser applies` TRUE TRUE FALSE FALSE
-- the literal reading of (i): an adviser who knows neither thing satisfies (i) vacuously (NOTES.md, marginal readings)
#ASSERT `s 330(6)(b) the exception for a professional adviser applies` TRUE FALSE FALSE FALSE
#ASSERT NOT `s 330(6)(b) the exception for a professional adviser applies` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 330(6)(b) the exception for a professional adviser applies` FALSE FALSE FALSE FALSE
#ASSERT `s 330(6)(c) subsection (7) or (7B) applies to him` TRUE FALSE
#ASSERT `s 330(6)(c) subsection (7) or (7B) applies to him` FALSE TRUE
#ASSERT NOT `s 330(6)(c) subsection (7) or (7B) applies to him` FALSE FALSE
-- (7): does not know or suspect; has been provided with the specified training
#ASSERT `s 330(7) the exception for an untrained person who does not know or suspect applies` TRUE FALSE
#ASSERT NOT `s 330(7) the exception for an untrained person who does not know or suspect applies` TRUE TRUE
#ASSERT NOT `s 330(7) the exception for an untrained person who does not know or suspect applies` FALSE FALSE
#ASSERT NOT `s 330(7) the exception for an untrained person who does not know or suspect applies` FALSE TRUE
#ASSERT `s 330(7B) the exception for a person assisting an adviser applies` TRUE TRUE TRUE
#ASSERT NOT `s 330(7B) the exception for a person assisting an adviser applies` FALSE TRUE TRUE
#ASSERT NOT `s 330(7B) the exception for a person assisting an adviser applies` TRUE FALSE TRUE
#ASSERT NOT `s 330(7B) the exception for a person assisting an adviser applies` TRUE TRUE FALSE
-- (7C): knows it occurs abroad; not unlawful there; of a prescribed description
#ASSERT `s 330(7C) the exception for money laundering lawful abroad applies` TRUE TRUE FALSE
#ASSERT NOT `s 330(7C) the exception for money laundering lawful abroad applies` TRUE TRUE TRUE
#ASSERT NOT `s 330(7C) the exception for money laundering lawful abroad applies` FALSE TRUE FALSE
#ASSERT NOT `s 330(7C) the exception for money laundering lawful abroad applies` TRUE FALSE FALSE
#ASSERT `s 330(7D) the exception for information from an immigration check applies` TRUE TRUE
#ASSERT NOT `s 330(7D) the exception for information from an immigration check applies` TRUE FALSE
#ASSERT NOT `s 330(7D) the exception for information from an immigration check applies` FALSE TRUE
#ASSERT `s 330(7E) the exception for information from an eligibility verification notice applies` TRUE TRUE
#ASSERT NOT `s 330(7E) the exception for information from an eligibility verification notice applies` TRUE FALSE
#ASSERT NOT `s 330(7E) the exception for information from an eligibility verification notice applies` FALSE TRUE
-- the six exceptions, one at a time and none
#ASSERT `s 330(6) to (7E) one of the exceptions applies` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 330(6) to (7E) one of the exceptions applies` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 330(6) to (7E) one of the exceptions applies` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 330(6) to (7E) one of the exceptions applies` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 330(6) to (7E) one of the exceptions applies` FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 330(6) to (7E) one of the exceptions applies` FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `s 330(6) to (7E) one of the exceptions applies` FALSE FALSE FALSE FALSE FALSE FALSE

§ `s 330 the offence, the duty and the guidance`
-- arguments: first condition, second condition, third condition, fourth condition, an exception applies
#ASSERT `s 330(1) the person commits an offence` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 330(1) the person commits an offence` TRUE NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 330(1) the person commits an offence` TRUE (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` FALSE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` TRUE (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` TRUE NOTHING TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits an offence` FALSE NOTHING TRUE TRUE FALSE EQUALS JUST FALSE
-- the duty twin: first, second, third conditions and an exception (the fourth condition is the failure, so it is not an input)
#ASSERT `s 330(1) the person must make the required disclosure` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 330(1) the person must make the required disclosure` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 330(1) the person must make the required disclosure` FALSE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person must make the required disclosure` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person must make the required disclosure` TRUE NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 330(1) the person must make the required disclosure` TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
-- the regulative twin: no period is stated, so only the act discharges the duty
#TRACE `s 330(4) the person must make the required disclosure to a nominated officer or an authorised person as soon as practicable` (JUST TRUE) AT 0 WITH
    PARTY `the person` DOES `make the required disclosure` AT 5
#TRACE `s 330(4) the person must make the required disclosure to a nominated officer or an authorised person as soon as practicable` (JUST TRUE) AT 0 WITH
    WAITUNTIL 1000
#TRACE `s 330(4) the person must make the required disclosure to a nominated officer or an authorised person as soon as practicable` (JUST FALSE) AT 0 WITH
    WAITUNTIL 1000
#TRACE `s 330(4) the person must make the required disclosure to a nominated officer or an authorised person as soon as practicable` NOTHING AT 0 WITH
    WAITUNTIL 1000
-- (8): all four limbs, or the court is not told to consider it
#ASSERT `s 330(8) the court must consider whether he followed the guidance` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(8) the court must consider whether he followed the guidance` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 330(8) the court must consider whether he followed the guidance` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 330(8) the court must consider whether he followed the guidance` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 330(8) the court must consider whether he followed the guidance` TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `s 330 nominated officer, privileged circumstances and the defined terms`
#ASSERT `s 330(9) the disclosure satisfies paragraphs (a) and (b) of the definition of a disclosure to a nominated officer` TRUE TRUE
#ASSERT NOT `s 330(9) the disclosure satisfies paragraphs (a) and (b) of the definition of a disclosure to a nominated officer` TRUE FALSE
#ASSERT NOT `s 330(9) the disclosure satisfies paragraphs (a) and (b) of the definition of a disclosure to a nominated officer` FALSE TRUE
