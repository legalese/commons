IMPORT prelude
IMPORT `poca-nouns`
IMPORT `poca-sch9`

-- Tests for poca-sch9.l4 (Schedule 9).  Every expected value is written from the text of Schedule 9 before the run; none is copied from output.
-- Arguments are positional, in the order of the rule's GIVEN.

§ `Schedule 9, para 1(2): credit institution`
-- The three alternatives each suffice; with none the text's "means" says no.
#ASSERT `sch 9 para 1(2) the person is a credit institution` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 9 para 1(2) the person is a credit institution` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 9 para 1(2) the person is a credit institution` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 9 para 1(2) the person is a credit institution` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Schedule 9, para 1(1)(a) to (e)`
-- (a) a credit institution that accepts deposits, or that grants credits for its own account; not a body that is not a credit institution
#ASSERT `sch 9 para 1(1)(a) the business consists of accepting deposits or granting credits as a credit institution` TRUE TRUE FALSE
#ASSERT `sch 9 para 1(1)(a) the business consists of accepting deposits or granting credits as a credit institution` TRUE FALSE TRUE
#ASSERT NOT `sch 9 para 1(1)(a) the business consists of accepting deposits or granting credits as a credit institution` FALSE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(a) the business consists of accepting deposits or granting credits as a credit institution` TRUE FALSE FALSE
-- (b) arguments: carries on a listed activity, credit institution, only listed activity as creditor, aa, bb, cc, only own-account trading, acts on behalf of a customer
#ASSERT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
-- (b)(i): a credit institution is carved out
#ASSERT NOT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- (b)(ia): carved out only when the creditor agreement meets (aa), (bb) and (cc) together
#ASSERT NOT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE
#ASSERT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE TRUE FALSE TRUE TRUE FALSE FALSE
-- (b)(ii): carved out when it only trades for own account and does not act on behalf of a customer; not when it does
#ASSERT NOT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `sch 9 para 1(1)(b) the business consists of listed activities carried on by an undertaking not excluded by (i), (ia) or (ii)` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE
-- (c) authorised person, long-term insurance, other than a reinsurance contract
#ASSERT `sch 9 para 1(1)(c) the business consists of long-term insurance other than reinsurance` TRUE TRUE FALSE
#ASSERT NOT `sch 9 para 1(1)(c) the business consists of long-term insurance other than reinsurance` TRUE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(c) the business consists of long-term insurance other than reinsurance` TRUE FALSE FALSE
#ASSERT NOT `sch 9 para 1(1)(c) the business consists of long-term insurance other than reinsurance` FALSE TRUE FALSE
-- (d) investment services by a person not within an exclusion whose regular occupation it is
#ASSERT `sch 9 para 1(1)(d) the business consists of investment services or activities by a person not excluded` TRUE FALSE TRUE
#ASSERT NOT `sch 9 para 1(1)(d) the business consists of investment services or activities by a person not excluded` TRUE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(d) the business consists of investment services or activities by a person not excluded` TRUE FALSE FALSE
#ASSERT NOT `sch 9 para 1(1)(d) the business consists of investment services or activities by a person not excluded` FALSE FALSE TRUE
-- (e)
#ASSERT `sch 9 para 1(1)(e) the business consists of the marketing or offering of units or shares by a collective investment undertaking` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(e) the business consists of the marketing or offering of units or shares by a collective investment undertaking` TRUE FALSE

§ `Schedule 9, para 1(1)(f) to (m)`
#ASSERT `sch 9 para 1(1)(f) the business consists of the activities of an insurance intermediary in respect of long-term insurance` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(f) the business consists of the activities of an insurance intermediary in respect of long-term insurance` TRUE FALSE
#ASSERT `sch 9 para 1(1)(g) the business consists of activities in (b) to (f) carried on by a branch in the United Kingdom` TRUE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(g) the business consists of activities in (b) to (f) carried on by a branch in the United Kingdom` TRUE TRUE FALSE
#ASSERT `sch 9 para 1(1)(h) the business consists of the activities of the National Savings Bank` TRUE
#ASSERT NOT `sch 9 para 1(1)(h) the business consists of the activities of the National Savings Bank` FALSE
#ASSERT `sch 9 para 1(1)(i) the business consists of an activity for raising money under the National Loans Act 1968` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(i) the business consists of an activity for raising money under the National Loans Act 1968` TRUE FALSE
#ASSERT `sch 9 para 1(1)(j) the business consists of statutory audit work by a statutory auditor` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(j) the business consists of statutory audit work by a statutory auditor` TRUE FALSE
#ASSERT `sch 9 para 1(1)(ja) the business consists of local audit work by a local auditor` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(ja) the business consists of local audit work by a local auditor` FALSE TRUE
#ASSERT `sch 9 para 1(1)(k) the business consists of the activities of an insolvency practitioner` TRUE
#ASSERT NOT `sch 9 para 1(1)(k) the business consists of the activities of an insolvency practitioner` FALSE
#ASSERT `sch 9 para 1(1)(l) the business consists of the provision of accountancy services` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(l) the business consists of the provision of accountancy services` TRUE FALSE
#ASSERT `sch 9 para 1(1)(m) the business consists of material aid, assistance or advice in connection with tax affairs` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(m) the business consists of material aid, assistance or advice in connection with tax affairs` FALSE TRUE

§ `Schedule 9, para 1(1)(n) to (v)`
-- (n) arguments: buying and selling, managing client money, opening accounts, organising contributions, creating trusts and companies, legal or notarial services by way of business
#ASSERT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` FALSE TRUE FALSE FALSE FALSE TRUE
#ASSERT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` FALSE FALSE TRUE FALSE FALSE TRUE
#ASSERT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` FALSE FALSE FALSE TRUE FALSE TRUE
#ASSERT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` FALSE FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `sch 9 para 1(1)(n) the business consists of participation in a financial or real property transaction by a legal or notarial services provider` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `sch 9 para 1(1)(o) the business consists of a service mentioned in sub-paragraph (4)` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(o) the business consists of a service mentioned in sub-paragraph (4)` TRUE FALSE
-- (p) arguments: estate agency work, letting agency work, a firm or sole practitioner who carries on such work
#ASSERT `sch 9 para 1(1)(p) the business consists of estate agency work or letting agency work` TRUE FALSE TRUE
#ASSERT `sch 9 para 1(1)(p) the business consists of estate agency work or letting agency work` FALSE TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(p) the business consists of estate agency work or letting agency work` FALSE FALSE TRUE
#ASSERT NOT `sch 9 para 1(1)(p) the business consists of estate agency work or letting agency work` TRUE FALSE FALSE
-- (q) "at least 10,000" pounds in cash: the boundary is in
#ASSERT `sch 9 para 1(1)(q) the business consists of trading in goods where a transaction involves cash payments of at least 10,000 pounds in total` TRUE 10000 TRUE
#ASSERT NOT `sch 9 para 1(1)(q) the business consists of trading in goods where a transaction involves cash payments of at least 10,000 pounds in total` TRUE 9999 TRUE
#ASSERT NOT `sch 9 para 1(1)(q) the business consists of trading in goods where a transaction involves cash payments of at least 10,000 pounds in total` FALSE 20000 TRUE
#ASSERT NOT `sch 9 para 1(1)(q) the business consists of trading in goods where a transaction involves cash payments of at least 10,000 pounds in total` TRUE 20000 FALSE
#ASSERT `sch 9 para 1(1)(r) the business consists of operating a casino under a casino operating licence` TRUE
#ASSERT NOT `sch 9 para 1(1)(r) the business consists of operating a casino under a casino operating licence` FALSE
#ASSERT `sch 9 para 1(1)(s) the business consists of the auctioning by an auction platform of two-day spot or five-day futures` TRUE
#ASSERT NOT `sch 9 para 1(1)(s) the business consists of the auctioning by an auction platform of two-day spot or five-day futures` FALSE
#ASSERT `sch 9 para 1(1)(t) the business consists of bidding directly on behalf of clients in auctions of emissions allowances` TRUE
#ASSERT NOT `sch 9 para 1(1)(t) the business consists of bidding directly on behalf of clients in auctions of emissions allowances` FALSE
-- (u) arguments: firm or sole practitioner, trades in works of art, value, freeport operator, stores works of art, value stored; "amounts to 10,000 pounds or more" is inclusive
#ASSERT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE TRUE 10000 FALSE FALSE 0
#ASSERT NOT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE TRUE 9999 FALSE FALSE 0
#ASSERT NOT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE FALSE 50000 FALSE FALSE 0
#ASSERT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE FALSE 0 TRUE TRUE 10000
#ASSERT NOT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE FALSE 0 TRUE TRUE 9999
#ASSERT NOT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` TRUE FALSE 0 TRUE FALSE 10000
#ASSERT NOT `sch 9 para 1(1)(u) the business consists of activities in works of art of 10,000 pounds or more, or storing works of art in a freeport` FALSE TRUE 10000 FALSE FALSE 0
#ASSERT `sch 9 para 1(1)(v) the business consists of activities as a cryptoasset exchange provider or custodian wallet provider` TRUE TRUE
#ASSERT NOT `sch 9 para 1(1)(v) the business consists of activities as a cryptoasset exchange provider or custodian wallet provider` FALSE TRUE

§ `Schedule 9, para 1(1) aggregate`
-- 23 positional fields: (a) (b) (c) (d) (e) (f) (g) (h) (i) (j) (ja) (k) (l) (m) (n) (o) (p) (q) (r) (s) (t) (u) (v)
`no limb holds` MEANS `Limbs of paragraph 1(1) that hold` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`only limb (ja) holds` MEANS `Limbs of paragraph 1(1) that hold` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`only limb (v) holds` MEANS `Limbs of paragraph 1(1) that hold` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
#ASSERT `sch 9 para 1(1) the business is in the regulated sector to the extent that it consists of a listed activity` `only limb (ja) holds` EQUALS JUST TRUE
#ASSERT `sch 9 para 1(1) the business is in the regulated sector to the extent that it consists of a listed activity` `only limb (v) holds` EQUALS JUST TRUE
-- a business that fits no limb: the Schedule does not say it is outside the regulated sector, so "not covered" (the text's list is not closed with "only")
-- the Act hands the question to the list ("Schedule 9 has effect for the purpose of determining what is a business in the regulated sector", s 330(12)(a)): a business in no limb is not in the regulated sector
#ASSERT `sch 9 para 1(1) the business is in the regulated sector to the extent that it consists of a listed activity` `no limb holds` EQUALS JUST FALSE

