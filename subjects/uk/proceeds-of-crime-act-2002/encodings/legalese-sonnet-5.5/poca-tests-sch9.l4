§ `Schedule 9, para 2: excluded activities`
#ASSERT `sch 9 para 2(1)(a) the business consists of a registered society's issuing of withdrawable share capital or acceptance of deposits within the limits` TRUE TRUE
#ASSERT NOT `sch 9 para 2(1)(a) the business consists of a registered society's issuing of withdrawable share capital or acceptance of deposits within the limits` TRUE FALSE
#ASSERT `sch 9 para 2(1)(b) the business consists of a registered Northern Ireland society's issuing of withdrawable share capital or acceptance of deposits within the limits` TRUE TRUE
#ASSERT NOT `sch 9 para 2(1)(b) the business consists of a registered Northern Ireland society's issuing of withdrawable share capital or acceptance of deposits within the limits` FALSE TRUE
#ASSERT `sch 9 para 2(1)(c) the business consists of an activity for which a person specified in the Exemption Order is exempt` TRUE
#ASSERT NOT `sch 9 para 2(1)(c) the business consists of an activity for which a person specified in the Exemption Order is exempt` FALSE
#ASSERT `sch 9 para 2(1)(d) the business consists of the exercise of functions under section 45 of the Financial Services Act 1986 by a formerly exempted person` TRUE TRUE
#ASSERT NOT `sch 9 para 2(1)(d) the business consists of the exercise of functions under section 45 of the Financial Services Act 1986 by a formerly exempted person` TRUE FALSE
#ASSERT `sch 9 para 2(1)(e) the business consists of financial activity meeting the conditions in sub-paragraph (3) by a high value dealer` TRUE TRUE
#ASSERT NOT `sch 9 para 2(1)(e) the business consists of financial activity meeting the conditions in sub-paragraph (3) by a high value dealer` FALSE TRUE
#ASSERT `sch 9 para 2(1)(g) the business consists of an activity of a local authority that would be regulated but for article 72G` TRUE TRUE
#ASSERT NOT `sch 9 para 2(1)(g) the business consists of an activity of a local authority that would be regulated but for article 72G` TRUE FALSE
#ASSERT `sch 9 para 2(1)(h) the business consists of the preparation of a home report` TRUE
#ASSERT NOT `sch 9 para 2(1)(h) the business consists of the preparation of a home report` FALSE
-- 7 positional fields: (a) (b) (c) (d) (e) (g) (h)
`no exclusion holds` MEANS `Exclusions of paragraph 2(1) that hold` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`only exclusion (h) holds` MEANS `Exclusions of paragraph 2(1) that hold` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
#ASSERT `sch 9 para 2(1) the business is in the regulated sector to the extent that it consists of an excluded activity` `only exclusion (h) holds` EQUALS JUST FALSE
#ASSERT `sch 9 para 2(1) the business is in the regulated sector to the extent that it consists of an excluded activity` `no exclusion holds` EQUALS NOTHING
#ASSERT `sch 9 para 2(2) the person is a high value dealer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 9 para 2(2) the person is a high value dealer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 9 para 2(2) the person is a high value dealer` FALSE TRUE EQUALS JUST FALSE
-- para 2(3) arguments: turnover, greatest number of transactions over 1,000 with one customer, percentage of total turnover, ancillary, transmission of money, main activity within 1(1)(a)-(p),(r)-(t), only to customers of main activity, offered to the public
-- all of (a) to (g) hold: the text says the business is not in the regulated sector
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- (a) turnover must not exceed 100,000: 100,001 fails
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100001 1 5 TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (b) no more than one transaction exceeding 1,000: two fails
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 2 5 TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (c) must not exceed 5%: 6 fails
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 6 TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (d) ancillary
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (e) not transmission or remittance of money
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
-- (f) main activity not within 1(1)(a) to (p), (r) to (t)
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
-- (g) provided only to customers of the main activity and not offered to the public
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `sch 9 para 2(3) the business is in the regulated sector to the extent that it consists of financial activity` 100000 1 5 TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- para 2(4): the seven bodies; any other body is not covered
#ASSERT `sch 9 para 2(4) the business is in the regulated sector` `the Treasury Solicitor` EQUALS JUST FALSE
#ASSERT `sch 9 para 2(4) the business is in the regulated sector` `the Auditor General for Wales` EQUALS JUST FALSE
#ASSERT `sch 9 para 2(4) the business is in the regulated sector` `the Official Solicitor to the Supreme Court, when acting as trustee in his official capacity` EQUALS JUST FALSE
#ASSERT `sch 9 para 2(4) the business is in the regulated sector` `another body` EQUALS NOTHING

§ `Schedule 9, paras 1 and 2 together (hand-gathered)`
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` (JUST TRUE) NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` (JUST TRUE) NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE
-- a business in no head of para 1(1) and reached by no exclusion is not in the regulated sector (the hand-off of s 330(12)(a)); only a caller's NOTHING comes out as NOTHING
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `sch 9 paras 1 and 2 the business is in the regulated sector` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING

§ `Schedule 9, para 3: interpretation`
#ASSERT `sch 9 para 3(1) what the defined instrument means` `the Solvency 2 Directive` EQUALS JUST "Directive 2009/138/EC of the European Parliament and of the Council of 25 November 2009 on the taking-up and pursuit of the business of Insurance and Reinsurance (Solvency II)"
#ASSERT `sch 9 para 3(1) what the defined instrument means` `the Markets in Financial Instruments Directive` EQUALS JUST "directive 2014/65/EU of the European Parliament and of the Council of 15 May 2014 on markets in financial instruments"
#ASSERT `sch 9 para 3(1) what the defined instrument means` `another instrument` EQUALS NOTHING
#ASSERT `sch 9 para 3(2) the amount is within a reference to an amount in euros` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 9 para 3(2) the amount is within a reference to an amount in euros` FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 9 para 3(2) the amount is within a reference to an amount in euros` FALSE FALSE EQUALS NOTHING
#ASSERT `sch 9 para 3(3) the term has the same meaning in this Part as in that Regulation or Directive` TRUE EQUALS JUST TRUE
#ASSERT `sch 9 para 3(3) the term has the same meaning in this Part as in that Regulation or Directive` FALSE EQUALS NOTHING

