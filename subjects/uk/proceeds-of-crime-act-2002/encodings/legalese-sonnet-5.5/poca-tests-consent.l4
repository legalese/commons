IMPORT prelude
IMPORT daydate
IMPORT `poca-nouns`
IMPORT `poca-consent`

-- Tests for poca-consent.l4 (sections 335 to 336D).  Every expected value is written from the text before the run.
-- Calendar facts used (2026): Monday 2 November; Saturday 7 November; Friday 25 December (Christmas Day); Friday 1 January 2027.

`no holidays` MEANS EMPTY
`a bank holiday on Tuesday 10 November` MEANS LIST (Date 10 11 2026)
`boxing day and new year holidays` MEANS LIST (Date 28 12 2026), (Date 1 1 2027)

§ `s 335(1) the appropriate consent`
#ASSERT `s 335(1) the consent is the appropriate consent` `a nominated officer` `a nominated officer` EQUALS JUST TRUE
#ASSERT `s 335(1) the consent is the appropriate consent` `a constable` `a constable` EQUALS JUST TRUE
#ASSERT `s 335(1) the consent is the appropriate consent` `a customs officer` `a customs officer` EQUALS JUST TRUE
-- s 340(13): "References to a constable include references to a person authorised for the purposes of this Part by the Director General of the National Crime Agency"
#ASSERT `s 335(1) the consent is the appropriate consent` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` EQUALS JUST TRUE
#ASSERT `s 335(1) the consent is the appropriate consent` `a constable` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` EQUALS JUST TRUE
#ASSERT `s 335(1) the consent is the appropriate consent` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `a constable` EQUALS JUST TRUE
#ASSERT `s 335(1) the consent is the appropriate consent` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `a customs officer` EQUALS JUST FALSE
#ASSERT `s 335(1) the consent is the appropriate consent` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `a nominated officer` EQUALS JUST FALSE
#ASSERT `s 335(1) the consent is the appropriate consent` `a nominated officer` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` EQUALS JUST FALSE
-- the consent of one kind of officer does not answer a disclosure made to another
#ASSERT `s 335(1) the consent is the appropriate consent` `a constable` `a nominated officer` EQUALS JUST FALSE
#ASSERT `s 335(1) the consent is the appropriate consent` `a nominated officer` `a customs officer` EQUALS JUST FALSE
#ASSERT `s 335(1) the consent is the appropriate consent` `anyone else` `a constable` EQUALS JUST FALSE

§ `s 335(5) the notice period`
-- disclosure on Monday 2 November: the first working day after is Tuesday 3 November (day 1); seven working days end on Wednesday 11 November
#ASSERT `s 335(5) the first day of the notice period` (Date 2 11 2026) `no holidays` EQUALS Date 3 11 2026
#ASSERT `s 335(5) the last day of the notice period` (Date 2 11 2026) `no holidays` EQUALS Date 11 11 2026
-- a bank holiday on Tuesday 10 November pushes the seventh working day to Thursday 12 November
#ASSERT `s 335(5) the last day of the notice period` (Date 2 11 2026) `a bank holiday on Tuesday 10 November` EQUALS Date 12 11 2026
-- disclosure on Friday 6 November: the first working day after is Monday 9 November; the seventh is Tuesday 17 November
#ASSERT `s 335(5) the first day of the notice period` (Date 6 11 2026) `no holidays` EQUALS Date 9 11 2026
#ASSERT `s 335(5) the last day of the notice period` (Date 6 11 2026) `no holidays` EQUALS Date 17 11 2026
-- disclosure on Saturday 7 November: the same period as Friday's
#ASSERT `s 335(5) the first day of the notice period` (Date 7 11 2026) `no holidays` EQUALS Date 9 11 2026
#ASSERT `s 335(5) the last day of the notice period` (Date 7 11 2026) `no holidays` EQUALS Date 17 11 2026
-- disclosure on Thursday 24 December: Christmas Day (Friday 25) is not a working day even though the list is empty; Monday 28 December is day 1, and day 7 is Tuesday 5 January 2027
#ASSERT `s 335(5) the first day of the notice period` (Date 24 12 2026) `no holidays` EQUALS Date 28 12 2026
#ASSERT `s 335(5) the last day of the notice period` (Date 24 12 2026) `no holidays` EQUALS Date 5 1 2027
-- disclosure on Tuesday 22 December with Monday 28 December and Friday 1 January listed: Wed 23 (1), Thu 24 (2), Tue 29 (3), Wed 30 (4), Thu 31 (5), Mon 4 Jan (6), Tue 5 Jan (7)
#ASSERT `s 335(5) the last day of the notice period` (Date 22 12 2026) `boxing day and new year holidays` EQUALS Date 5 1 2027

§ `s 335(6) the moratorium period`
-- 31 days starting with 9 November 2026: the first day is 9 November, the last is 9 December
#ASSERT `s 335(6) the last day of the moratorium period` (Date 9 11 2026) 0 EQUALS Date 9 12 2026
-- extended by 31 days (an extension under section 336A or 336C)
#ASSERT `s 335(6) the last day of the moratorium period` (Date 9 11 2026) 31 EQUALS Date 9 1 2027

§ `s 335(7) a working day`
#ASSERT `s 335(7) the day is a working day` (Date 3 11 2026) `no holidays` EQUALS JUST TRUE
#ASSERT `s 335(7) the day is a working day` (Date 7 11 2026) `no holidays` EQUALS JUST FALSE
#ASSERT `s 335(7) the day is a working day` (Date 8 11 2026) `no holidays` EQUALS JUST FALSE
#ASSERT `s 335(7) the day is a working day` (Date 25 12 2026) `no holidays` EQUALS JUST FALSE
#ASSERT `s 335(7) the day is a working day` (Date 10 11 2026) `a bank holiday on Tuesday 10 November` EQUALS JUST FALSE
#ASSERT `s 335(7) the day is a working day` (Date 11 11 2026) `a bank holiday on Tuesday 10 November` EQUALS JUST TRUE

§ `s 335(3) and (4) the conditions`
-- (3): no notice at all, asked after the last day of the notice period (11 November)
#ASSERT `s 335(3) the condition is satisfied` NOTHING (Date 11 11 2026) (Date 12 11 2026)
-- asked on the last day itself: the notice period has not ended
#ASSERT NOT `s 335(3) the condition is satisfied` NOTHING (Date 11 11 2026) (Date 11 11 2026)
-- a notice received after the notice period ended does not defeat (3)
#ASSERT `s 335(3) the condition is satisfied` (JUST (Date 12 11 2026)) (Date 11 11 2026) (Date 13 11 2026)
-- a notice received on the last day of the notice period is "before the end" of it: (3) fails
#ASSERT NOT `s 335(3) the condition is satisfied` (JUST (Date 11 11 2026)) (Date 11 11 2026) (Date 20 11 2026)
-- (4): notice on the last day (11 November); moratorium is 31 days from 11 November: last day 11 December; expired on 12 December
#ASSERT `s 335(4) the condition is satisfied` (JUST (Date 11 11 2026)) (Date 11 11 2026) 0 (Date 12 12 2026)
#ASSERT NOT `s 335(4) the condition is satisfied` (JUST (Date 11 11 2026)) (Date 11 11 2026) 0 (Date 11 12 2026)
-- the period extended by 10 days is not expired on 12 December
#ASSERT NOT `s 335(4) the condition is satisfied` (JUST (Date 11 11 2026)) (Date 11 11 2026) 10 (Date 12 12 2026)
#ASSERT `s 335(4) the condition is satisfied` (JUST (Date 11 11 2026)) (Date 11 11 2026) 10 (Date 22 12 2026)
-- a notice that came after the notice period ended is outside (4)(a)
#ASSERT NOT `s 335(4) the condition is satisfied` (JUST (Date 12 11 2026)) (Date 11 11 2026) 0 (Date 31 12 2026)
-- no notice: (4) does not apply
#ASSERT NOT `s 335(4) the condition is satisfied` NOTHING (Date 11 11 2026) 0 (Date 31 12 2026)

§ `s 335(2) treated as having the appropriate consent`
-- disclosed Monday 2 November, no notice, asked Thursday 12 November (the notice period ended 11 November): treated as having consent
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) NOTHING `no holidays` 0 (Date 12 11 2026) EQUALS JUST TRUE
-- asked on 11 November, the last day of the notice period: not yet
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) NOTHING `no holidays` 0 (Date 11 11 2026) EQUALS JUST FALSE
-- refusal received 5 November (within the notice period); moratorium 31 days from 5 November ends 5 December; asked 4 December: not expired
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) (JUST (Date 5 11 2026)) `no holidays` 0 (Date 5 12 2026) EQUALS JUST FALSE
-- asked 6 December: expired
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) (JUST (Date 5 11 2026)) `no holidays` 0 (Date 6 12 2026) EQUALS JUST TRUE
-- the court extended the moratorium by 20 days: asked 6 December, still running
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) (JUST (Date 5 11 2026)) `no holidays` 20 (Date 6 12 2026) EQUALS JUST FALSE
-- refusal received late, on 12 November: (3) is satisfied asked on 13 November
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` TRUE (Date 2 11 2026) (JUST (Date 12 11 2026)) `no holidays` 0 (Date 13 11 2026) EQUALS JUST TRUE
-- no authorised disclosure to a constable or customs officer: (a) fails
#ASSERT `s 335(2) the person must be treated as having the appropriate consent` FALSE (Date 2 11 2026) NOTHING `no holidays` 0 (Date 30 11 2026) EQUALS JUST FALSE

-- s 335(2)(a): to whom the authorised disclosure was made; a person authorised by the Director General of the NCA is a constable (s 340(13))
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` TRUE `a constable` EQUALS JUST TRUE
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` TRUE `a customs officer` EQUALS JUST TRUE
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` TRUE `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` EQUALS JUST TRUE
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` TRUE `a nominated officer` EQUALS JUST FALSE
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` TRUE `an officer of Revenue and Customs` EQUALS JUST FALSE
#ASSERT `s 335(2)(a) he makes an authorised disclosure to a constable or a customs officer` FALSE `a constable` EQUALS JUST FALSE
§ `s 335(8) and (9)`
#ASSERT `s 335(8) the act is a prohibited act` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 335(8) the act is a prohibited act` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 335(8) the act is a prohibited act` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 335(8) the act is a prohibited act` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 335(9) the person is a nominated officer` TRUE EQUALS JUST TRUE
#ASSERT `s 335(9) the person is a nominated officer` FALSE EQUALS JUST FALSE

§ `s 336(2) to (4) the nominated officer's conditions`
#ASSERT `s 336(2) the condition is satisfied` TRUE TRUE
#ASSERT NOT `s 336(2) the condition is satisfied` TRUE FALSE
#ASSERT NOT `s 336(2) the condition is satisfied` FALSE TRUE
