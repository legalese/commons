-- (4): the moratorium period is 31 days from the day the nominated officer is given notice
#ASSERT `s 336(8) the last day of the moratorium period` (Date 11 11 2026) 0 EQUALS Date 11 12 2026
#ASSERT `s 336(8) the last day of the moratorium period` (Date 11 11 2026) 14 EQUALS Date 25 12 2026
#ASSERT `s 336(4) the condition is satisfied` TRUE (JUST (Date 11 11 2026)) (Date 11 11 2026) 0 (Date 12 12 2026)
#ASSERT NOT `s 336(4) the condition is satisfied` TRUE (JUST (Date 11 11 2026)) (Date 11 11 2026) 0 (Date 11 12 2026)
#ASSERT NOT `s 336(4) the condition is satisfied` TRUE (JUST (Date 12 11 2026)) (Date 11 11 2026) 0 (Date 31 12 2026)
#ASSERT NOT `s 336(4) the condition is satisfied` TRUE NOTHING (Date 11 11 2026) 0 (Date 31 12 2026)
#ASSERT NOT `s 336(4) the condition is satisfied` FALSE (JUST (Date 11 11 2026)) (Date 11 11 2026) 0 (Date 12 12 2026)
#ASSERT `s 336(9) the day is a working day` (Date 3 11 2026) `no holidays` EQUALS JUST TRUE
#ASSERT `s 336(9) the day is a working day` (Date 10 11 2026) `a bank holiday on Tuesday 10 November` EQUALS JUST FALSE

§ `s 336(1) the prohibition on the nominated officer`
#ASSERT `s 336(1) the nominated officer is prohibited from giving the appropriate consent` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 336(1) the nominated officer is prohibited from giving the appropriate consent` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 336(1) the nominated officer is prohibited from giving the appropriate consent` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 336(1) the nominated officer is prohibited from giving the appropriate consent` FALSE FALSE TRUE EQUALS JUST FALSE
-- the regulative twin: with no condition satisfied, giving the consent is a breach by the nominated officer; with one satisfied, nothing is breached
#TRACE `s 336(1) the nominated officer must not give the appropriate consent unless a condition is satisfied` FALSE AT 0 WITH
    PARTY `the nominated officer` DOES `give the appropriate consent to a prohibited act` AT 3
#TRACE `s 336(1) the nominated officer must not give the appropriate consent unless a condition is satisfied` TRUE AT 0 WITH
    PARTY `the nominated officer` DOES `give the appropriate consent to a prohibited act` AT 3
#TRACE `s 336(1) the nominated officer must not give the appropriate consent unless a condition is satisfied` FALSE AT 0 WITH
    WAITUNTIL 400

