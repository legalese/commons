IMPORT prelude
IMPORT `poca-threshold`

-- Tests for poca-threshold.l4 (section 339A).  Expected values are written from the text of section 339A before the run.

§ `s 339A(2) the account threshold`
-- no specification: 3,000 pounds
#ASSERT `s 339A(2) the threshold amount for acts done in operating an account, in pounds` NOTHING EQUALS 3000
-- a higher amount specified: that amount
#ASSERT `s 339A(2) the threshold amount for acts done in operating an account, in pounds` (JUST 5000) EQUALS 5000
-- just above the default
#ASSERT `s 339A(2) the threshold amount for acts done in operating an account, in pounds` (JUST 3001) EQUALS 3001
-- an amount equal to the default is not "higher": the default stands (the same figure)
#ASSERT `s 339A(2) the threshold amount for acts done in operating an account, in pounds` (JUST 3000) EQUALS 3000
-- an amount below the default is not "higher" (and subsection (6) forbids it): the default stands
#ASSERT `s 339A(2) the threshold amount for acts done in operating an account, in pounds` (JUST 2999) EQUALS 3000

§ `s 339A(3) to (5): who may specify and vary`
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `an officer of Revenue and Customs` `when giving consent to the doing of an act in opening or operating the account or a related account` EQUALS JUST TRUE
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `a constable` `when giving notice refusing consent to the doing of an act in opening or operating the account or a related account` EQUALS JUST TRUE
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `a constable` `on a request from the body or institution` EQUALS JUST TRUE
-- another occasion, or another person: the subsection does not say
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `a constable` `on another occasion` EQUALS NOTHING
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `another person` `on a request from the body or institution` EQUALS NOTHING
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `an officer of Revenue and Customs` TRUE EQUALS JUST TRUE
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `a constable` TRUE EQUALS JUST TRUE
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `a constable` FALSE EQUALS JUST FALSE
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `another person` TRUE EQUALS NOTHING
-- s 340(13): a person authorised by the Director General of the NCA is a constable
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `on a request from the body or institution` EQUALS JUST TRUE
#ASSERT `s 339A(3) the person may specify the threshold amount for acts done in operating an account` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` `on another occasion` EQUALS NOTHING
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` TRUE EQUALS JUST TRUE
#ASSERT `s 339A(4) the person may vary the threshold amount for acts done in operating an account` `a person authorised for the purposes of this Part by the Director General of the National Crime Agency` FALSE EQUALS JUST FALSE
#ASSERT `s 339A(5) different threshold amounts may be specified for different acts on the same account` TRUE EQUALS JUST TRUE
#ASSERT `s 339A(5) different threshold amounts may be specified for different acts on the same account` FALSE EQUALS NOTHING

§ `s 339A(6) the floor`
#ASSERT `s 339A(6) the specified amount is one that may be specified as the threshold amount` 3000 EQUALS JUST TRUE
#ASSERT `s 339A(6) the specified amount is one that may be specified as the threshold amount` 10000 EQUALS JUST TRUE
#ASSERT `s 339A(6) the specified amount is one that may be specified as the threshold amount` 2999 EQUALS JUST FALSE

§ `s 339A(6A) and (8)`
#ASSERT `s 339A(6A) the threshold amount for acts done to terminate a business relationship, in pounds` TRUE EQUALS JUST 3000
#ASSERT `s 339A(6A) the threshold amount for acts done to terminate a business relationship, in pounds` FALSE EQUALS NOTHING
#ASSERT `s 339A(8) the account is related to the other` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 339A(8) the account is related to the other` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 339A(8) the account is related to the other` FALSE TRUE EQUALS JUST FALSE
