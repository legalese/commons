IMPORT prelude
IMPORT `poca-nouns`
IMPORT `poca-tipping`

-- Tests for poca-tipping.l4 (sections 333 to 333E).  Every expected value is written from the text before the run.

§ `s 333A(2) the matters`
-- arguments: a disclosure under this Part has been made; the recipient; the information came in the course of a regulated-sector business
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `a constable` TRUE EQUALS JUST TRUE
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `an officer of Revenue and Customs` TRUE EQUALS JUST TRUE
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `a nominated officer` TRUE EQUALS JUST TRUE
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `a National Crime Agency officer authorised for the purposes of this Part by the Director General of that Agency` TRUE EQUALS JUST TRUE
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `someone else` TRUE EQUALS JUST FALSE
#ASSERT `s 333A(2) the matter is within subsection (2)` FALSE `a constable` TRUE EQUALS JUST FALSE
#ASSERT `s 333A(2) the matter is within subsection (2)` TRUE `a constable` FALSE EQUALS JUST FALSE

§ `s 333A(1) and (3) the offences`
-- (1): matter within (2) (a MAYBE BOOLEAN); likely to prejudice; Schedule 9 answer; information came in that business; a permitted disclosure of 333B-333D; the exception of 333D(3)
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST FALSE) TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` NOTHING TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` (JUST TRUE) TRUE (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333A(1) the person commits an offence by disclosing a matter within subsection (2)` NOTHING TRUE NOTHING TRUE TRUE FALSE EQUALS JUST FALSE
-- (3): discloses the investigation; likely to prejudice it; Schedule 9 answer; information came in that business; a permitted disclosure; the exception of 333D(4)
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` FALSE TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333A(3) the person commits an offence by disclosing an investigation` TRUE TRUE (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
-- (4): the penalties
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on summary conviction`)'s `months of imprisonment` EQUALS 3
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on summary conviction`)'s `ceiling of the fine` EQUALS `level 5 on the standard scale`
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on summary conviction`)'s `imprisonment and a fine may both be imposed`
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on conviction on indictment`)'s `months of imprisonment` EQUALS 24
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on conviction on indictment`)'s `ceiling of the fine` EQUALS `a fine with no ceiling stated`
#ASSERT (`s 333A(4) the most that can be imposed on a person guilty of an offence under section 333A` `on conviction on indictment`)'s `imprisonment and a fine may both be imposed`
-- (5)
#ASSERT `s 333A(5) one of the permitted disclosures of sections 333B to 333D applies` TRUE FALSE FALSE
#ASSERT `s 333A(5) one of the permitted disclosures of sections 333B to 333D applies` FALSE TRUE FALSE
#ASSERT `s 333A(5) one of the permitted disclosures of sections 333B to 333D applies` FALSE FALSE TRUE
#ASSERT NOT `s 333A(5) one of the permitted disclosures of sections 333B to 333D applies` FALSE FALSE FALSE
-- the prohibitions, derived from the offences
#TRACE `s 333A(1) the person must not disclose a matter within subsection (2)` (JUST TRUE) AT 0 WITH
    PARTY `the person` DOES `disclose a matter within section 333A(2)` AT 5
#TRACE `s 333A(1) the person must not disclose a matter within subsection (2)` (JUST FALSE) AT 0 WITH
    PARTY `the person` DOES `disclose a matter within section 333A(2)` AT 5
#TRACE `s 333A(1) the person must not disclose a matter within subsection (2)` NOTHING AT 0 WITH
    PARTY `the person` DOES `disclose a matter within section 333A(2)` AT 5
#TRACE `s 333A(3) the person must not disclose that an investigation is contemplated or is being carried out` (JUST TRUE) AT 0 WITH
    PARTY `the person` DOES `disclose the contemplated or actual investigation` AT 5
#TRACE `s 333A(3) the person must not disclose that an investigation is contemplated or is being carried out` (JUST FALSE) AT 0 WITH
    PARTY `the person` DOES `disclose the contemplated or actual investigation` AT 5

§ `s 333B permitted disclosures within an undertaking or group`
#ASSERT `s 333B(1) the disclosure within an undertaking is permitted` TRUE TRUE
#ASSERT NOT `s 333B(1) the disclosure within an undertaking is permitted` FALSE TRUE
#ASSERT NOT `s 333B(1) the disclosure within an undertaking is permitted` TRUE FALSE
-- (2): by a credit or financial institution; to one; recipient situated in the UK, an EEA state or an equivalent country; same group
#ASSERT `s 333B(2) the disclosure within a group of institutions is permitted` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 333B(2) the disclosure within a group of institutions is permitted` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 333B(2) the disclosure within a group of institutions is permitted` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 333B(2) the disclosure within a group of institutions is permitted` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 333B(2) the disclosure within a group of institutions is permitted` TRUE TRUE TRUE FALSE
#ASSERT `s 333B(3) the institutions belong to the same group` TRUE EQUALS JUST TRUE
#ASSERT `s 333B(3) the institutions belong to the same group` FALSE EQUALS NOTHING
#ASSERT `s 333B(4) the disclosure between advisers in undertakings under common control is permitted` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 333B(4) the disclosure between advisers in undertakings under common control is permitted` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 333B(4) the disclosure between advisers in undertakings under common control is permitted` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 333B(4) the disclosure between advisers in undertakings under common control is permitted` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 333B(4) the disclosure between advisers in undertakings under common control is permitted` TRUE TRUE TRUE FALSE

§ `s 333C permitted disclosures between institutions`
#ASSERT `s 333C(1) this section applies to the disclosure` `by a credit institution to another credit institution` EQUALS JUST TRUE
#ASSERT `s 333C(1) this section applies to the disclosure` `by a financial institution to another financial institution` EQUALS JUST TRUE
#ASSERT `s 333C(1) this section applies to the disclosure` `by a professional legal adviser to another professional legal adviser` EQUALS JUST TRUE
#ASSERT `s 333C(1) this section applies to the disclosure` `by a relevant professional adviser of a particular kind to another relevant professional adviser of the same kind` EQUALS JUST TRUE
#ASSERT `s 333C(1) this section applies to the disclosure` `another disclosure` EQUALS JUST FALSE
-- (2): applies; relates to a client (i), a transaction (ii) or a service (iii); the purpose only of preventing an offence; recipient situated in the UK, an EEA state or an equivalent country; equivalent duties of confidentiality
#ASSERT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE TRUE FALSE FALSE TRUE TRUE TRUE
#ASSERT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE FALSE TRUE FALSE TRUE TRUE TRUE
#ASSERT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE FALSE FALSE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE FALSE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT `s 333C(2) the disclosure between institutions or advisers is permitted` FALSE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE TRUE TRUE TRUE FALSE TRUE TRUE
#ASSERT NOT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT `s 333C(2) the disclosure between institutions or advisers is permitted` TRUE TRUE TRUE TRUE TRUE TRUE FALSE

§ `s 333D other permitted disclosures`
-- (1): supervisory authority; proceedings under 336A; in good faith by virtue of 339ZB; detection of a criminal offence; an investigation under this Act; enforcement of a court order
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `s 333D(1) the disclosure for one of the listed purposes is permitted` FALSE FALSE FALSE FALSE FALSE FALSE
-- (1A): an application to extend the moratorium; to a customer; who appears to have an interest; only what is necessary
#ASSERT `s 333D(1A) the disclosure to a customer or client about the application is permitted` TRUE TRUE TRUE TRUE
#ASSERT NOT `s 333D(1A) the disclosure to a customer or client about the application is permitted` FALSE TRUE TRUE TRUE
#ASSERT NOT `s 333D(1A) the disclosure to a customer or client about the application is permitted` TRUE FALSE TRUE TRUE
#ASSERT NOT `s 333D(1A) the disclosure to a customer or client about the application is permitted` TRUE TRUE FALSE TRUE
#ASSERT NOT `s 333D(1A) the disclosure to a customer or client about the application is permitted` TRUE TRUE TRUE FALSE
#ASSERT `s 333D(2) the disclosure by an adviser to dissuade the client is permitted` TRUE TRUE TRUE
#ASSERT NOT `s 333D(2) the disclosure by an adviser to dissuade the client is permitted` FALSE TRUE TRUE
#ASSERT NOT `s 333D(2) the disclosure by an adviser to dissuade the client is permitted` TRUE FALSE TRUE
#ASSERT NOT `s 333D(2) the disclosure by an adviser to dissuade the client is permitted` TRUE TRUE FALSE
#ASSERT `s 333D(3) the exception of section 333D(3) applies` TRUE
#ASSERT NOT `s 333D(3) the exception of section 333D(3) applies` FALSE
#ASSERT `s 333D(4) the exception of section 333D(4) applies` TRUE
#ASSERT NOT `s 333D(4) the exception of section 333D(4) applies` FALSE

§ `s 333E how the words are read`
#ASSERT `s 333E(1) the business is a business in the regulated sector` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333E(1) the business is a business in the regulated sector` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333E(1) the business is a business in the regulated sector` NOTHING EQUALS NOTHING
#ASSERT `s 333E(1) the body is a supervisory authority` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333E(1) the body is a supervisory authority` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333E(1) the body is a supervisory authority` NOTHING EQUALS NOTHING
#ASSERT `s 333E(2) the institution is a credit institution` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333E(2) the institution is a credit institution` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333E(2) the institution is a credit institution` NOTHING EQUALS NOTHING
#ASSERT `s 333E(2) the undertaking is a financial institution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333E(2) the undertaking is a financial institution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333E(2) the undertaking is a financial institution` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333E(3) the disclosure counts as a disclosure by or to the institution` TRUE EQUALS JUST TRUE
#ASSERT `s 333E(3) the disclosure counts as a disclosure by or to the institution` FALSE EQUALS NOTHING
#ASSERT `s 333E(4) the country or territory imposes equivalent money laundering requirements` TRUE EQUALS JUST TRUE
#ASSERT `s 333E(4) the country or territory imposes equivalent money laundering requirements` FALSE EQUALS NOTHING
-- (5): Adviser fields are: professional legal adviser; accountant, auditor or tax adviser; member of such a professional body; competence testing; standards; sanctions
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF FALSE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 333E(5) the person is a relevant professional adviser` (`Adviser` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
