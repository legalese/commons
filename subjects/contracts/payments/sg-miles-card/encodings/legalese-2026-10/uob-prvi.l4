#ASSERT `the PRVI Amex loyalty UNI$ for spend of` 60000 `against` 80000 EQUALS 0
#ASSERT `the PRVI Amex annual fee is waived on spend of` 50000
#ASSERT NOT (`the PRVI Amex annual fee is waived on spend of` 49999.99)
