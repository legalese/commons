§§ `The default cardholder and a fresh month`

`the default cardholder` MEANS
    Cardholder WITH
        yuu              IS `yuu holder` WITH `yuu account linked to the card` IS TRUE
        `PAssion`        IS `PAssion holder` WITH
                                `People's Association member`               IS TRUE
                                `yuu account linked to the PAssion card`    IS TRUE
        `Lady's`         IS `Lady's holder` WITH
                                `elected categories`   IS LIST `Dining`, `Family`
                                `Lady's Savings band`  IS `Under S$10,000`
        `Revolution`     IS `Revolution holder` WITH
                                `Deposits ADB of S$50,000 in the sole Everyday Global Account` IS FALSE
        `Visa Signature` IS `Visa Signature holder` WITH vintage IS `Approved on or after 1 July 2025`
        `Trust`          IS `Trust holder` WITH
                                `reward choice`                  IS `Miles`
                                `new Trust credit card customer` IS TRUE
                                `card approved on`               IS Date 22 9 2026
                                `Quest spend tiers in S$`        IS LIST 1000, 5000, 15000

`a fresh month` MEANS
    `Month to date` WITH
        yuu              IS `yuu month` WITH
                                `Eligible Spend posted`  IS 0
                                `merchants hit`          IS EMPTY
                                `bonus yuu Points earned` IS 0
        `Woman's`        IS `Woman's month` WITH `online spend accumulated` IS 0
        `Revolution`     IS `Revolution month` WITH
                                `Eligible Transactions posted` IS 0
                                `Bonus Points earned`          IS 0
        `Lady's`         IS `Lady's month` WITH `Bonus UNI$ by elected category` IS LIST 0, 0
        `PAssion`        IS `PAssion month` WITH
                                `Qualified Spend`            IS 0
                                `items transacted`           IS EMPTY
                                `ringgit spend made`         IS FALSE
                                `POSB Bonus Points earned`   IS 0
        `Citi`           IS `Citi month` WITH `Bonus Points earned` IS 0
        `Preferred Visa` IS `Preferred Visa month` WITH
                                `mobile contactless bonus UNI$` IS 0
                                `selected online bonus UNI$`    IS 0
        `Visa Signature` IS `Visa Signature month` WITH
                                `contactless and petrol spend`         IS 0
                                `contactless and petrol UNI$10 earned` IS 0
                                `overseas spend`                       IS 0
                                `overseas UNI$10 earned`               IS 0
        `Smart`          IS `Smart month` WITH `Eligible Retail Transactions` IS 0
        `Trust`          IS `Trust month` WITH `cumulative posted qualifying spend` IS 0
        `PRVI`           IS `PRVI month` WITH
                                `membership-year spend`            IS 0
                                `quarter overseas in-person spend` IS 0
